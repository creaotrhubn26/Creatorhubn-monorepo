{
  "name": "creatorhub-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently -n \"frontend,backend\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "test:storyboard-asset-package": "cd frontend && npm run test:storyboard-asset-package",
    "test:storyboard-packs-api": "cd backend && npm run test:storyboard-packs",
    "test:storyboard-r2-path": "cd backend && npm run test:storyboard-r2-path"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
