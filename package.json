{
  "name": "creatorhub-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently -n \"frontend,backend\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "smoke:role-room:live": "node scripts/role-room-live-smoke.mjs",
    "check:role-room-billing": "node backend/scripts/check-role-room-billing.mjs",
    "e2e:role-room-exporter:live": "node scripts/role-room-exporter-live-e2e.mjs",
    "e2e:role-room-google-workspace:live": "node scripts/role-room-google-workspace-live-e2e.mjs",
    "deploy:role-room:prod": "node scripts/deploy-role-room-prod.mjs",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "@mapbox/node-pre-gyp": {
      "tar": "^7.5.22"
    },
    "dompurify": "^3.4.13",
    "tmp": "^0.2.7",
    "node-fetch@2": "2.7.0",
    "uuid@8": "11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "lighthouse": {
      "puppeteer-core": "^25.6.0"
    },
    "@xenova/transformers": {
      "onnxruntime-web": "^1.23.2",
      "sharp": "0.35.3"
    },
    "@types/express-serve-static-core": "5.1.0",
    "@types/qs": "6.14.0",
    "@types/node": "24.10.13",
    "@types/react": "18.3.27",
    "@types/three": "0.182.0"
  }
}
