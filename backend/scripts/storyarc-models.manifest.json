{
  "manifestVersion": 1,
  "description": "Story Arc Studio speech + diarization + denoise model artifacts. Deepgram is API-based and therefore has no model file upload.",
  "models": [
    {
      "id": "rnnoise-lq",
      "description": "RNNoise ARNNDN model used by /api/audio/mix denoise chain.",
      "optional": false,
      "r2Key": "models/audio/rnnoise/leavened-quisling-2018-08-31-lq.rnnn",
      "source": {
        "type": "local",
        "path": "config/models/rnnoise/lq.rnnn"
      }
    },
    {
      "id": "faster-whisper-small-config",
      "optional": true,
      "r2Key": "models/speech/faster-whisper-small/config.json",
      "source": {
        "type": "url",
        "url": "https://huggingface.co/Systran/faster-whisper-small/resolve/main/config.json"
      }
    },
    {
      "id": "faster-whisper-small-model",
      "optional": true,
      "r2Key": "models/speech/faster-whisper-small/model.bin",
      "source": {
        "type": "url",
        "url": "https://huggingface.co/Systran/faster-whisper-small/resolve/main/model.bin"
      }
    },
    {
      "id": "faster-whisper-small-tokenizer",
      "optional": true,
      "r2Key": "models/speech/faster-whisper-small/tokenizer.json",
      "source": {
        "type": "url",
        "url": "https://huggingface.co/Systran/faster-whisper-small/resolve/main/tokenizer.json"
      }
    },
    {
      "id": "whisperx-align-en-config",
