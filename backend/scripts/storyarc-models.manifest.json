        "type": "url",
        "url": "https://huggingface.co/facebook/wav2vec2-base-960h/resolve/main/config.json"
      }
    },
    {
      "id": "whisperx-align-en-model",
      "optional": true,
      "r2Key": "models/speech/whisperx-align-en/pytorch_model.bin",
      "source": {
        "type": "url",
        "url": "https://huggingface.co/facebook/wav2vec2-base-960h/resolve/main/pytorch_model.bin"
      }
    },
    {
      "id": "whisperx-align-en-vocab",
      "optional": true,
      "r2Key": "models/speech/whisperx-align-en/vocab.json",
      "source": {
        "type": "url",
        "url": "https://huggingface.co/facebook/wav2vec2-base-960h/resolve/main/vocab.json"
      }
    },
    {
      "id": "whisperx-align-en-preprocessor",
      "optional": true,
      "r2Key": "models/speech/whisperx-align-en/preprocessor_config.json",
      "source": {
        "type": "url",
        "url": "https://huggingface.co/facebook/wav2vec2-base-960h/resolve/main/preprocessor_config.json"
      }
    },
    {
      "id": "pyannote-speaker-diarization-config",
      "description": "Requires accepted HF license + HUGGINGFACE_TOKEN.",
      "optional": true,
      "r2Key": "models/speech/pyannote/speaker-diarization-3.1/config.yaml",
      "source": {
        "type": "url",
        "url": "https://huggingface.co/pyannote/speaker-diarization-3.1/resolve/main/config.yaml"
      }
    },
    {
      "id": "pyannote-segmentation-config",
      "description": "Requires accepted HF license + HUGGINGFACE_TOKEN.",
      "optional": true,
      "r2Key": "models/speech/pyannote/segmentation-3.0/config.yaml",
      "source": {
        "type": "url",
        "url": "https://huggingface.co/pyannote/segmentation-3.0/resolve/main/config.yaml"
