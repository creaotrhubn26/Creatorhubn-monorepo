      }
    },
    {
      "id": "demucs-htdemucs-weight",
      "optional": true,
      "r2Key": "models/audio/demucs/htdemucs/955717e8-8726e21a.th",
      "source": {
        "type": "url",
        "url": "https://dl.fbaipublicfiles.com/demucs/hybrid_transformer/955717e8-8726e21a.th"
