{
  "name": "creatorhub-backend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "main": "server/index.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=16384' tsx server/index.ts",
    "dev:all": "concurrently -n \"node,python\" -c \"cyan,yellow\" \"npm run dev\" \"npm run ml:start\"",
    "ml:start": "cd python_ml_service && python main.py",
    "ml:install": "cd python_ml_service && pip install -r requirements.txt",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --splitting --chunk-names=chunks/[name]-[hash] --target=node20",
    "start": "node server.js",
    "start:all": "concurrently -n \"node,python\" -c \"cyan,yellow\" \"npm start\" \"npm run ml:start\"",
    "migrate": "./migrate.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "db:push": "npx --yes drizzle-kit push",
    "db:push:safe": "node scripts/run-db-push-with-timeout.js",
    "db:studio": "npx --yes drizzle-kit studio",
    "generate-assets": "tsx scripts/generate-all-assets.ts",
    "test-generation": "tsx scripts/generate-all-assets.ts -- --limit 1",
    "upload-models-r2": "tsx scripts/upload-models-to-r2.ts",
    "upload-gfpgan": "tsx scripts/upload-gfpgan-essential.ts",
    "upload-realesrgan": "tsx scripts/upload-realesrgan-to-r2.ts",
    "upload-diffbir": "tsx scripts/upload-diffbir-to-r2.ts",
    "upload-diffbir-essential": "tsx scripts/upload-diffbir-essential.ts",
    "upload-facexformer": "tsx scripts/upload-facexformer-to-r2.ts",
    "update-facexformer-db": "tsx scripts/update-facexformer-db.ts",
    "test-facexformer-download": "tsx scripts/test-facexformer-download.ts",
    "upload-diffbir-weights": "tsx scripts/upload-diffbir-weights.ts",
    "test-r2": "tsx scripts/test-r2-connection.ts",
    "test-integration": "tsx scripts/test-complete-integration.ts",
    "oauth:check": "node scripts/check-oauth-scopes.js",
    "oauth:update": "./scripts/update-oauth-scopes.sh",
    "db:psql": "node -e \"require('dotenv').config({path: '.env.local'}); require('dotenv').config(); require('child_process').spawn('psql', [process.env.DATABASE_URL], {stdio: 'inherit'});\"",
    "db:health": "tsx server/scripts/database-health-check.ts",
    "db:check-missing": "tsx server/scripts/check-and-create-missing-tables.ts",
    "db:check-batch": "tsx server/scripts/batch-table-checker.ts",
    "db:find-all": "tsx server/scripts/find-all-database-tables.ts",
    "db:generate-schema": "tsx server/scripts/add-missing-tables-to-schema.ts",
    "db:generate-schema:apply": "tsx server/scripts/add-missing-tables-to-schema.ts --apply",
    "db:add-wedding-columns": "tsx server/scripts/add-wedding-timeline-columns.ts",
    "db:add-wedding-columns:apply": "tsx server/scripts/add-wedding-timeline-columns.ts --apply",
    "db:optimize-wedding-timeline": "tsx server/scripts/optimize-wedding-timeline-tables.ts",
    "db:optimize-wedding-timeline:apply": "tsx server/scripts/optimize-wedding-timeline-tables.ts --apply",
    "db:cleanup-wedding-nulls": "tsx server/scripts/cleanup-wedding-timeline-nulls.ts",
    "db:cleanup-wedding-nulls:apply": "tsx server/scripts/cleanup-wedding-timeline-nulls.ts --apply",
    "db:add-universal-showcase-columns": "tsx server/scripts/add-universal-showcase-columns.ts",
    "db:add-universal-showcase-columns:apply": "tsx server/scripts/add-universal-showcase-columns.ts --apply",
    "db:optimize-universal-showcase": "tsx server/scripts/optimize-universal-showcase-tables.ts",
    "db:optimize-universal-showcase:apply": "tsx server/scripts/optimize-universal-showcase-tables.ts --apply",
    "db:add-universal-dashboard-columns": "tsx server/scripts/add-universal-dashboard-columns.ts",
    "db:add-universal-dashboard-columns:apply": "tsx server/scripts/add-universal-dashboard-columns.ts --apply",
    "db:optimize-universal-dashboard": "tsx server/scripts/optimize-universal-dashboard-tables.ts",
    "db:optimize-universal-dashboard:apply": "tsx server/scripts/optimize-universal-dashboard-tables.ts --apply",
    "db:add-worklog-columns": "tsx server/scripts/add-worklog-columns.ts",
    "db:add-worklog-columns:apply": "tsx server/scripts/add-worklog-columns.ts --apply",
    "db:optimize-worklog": "tsx server/scripts/optimize-worklog-tables.ts",
    "db:optimize-worklog:apply": "tsx server/scripts/optimize-worklog-tables.ts --apply",
    "db:analyze-frontend": "tsx server/scripts/analyze-frontend-components.ts",
    "db:ensure-all-tables": "tsx server/scripts/ensure-all-tables-and-columns.ts",
    "db:ensure-all-tables:apply": "tsx server/scripts/ensure-all-tables-and-columns.ts --apply",
    "db:fix-nullable-columns": "tsx server/scripts/fix-nullable-columns.ts",
    "db:fix-nullable-columns:apply": "tsx server/scripts/fix-nullable-columns.ts --apply",
    "db:verify-all": "tsx server/scripts/final-verification-all-tables.ts",
    "db:verify-comprehensive": "tsx server/scripts/comprehensive-database-verification.ts",
    "db:verify-every-component": "tsx server/scripts/verify-every-component.ts",
    "db:verify-routes-vs-tables": "tsx server/scripts/verify-routes-vs-tables.ts",
    "db:verify-backend": "tsx server/scripts/verify-backend-complete.ts",
    "db:verify-production": "tsx server/scripts/production-verification.ts",
    "db:pre-deployment": "tsx server/scripts/pre-deployment-checklist.ts",
    "db:post-deployment": "tsx server/scripts/post-deployment-verification.ts",
    "db:monitor": "tsx server/scripts/continuous-monitoring.ts",
    "db:forensic-performance": "tsx server/scripts/forensic-performance-analysis.ts",
    "db:fix-orphaned-records": "tsx server/scripts/fix-orphaned-records.ts",
    "db:add-missing-indexes": "tsx server/scripts/add-missing-indexes.ts",
    "db:check-full": "tsx server/scripts/comprehensive-frontend-backend-check.ts",
    "db:create-tables": "tsx scripts/create-missing-tables-direct-sql.ts",
    "db:kill-queries": "tsx server/scripts/kill-long-running-queries.ts",
    "db:kill-queries:live": "tsx server/scripts/kill-long-running-queries.ts --kill",
    "db:kill-idle": "tsx server/scripts/kill-idle-transactions.ts",
    "db:kill-idle:live": "tsx server/scripts/kill-idle-transactions.ts --kill"
  },
