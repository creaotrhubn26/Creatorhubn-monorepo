{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theroleroom.com/schemas/storyboard-scenario-pack-v1.json",
  "title": "The Role Room Storyboard Scenario Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "label", "domain", "description", "catalog", "subdomains", "families"],
  "properties": {
    "schemaVersion": { "const": "trr-scenario-pack-v1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "label": { "$ref": "#/$defs/nonEmpty" },
    "domain": { "$ref": "#/$defs/id" },
    "description": { "$ref": "#/$defs/nonEmpty" },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zones", "roles", "propTypes", "actions", "states", "safetyContexts", "continuityLocks"],
      "properties": {
        "zones": { "$ref": "#/$defs/promptEntries" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "prompt", "wardrobe"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/nonEmpty" },
              "prompt": { "$ref": "#/$defs/nonEmpty" },
              "wardrobe": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "propTypes": { "$ref": "#/$defs/promptEntries" },
        "actions": { "$ref": "#/$defs/promptEntries" },
        "states": { "$ref": "#/$defs/promptEntries" },
        "safetyContexts": { "$ref": "#/$defs/promptEntries" },
        "continuityLocks": { "$ref": "#/$defs/promptEntries" }
      }
    },
    "subdomains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "zoneIds", "roleIds", "propTypeIds", "actionIds", "stateIds", "safetyContextIds", "continuityLockIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/nonEmpty" },
          "zoneIds": { "$ref": "#/$defs/idList" },
          "roleIds": { "$ref": "#/$defs/idList" },
          "propTypeIds": { "$ref": "#/$defs/idList" },
          "actionIds": { "$ref": "#/$defs/idList" },
          "stateIds": { "$ref": "#/$defs/idList" },
          "safetyContextIds": { "$ref": "#/$defs/idList" },
          "continuityLockIds": { "$ref": "#/$defs/idList" }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "primaryStyleAnchor", "variants"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/nonEmpty" },
          "primaryStyleAnchor": { "enum": ["object-architecture", "organic-nature", "weather-effects"] },
          "secondaryStyleAnchor": { "enum": ["object-architecture", "organic-nature", "weather-effects"] },
          "variants": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "$ref": "#/$defs/promptEntry" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "idList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "promptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "prompt": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "promptEntries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/promptEntry" } }
  }
}
