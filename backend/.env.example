# Backend env template for local development.
# Copy to .env and fill in real values. DO NOT commit .env.

# ── Core ──────────────────────────────────────────────────────
# DATABASE_URL=postgres://user:pass@localhost:5432/creatorhub
# PORT=3001

# ── The Role Room Agent — AI processors ───────────────────────

# Cohere (existing rerank workflow)
# COHERE_API_KEY=
# ROLE_ROOM_AGENT_COHERE_RERANK_MODEL=rerank-v3.5

# Anthropic (Claude — new generation workflow, feature-flagged)
# Default model: claude-sonnet-4-5. Override with ROLE_ROOM_AGENT_CLAUDE_MODEL.
# ANTHROPIC_API_KEY=
# ROLE_ROOM_AGENT_CLAUDE_ENABLED=false
# ROLE_ROOM_AGENT_CLAUDE_MODEL=claude-sonnet-4-5

# Route the producer-bootstrap synthesis layer through Claude instead of
# OpenAI. Default (unset or anything != "claude") keeps existing OpenAI path.
# Requires ANTHROPIC_API_KEY. Falls back to OpenAI on Claude failure.
# ROLE_ROOM_BOOTSTRAP_MODEL=claude
# ROLE_ROOM_BOOTSTRAP_CLAUDE_MODEL=claude-sonnet-4-5

# Multimodal vision: when bootstrap routes through Claude, automatically
# fetch the customer's og:image/twitter:image and include it in the
# synthesis so Claude can "see" the visual identity. Set to "false" to
# skip image analysis (faster, cheaper, but weaker brand signal).
# ROLE_ROOM_BOOTSTRAP_VISION=true

# Tool-orchestrated bootstrap: Claude picks which fetchers to run
# (Brreg, website, Google Places) based on input shape. Best for
# non-Norwegian customers (skips Brreg) or for thin inputs where we
# shouldn't call all sources. Falls through to deterministic pipeline
# if orchestrator yields nothing useful.
# ROLE_ROOM_BOOTSTRAP_ORCHESTRATOR=claude

# Cost-saving cache for agent responses. Same question + same context
# within 30 min returns the cached answer (no Anthropic call).
# Default on; set to "off" to disable.
# ROLE_ROOM_AGENT_CACHE=on

# Model router: send short info-lookup queries to Haiku 4.5 (~5× cheaper
# than Sonnet 4.5). Set to "off" to always use Sonnet.
# ROLE_ROOM_AGENT_MODEL_ROUTER=on
# ROLE_ROOM_AGENT_HAIKU_MODEL=claude-haiku-4-5-20251001

# Proactive daily agent scan — once per 24 h, the agent looks at each
# active project with AI consent and drops risk findings into Innboks
# (producer_project_notifications). Disabled by default so costs stay
# predictable; enable after a small pilot.
# ROLE_ROOM_AGENT_DAILY_SCAN_ENABLED=false
# ROLE_ROOM_AGENT_DAILY_SCAN_LIMIT=50

# ── GDPR — AI audit log retention ─────────────────────────────
# role_room_ai_audit_log is pruned daily at 365 days by the app.
# No env var needed — cron is started from httpServer.listen callback.
