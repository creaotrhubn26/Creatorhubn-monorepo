# Backend env template for local development.
# Copy to .env and fill in real values. DO NOT commit .env.

# ── Core ──────────────────────────────────────────────────────
# DATABASE_URL=postgres://user:pass@localhost:5432/creatorhub
# PORT=3001

# ── The Role Room Agent — AI processors ───────────────────────

# Cohere (existing rerank workflow)
# COHERE_API_KEY=
# ROLE_ROOM_AGENT_COHERE_RERANK_MODEL=rerank-v3.5

# Anthropic (Claude — new generation workflow, feature-flagged)
# Default model: claude-sonnet-4-5. Override with ROLE_ROOM_AGENT_CLAUDE_MODEL.
# ANTHROPIC_API_KEY=
# ROLE_ROOM_AGENT_CLAUDE_ENABLED=false
# ROLE_ROOM_AGENT_CLAUDE_MODEL=claude-sonnet-4-5

# Route the producer-bootstrap synthesis layer through Claude instead of
# OpenAI. Default (unset or anything != "claude") keeps existing OpenAI path.
# Requires ANTHROPIC_API_KEY. Falls back to OpenAI on Claude failure.
# ROLE_ROOM_BOOTSTRAP_MODEL=claude
# ROLE_ROOM_BOOTSTRAP_CLAUDE_MODEL=claude-sonnet-4-5

# Multimodal vision: when bootstrap routes through Claude, automatically
# fetch the customer's og:image/twitter:image and include it in the
# synthesis so Claude can "see" the visual identity. Set to "false" to
# skip image analysis (faster, cheaper, but weaker brand signal).
# ROLE_ROOM_BOOTSTRAP_VISION=true

# Tool-orchestrated bootstrap: Claude picks which fetchers to run
# (Brreg, website, Google Places) based on input shape. Best for
# non-Norwegian customers (skips Brreg) or for thin inputs where we
# shouldn't call all sources. Falls through to deterministic pipeline
# if orchestrator yields nothing useful.
# ROLE_ROOM_BOOTSTRAP_ORCHESTRATOR=claude

# Cost-saving cache for agent responses. Same question + same context
# within 30 min returns the cached answer (no Anthropic call).
# Default on; set to "off" to disable.
# ROLE_ROOM_AGENT_CACHE=on

# Model router: send short info-lookup queries to Haiku 4.5 (~5× cheaper
# than Sonnet 4.5). Set to "off" to always use Sonnet.
# ROLE_ROOM_AGENT_MODEL_ROUTER=on
# ROLE_ROOM_AGENT_HAIKU_MODEL=claude-haiku-4-5-20251001

# Proactive daily agent scan — once per 24 h, the agent looks at each
# active project with AI consent and drops risk findings into Innboks
# (producer_project_notifications). Disabled by default so costs stay
# predictable; enable after a small pilot.
# ROLE_ROOM_AGENT_DAILY_SCAN_ENABLED=false
# ROLE_ROOM_AGENT_DAILY_SCAN_LIMIT=50

# ── GDPR — AI audit log retention ─────────────────────────────
# role_room_ai_audit_log is pruned daily at 365 days by the app.
# No env var needed — cron is started from httpServer.listen callback.

# ── Audition reminders (Twilio SMS + Gmail fallback) ─────────
# Branded SMS senders for The Role Room and CreatorHub. Each brand has
# its own Messaging Service SID (registered alphanumeric "RoleRoom" /
# "CreatorHub" sender ID). Generic TWILIO_* values act as fallback.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# ROLE_ROOM_TWILIO_ACCOUNT_SID=
# ROLE_ROOM_TWILIO_AUTH_TOKEN=
# ROLE_ROOM_TWILIO_MESSAGING_SERVICE_SID=
# CREATORHUB_TWILIO_ACCOUNT_SID=
# CREATORHUB_TWILIO_AUTH_TOKEN=
# CREATORHUB_TWILIO_MESSAGING_SERVICE_SID=

# Reminder runner — set ENABLED=false to skip SMS+email sends in
# CI / dev. Interval is in minutes (default 15). Sweep windows reminders
# 24h ± 15min and 1h ± 15min before each scheduled audition.
# AUDITION_REMINDER_RUNNER_ENABLED=true
# AUDITION_REMINDER_INTERVAL_MINUTES=15

# SMS billing (kunden faktureres for branded SMS i månedsfakturaen).
# Pris er i NOK eks. mva. og stemples per rad i casting_sms_usage så
# pris-endringer ikke påvirker historiske fakturaer.
# CASTING_SMS_RETAIL_PRICE_NOK_EX_VAT=2.00
# CASTING_SMS_VAT_RATE=0.25
# CASTING_SMS_COST_NOK=0.65

# SMS-faktura-sync mot Stripe. Daglig sweep aggregerer uavfakturerte
# casting_sms_usage-rader fra avsluttede billing-perioder per (kunde, måned)
# og legger dem som invoice line-items på neste Stripe-faktura. Idempotent
# via stripe_invoice_item_id-stemplet på hver rad. Krever at Role Room
# Stripe-klienten er konfigurert.
# CASTING_SMS_INVOICE_RUNNER_ENABLED=true
# CASTING_SMS_INVOICE_INTERVAL_HOURS=24

# ── WhatsApp Cloud API (Multi-tenant BYO Meta) ──────────────
# Multi-tenant: hver bedrift kobler sin egen Meta Business-konto via
# settings-UI. Disse env-varene er KUN fallback for The Role Room sin
# egen demo-konto (når en kunde ennå ikke har koblet til).
#
# WHATSAPP_BUSINESS_ACCOUNT_ID, WHATSAPP_PHONE_NUMBER_ID, META_APP_ID,
# META_APP_SECRET er dokumentert under "Meta / Instagram" lenger oppe.
#
# META_APP_ACCESS_TOKEN: System User-permanent token fra Meta Business
# Manager → Business Settings → System Users → Generate Access Token.
# META_APP_ACCESS_TOKEN=

# Template-navn for godkjente Meta-templates. Endre HVIS templates
# godkjennes med andre navn enn defaults. Defaults matcher våre
# template-submits (audition_reminder_24h_no, audition_reminder_1h_no,
# production_team_invite_no).
# META_WHATSAPP_TEMPLATE_LANGUAGE=nb_NO
# META_WHATSAPP_TEMPLATE_24H_NAME=audition_reminder_24h_no
# META_WHATSAPP_TEMPLATE_1H_NAME=audition_reminder_1h_no
# META_WHATSAPP_TEMPLATE_TEAM_INVITE_NAME=production_team_invite_no

# Team-invitasjons-runner — daglig sweep finner crew uten WhatsApp-
# invitasjon ennå og sender via bedriftens Cloud API. Retry-bar på fail.
# CASTING_TEAM_INVITE_RUNNER_ENABLED=true
# CASTING_TEAM_INVITE_INTERVAL_MINUTES=10

# WhatsApp billing — pris per melding stemples per rad i casting_whatsapp_usage.
# 0,80 NOK retail / 0,34 cost / ~135% margin. Endring her påvirker kun
# nye meldinger.
# CASTING_WHATSAPP_RETAIL_PRICE_NOK_EX_VAT=0.80
# CASTING_WHATSAPP_VAT_RATE=0.25
# CASTING_WHATSAPP_COST_NOK=0.34

# WhatsApp-faktura-sync — daglig sweep aggregerer uavfakturerte
# casting_whatsapp_usage-rader til Stripe invoice items.
# CASTING_WHATSAPP_INVOICE_RUNNER_ENABLED=true
# CASTING_WHATSAPP_INVOICE_INTERVAL_HOURS=24
