# Backend env template for local development.
# Copy to .env and fill in real values. DO NOT commit .env.

# ── Core ──────────────────────────────────────────────────────
# DATABASE_URL=postgres://user:pass@localhost:5432/creatorhub
# One-off old-to-new database scripts only; must differ from DATABASE_URL.
# LEGACY_DATABASE_URL=postgres://user:pass@localhost:5432/creatorhub_legacy
# PORT=3001

# ── The Role Room Agent — AI processors ───────────────────────

# Cohere (existing rerank workflow)
# COHERE_API_KEY=
# ROLE_ROOM_AGENT_COHERE_RERANK_MODEL=rerank-v3.5

# Anthropic (Claude — new generation workflow, feature-flagged)
# Default model: claude-sonnet-4-5. Override with ROLE_ROOM_AGENT_CLAUDE_MODEL.
# ANTHROPIC_API_KEY=
# ROLE_ROOM_AGENT_CLAUDE_ENABLED=false
# ROLE_ROOM_AGENT_CLAUDE_MODEL=claude-sonnet-4-5

# Route the producer-bootstrap synthesis layer through Claude instead of
# OpenAI. Default (unset or anything != "claude") keeps existing OpenAI path.
# Requires ANTHROPIC_API_KEY. Falls back to OpenAI on Claude failure.
# ROLE_ROOM_BOOTSTRAP_MODEL=claude
# ROLE_ROOM_BOOTSTRAP_CLAUDE_MODEL=claude-sonnet-4-5

# Multimodal vision: when bootstrap routes through Claude, automatically
# fetch the customer's og:image/twitter:image and include it in the
# synthesis so Claude can "see" the visual identity. Set to "false" to
# skip image analysis (faster, cheaper, but weaker brand signal).
# ROLE_ROOM_BOOTSTRAP_VISION=true

# Tool-orchestrated bootstrap: Claude picks which fetchers to run
# (Brreg, website, Google Places) based on input shape. Best for
# non-Norwegian customers (skips Brreg) or for thin inputs where we
# shouldn't call all sources. Falls through to deterministic pipeline
# if orchestrator yields nothing useful.
# ROLE_ROOM_BOOTSTRAP_ORCHESTRATOR=claude

# Cost-saving cache for agent responses. Same question + same context
# within 30 min returns the cached answer (no Anthropic call).
# Default on; set to "off" to disable.
# ROLE_ROOM_AGENT_CACHE=on

# Model router: send short info-lookup queries to Haiku 4.5 (~5× cheaper
# than Sonnet 4.5). Set to "off" to always use Sonnet.
# ROLE_ROOM_AGENT_MODEL_ROUTER=on
# ROLE_ROOM_AGENT_HAIKU_MODEL=claude-haiku-4-5-20251001

# Proactive daily agent scan — once per 24 h, the agent looks at each
# active project with AI consent and drops risk findings into Innboks
# (producer_project_notifications). Disabled by default so costs stay
# predictable; enable after a small pilot.
# ROLE_ROOM_AGENT_DAILY_SCAN_ENABLED=false
# ROLE_ROOM_AGENT_DAILY_SCAN_LIMIT=50

# ── GDPR — AI audit log retention ─────────────────────────────
# role_room_ai_audit_log is pruned daily at 365 days by the app.
# No env var needed — cron is started from httpServer.listen callback.

# ── Audition reminders (Twilio SMS + Gmail fallback) ─────────
# Branded SMS senders for The Role Room and CreatorHub. Each brand has
# its own Messaging Service SID (registered alphanumeric "RoleRoom" /
# "CreatorHub" sender ID). Generic TWILIO_* values act as fallback.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# ROLE_ROOM_TWILIO_ACCOUNT_SID=
# ROLE_ROOM_TWILIO_AUTH_TOKEN=
# ROLE_ROOM_TWILIO_MESSAGING_SERVICE_SID=
# CREATORHUB_TWILIO_ACCOUNT_SID=
# CREATORHUB_TWILIO_AUTH_TOKEN=
# CREATORHUB_TWILIO_MESSAGING_SERVICE_SID=

# Reminder runner — set ENABLED=false to skip SMS+email sends in
# CI / dev. Interval is in minutes (default 15). Sweep windows reminders
# 24h ± 15min and 1h ± 15min before each scheduled audition.
# AUDITION_REMINDER_RUNNER_ENABLED=true
# AUDITION_REMINDER_INTERVAL_MINUTES=15

# SMS billing (kunden faktureres for branded SMS i månedsfakturaen).
# Pris er i NOK eks. mva. og stemples per rad i casting_sms_usage så
# pris-endringer ikke påvirker historiske fakturaer.
# CASTING_SMS_RETAIL_PRICE_NOK_EX_VAT=2.00
# CASTING_SMS_VAT_RATE=0.25
# CASTING_SMS_COST_NOK=0.65

# SMS-faktura-sync mot Stripe. Daglig sweep aggregerer uavfakturerte
# casting_sms_usage-rader fra avsluttede billing-perioder per (kunde, måned)
# og legger dem som invoice line-items på neste Stripe-faktura. Idempotent
# via stripe_invoice_item_id-stemplet på hver rad. Krever at Role Room
# Stripe-klienten er konfigurert.
# CASTING_SMS_INVOICE_RUNNER_ENABLED=true
# CASTING_SMS_INVOICE_INTERVAL_HOURS=24

# ── WhatsApp Cloud API (Multi-tenant BYO Meta) ──────────────
# Multi-tenant: hver bedrift kobler sin egen Meta Business-konto via
# settings-UI. Disse env-varene er KUN fallback for The Role Room sin
# egen demo-konto (når en kunde ennå ikke har koblet til).
#
# WHATSAPP_BUSINESS_ACCOUNT_ID, WHATSAPP_PHONE_NUMBER_ID, META_APP_ID,
# META_APP_SECRET er dokumentert under "Meta / Instagram" lenger oppe.
#
# META_APP_ACCESS_TOKEN: System User-permanent token fra Meta Business
# Manager → Business Settings → System Users → Generate Access Token.
# META_APP_ACCESS_TOKEN=

# Template-navn for godkjente Meta-templates. Endre HVIS templates
# godkjennes med andre navn enn defaults. Defaults matcher våre
# template-submits (audition_reminder_24h_no, audition_reminder_1h_no,
# production_team_invite_no).
# META_WHATSAPP_TEMPLATE_LANGUAGE=nb_NO
# META_WHATSAPP_TEMPLATE_24H_NAME=audition_reminder_24h_no
# META_WHATSAPP_TEMPLATE_1H_NAME=audition_reminder_1h_no
# META_WHATSAPP_TEMPLATE_TEAM_INVITE_NAME=production_team_invite_no

# Team-invitasjons-runner — daglig sweep finner crew uten WhatsApp-
# invitasjon ennå og sender via bedriftens Cloud API. Retry-bar på fail.
# CASTING_TEAM_INVITE_RUNNER_ENABLED=true
# CASTING_TEAM_INVITE_INTERVAL_MINUTES=10

# WhatsApp billing — pris per melding stemples per rad i casting_whatsapp_usage.
# 0,80 NOK retail / 0,34 cost / ~135% margin. Endring her påvirker kun
# nye meldinger.
# CASTING_WHATSAPP_RETAIL_PRICE_NOK_EX_VAT=0.80
# CASTING_WHATSAPP_VAT_RATE=0.25
# CASTING_WHATSAPP_COST_NOK=0.34

# WhatsApp-faktura-sync — daglig sweep aggregerer uavfakturerte
# casting_whatsapp_usage-rader til Stripe invoice items.
# CASTING_WHATSAPP_INVOICE_RUNNER_ENABLED=true
# CASTING_WHATSAPP_INVOICE_INTERVAL_HOURS=24

# ── Google Workspace OAuth (Role Room) ────────────────────────
# Kreves for "Logg inn med Google"-flowen i Role Room.
# Hent client_id + secret fra Google Cloud Console → OAuth 2.0 Client IDs.
# Redirect URI må matche EKSAKT: https://<din-domene>/api/role-room/google/oauth/callback
# Bytt prod-host i ROLE_ROOM_PUBLIC_URL (hvis annet enn theroleroom.com).
# ROLE_ROOM_GOOGLE_CLIENT_ID=
# ROLE_ROOM_GOOGLE_CLIENT_SECRET=
# ROLE_ROOM_GOOGLE_REDIRECT_URI=https://theroleroom.com/api/role-room/google/oauth/callback
# ROLE_ROOM_PUBLIC_URL=https://theroleroom.com
# ROLE_ROOM_PUBLIC_ORIGIN=https://theroleroom.com

# Google Workspace allow-list (#2 fra audit): kommaseparert liste over
# tillatte hd-claim-domener. TOM = tillat alle (også @gmail.com). Sett
# for å begrense login til kun din(e) klients Workspace-domene(r).
# ROLE_ROOM_GOOGLE_ALLOWED_DOMAINS=kunde1.no,kunde2.com

# Token-krypteringsnøkkel for lagrede OAuth-tokens (AES-256-GCM).
# Generer med: openssl rand -base64 32
# ROLE_ROOM_GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── 2FA / TOTP encryption ─────────────────────────────────────
# AES-256-GCM-nøkkel for TOTP-secrets i user_totp_secrets-tabellen.
# Kan dele ROLE_ROOM_TOKEN_ENCRYPTION_KEY hvis du vil ha samme nøkkel
# for alt, men separasjon er anbefalt for nøkkel-rotering.
# Generer med: openssl rand -base64 32
# TOTP_SECRET_ENCRYPTION_KEY=
# ROLE_ROOM_TOKEN_ENCRYPTION_KEY=

# ── Gmail SMTP (passord-reset, 2FA-koder, vault-reveal-koder) ─
# Brukes av password-reset-service, email-verification-service og flere.
# Lag en App Password i Google-kontoen din (krever 2FA på Google-kontoen).
# GMAIL_USER=noreply@dittfirma.no
# GMAIL_APP_PASSWORD=

# ── Capture-lagring (S3-kompatibel — produksjon: Backblaze B2) ──
# Fotos/video fra Capture-appen legges i en S3-kompatibel bucket. I
# produksjon bruker vi Backblaze B2 — sett endepunkt til B2 S3-regionen,
# f.eks. https://s3.eu-central-003.backblazeb2.com (kamel-regionen din).
# Cloudflare R2 fungerer også (de er begge S3-kompatible), men B2 er
# standard. Prefix brukes som rot-katalog for alle capture-objekter.
# CAPTURE_R2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# CAPTURE_R2_BUCKET=<b2-bucket-navn>
# CAPTURE_R2_ACCESS_KEY_ID=<b2-application-key-id>
# CAPTURE_R2_SECRET_ACCESS_KEY=<b2-application-key>
# CAPTURE_R2_PREFIX=capture/
# (Fallback: CLOUDFLARE_R2_ENDPOINT / CLOUDFLARE_R2_UPLOAD_BUCKET / R2_BUCKET
#  og CLOUDFLARE_R2_ACCESS_KEY_ID / CLOUDFLARE_R2_SECRET_ACCESS_KEY.)

# ── Public app URL (for klient-portal-magic-links) ────────────
# Brukes til å bygge full magic-link-URL i e-poster (client-portal,
# password-reset, etc.). Hvis ikke satt, brukes relative paths.
# PUBLIC_APP_URL=https://creatorhub.no
# APP_URL=https://creatorhub.no

# ── The Role Room private object storage (AWS S3) ───────────
# Documents and images use a private S3 bucket. Cloudflare is only used for
# Stream video. Never expose these credentials to Vite/browser variables.
# ROLE_ROOM_STORAGE_PROVIDER=aws_s3
# Production Render runtime uses managed OIDC. Render injects
# AWS_WEB_IDENTITY_TOKEN_FILE after deploy; never set that path manually.
# AWS_ROLE_ARN=arn:aws:iam::745600963362:role/TheRoleRoomStorageRuntimeProd
# The static values below are migration/local fallback credentials only.
# AWS_ROLE_ROOM_ACCESS_KEY_ID=
# AWS_ROLE_ROOM_SECRET_ACCESS_KEY=
# AWS_ROLE_ROOM_SESSION_TOKEN=
# AWS_ROLE_ROOM_BUCKET_NAME=the-role-room-prod-745600963362-eu-north-1
# AWS_ROLE_ROOM_REGION=eu-north-1
#
# Organization-owned storage billing. The base quota follows the main Role
# Room plan; only optional add-ons use dedicated recurring Stripe Prices.
# Do not reuse the old composer_r2_gb_month meter or Leadgrid/seat Price IDs.
# ROLE_ROOM_STORAGE_PRICE_EXTRA_100_GIB_MONTHLY=
# ROLE_ROOM_STORAGE_PRICE_EXTRA_1_TIB_MONTHLY=
# Keep disabled until bandwidth/fair-use enforcement is configured.
ROLE_ROOM_STORAGE_1_TIB_CHECKOUT_ENABLED=false
# ROLE_ROOM_STORAGE_BILLING_PORTAL_CONFIGURATION_ID=
# ROLE_ROOM_STORAGE_PAYMENT_GRACE_DAYS=7
# Stripe Connect affiliate payouts remain fail-closed until onboarding,
# webhook reconciliation and a test-mode batch have been verified.
ROLE_ROOM_AFFILIATE_PAYOUTS_ENABLED=false
# ROLE_ROOM_AFFILIATE_PAYOUT_CRON_SECRET=
# Signing secret for /api/role-room/billing/connect-webhook. This is the
# connected-account endpoint, not the platform STRIPE_WEBHOOK_SECRET.
# ROLE_ROOM_STRIPE_CONNECT_WEBHOOK_SECRET=
# Direct S3 single-PUT maximum; defaults to 2 GiB and is capped at 5 GiB.
# ROLE_ROOM_STORAGE_MAX_SINGLE_UPLOAD_BYTES=2147483648
#
# Rollback/source settings during the non-destructive B2 migration:
# B2_ROLE_ROOM_APPLICATION_KEY_ID=
# B2_ROLE_ROOM_APPLICATION_KEY=
# B2_ROLE_ROOM_BUCKET_NAME=the-role-room-prod
# B2_REGION=eu-central-003

# ── Video Room delivery (Cloudflare Stream) ────────────────
# Stream handles resumable TUS/import-by-link, adaptive HLS, captions and
# signed playback. Sound Room audio remains in private AWS S3.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# Value after "customer-" and before ".cloudflarestream.com".
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
# Signed playback is mandatory unless explicitly disabled in local debugging.
# CLOUDFLARE_STREAM_REQUIRE_SIGNED_URLS=1
# Full-file Video Room QC worker. Docker/system binaries are used by default.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# VIDEO_QC_TIMEOUT_MINUTES=120
# Extra HTTPS host suffixes for legacy file_url rows only. S3/Stream URLs are
# generated internally and do not use this allow-list.
# VIDEO_QC_ALLOWED_MEDIA_HOSTS=media.example.com

# ── LinkedIn / TikTok / Instagram OAuth ───────────────────────
# Egne client_id + secret + token-encryption-key per platform.
# ROLE_ROOM_LINKEDIN_CLIENT_ID=
# ROLE_ROOM_LINKEDIN_CLIENT_SECRET=
# Må være registrert nøyaktig i LinkedIn Developer Portal.
# ROLE_ROOM_LINKEDIN_REDIRECT_URI=https://theroleroom.com/api/auth/linkedin/callback
# ROLE_ROOM_LINKEDIN_TOKEN_ENCRYPTION_KEY=
# Cockpit kan bruke samme app via ROLE_ROOM_* over, eller disse aliasene.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Ads OAuth gjenbruker paret over. Disse kan settes hvis Ads skal bruke en
# separat LinkedIn-app:
# LINKEDIN_ADS_OAUTH_CLIENT_ID=
# LINKEDIN_ADS_OAUTH_CLIENT_SECRET=
# Primær callback bygges fra PUBLIC_BACKEND_URL. Med dagens Render-base må
# denne registreres nøyaktig på appen som brukes til Ads OAuth:
# https://creatorhub-backend-rtbl.onrender.com/api/admin-room/agent/ads/oauth/linkedin/callback
# Registrer også Role Room-callbacken:
# https://theroleroom.com/api/role-room/ads/linkedin/oauth/callback
# Valgfri override; standard følger nyeste versjon som koden er testet mot.
# LINKEDIN_API_VERSION=202608
# Slå bare på etter separat LinkedIn Matched Audiences-godkjenning. Krever
# deretter ny LinkedIn Ads OAuth-tilkobling for å få rw_dmp_segments.
# LINKEDIN_MATCHED_AUDIENCES_ENABLED=false
# ROLE_ROOM_TIKTOK_CLIENT_KEY=
# ROLE_ROOM_TIKTOK_CLIENT_SECRET=
# ROLE_ROOM_TIKTOK_TOKEN_ENCRYPTION_KEY=

# ── Leadgrid workflow event ingress ───────────────────────────
# Use a separate random secret per organization AND event for normalized
# provider callbacks. Each value must be at least 32 characters. The API
# fails closed for a missing tenant/event entry. Example shape:
# {"<organization-uuid>":{"email.opened":"<secret>","contract.signed":"<secret>"}}
#
# HMAC producers send X-Leadgrid-Timestamp, X-Leadgrid-Delivery-Id and
# X-Leadgrid-Signature. Internal producers use the service token as a Bearer
# token together with timestamp + delivery id. Never put either secret in a
# browser or native-app bundle.
# LEADGRID_WORKFLOW_EVENT_SIGNING_SECRETS_JSON=
# LEADGRID_WORKFLOW_EVENT_SERVICE_TOKEN=

# ── Super-admin emergency login ──────────────────────────────
# Break-glass only. Identity is configured, then independently revalidated as
# an active users.role='super_admin' on every login. Never bundle either value
# in frontend/E2E source; tests use E2E_SUPER_ADMIN_* variables instead.
# SUPER_ADMIN_EMERGENCY_EMAIL=
# SUPER_ADMIN_EMERGENCY_TOKEN=
# Canvas optimistic concurrency is required by default. Enable only during a
# time-bounded legacy-client transition, then remove again.
CANVAS_ALLOW_MISSING_IF_MATCH=false

# Optional HMAC secret for opaque Canvas pagination cursors (minimum 16 bytes).
# Production should use a dedicated secret instead of reusing an auth token.
# CANVAS_CURSOR_SECRET=

# Canvas trash/orphan retention step in the existing daily Leadgrid cron.
# The step is OFF and the recurring cron is hard-pinned to dry-run. Rollout:
#   1) enable and inspect structured worker logs,
#   2) optionally enable legacy-orphan reporting,
#   3) request a separate production approval before wiring apply mode.
# CANVAS_RETENTION_WORKER_ENABLED=false
# CANVAS_RETENTION_WORKER_MODE=dry-run
# Reserved guard for a separately approved manual apply rollout. The daily
# cron ignores apply mode even when this phrase is configured.
# CANVAS_RETENTION_WORKER_DESTRUCTIVE_CONFIRMATION=
# CANVAS_RETENTION_WORKER_RECONCILE_ORPHANS=false
# CANVAS_RETENTION_WORKER_RETENTION_DAYS=30
# CANVAS_RETENTION_WORKER_BATCH_SIZE=100
