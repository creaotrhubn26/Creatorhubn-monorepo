{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatorhubn.com/schemas/protools-review-console-v1.json",
  "title": "CreatorHub Pro Tools Review Console IPC v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocolVersion", "requestId", "auth", "action"],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "auth": { "type": "string", "minLength": 32, "maxLength": 256 },
        "action": { "enum": ["health", "state", "feedback", "locate", "mark", "resolve", "reply", "snapshot", "send_review"] },
        "payload": { "type": "object", "maxProperties": 32 }
      }
    },
    {
      "type": "object",
      "required": ["protocolVersion", "ok"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string" },
        "ok": { "type": "boolean" },
        "result": {},
        "error": { "type": "string" }
      }
    }
  ]
}
