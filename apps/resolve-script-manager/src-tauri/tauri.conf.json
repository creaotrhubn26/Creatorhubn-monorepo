{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Role Room Post Agent",
  "version": "0.2.43",
  "identifier": "no.creatorhubn.roleroom-post-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Role Room Post Agent",
        "width": 1560,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "Developer ID Application: Creatorhub AS (9TAUZCPK95)"
    },
    "shortDescription": "DaVinci Resolve pipeline automation for videographers",
    "longDescription": "Run the full post-production pipeline — import, organize, timeline-build, sync, rough cut, render queue, backup — as scripted DaVinci Resolve actions with dry-run safety and live logs.",
    "resources": ["../python/**/*"],
    "createUpdaterArtifacts": "v1Compatible",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/creaotrhubn26/Creatorhubn-monorepo/releases/latest/download/post-agent-{{target}}-{{arch}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMDIyRDJEQzA1MDU0QUQKUldTdFZGREFMUzBDL2FmM0tQTGtOUFJ5bW05amJIUEtFajJJQVN2RWdDTVpBbGxNdXpHVUZmcnQK",
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["postagent"]
      }
    }
  }
}
