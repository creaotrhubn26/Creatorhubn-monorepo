{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notater",
  "version": "0.1.0",
  "identifier": "com.creatorhub.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1426",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notater",
        "width": 1360,
        "height": 820,
        "minWidth": 900,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Prosjektnotater med fulltekstsøk, helt offline",
    "longDescription": "Skriveflate for notatene i ~/CreatorHub-notater. Markdown på disk i git, indeksert lokalt med SQLite FTS5. Ingen nettverk, ingen API-nøkkel. Deler indeks og notatmappe med kommandolinjeverktøyet notat.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {}
}
