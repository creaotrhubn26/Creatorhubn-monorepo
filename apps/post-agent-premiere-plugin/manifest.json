{
  "manifestVersion": 5,
  "id": "no.creatorhubn.video-room-premiere",
  "name": "CreatorHub Video Room",
  "version": "0.3.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "creatorHubVideoRoomPanel",
      "label": { "default": "CreatorHub Video Room" },
      "minimumSize": { "width": 300, "height": 420 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 400, "height": 720 },
      "preferredFloatingSize": { "width": 480, "height": 780 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "https://creatorhubn.com",
        "https://www.creatorhubn.com",
        "https://upload.videodelivery.net"
      ]
    },
    "launchProcess": {
      "schemes": ["https"]
    }
  }
}
