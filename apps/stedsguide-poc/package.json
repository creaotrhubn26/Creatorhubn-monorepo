{
  "name": "stedsguide-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "POC: universelt utformet, flerspråklig lydguide for severdigheter (kart + nærmeste severdighet, synstolking, teksting, quick buy/abonnement)",
  "scripts": {
    "dev": "vite --port 1430 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1431 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
