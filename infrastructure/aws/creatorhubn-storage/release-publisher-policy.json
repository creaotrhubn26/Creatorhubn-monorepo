{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyApplicationReleases",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::creatorhubn-prod-745600963362-eu-north-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["platform/releases/protools-companion/*"]
        }
      }
    },
    {
      "Sid": "PublishOnlyProToolsCompanionReleases",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::creatorhubn-prod-745600963362-eu-north-1/platform/releases/protools-companion/*"
    }
  ]
}
