{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Intelligence Baseline",
  "type": "object",
  "required": [
    "project",
    "components"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "declared_version": {
            "type": "string"
          },
          "resolved_version": {
            "type": "string"
          },
          "version_evidence": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "criticality": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "api_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "symbol"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "canonical_symbol": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criticality": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risk_surfaces": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
