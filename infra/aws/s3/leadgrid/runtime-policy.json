{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLeadgridBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::leadgrid-prod-745600963362-eu-north-1"
    },
    {
      "Sid": "ListLeadgridMultipartUploads",
      "Effect": "Allow",
      "Action": "s3:ListBucketMultipartUploads",
      "Resource": "arn:aws:s3:::leadgrid-prod-745600963362-eu-north-1"
    },
    {
      "Sid": "ListLeadgridTenantPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::leadgrid-prod-745600963362-eu-north-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "organizations/*",
            "users/*",
            "temporary/*",
            "exports/*",
            "quarantine/*"
          ]
        }
      }
    },
    {
      "Sid": "ManageLeadgridTenantObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::leadgrid-prod-745600963362-eu-north-1/organizations/*",
        "arn:aws:s3:::leadgrid-prod-745600963362-eu-north-1/users/*",
        "arn:aws:s3:::leadgrid-prod-745600963362-eu-north-1/temporary/*",
        "arn:aws:s3:::leadgrid-prod-745600963362-eu-north-1/exports/*",
        "arn:aws:s3:::leadgrid-prod-745600963362-eu-north-1/quarantine/*"
      ]
    }
  ]
}
