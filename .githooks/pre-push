#!/usr/bin/env bash
# Pre-push: catches the two prod-deploy traps that have repeatedly broken
# Render and Vercel builds.
#   1. backend/package-lock.json drift — Dockerfile runs 'npm ci' standalone
#      in /app/backend, which fails if the lock isn't synced with package.json.
#   2. `await import('@/...')` — rollup (Vercel prod build) cannot resolve
#      the @ alias inside dynamic imports, even though local tsc passes.
#
# Skip with: `git push --no-verify` (use sparingly; both checks fix recurring
# outages, not stylistic concerns).

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

red()   { printf '\033[0;31m%s\033[0m\n' "$*"; }
green() { printf '\033[0;32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[0;33m%s\033[0m\n' "$*"; }

# ── Check 1: backend lock-file drift ──────────────────────────────────────
yellow "[pre-push] Checking backend/package-lock.json sync…"
TMP=$(mktemp)
cp backend/package-lock.json "$TMP"
(cd backend && npm install --workspaces=false --package-lock-only --silent >/dev/null 2>&1) || {
  cp "$TMP" backend/package-lock.json
  rm "$TMP"
  red "[pre-push] npm install --package-lock-only failed. Resolve manually before pushing."
  exit 1
}
if ! cmp -s backend/package-lock.json "$TMP"; then
  cp "$TMP" backend/package-lock.json
  rm "$TMP"
  red "[pre-push] backend/package-lock.json is out of sync with backend/package.json."
  red "           Render's 'npm ci' will fail (this trap has cost ~3 weeks of failed deploys)."
  yellow "Fix:"
  yellow "    cd backend && npm install --workspaces=false --package-lock-only"
  yellow "    git add backend/package-lock.json && git commit -m 'chore: sync backend lock'"
  exit 1
fi
rm "$TMP"
green "[pre-push] Lock-file in sync."

# ── Check 2: dynamic-import @-alias ───────────────────────────────────────
yellow "[pre-push] Scanning for await import('@/...') — rollup-incompatible…"
HITS=$(grep -rn "await import('@/" frontend/client/src/ --include="*.ts" --include="*.tsx" 2>/dev/null || true)
if [ -n "$HITS" ]; then
  red "[pre-push] Found dynamic imports using '@/' alias — Vercel rollup-build will fail:"
  printf '%s\n' "$HITS" | sed 's/^/    /'
  yellow "Fix: replace '@/<path>' with a relative path (e.g. '../services/foo')."
  exit 1
fi
green "[pre-push] No rollup-incompatible dynamic imports."

green "[pre-push] All checks passed."

# ── Check 3: frontend tsc on changed files ───────────────────────────────
# Catches identifier redeclarations + type errors before they reach CI.
# Limited to changed files (since prior commit) so check stays fast.
# Skip with: FAST_PUSH=1 git push
if [ "${FAST_PUSH:-0}" != "1" ]; then
  CHANGED_FRONTEND=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD 2>/dev/null | grep -E "^frontend/client/src/.*\.(ts|tsx)$" | grep -v "/unused/" || true)
  if [ -n "$CHANGED_FRONTEND" ]; then
    NUM=$(echo "$CHANGED_FRONTEND" | wc -l | tr -d ' ')
    yellow "[pre-push] tsc on $NUM changed frontend file(s)…"
    cd frontend
    # tsc --noEmit on the whole project but filter errors to changed files.
    # Faster than per-file because tsc still resolves the whole project.
    TSC_OUT=$(npx tsc --noEmit --skipLibCheck 2>&1 || true)
    cd "$ROOT"
    # Filter tsc output to only errors in our changed files
    ERRORS=""
    for f in $CHANGED_FRONTEND; do
      # tsc paths in output are relative to frontend/, drop the prefix
      REL=$(echo "$f" | sed 's|^frontend/||')
      M=$(echo "$TSC_OUT" | grep -E "^$REL\(" || true)
      if [ -n "$M" ]; then ERRORS="$ERRORS$M"$'\n'; fi
    done
    if [ -n "$ERRORS" ]; then
      red "[pre-push] tsc errors in changed frontend files (build vil feile på CI):"
      printf '%s' "$ERRORS" | sed 's/^/    /'
      yellow "Fix lokalt, eller bruk FAST_PUSH=1 git push for å hoppe over."
      exit 1
    fi
    green "[pre-push] tsc clean on changed frontend files."
  fi
fi
