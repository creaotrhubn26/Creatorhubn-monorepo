# Lead Map iPad — fastlane Fastfile
#
# Hva dette dekker:
#   * fastlane ios beta       — archive + upload til TestFlight
#   * fastlane ios release    — archive + upload til App Store Review
#   * fastlane ios bump_build — øk CFBundleVersion
#
# Hva dette IKKE dekker:
#   * Opprette app-recordet i App Store Connect (engangs-step manuelt)
#   * aps-environment-entitlement (lagt til i project.yml)
#
# Auth-credentials (env vars, ALDRI committed):
#   APP_STORE_CONNECT_API_KEY_ID
#   APP_STORE_CONNECT_API_ISSUER_ID
#   APP_STORE_CONNECT_API_KEY_CONTENT  (.p8 base64-encoded)

require "base64"
require "fileutils"

default_platform(:ios)

APP_IDENTIFIER = "com.creatorhubn.LeadMapApp"
SCHEME         = "LeadMapApp"
PROJECT        = "LeadMapApp.xcodeproj"

platform :ios do
  before_all do
    # XcodeGen-prosjektet må regenereres før hver beta-bygging i tilfelle
    # project.yml er oppdatert siden sist.
    sh("cd .. && xcodegen generate")
  end

  desc "Bump CFBundleVersion by 1"
  lane :bump_build do
    increment_build_number(xcodeproj: PROJECT)
  end

  desc "Archive + upload til TestFlight"
  lane :beta do
    setup_api_key
    download_app_store_profiles
    bump_build

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: File.expand_path("ExportOptions.plist", __dir__),
      clean: true,
      output_directory: "build/",
      output_name: "LeadMap.ipa",
      xcargs: xcodebuild_auth_xcargs,
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("Fant ingen IPA etter build_app") unless ipa_path && File.exist?(ipa_path)
    ipa_mb = (File.size(ipa_path) / 1_000_000.0).round(1)
    UI.message("IPA klar for upload: #{ipa_path} (#{ipa_mb} MB)")
    UI.user_error!("IPA er #{ipa_mb} MB (> 200 MB) — Apple avviser") if ipa_mb > 200

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: File.exist?("changelog.txt") ? File.read("changelog.txt") : nil,
    )
  end

  desc "Archive + submit for App Store Review"
  lane :release do
    setup_api_key
    download_app_store_profiles
    bump_build

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: File.expand_path("ExportOptions.plist", __dir__),
      clean: true,
      output_directory: "build/",
      output_name: "LeadMap.ipa",
      xcargs: xcodebuild_auth_xcargs,
    )

    upload_to_app_store(
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: true,
    )
  end

  # Skriv .p8-nøkkelen til disk slik at xcodebuild -allowProvisioningUpdates
  # kan hente profiler/cert via App Store Connect API. fastlane's
  # app_store_connect_api_key alene gjør IKKE nøkkelen tilgjengelig for
  # xcodebuild — den må passere som -authenticationKey* args (Xcode 13+).
  private_lane :setup_api_key do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

    unless key_id && issuer_id && key_content
      UI.important("ASC API-creds er ikke satt — fastlane vil falle tilbake til lokal Xcode-konto (lokal dev)")
      return
    end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true,
      duration: 1200,
      in_house: false,
    )

    # Også skriv .p8 til disk + eksporter env-vars for xcargs-helperen
    pkey_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(pkey_dir)
    pkey_path = File.join(pkey_dir, "AuthKey_#{key_id}.p8")
    decoded = Base64.decode64(key_content)
    File.write(pkey_path, decoded)
    ENV["ASC_KEY_PATH"]    = pkey_path
    ENV["ASC_KEY_ID"]      = key_id
    ENV["ASC_ISSUER_ID"]   = issuer_id
    UI.success("ASC API-nøkkel skrevet til #{pkey_path}")
  end

  # Last ned/regenerer App Store-profiler så de peker på cert-en vi har
  # lokalt på CI (Apple Distribution importert til midlertidig keychain
  # fra BUILD_CERTIFICATE_BASE64-secret).
  #
  # `force: true` lar sigh regenerere profilen hvis den eksisterende hos
  # Apple peker på en cert vi ikke har private key for (readonly er
  # gjensidig ekskluderende med force og må droppes). `provisioning_name`
  # matcher de Daniel laget manuelt 2026-06-25 så ExportOptions.plist sin
  # provisioningProfiles-mapping fortsatt fungerer.
  private_lane :download_app_store_profiles do
    # iOS-bundles (hovedapp + widget-extension).
    [
      { bundle: "com.creatorhubn.LeadMapApp",               name: "LeadMap App Store" },
      { bundle: "com.creatorhubn.LeadMapApp.LeadMapWidget", name: "LeadMap Widget App Store" },
    ].each do |cfg|
      sigh(
        app_identifier: cfg[:bundle],
        provisioning_name: cfg[:name],
        force: true,
        platform: "ios",
      )
    end

    # watchOS-bundle (LeadgridWatchApp, roadmap #403).
    # Bundle ID com.creatorhubn.LeadMapApp.watchkitapp er allerede
    # registrert paa Apple (id=NRTYB9NHTP, opprettet via ASC API
    # POST /v1/bundleIds 2026-06-28) — sigh kan derfor opprette
    # provisioning-profile direkte uten produce-fallback.
    sigh(
      app_identifier: "com.creatorhubn.LeadMapApp.watchkitapp",
      provisioning_name: "LeadMap Watch App Store",
      force: true,
      platform: "ios",
    )
  end

  # Returnerer xcargs-streng med auth-flags hvis ASC-nøkkel er satt opp,
  # ellers bare -allowProvisioningUpdates (lokal dev).
  private_lane :xcodebuild_auth_xcargs do
    args = ["-allowProvisioningUpdates"]
    if ENV["ASC_KEY_PATH"] && ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
      args << "-authenticationKeyPath #{ENV['ASC_KEY_PATH']}"
      args << "-authenticationKeyID #{ENV['ASC_KEY_ID']}"
      args << "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    end
    args.join(" ")
  end
end
