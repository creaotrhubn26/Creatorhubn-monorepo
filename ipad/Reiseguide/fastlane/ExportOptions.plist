<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store</string>
    <key>teamID</key>
    <string>9TAUZCPK95</string>
    <!--
        Manuell signering, samme som LeadMapApp: Xcodes cloud signing feiler
        for teamet («Cloud signing permission error»), så vi peker direkte på
        App Store-profilen som fastlane (sigh) henter før arkivering.
        Profilnavnet må matche PROFILE_NAME i Fastfile.
    -->
    <key>signingStyle</key>
    <string>manual</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>com.creatorhubn.reiseguide</key>
        <string>SenseAid Explore App Store</string>
    </dict>
    <key>uploadBitcode</key>
    <false/>
    <key>uploadSymbols</key>
    <true/>
    <key>compileBitcode</key>
    <false/>
    <key>destination</key>
    <string>export</string>
    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
