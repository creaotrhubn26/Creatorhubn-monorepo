# SenseAid Explore (ipad/Reiseguide) — fastlane Fastfile
#
# Hva dette dekker:
#   * fastlane ios beta        — archive + upload til TestFlight
#   * fastlane ios release     — archive + upload til App Store Review (ikke submit)
#   * fastlane ios bump_build  — sett CFBundleVersion til UTC-tidsstempel
#
# Engangs-steg mot Apple: bundle-ID-ene registreres automatisk (ensure_bundle_ids,
# ASC API POST /v1/bundleIds) og App Store-profilene lages av sigh — én for
# hovedappen, én for ReiseguideWidgets-extension-en (pakke 2, item 6: Live
# Activity på låseskjerm/Dynamic Island). App-recordet i App Store Connect kan
# IKKE lages via API-et (Apples dokumentasjon for /v1/apps: «Don't use this
# API to create new apps», hentet 2026-09-18), så ensure_app_record stopper
# tidlig med beskjed til den som må klikke i ASC — extension-en trenger IKKE
# noe eget app-record. Testere legges til i ASC, se ../TESTFLIGHT.md.
#
# Samme mønster som ipad/LeadMapApp (manuell signering med importert
# «Apple Distribution»-cert + App Store-profil(er) hentet av sigh), fordi
# Xcodes cloud signing feiler for teamet («Cloud signing permission error»).
#
# Auth (env vars, ALDRI committed):
#   APP_STORE_CONNECT_API_KEY_ID
#   APP_STORE_CONNECT_API_ISSUER_ID
#   APP_STORE_CONNECT_API_KEY_CONTENT   (.p8 base64-encoded)

require "base64"
require "fileutils"

default_platform(:ios)

APP_IDENTIFIER = "com.creatorhubn.reiseguide"
APP_NAME       = "SenseAid Explore"
PROFILE_NAME   = "SenseAid Explore App Store"
SCHEME         = "Reiseguide"
PROJECT        = "Reiseguide.xcodeproj"
IPA_NAME       = "SenseAidExplore.ipa"

# Alle iOS-bundles i prosjektet (hovedapp + widget-extension). Brukt av
# ensure_bundle_ids og download_app_store_profiles — samme liste-mønster som
# ipad/LeadMapApp/fastlane/Fastfile.
BUNDLES = [
  { bundle: APP_IDENTIFIER, name: APP_NAME, profile: PROFILE_NAME },
  { bundle: "com.creatorhubn.reiseguide.widgets", name: "SenseAid Explore Widgets", profile: "SenseAid Explore Widgets App Store" },
].freeze

platform :ios do
  before_all do
    # XcodeGen-prosjektet regenereres fra project.yml før hvert bygg.
    sh("cd .. && xcodegen generate")
  end

  desc "Sett CFBundleVersion til UTC-tidsstempel (unikt og strengt økende)"
  lane :bump_build do
    # xcodegen setter CURRENT_PROJECT_VERSION tilbake til «1» hver gang, så
    # +1 ville kollidert; tidsstempel er alltid høyere enn forrige opplasting.
    build_number = Time.now.utc.strftime("%Y%m%d%H%M%S")
    increment_build_number(build_number: build_number, xcodeproj: PROJECT)
    UI.message("SenseAid Explore buildnummer: #{build_number}")
  end

  desc "Archive + upload til TestFlight"
  lane :beta do
    setup_api_key
    ensure_bundle_ids
    download_app_store_profiles
    ensure_app_record
    bump_build

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: File.expand_path("ExportOptions.plist", __dir__),
      clean: true,
      output_directory: "build/",
      output_name: IPA_NAME,
      xcargs: xcodebuild_auth_xcargs,
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("Fant ingen IPA etter build_app") unless ipa_path && File.exist?(ipa_path)
    ipa_mb = (File.size(ipa_path) / 1_000_000.0).round(1)
    UI.message("IPA klar for upload: #{ipa_path} (#{ipa_mb} MB)")
    UI.user_error!("IPA er #{ipa_mb} MB (> 200 MB), Apple avviser") if ipa_mb > 200

    changelog_path = File.expand_path("changelog.txt", __dir__)
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: File.exist?(changelog_path) ? File.read(changelog_path) : nil,
    )
    UI.success("SenseAid Explore lastet opp til TestFlight")
  end

  desc "Archive + upload til App Store Review (submit er et manuelt steg)"
  lane :release do
    setup_api_key
    ensure_bundle_ids
    download_app_store_profiles
    ensure_app_record
    bump_build

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: File.expand_path("ExportOptions.plist", __dir__),
      clean: true,
      output_directory: "build/",
      output_name: IPA_NAME,
      xcargs: xcodebuild_auth_xcargs,
    )

    upload_to_app_store(
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: true,
    )
  end

  private_lane :setup_api_key do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

    unless key_id && issuer_id && key_content
      UI.important("ASC API-nøkkel er ikke satt; fastlane bruker Xcode-kontoen din (lokal dev)")
      next
    end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true,
      duration: 1200,
      in_house: false,
    )

    # xcodebuild -authenticationKey* trenger nøkkelen som fil.
    pkey_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(pkey_dir)
    pkey_path = File.join(pkey_dir, "AuthKey_#{key_id}.p8")
    File.write(pkey_path, Base64.decode64(key_content))
    ENV["ASC_KEY_PATH"]  = pkey_path
    ENV["ASC_KEY_ID"]    = key_id
    ENV["ASC_ISSUER_ID"] = issuer_id
    UI.success("ASC API-nøkkel skrevet til #{pkey_path}")
  end

  # Registrerer alle bundle-ID-ene (hovedapp + widget-extension) i Developer
  # Portal hvis de mangler (ASC API POST /v1/bundleIds; LeadMap-watch-bundlen
  # ble laget på samme måte). Krever at ASC-nøkkelen har App Manager- eller
  # Admin-rolle. Uten nøkkel (lokal dev) lar vi Xcode ordne det.
  private_lane :ensure_bundle_ids do
    unless lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
      UI.important("Ingen ASC-nøkkel; hopper over bundle-ID-sjekk (Xcode ordner det lokalt)")
      next
    end

    BUNDLES.each do |cfg|
      existing = Spaceship::ConnectAPI::BundleId.find(cfg[:bundle])
      if existing
        UI.message("Bundle-ID #{cfg[:bundle]} er registrert hos Apple (#{existing.id})")
      else
        UI.message("Registrerer bundle-ID #{cfg[:bundle]} («#{cfg[:name]}») i Developer Portal")
        created = Spaceship::ConnectAPI::BundleId.create(
          name: cfg[:name],
          identifier: cfg[:bundle],
          platform: "IOS",
        )
        UI.success("Bundle-ID registrert (#{created.id})")
      end
    end
  end

  # App-recordet i App Store Connect må finnes før upload_to_testflight, og
  # Apple tillater ikke å opprette det via API-et. Sjekken ligger før
  # build_app så en manglende record koster sekunder, ikke et 10-minutters bygg.
  private_lane :ensure_app_record do
    next unless lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    if app
      UI.success("App-record «#{app.name}» finnes i App Store Connect (#{app.id})")
      next
    end

    UI.user_error!(<<~MSG)
      Fant ikke app-record for #{APP_IDENTIFIER} i App Store Connect.
      Apple lar ikke API-et opprette app-records, så det må gjøres én gang på
      appstoreconnect.apple.com → My Apps → + → New App (se ../TESTFLIGHT.md steg 2):
        Platform: iOS · Name: #{APP_NAME} · Primary Language: Norwegian (Bokmål)
        Bundle ID: #{APP_IDENTIFIER} · SKU: SENSEAID-EXPLORE-01
      Bundle-ID-en og App Store-profilen er allerede på plass; kjør workflowen på nytt etterpå.
    MSG
  end

  # Henter (eller oppretter) de manuelle App Store-profilene for hver
  # bundle-ID så manual signing i ExportOptions.plist finner dem. force: true
  # regenererer mot cert-en som er importert i keychainen (samme mønster som
  # ipad/LeadMapApp/fastlane/Fastfile#download_app_store_profiles).
  private_lane :download_app_store_profiles do
    BUNDLES.each do |cfg|
      sigh(
        app_identifier: cfg[:bundle],
        provisioning_name: cfg[:profile],
        force: true,
        platform: "ios",
      )
    end
  end

  private_lane :xcodebuild_auth_xcargs do
    args = ["-allowProvisioningUpdates"]
    if ENV["ASC_KEY_PATH"] && ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
      args << "-authenticationKeyPath #{ENV['ASC_KEY_PATH']}"
      args << "-authenticationKeyID #{ENV['ASC_KEY_ID']}"
      args << "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    end
    args.join(" ")
  end
end
