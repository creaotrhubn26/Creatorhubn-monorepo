    "area.offline": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikk ikke hentet områdene. Du er kanskje uten nett. Viser områdene som er lagret på telefonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the areas. You may be offline. Showing the areas saved on your phone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke hente områderne. Du er måske uden net. Viser de områder, der er gemt på telefonen."
          }
        }
      }
    },
