    "askGuide.buttonHint": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still et spørsmål om stedet. Svaret bygger bare på guideteksten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question about this place. The answer is based only on the guide text."
          }
        }
      }
    },
    "askGuide.error.empty": {
      "extractionState": "manual",
      "localizations": {
