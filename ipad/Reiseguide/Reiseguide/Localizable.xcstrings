          "stringUnit": {
            "state": "translated",
            "value": "Skriv et spørsmål først."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a question first."
          }
        }
      }
    },
    "askGuide.error.generation": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Guiden klarte ikke å svare akkurat nå. Prøv igjen, eller spør på en annen måte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guide couldn't answer right now. Try again, or ask in a different way."
          }
        }
      }
    },
    "askGuide.fieldHint": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv, eller trykk på mikrofonen på tastaturet for å diktere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type, or tap the microphone on the keyboard to dictate."
          }
        }
      }
    },
    "askGuide.fieldLabel": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt spørsmål"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your question"
          }
        }
      }
    },
    "askGuide.footer": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene lages på telefonen med Apple Intelligence og bygger bare på guideteksten. De kan inneholde feil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers are made on your phone with Apple Intelligence and are based only on the guide text. They may contain mistakes."
          }
        }
      }
    },
    "askGuide.intro": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør om %@. Guiden svarer bare ut fra teksten i guiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about %@. The guide answers only from the guide text."
          }
        }
      }
    },
    "askGuide.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For eksempel: Hvor gammelt er dette?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: How old is this?"
          }
        }
      }
    },
    "askGuide.status.available": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgjengelig. Svarene lages på telefonen med Apple Intelligence, ut fra guideteksten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available. Answers are made on your phone with Apple Intelligence, from the guide text."
          }
        }
      }
    },
