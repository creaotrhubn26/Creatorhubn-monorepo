    "askGuide.footer": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene lages på telefonen med Apple Intelligence og bygger bare på guideteksten. De kan inneholde feil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers are made on your phone with Apple Intelligence and are based only on the guide text. They may contain mistakes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene laves på telefonen med Apple Intelligence og bygger kun på guideteksten. De kan indeholde fejl."
          }
        }
      }
    },
    "askGuide.intro": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør om %@. Guiden svarer bare ut fra teksten i guiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about %@. The guide answers only from the guide text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg om %@. Guiden svarer kun ud fra teksten i guiden."
          }
        }
      }
    },
    "askGuide.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For eksempel: Hvor gammelt er dette?"
