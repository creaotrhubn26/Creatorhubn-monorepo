    "askGuide.suggestion.1": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva er det viktigste å vite om stedet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is the most important thing to know about this place?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad er det vigtigste at vide om stedet?"
          }
        }
      }
    },
    "askGuide.suggestion.2": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem bygde det, og når?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who built it, and when?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem byggede det, og hvornår?"
          }
        }
      }
    },
    "askGuide.suggestion.3": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er det trinnfri tilgang her?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is there step-free access here?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er der niveaufri adgang her?"
          }
        }
      }
    },
    "askGuide.suggestionHint": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiller spørsmålet med en gang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks the question right away."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiller spørgsmålet med det samme."
          }
        }
      }
    },
