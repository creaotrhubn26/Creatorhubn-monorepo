    "settings.arrivalNotifications.explanationBody": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SenseAid Explore kan sende deg et varsel når du er ved en severdighet, selv når appen ikke er åpen. Dette krever at du gir «Alltid»-tilgang til posisjonen din. Du kan skru dette av når som helst i Innstillinger. Varselet starter ikke lyd av seg selv — du velger selv å trykke «Spill av»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SenseAid Explore can send you a notification when you're at a place, even when the app isn't open. This requires granting “Always” location access. You can turn this off anytime in Settings. The notification doesn't start playback on its own — you choose to tap “Play”."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SenseAid Explore kan sende dig en notifikation, når du er ved en seværdighed, også når appen ikke er åben. Det kræver, at du giver adgang til din position «Altid». Du kan slå det fra når som helst i Indstillinger. Notifikationen starter ikke lyd af sig selv — du vælger selv at trykke på «Afspil»."
          }
        }
      }
    },
    "settings.arrivalNotifications.explanationTitle": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsle meg ved ankomst?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me on arrival?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv mig besked ved ankomst?"
          }
        }
      }
    },
    "settings.arrivalNotifications.footer": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krever «Alltid»-posisjon. Varsler ikke mens appen er åpen — der vises kortet som vanlig. Åpner appen når du trykker «Spill av»; lyden starter først da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires Always location access. Doesn't notify while the app is open — the usual card appears there instead. Opens the app when you tap “Play”; playback starts then."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræver positionsadgang «Altid». Giver ikke besked, mens appen er åben — der vises kortet som sædvanligt. Åbner appen, når du trykker på «Afspil»; lyden starter først da."
          }
        }
      }
    },
