    "askGuide.error.generation": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Guiden klarte ikke å svare akkurat nå. Prøv igjen, eller spør på en annen måte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guide couldn't answer right now. Try again, or ask in a different way."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Guiden kunne ikke svare lige nu. Prøv igen, eller spørg på en anden måde."
          }
        }
      }
    },
