    "privacy.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggen og vurderingene dine slettes fra serveren, og appen får en ny enhets-ID. Loggen på telefonen beholdes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your log and ratings are deleted from the server and the app gets a new device ID. The log on this phone is kept."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din log og dine vurderinger slettes fra serveren, og appen får et nyt enheds-id. Loggen på telefonen bevares."
          }
        }
      }
    },
    "privacy.deleteConfirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slette alle data på serveren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all data on the server?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet alle data på serveren?"
          }
        }
      }
    },
    "privacy.footer": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggen ligger alltid på telefonen. Slår du dette på, lagres sted, tidspunkt, stjerner og quiz-resultat også på serveren, knyttet til en tilfeldig enhets-ID uten navn, konto eller posisjon. Dataene slettes automatisk etter ett år, når du slår av bryteren, eller når du sletter dem her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log always lives on your phone. If you turn this on, place, time, stars and quiz score are also stored on the server, tied to a random device ID without name, account or location. The data is deleted automatically after one year, when you turn this off, or when you delete it here."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggen ligger altid på telefonen. Slår du dette til, gemmes sted, tidspunkt, stjerner og quizresultat også på serveren, knyttet til et tilfældigt enheds-id uden navn, konto eller position. Dataene slettes automatisk efter et år, når du slår kontakten fra, eller når du sletter dem her."
          }
        }
      }
    },
