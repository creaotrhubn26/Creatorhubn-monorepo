    "privacy.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggen og vurderingene dine slettes fra serveren, og appen får en ny enhets-ID. Loggen på telefonen beholdes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your log and ratings are deleted from the server and the app gets a new device ID. The log on this phone is kept."
          }
        }
      }
    },
    "privacy.deleteConfirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
