# Set via env vars — ``fastlane`` reads these at runtime. Keeping
# them empty in the committed file avoids leaking the App Store
# team + Apple ID into git history.
app_identifier("com.creatorhubn.capture")
apple_id(ENV["FASTLANE_USER"] || "")
team_id(ENV["APP_STORE_TEAM_ID"] || "")
itc_team_id(ENV["APP_STORE_CONNECT_TEAM_ID"] || "")
