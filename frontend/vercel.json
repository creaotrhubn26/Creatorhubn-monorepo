{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "devCommand": "npm run dev",
  "redirects": [
    {
      "source": "/casting.html",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/theroleroom",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/theroleroom/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/talentportal/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/talentportal",
      "permanent": true
    },
    {
      "source": "/utdanningsinstitusjon/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/utdanningsinstitusjon",
      "permanent": true
    },
    {
      "source": "/casting.html",
      "destination": "/theroleroom",
      "permanent": true
    },
    {
      "source": "/theroleroom/",
      "destination": "/theroleroom",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom-robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom-sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/creatorhubn-robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/creatorhubn-sitemap.xml"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom.html"
    },
    {
      "source": "/talentportal",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom.html"
    },
    {
      "source": "/utdanningsinstitusjon",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom.html"
    },
    {
      "source": "/theroleroom",
      "destination": "/theroleroom.html"
    },
    {
      "source": "/data-deletion",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom-data-deletion.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom-privacy.html"
    },
    {
      "source": "/terms-and-conditions",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom-terms.html"
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?theroleroom\\.com"
        }
      ],
      "destination": "/theroleroom-terms.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://creatorhub-backend-rtbl.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
