{
  "name": "creatorhub-frontend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=12288' vite --port 5001 --strictPort",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:a11y": "sh ./scripts/run-axe-audit.sh",
    "audit:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "audit:all": "npm run audit:a11y && npm run audit:lighthouse",
    "typecheck:story-arc-studio": "node scripts/typecheck-story-arc-studio.mjs",
    "typecheck:professional-timeline": "tsc -p tsconfig.professional-timeline.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "test:unit": "vitest run --config vitest.config.ts client/src/components/story-arc-studio",
    "test:unit:watch": "vitest --config vitest.config.ts client/src/components/story-arc-studio",
    "test:e2e": "playwright test",
    "test:e2e:story-arc-regression": "playwright test e2e/story-arc-regression.spec.ts --project=chromium",
    "test:e2e:visual-editor-regression": "playwright test e2e/visual-editor-regression.spec.ts --project=chromium",
    "test:e2e:visual-editor-hardened": "playwright test e2e/visual-editor-regression.spec.ts --project=chromium --repeat-each=2 --retries=1",
    "test:e2e:story-arc-edit-tools": "playwright test e2e/story-arc-edit-tools-isolated.spec.ts --project=chromium",
    "test:e2e:timeline-render-budget": "playwright test e2e/professional-timeline-render-budget.spec.ts --project=chromium",
    "test:e2e:story-arc-full": "playwright test e2e/story-arc-regression.spec.ts e2e/story-arc-edit-tools-isolated.spec.ts --project=chromium",
    "test:e2e:story-arc-regression:stable": "playwright test e2e/story-arc-regression.spec.ts --project=chromium --repeat-each=2",
    "test:e2e:story-arc-hardened": "playwright test e2e/story-arc-regression.spec.ts e2e/story-arc-edit-tools-isolated.spec.ts e2e/professional-timeline-render-budget.spec.ts --project=chromium --repeat-each=2 --retries=1",
    "test:e2e:storyboard-drawing-editor": "playwright test e2e/storyboard-drawing-editor.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:google-workspace-sso": "node scripts/google-workspace-sso-smoke.mjs",
    "test:google-workspace-live": "node scripts/google-workspace-live-matrix.mjs"
  },
