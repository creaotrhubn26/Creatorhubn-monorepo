# Backend API URL
# Note: Vite reads runtime frontend env vars from frontend/client/.env.*
# Keep the same VITE_* values in frontend/client/.env.local or frontend/client/.env.production.
VITE_API_URL=https://backend-djm5.onrender.com

# For local development, use:
# VITE_API_URL=http://localhost:5050

# Google Analytics / Google tag
# CreatorHub and The Role Room run in the same GA4 property with separate web streams.
# These are public measurement/container identifiers, not secrets.
VITE_CREATORHUB_GA_MEASUREMENT_ID=G-6E5MJT8REW
VITE_ROLE_ROOM_GA_MEASUREMENT_ID=G-9T7K5TJVFX
VITE_GOOGLE_TAG_MANAGER_ID=GTM-MFWW7X83

# Optional paid media pixels
# Meta Pixel covers both Facebook and Instagram ads inside Meta Ads Manager.
VITE_CREATORHUB_META_PIXEL_ID=1886226702029036
VITE_ROLE_ROOM_META_PIXEL_ID=1282335783868606
VITE_CREATORHUB_TIKTOK_PIXEL_ID=
VITE_ROLE_ROOM_TIKTOK_PIXEL_ID=

# Google Scholar Research Integration (Virtual Studio)
# Get your API key from https://serpapi.com
# Pricing: $50/month for 5,000 searches
# This enables automatic research-based optimization of rendering features
VITE_SERPAPI_KEY=your_serpapi_key_here

# ── Error monitoring ─────────────────────────────────────────────────────
# Sentry — uten DSN er error-tracking deaktivert; main.tsx logger
# "Sentry is not configured" ved oppstart hvis denne mangler.
# Hent DSN fra Sentry-prosjektet ditt: sentry.io/settings/projects/X/keys/
VITE_SENTRY_DSN=

# ── Microsoft Clarity ────────────────────────────────────────────────────
# Hardkodet i client/index.html — projektID for begge tjenestene:
#   CreatorHub: wqg9kj1vxt
#   Role Room:  wqgcu06tz0
# Endre dem i client/index.html hvis du går til egen Clarity-konto.
