                },
                  {
                    title: 'Portfolio Gjennomgang',
                    client: 'Bergen Musikk A',
                    time: '16:30 - 17:3',
                    type: 'video',
                    status: 'upcoming',
                },
                  {
                    title: 'Prosjekt Status Møte',
                    client: 'Norsk Film Studio',
                    time: '19:00 - 19:3',
