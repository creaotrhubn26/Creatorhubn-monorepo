                    <div className="flex-1">
                      <h4 className="font-bold text-gray-800 text-sm">{meeting.title}</h4>
                      <p className="text-xs text-gray-600">{meeting.client}</p>
                      <p className="text-xs text-amber-600 font-medium">{meeting.time}</p>
