        >
          <DialogTitle>
            Lagre Video Prosjekt
          </DialogTitle>
          <DialogContent>
            <Stack spacing={3} sx={{ mt: 1 }}>
              <FormControl fullWidth>
                <InputLabel>Lagringstype</InputLabel>
                <Select
                  value={saveAsType}
                  onChange={(e) => setSaveAsType(e.target.value as 'overwrite' | 'new' | 'download')}
                  label="Lagringstype"
                >
                  <MenuItem value="overwrite">
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                      <CloudUpload />
                      Overskrive eksisterende
                    </Box>
                  </MenuItem>
                  <MenuItem value="new">
