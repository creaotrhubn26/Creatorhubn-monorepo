                        <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, width: '100%' }}>
                          <Chip 
                            label={change.type.replace('_', ' ')} 
                            size="small"
                            color={change.type === 'sequence_edit' ? 'primary' : 
                                   change.type === 'color_grade' ? 'secondary' :
                                   change.type === 'multicam_sync' ? 'success' : 'default'}
                          />
                          <Typography variant="body2" sx={{ flex: 1 }}>
                            {change.description}
                          </Typography>
                          <Typography variant="caption" color="text.secondary">
                            {change.timestamp}
