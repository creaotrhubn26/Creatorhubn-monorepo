                      <History />
                      Lagre som ny versjon
                    </Box>
                  </MenuItem>
                  <MenuItem value="download">
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                      <Download />
                      Lagre til datamaskin
                    </Box>
                  </MenuItem>
                </Select>
              </FormControl>

              {saveAsType === 'new' && (
                <TextField
                  fullWidth
                  label="Prosjektnavn"
                  value={saveAsName}
                  onChange={(e) => setSaveAsName(e.target.value)}
                  placeholder="Skriv inn navn for ny versjon..."
                  helperText="Eksempel: Bryllup_Film_V3, Highlight_Final_Version"
                />
              )}

              <Paper sx={{ p: 2, bgcolor: 'grey.50' }}>
                <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                  {saveAsType === 'overwrite' ? 'Overskrive eksisterende:' : 'Ny versjon vil inneholde:'}
                </Typography>
                <List dense>
                  <ListItem>
                    <ListItemText primary="Alle videosekvenser og kapitler" />
                  </ListItem>
