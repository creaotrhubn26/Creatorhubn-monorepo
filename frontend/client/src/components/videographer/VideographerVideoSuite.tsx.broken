          </Button>
          <Button 
            variant="contained" 
            onClick={handleSocialMediaExport}
            disabled={isProcessing}
            sx={{ bgcolor: '#e91e63' }}
          >
            {isProcessing ? 'Prosesserer...' : 'Start Optimalisering'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* Algorithm Optimizer Dialog */}
      <Dialog open={algorithmOptimizerOpen} onClose={() => setAlgorithmOptimizerOpen(false)} maxWidth="lg" fullWidth>
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1, bgcolor: '#9c27b0', color: 'white' }}>
          <SmartToy />
          Algoritme Optimizer - Intelligent Video Analyse
        </DialogTitle>
        <DialogContent sx={{ p: 3 }}>
          <Typography variant="body1" sx={{ mb: 3 }}>
            Analyser og optimaliser {selectedVideoFiles.length || 1} video{(selectedVideoFiles.length || 1) !== 1 ? 'er' : ''} for maksimal reach og engagement
          </Typography>
          
          <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
              <Paper sx={{ p: 2 }}>
                <Typography variant="h6" sx={{ mb: 2, display: 'flex', alignItems: 'center', gap: 1 }}>
                  <Analytics />
                  Hook Analyse (3 første sekunder)
                </Typography>
                <Box sx={{ mb: 2 }}>
                  <Typography gutterBottom>Hook Styrke</Typography>
                  <Slider
                    defaultValue={85}
                    min={0}
                    max={100}
                    valueLabelDisplay="auto"
                    valueLabelFormat={(value) => `${value}%`}
                  />
                </Box>
                <Typography variant="body2" color="text.secondary">
                  Optimerer åpningssekvens for maksimal attention capture
                </Typography>
              </Paper>
            </Grid>

            <Grid item xs={12} md={6}>
              <Paper sx={{ p: 2 }}>
                <Typography variant="h6" sx={{ mb: 2, display: 'flex', alignItems: 'center', gap: 1 }}>
                  <Speed />
                  Pacing Optimalisering
                </Typography>
                <Box sx={{ mb: 2 }}>
                  <Typography gutterBottom>Tempo Score</Typography>
                  <Slider
                    defaultValue={92}
                    min={0}
                    max={100}
                    valueLabelDisplay="auto"
                    valueLabelFormat={(value) => `${value}%`}
                  />
                </Box>
                <Typography variant="body2" color="text.secondary">
                  Justerer klipping og overganger for optimal retention
                </Typography>
              </Paper>
            </Grid>

            <Grid item xs={12}>
              <Paper sx={{ p: 2 }}>
                <Typography variant="h6" sx={{ mb: 2 }}>
                  Trend Integration & Hashtag Optimizer
                </Typography>
                <Grid container spacing={2}>
                  <Grid item xs={12} md={4}>
                    <Typography variant="body2" color="text.secondary">Trend Score</Typography>
                    <Typography variant="h4" sx={{ color: '#9c27b0', fontWeight: 'bold' }}>88%</Typography>
                  </Grid>
                  <Grid item xs={12} md={4}>
                    <Typography variant="body2" color="text.secondary">Hashtag Reach</Typography>
                    <Typography variant="h4" sx={{ color: '#9c27b0', fontWeight: 'bold' }}>2.5M</Typography>
                  </Grid>
                  <Grid item xs={12} md={4}>
                    <Typography variant="body2" color="text.secondary">Viral Potential</Typography>
                    <Typography variant="h4" sx={{ color: '#9c27b0', fontWeight: 'bold' }}>73%</Typography>
                  </Grid>
                </Grid>
              </Paper>
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setAlgorithmOptimizerOpen(false)}>
            Lukk
          </Button>
          <Button variant="contained" sx={{ bgcolor: '#9c27b0' }}>
            Utfør Optimalisering
          </Button>
        </DialogActions>
      </Dialog>
  );
}