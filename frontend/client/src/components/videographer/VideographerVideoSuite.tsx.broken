                  </ListItem>
                  <ListItem>
                    <ListItemText primary="Kommentarer og review-runder" />
                  </ListItem>
                </List>
              </Paper>
            </Stack>
          </DialogContent>
          <DialogActions>
            <Button onClick={() => setSaveAsDialogOpen(false)}>
              Avbryt
            </Button>
            <Button 
              variant="contained"
              disabled={saveAsType === 'new' && !saveAsName.trim()}
              onClick={() => {
                if (saveAsType === 'download') {
                  handleDownloadToComputer();
                } else {
                  // Handle save logic here
                  console.log('Lagrer video som:', saveAsType, saveAsName);
                }
                setSaveAsDialogOpen(false);
                setSaveAsName('');
              }}
            >
              {saveAsType === 'overwrite' ? 'Overskrive' : 
             saveAsType === 'download' ? 'Last ned til datamaskin' : 'Lagre som ny'}
            </Button>
          </DialogActions>
