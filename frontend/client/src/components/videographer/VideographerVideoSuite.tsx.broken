                        </Box>
                      </AccordionSummary>
                      <AccordionDetails>
                        <Grid container spacing={2}>
                          <Grid item xs={12} md={6}>
                            <Typography variant="body2" color="text.secondary">
                              <strong>Versjon:</strong> {change.version}
                            </Typography>
                            <Typography variant="body2" color="text.secondary">
                              <strong>Timecode:</strong> {change.timecode}
                            </Typography>
                            <Typography variant="body2" color="text.secondary">
                              <strong>Bruker:</strong> {change.user}
