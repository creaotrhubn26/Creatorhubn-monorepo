                    { format: 'Bryllup Highlight', count: 8, percentage: 45 },
                    { format: 'Sosiale Medier Innhold', count: 5, percentage: 28 },
                    { format: 'Bedriftsvideoer', count: 3, percentage: 17 },
                    { format: 'Musikkvideo', count: 2, percentage: 10 }
                  ].map((format, idx) => (
                    <Box key={idx} sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                      <Typography sx={{ minWidth: 120 }}>{format.format}</Typography>
                      <Box sx={{ 
                        flex: 1, 
