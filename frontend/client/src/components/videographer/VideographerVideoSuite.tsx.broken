    { id: 'facebook', name: 'Facebook', icon: <Facebook />, formats: ['Post (16:9)', 'Story (9:16)', 'Cover (16:9)'] },
    { id: 'twitter', name: 'Twitter/X', icon: <Twitter />, formats: ['Post (16:9)', 'Video Tweet (1:1)'] },
