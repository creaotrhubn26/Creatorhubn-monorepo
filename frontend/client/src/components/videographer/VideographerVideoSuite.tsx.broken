                    { timecode: '00:03:45', comment: 'Perfekt øyeblikk! Kan vi få slow motion?', author: 'Klient', status: 'Under arbeid' },
                    { timecode: '00:05:12', comment: 'Kan vi korte ned denne sekvensen?', author: 'Klient', status: 'Løst' }
