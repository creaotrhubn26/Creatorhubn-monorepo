    {/* Social Media Format Dialog */}
    <Dialog open={socialMediaDialogOpen} onClose={() => setSocialMediaDialogOpen(false)} maxWidth="md" fullWidth>
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1, bgcolor: '#e91e63', color: 'white' }}>
          <Share />
          Sosiale Medier Format Optimizer
        </DialogTitle>
        <DialogContent sx={{ p: 3 }}>
          <Typography variant="body1" sx={{ mb: 3 }}>
            Optimaliser {selectedVideoFiles.length || 1} video{(selectedVideoFiles.length || 1) !== 1 ? 'er' : ''} for sosiale medier
          </Typography>
          
          <FormControl fullWidth sx={{ mb: 2 }}>
            <InputLabel>Plattform</InputLabel>
            <Select value={selectedPlatform} onChange={(e) => setSelectedPlatform(e.target.value)}>
              {socialPlatforms.map((platform) => (
                <MenuItem key={platform.id} value={platform.id}>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                    {platform.icon}
                    {platform.name}
                  </Box>
                </MenuItem>
              ))}
            </Select>
          </FormControl>

          <FormControl fullWidth sx={{ mb: 2 }}>
            <InputLabel>Format</InputLabel>
            <Select value={selectedSocialFormat} onChange={(e) => setSelectedSocialFormat(e.target.value)}>
              {socialPlatforms.find(p => p.id === selectedPlatform)?.formats.map((format, idx) => (
                <MenuItem key={idx} value={format}>
                  {format}
                </MenuItem>
              ))}
            </Select>
          </FormControl>

          <FormControlLabel
            control={<Switch defaultChecked />}
            label="Legg til automatiske undertekster"
            sx={{ mb: 2 }}
          />

          <FormControlLabel
            control={<Switch defaultChecked />}
            label="Optimaliser for mobile visning"
            sx={{ mb: 2 }}
          />

          {isProcessing && (
            <Box sx={{ mt: 2 }}>
              <LinearProgress variant="determinate" value={processingProgress} sx={{ mb: 1 }} />
              <Typography variant="body2" color="text.secondary">
                Prosesserer: {processingProgress}% fullført
              </Typography>
            </Box>
          )}
        </DialogContent>
