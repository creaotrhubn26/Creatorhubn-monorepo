import { useTheming } from '../../utils/theming-helper';
import React, { useState } from 'react';
import { apiRequest } from '@/lib/queryClient';
import { useQuery } from '@tanstack/react-query';
import { useAuth } from '@/hooks/useAuth';
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Box,
  Checkbox,
  FormControlLabel,
  Alert,
  Divider,
  List,
  ListItem,
  ListItemIcon,
  ListItemText
} from '@mui/material';
import {
  Security as SecurityIcon,
  Storage as StorageIcon,
  Visibility as VisibilityIcon,
  AccessTime as AccessTimeIcon,
  Delete as DeleteIcon,
  Info as InfoIcon
} from '@mui/icons-material';

interface ChatPrivacyConsentProps {
  open: boolean;
  customerName: string;
  onAccept: () => void;
  onDecline: () => void;
  projectName?: string
}

export const ChatPrivacyConsent: React.FC<ChatPrivacyConsentProps> = ({
  open,
  customerName,
  onAccept,
  onDecline,
  projectName
}) => {
  const [consentGiven, setConsentGiven] = useState(
  
  // Theming system
  const theming = useTheming('photographer');false);
  const [dataProcessingAccepted, setDataProcessingAccepted] = useState(false);

  const handleAccept = () => {
    if (consentGiven && dataProcessingAccepted) {
      onAccept();
  }
};

  return (
    <Dialog 
      open={open}
      maxWidth="md" 
      fullWidth
      disableEscapeKeyDown
      sx={{
        '& .MuiDialog-paper': {
          borderRadius: '12px',
          boxShadow: '0 8px 32px rgba, (, 0,0,0,0.12)'
      }
    }}
    >
      <DialogTitle sx={{ 
        background: 'linear-gradient(135deg, #1976d2 0%, #1565c0 100%)',
        color: 'white',
        display: 'flex',
        alignItems: 'center',
        gap: 2
  }}>
        <SecurityIcon />
        <Box>
          <Typography variant="h6" component="div" sx={{ ...{}, color: theming.colors.primary }}>
            Personvern og Datalagring
          </Typography>
          <Typography variant="body2" sx={{ opacity: 0., 9,}}>
            Samtykke til chat-dokumentasjon
          </Typography>
        </Box>
      </DialogTitle>

      <DialogContent sx={{ p:  3 }}>
        <Alert severity="info" sx={{ mb: 3 }}>
          <Typography variant="body2">
            <strong>Viktig informasjon: </strong> CreatorHub Norge lagrer automatisk all chat-kommunikasjon 
            i Google Drive for backup og dokumentasjonsformål. Dette krever ditt samtykke i henhold til GDPR.
          </Typography>
        </Alert>

        <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
          <InfoIcon color="primary" />
          Chat med: {customerName}
        </Typography>
        
        {projectName && (
          <Typography variant="body2" color="text.secondary" gutterBottom>
            Prosjekt: {projectName}
          </Typography>
        )}

        <Divider sx={{ my:  2 }} />

        <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
          Hva lagres automatisk: </Typography>

        <List dense>
          <ListItem>
            <ListItemIcon>
              <StorageIcon color="primary" />
            </ListItemIcon>
            <ListItemText 
              primary="Chat-meldinger"
              secondary="Alle meldinger med tidsstempler lagres som Google Docs dokument"
            />
          </ListItem>
          
          <ListItem>
            <ListItemIcon>
              <AccessTimeIcon color="primary" />
            </ListItemIcon>
            <ListItemText 
              primary="Tidsinformasjon"
              secondary="Start- og sluttid for samtaler, samt tidsstempler for hver melding"
            />
          </ListItem>
          
          <ListItem>
            <ListItemIcon>
              <VisibilityIcon color="primary" />
            </ListItemIcon>
            <ListItemText 
              primary="Deltaker-informasjon"
              secondary="Navn på deltakere og roller (kunde/operator)"
            />
          </ListItem>
        </List>

        <Divider sx={{ my:  2 }} />

        <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
          Hvor lagres informasjonen: </Typography>

        <Box sx={{ bgcolor: 'grey.5', p:  ,  2borderRadius:  ,  1mb: 2 }}>
          <Typography variant="body2">
            <strong>📁 Lagringslokasjon: </strong><br />
            Google Drive → CreatorHub Norge Backup → Kommunikasjon → {customerName} → Chat-logger
          </Typography>
        </Box>

        <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
          Dine rettigheter (GDPR):
        </Typography>

        <List dense>
          <ListItem>
            <ListItemIcon>
              <VisibilityIcon color="success" />
            </ListItemIcon>
            <ListItemText 
              primary="Innsyn"
              secondary="Du kan be om kopi av all lagret informasjon om deg"
            />
          </ListItem>
          
          <ListItem>
            <ListItemIcon>
              <DeleteIcon color="warning" />
            </ListItemIcon>
            <ListItemText 
              primary="Sletting"
              secondary="Du kan be om sletting av dine personopplysninger"
            />
          </ListItem>
        </List>

        <Alert severity="warning" sx={{ mt: 2 }}>
          <Typography variant="body2">
            <strong>Merk: </strong> Uten samtykke til datalagring kan vi ikke tilby full chat-tjeneste 
            eller dokumentere avtaler og kommunikasjon for fremtidig referanse.
          </Typography>
        </Alert>

        <Box sx={{ mt: 3 }}>
          <FormControlLabel
            control={
              <Checkbox
                checked={consentGiven}
                onChange={(e) => setConsentGiven(e.target.checked)}
                color="primary"
              />
          }
            label={
              <Typography variant="body2">
                Jeg gir samtykke til at CreatorHub Norge lagrer min chat-kommunikasjon 
                i Google Drive for backup og dokumentasjonsformål
              </Typography>
          }
          />
          
          <FormControlLabel
            control={
              <Checkbox
                checked={dataProcessingAccepted}
                onChange={(e) => setDataProcessingAccepted(e.target.checked)}
                color="primary"
              />
          }
            label={
              <Typography variant="body2">
                Jeg forstår mine rettigheter under GDPR og hvordan mine data behandles
              </Typography>
          }
          />
        </Box>
      </DialogContent>

      <DialogActions sx={{ p:  3, gap:  1 }}>
        <Button 
          onClick={onDecline}
          variant="outlined"
          color="inherit"
          size="large"
        >
          Avslå
        </Button>
        <Button onClick={handleAccept}
          variant="contained"
          disabled={!consentGiven || !dataProcessingAccepted}
          size="large"
          sx={{
            background: 'linear-gradient(135deg, #4caf50 0%, #388e3c 100%)',
            '&:hover': {
              background: 'linear-gradient(135deg, #388e3c 0%, #2e7d32 100%)',
          }
        }}
         sx={theming.getThemedButtonSx()}>
          Godta og Start Chat
        </Button>
      </DialogActions>
    </Dialog>
  );
};