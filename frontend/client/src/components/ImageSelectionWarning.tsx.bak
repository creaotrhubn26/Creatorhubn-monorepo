/**
 * Image Selection Warning Component
 * Psykologisk tilnærming for bildeutvalg - guidar kunden positivt
 */

import { useTheming } from '@/lib/theming-helper';
import React from 'react';
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
