  Chip
} from '@mui/material';
import {
  PhotoLibrary,
  Favorite,
  LocalOffer,
  TrendingUp,
  CheckCircle,
  Description
} from '@mui/icons-material';

interface ImageSelectionWarningProps {
  open: boolean;
  onClose: () => void;
  selectedCount: number;
  contractedImages: number;
  onKeepAllImages: () => void;
  onSelectFewer: () => void;
  pricePerImage: number;
  packageDeals?: {
    package50: number;
    package100: number;
};
  contractId?: string;
  onViewContract?: () => void;
}

export default function
  // Theming system
  const theming = useTheming(); ImageSelectionWarning({
  open,
  onClose,
  selectedCount,
  contractedImages: number,
  onKeepAllImages: () => void,
  onSelectFewer: () => void,
  pricePerImage: number,
  packageDeals: { package50: number, package100: number, package0: number },
  contractId?: string,
  onViewContract?: () => void
}: ImageSelectionWarningProps) => {
  const extraImages: number = selectedCount - contractedImages;
  const extraCost: number = extraImages * pricePerImage;
  const package50Savings: number = (50 * pricePerImage) - packageDeals.package50;
  const package100Savings: number = (100 * pricePerImage) - packageDeals.package100;

  return (
    <Dialog open={open} onClose={onClose} maxWidth="md" fullWidth PaperProps={{ sx: { bgcolor: '#0f141', color: '#fff', border: '1px solid rgba(25,255,255,0.1)', borderRadius: '12px' } }}>
      onClose: () => void,
      open={open}
      onClose={onClose}
      maxWidth="md"
      fullWidth
      PaperProps={{
        sx: {
          bgcolor: '#0f141',
          color: '#fff',
          border: '1px solid rgba(25,255,255,0.1)',
          borderRadius: '12px'
        }
      }}
    >     <DialogTitle sx={{ color: '#fff', textAlign: 'center', borderBottom: '1px solid rgba(25,255,255,0.1)', pb: 2 }}>
      <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap:  2 }}>
        <PhotoLibrary sx={{ color: '#ffa72', fontSize: 3, 2,}} />
        <Typography variant="h5" sx={{ fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
          Alle dine vakre minner!
        </Typography>
      </Box>
    </DialogTitle>
    <DialogContent sx={{ bgcolor: '#0a0f1', p:  3 }}>
      <Alert severity="info" icon={<Favorite sx={{ color: '#e91e63, ',}} />} sx={{ bgcolor: 'rgba(25, 167, 38, 0.1)', border: '1px solid rgba(25, 167, 38, 0.3)', color: '#fff', mb: 3, borderRadius: '8px' }}>
        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 1 }}>
          <Box sx={{ flex:  1 }}>
            <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
              Du har valgt {selectedCount} fantastiske bilder!
            </Typography>
            <Typography>
              Kontrakten din inkluderer {contractedImages} bilder, så du har funnet {extraImages} ekstra minner 
              som du ønsker å ta vare på. Det viser hvor vellykket fotograferingen var! 📸
            </Typography>
          </Box>
        </Box>
      </Alert>

      <Box sx={{ mb: 3 }}>
        <Typography variant="h6" gutterBottom sx={{ color: '#ffa72', mb: 2 }} sx={{ ...{}, color: theming.colors.primary }}>
          Du har to gode valg: </Typography>
              <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
          Velg færre bilder
        </Typography>
          <Typography variant="body2" sx={{ mb: 2, textAlign: 'center', fontWeight: 500, fontFamily: theming.typography.families.body,        fontWeight: theming.typography.weights.normal,color: theming.colors.primary, lineHeight: theming.typography.lineHeight.normal, fontSize: theming.typography.sizes.base }}> Gå tilbake og velg de {contractedImages} bildene som betyr aller mest for deg. 
          Du kan alltid bestille flere senere hvis du angrer. </Typography>
          fontSize: theming.typography.sizes.base,
          fontSize: theming.typography.sizes.base }}>
          fontSize: theming.typography.sizes.base }}>
          <Button onClick={onKeepAllImages} variant="contained" size="large" sx={theming.getThemedButtonSx()}>
          Ja, behold alle minnene! 💚
        </Button>
      </DialogActions>
    </Dialog>
  );
}
              <Button
                variant="outlined"
                size="small"
                startIcon={<Description />}
                onClick={onViewContract}
                sx={{
                  ml:  2,
                  color: '#ffa72',
                  borderColor: '#ffa72',
                  minWidth: '140px',
                  '&:hover': {
                    borderColor: '#ffb74',
                    bgcolor: 'rgba(25, 167, 38, 0.1)'
                }
              }}
              >
                Se kontrakt
              </Button>
            )}
          </Box>
        </Alert>

        <Box sx={{ mb: 3 }}>
          <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedTypographySx('h6') }}>
            Du har to gode valg: </Typography>

          {/* Valg 1: Behold alle */}
          <Card sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedCardSx() }}>
            <CardContent sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedCardContentSx() } }>
              <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 1 }}>
                <CheckCircle sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedIconSx('checkCircle') }} />
                <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedTypographySx('h6') }}>
                  Behold alle minnene dine
                </Typography>
                <Chip 
                  label="Anbefalt!" 
                  size="small" 
                  sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedChipSx() }}>
                  <Typography sx={{ color: theming.colors.primary, textAlign: 'center, ', fontWeight: 500, fontFamily: theming.typography.families.body,        fontWeight: theming.typography.weights.normal,color: theming.colors.primary, lineHeight: theming.typography.lineHeight.normal, fontSize: theming.typography.sizes.base }}>
                    Anbefalt!
                  </Typography>
                </Chip>
              </Box>
              
              <Typography sx={{ color: theming.colors.primary, textAlign: 'center, ', fontWeight: 500, fontFamily: theming.typography.families.body,        fontWeight: theming.typography.weights.normal,color: theming.colors.primary, lineHeight: theming.typography.lineHeight.normal, fontSize: theming.typography.sizes.base }}>
                Gå tilbake og velg de {contractedImages} bildene som betyr aller mest for deg. 
                Du kan alltid bestille flere senere hvis du angrer.
              </Typography>
            </CardContent>
          </Card>
        </Box>

        <Divider sx={{ my:  ,  2borderColor: 'rgba(25,255,255,0.1)' }} />

        <Typography variant="body2" sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedTypographySx('body2') }}>
          💝 Husk: Dette er minner for livet. De fleste kunder velger å beholde alle bildene sine!
        </Typography>
      </DialogContent>

      <DialogActions sx={{ ...{}, bgcolor: theming.colors.primary, ...theming.getThemedDialogActionsSx() }}>
        <Button 
          onClick={onSelectFewer}
          variant="outlined"
          sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedButtonSx() }}>
          Velg færre bilder
        </Button>
          Velg færre bilder
        </Button>
        
        <Button onClick={onKeepAllImages}
          variant="contained"
          size="large"
          sx={{ ...{}, color: theming.colors.primary, ...theming.getThemedButtonSx() }}>
              bgcolor: theming.colors.primary, 
          Ja, behold alle minnene! 💚
        </Button>
      </DialogActions>
    </Dialog>
  );
}
            <Typography sx={{ color: theming.colors.primary, textAlign: 'center, ', fontWeight: 500, fontFamily: theming.typography.families.body,        fontWeight: theming.typography.weights.normal,color: theming.colors.primary, lineHeight: theming.typography.lineHeight.normal, fontSize: theming.typography.sizes.base }}>
              Ja, behold alle minnene! 💚
            </Typography>
          </Button>
        </DialogActions>
      </Dialog>
    );
  }