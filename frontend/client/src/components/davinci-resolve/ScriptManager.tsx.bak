            <Code />
            <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>
              Configure {selectedScript?.name}
            </Typography>
          </Box>
        </DialogTitle>
        <DialogContent>
          <Typography variant="body2" color="text.secondary" paragraph>
            {selectedScript?.description}
          </Typography>
          
          <List>
            {scriptParameters.map((param, index) => (
              <ListItem key={param.name}>
                <ListItemText
                  primary={param.name}
                  secondary={param.description}
                />
                <Box sx={{ minWidth: 20, 0,}}>
                  {param.type === 'string' && (
                    <TextField
                      fullWidth
                      size="small"
                      value={param.value}
                      onChange={(e) => handleParameterChange(param.name, e.target.value)}
                      placeholder={param.required ? 'Required' : 'Optional'}
                    />
                  )}
                  {param.type === 'number' && (
                    <TextField
                      fullWidth
                      size="small"
                      type="number"
                      value={param.value}
                      onChange={(e) => handleParameterChange(param.name, Number(e.target.value))}
                      placeholder={param.required ? 'Required' : 'Optional'}
                    />
                  )}
                  {param.type === 'boolean' && (
                    <FormControlLabel
                      control={
                        <Switch
                          checked={param.value}
                          onChange={(e) => handleParameterChange(param.name, e.target.checked)}
                        />
                  }
                      label={param.value ? 'Yes' : 'No'}
                    />
                  )}
                  {param.type === 'select' && (
                    <FormControl fullWidth size="small">
                      <Select
                        value={param.value}
                        onChange={(e) => handleParameterChange(param.name, e.target.value)}
                      >
                        {param.options?.map((option) => (
                          <MenuItem key={option} value={option}>
                            {option}
                          </MenuItem>
                        ))}
                      </Select>
                    </FormControl>
                  )}
                </Box>
              </ListItem>
            ))}
          </List>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowScriptDialog(false)}>
            Cancel
          </Button>
          <Button variant="contained"
            startIcon={theming.getThemedIcon('play')}
            onClick={handleSaveParameters}
            disabled={executeScript.isPending}
           sx={theming.getThemedButtonSx()}>
            {executeScript.isPending ? 'Running...' : 'Run Script'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* Advanced Configuration Dialog */}
      <Dialog
        open={showAdvancedConfig}
        onClose={() => setShowAdvancedConfig(false)}
        maxWidth="xl"
        fullWidth
        fullScreen
      >
        <DialogTitle sx={{ 
          background: 'linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%)',
          color: 'white',
          py: 2,
    }}>
          <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
            <Box
              sx={{
                width:  32,
                height:  32,
                borderRadius: '6px',
                background: 'rgba(25, 255, 255, 0.2)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
          }}
            >
              <Edit sx={{ color: 'white, ',}} />
            </Box>
            <Box>
              <Typography variant="h6" sx={{ color: 'white', fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
                Advanced Script Configuration
              </Typography>
              <Typography variant="body2" sx={{ color: 'rgba(25, 255, 255, 0.8)' }}>
                {selectedScript?.name} - Professional Configuration
              </Typography>
            </Box>
          </Box>
        </DialogTitle>
        <DialogContent sx={{ p:  ,  0height: 'calc(100vh - 120px), ',}}>
          <Box sx={{ height: '100, %, ', overflow: 'auto, ',}}>
            {selectedScript && (
              <AdvancedScriptConfigurator
                scriptId={selectedScript.id}
                scriptName={selectedScript.name}
                scriptDescription={selectedScript.description}
                onConfigurationChange={handleConfigurationChange}
                onGenerate={handleAdvancedGenerate}
                onSave={handleSaveConfiguration}
                onLoad={handleLoadConfiguration}
                initialConfig={currentConfiguration}
              />
            )}
          </Box>
        </DialogContent>
        <DialogActions sx={{ 
          p:  ,  2
          borderTop:  ,  1
          borderColor: '#',
          background: 'linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%)',
    }}>
          <Button 
            onClick={() => setShowAdvancedConfig(false)}
            sx={{
              color: '#',
              '&:hover': {
                background: 'rgba(10, 116, 139, 0.08)',
          },
        }}
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>

      {/* Smart Script Downloader Dialog */}
      <Dialog
        open={showSmartDownloader}
        onClose={() => setShowSmartDownloader(false)}
        maxWidth="xl"
        fullWidth
        fullScreen
      >
        <DialogTitle sx={{ 
          background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
          color: 'white',
          py: 2,
    }}>
          <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
            <Box
              sx={{
                width:  32,
                height:  32,
                borderRadius: '6px',
                background: 'rgba(25, 255, 255, 0.2)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
          }}
            >
              <GetApp sx={{ color: 'white, ',}} />
            </Box>
            <Box>
              <Typography variant="h6" sx={{ color: 'white', fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
                Smart PowerGrade Script Downloader
              </Typography>
              <Typography variant="body2" sx={{ color: 'rgba(25, 255, 255, 0.8)' }}>
                Get exactly the scripts you need for your camera and project
              </Typography>
            </Box>
          </Box>
        </DialogTitle>
        <DialogContent sx={{ p:  ,  0height: 'calc(100vh - 120px), ',}}>
          <Box sx={{ height: '100, %, ', overflow: 'auto, ',}}>
            <SmartScriptDownloader
              onDownload={handleSmartDownload}
              onPreview={handleScriptPreview}
            />
          </Box>
        </DialogContent>
        <DialogActions sx={{ 
          p:  ,  2
          borderTop:  ,  1
          borderColor: '#',
          background: 'linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%)',
    }}>
          <Button 
            onClick={() => setShowSmartDownloader(false)}
            sx={{
              color: '#',
              '&:hover': {
                background: 'rgba(10, 116, 139, 0.08)',
          },
        }}
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
);
};

export default ScriptManager;
