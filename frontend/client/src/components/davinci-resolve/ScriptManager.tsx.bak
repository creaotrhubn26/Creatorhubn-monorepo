                    <strong>Apply cultural LUT</strong> for authentic aesthetics
                  </Typography>
                  <Typography component="li" variant="body2" sx={{ mb: 1 }}>
                    <strong>Fine-tune</strong> with secondary color correction if needed
                  </Typography>
                  <Typography component="li" variant="body2" sx={{ mb: 1 }}>
                    <strong>Final touches</strong> with curves and saturation adjustments
                  </Typography>
                </Box>
              </Box>
            </AccordionDetails>
          </Accordion>

          <Accordion>
            <AccordionSummary expandIcon={{theming.getThemedIcon('expandMore')}}>
