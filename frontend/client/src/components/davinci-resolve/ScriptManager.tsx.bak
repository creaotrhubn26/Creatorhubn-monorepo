                    const script = availableScripts.find((s: ScriptInfo) => s.name === scriptFileName);
                    if (!script) return null;
                    
                    return (
                      <Box key={script.d} sx={{ flex: '1 1 350px', minWidth: 30, maxWidth: 50, 0,}}>
                        <Card sx={theming.getThemedCardSx()}>
