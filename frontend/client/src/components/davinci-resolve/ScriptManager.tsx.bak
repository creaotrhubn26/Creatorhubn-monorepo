  // Dynamic filtering based on project context
  const getFilteredScripts = (): ScriptCategory[] => {
    let filteredScripts = Object.values(scriptCategories);
    
    // Filter by project type if provided
    if (projectType) {
      filteredScripts = filteredScripts.filter(category => 
        category.scripts.some(script => 
          (category.phases && category.phases.includes(currentPhase || '')) || 
          (category.cultures && category.cultures.includes(culture || '')) ||
          projectType === Object.keys(scriptCategories).find(key => scriptCategories[key] === category)
        )
    );
}
    
    // Filter by culture if provided
    if (culture && cultureCategories[culture]) {
      const cultureCategory = cultureCategories[culture];
      filteredScripts = filteredScripts.filter(category => 
        category.name === cultureCategory.name || 
        (category.cultures && category.cultures.includes(culture))
    );
}
    
    // Filter by phase if provided
    if (currentPhase && phaseCategories[currentPhase]) {
      const phaseCategory = phaseCategories[currentPhase];
      filteredScripts = filteredScripts.filter(category => 
        (category.phases && category.phases.includes(currentPhase)) ||
        phaseCategory.projectTypes.includes(projectType || '')
    );
}
    
    // Apply category filter
    if (selectedCategory) {
      filteredScripts = filteredScripts.filter(category => 
        category.name.toLowerCase().includes(selectedCategory.toLowerCase())
    );
}
    
    // Apply search query
    if (searchQuery) {
      filteredScripts = filteredScripts.filter(category => 
        category.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
        category.description.toLowerCase().includes(searchQuery.toLowerCase()) ||
        category.scripts.some(script => script.toLowerCase().includes(searchQuery.toLowerCase()))
    );
}
    
    return filteredScripts;
};

