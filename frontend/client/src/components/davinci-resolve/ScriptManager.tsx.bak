  const { data: systemStatus, refetch: refetchSystemStatus } = useQuery({
    queryKey: ['/api/davinci-resolve/system-status, '],
    queryFn: () => apiRequest('/api/davinci-resolve/system-status, ', ),
    refetchInterval: 500,
});

