        {/* LUT Tutorial Section , *, /}
        <Paper sx={{ mb: ,  2p:  ,  2bgcolor: '#e3f2fd', border: '1px solid #2196f3, ',}} sx={theming.getThemedCardSx()}>
          <Typography variant="h6" gutterBottom sx={{ color: '#', fontWeight: 'bold, ',}} sx={{ ...{}, color: theming.colors.primary }}>
            🎨 Culture-Specific LUTs Tutorial
          </Typography>
          <Typography variant="body2" color="text.secondary" paragraph>
            Learn how to use the specialized LUTs (Look-Up Tables) for authentic cultural wedding aesthetics.
          </Typography>
          
          <Accordion>
            <AccordionSummary expandIcon={{theming.getThemedIcon('expandMore')}}>
              <Typography variant="subtitle1" sx={{ fontWeight: 'bold, ',}}>
                📖 How to Apply Cultural LUTs
              </Typography>
            </AccordionSummary>
            <AccordionDetails>
              <Box sx={{ mb: 2 }}>
                <Typography variant="subtitle2" gutterBottom sx={{ fontWeight: 'bold', color: '#1976d2, ',}}>
                  🎬 In DaVinci Resolve: </Typography>
                <Box component="ol" sx={{ pl:,  2mt: 1 }}>
                  <Typography component="li" variant="body2" sx={{ mb: 1 }}>
                    Go to the <strong>Color page</strong>
                  </Typography>
                  <Typography component="li" variant="body2" sx={{ mb: 1 }}>
                    <strong>Right-click</strong> on any color node
                  </Typography>
                  <Typography component="li" variant="body2" sx={{ mb: 1 }}>
                    Select <strong>LUT → Browse</strong>
                  </Typography>
                  <Typography component="li" variant="body2" sx={{ mb: 1 }}>
                    Navigate to <strong>luts/real-functional/cultural/[culture-folder]</strong>
                  </Typography>
