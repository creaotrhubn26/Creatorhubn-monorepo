interface ScriptInfo {
  id: string;
  name: string;
  description: string;
  category: string;
  parameters: ScriptParameter[];
  isInstalled: boolean;
  isRunning: boolean;
  lastRun?: string;
  status: 'ready' | 'error' | 'running' | 'installing', ;, 
}

interface ScriptParameter {
  name: string;
  type: 'string' | 'number' | 'boolean' | 'select';
  value: any;
  options?: string[];
  description: string;
  required: boolean, ;, 
}

interface InstallationStep {
  id: string;
  title: string;
  description: string;
  status: 'pending' | 'running' | 'completed' | 'error';
  details?: string;
  action?: () => Promise<void>, ;, 
}

