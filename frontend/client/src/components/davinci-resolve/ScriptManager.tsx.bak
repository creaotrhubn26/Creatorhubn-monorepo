        actions: ['install', 'execute', 'configure', 'monitor'],
        ui: ['dialog', 'form', 'status', 'progress'],
        system: ['davinci:connect', 'python: check', 'api: locate']
    , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
      dependencies: ['davinci-resolve-api', 'python-runtime'],
      lastActive: Date.now, (, ),
      performance: {
        renderCount:,  , 0,
        avgRenderTime:  0,
        memoryUsage: 0
    ,  ,}
});

    // Track feature usage
