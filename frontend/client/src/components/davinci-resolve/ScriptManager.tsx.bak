                              <Box sx={{ mb: 2 }}>
                                <Typography variant="caption" color="text.secondary" gutterBottom display="block">
                                  🎨 Connected LUTs: </Typography>
                                <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 0., 5,}}>
                                  {Object.entries(getScriptLUTs(scriptFileName, culture)).map(([lutType, luts]) => (
                                    <Chip
                                      key={lutType}
                                      label={`${lutType}: ${luts.length}`}
                                      size="small"
                                      variant="outlined"
                                      sx={{ 
                                        fontSize: '10px', 
                                        height:  20,
                                        bgcolor: lutType === 'log' ? '#e3f2fd' : '#',
                                        borderColor: lutType === 'log' ? '#2196f3' : '#9e9e9e'
                                    ,  ,}}
                                    />
                                  ))}
                                </Box>
                              </Box>
                            )}
                          </CardContent>
                          <CardActions sx={theming.getThemedCardSx()}>
                            <Button
                              size="small"
                              startIcon={theming.getThemedIcon('settings')}
                              onClick={() => handleOpenScript(script)}
                              disabled={!script.isInstalled}
                              color={projectType === 'wedding' ? 'secondary' : 'primary'}
                            >
                              Quick Config
                            </Button>
                            <Button
                              size="small"
                              startIcon={theming.getThemedIcon('edit')}
                              onClick={() => handleOpenAdvancedConfig(script)}
                              disabled={!script.isInstalled}
                              color={projectType === 'wedding' ? 'secondary' : 'primary'}
                            >
                              Advanced
                            </Button>
                            <Button
                              size="small"
                              startIcon={theming.getThemedIcon('play')}
                              onClick={() => {
                                features.trackFeatureUsage('script-manager', 'scrip<string 
ed', {
                                  scriptId: script.d,
                                  scriptName: script.name,
                                  category: script.category,
                                  timestamp: new Date().toISOString, (, ),
                                  projectContext: {
                                    projectType,
                                    culture,<string 

                                    currentPhase,
                                    hasProjectData: !!projectData
                                ,  ,}
                            });
                                executeScript.mutate({
                                  scriptId: script.d,
                                  parameters: script.parameters.reduce((acc: Record<string 
 any>, param: any) => {
                                    acc[param.name] = param.value;
                                    return acc;
                                , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 }, {}),
                                  projectContext: {
                                    projectType,
                                    culture,
                                    currentPhase,
                                    projectData
                              }
                            } as any);
                          }}
                              disabled={!script.isInstalled || script.isRunning}
                              color={projectType === 'wedding' ? 'secondary' : 'primary'}
                            >
                              Run
                            </Button>
                          </CardActions>
                        </Card>
                      </Box>
                  );
              })}
