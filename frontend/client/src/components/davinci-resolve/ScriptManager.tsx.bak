                                icon={script.isInstalled ? {theming.getThemedIcon('checkCircle')} : <ErrorIcon />}
                                label={script.isInstalled ? 'Installed' : 'Not Installed'}
                                color={script.isInstalled ? 'success' : 'error'}
                                size="small"
                              />
                              {script.isRunning && (
                                <Chip
                                  icon={<CircularProgress size={16} />}
                                  label="Running"
                                  color="info"
                                  size="small"
                                />
                              )}
                            </Box>

                            {/* LUT Integration Display */}
