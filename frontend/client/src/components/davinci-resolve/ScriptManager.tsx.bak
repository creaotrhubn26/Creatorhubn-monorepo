  ,  ,});

    return () => {
      lifecycle.unregisterComponent('script-manager');
};
}, [lifecycle, analytics]);

  // Initialize installation steps
  useEffect(() => {
    const steps: InstallationStep[] = [
      {
        id: 'check-python',
        title: 'Check Python Installation',
        description: 'Verify Python 3.8+ is installed and accessible',
        status: 'pending',
        action: async () => {
          try {
            const result = await apiRequest('/api/davinci-resolve/check-python');
            if (result.installed) {
              setInstallationSteps(prev => 
                prev.map(step => 
                  step.id === 'check-python' 
                    ? { ...step, status: 'completed', details: `Python ${result.version} found` }
                    : step
                )
            );
        } else {
              throw new Error('Python not found');
        }
      } catch (err) {
            setInstallationSteps(prev => 
              prev.map(step => 
                step.id === 'check-python' 
                  ? { ...step, status: 'error', details: 'Python not found. Please install Python 3.8+, ',}
                  : step
              )
          );
      }
    }
  },
      {
        id: 'check-davinci',
        title: 'Check DaVinci Resolve Installation',
        description: 'Verify DaVinci Resolve Studio is installed',
        status: 'pending',
        action: async () => {
          try {
            const result = await apiRequest('/api/davinci-resolve/check-installation');
            if (result.installed) {
              setInstallationSteps(prev => 
                prev.map(step => 
                  step.id === 'check-davinci' 
                    ? { ...step, status: 'completed', details: `DaVinci Resolve ${result.version} found` }
                    : step
                )
            );
        } else {
              throw new Error('DaVinci Resolve not found');
        }
      } catch (err) {
            setInstallationSteps(prev => 
              prev.map(step => 
                step.id === 'check-davinci' 
                  ? { ...step, status: 'error', details: 'DaVinci Resolve Studio not found, ',}
                  : step
              )
          );
      }
    }
  },
      {
        id: 'locate-api',
        title: 'Locate DaVinci Resolve AP',
        description: 'Find the Python API module for DaVinci Resolve',
        status: 'pending',
        action: async () => {
          try {
            const result = await apiRequest('/api/davinci-resolve/locate-api');
            if (result.found) {
              setInstallationSteps(prev => 
                prev.map(step => 
                  step.id === 'locate-api' 
                    ? { ...step, status: 'completed', details: `API found at: ${result.path}` }
                    : step
                )
            );
        } else {
              throw new Error('API not found');
        }
      } catch (err) {
            setInstallationSteps(prev => 
              prev.map(step => 
                step.id === 'locate-api' 
                  ? { ...step, status: 'error', details: 'DaVinci Resolve API not found, ',}
                  : step
              )
          );
      }
    }
  },
      {
        id: 'install-dependencies',
        title: 'Install Python Dependencies',
        description: 'Install required Python packages for script execution',
        status: 'pending',
        action: async () => {
          try {
            const result = await apiRequest('/api/davinci-resolve/install-dependencies', {
              method: 'POST'
          ,  ,});
            if (result.success) {
              setInstallationSteps(prev => 
                prev.map(step => 
                  step.id === 'install-dependencies' 
                    ? { ...step, status: 'completed', details: 'All dependencies installed successfully, ',}
                    : step
                )
            );
        } else {
              throw new Error(result.error);
        }
      } catch (err) {
            setInstallationSteps(prev => 
              prev.map(step => 
                step.id === 'install-dependencies' 
                  ? { ...step, status: 'error', details: 'Failed to install dependencies, ',}
                  : step
              )
          );
      }
    }
  },
      {
        id: 'test-connection',
        title: 'Test DaVinci Resolve Connection',
        description: 'Verify scripts can communicate with DaVinci Resolve',
        status: 'pending',
        action: async () => {
          try {
            const result = await apiRequest('/api/davinci-resolve/test-connection', {
              method: 'POST'
          ,  ,});
            if (result.connected) {
              setInstallationSteps(prev => 
                prev.map(step => 
                  step.id === 'test-connection' 
                    ? { ...step, status: 'completed', details: 'Successfully connected to DaVinci Resolve, ',}
                    : step
                )
            );
        } else {
              throw new Error('Connection failed');
        }
      } catch (err) {
            setInstallationSteps(prev => 
              prev.map(step => 
                step.id === 'test-connection' 
                  ? { ...step, status: 'error', details: 'Failed to connect to DaVinci Resolve, ',}
                  : step
              )
          );
      }
    }
  }
    ];
    setInstallationSteps(steps);
}, []);

  // Run installation step
  const runInstallationStep = async (stepId: string) => {
    const step = installationSteps.find(s => s.id === stepId);
    if (!step || !step.action) return;

    setInstallationSteps(prev => 
      prev.map(s => 
        s.id === stepId 
          ? { .., .status: 'running, ',}
          : s
      )
  );

    try {
      await step.action();
} catch (error) {
      console.error('Installation step failed:', error);
}
};

  // Run all installation steps
  const runAllInstallationSteps = async () => {
    for (const step of installationSteps) {
      if (step.status === 'pending' && step.action) {
        await runInstallationStep(step.id);
        await new Promise(resolve => setTimeout(resolve, 1000)); // Small delay between steps
  }
}
};

  // Execute script with enhanced integration
  const executeScript = useMutation({
    mutationFn: ({ scriptd, parameters }: { scriptId: string; parameters: any }) => {
      const endTiming = performance.startTiming(`script_execution_${scriptId}`);
      
      analytics.trackEvent('script_execution_started', {
        scriptId,
        parameters: Object.keys(parameters),
        timestamp: Date.now()
    ,  ,});

      // Track feature usage
      features.trackFeatureUsage('script-manager', 'script_executed', {
        timestamp: Date.now, (, ),
        scriptId: scriptd,
        parameters: Object.keys(parameters ||,  , {}),
        component: 'ScriptManager'
    ,  ,});

      return apiRequest(`/api/davinci-resolve/scripts/${scriptId}/execute`, {
        method: 'POST',
        body: JSON.stringify({ parameters }),
  }).finally(() => {
        endTiming();
  });
},
    onSuccess: (data, variables) => {
      console.log('Script executed successfully:', data);
      refetchScripts();
      
      analytics.trackEvent('script_execution_success', {
        scriptId: variables.scriptd,
        executionTime: data.executionTime ||,  , 0,
        timestamp: Date.now()
    ,  ,});

      // Show success notification
      visualEditor.addNotification({
        type: 'success',
        title: 'Script Executed Successfully',
        message: `Script "${variables.scriptd}" completed successfully`,
        read: false
    ,  ,});
},
    onError: (error, variables) => {
      console.error('Script execution failed:', error);
      
      analytics.trackEvent('script_execution_failed', {
        scriptId: variables.scriptd,
        error: error.message,
        timestamp: Date.now()
    ,  ,});

      // Show error notification
      visualEditor.addNotification({
        type: 'error',
        title: 'Script Execution Failed',
        message: `Failed to execute script "${variables.scriptd}": ${error.message}`,
        read: false
    ,  ,});
},
});

  // Open script dialog with analytics
  const handleOpenScript = (script: ScriptInfo) => {
    setSelectedScript(script);
    setScriptParameters([...script.parameters]);
    setShowScriptDialog(true);
    
    analytics.trackEvent('script_dialog_opened', {
      scriptId: script.d,
      scriptName: script.name,
      timestamp: Date.now()
  ,  ,});
};

  // Open advanced configuration with analytics
  const handleOpenAdvancedConfig = (script: ScriptInfo) => {
    setSelectedScript(script);
    setShowAdvancedConfig(true);
    
    analytics.trackEvent('advanced_config_opened', {
      scriptId: script.d,
      scriptName: script.name,
      timestamp: Date.now()
  ,  ,});
};

  // Save script parameters
  const handleSaveParameters = () => {
    if (selectedScript) {
      executeScript.mutate({
        scriptId: selectedScript.d,
        parameters: scriptParameters.reduce((acc, param) => {
          acc[param.name] = param.value;
          return acc;
    }, {} as any),
  });
      setShowScriptDialog(false);
}
};

  // Update parameter value
  const handleParameterChange = (paramName: string, value: any) => {
    setScriptParameters(prev =>
      prev.map(param =>
        param.name === paramName ? { ...param, value } : param
      )
  );
};

  // Handle advanced configuration changes
  const handleConfigurationChange = (config: any) => {
    setCurrentConfiguration(config);
,  ,};

  // Handle advanced configuration generation
  const handleAdvancedGenerate = (config: any) => {
    if (selectedScript) {
      executeScript.mutate({
        scriptId: selectedScript.d,
        parameters: config,
  });
      setShowAdvancedConfig(false);
}
};

  // Handle save configuration with integration
  const handleSaveConfiguration = (config: any) => {
    console.log('Saving configuration, :, ', config);
    
    analytics.trackEvent('configuration_saved', {
      scriptId: selectedScript?.d,
      configKeys: Object.keys(config),
      timestamp: Date.now()
  ,  ,});

    // Save to localStorage for persistence
    localStorage.setItem(`script_config_${selectedScript?.id}`, JSON.stringify(config));
    
    // Show success notification
    visualEditor.addNotification({
      type: 'success',
      title: 'Configuration Saved',
      message: `Configuration for "${selectedScript?.name}" saved successfully`,
      read: false
  ,  ,});
};

  // Handle load configuration with integration
  const handleLoadConfiguration = (configId: string) => {
    console.log('Loading configuration, :, ', configId);
    
    analytics.trackEvent('configuration_loaded', {
      configId,
      scriptId: selectedScript?.d,
      timestamp: Date.now()
  ,  ,});

    // Load from localStorage
    const configData = localStorage.getItem(`script_config_${configId}`);
    const config = configData ? JSON.parse(configData) : null;
    if (config) {
      setCurrentConfiguration(config);
      
      visualEditor.addNotification({
        type: 'info',
        title: 'Configuration Loaded',
        message: `Configuration "${configd}" loaded successfully`,
        read: false
    ,  ,});
} else {
      visualEditor.addNotification({
        type: 'warning',
        title: 'Configuration Not Found',
        message: `Configuration "${configd}" not found`,
        read: false
    ,  ,});
}
};

  // Handle smart script download
  const handleSmartDownload = (scripts: any[]) => {
    console.log('Downloading scripts, :, ', scripts);
    
    analytics.trackEvent('smart_download_started', {
      scriptCount: scripts.length,
      timestamp: Date.now()
  ,  ,});

    // Simulate download process
    scripts.forEach((script, index) => {
      setTimeout(() => {
        const link = document.createElement('a');
        link.href = `/api/script-download/scripts/${script.path}`;
        link.download = script.name;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
  }, index * 500); // Stagger downloads
});

    visualEditor.addNotification({
      type: 'success',
      title: 'Scripts Downloaded',
      message: `${scripts.length} PowerGrade scripts downloaded successfully`,
      read: false
  ,  ,});
};

  // Handle script preview
  const handleScriptPreview = (script: any) => {
    console.log('Previewing script, :, ', script);
    
    analytics.trackEvent('script_previewed', {
      scriptName: script.name,
      timestamp: Date.now()
  ,  ,});

    // Open preview dialog or show script content
    visualEditor.addNotification({
      type: 'info',
      title: 'Script Preview',
      message: `Previewing ${script.name}`,
      read: false
  ,  ,});
};

  const getStepIcon = (status: string) => {
    switch (status) {
      case 'completed':
        return <CheckCircle color="success" />;
      case 'error':
        return <ErrorIcon color="error" />;
      case 'running':
        return <CircularProgress size={0} />;
      default: return <Info color="disabled" />;
  ,  ,}
};

  // Custom icon components for platforms
  const PythonIcon = () => (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M14.25.18l.9.2.73.26.59.3.45.32.34.34.25.34.16.33.1.3.04.26.02.2-.01.13V8.5l-.05.63-.13.55-.21.46-.26.38-.3.31-.33.25-.35.19-.35.14-.33.1-.3.07-.26.04-.21.02H8.77l-.69.05-.59.14-.5.22-.41.27-.34.32-.28.35-.22.37-.18.38-.14.38-.1.37-.07.35-.05.32-.02.28v3.06H3.17l-.21-.05-.19-.1-.17-.14-.15-.17-.12-.19-.1-.21-.07-.22-.05-.22-.03-.21-.02-.2v-5.62l.03-.45.1-.42.16-.38.22-.34.26-.3.3-.26.33-.22.35-.18.35-.15.33-.11.3-.08.26-.05.21-.02h5.39l.69-.05.59-.14.5-.22.41-.27.34-.32.28-.35.22-.37.18-.38.14-.38.1-.37.07-.35.05-.32.02-.28V.18zm-1.38 1.36l-.05.13-.02.1v2.27l.02.1.05.13.08.1.1.08.13.05.1.02h2.27l.1-.02.13-.05.1-.08.08-.1.05-.13.02-.1V1.67l-.02-.1-.05-.13-.08-.1-.1-.08-.13-.05-.1-.02h-2.27l-.1.02-.13.05-.1.08-.08.1zm-8.5 8.1l-.05.13-.02.1v2.27l.02.1.05.13.08.1.1.08.13.05.1.02h2.27l.1-.02.13-.05.1-.08.08-.1.05-.13.02-.1v-2.27l-.02-.1-.05-.13-.08-.1-.1-.08-.13-.05-.1-.02H4.37l-.1.02-.13.05-.1.08-.08.1z"/>
    </svg>
);

  const WindowsIcon = () => (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 12V6.75l6-1.32v6.48L3 12zm17-9v8.75l-10 .15V5.21L20 3zM3 13l6 .09v6.81l-6-1.15V13zm17 9v-8.75l-10-.15v6.59l10 1.31z"/>
    </svg>
);

  const LinuxIcon = () => (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.504 0C5.636 0 0 5.636 0 12.504S5.636 25.008 12.504 25.008 25.008 19.372 25.008 12.504 19.372 0 12.504 0zm0 1.5c6.075 0 11.004 4.929 11.004 11.004S18.579 23.508 12.504 23.508 1.5 18.579 1.5 12.504 6.429 1.5 12.504 1.5zM8.5 7.5c-.828 0-1.5.672-1.5 1.5s.672 1.5 1.5 1.5 1.5-.672 1.5-1.5-.672-1.5-1.5-1.5zm7 0c-.828 0-1.5.672-1.5 1.5s.672 1.5 1.5 1.5 1.5-.672 1.5-1.5-.672-1.5-1.5-1.5zm-7 3c-.828 0-1.5.672-1.5 1.5s.672 1.5 1.5 1.5 1.5-.672 1.5-1.5-.672-1.5-1.5-1.5zm7 0c-.828 0-1.5.672-1.5 1.5s.672 1.5 1.5 1.5 1.5-.672 1.5-1.5-.672-1.5-1.5-1.5z"/>
    </svg>
);

  const getSystemIcon = () => {
    if (!systemInfo) return {theming.getThemedIcon('info')};
    const platform = systemInfo.platform?.toLowerCase();
    if (platform?.includes('mac')) return <Apple />;
    if (platform?.includes('win')) return <WindowsIcon />;
    if (platform?.includes('linux')) return <LinuxIcon />;
    return {theming.getThemedIcon('info')};
};

  // Show loading state while checking feature flag
  if (isFeatureLoading) {
    return (
      <Box sx={{ p:  3, display: 'flex', justifyContent: 'center', alignItems: 'center', minHeight: 20, 0,}}>
        <CircularProgress />
        <Typography variant="body1" sx={{ ml:  2 }}>
          Checking access permissions...
        </Typography>
      </Box>
  );
}

  // Show access denied if feature is not enabled
  if (!isScriptManagerEnabled) {
    const getFeatureDisabledMessage = () => {
      switch (scriptManagerAccess.reason) {
        case 'plan_required':
          return {
            title: 'Upgrade Required',
            message: `The Script Manager feature requires a ${scriptManagerAccess.requiredPlan} plan or higher. Please upgrade your plan to access DaVinci Resolve automation tools.`,
            action: 'Upgrade Plan'
        ,  ,};
        case 'profession_required':
          return {
            title: 'Profession Restricted',
            message: `The Script Manager feature is only available for ${scriptManagerAccess.requiredProfession?.join, (, ', ')} professionals. Please contact your administrator if you believe this is an error.`,
            action: 'Contact Admin'
        ,  ,};
        case 'beta_restricted':
          return {
            title: 'Beta Feature',
            message: 'The Script Manager feature is currently in beta and not available to all users. Please contact your administrator for access.',
            action: 'Request Access'
        ,  ,};
        case 'coming_soon':
          return {
            title: 'Coming Soon',
            message: 'The Script Manager feature is currently under development and will be available soon. Stay tuned for updates, !, ',
            action: 'Get Notified'
        ,  ,};
        case 'deprecated':
          return {
            title: 'Feature Deprecated',
            message: 'The Script Manager feature has been deprecated and is no longer available. Please use alternative tools.',
            action: 'View Alternatives'
        ,  ,};
        case 'api_only':
          return {
            title: 'API Only',
            message: 'The Script Manager feature is only available via API integration. Please contact your administrator for API access.',
            action: 'API Documentation'
        ,  ,};
        default: return {
            title: 'Access Restricted',
            message: 'The Script Manager feature is not available for your account. Please contact your administrator to enable this feature.',
            action: 'Contact Support'
        ,  ,};
  }
};

    const disabledInfo = getFeatureDisabledMessage();

    return (
      <Box sx={{ p:  3 }}>
        <Alert severity="warning" sx={{ mb: 2 }}>
          <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
            {disabledInfo.title}
          </Typography>
          <Typography variant="body1" sx={{ mb: 2 }}>
            {disabledInfo.message}
          </Typography>
          
          {/* Feature Access Details */}
          {scriptManagerAccess.metadata && (
            <Box sx={{ 
              p:  ,  2
              border:  ,  1
              borderColor: 'divider', 
              borderRadius:  ,  1
              bgcolor: 'background.paper',
              mt: 2
          ,  ,}}>
              <Typography variant="body2" color="text.secondary" gutterBottom>
                <strong>Feature Details: </strong>
              </Typography>
              {scriptManagerAccess.metadata.betaFeature && (
                <Typography variant="caption" color="warning.main" display="block">
                  • Beta Feature
                </Typography>
             ,  , )}
              {scriptManagerAccess.metadata.comingSoon && (
                <Typography variant="caption" color="info.main" display="block">
                  • Coming Soon
                </Typography>
              )}
              {scriptManagerAccess.metadata.deprecated && (
                <Typography variant="caption" color="error.main" display="block">
                  • Deprecated
                </Typography>
              )}
              {scriptManagerAccess.metadata.apiOnly && (
                <Typography variant="caption" color="primary.main" display="block">
                  • API Only
                </Typography>
              )}
            </Box>
          )}
          
          <Button
            variant="outlined"
            onClick={() => {
              // Track feature access attempt
              features.trackFeatureUsage('script-manager', 'access_denied', {
                reason: scriptManagerAccess.reason,
                timestamp: Date.now()
            ,  ,});
              // Handle action based on reason
              console.log('Feature access action:', disabledInfo.action);
        }}
            sx={{ mt: 2 }}
          >
            {disabledInfo.action}
          </Button>
        </Alert>
        <Paper sx={{ p:  3, textAlign: 'center, ',}} sx={theming.getThemedCardSx()}>
          <Typography variant="h6" color="text.secondary" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
            Script Manager
          </Typography>
          <Typography variant="body2" color="text.secondary">
            This feature allows you to manage and execute DaVinci Resolve automation scripts.
          </Typography>
        </Paper>
      </Box>
  );
}

  return (
    <Box sx={{ p:  3 }}>
      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
        <Box>
          <Typography variant="h4" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
            DaVinci Resolve Script Manager
          </Typography>
          <Typography variant="body1" color="text.secondary" paragraph>
            Interactive installation guide and script management for DaVinci Resolve automation.
          </Typography>
        </Box>
        
        {/* Smart Download Section - Only show when project context is available */}
        {(projectType || culture || currentPhase) && (
          <Button variant="contained"
            size="large"
            startIcon={theming.getThemedIcon('getApp')}
            onClick={() = sx={theming.getThemedButtonSx()}> setShowSmartDownloader(true)}
            sx={{ 
              background: projectType === 'wedding' ? 
                'linear-gradient(135deg, #7b1fa2 0%, #9c27b0 100%)' : // Purple for wedding
                'linear-gradient(135deg, #1976d2 0%, #2196f3 100%)', // Blue for video
              '&:hover': {
                background: projectType === 'wedding' ? 
                  'linear-gradient(135deg, #6a1b9a 0%, #8e24aa 100%)' :
                  'linear-gradient(135deg, #1565c0 0%, #1976d2 100%)',
          }
        }}
          >
            Smart Script Downloader
          </Button>
        )}
        
        {/* Feature Analytics Display */}
        <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
          <Typography variant="caption" color="text.secondary">
            Features: {features.getFeatureAnalytics().enabledFeatures}/{features.getFeatureAnalytics().totalFeatures}
          </Typography>
          <Chip 
            label={`${Math.round(features.getFeatureAnalytics().featureAdoptionRate * 100)}%`}
            size="small"
            variant="outlined"
            sx={{ fontSize: '10px', height: 2, 0,}}
          />
        </Box>
        
        {/* Integration Status Panel */}
        <Box sx={{ display: 'flex', gap:  ,  1alignItems: 'center, ',}}>
          <Chip
            icon={{theming.getThemedIcon('checkCircle')}}
            label="Integration Active"
            color="success"
            size="small"
          />
          <Tooltip title="View Debug Information">
            <IconButton
              size="small"
              onClick={() => {
                const debugInfo = debugging.getDebugInfo();
                console.log('Script Manager Debug Info:', debugInfo);
                visualEditor.addNotification({
                  type: 'info',
                  title: 'Debug Info',
                  message: 'Debug information logged to console',
                  read: false
              ,  ,});
          }}
            >
              <Code />
            </IconButton>
          </Tooltip>
        </Box>
      </Box>

      {/* System Status */}
      <Paper sx={{ p:  ,  2mb: 3 }} sx={theming.getThemedCardSx()}>
        <Box sx={{ display: 'flex', alignItems: 'center', gap:  ,  2mb: 2 }}>
          {getSystemIcon()}
          <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>System Status</Typography>
          <Button
            startIcon={theming.getThemedIcon('refresh')}
            onClick={() => refetchSystemStatus()}
            size="small"
          >
            Refresh
          </Button>
        </Box>
        
        {systemStatus && (
          <Box sx={{ display: 'flex', flexWrap: 'wrap', gap:  2 }}>
            <Box sx={{ flex: '1 1 300px', minWidth: 30, 0,}}>
              <Card variant="outlined" sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="subtitle2" gutterBottom>
                    Python Status
                  </Typography>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                    {systemStatus.python?.installed ? (
                      <CheckCircle color="success" />
                    ) : (
                      <ErrorIcon color="error" />
                    )}
                    <Typography variant="body2">
                      {systemStatus.python?.installed 
                        ? `Python ${systemStatus.python.version}` 
                        : 'Not installed'
                  }
                    </Typography>
                  </Box>
                </CardContent>
              </Card>
            </Box>
            
            <Box sx={{ flex: '1 1 300px', minWidth: 30, 0,}}>
              <Card variant="outlined" sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="subtitle2" gutterBottom>
                    DaVinci Resolve Status
                  </Typography>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                    {systemStatus.davinci?.installed ? (
                      <CheckCircle color="success" />
                    ) : (
                      <ErrorIcon color="error" />
                    )}
                    <Typography variant="body2">
                      {systemStatus.davinci?.installed 
                        ? `DaVinci Resolve ${systemStatus.davinci.version}` 
                        : 'Not installed'
                  }
                    </Typography>
                  </Box>
                </CardContent>
              </Card>
            </Box>
            
            <Box sx={{ flex: '1 1 300px', minWidth: 30, 0,}}>
              <Card variant="outlined" sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="subtitle2" gutterBottom>
                    API Connection
                  </Typography>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                    {systemStatus.api?.connected ? (
                      <CheckCircle color="success" />
                    ) : (
                      <ErrorIcon color="error" />
                    )}
                    <Typography variant="body2">
                      {systemStatus.api?.connected ? 'Connected' : 'Not connected'}
                    </Typography>
                  </Box>
                </CardContent>
              </Card>
            </Box>
          </Box>
        )}
      </Paper>

      {/* Installation Guide */}
      <Paper sx={{ p:  ,  2mb: 3 }} sx={theming.getThemedCardSx()}>
        <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
          Installation Guide
        </Typography>
        <Typography variant="body2" color="text.secondary" paragraph>
          Follow these steps to set up DaVinci Resolve script automation: </Typography>
        
        <Stepper activeStep={activeStep} orientation="vertical">
          {installationSteps.map((step, index) => (
            <Step key={step.id}>
              <StepLabel
                icon={getStepIcon(step.status)}
                optional={
                  step.status === 'error' && (
                    <Button
                      size="small"
                      onClick={() => runInstallationStep(step.id)}
                      disabled={!step.action}
                    >
                      Retry
                    </Button>
                  )
            }
              >
                {step.title}
              </StepLabel>
              <StepContent>
                <Typography variant="body2" color="text.secondary">
                  {step.description}
                </Typography>
                {step.details && (
                  <Alert 
                    severity={step.status === 'error' ? 'error' : 'info'} 
                    sx={{ mt: 1 }}
                  >
                    {step.details}
                  </Alert>
                )}
                <Box sx={{ mt: 2 }}>
                  <Button variant="contained"
                    onClick={() = sx={theming.getThemedButtonSx()}> runInstallationStep(step.id)}
                    disabled={step.status === 'running' || !step.action}
                    startIcon={step.status === 'running' ? <CircularProgress size={16} /> : {theming.getThemedIcon('play')}}
                  >
                    {step.status === 'running' ? 'Running...' : 'Run Step'}
                  </Button>
                </Box>
              </StepContent>
            </Step>
          ))}
        </Stepper>
        
        <Box sx={{ mt: 2 }}>
          <Button variant="contained"
            onClick={runAllInstallationSteps}
            startIcon={theming.getThemedIcon('play')}
            disabled={installationSteps.some(step = sx={theming.getThemedButtonSx()}> step.status === 'running')}
          >
            Run All Steps
          </Button>
        </Box>
      </Paper>

      {/* Available Scripts */}
      <Paper sx={{ p:  2 }} sx={theming.getThemedCardSx()}>
