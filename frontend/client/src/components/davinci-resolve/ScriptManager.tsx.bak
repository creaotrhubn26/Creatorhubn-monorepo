                    Choose the appropriate LUT file (e.g., <code>sikh-wedding-golden.cube</code>)
                  </Typography>
                </Box>
              </Box>

              <Box sx={{ mb: 2 }}>
                <Typography variant="subtitle2" gutterBottom sx={{ fontWeight: 'bold', color: '#1976d2, ',}}>
