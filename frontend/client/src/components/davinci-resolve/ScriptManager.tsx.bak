                <Box sx={{ display: 'flex', gap:  ,  2flexWrap: 'wrap', mt: 1 }}>
                  <Chip label="Subtle: 30-50%" color="default" size="small" />
                  <Chip label="Standard: 60-80%" color="primary" size="small" />
                  <Chip label="Strong: 85-100%" color="secondary" size="small" />
                </Box>
                <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
