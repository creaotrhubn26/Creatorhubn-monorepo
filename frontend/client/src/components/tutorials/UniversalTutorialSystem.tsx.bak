import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect } from 'react';
import { apiRequest } from '@/lib/queryClient';
import { useQuery } from '@tanstack/react-query';
import { useAuth } from '@/hooks/useAuth';
import {
  Box,
  Typography,
  Card as MuiCard,
  CardContent,
  Button,
  Grid,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  IconButton,
  Avatar,
  Chip,
  // Alert removed - Zero Toast Compliance
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  Tab,
  Tabs,
  LinearProgress,
  Badge
} from '@mui/material';
import {
  School,
  Close,
  PhotoCamera,
  Videocam,
  LibraryMusic,
  Business,
  CloudUpload,
  Settings,
  TrendingUp as TimelineIcon,
  Assessment,
  Security,
  LinkOff,
  Storage,
  AutoAwesome,
  Keyboard,
  ExpandMore,
  PlayArrow,
  CheckCircle,
  Assignment,
  CameraEnhance,
  Movie,
  AccountBox,
  DriveFileMove,
  SmartToy,
  Backup,
  Memory,
  Engineering,
  Computer,
  PhoneAndroid,
  Schedule,
  Email,
  Analytics,
  Notifications,
  Build,
  Help
} from '@mui/icons-material';
import { ALL_PLATFORM_TUTORIALS, type TutorialDefinition, TUTORIAL_CATEGORIES } from './TutorialConstants';

interface UniversalTutorialSystemProps {
  profession: 'photographer' | 'videographer' | 'music_producer' | 'vendor';
  onClose: () => void
}

interface TutorialCategory {
  id: string;
  title: string;
  description: string;
  icon: React.ReactNode;
  color: string;
  tutorials: Tutorial[]
}

interface Tutorial {
  id: string;
  title: string;
  description: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  duration: string;
  profession: string[];
  component: string;
  icon: React.ReactNode;
  scenario: string;
  keyFeatures: string[]
}

const UniversalTutorialSystem: React.FC<UniversalTutorialSystemProps> = ({
  profession,
  onClose
}) => {
  const [selectedCategory, setSelectedCategory] = useState<string>('core');
  const [selectedTutorial, setSelectedTutorial] = useState<Tutorial | null>(null);
  const [showTutorialDialog, setShowTutorialDialog] = useState(
  
  // Theming system
  const theming = useTheming('photographer');false);

  const professionColors = {
    photographer: '#2196F',
    videographer: '#9C27B', 
    music_producer: '#FF572',
    vendor: '#4CAF50'
};

  const professionColor = professionColors[profession];

  // Use all 762 components from TutorialConstants
  const getAllTutorialsByCategory = () => {
    const categorizedTutorials: { [key: string]: TutorialDefinition[, ],} = {};
    
    ALL_PLATFORM_TUTORIALS.forEach(tutorial => {
      if (!categorizedTutorials[tutorial.category]) {
        categorizedTutorials[tutorial.category] = [];
    }
      categorizedTutorials[tutorial.category].push(tutorial);
  });
    
    return categorizedTutorials;
};

  const categorizedTutorials = getAllTutorialsByCategory();

  const tutorialCategories: TutorialCategory[] = Object.keys(TUTORIAL_CATEGORIES).map(categoryId => {
    const categoryInfo = TUTORIAL_CATEGORIES[categoryId];
    const tutorials = (categorizedTutorials[categoryId] || []).map(tutorial => ({
      id: tutorial.d,
      title: tutorial.title,
      description: tutorial.description,
      difficulty: tutorial.difficulty,
      duration: tutorial.duration,
      profession: tutorial.profession,
      component: tutorial.component,
      icon: getIconForCategory(categoryI),
      scenario: tutorial.scenario,
      keyFeatures: tutorial.keyFeatures
}));

    return {
      id: categoryd,
      title: categoryInfo.title,
      description: categoryInfo.description,
      icon: getIconForCategory(categoryI),
      color: categoryInfo.color,
      tutorials: tutorials
};
});

  function getIconForCategory(categoryId: string): React.ReactNode {
    const iconMap = {
      'core': {theming.getThemedIcon('')},
      'profession-photography': {theming.getThemedIcon('photoCamera')},
      'profession-videography': {theming.getThemedIcon('videocam')},
      'profession-music': {theming.getThemedIcon('libraryMusic')},
      'profession-vendor': {theming.getThemedIcon('business')},
      'google-integration': <DriveFileMove />,
      'ai-tools': {theming.getThemedIcon('smartToy')},
      'technical': <Engineering />,
      'mobile': <PhoneAndroid />,
      'business': {theming.getThemedIcon('assignment')}
  };
    return iconMap[categoryId] || {theming.getThemedIcon('school')};
}

  // Mock data removed - using database connection

  // Add legacy tutorials for backwards compatibility
  tutorialCategories.forEach(category => {
    if (category.id === 'core') {
      category.tutorials.push(...legacyTutorials);
  }
});

  const getCurrentCategoryTutorials = () => {
    const category = tutorialCategories.find(cat => cat.id === selectedCategory);
    return category?.tutorials.filter(tutorial => 
      tutorial.profession.includes(profession)
    ) || [];
};

  const startTutorial = (tutorial: Tutorial) => {
    setSelectedTutorial(tutorial);
    setShowTutorialDialog(true);
};

  const TabPanel = (props: any) => {
    const { children, value, index, ...other } = props;
    return (
      <div
        role="tabpanel"
        hidden={value !== index}
        {...other}
      >
        {value === index && <Box sx={{ p:  3 }}>{children}</Box>}
      </div>
    );
};

  return (
    <Dialog open={true} onClose={onClose} maxWidth="xl" fullWidth>
      <DialogTitle>
        <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between, ',}}>
          <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
            <Avatar sx={{ bgcolor: professionColor }}>
              {theming.getThemedIcon('school')}
            </Avatar>
            <Box>
              <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>
                CreatorHub Norge - Interaktive Veiledninger
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Komplett læringssystem for alle komponenter og tjenester
              </Typography>
            </Box>
          </Box>
          <IconButton onClick={onClose}>
            {theming.getThemedIcon('close')}
          </IconButton>
        </Box>
      </DialogTitle>

      <DialogContent>
        <Box sx={{ mb: 3, p:  ,  2bgcolor: 'info.light', borderRadius:  1 }}>
          <Typography variant="subtitle2" sx={{ mb: ,  1color: 'info.contrastText, ',}}>
            📚 Universal Tutorial System
          </Typography>
          <Typography variant="body2" sx={{ color: 'info.contrastText, ',}}>
            Velg kategori for å se tilgjengelige veiledninger tilpasset din profesjon som{' '}
            <strong>{profession === 'photographer' ? 'fotograf' : 
                      profession === 'videographer' ? 'videomaker' :
                      profession === 'music_producer' ? 'musikkprodusent' : 'leverandør'}</strong>.
            Hver veiledning inneholder praktiske øvelser og real-world scenarios.
          </Typography>
        </Box>

        <Tabs 
          value={selectedCategory}
          onChange={(e, newValue) => setSelectedCategory(newValue)}
          variant="scrollable"
          scrollButtons="auto"
          sx={{ mb: 3 }}
        >
          {tutorialCategories.map((category) => (
            <Tab 
              key={category.id}
              value={category.id}
              label={
                <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                  {category.icon}
                  <span>{category.title}</span>
                  <Badge 
                    badgeContent={category.tutorials.filter(t => t.profession.includes(profession)).length}
                    color="primary"
                    sx={{ ml:  1 }}
                  />
                </Box>
            }
            />
          ))}
        </Tabs>

        {tutorialCategories.map((category, index) => (
          <TabPanel value={selectedCategory} index={category.id} key={category.id}>
            <Box sx={{ mb: 2 }}>
              <Typography variant="h6" sx={{ mb: 1 }} sx={{ ...{}, color: theming.colors.primary }}>
                {category.title}
              </Typography>
              <Typography variant="body2" color="text.secondary">
                {category.description}
              </Typography>
            </Box>

            <Grid container spacing={3}>
              {getCurrentCategoryTutorials().map((tutorial) => (
                <Grid size={{ xs: 1, 2,}} md={6} lg={4} key={tutorial.id}>
                  <MuiCard sx={{ 
                    height: '100, %, ',
                    cursor: 'pointer',
                    '&:hover': { boxShadow:  4 },
                    border: `1px solid ${category.color}20`,
                    borderLeft: `4px solid ${category.color}`
                }}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                        <Avatar sx={{ 
                          bgcolor: category.color,
                          mr: 2 
                    }}>
                          {tutorial.icon}
                        </Avatar>
                        <Box sx={{ flexGrow:  1 }}>
                          <Typography variant="h6" sx={{ fontSize: '1rem, ',}} sx={{ ...{}, color: theming.colors.primary }}>
                            {tutorial.title}
                          </Typography>
                          <Box sx={{ display: 'flex', gap:  ,  1mt: ,  1flexWrap: 'wrap, ',}}>
                            <Chip 
                              label={tutorial.difficulty === 'beginner' ? 'Nybegynner' :
                                     tutorial.difficulty === 'intermediate' ? 'Mellom' : 'Avansert'}
                              size="small"
                              color={tutorial.difficulty === 'beginner' ? 'success' :
                                     tutorial.difficulty === 'intermediate' ? 'warning' : 'error'}
                            />
                            <Chip label={tutorial.duration} size="small" variant="outlined" />
                          </Box>
                        </Box>
                      </Box>
                      
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        {tutorial.description}
                      </Typography>
                      
                      <Accordion>
                        <AccordionSummary expandIcon={{theming.getThemedIcon('expandMore')}}>
                          <Typography variant="subtitle2">🎯 Scenario</Typography>
                        </AccordionSummary>
                        <AccordionDetails>
                          <Typography variant="body2" sx={{ mb: 2 }}>
                            {tutorial.scenario}
                          </Typography>
                          <Typography variant="subtitle2" sx={{ mb: 1 }}>
                            Nøkkelfunksjoner: </Typography>
                          <List dense>
                            {tutorial.keyFeatures.map((feature, featureIndex) => (
                              <ListItem key={featureIndex} sx={{ py: 0 }}>
                                <ListItemIcon sx={{ minWidth: 3, 0,}}>
                                  <CheckCircle color="success" sx={{ fontSize: '1rem, ',}} />
                                </ListItemIcon>
                                <ListItemText 
                                  primary={feature}
                                  primaryTypographyProps={{ variant: 'body2, ',}}
                                />
                              </ListItem>
                            ))}
                          </List>
                        </AccordionDetails>
                      </Accordion>
                      
                      <Button variant="contained"
                        fullWidth
                        startIcon={theming.getThemedIcon('play')}
                        onClick={() = sx={theming.getThemedButtonSx()}> startTutorial(tutorial)}
                        sx={{ mt: ,  2bgcolor: category.color }}
                      >
                        Start veiledning
                      </Button>
                    </CardContent>
                  </MuiCard>
                </Grid>
              ))}
            </Grid>

            {getCurrentCategoryTutorials().length === 0 && (
              <Typography variant="body1" sx={{ textAlign: 'center', p:  ,  2bgcolor: 'info.light', borderRadius:  ,  1color: 'info.contrastText, ',}}>
                Ingen veiledninger tilgjengelig for {profession} i denne kategorien ennå.
              </Typography>
            )}
          </TabPanel>
        ))}

        {/* Tutorial Implementation Dialog */}
        {showTutorialDialog && selectedTutorial && (
          <Dialog 
            open={showTutorialDialog}
            onClose={() => setShowTutorialDialog(false)}
            maxWidth="md"
            fullWidth
          >
            <DialogTitle>
              <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
                <Avatar sx={{ bgcolor: professionColor }}>
                  {selectedTutorial.icon}
                </Avatar>
                <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>
                  {selectedTutorial.title}
                </Typography>
              </Box>
            </DialogTitle>
            <DialogContent>
              <Box sx={{ mb: 3, p:  ,  2bgcolor: 'info.light', borderRadius:  1 }}>
                <Typography variant="subtitle2" sx={{ mb: ,  1color: 'info.contrastText, ',}}>
                  🚧 Tutorial Under Utvikling
                </Typography>
                <Typography variant="body2" sx={{ color: 'info.contrastText, ',}}>
                  Denne veiledningen for <strong>{selectedTutorial.component}</strong> er planlagt og vil bli implementert 
                  med samme interaktive approach som Pro Tools plugin tutorial systemet.
                </Typography>
              </Box>
              
              <Typography variant="h6" sx={{ mb: 2 }} sx={{ ...{}, color: theming.colors.primary }}>
                Planlagt Innhold: </Typography>
              
              <Typography variant="body1" sx={{ mb: 2 }}>
                <strong>Scenario: </strong> {selectedTutorial.scenario}
              </Typography>
              
              <Typography variant="subtitle1" sx={{ mb: 1 }}>
                Nøkkelfunksjoner som dekkes: </Typography>
              <List>
                {selectedTutorial.keyFeatures.map((feature, index) => (
                  <ListItem key={index}>
                    <ListItemIcon>
                      <CheckCircle color="success" />
                    </ListItemIcon>
                    <ListItemText primary={feature} />
                  </ListItem>
                ))}
              </List>
              
              <Box sx={{ mt: ,  2p:  ,  2bgcolor: 'success.light', borderRadius:  1 }}>
                <Typography variant="body2" sx={{ color: 'success.contrastText, ',}}>
                  Alle veiledninger vil følge samme mønster som Pro Tools tutorial med: step-by-step instruksjoner, praktiske øvelser, real-world scenarios og interaktiv læring.
                </Typography>
              </Box>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => setShowTutorialDialog(false)}>
                Lukk
              </Button>
            </DialogActions>
          </Dialog>
        )}
      </DialogContent>
    </Dialog>
  );
};

export default UniversalTutorialSystem;