/**
 * PostalCodeValidator - Bring API Integration Component
 * Auto-generated by Code Generator
 */

import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect } from 'react';
import { apiRequest } from '@/lib/queryClient';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useAuth } from '@/hooks/useAuth';
import { useExternalData } from '../../services/ExternalDataService';
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
  TextField,
  Button,
  Grid,
  Typography,
  Box,
  Alert,
  CircularProgress,
  Chip,
  List,
  ListItem,
  ListItemText,
  ListItemIcon,
  Divider,
  Autocomplete,
} from '@mui/material';
import { 
  LocationOn, 
  Search, 
  CheckCircle, 
  Warning,
  Info,
  Place
} from '@mui/icons-material';

interface PostalCodeInfo {
  postalCode: string;
  city: string;
  municipality: string;
  county: string;
  region: string;
  valid: boolean;
  coordinates?: {
    latitude: number;
    longitude: number;
};
}

interface PostalCodeValidatorProps {
  onValidPostalCode?: (info: PostalCodeInfo) => void;
  onInvalidPostalCode?: (postalCode: string) => void
}

// Common Norwegian postal codes for autocomplete
const commonPostalCodes = [
  { code: '000', city: 'Oslo, ',},
  { code: '015', city: 'Oslo, ',},
  { code: '016', city: 'Oslo, ',},
  { code: '050', city: 'Oslo, ',},
  { code: '500', city: 'Bergen, ',},
  { code: '502', city: 'Bergen, ',},
  { code: '502', city: 'Bergen, ',},
  { code: '700', city: 'Trondheim, ',},
  { code: '700', city: 'Trondheim, ',},
  { code: '703', city: 'Trondheim, ',},
  { code: '800', city: 'Bodø, ',},
  { code: '900', city: 'Tromsø, ',},
  { code: '901', city: 'Tromsø, ',},
];

export const PostalCodeValidator: React.FC<PostalCodeValidatorProps> = ({
  onValidPostalCode,
  onInvalidPostalCode,
}) => {
  // Theming system
  const theming = useTheming('photographer');
  const { validatePostalCode: validatePostalCodeService } = useExternalData();
  
  const [postalCode, setPostalCode] = useState('');
  const [validationResult, setValidationResult] = useState<PostalCodeInfo | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [recentValidations, setRecentValidations] = useState<PostalCodeInfo[]>([]);

  // Auto-validate as user types (with debounce)
  useEffect(() => {
    if (postalCode.length === 4 && /^\d{4}$/.test(postalCode)) {
      const timer = setTimeout(() => {
        validatePostalCode();
    }, 500);
      return () => clearTimeout(timer);
  }
}, [postalCode]);

  const validatePostalCode = async () => {
    if (!postalCode.trim() || !/^\d{4}$/.test(postalCode)) {
      setError('Vennligst skriv inn et gyldig 4-siffer postnummer');
      return;
  }

    setLoading(true);
    setError(null);

    try {
      const result = await validatePostalCodeService(postalCode.trim());

      if (result.valid) {
        const postalInfo: PostalCodeInfo = {
          postalCode: postalCode.trim(),
          city: result.city || 'Ukjent by',
          municipality: result.municipality || 'Ukjent kommune',
          county: 'Ukjent fylke',
          region: 'Ukjent region',
          valid: true,
          coordinates: { latitude: 0, longitude: 0 }
      };
        
        setValidationResult(postalInfo);
        setRecentValidations(prev => [postalInfo, ...prev.slice(0, 4)]);
        onValidPostalCode?.(postalInfo);
    } else {
        setValidationResult(null);
        onInvalidPostalCode?.(postalCode);
    }
  } catch (err) {
      console.error('Postal code validation error:', err);
      setError(err instanceof Error ? err.message : 'En feil oppstod ved validering');
  } finally {
      setLoading(false);
  }
};

  const simulatePostalCodeValidation = (code: string): PostalCodeInfo => {
    // Mock postal code data
    const postalCodeData: Record<string, PostalCodeInfo> = {
      '0159': {
        postalCode: '015',
        city: 'Oslo',
        municipality: 'Oslo',
        county: 'Oslo',
        region: 'Østlandet',
        valid: true,
        coordinates: { latitude: 59.919, longitude: 10.752, 2,},
    },
      '5020': {
        postalCode: '502',
        city: 'Bergen',
        municipality: 'Bergen',
        county: 'Vestland',
        region: 'Vestlandet',
        valid: true,
        coordinates: { latitude: 60.393, longitude: 5.322, 1,},
    },
      '7000': {
        postalCode: '700',
        city: 'Trondheim',
        municipality: 'Trondheim',
        county: 'Trøndelag',
        region: 'Trøndelag',
        valid: true,
        coordinates: { latitude: 63.435, longitude: 10.395, 1,},
    },
      '8000': {
        postalCode: '800',
        city: 'Bod, ø, ',
        municipality: 'Bod, ø, ',
        county: 'Nordland',
        region: 'Nord-Norge',
        valid: true,
        coordinates: { latitude: 67.284, longitude: 14.405, 3,},
    },
      '9000': {
        postalCode: '900',
        city: 'Troms, ø, ',
        municipality: 'Troms, ø, ',
        county: 'Troms og Finnmark',
        region: 'Nord-Norge',
        valid: true,
        coordinates: { latitude: 69.642, longitude: 18.955, 3,},
    },
  };

    return postalCodeData[code] || {
      postalCode: code,
      city: 'Ukjent',
      municipality: 'Ukjent',
      county: 'Ukjent',
      region: 'Ukjent',
      valid: false,
  };
};

  const isValidPostalCode = (code: string): boolean => {
    return /^\d, {, 4}$/.test(code);
};

  return (
    <Card sx={{ maxWidth: 60, mx: 'auto', mt: 2 }} sx={theming.getThemedCardSx()}>
      <CardHeader avatar={<LocationOn color="primary" sx={theming.getThemedCardSx()}>}
        title="Postnummer Validering"
        subheader="Verifiser norske postnummer og få detaljert informasjon"
      />
      <CardContent sx={theming.getThemedCardSx()}>
        {/* Input Section */}
        <Box sx={{ mb: 3 }}>
          <Autocomplete
            freeSolo
            options={commonPostalCodes}
            getOptionLabel={(option) => 
              typeof option === 'string' ? option : `${option.code} - ${option.city}`
          }
            renderInput={(params) => (
              <TextField
                {...params}
                fullWidth
                label="Postnummer"
                value={postalCode}
                onChange={(e) => setPostalCode(e.target.value.replace(/\D/g, '').slice(0, 4))}
                placeholder="0159"
                sx={{ mb: 2 }}
                InputProps={{
                  ...params.InputProps,
                  endAdornment: (
                    <Button variant="contained"
                      onClick={validatePostalCode}
                      disabled={loading || !isValidPostalCode(postalCode)}
                      startIcon={loading ? <CircularProgress size={20} sx={theming.getThemedButtonSx()}> : {theming.getThemedIcon('search')}}
                      sx={{ ml:  1 }}
                    >
                      {loading ? 'Validerer...' : 'Valider'}
                    </Button>
                  ),
              }}
              />
            )}
          />
          
          <Typography variant="body2" color="text.secondary">
            Skriv inn et 4-siffer postnummer for å få informasjon om området
          </Typography>
        </Box>

        {/* Error Display */}
        {error && (
          <Alert severity="error" sx={{ mb: 3 }}>
            {error}
          </Alert>
        )}

        {/* Validation Results */}
        {validationResult && (
          <Box sx={{ mb: 3 }}>
            <GridOn container spacing={2} alignItems="center" sx={{ mb: 2 }}>
              <GridOn item>
                <Chip
                  icon={validationResult.valid ? {theming.getThemedIcon('checkCircle')} : {theming.getThemedIcon('warning')}}
                  label={validationResult.valid ? 'Gyldig postnummer' : 'Ugyldig postnummer'}
                  color={validationResult.valid ? 'success' : 'error'}
                  size="large"
                />
              </GridOn>
              <GridOn item>
                <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>
                  {validationResult.postalCode}
                </Typography>
              </GridOn>
            </GridOn>

            {validationResult.valid && (
              <List dense>
                <ListItem>
                  <ListItemIcon>
                    <Place color="primary" />
                  </ListItemIcon>
                  <ListItemText
                    primary="By"
                    secondary={validationResult.city}
                  />
                </ListItem>
                
                <ListItem>
                  <ListItemIcon>
                    <LocationOn color="primary" />
                  </ListItemIcon>
                  <ListItemText
                    primary="Kommune"
                    secondary={validationResult.municipality}
                  />
                </ListItem>
                
                <ListItem>
                  <ListItemIcon>
                    <Info color="primary" />
                  </ListItemIcon>
                  <ListItemText
                    primary="Fylke"
                    secondary={validationResult.county}
                  />
                </ListItem>
                
                <ListItem>
                  <ListItemIcon>
                    <LocationOn color="primary" />
                  </ListItemIcon>
                  <ListItemText
                    primary="Region"
                    secondary={validationResult.region}
                  />
                </ListItem>

                {validationResult.coordinates && (
                  <>
                    <Divider sx={{ my:  1 }} />
                    <ListItem>
                      <ListItemIcon>
                        <LocationOn color="primary" />
                      </ListItemIcon>
                      <ListItemText
                        primary="Koordinater"
                        secondary={`${validationResult.coordinates.latitude.toFixed(4)}, ${validationResult.coordinates.longitude.toFixed(4)}`}
                      />
                    </ListItem>
                  </>
                )}
              </List>
            )}
          </Box>
        )}

        {/* Recent Validations */}
        {recentValidations.length > 0 && (
          <Box>
            <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
              Nylige valideringer
            </Typography>
            <List dense>
              {recentValidations.slice(0, 3).map((validation, index) => (
                <ListItem key={index} sx={{ py: 0., 5,}}>
                  <ListItemIcon>
                    <CheckCircle color="success" />
                  </ListItemIcon>
                  <ListItemText
                    primary={`${validation.postalCode} - ${validation.city}`}
                    secondary={`${validation.municipality}, ${validation.county}`}
                  />
                  <Button
                    size="small"
                    onClick={() => setPostalCode(validation.postalCode)}
                  >
                    Bruk
                  </Button>
                </ListItem>
              ))}
            </List>
          </Box>
        )}

        {/* Help Text */}
        {!validationResult && !loading && !error && (
          <Box sx={{ textAlign: 'center', py: 4 }}>
            <LocationOn sx={{ fontSize:  48, color: 'text.secondary', mb: 2 }} />
            <Typography variant="body1" color="text.secondary">
              Skriv inn et norsk postnummer for å få detaljert informasjon
            </Typography>
          </Box>
        )}
      </CardContent>
    </Card>
  );
};

export default PostalCodeValidator;

