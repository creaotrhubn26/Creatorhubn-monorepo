/**
 * Onboarding Plan Selection Step
 * Integrates PlatformPricingService with Trial System
 */

import React, { useState } from 'react';
import {
  Box,
  Card,
  CardContent,
  Typography,
  Button,
  Grid,
  Chip,
  Alert,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Radio,
  RadioGroup,
  FormControlLabel,
  Divider,
} from '@mui/material';
import {
  CheckCircle,
  Star,
  TrendingUp,
  Security,
  Speed,
} from '@mui/icons-material';
import { usePlatformPricing } from '../../services/PlatformPricingService';
import type { PlatformSubscriptionPlan } from '../../services/PlatformPricingService';

interface OnboardingPlanSelectionProps {
  onPlanSelected: (plan: PlatformSubscriptionPlan, startTrial: boolean) => void;
  selectedProfession?: string;
}

export function OnboardingPlanSelection({
  onPlanSelected,
  selectedProfession,
}: OnboardingPlanSelectionProps) {
  const { subscriptionPlans, formatPrice, isLoading } = usePlatformPricing();
  const [selectedPlanId, setSelectedPlanId] = useState<string>('free');
  const [wantsTrial, setWantsTrial] = useState(true);

  const handleContinue = () => {
    const selectedPlan = subscriptionPlans.find(p => p.id === selectedPlanId);
    if (selectedPlan) {
      onPlanSelected(selectedPlan, wantsTrial && selectedPlan.trialDays > 0);
    }
  };

  const getPlanIcon = (tier: string) => {
    switch (tier) {
      case 'premium':
      case 'enterprise':
        return <Star sx={{ color: '#ffd700' }} />;
      case 'professional':
        return <TrendingUp sx={{ color: '#ff8c00' }} />;
      default:
        return <CheckCircle sx={{ color: '#4caf50' }} />;
    }
  };

  return (
    <Box>
      <Typography variant="h5" gutterBottom sx={{ textAlign: 'center', mb: 4 }}>
        Velg din plan
      </Typography>

      <Typography variant="body1" color="text.secondary" sx={{ textAlign: 'center', mb: 4 }}>
        Start med en gratis prøveperiode eller velg en plan som passer dine behov
      </Typography>

      {isLoading ? (
        <Box sx={{ textAlign: 'center', py: 4 }}>
          <Typography>Laster planer...</Typography>
        </Box>
      ) : (
        <Grid container spacing={3}>
          {subscriptionPlans.map((plan) => {
            const isSelected = selectedPlanId === plan.id;
            const hasTrial = plan.trialDays > 0;

            return (
              <Grid item xs={12} md={plan.isPopular ? 12 : 6} key={plan.id}>
                <Card
                  sx={{
                    border: isSelected ? '3px solid' : '1px solid',
                    borderColor: isSelected ? 'primary.main' : 'divider',
                    bgcolor: plan.isPopular ? 'primary.50' : 'background.paper',
                    position: 'relative',
                    cursor: 'pointer',
                    transition: 'all 0.2s',
                    '&:hover': {
                      borderColor: 'primary.main',
                      boxShadow: 4,
                    },
                  }}
                  onClick={() => setSelectedPlanId(plan.id)}
                >
                  {plan.isPopular && (
                    <Chip
                      label="Most Popular"
                      color="primary"
                      size="small"
                      sx={{ position: 'absolute', top: 16, right: 16 }}
                    />
                  )}

                  <CardContent sx={{ p: 3 }}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 2 }}>
                      <FormControlLabel
                        value={plan.id}
                        control={<Radio checked={isSelected} />}
                        label=""
                        sx={{ m: 0 }}
                      />
                      {getPlanIcon(plan.tier)}
                      <Box sx={{ flex: 1 }}>
                        <Typography variant="h6" gutterBottom>
                          {plan.displayName}
                        </Typography>
                        <Typography variant="body2" color="text.secondary">
                          {plan.description}
                        </Typography>
                      </Box>
                    </Box>

                    <Divider sx={{ my: 2 }} />

                    {/* Price */}
                    <Box sx={{ mb: 3 }}>
                      <Typography variant="h4" sx={{ fontWeight: 600 }}>
                        {formatPrice(plan.price, plan.currency)}
                        <Typography component="span" variant="body2" color="text.secondary">
                          /{plan.billingCycle === 'monthly' ? 'måned' : 'år'}
                        </Typography>
                      </Typography>

                      {hasTrial && wantsTrial && (
                        <Alert severity="success" sx={{ mt: 2 }}>
                          <Typography variant="body2">
                            🎉 Start med {plan.trialDays} dagers gratis prøveperiode!
                          </Typography>
                        </Alert>
                      )}
                    </Box>

                    {/* Features */}
                    <List dense>
                      {plan.features.slice(0, 6).map((feature, index) => (
                        <ListItem key={index} sx={{ px: 0, py: 0.5 }}>
                          <ListItemIcon sx={{ minWidth: 32 }}>
                            <CheckCircle sx={{ fontSize: 18, color: 'success.main' }} />
                          </ListItemIcon>
                          <ListItemText
                            primary={feature}
                            primaryTypographyProps={{ variant: 'body2' }}
                          />
                        </ListItem>
                      ))}
                    </List>

                    {/* Limits */}
                    <Box sx={{ mt: 2, p: 2, bgcolor: 'background.default', borderRadius: 1 }}>
                      <Grid container spacing={2}>
                        <Grid item xs={4}>
                          <Typography variant="caption" color="text.secondary">
                            Users
                          </Typography>
                          <Typography variant="body2" fontWeight={600}>
                            {plan.limits.maxUsers === -1 ? '∞' : plan.limits.maxUsers}
                          </Typography>
                        </Grid>
                        <Grid item xs={4}>
                          <Typography variant="caption" color="text.secondary">
                            Projects
                          </Typography>
                          <Typography variant="body2" fontWeight={600}>
                            {plan.limits.maxProjects === -1 ? '∞' : plan.limits.maxProjects}
                          </Typography>
                        </Grid>
                        <Grid item xs={4}>
                          <Typography variant="caption" color="text.secondary">
                            Storage
                          </Typography>
                          <Typography variant="body2" fontWeight={600}>
                            {plan.limits.maxStorageGB === -1 ? '∞' : `${plan.limits.maxStorageGB}GB`}
                          </Typography>
                        </Grid>
                      </Grid>
                    </Box>
                  </CardContent>
                </Card>
              </Grid>
            );
          })}
        </Grid>
      )}

      {/* Trial Toggle */}
      <Box sx={{ mt: 4, p: 3, bgcolor: 'background.paper', borderRadius: 2 }}>
        <FormControlLabel
          control={
            <Radio
              checked={wantsTrial}
              onChange={(e) => setWantsTrial(e.target.checked)}
            />
          }
          label={
            <Box>
              <Typography variant="body1" fontWeight={600}>
                Start med gratis prøveperiode
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Test alle premium funksjoner uten kostnad. Ingen kredittkort påkrevd.
              </Typography>
            </Box>
          }
        />
      </Box>

      {/* Continue Button */}
      <Box sx={{ mt: 4, display: 'flex', justifyContent: 'center' }}>
        <Button
          variant="contained"
          size="large"
          onClick={handleContinue}
          disabled={!selectedPlanId}
          sx={{ minWidth: 200, py: 1.5 }}
        >
          {wantsTrial && subscriptionPlans.find(p => p.id === selectedPlanId)?.trialDays
            ? `Start ${subscriptionPlans.find(p => p.id === selectedPlanId)?.trialDays}-dagers prøveperiode`
            : 'Fortsett'}
        </Button>
      </Box>
    </Box>
  );
}
