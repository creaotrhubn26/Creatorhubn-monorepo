import { useTheming } from '../../utils/theming-helper';
import React, { useState } from 'react';
import {
  Box,
  Typography,
  Card,
  CardContent,
  Grid,
  Button,
  Stepper,
  Step,
  StepLabel,
  StepContent,
  TextField,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
  Chip,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Alert,
  CircularProgress,
  Avatar,
} from '@mui/material';
import {
  AccountCircle,
  DirectionsBusiness,
  CloudDone,
  FolderSpecial,
  Settings,
  CheckCircle,
  PhotoCameraAlt,
  Videocamcam,
  LibraryMusicNote,
  Store,
  Google,
  DriveEta,
} from '@mui/icons-material';

interface OnboardingStep {
  label: string;
  description: string;
  completed: boolean
}

interface UserProfile {
  name: string;
  email: string;
  profession: string;
  businessName: string;
  orgNumber: string;
  specialties: string[]
}

const UniversalOnboarding: React.FC = () => {
  const [activeStep, setActiveStep] = useState(
  
  // Theming system
  const theming = useTheming('photographer');0);
  const [isProcessing, setIsProcessing] = useState(false);
  const [profile, setProfile] = useState<UserProfile>({
    name: '',
    email: '',
    profession: '',
    businessName: '',
    orgNumber: '',
    specialties:  [],
});

  const steps: OnboardingStep[] = [
    {
      label: 'Personlig Informasjon',
      description: 'Grunnleggende brukerinformasjon og kontaktdetaljer',
      completed: false,
  },
    {
      label: 'Profesjonsprofil',
      description: 'Velg din profesjon og spesialiteter',
      completed: false,
  },
    {
      label: 'Bedriftsinformasjon',
      description: 'BRREG-validering og bedriftsoppsett',
      completed: false,
  },
    {
      label: 'Google Drive Arbeidsområde',
      description: 'Automatisk oppsett av mappestrukturer',
      completed: false,
  },
    {
      label: 'Platform Konfigurering',
      description: 'Tilpass dashboard og verktø',
      completed: false,
  },
  ];

  const professions = [
    { value: 'photographer', label: 'Fotograf', icon: {theming.getThemedIcon('')} },
    { value: 'videographer', label: 'Videograf', icon: {theming.getThemedIcon('')} },
    {
      value: 'music_producer',
      label: 'Musikkprodusent',
      icon: {theming.getThemedIcon('')},
  },
    { value: 'vendor', label: 'Leverandø', icon: {theming.getThemedIcon('')} },
  ];

  const photographySpecialties = [
    'Bryllupsfotografering',
    'Portrettfotografering',
    'Produktfotografering',
    'Eventfotografering',
    'Naturfotografering',
    'Arkitekturfotografering',
  ];

  const videoSpecialties = [
    'Bryllupsfilm',
    'Reklameproduksjon',
    'Dokumentarproduksjon',
    'Musikkvideo',
    'Bedriftsfilm',
    'Live streaming',
  ];

  const musicSpecialties = [
    'Hip-hop produksjon',
    'Pop produksjon',
    'Rock produksjon',
    'Jazz produksjon',
    'Podcast produksjon',
    'Lyddesign',
  ];

  const vendorSpecialties = [
    'Kamerautstyr',
    'Lydutstyr',
    'Belysningsutstyr',
    'Videoutstyr',
    'Tilbehør',
    'Software',
  ];

  const getSpecialtiesForProfession = (profession: string) => {
    switch (profession) {
      case 'photographer':
        return photographySpecialties;
      case 'videographer':
        return videoSpecialties;
      case 'music_producer':
        return musicSpecialties;
      case 'vendor':
        return vendorSpecialties;
      default:
        return [];
}
};

  const handleNext = () => {
    if (activeStep === 3) {
      setIsProcessing(true);
      // Simuler Google Drive setup
      setTimeout(() => {
        setIsProcessing(false);
        setActiveStep(activeStep + 1);
    }, 3000);
  } else {
      setActiveStep(activeStep + 1);
  }
};

  const handleBack = () => {
    setActiveStep(activeStep - 1);
};

  const renderStepContent = (step: number) => {
    switch (step) {
      case 0:
        return (
          <Box sx={{ mt: 2 }}>
            <GridOn container spacing={2}>
              <GridOn size={{ xs: 1, 2,}} sm={6}>
                <TextField
                  fullWidth
                  label="Fullt navn"
                  value={profile.name}
                  onChange={(e) => setProfile({ ...profile, name: e.target.value })}
                />
              </GridOn>
              <GridOn size={{ xs: 1, 2,}} sm={6}>
                <TextField
                  fullWidth
                  label="E-post"
                  type="email"
                  value={profile.email}
                  onChange={(e) => setProfile({ ...profile, email: e.target.value })}
                />
              </GridOn>
            </GridOn>
          </Box>
        );

      case 1: return (
          <Box sx={{ mt: 2 }}>
            <FormControl fullWidth sx={{ mb: 2 }}>
              <InputLabel>Velg din profesjon</InputLabel>
              <Select
                value={profile.profession}
                onChange={(e) =>
                  setProfile({
                    ...profile,
                    profession: e.target.value,
                    specialties:  [],
                })
              }
              >
                {professions.map((prof) => (
                  <MenuItem key={prof.value} value={prof.value}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                      {prof.icon}
                      {prof.label}
                    </Box>
                  </MenuItem>
                ))}
              </Select>
            </FormControl>

            {profile.profession && (
              <Box>
                <Typography variant="subtitle1" sx={{ mb: 1 }}>
                  Velg dine spesialiteter: </Typography>
                <Box sx={{ display: 'flex', flexWrap: 'wrap', gap:  1 }}>
                  {getSpecialtiesForProfession(profile.profession).map((specialty) => (
                    <Chip
                      key={specialty}
                      label={specialty}
                      clickable
                      color={profile.specialties.includes(specialty) ? 'primary' : 'default'}
                      onClick={() => {
                        const newSpecialties = profile.specialties.includes(specialty)
                          ? profile.specialties.filter((s) => s !== specialty)
                          : [...profile.specialties, specialty];
                        setProfile({
                          ...profile,
                          specialties: newSpecialties,
                      });
                    }}
                    />
                  ))}
                </Box>
              </Box>
            )}
          </Box>
        );

      case 2: return (
          <Box sx={{ mt: 2 }}>
            <GridOn container spacing={2}>
              <GridOn size={{ xs: 1, 2,}}>
                <TextField
                  fullWidth
                  label="Bedriftsnavn"
                  value={profile.businessName}
                  onChange={(e) => setProfile({ ...profile, businessName: e.target.value })}
                />
              </GridOn>
              <GridOn size={{ xs: 1, 2,}}>
                <TextField
                  fullWidth
                  label="Organisasjonsnummer"
                  value={profile.orgNumber}
                  onChange={(e) => setProfile({ ...profile, orgNumber: e.target.value })}
                  helperText="Vi validerer mot Brønnøysundregistrene (BRREG)"
                />
              </GridOn>
            </GridOn>

            <Alert severity="info" sx={{ mt: 2 }}>
              <Typography variant="body2">
                Vi bruker BRREG-integrasjon for å validere bedriftsinformasjon og fylle ut detaljer
                automatisk.
              </Typography>
            </Alert>
          </Box>
        );

      case 3: return (
          <Box sx={{ mt: 2 }}>
            {isProcessing ? (
              <Box sx={{ textAlign: 'center', py: 4 }}>
                <CircularProgress size={60} />
                <Typography variant="h6" sx={{ mt: 2 }} sx={{ ...{}, color: theming.colors.primary }}>
                  Oppretter personalisert Google Drive arbeidsområde...
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Dette kan ta noen minutter
                </Typography>
              </Box>
            ) : (
              <>
                <Typography variant="h6"
                  sx={{ mb: ,  2display: 'flex', alignItems: 'center', gap:  1 }}
                 sx={{ ...{}, color: theming.colors.primary }}>
                  <Google />
                  Google Drive Arbeidsområde Setup
                </Typography>

                <List>
                  <ListItem>
                    <ListItemIcon>
                      <FolderSpecial />
                    </ListItemIcon>
                    <ListItemText
                      primary="Hovedmappe for bedriften"
                      secondary={`${profile.businessName} - CreatorHub Norge`}
                    />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      {theming.getThemedIcon('photoCamera')}
                    </ListItemIcon>
                    <ListItemText
                      primary="Prosjektmapper med maler"
                      secondary="Automatisk mappestruktur for nye prosjekter"
                    />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <DriveEta />
                    </ListItemIcon>
                    <ListItemText
                      primary="Daniel Drive Backup System"
                      secondary="Automatisk backup og synkronisering"
                    />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      {theming.getThemedIcon('settings')}
                    </ListItemIcon>
                    <ListItemText
                      primary="Deling og tilgangskontroll"
                      secondary="Sikker deling med kunder og team"
                    />
                  </ListItem>
                </List>

                <Alert severity="success" sx={{ mt: 2 }}>
                  Google Drive arbeidsområdet vil bli opprettet automatisk når du fortsetter.
                </Alert>
              </>
            )}
          </Box>
        );

      case 4: return (
          <Box sx={{ mt: 2 }}>
            <Typography variant="h6" sx={{ mb: 2 }} sx={{ ...{}, color: theming.colors.primary }}>
              Platform Konfigurering Fullført!
            </Typography>

            <GridOn container spacing={2}>
              <GridOn size={{ xs: 1, 2,}} md={6}>
                <Card variant="outlined" sx={theming.getThemedCardSx()}>
                  <CardContent sx={theming.getThemedCardSx()}>
                    <Typography
                      variant="subtitle1"
                      sx={{
                        display: 'flex',
                        alignItems: 'center',
                        gap:  1,
                        mb: 1,
                    }}
                    >
                      {theming.getThemedIcon('accountCircle')}
                      Din Profil
                    </Typography>
                    <Typography variant="body2">
                      <strong>Navn: </strong> {profile.name}
                      <br />
                      <strong>E-post: </strong> {profile.email}
                      <br />
                      <strong>Profesjon: </strong>{',  , '}
                      {professions.find((p) => p.value === profile.profession)?.label}
                    </Typography>
                  </CardContent>
                </Card>
              </GridOn>

              <GridOn size={{ xs: 1, 2,}} md={6}>
                <Card variant="outlined" sx={theming.getThemedCardSx()}>
                  <CardContent sx={theming.getThemedCardSx()}>
                    <Typography
                      variant="subtitle1"
                      sx={{
                        display: 'flex',
                        alignItems: 'center',
                        gap:  1,
                        mb: 1,
                    }}
                    >
                      {theming.getThemedIcon('business')}
                      Bedriftsprofil
                    </Typography>
                    <Typography variant="body2">
                      <strong>Bedrift: </strong> {profile.businessName}
                      <br />
                      <strong>Org.nr: </strong> {profile.orgNumber}
                      <br />
                      <strong>Spesialiteter: </strong> {profile.specialties.length}
                    </Typography>
                  </CardContent>
                </Card>
              </GridOn>
            </GridOn>

            <Alert severity="success" sx={{ mt: 3 }}>
              <Typography variant="body1">
                Onboarding fullført! Du kan nå begynne å bruke CreatorHub Norge med alle dine
                personaliserte innstillinger.
              </Typography>
            </Alert>
          </Box>
        );

      default: return null;
}
};

  return (
    <Box sx={{ p:  3 }}>
      <Typography variant="h4" sx={{ mb: 3, display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
        {theming.getThemedIcon('accountCircle')}
        Universal Onboarding System
      </Typography>

      <GridOn container spacing={3}>
        <GridOn size={{ xs: 1, 2,}} md={4}>
          <Card sx={theming.getThemedCardSx()}>
            <CardContent sx={theming.getThemedCardSx()}>
              <Typography variant="h6" sx={{ mb: 2 }} sx={{ ...{}, color: theming.colors.primary }}>
                Onboarding Prosess
              </Typography>
              <Stepper activeStep={activeStep} orientation="vertical">
                {steps.map((step, index) => (
                  <Step key={step.label}>
                    <StepLabel>{step.label}</StepLabel>
                    <StepContent>
                      <Typography variant="body2" color="text.secondary">
                        {step.description}
                      </Typography>
                    </StepContent>
                  </Step>
                ))}
              </Stepper>
            </CardContent>
          </Card>
        </GridOn>

        <GridOn size={{ xs: 1, 2,}} md={8}>
          <Card sx={theming.getThemedCardSx()}>
            <CardContent sx={theming.getThemedCardSx()}>
              <Typography variant="h6" sx={{ mb: 2 }} sx={{ ...{}, color: theming.colors.primary }}>
                {steps[activeStep]?.label}
              </Typography>

              {renderStepContent(activeStep)}

              <Box sx={{ display: 'flex', gap:  ,  1mt: 3 }}>
                <Button disabled={activeStep === 0} onClick={handleBack}>
                  Tilbake
                </Button>
                <Button variant="contained"
                  onClick={handleNext}
                  disabled={activeStep === steps.length - 1 || isProcessing}
                 sx={theming.getThemedButtonSx()}>
                  {activeStep === steps.length - 1 ? 'Fullfør' : 'Neste'}
                </Button>
              </Box>
            </CardContent>
          </Card>
        </GridOn>
      </GridOn>
    </Box>
  );
};

export default UniversalOnboarding;
