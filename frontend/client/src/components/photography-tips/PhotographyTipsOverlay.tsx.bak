import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect } from 'react';
import { apiRequest } from '@/lib/queryClient';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useAuth } from '@/hooks/useAuth';
import {
  Fab,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Card,
  CardContent,
  Typography,
  Chip,
  Box,
  IconButton,
  Button,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Divider,
  Rating,
  Slide,
  Alert,
  CircularProgress,
  Badge,
  Tooltip,
  Grid,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
  TextField,
  InputAdornment,
} from '@mui/material';
import {
  TipsAndUpdates as TipsIcon,
  Close as CloseIcon,
  ExpandMore as ExpandMoreIcon,
  PhotoCamera as CameraIcon,
  Brightness6 as LightingIcon,
  LocationOn as LocationIcon,
  Schedule as TimeIcon,
  Bookmark as BookmarkIcon,
  BookmarkBorder as BookmarkBorderIcon,
  ThumbUp as ThumbUpIcon,
  ThumbDown as ThumbDownIcon,
  Search as SearchIcon,
  FilterList as FilterIcon,
  Lightbulb as LightbulbIcon,
  Settings as SettingsIcon,
  School as LearnIcon,
  AutoAwesome as MagicIcon
} from '@mui/icons-material';
import { TransitionProps } from '@mui/material/transitions';
import { PhotographyTip, TipContext } from '../../shared/photography-tips-schema';

const Transition = React.forwardRef(function Transition(
  props: TransitionProps & {
    children: React.ReactElement;
},
  ref: React.Ref<unknown>,
) {
  return <Slide direction="up" ref={ref} {...props} />;
});

interface PhotographyTipsOverlayProps {
  context?: TipContext;
  userId?: string;
  onTipInteraction?: (tipId: string, interactionType: string) => void
}

export const PhotographyTipsOverlay: React.FC<PhotographyTipsOverlayProps> = ({
  context =,  , {},
  userId = 'photographer_user',
  onTipInteraction
}) => {
  const [open, setOpen] = useState(false);
  const [selectedTip, setSelectedTip] = useState<PhotographyTip | null>(null);
  const [bookmarkedTips, setBookmarkedTips] = useState<Set<string>>(new Set());
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategory, setSelectedCategory] = useState<string>('');
  const [showSettings, setShowSettings] = useState(false);
  
  const queryClient = useQueryClient();
  
  // Theming system
  const theming = useTheming('photographer');

  // Fetch contextual tips
  const { data: tipsData, isLoading } = useQuery({
    queryKey: ['/api/photography-tips', context],
    enabled: open,
    queryFn: () => apiRequest(['/api/photography-tips', context], {
      headers: {
  }
  }),
});

  // Fetch categories
  const { data: categoriesData } = useQuery({
    queryKey: ['/api/photography-tips/categories, '],
    enabled: open,
    queryFn: async () => {
      return apiRequest('/api/photography-tips/categories', {
        headers: auth
  });
  },
});

  // Search tips
  const { data: searchResults, isLoading: isSearching } = useQuery({
    queryKey: ['/api/photography-tips/search', searchQuery, selectedCategory],
    enabled: open && (searchQuery.length > 0 || selectedCategory.length > 0),
    queryFn: () => apiRequest(['/api/photography-tips/search', searchQuery, selectedCategory], {
      headers: {
  }
  }),
});

  // Track interaction mutation
  const interactionMutation = useMutation({
    mutationFn: async (data: { tipId: string; interactionType: string; context?: any }) => {
      const response = await fetch('/api/photography-tips/interaction', {
        headers: {
          ...auth,
          'Content-Type': 'application/json'
      },
        method: 'POST',
        body: JSON.stringify({
          ...data,
          userId,
          context: context
    })
    });
      if (!response.ok) throw new Error('Failed to track interaction');
      return response.json();
  },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['/api/photography-tips'],});
  }
});

  const tips = searchResults?.results || tipsData?.tips || [];
  const categories = categoriesData?.categories || [];

  // Handle tip interaction
  const handleTipInteraction = (tipId: string, interactionType: string) => {
    interactionMutation.mutate({
      tipd,
      interactionType,
      context
  });
    
    if (interactionType === 'bookmark') {
      setBookmarkedTips(prev => {
        const newSet = new Set(prev);
        if (newSet.has(tipId)) {
          newSet.delete(tipId);
      } else {
          newSet.add(tipId);
      }
        return newSet;
    });
  }
    
    onTipInteraction?.(tipId, interactionType);
};

  // Open tip details
  const openTipDetails = (tip: PhotographyTip) => {
    setSelectedTip(tip);
    handleTipInteraction(tip.id!, 'view');
};

  // Get contextual tip count
  const contextualTipCount = tips.length;
  const hasNewTips = contextualTipCount > 0;

  return (
    <>
      {/* Floating Action Button */}
      <Tooltip title="Fotograferingstips" arrow>
        <Fab
          color="primary"
          sx={{
            position: 'fixed',
            bottom: 10,
            right:  24,
            background: 'linear-gradient(135deg, #ff6b35 0%, #f7931e 100%)',
            '&:hover': {
              transform: 'scale(1.1, ), ',
              boxShadow: '0 8px 25px rgba(25, 107, 53, 0.4)'
          },
            transition: 'all 0.3s ease',
            zIndex: 1000
      }}
          onClick={() => setOpen(true)}
        >
          <Badge
            badgeContent={hasNewTips ? contextualTipCount : 0}
            color="error"
            sx={{ '& .MuiBadge-badge': { fontSize: '0.7rem', minWidth: '16px', height: '16px, ',} }}
          >
            <TipsIcon />
          </Badge>
        </Fab>
      </Tooltip>

      {/* Main Tips Dialog */}
      <Dialog
        fullScreen
        open={open}
        onClose={() => setOpen(false)}
        TransitionComponent={Transition}
        sx={{
          '& .MuiDialog-paper': {
            background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
        }
      }}
      >
        <DialogTitle
          sx={{
            background: 'rgba(25, 255, 255, 0.1)',
            backdropFilter: 'blur(10px, ), ',
            color: 'white',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderBottom: '1px solid rgba(25, 255, 255, 0.2)'
        }}
        >
          <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
            <LightbulbIcon />
            <Typography variant="h6" sx={{ fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
              Fotograferingstips
            </Typography>
            {hasNewTips && (
              <Chip
                label={`${contextualTipCount} relevante tips`}
                size="small"
                sx={{
                  background: 'rgba(25, 255, 255, 0.2)',
                  color: 'white',
                  border: '1px solid rgba(25, 255, 255, 0.3)'
              }}
              />
            )}
          </Box>
          <Box sx={{ display: 'flex', gap:  1 }}>
            <IconButton
              onClick={() => setShowSettings(!showSettings)}
              sx={{ color: 'white, ',}}
            >
              <SettingsIcon />
            </IconButton>
            <IconButton
              onClick={() => setOpen(false)}
              sx={{ color: 'white, ',}}
            >
              <CloseIcon />
            </IconButton>
          </Box>
        </DialogTitle>

        <DialogContent sx={{ p:  0 }}>
          {/* Search and Filter Bar */}
          <Box
            sx={{
              p:  2,
              background: 'rgba(25, 255, 255, 0.05)',
              backdropFilter: 'blur(10px, ), ',
              borderBottom: '1px solid rgba(25, 255, 255, 0.1)'
          }}
          >
            <Grid container spacing={2} alignItems="center">
              <Grid size={{ xs: 1, 2,}} sm={6}>
                <TextField
                  fullWidth
                  placeholder="Søk etter tips..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  InputProps={{
                    startAdornment: (
                      <InputAdornment position="start">
                        <SearchIcon sx={{ color: 'white, ',}} />
                      </InputAdornment>
                    ),
                    sx: {
                      color: 'white',
                      '& .MuiOutlinedInput-notchedOutline': {
                        borderColor: 'rgba(25, 255, 255, 0.3)'
                    },
                      '&:hover .MuiOutlinedInput-notchedOutline': {
                        borderColor: 'rgba(25, 255, 255, 0.5)'
                    },
                      '&.Mui-focused .MuiOutlinedInput-notchedOutline': {
                        borderColor: '#ff6b35'
                  }
                  }
                }}
                />
              </Grid>
              <Grid size={{ xs: 1, 2,}} sm={4}>
                <FormControl fullWidth>
                  <InputLabel sx={{ color: 'white, ',}}>Kategori</InputLabel>
                  <Select
                    value={selectedCategory}
                    onChange={(e) => setSelectedCategory(e.target.value)}
                    sx={{
                      color: 'white',
                      '& .MuiOutlinedInput-notchedOutline': {
                        borderColor: 'rgba(25, 255, 255, 0.3)'
                    },
                      '&:hover .MuiOutlinedInput-notchedOutline': {
                        borderColor: 'rgba(25, 255, 255, 0.5)'
                    },
                      '&.Mui-focused .MuiOutlinedInput-notchedOutline': {
                        borderColor: '#ff6b35'
                  }
                  }}
                  >
                    <MenuItem value="">Alle kategorier</MenuItem>
                    {categories.map((category: any) => (
                      <MenuItem key={category.d} value={category.id}>
                        {category.name} ({category.count})
                      </MenuItem>
                    ))}
                  </Select>
                </FormControl>
              </Grid>
              <Grid size={{ xs: 1, 2,}} sm={2}>
                <Button
                  fullWidth
                  variant="outlined"
                  startIcon={<FilterIcon />}
                  sx={{
                    color: 'white',
                    borderColor: 'rgba(25, 255, 255, 0.3)',
                    '&:hover': {
                      borderColor: 'rgba(25, 255, 255, 0.5)',
                      background: 'rgba(25, 255, 255, 0.05)'
                  }
                }}
                >
                  Filter
                </Button>
              </Grid>
            </Grid>
          </Box>

          {/* Context Information */}
          {Object.keys(context).length > 0 && (
            <Box
              sx={{
                p:  2,
                background: 'rgba(25, 255, 255, 0.08)',
                borderBottom: '1px solid rgba(25, 255, 255, 0.1)'
            }}
            >
              <Typography variant="body2" sx={{ color: 'white', mb: ,  1opacity: 0., 9,}}>
                Basert på din nåværende situasjon: </Typography>
              <Box sx={{ display: 'flex', flexWrap: 'wrap', gap:  1 }}>
                {context.currentCamera && (
                  <Chip
                    icon={<CameraIcon />}
                    label={context.currentCamera}
                    size="small"
                    sx={{ background: 'rgba(25, 255, 255, 0.2)', color: 'white, ',}}
                  />
                )}
                {context.lightingCondition && (
                  <Chip
                    icon={<LightingIcon />}
                    label={context.lightingCondition}
                    size="small"
                    sx={{ background: 'rgba(25, 255, 255, 0.2)', color: 'white, ',}}
                  />
                )}
                {context.location && (
                  <Chip
                    icon={<LocationIcon />}
                    label={context.location}
                    size="small"
                    sx={{ background: 'rgba(25, 255, 255, 0.2)', color: 'white, ',}}
                  />
                )}
                {context.timeOfDay && (
                  <Chip
                    icon={<TimeIcon />}
                    label={context.timeOfDay}
                    size="small"
                    sx={{ background: 'rgba(25, 255, 255, 0.2)', color: 'white, ',}}
                  />
                )}
              </Box>
            </Box>
          )}

          {/* Tips List */}
          <Box sx={{ p:  ,  2minHeight: '60vh', maxHeight: '60vh', overflowY: 'auto, ',}}>
            {isLoading || isSearching ? (
              <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: 20, 0,}}>
                <CircularProgress sx={{ color: 'white, ',}} />
              </Box>
            ) : tips.length === 0 ? (
              <Alert
                severity="info"
                sx={{
                  background: 'rgba(25, 255, 255, 0.1)',
                  color: 'white',
                  '& .MuiAlert-icon': { color: 'white, ',}
              }}
              >
                {searchQuery || selectedCategory 
                  ? 'Ingen tips funnet for ditt søk. Prøv andre søkeord.'
                  : 'Ingen relevante tips funnet for din nåværende situasjon.'
              }
              </Alert>
            ) : (
              <Grid container spacing={2}>
                {tips.map((tip: PhotographyT, ipindex: number) => (
                  <Grid size={{ xs: 1, 2,}} sm={6} lg={4} key={tip.id || index}>
                    <Card
                      sx={{
                        background: 'rgba(25, 255, 255, 0.1)',
                        backdropFilter: 'blur(10px, ), ',
                        border: '1px solid rgba(25, 255, 255, 0.2)',
                        cursor: 'pointer',
                        transition: 'all 0.3s ease',
                        '&:hover': {
                          transform: 'translateY(-4px, ), ',
                          boxShadow: '0 8px 32px rgba, (00.3)',
                          background: 'rgba(25, 255, 255, 0.15)'
                      }
                    }}
                      onClick={() = sx={theming.getThemedCardSx()}> openTipDetails(tip)}
                    >
                      <CardContent sx={theming.getThemedCardSx()}>
                        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 1 }}>
                          <Chip
                            label={tip.category}
                            size="small"
                            sx={{
                              background: 'linear-gradient(135deg, #ff6b35 0%, #f7931e 100%)',
                              color: 'white',
                              fontWeight: 600
                        }}
                          />
                          <IconButton
                            size="small"
                            onClick={(e) => {
                              e.stopPropagation();
                              handleTipInteraction(tip.id!, 'bookmark');
                          }}
                            sx={{ color: 'white, ',}}
                          >
                            {bookmarkedTips.has(tip.id!) ? <BookmarkIcon /> : <BookmarkBorderIcon />}
                          </IconButton>
                        </Box>
                        <Typography variant="h6" sx={{ color: 'white', mb: ,  1fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
                          {tip.title}
                        </Typography>
                        <Typography
                          variant="body2"
                          sx={{
                            color: 'rgba(25, 255, 255, 0.8)',
                            mb: 2,
                            display: '-webkit-box',
                            WebkitLineClamp:  3,
                            WebkitBoxOrient: 'vertical',
                            overflow: 'hidden'
                      }}
                        >
                          {tip.content}
                        </Typography>
                        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center, ',}}>
                          <Chip
                            label={tip.conditions?.difficulty || 'beginner'}
                            size="small"
                            variant="outlined"
                            sx={{
                              borderColor: 'rgba(25, 255, 255, 0.5)',
                              color: 'white',
                              textTransform: 'capitalize'
                        }}
                          />
                          <Button
                            size="small"
                            endIcon={<LearnIcon />}
                            sx={{ color: '#ff6b35, ',}}
                          >
                            Les mer
                          </Button>
                        </Box>
                      </CardContent>
                    </Card>
                  </Grid>
                ))}
              </Grid>
            )}
          </Box>
        </DialogContent>
      </Dialog>

      {/* Tip Details Dialog */}
      {selectedTip && (
        <TipDetailsDialog
          tip={selectedTip}
          open={Boolean(selectedTip)}
          onClose={() => setSelectedTip(null)}
          onInteraction={handleTipInteraction}
          isBookmarked={bookmarkedTips.has(selectedTip.id!)}
        />
      )}
    </>
  );
};

// Tip Details Dialog Component
interface TipDetailsDialogProps {
  tip: PhotographyTip;
  open: boolean;
  onClose: () => void;
  onInteraction: (tipId: string, interactionType: string) => void;
  isBookmarked: boolean
}

const TipDetailsDialog: React.FC<TipDetailsDialogProps> = ({
  tip,
  open,
  onClose,
  onInteraction,
  isBookmarked
}) => {
  const [helpfulRating, setHelpfulRating] = useState<boolean | null>(null);

  return (
    <Dialog
      open={open}
      onClose={onClose}
      maxWidth="md"
      fullWidth
      PaperProps={{
        sx: {
          background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
          color: 'white'
    }
    }}
    >
      <DialogTitle
        sx={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          borderBottom: '1px solid rgba(25, 255, 255, 0.2)'
      }}
      >
        <Box>
          <Typography variant="h5" sx={{ fontWeight: 60, mb: 1 }} sx={{ ...{}, color: theming.colors.primary }}>
            {tip.title}
          </Typography>
          <Chip
            label={tip.category}
            sx={{
              background: 'linear-gradient(135deg, #ff6b35 0%, #f7931e 100%)',
              color: 'white'
        }}
          />
        </Box>
        <IconButton onClick={onClose} sx={{ color: 'white, ',}}>
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent sx={{ p:  3 }}>
        {/* Scenario */}
        <Box sx={{ mb: 3 }}>
          <Typography variant="h6" sx={{ mb: ,  1display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
            <MagicIcon />
            Scenario
          </Typography>
          <Typography variant="body1" sx={{ opacity: 0., 9,}}>
            {tip.scenario}
          </Typography>
        </Box>

        {/* Main Content */}
        <Box sx={{ mb: 3 }}>
          <Typography variant="body1" sx={{ lineHeight: 1., 7,}}>
            {tip.content}
          </Typography>
        </Box>

        {/* Camera Settings */}
        {tip.recommendedSettings && (
          <Accordion
            sx={{
              background: 'rgba(25, 255, 255, 0.1)',
              color: 'white',
              mb: 2,
              '&:before': { display: 'none, ',}
          }}
          >
            <AccordionSummary expandIcon={<ExpandMoreIcon sx={{ color: 'white, ',}} />}>
              <Typography variant="h6" sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                <SettingsIcon />
                Anbefalte kamerainnstillinger
              </Typography>
            </AccordionSummary>
            <AccordionDetails>
              <Grid container spacing={2}>
                {tip.recommendedSettings.aperture && (
                  <Grid size={{ xs: 1, 2,}} sm={6}>
                    <Typography variant="subtitle2" sx={{ fontWeight: 60, mb: 1 }}>
                      Blenderåpning
                    </Typography>
                    <Box sx={{ display: 'flex', flexWrap: 'wrap', gap:  1 }}>
                      {tip.recommendedSettings.aperture.map((setting, idx) => (
                        <Chip
                          key={idx}
                          label={setting}
                          size="small"
                          variant="outlined"
                          sx={{ borderColor: 'rgba(25, 255, 255, 0.5)', color: 'white, ',}}
                        />
                      ))}
                    </Box>
                  </Grid>
                )}
                {tip.recommendedSettings.shutterSpeed && (
                  <Grid size={{ xs: 1, 2,}} sm={6}>
                    <Typography variant="subtitle2" sx={{ fontWeight: 60, mb: 1 }}>
                      Lukkertid
                    </Typography>
                    <Box sx={{ display: 'flex', flexWrap: 'wrap', gap:  1 }}>
                      {tip.recommendedSettings.shutterSpeed.map((setting, idx) => (
                        <Chip
                          key={idx}
                          label={setting}
                          size="small"
                          variant="outlined"
                          sx={{ borderColor: 'rgba(25, 255, 255, 0.5)', color: 'white, ',}}
                        />
                      ))}
                    </Box>
                  </Grid>
                )}
                {tip.recommendedSettings.iso && (
                  <Grid size={{ xs: 1, 2,}} sm={6}>
                    <Typography variant="subtitle2" sx={{ fontWeight: 60, mb: 1 }}>
                      ISO
                    </Typography>
                    <Box sx={{ display: 'flex', flexWrap: 'wrap', gap:  1 }}>
                      {tip.recommendedSettings.iso.map((setting, idx) => (
                        <Chip
                          key={idx}
                          label={setting}
                          size="small"
                          variant="outlined"
                          sx={{ borderColor: 'rgba(25, 255, 255, 0.5)', color: 'white, ',}}
                        />
                      ))}
                    </Box>
                  </Grid>
                )}
              </Grid>
            </AccordionDetails>
          </Accordion>
        )}

        {/* Equipment */}
        {tip.recommendedEquipment && (
          <Accordion
            sx={{
              background: 'rgba(25, 255, 255, 0.1)',
              color: 'white',
              mb: 2,
              '&:before': { display: 'none, ',}
          }}
          >
            <AccordionSummary expandIcon={<ExpandMoreIcon sx={{ color: 'white, ',}} />}>
              <Typography variant="h6" sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                <CameraIcon />
                Anbefalt utstyr
              </Typography>
            </AccordionSummary>
            <AccordionDetails>
              <Grid container spacing={2}>
                {tip.recommendedEquipment.lenses && (
                  <Grid size={{ xs: 1, 2,}}>
                    <Typography variant="subtitle2" sx={{ fontWeight: 60, mb: 1 }}>
                      Objektiver
                    </Typography>
                    <List dense>
                      {tip.recommendedEquipment.lenses.map((lens, idx) => (
                        <ListItem key={idx} sx={{ py: 0 }}>
                          <ListItemText primary={lens} sx={{ color: 'white, ',}} />
                        </ListItem>
                      ))}
                    </List>
                  </Grid>
                )}
              </Grid>
            </AccordionDetails>
          </Accordion>
        )}
      </DialogContent>

      <DialogActions
        sx={{
          p:  3,
          borderTop: '1px solid rgba(25, 255, 255, 0.2)',
          justifyContent: 'space-between'
    }}
      >
        <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
          <Typography variant="body2">Var dette nyttig?</Typography>
          <IconButton
            onClick={() => {
              setHelpfulRating(true);
              onInteraction(tip.id!, 'helpful');
          }}
            sx={{ color: helpfulRating === true ? '#4caf50' : 'white, ',}}
          >
            <ThumbUpIcon />
          </IconButton>
          <IconButton
            onClick={() => {
              setHelpfulRating(false);
              onInteraction(tip.id!, 'not_helpful');
          }}
            sx={{ color: helpfulRating === false ? '#f44336' : 'white, ',}}
          >
            <ThumbDownIcon />
          </IconButton>
        </Box>
        <Box sx={{ display: 'flex', gap:  1 }}>
          <Button
            startIcon={isBookmarked ? <BookmarkIcon /> : <BookmarkBorderIcon />}
            onClick={() => onInteraction(tip.id!, 'bookmark')}
            sx={{ color: 'white, ',}}
          >
            {isBookmarked ? 'Fjern lagring' : 'Lagre tip'}
          </Button>
          <Button onClick={onClose} variant="contained" sx={{ ml:  1 }} sx={theming.getThemedButtonSx()}>
            Lukk
          </Button>
        </Box>
      </DialogActions>
    </Dialog>
  );
};