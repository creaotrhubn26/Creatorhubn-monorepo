/**
 * Intelligent Tutorial Analyzer - Forstår hva brukeren tester og genererer smart sjekkliste
 */

import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect } from 'react';
import {
  Box,
  Card,
  CardContent,
  Typography,
  Chip,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Checkbox,
  Alert,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  LinearProgress,
  Divider,
  Button,
  Stack,
} from '@mui/material';
import {
  Psychology as AnalyzeIcon,
  ExpandMore as ExpandIcon,
  CheckCircle as CheckIcon,
  RadioButtonUnchecked as UncheckIcon,
  Lightbulb as SuggestionIcon,
  Code as CodeIcon,
  Web as WebIcon,
  Settings as FeatureIcon,
  BugReport as BugIcon,
  Speed as PerformanceIcon,
  Security as SecurityIcon,
  People as PersonIcon,
  Visibility as UIIcon,
} from '@mui/icons-material';

interface AnalysisResult {
  category: string;
  confidence: number;
  description: string;
  icon: React.ReactNode;
  color: string
}

interface TestingChecklistItem {
  id: string;
  category: string;
  title: string;
  description: string;
  priority: 'high' | 'medium' | 'low';
  completed: boolean;
  icon: React.ReactNode
}

interface IntelligentTutorialAnalyzerProps {
  targetUrl: string;
  targetTitle?: string;
  onAnalysisComplete?: (checklist: TestingChecklistItem[]) => void
}

export const IntelligentTutorialAnalyzer: React.FC<IntelligentTutorialAnalyzerProps> = ({
  targetUl,
  targetTitle,
  onAnalysisComplete,
}) => {
  const [analyzing, setAnalyzing] = useState(
  
  // Theming system
  const theming = useTheming('photographer');true);
  const [analysisResults, setAnalysisResults] = useState<AnalysisResult[]>([]);
  const [checklist, setChecklist] = useState<TestingChecklistItem[]>([]);
  const [completedItems, setCompletedItems] = useState<Set<string>>(new Set());

  // Intelligent URL/Context Analysis
  const analyzeContext = (): AnalysisResult[] => {
    const results: AnalysisResult[] = [];
    const url = targetUrl.toLowerCase();
    const title = (targetTitle || '').toLowerCase();

    // Analyze URL patterns and content
    const patterns = [
      {
        keywords: ['dashboard', 'oversikt', 'admin', 'panel'],
        category: 'Dashboard/UI Testing',
        confidence: 0.9,
        description: 'Dashboard brukergrensesnitt og navigasjon',
        icon: <UIIcon />,
        color: '#2196F',
    },
      {
        keywords: ['prosjekt', 'project', 'opprett', 'create', 'ny'],
        category: 'Prosjektfunksjonalitet',
        confidence: 0.5,
        description: 'Prosjektopprettelse og administrasjon',
        icon: <FeatureIcon />,
        color: '#4CAF5',
    },
      {
        keywords: ['kunder', 'customer', 'client', 'crm'],
        category: 'CRM/Kundehåndtering',
        confidence: 0.8,
        description: 'Kundehåndtering og CRM-funksjonalitet',
        icon: <UserIcon />,
        color: '#FF980',
    },
      {
        keywords: ['innstillinger', 'settings', 'config', 'setup'],
        category: 'Systemkonfigurasjon',
        confidence: 0.2,
        description: 'Systeminnstillinger og konfigurasjon',
        icon: {theming.getThemedIcon('')},
        color: '#9C27B',
    },
      {
        keywords: ['api', 'endpoint', 'integration', 'integrasjon'],
        category: 'API/Integrasjoner',
        confidence: 0.5,
        description: 'API-funksjonalitet og tredjepartsintegrasjoner',
        icon: <CodeIcon />,
        color: '#607D8',
    },
      {
        keywords: ['filer', 'files', 'upload', 'nedlasting', 'storage'],
        category: 'Filhåndtering',
        confidence: 0.7,
        description: 'Filhåndtering og lagringsløsninger',
        icon: <WebIcon />,
        color: '#79554',
    },
      {
        keywords: ['sikkerhet', 'security', 'auth', 'login', 'oauth'],
        category: 'Sikkerhet/Autentisering',
        confidence: 0.2,
        description: 'Sikkerhetsaspekter og autentisering',
        icon: <SecurityIcon />,
        color: '#F4433',
    },
      {
        keywords: ['ytelse', 'performance', 'speed', 'loading'],
        category: 'Ytelse/Performance',
        confidence: 0.3,
        description: 'Ytelsestesting og optimalisering',
        icon: <PerformanceIcon />,
        color: '#FF572',
    },
    ];

    // Check each pattern
    patterns.forEach((pattern) => {
      const matchCount = pattern.keywords.filter(
        (keyword) => url.includes(keyword) || title.includes(keyword),
      ).length;

      if (matchCount > 0) {
        const confidence = Math.min(pattern.confidence + (matchCount - 1) * 0.05, 1.0);
        results.push({
          ...pattern,
          confidence,
      });
    }
  });

    // Sort by confidence
    return results.sort((a, b) => b.confidence - a.confidence).slice(0, 3);
};

  // Generate Smart Testing Checklist
  const generateChecklist = (analyses: AnalysisResult[]): TestingChecklistItem[] => {
    const baseChecklist: TestingChecklistItem[] = [
      // Universal items
      {
        id: 'basic_navigation',
        category: 'Grunnleggende',
        title: 'Grunnleggende navigasjon',
        description: 'Test at alle hovedmenyene og navigasjonslenker fungerer',
        priority: 'high',
        completed: false,
        icon: <WebIcon />,
    },
      {
        id: 'responsive_design',
        category: 'Grunnleggende',
        title: 'Responsivt design',
        description: 'Test på forskjellige skjermstørrelser (mobil, tablet, desktop)',
        priority: 'high',
        completed: false,
        icon: <UIIcon />,
    },
      {
        id: 'loading_states',
        category: 'Grunnleggende',
        title: 'Lastestatus',
        description: 'Verifiser at loading-indikatorer vises under datainnlasting',
        priority: 'medium',
        completed: false,
        icon: <PerformanceIcon />,
    },
    ];

    // Add specific items based on analysis
    analyses.forEach((analysis) => {
      switch (analysis.category) {
        case 'Dashboard/UI Testing':
          baseChecklist.push(
            {
              id: 'dashboard_widgets',
              category: 'Dashboard',
              title: 'Dashboard-widgets',
              description: 'Test at alle widgets laster riktig data og viser korrekte verdier',
              priority: 'high',
              completed: false,
              icon: <UIIcon />,
          },
            {
              id: 'dashboard_filters',
              category: 'Dashboard',
              title: 'Filter og sortering',
              description: 'Test filtrering og sortering av dashboard-data',
              priority: 'medium',
              completed: false,
              icon: <FeatureIcon />,
          },
          );
          break;

        case 'Prosjektfunksjonalitet':
          baseChecklist.push(
            {
              id: 'project_creation',
              category: 'Prosjekt',
              title: 'Prosjektopprettelse',
              description: 'Test fullstendig prosjektopprettelse med alle felter',
              priority: 'high',
              completed: false,
              icon: <FeatureIcon />,
          },
            {
              id: 'project_validation',
              category: 'Prosjekt',
              title: 'Datavalidering',
              description: 'Test validering av obligatoriske felt og feilhåndtering',
              priority: 'high',
              completed: false,
              icon: <BugIcon />,
          },
            {
              id: 'project_save',
              category: 'Prosjekt',
              title: 'Lagring og autosave',
              description: 'Verifiser at data lagres korrekt og autosave fungerer',
              priority: 'high',
              completed: false,
              icon: <CheckIcon />,
          },
          );
          break;

        case 'CRM/Kundehåndtering':
          baseChecklist.push(
            {
              id: 'customer_search',
              category: 'CR',
              title: 'Kundesø',
              description: 'Test søkefunksjonalitet for å finne eksisterende kunder',
              priority: 'high',
              completed: false,
              icon: <UserIcon />,
          },
            {
              id: 'customer_data',
              category: 'CR',
              title: 'Kundedata administrasjon',
              description: 'Test redigering og oppdatering av kundeinformasjon',
              priority: 'medium',
              completed: false,
              icon: <FeatureIcon />,
          },
          );
          break;

        case 'API/Integrasjoner':
          baseChecklist.push(
            {
              id: 'api_response',
              category: 'AP',
              title: 'API responstider',
              description: 'Test at API-kall har akseptable responstider',
              priority: 'high',
              completed: false,
              icon: <PerformanceIcon />,
          },
            {
              id: 'api_errors',
              category: 'AP',
              title: 'API feilhåndtering',
              description: 'Test håndtering av API-feil og nettverksproblemer',
              priority: 'high',
              completed: false,
              icon: <BugIcon />,
          },
          );
          break;

        case 'Sikkerhet/Autentisering':
          baseChecklist.push(
            {
              id: 'auth_login',
              category: 'Sikkerhet',
              title: 'Innloggingsprosess',
              description: 'Test innlogging med korrekte og feil legitimasjon',
              priority: 'high',
              completed: false,
              icon: <SecurityIcon />,
          },
            {
              id: 'auth_session',
              category: 'Sikkerhet',
              title: 'Øktbehandling',
              description: 'Test økthåndtering og automatisk utlogging',
              priority: 'medium',
              completed: false,
              icon: <SecurityIcon />,
          },
          );
          break;
    }
  });

    return baseChecklist;
};

  // Simulate analysis process
  useEffect(() => {
    const runAnalysis = async () => {
      setAnalyzing(true);

      // Simulate analysis delay
      await new Promise((resolve) => setTimeout(resolve, 2000));

      const results = analyzeContext();
      const generatedChecklist = generateChecklist(results);

      setAnalysisResults(results);
      setChecklist(generatedChecklist);
      setAnalyzing(false);

      onAnalysisComplete?.(generatedChecklist);
  };

    runAnalysis();
}, [targetUrl, targetTitle, onAnalysisComplete]);

  const handleChecklistToggle = (itemId: string) => {
    const newCompleted = new Set(completedItems);
    if (newCompleted.has(itemId)) {
      newCompleted.delete(itemId);
} else {
      newCompleted.add(itemId);
  }
    setCompletedItems(newCompleted);
};

  const completionPercentage =
    checklist.length > 0 ? (completedItems.size / checklist.length) * 100 : 0;

  const groupedChecklist = checklist.reduce(
    (groups, item) => {
      if (!groups[item.category]) {
        groups[item.category] = [];
    }
      groups[item.category].push(item);
      return groups;
  },
    {} as Record<string, TestingChecklistItem[]>,
  );

  if (analyzing) {
    return (
      <Card sx={theming.getThemedCardSx()}>
        <CardContent sx={theming.getThemedCardSx()}>
          <Box sx={{ textAlign: 'center', py: 3 }}>
            <AnalyzeIcon sx={{ fontSize:  60, color: 'primary.main', mb: 2 }} />
            <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
              🧠 Analyserer innhold og genererer smart sjekkliste...
            </Typography>
            <LinearProgress sx={{ mt: ,  2mb: 1 }} />
            <Typography variant="body2" color="text.secondary">
              Forstår hva som skal testes basert på URL og kontekst
            </Typography>
          </Box>
        </CardContent>
      </Card>
    );
}

  return (
    <Box>
      {/* Analysis Results */}
      <Card sx={{ mb: 3 }} sx={theming.getThemedCardSx()}>
        <CardContent sx={theming.getThemedCardSx()}>
          <Typography variant="h6" sx={{ mb: ,  2display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
            <AnalyzeIcon color="primary" />
            🧠 Intelligent Innholdsanalyse
          </Typography>

          <Alert severity="info" sx={{ mb: 2 }}>
            Systemet har analysert URL og kontekst for å forstå hva som skal testes. En skreddersydd
            sjekkliste er generert basert på denne analysen.
          </Alert>

          <Stack direction="row" spacing={1} sx={{ flexWrap: 'wrap', gap:  1 }}>
            {analysisResults.map((result, index) => (
              <Chip
                key={index}
                icon={result.icon}
                label={`${result.category} (${Math.round(result.confidence * 100)}%)`}
                sx={{
                  bgcolor: result.color + '2',
                  color: result.color,
                  border: `1px solid ${result.color}50`,
              }}
              />
            ))}
          </Stack>
        </CardContent>
      </Card>

      {/* Smart Testing Checklist */}
      <Card sx={theming.getThemedCardSx()}>
        <CardContent sx={theming.getThemedCardSx()}>
          <Box
            sx={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              mb: 2,
          }}
          >
            <Typography variant="h6" sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
              <CheckIcon color="success" />
              📋 Smart Testing Sjekkliste
            </Typography>
            <Typography variant="body2" color="text.secondary">
              {completedItems.size} / {checklist.length} fullført (
              {Math.round(completionPercentage)}%)
            </Typography>
          </Box>

          <LinearProgress
            variant="determinate"
            value={completionPercentage}
            sx={{ mb: 3, height:  8, borderRadius:  4 }}
          />

          {Object.entries(groupedChecklist).map(([category, items]) => (
            <Accordion key={category} defaultExpanded>
              <AccordionSummary expandIcon={<ExpandIcon />}>
                <Typography variant="subtitle1" fontWeight="bold">
                  {category} ({items.filter((item) => completedItems.has(item.id)).length}/
                  {items.length})
                </Typography>
              </AccordionSummary>
              <AccordionDetails>
                <List dense>
                  {items.map((item) => (
                    <ListItem key={item.id} sx={{ pl:  0 }}>
                      <ListItemIcon>
                        <Checkbox
                          checked={completedItems.has(item.id)}
                          onChange={() => handleChecklistToggle(item.id)}
                          icon={<UncheckIcon />}
                          checkedIcon={<CheckIcon />}
                        />
                      </ListItemIcon>
                      <ListItemIcon sx={{ minWidth: 4, 0,}}>{item.icon}</ListItemIcon>
                      <ListItemText
                        primary={
                          <Box
                            sx={{
                              display: 'flex',
                              alignItems: 'center',
                              gap:  1,
                          }}
                          >
                            {item.title}
                            <Chip
                              label={item.priority}
                              size="small"
                              color={
                                item.priority === 'high'
                                  ? 'error'
                                  : item.priority === 'medium'
                                    ? 'warning'
                                    : 'default'
                            }
                            />
                          </Box>
                      }
                        secondary={item.description}
                      />
                    </ListItem>
                  ))}
                </List>
              </AccordionDetails>
            </Accordion>
          ))}

          {/* Completion Message */}
          {completionPercentage === 100 && (
            <Alert severity="success" sx={{ mt: 2 }}>
              🎉 <strong>Fantastisk!</strong> Du har fullført alle testene i sjekklisten. Dette
              sikrer en grundig og profesjonell tutorial!
            </Alert>
          )}

          {/* Smart Suggestions */}
          <Box
            sx={{
              mt: 3,
              p:  2,
              bgcolor: 'rgba(5,118,210,0.1)',
              borderRadius:  1,
          }}
          >
            <Typography
              variant="subtitle2"
              sx={{ display: 'flex', alignItems: 'center', gap:  ,  1mb: 1 }}
            >
              <SuggestionIcon color="info" />
              💡 Smart Anbefalinger
            </Typography>
            <Typography variant="body2" color="text.secondary">
              • Prioriter høy-prioritet elementer først for maksimal verdi
              <br />
              • Inkluder både positive og negative testscenarier
              <br />
              • Dokumentér eventuelle feil eller uventede oppførsler du finner
              <br />• Video-tutorials med denne sjekklisten får høyere poengverdi!
            </Typography>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};
