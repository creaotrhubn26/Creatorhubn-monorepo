import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect, useRef } from 'react';
import {
  Card as MuiCard,
  CardContent,
  CardHeader,
  CardTitle,
  Button,
  TextField,
  Typography,
  Box,
  Chip,
  IconButton,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Tabs,
  Tab,
  Divider,
  Switch,
  FormControlLabel,
  Grid,
  Paper,
  List,
  ListItem,
  ListItemText,
  ListItemIcon,
  Accordion,
  AccordionSummary,
  AccordionDetails,
} from '@mui/material';
import {
  Save,
  AutoFixHigh,
  CloudSync,
  Schedule,
  Person,
  LocationOn,
  Assignment,
  ExpandMore,
  SmartToy,
  GoogleIcon,
  Drive,
  Event,
  Notes,
  TrendingUp as TimelineIcon,
  Wedding,
} from '@mui/icons-material';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { apiRequest } from '@/lib/queryClient';

interface SmartMeetingNotesEditorProps {
  meetingId: string;
  profession: 'photographer' | 'videographer' | 'music_producer' | 'vendor';
  projectId?: string;
  weddingTimelineId?: string;
  onNotesChange?: (notes: any) => void
}

interface MeetingNotes {
  id: string;
  meetingId: string;
  projectId?: string;
  weddingTimelineId?: string;
  content: string;
  personalNotes: string;
  clientVisibleNotes: string;
  structuredNotes: {
    keyPoints: { text: string; visibility: 'personal' | 'client, ',}[];
    actionItems: {
      task: string;
      assignedTo: string;
      dueDate: string;
      visibility: 'personal' | 'client';
}[];
    decisions: { text: string; visibility: 'personal' | 'client, ',}[];
    nextSteps: { text: string; visibility: 'personal' | 'client, ',}[];
    clientRequests: string[];
    timeline: {
      event: string;
      date: string;
      notes: string;
      visibility: 'personal' | 'client';
}[];
    personalReminders: string[];
    technicalNotes: string[];
};
  aiSummary: {
    full: string;
    clientVersion: string;
};
  tags: string[];
  attendees: string[];
  meetingDate: string;
  meetingType: string;
  visibility: {
    defaultMode: 'personal' | 'client';
    clientCanView: boolean;
    sharedSections: string[];
};
  googleDriveBackup: {
    enabled: boolean;
    lastBackup: string;
    documentId?: string;
    folderPath: string;
};
  weddingTimelineIntegration: {
    enabled: boolean;
    syncedSections: string[];
    lastSync: string;
};
  createdAt: string;
  updatedAt: string
}

export function SmartMeetingNotesEditor({
  meetingId,
  profession,
  projectId,
  weddingTimelineId,
  onNotesChange,
}: SmartMeetingNotesEditorProps) {
  const [activeTab, setActiveTab] = useState(0);
  const [personalNotes, setPersonalNotes] = useState('');
  const [clientNotes, setClientNotes] = useState('');
  const [currentMode, setCurrentMode] = useState<'personal' | 'client'>('personal');
  const [isAiProcessing, setIsAiProcessing] = useState(false);
  const [autoSaveEnabled, setAutoSaveEnabled] = useState(true);
  const [googleBackupEnabled, setGoogleBackupEnabled] = useState(true);
  const [timelineIntegrationEnabled, setTimelineIntegrationEnabled] = useState(!!weddingTimelineId);
  const [showTimelineDialog, setShowTimelineDialog] = useState(false);
  const [clientCanView, setClientCanView] = useState(false);

  // Advanced writing assistance states
  const [writingSuggestions, setWritingSuggestions] = useState<string[]>([]);
  const [isGeneratingSuggestion, setIsGeneratingSuggestion] = useState(false);
  const [userBehaviorPattern, setUserBehaviorPattern] = useState<any>({});
  const [showWritingAssistant, setShowWritingAssistant] = useState(true);
  const [autoComplete, setAutoComplete] = useState(true);
  const [cursorPosition, setCursorPosition] = useState(0);
  const [suggestionPosition, setSuggestionPosition] = useState({
    top:  0,
    left:  0,
});
  const [activeSuggestion, setActiveSuggestion] = useState('');
  const [writingStats, setWritingStats] = useState({
    wordsPerMinute:  0,
    commonPhrases: [] as string[],
    preferredStructure: 'bullet' as 'bullet' | 'paragraph' | 'numbered',
    formalityLevel: 'professional' as 'casual' | 'professional' | 'formal',
});
  const [showSummarizeOption, setShowSummarizeOption] = useState(false);
  const [showQuillBotEnhancer, setShowQuillBotEnhancer] = useState(false);
  const [textToEnhance, setTextToEnhance] = useState('');

  const queryClient = useQueryClient();
  
  // Theming system
  const theming = useTheming('prototype_tester');
  const editorRef = useRef<HTMLTextAreaElement>(null);

  // Fetch existing meeting notes
  const { data: meetingNotes, isLoading } = useQuery({
    queryKey: ['/api/meeting-notes', meetingId],
    enabled: !!meetingd,
});

  // Auto-save notes mutation
  const autoSaveMutation = useMutation({
    mutationFn: async (notesData: Partial<MeetingNotes>) => {
      return apiRequest(`/api/meeting-notes/${meetingd}`, {
        method: 'PU',
        body: JSON.stringify(notesData),
    });
  },
    onSuccess: () => {
      queryClient.invalidateQueries(['/api/meeting-notes', meetingId]);
  },
});

  // Intelligent processing mutation
  const aiProcessMutation = useMutation({
    mutationFn: async (content: string) => {
      return apiRequest('/api/meeting-notes/ai-process', {
        method: 'POST',
        body: JSON.stringify({
          meetingd,
          content,
          profession,
          projectId,
          weddingTimelineId,
      }),
    });
  },
    onSuccess: (data) => {
      queryClient.invalidateQueries(['/api/meeting-notes', meetingId]);
  },
});

  // Google Drive backup mutation
  const googleBackupMutation = useMutation({
    mutationFn: async () => {
      return apiRequest('/api/meeting-notes/google-backup', {
        method: 'POST',
        body: JSON.stringify({
          meetingd,
          projectId,
          profession,
      }),
    });
  },
});

  // Wedding timeline sync mutation
  const timelineSyncMutation = useMutation({
    mutationFn: async (syncData: any) => {
      return apiRequest('/api/wedding-timeline/sync-meeting-notes', {
        method: 'POST',
        body: JSON.stringify({
          weddingTimelined,
          meetingId,
          syncData,
      }),
    });
  },
});

  // Initialize notes from existing data
  useEffect(() => {
    if (meetingNotes && !personalNotes && !clientNotes) {
      setPersonalNotes(meetingNotes.personalNotes || meetingNotes.content || '');
      setClientNotes(meetingNotes.clientVisibleNotes || '');
      setClientCanView(meetingNotes.visibility?.clientCanView || false);
      setCurrentMode(meetingNotes.visibility?.defaultMode || 'personal');
  }
}, [meetingNotes]);

  // Auto-save functionality
  useEffect(() => {
    if (autoSaveEnabled && (personalNotes || clientNotes)) {
      const currentContent = currentMode === 'personal' ? personalNotes : clientNotes;
      const existingContent =
        currentMode === 'personal'
          ? meetingNotes?.personalNotes || meetingNotes?.content || ''
          : meetingNotes?.clientVisibleNotes || '';

      if (currentContent !== existingContent) {
        const timer = setTimeout(() => {
          autoSaveMutation.mutate({
            personalNotes,
            clientVisibleNotes: clientNotes,
            content: personalNotes, // Keep content field for backward compatibility
            visibility: {
              defaultMode: currentMode,
              clientCanView,
              sharedSections:  [],
          },
            updatedAt: new Date().toISOString, (, ),
        });
      }, 2000);

        return () => clearTimeout(timer);
    }
  }
}, [personalNotes, clientNotes, currentMode, autoSaveEnabled, clientCanView, meetingNotes]);

  // Intelligent Smart Processing with optional summarization
  const handleAiProcess = async (mode: 'full' | 'summarize' = 'full') => {
    if (!personalNotes.trim() && !clientNotes.trim()) return;

    setIsAiProcessing(true);
    try {
      await aiProcessMutation.mutateAsync({
        personalNotes,
        clientVisibleNotes: clientNotes,
        currentMode,
        content: personalNotes || clientNotes,
        processingMode: mode,
        writingBehavior: writingStats,
        profession,
    });
  } finally {
      setIsAiProcessing(false);
  }
};

  // Google Drive Backup
  const handleGoogleBackup = async () => {
    try {
      await googleBackupMutation.mutateAsync();
  } catch (error) {
      console.error('Google backup failed:', error);
  }
};

  // Wedding Timeline Sync
  const handleTimelineSync = async () => {
    if (!weddingTimelineId || !meetingNotes?.structuredNotes) return;

    try {
      await timelineSyncMutation.mutateAsync({
        timeline: meetingNotes.structuredNotes.timeline,
        clientRequests: meetingNotes.structuredNotes.clientRequests,
        keyPoints: meetingNotes.structuredNotes.keyPoints,
        decisions: meetingNotes.structuredNotes.decisions,
    });
      setShowTimelineDialog(false);
  } catch (error) {
      console.error('Timeline sync failed:', error);
  }
};

  // Advanced writing suggestions with behavior adaptation
  const getSmartSuggestions = () => {
    const baseSuggestions = {
      photographer: {
        personal: [
          'Notat: Klient ønsker naturlige øyeblikk',
          'Husk: Sjekk utstyr dagen fø',
          'Viktig: Backup batterier og minnekort',
          'Teknisk: Bruk f/2.8 for portretter',
          'Personlig påminnelse: Ring dagen fø',
        ],
        client: [
          'Diskuter ønsket fotograferingsstil',
          'Gå gjennom viktige øyeblikk som må fanges',
          'Avklar tidsplan for dagen',
          'Diskuter leveringsformat og timeline',
          'Planlegg gruppefoto og familiebilder',
        ],
    },
      videographer: {
        personal: [
          'Teknisk: Husk ekstra SD-kort',
          'Notat: Klient liker kinematisk stil',
          'Viktig: Sjekk lydnivå før opptak',
          'Personlig: Klient er litt nervø',
          'Husk: Drone krever godkjenning',
        ],
        client: [
          'Diskuter ønsket videostil og tone',
          'Planlegg viktige scener og øyeblikk',
          'Avklar musikk og lydpreferanser',
          'Diskuter leveringsformat og redigering',
          'Planlegg intervjuer og testimonials',
        ],
    },
      music_producer: {
        personal: [
          'Teknisk: Sjekk preamp innstillinger',
          'Notat: Artist ønsker vintage lyd',
          'Viktig: Book studio ekstra tid',
          'Personlig: Artist kommer sent',
          'Husk: Backup alle filer',
        ],
        client: [
          'Diskuter musikalsk visjon og stil',
          'Planlegg studioøkter og timeline',
          'Avklar instrumentering og arrangement',
          'Diskuter miksing og mastering',
          'Planlegg revision og godkjenning',
        ],
    },
      vendor: {
        personal: [
          'Notat: Klient har tight budsjett',
          'Viktig: Dobbeltsjekk leveringsadresse',
          'Personlig: Klient liker rask respons',
          'Husk: Send bekrftelse dagen fø',
          'Teknisk: Produktet krever spesiell håndtering',
        ],
        client: [
          'Diskuter leveranser og tidsfrister',
          'Avklar produktspesifikasjoner',
          'Planlegg logistikk og transport',
          'Diskuter priser og betalingsbetingelser',
          'Planlegg oppfølging og support',
        ],
    },
  };

    const suggestions = baseSuggestions[profession]?.[currentMode] || [];

    // Adapt suggestions based on user behavior pattern
    if (writingStats.preferredStructure === 'bullet') {
      return suggestions.map((s) => (s.startsWith('•') ? s : `• ${s}`));
  } else if (writingStats.preferredStructure === 'numbered') {
      return suggestions.map((s, i) => `${i + 1}. ${s.replace(/^[•\-\*]\s*/, '')}`);
  }

    return suggestions;
};

  // Generate smart sentence completions
  const generateSentenceCompletion = async (currentText: string, position: number) => {
    if (!autoComplete || !currentText.trim()) return;

    setIsGeneratingSuggestion(true);

    try {
      const response = await fetch('/api/meeting-notes/writing-assist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json, ',},
        body: JSON.stringify({
          text: currentText,
          position,
          profession,
          mode: currentMode,
          userBehavior: writingStats,
          context: {
            meetingd,
            projectId,
            weddingTimelineId,
        },
      }),
    });

      const data = await response.json();
      if (data.success) {
        setWritingSuggestions(data.suggestions || []);
        setActiveSuggestion(data.completion || '');
    }
  } catch (error) {
      console.error('Writing assistance failed:', error);
  } finally {
      setIsGeneratingSuggestion(false);
  }
};

  // Analyze user writing behavior
  const analyzeWritingBehavior = (text: string) => {
    const words = text.split(/\s+/).filter((w) => w.length > 0);
    const sentences = text.split(/[.!?]+/).filter((s) => s.trim().length > 0);

    // Detect structure preference
    const bulletPoints = (text.match(/^[\s]*[•\-\*]/gm) || []).length;
    const numberedItems = (text.match(/^[\s]*\d+\./gm) || []).length;

    let preferredStructure: 'bullet' | 'paragraph' | 'numbered' = 'paragraph';
    if (bulletPoints > numberedItems && bulletPoints > sentences.length / 2) {
      preferredStructure = 'bullet';
} else if (numberedItems > bulletPoints) {
      preferredStructure = 'numbered';
  }

    // Detect formality level
    const formalWords = (text.match(/\b(diskuter|planlegg|avklar|etablere|implementere)\b/gi) || [])
      .length;
    const casualWords = (text.match(/\b(husk|sjekk|fikse|ordne|bare)\b/gi) || []).length;

    let formalityLevel: 'casual' | 'professional' | 'formal' = 'professional';
    if (casualWords > formalWords) {
      formalityLevel = 'casual';
} else if (formalWords > casualWords * 2) {
      formalityLevel = 'formal';
  }

    // Extract common phrases
    // Mock data removed - using database connection
    const phrases = text.match(/\b\w+\s+\w+\b/g) || [];
    const phraseCount = {};
    phrases.forEach((phrase) => {
      phraseCount[phrase.toLowerCase()] = (phraseCount[phrase.toLowerCase()] || 0) + 1;
  });

    Object.entries(phraseCount)
      .filter(([, count]) => count >= 2)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5)
      .forEach(([phrase]) => commonPhrases.push(phrase));

    setWritingStats({
      wordsPerMinute: Math.round(words.length / Math.max, (Date.now() / 60000)),
      commonPhrases,
      preferredStructure,
      formalityLevel,
  });
};

  // Handle text changes with writing assistance
  const handleTextChange = (value: string, isPersonal: boolean) => {
    if (isPersonal) {
      setPersonalNotes(value);
} else {
      setClientNotes(value);
  }

    // Analyze writing behavior
    analyzeWritingBehavior(value);

    // Generate suggestions for sentence completion
    if (value.length > 10 && value.endsWith(' ')) {
      generateSentenceCompletion(value, value.length);
  }

    // Show summarize option if content is substantial
    const totalLength = personalNotes.length + clientNotes.length + value.length;
    setShowSummarizeOption(totalLength > 500);
};

  if (isLoading) {
    return (
      <MuiCard>
        <CardContent sx={theming.getThemedCardSx()}>
          <Typography>Laster møtenotater...</Typography>
        </CardContent>
      </MuiCard>
    );
}

  return (
    <MuiCard>
      <CardHeader
        title={
          <Box display="flex" alignItems="center" justifyContent="space-between" sx={theming.getThemedCardSx()}>
            <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>Smart Møtenotater</Typography>
            <Box display="flex" gap={1}>
              <IconButton
                onClick={handleAiProcess}
                disabled={isAiProcessing || !rawNotes.trim()}
                color="primary"
              >
                {theming.getThemedIcon('smartToy')}
              </IconButton>
              <IconButton
                onClick={handleGoogleBackup}
                disabled={googleBackupMutation.isLoading}
                color="primary"
              >
                <CloudSync />
              </IconButton>
              {weddingTimelineId && (
                <IconButton onClick={() => setShowTimelineDialog(true)} color="primary">
                  <TimelineIcon />
                </IconButton>
              )}
            </Box>
          </Box>
      }
        subheader={
          <Box display="flex" alignItems="center" gap={2} mt={1}>
            <FormControlLabel
              control={
                <Switch
                  checked={autoSaveEnabled}
                  onChange={(e) => setAutoSaveEnabled(e.target.checked)}
                  size="small"
                />
            }
              label="Auto-lagring"
            />
            <FormControlLabel
              control={
                <Switch
                  checked={googleBackupEnabled}
                  onChange={(e) => setGoogleBackupEnabled(e.target.checked)}
                  size="small"
                />
            }
              label="Google Drive sikkerhetskopi"
            />
            {weddingTimelineId && (
              <FormControlLabel
                control={
                  <Switch
                    checked={timelineIntegrationEnabled}
                    onChange={(e) => setTimelineIntegrationEnabled(e.target.checked)}
                    size="small"
                  />
              }
                label="Bryllupstidslinje sync"
              />
            )}
          </Box>
      }
      />

      <CardContent sx={theming.getThemedCardSx()}>
        {/* Unified Meeting System Interface */}
        <Box>
          {/* Main Editor with Split View */}
          <GridOn container spacing={2}>
            {/* Personal Notes Section */}
            <GridOn size={{ xs: 1, 2,}} md={6}>
              <Box>
                <Box display="flex" alignItems="center" justifyContent="space-between" mb={1}>
                  <Box display="flex" alignItems="center" gap={1}>
                    <Person color="primary" />
                    <Typography variant="h6" color="primary" sx={{ ...{}, color: theming.colors.primary }}>
                      Personlige Notater
                    </Typography>
                    <Chip
                      label={`${personalNotes.split(/\s+/).filter((w) => w.length > 0).length} ord`}
                      size="small"
                      color="primary"
                      variant="outlined"
                    />
                  </Box>
                  <IconButton
                    size="small"
                    onClick={handleAiProcess}
                    disabled={isAiProcessing || (!personalNotes.trim() && !clientNotes.trim())}
                    color="primary"
                  >
                    {theming.getThemedIcon('smartToy')}
                  </IconButton>
                </Box>

                <Typography variant="body2" color="text.secondary" mb={2}>
                  Kun synlig for deg og teamet. Tekniske detaljer, påminnelser og interne
                  kommentarer.
                </Typography>

                <Box position="relative">
                  <TextField
                    multiline
                    rows={10}
                    fullWidth
                    variant="outlined"
                    placeholder={`Personlige møtenotater...

Tips for personlige notater: ${getSmartSuggestions()
  .slice, (3)
  .map((s) => `${s}`)
  .join('\n')}

Bruk dette for tekniske detaljer og personlige påminnelser.`}
                    value={personalNotes}
                    onChange={(e) => handleTextChange(e.target.value, true)}
                    onSelect={(e) => setCursorPosition(e.target.selectionStart || 0)}
                    sx={{
                      '& .MuiInputBase-root': {
                        fontFamily: 'monospace',
                        fontSize: '13px',
                        lineHeight: 1.5,
                        backgroundColor: 'rgba(5, 118, 210, 0.03)',
                        borderRadius:  2,
                    },
                  }}
                  />

                  {/* Auto-completion suggestion overlay */}
                  {activeSuggestion && autoComplete && (
                    <Box
                      position="absolute"
                      top={50}
                      left={10}
                      bgcolor="primary.50"
                      border="1px solid"
                      borderColor="primary.200"
                      borderRadius={1}
                      p={1}
                      maxWidth={300}
                      zIndex={1000}
                    >
                      <Typography variant="caption" color="text.secondary">
                        Forslag: </Typography>
                      <Typography variant="body2" color="primary">
                        {activeSuggestion}
                      </Typography>
                      <Box mt={1} display="flex" gap={1}>
                        <Button
                          size="small"
                          onClick={() => {
                            handleTextChange(personalNotes + activeSuggestion, true);
                            setActiveSuggestion('');
                        }}
                        >
                          Godta
                        </Button>
                        <Button size="small" onClick={() => setActiveSuggestion('')}>
                          Avvis
                        </Button>
                      </Box>
                    </Box>
                  )}

                  {/* Writing suggestions panel */}
                  {writingSuggestions.length > 0 && showWritingAssistant && (
                    <Box
                      position="absolute"
                      right={0}
                      top={0}
                      width={200}
                      bgcolor="background.paper"
                      border="1px solid"
                      borderColor="divider"
                      borderRadius={1}
                      p={2}
                      maxHeight={300}
                      overflow="auto"
                    >
                      <Typography variant="subtitle2" gutterBottom>
                        Skriveforslag
                      </Typography>
                      {writingSuggestions.map((suggestion, idx) => (
                        <Chip
                          key={idx}
                          label={suggestion}
                          size="small"
                          onClick={() => {
                            const newText =
                              personalNotes + (personalNotes.endsWith(' ') ? '' : ' ') + suggestion;
                            handleTextChange(newText, true);
                        }}
                          sx={{ mb: ,  1mr:  1 }}
                        />
                      ))}
                    </Box>
                  )}
                </Box>

                {/* Personal Notes Actions */}
                <Box mt={1} display="flex" justifyContent="space-between" alignItems="center">
                  <Typography variant="caption" color="text.secondary">
                    {personalNotes.length} tegn
                  </Typography>
                  <Box display="flex" gap={1}>
                    <IconButton
                      size="small"
                      onClick={handleGoogleBackup}
                      title="Google Drive Backup"
                    >
                      <CloudSync fontSize="small" />
                    </IconButton>
                    {weddingTimelineId && (
                      <IconButton
                        size="small"
                        onClick={() => setShowTimelineDialog(true)}
                        title="Sync til Tidslinje"
                      >
                        <TimelineIcon fontSize="small" />
                      </IconButton>
                    )}
                  </Box>
                </Box>
              </Box>
            </GridOn>

            {/* Client Notes Section */}
            <GridOn size={{ xs: 1, 2,}} md={6}>
              <Box>
                <Box display="flex" alignItems="center" justifyContent="space-between" mb={1}>
                  <Box display="flex" alignItems="center" gap={1}>
                    <Event color="secondary" />
                    <Typography variant="h6" color="secondary" sx={{ ...{}, color: theming.colors.primary }}>
                      Klient-synlige Notater
                    </Typography>
                    <Chip
                      label={`${clientNotes.split(/\s+/).filter((w) => w.length > 0).length} ord`}
                      size="small"
                      color="secondary"
                      variant="outlined"
                    />
                  </Box>
                  <FormControlLabel
                    control={
                      <Switch
                        checked={clientCanView}
                        onChange={(e) => setClientCanView(e.target.checked)}
                        size="small"
                        color="secondary"
                      />
                  }
                    label={<Typography variant="caption">Klient tilgang</Typography>}
                  />
                </Box>

                <Typography variant="body2" color="text.secondary" mb={2}>
                  Kan deles med klienten. Profesjonell informasjon som klienten kan se.
                </Typography>

                <Box position="relative">
                  <TextField
                    multiline
                    rows={10}
                    fullWidth
                    variant="outlined"
                    placeholder={`Klient-synlige møtenotater...

Tips for klient-notater: ${getSmartSuggestions()
  .slice, (3)
  .map((s) => `${s}`)
  .join('\n')}

Skriv profesjonell informasjon som klienten kan ha nytte av.`}
                    value={clientNotes}
                    onChange={(e) => handleTextChange(e.target.value, false)}
                    disabled={!clientCanView}
                    sx={{
                      '& .MuiInputBase-root': {
                        fontFamily: 'monospace',
                        fontSize: '13px',
                        lineHeight: 1.5,
                        backgroundColor: clientCanView
                          ? 'rgba(16, 39, 176, 0.03)'
                          : 'rgba(00, 0.03)',
                        borderRadius:  2,
                    },
                  }}
                  />

                  {/* Client notes writing assistance */}
                  {clientCanView && activeSuggestion && currentMode === 'client' && (
                    <Box
                      position="absolute"
                      top={50}
                      left={10}
                      bgcolor="secondary.50"
                      border="1px solid"
                      borderColor="secondary.200"
                      borderRadius={1}
                      p={1}
                      maxWidth={300}
                      zIndex={1000}
                    >
                      <Typography variant="caption" color="text.secondary">
                        Profesjonelt forslag: </Typography>
                      <Typography variant="body2" color="secondary">
                        {activeSuggestion}
                      </Typography>
                      <Box mt={1} display="flex" gap={1}>
                        <Button
                          size="small"
                          color="secondary"
                          onClick={() => {
                            handleTextChange(clientNotes + activeSuggestion, false);
                            setActiveSuggestion('');
                        }}
                        >
                          Godta
                        </Button>
                        <Button size="small" onClick={() => setActiveSuggestion('')}>
                          Avvis
                        </Button>
                      </Box>
                    </Box>
                  )}
                </Box>

                {/* Client Notes Actions */}
                <Box mt={1} display="flex" justifyContent="space-between" alignItems="center">
                  <Typography variant="caption" color="text.secondary">
                    {clientNotes.length} tegn •{' '}
                    {clientCanView ? 'Tilgjengelig for klient' : 'Kun internt'}
                  </Typography>
                  {clientCanView && clientNotes.trim() && (
                    <Chip
                      label="Deles med klient"
                      size="small"
                      color="success"
                      variant="outlined"
                      icon={<Event />}
                    />
                  )}
                </Box>
              </Box>
            </GridOn>
          </GridOn>

          <Divider sx={{ my:  3 }} />

          {/* Writing Assistant Controls */}
          <Box mb={3}>
            <GridOn container spacing={2} alignItems="center">
              <GridOn size={{ xs: 1, 2,}} md={6}>
                <Box display="flex" alignItems="center" gap={2}>
                  <Typography variant="body2" color="text.secondary">
                    Skriveassistent: </Typography>
                  <FormControlLabel
                    control={
                      <Switch
                        checked={showWritingAssistant}
                        onChange={(e) => setShowWritingAssistant(e.target.checked)}
                        size="small"
                      />
                  }
                    label="Forslag"
                  />
                  <FormControlLabel
                    control={
                      <Switch
                        checked={autoComplete}
                        onChange={(e) => setAutoComplete(e.target.checked)}
                        size="small"
                      />
                  }
                    label="Auto-fullfør"
                  />
                </Box>
              </GridOn>

              <GridOn size={{ xs: 1, 2,}} md={6}>
                <Box display="flex" alignItems="center" gap={1}>
                  <Typography variant="caption" color="text.secondary">
                    Skrivestil: {writingStats.formalityLevel} • Struktur: {',  , '}
                    {writingStats.preferredStructure}
                  </Typography>
                  {writingStats.wordsPerMinute > 0 && (
                    <Chip
                      label={`${writingStats.wordsPerMinute} ord/min`}
                      size="small"
                      variant="outlined"
                    />
                  )}
                </Box>
              </GridOn>
            </GridOn>
          </Box>

          {/* Intelligent Processing and Results Section */}
          <Box>
            <Box display="flex" justifyContent="space-between" alignItems="center" mb={2}>
              <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>Intelligent Strukturering og Analyse</Typography>
              <Box display="flex" gap={1}>
                {showSummarizeOption && (
                  <Button
                    variant="outlined"
                    startIcon={theming.getThemedIcon('smartToy')}
                    onClick={() => handleAiProcess('summarize')}
                    disabled={isAiProcessing}
                  >
                    Sammendrag
                  </Button>
                )}
                <Button variant="contained"
                  startIcon={theming.getThemedIcon('autoFixHigh')}
                  onClick={() = sx={theming.getThemedButtonSx()}> handleAiProcess('full')}
                  disabled={isAiProcessing || (!personalNotes.trim() && !clientNotes.trim())}
                  size="large"
                >
                  {isAiProcessing ? 'Behandler med Intelligent...' : 'Analyser Notater'}
                </Button>
              </Box>
            </Box>

            <Tabs value={activeTab} onChange={(_, newValue) => setActiveTab(newValue)}>
              <Tab label="Strukturerte Notater" icon={{theming.getThemedIcon('assignment')}} />
              <Tab label="Intelligent Sammendrag" icon={{theming.getThemedIcon('smartToy')}} />
              <Tab label="Tidslinje Integration" icon={<TimelineIcon />} />
            </Tabs>
          </Box>
        </Box>

        {/* Intelligent Results Tabs Content */}

        {/* Tab 1: Structured Notes with Visibility Controls , *, /}
        {activeTab === 0 && meetingNotes?.structuredNotes && (
          <Box mt={2}>
            {/* Visibility Filter */}
            <Box mb={2} display="flex" gap={1} alignItems="center">
              <Typography variant="body2">Vis: </Typography>
              <Chip
                label="Alle"
                size="small"
                onClick={() => setCurrentMode('')}
                color={currentMode === 'personal' ? 'primary' : 'default'}
              />
              <Chip
                label="Kun Klient-synlige"
                size="small"
                onClick={() => setCurrentMode('client')}
                color={currentMode === 'client' ? 'secondary' : 'default'}
              />
            </Box>

            <GridOn container spacing={3}>
              <GridOn size={{ xs: 1, 2,}} md={6}>
                <Accordion defaultExpanded>
                  <AccordionSummary expandIcon={{theming.getThemedIcon('expandMore')}}>
                    <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>Hovedpunkter</Typography>
                  </AccordionSummary>
                  <AccordionDetails>
                    <List>
                      {meetingNotes.structuredNotes.keyPoints
                        ?.filter(
                          (point) => currentMode === 'personal' || point.visibility === 'client',
                        )
                        .map((point, idx) => (
                          <ListItem key={idx}>
                            <ListItemText
                              primary={typeof point === 'string' ? point : point.text}
                              secondary={
                                typeof point !== 'string' && (
                                  <Chip
                                    size="small"
                                    label={
                                      point.visibility === 'client' ? 'Klient-synlig' : 'Personlig'
                                  }
                                    color={point.visibility === 'client' ? 'secondary' : 'primary'}
                                    variant="outlined"
                                  />
                                )
                            }
                            />
                          </ListItem>
                        ))}
                    </List>
                  </AccordionDetails>
                </Accordion>

                <Accordion>
                  <AccordionSummary expandIcon={{theming.getThemedIcon('expandMore')}}>
                    <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>Handlingspunkter</Typography>
                  </AccordionSummary>
                  <AccordionDetails>
                    <List>
                      {meetingNotes.structuredNotes.actionItems.map((item, idx) => (
                        <ListItem key={idx}>
                          <ListItemText
                            primary={item.task}
                            secondary={`${item.assignedTo} • ${item.dueDate}`}
                          />
                        </ListItem>
                      ))}
                    </List>
                  </AccordionDetails>
                </Accordion>
              </GridOn>

              <GridOn size={{ xs: 1, 2,}} md={6}>
                <Accordion>
                  <AccordionSummary expandIcon={{theming.getThemedIcon('expandMore')}}>
                    <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>Avgjørelser</Typography>
                  </AccordionSummary>
                  <AccordionDetails>
                    <List>
                      {meetingNotes.structuredNotes.decisions.map((decision, idx) => (
                        <ListItem key={idx}>
                          <ListItemText primary={decision} />
                        </ListItem>
                      ))}
                    </List>
                  </AccordionDetails>
                </Accordion>

                <Accordion>
                  <AccordionSummary expandIcon={{theming.getThemedIcon('expandMore')}}>
                    <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>Klientønsker</Typography>
                  </AccordionSummary>
                  <AccordionDetails>
                    <List>
                      {meetingNotes.structuredNotes.clientRequests.map((request, idx) => (
                        <ListItem key={idx}>
                          <ListItemText primary={request} />
                        </ListItem>
                      ))}
                    </List>
                  </AccordionDetails>
                </Accordion>
              </GridOn>
            </GridOn>
          </Box>
        )}

        {/* Tab 2: Intelligent Summary , *, /}
        {activeTab === 1 && (
          <Box mt={2}>
            <GridOn container spacing={2}>
              {/* Full Intelligent Summary */}
              <GridOn size={{ xs: 1, 2,}} md={6}>
                <Box>
                  <Typography variant="h6" gutterBottom color="primary" sx={{ ...{}, color: theming.colors.primary }}>
                    Fullstendig Sammendrag
                  </Typography>
                  {meetingNotes?.aiSummary?.full || meetingNotes?.aiSummary ? (
                    <Paper
                      sx={{
                        p:  3,
                        bgcolor: 'primary.5',
                        border: '1px solid',
                        borderColor: 'primary.20',
                    }}
                     sx={theming.getThemedCardSx()}>
                      <Typography variant="body1" style={{ whiteSpace: 'pre-line, ',}}>
                        {typeof meetingNotes.aiSummary === 'string'
                          ? meetingNotes.aiSummary
                          : meetingNotes.aiSummary.full}
                      </Typography>
                    </Paper>
                  ) : (
                    <Typography variant="body2" color="text.secondary" align="center">
                      Fullstendig Intelligent sammendrag vil vises her
                    </Typography>
                  )}
                </Box>
              </GridOn>

              {/* Client Version Summary */}
              <GridOn size={{ xs: 1, 2,}} md={6}>
                <Box>
                  <Box display="flex" alignItems="center" gap={1} mb={1}>
                    <Typography variant="h6" color="secondary" sx={{ ...{}, color: theming.colors.primary }}>
                      Klient Versjon
                    </Typography>
                    {clientCanView && (
                      <Chip label="Kan deles" size="small" color="success" variant="outlined" />
                    )}
                  </Box>
                  {meetingNotes?.aiSummary?.clientVersion ? (
                    <Paper
                      sx={{
                        p:  3,
                        bgcolor: 'secondary.5',
                        border: '1px solid',
                        borderColor: 'secondary.20',
                    }}
                     sx={theming.getThemedCardSx()}>
                      <Typography variant="body1" style={{ whiteSpace: 'pre-line, ',}}>
                        {meetingNotes.aiSummary.clientVersion}
                      </Typography>
                    </Paper>
                  ) : (
                    <Typography variant="body2" color="text.secondary" align="center">
                      Klient-tilpasset sammendrag vil vises her
                    </Typography>
                  )}
                </Box>
              </GridOn>
            </GridOn>
          </Box>
        )}

        {/* Tab 3: Timeline Integration , *, /}
        {activeTab === 2 && weddingTimelineId && (
          <Box mt={2}>
            <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
              Bryllupstidslinje Integrasjon
            </Typography>

            {meetingNotes?.structuredNotes?.timeline &&
            meetingNotes.structuredNotes.timeline.length > 0 ? (
              <List>
                {meetingNotes.structuredNotes.timeline.map((event, idx) => (
                  <ListItem key={idx}>
                    <ListItemIcon>
                      <Wedding />
                    </ListItemIcon>
                    <ListItemText
                      primary={event.event}
                      secondary={`${event.date} • ${event.notes}`}
                    />
                  </ListItem>
                ))}
              </List>
            ) : (
              <Typography variant="body2" color="text.secondary">
                Tidslinjeinformasjon vil vises her etter Intelligent-behandling
              </Typography>
            )}

            <Box mt={2}>
              <Button variant="contained"
                startIcon={<CloudSync sx={theming.getThemedButtonSx()}>}
                onClick={handleTimelineSync}
                disabled={!meetingNotes?.structuredNotes?.timeline?.length}
              >
                Sync til Bryllupstidslinje
              </Button>
            </Box>
          </Box>
        )}
      </CardContent>

      {/* Wedding Timeline Sync Dialog */}
      <Dialog
        open={showTimelineDialog}
        onClose={() => setShowTimelineDialog(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>Sync til Bryllupstidslinje</DialogTitle>
        <DialogContent>
          <Typography variant="body1" gutterBottom>
            Følgende informasjon vil bli synkronisert til bryllupstidslinjen: </Typography>

          {meetingNotes?.structuredNotes && (
            <Box>
              <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                Tidslinjedata: </Typography>
              <List dense>
                {meetingNotes.structuredNotes.timeline?.map((item, idx) => (
                  <ListItem key={idx}>
                    <ListItemText primary={item.event} secondary={item.date} />
                  </ListItem>
                ))}
              </List>

              <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                Klientønsker: </Typography>
              <List dense>
                {meetingNotes.structuredNotes.clientRequests?.map((request, idx) => (
                  <ListItem key={idx}>
                    <ListItemText primary={request} />
                  </ListItem>
                ))}
              </List>
            </Box>
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowTimelineDialog(false)}>Avbryt</Button>
          <Button onClick={handleTimelineSync}
            variant="contained"
            disabled={timelineSyncMutation.isLoading}
           sx={theming.getThemedButtonSx()}>
            {timelineSyncMutation.isLoading ? 'Synkroniserer...' : 'Sync Nå'}
          </Button>
        </DialogActions>
      </Dialog>
    </MuiCard>
  );
}
