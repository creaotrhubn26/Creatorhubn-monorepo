                multiline
                rows={4}
                label="AI-analyse resultat"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </GridOn>
          </GridOn>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowAIDetector(false)}>Lukk</Button>
          <Button
            variant="contained"
            onClick={() => handleDetectAI?.()}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Psychology />}
          >
            {isProcessing ? 'Analyserer...' : 'Analyser Tekst'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 📊 Word Counter Dialog */}
      <Dialog
        open={showWordCounter}
        onClose={() => setShowWordCounter(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Assignment color="primary" />
          Word Counter & Statistikk
        </DialogTitle>
        <DialogContent>
          <GridOn container spacing={2}>
            <GridOn size={{ xs: 12 }}>
              <TextField
                fullWidth
                multiline
                rows={5}
                label="Tekst som skal analyseres"
                value={inputText}
                onChange={(e) => {
                  setInputText(e.target.value);
                  if (e.target.value.trim()) {
                    const stats = analyzeText?.(e.target.value);
                    if (stats) {
                      setOutputText(
                        `
📊 TEKSTSTATISTIKK:

• Ord: ${stats.words}
• Tegn: ${stats.characters}
• Tegn (uten mellomrom): ${stats.charactersNoSpaces}
• Setninger: ${stats.sentences}
• Avsnitt: ${stats.paragraphs}
• Gjennomsnittlige ord per setning: ${stats.averageWordsPerSentence}
• Lesetid: ${stats.readingTime} minutter
                      `.trim(),
                      );
                    }
                  } else {
                    setOutputText('');
                  }
                }}
                placeholder="Skriv eller lim inn tekst for analyse..."
              />
            </GridOn>

            <GridOn size={{ xs: 12 }}>
              <TextField
                fullWidth
                multiline
                rows={6}
                label="Statistikk"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </GridOn>
          </GridOn>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowWordCounter(false)}>Lukk</Button>
          <Button
            variant="contained"
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier Statistikk
          </Button>
        </DialogActions>
      </Dialog>

      {/* ✅ CreatorBot-stil Floating Tools Panel */}
      <Paper
        elevation={6}
        sx={{
          position: 'fixed',
          top: '50%',
          right: 20,
          transform: 'translateY(-50%)',
          width: 280,
          maxHeight: '80vh',
          overflow: 'auto',
          zIndex: 1300,
          borderRadius: 2,
        }}
      >
        <Box sx={{ p: 2 }}>
          <Typography
            variant="h6"
            gutterBottom
            sx={{ display: 'flex', alignItems: 'center', gap: 1 }}
          >
            <SmartToy color="primary" />
            CreatorBot AI Tools
          </Typography>

          {/* CreatorBot Core Tools Grid */}
          <GridOn container spacing={1} sx={{ mb: 2 }}>
            {/* Paraphraser */}
            <GridOn size={{ xs: 6 }}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowParaphraser(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Transform sx={{ mb: 0.5 }} />
                <Typography variant="caption">Paraphraser</Typography>
              </Button>
            </GridOn>

            {/* Grammar Checker */}
            <GridOn size={{ xs: 6 }}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowGrammarChecker(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Spellcheck sx={{ mb: 0.5 }} />
                <Typography variant="caption">Grammar</Typography>
              </Button>
            </GridOn>

            {/* Summarizer */}
            <GridOn size={{ xs: 6 }}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowSummarizer(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Subject sx={{ mb: 0.5 }} />
                <Typography variant="caption">Summarizer</Typography>
              </Button>
            </GridOn>

            {/* AI Humanizer */}
            <GridOn size={{ xs: 6 }}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowHumanizer(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Psychology sx={{ mb: 0.5 }} />
                <Typography variant="caption">Humanizer</Typography>
              </Button>
            </GridOn>

            {/* Translator */}
            <GridOn size={{ xs: 6 }}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowTranslator(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Translate sx={{ mb: 0.5 }} />
                <Typography variant="caption">Translator</Typography>
              </Button>
            </GridOn>

            {/* Citation Generator */}
            <GridOn size={{ xs: 6 }}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowCitationGen(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <FormatQuote sx={{ mb: 0.5 }} />
                <Typography variant="caption">Citations</Typography>
              </Button>
            </GridOn>
          </GridOn>

          {/* Content Generators Accordion */}
          <Accordion>
            <AccordionSummary expandIcon={<ExpandMore />}>
              <Typography variant="subtitle2">Content Generators</Typography>
            </AccordionSummary>
            <AccordionDetails>
              <Stack spacing={1}>
                <Button
                  size="small"
                  variant="text"
                  startIcon={<Article />}
                  onClick={() => setShowParagraphGen(true)}
                >
                  Paragraph Generator
                </Button>
                <Button
                  size="small"
                  variant="text"
                  startIcon={<Book />}
                  onClick={() => setShowStoryGen(true)}
                >
                  Story Generator
                </Button>
                <Button
                  size="small"
                  variant="text"
                  startIcon={<Email />}
                  onClick={() => setShowEmailGen(true)}
                >
                  Email Writer
                </Button>
                <Button
                  size="small"
                  variant="text"
                  startIcon={<Work />}
                  onClick={() => setShowCoverLetterGen(true)}
                >
                  Cover Letter
                </Button>
                <Button
                  size="small"
                  variant="text"
                  startIcon={<Title />}
                  onClick={() => setShowTitleGen(true)}
                >
                  Title Generator
                </Button>
              </Stack>
            </AccordionDetails>
          </Accordion>

          {/* Utilities Accordion */}
          <Accordion>
            <AccordionSummary expandIcon={<ExpandMore />}>
              <Typography variant="subtitle2">Utilities & Analysis</Typography>
            </AccordionSummary>
            <AccordionDetails>
              <Stack spacing={1}>
                <Button
                  size="small"
                  variant="text"
                  startIcon={<Psychology />}
                  onClick={() => setShowAIDetector(true)}
                >
                  AI Content Detector
                </Button>
                <Button
                  size="small"
                  variant="text"
                  startIcon={<Assignment />}
                  onClick={() => setShowWordCounter(true)}
                >
                  Word Counter & Stats
                </Button>
                <Button
                  size="small"
                  variant="text"
                  startIcon={<Refresh />}
                  onClick={() => {
                    setInputText('');
                    setOutputText('');
                    toast({
                      title: 'Tilbakestilt',
                      description: 'Alle felt er tømt',
                      variant: 'default',
                    });
                  }}
                >
                  Clear All Fields
                </Button>
              </Stack>
            </AccordionDetails>
          </Accordion>
        </Box>
      </Paper>
    </Box>
  );
}
