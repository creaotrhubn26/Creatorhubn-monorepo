  const generateIntelligentAPI = () => `
// 🧠 AI-Generated API Endpoints
import express from 'express';
import { storage } from '../storage';

const router = express.Router();

// Intelligent ${generationSettings.profession} endpoint
router.post('/api/${generationSettings.profession}/intelligent-action', async (req, res) => {
  try {
    const { action, context } = req.body;
    
    // AI-powered logic based on profession
    const result = await processIntelligentAction(action, context, '${generationSettings.profession}');
    
    res.json({ 
      success: true, 
      result,
      generatedBy: 'MagicCreator AI',
      timestamp: new Date().toISOString()
    });
  } catch (error) {
    res.status(500).json({ error: 'Intelligent action failed' });
  }
});

async function processIntelligentAction(action: string, context: { id: string; title: string; data: unknown }, profession: string) {
  // Profession-specific intelligent processing
  const professionHandlers = {
    photographer: () => optimizePhotographyWorkflow(context),
    videographer: () => optimizeVideoWorkflow(context),
    music_producer: () => optimizeMusicWorkflow(context)
  };
  
  return await professionHandlers[profession]?.() || 'Generic intelligent action';
}

export default router;
`;

  const generateIntelligentDatabase = () => `
-- 🧠 AI-Generated Database Schema
-- Generated for ${generationSettings.profession} profession

CREATE TABLE IF NOT EXISTS ${generationSettings.profession}_intelligence (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id VARCHAR REFERENCES users(id),
  intelligence_data JSONB NOT NULL,
  profession VARCHAR DEFAULT '${generationSettings.profession}',
  ai_insights JSONB,
  performance_metrics JSONB,
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_${generationSettings.profession}_user 
  ON ${generationSettings.profession}_intelligence(user_id);

CREATE INDEX IF NOT EXISTS idx_${generationSettings.profession}_profession 
  ON ${generationSettings.profession}_intelligence(profession);

-- AI-generated insights table
CREATE TABLE IF NOT EXISTS ai_code_generations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id VARCHAR,
  component_type VARCHAR,
  generated_code TEXT,
  intelligence_level VARCHAR DEFAULT '${generationSettings.intelligenceLevel}',
  profession VARCHAR DEFAULT '${generationSettings.profession}',
  google_docs_id VARCHAR,
  created_at TIMESTAMP DEFAULT NOW()
);
`;

  // ✅ Notat-funksjoner
  const handleSaveNote = () => {
    if (!currentTitle.trim()) {
      toast({
        title: 'Mangler tittel',
        description: 'Notatet trenger en tittel',
        variant: 'destructive',
      });
      return;
    }

    saveNoteMutation.mutate({
      title: currentTitle,
      content: currentContent,
      category: selectedCategory === 'alle' ? 'personlig' : selectedCategory,
      tags: [],
      isShared: false,
    });
  };

  const handleSelectNote = (note: Note) => {
    setSelectedNote(note);
    setCurrentTitle(note.title);
    setCurrentContent(note.content);
    setIsEditing(false);
  };

  const startNewNote = () => {
    setSelectedNote(null);
    setCurrentTitle('');
    setCurrentContent('');
    setIsEditing(true);
  };

  // ✅ Filtrer notater
  const filteredNotes = (fetchedNotes || []).filter((note) => {
    const matchesSearch =
      !searchQuery ||
      note.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
      note.content.toLowerCase().includes(searchQuery.toLowerCase());
    const matchesCategory = selectedCategory === 'alle' || note.category === selectedCategory;
    return matchesSearch && matchesCategory;
  });

  return (
    <Box className={className} sx={{ height: '100vh', display: 'flex' }}>
      {/* ✅ Sidebar med notatliste */}
      <Paper
        sx={{
          width: 320,
          borderRight: 1,
          borderColor: 'divider',
          display: 'flex',
          flexDirection: 'column',
        }}
      >
        {/* Header */}
        <Box sx={{ p: 2, borderBottom: 1, borderColor: 'divider' }}>
          <Typography variant="h5" sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 2 }}>
            <NotesIcon color="primary" />
            CreatorHub Notater
          </Typography>

          {/* Søk */}
          <TextField
            fullWidth
            size="small"
            placeholder="Søk i notater..."
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            InputProps={{
              startAdornment: <Search sx={{ color: 'text.secondary', mr: 1 }} />,
            }}
            sx={{ mb: 2 }}
          />

          {/* Ny notat knapp */}
          <Button
            fullWidth
            variant="contained"
            startIcon={<Add />}
            onClick={startNewNote}
            sx={{ mb: 1 }}
          >
            Nytt notat
          </Button>
        </Box>

        {/* Kategorier */}
        <Box sx={{ p: 1 }}>
          <Tabs
            orientation="vertical"
            value={selectedCategory}
            onChange={(_, value) => setSelectedCategory(value)}
            sx={{ minHeight: 'auto' }}
          >
            {categories.map((cat) => (
              <Tab
                key={cat.id}
                value={cat.id}
                label={cat.name}
                sx={{
                  minHeight: 36,
                  fontSize: '12px',
                  alignItems: 'flex-start',
                  textAlign: 'left',
                }}
              />
            ))}
          </Tabs>
        </Box>

        {/* Notatliste */}
        <Box sx={{ flex: 1, overflow: 'auto' }}>
          {notesLoading ? (
            <Box sx={{ p: 2, textAlign: 'center' }}>
              <CircularProgress size={24} />
            </Box>
          ) : filteredNotes.length > 0 ? (
            <List dense>
              {filteredNotes.map((note) => (
                <ListItem
                  key={note.id}
                  component="button"
                  onClick={() => handleSelectNote(note)}
                  sx={{ 
                    px: 2,
                    backgroundColor: selectedNote?.id === note.id ? 'action.selected' : 'transparent',
                    '&:hover': {
                      backgroundColor: 'action.hover',
                    }
                  }}
                >
                  <ListItemText
                    primary={
                      <Typography variant="body2" noWrap>
                        {note.title}
                      </Typography>
                    }
                    secondary={
                      <Box>
                        <Typography variant="caption" color="text.secondary">
                          {new Date(note.updatedAt).toLocaleDateString('no')}
                        </Typography>
                        <Box
                          dangerouslySetInnerHTML={{
                            __html: note.content.replace(/<[^>]*>/g, '').substring(0, 50) + '...',
                          }}
                          sx={{
                            fontSize: '11px',
                            color: 'text.secondary',
                            mt: 0.5,
                            overflow: 'hidden',
                            textOverflow: 'ellipsis',
                          }}
                        />
                      </Box>
                    }
                  />
                </ListItem>
              ))}
            </List>
          ) : (
            <Box sx={{ p: 2, textAlign: 'center', color: 'text.secondary' }}>
              <NotesIcon sx={{ fontSize: 48, mb: 1, opacity: 0.5 }} />
              <Typography variant="body2">
                {searchQuery ? 'Ingen notater funnet' : 'Ingen notater ennå'}
              </Typography>
            </Box>
          )}
        </Box>
      </Paper>

      {/* ✅ Hovedinnhold */}
      <Box sx={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
        {/* Toolbar */}
        <Paper
          sx={{
            p: 2,
            borderBottom: 1,
            borderColor: 'divider',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
          }}
        >
          {selectedNote || isEditing ? (
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, flex: 1 }}>
              <TextField
                size="small"
                placeholder="Notattittel..."
                value={currentTitle}
                onChange={(e) => setCurrentTitle(e.target.value)}
                sx={{ flex: 1 }}
              />

              <Box sx={{ display: 'flex', gap: 1 }}>
                <Button
                  variant="contained"
                  size="small"
                  startIcon={<Save />}
                  onClick={handleSaveNote}
                  disabled={saveNoteMutation.isPending || !currentTitle.trim()}
                >
                  {saveNoteMutation.isPending ? 'Lagrer...' : 'Lagre'}
                </Button>

                {selectedNote && (
                  <>
                    <Button
                      variant="outlined"
                      size="small"
                      startIcon={isEditing ? <Visibility /> : <Edit />}
                      onClick={() => setIsEditing(!isEditing)}
                    >
                      {isEditing ? 'Forhåndsvis' : 'Rediger'}
                    </Button>

                    <Button
                      variant="outlined"
                      size="small"
                      color="error"
                      startIcon={<Delete />}
                      onClick={() => selectedNote && deleteNoteMutation.mutate(selectedNote.id)}
                      disabled={deleteNoteMutation.isPending}
                    >
                      Slett
                    </Button>
                  </>
                )}
              </Box>
            </Box>
          ) : (
            <Typography variant="h6" color="text.secondary">
              Velg et notat eller opprett et nytt
            </Typography>
          )}
        </Paper>

        {/* Editor/Viewer */}
        <Box sx={{ flex: 1, p: 2 }}>
          {selectedCategory === 'interactive' ? (
            <Box>
              {!interactiveMode ? (
                <Box>
                  <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                    <SmartToy color="primary" />
                    Interaktive Dokumenter
                  </Typography>
                  <Typography variant="body1" sx={{ mb: 3 }}>
                    Konverter statiske dokumenter til interaktive opplevelser med klikkbare elementer, 
                    kodesandkasser, simuleringer og mer.
                  </Typography>
                  
                  <DocumentImporter
                    onDocumentProcessed={handleDocumentProcessed}
                    onError={handleDocumentError}
                  />
                </Box>
              ) : (
                <Box>
                  <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
                    <Typography variant="h5">
                      Interaktiv Dokument Editor
                    </Typography>
                    <Stack direction="row" spacing={1}>
                      <Button
                        size="small"
                        variant="outlined"
                        onClick={() => setInteractiveMode(false)}
                      >
                        Tilbake
                      </Button>
                      <Button
                        size="small"
                        variant="contained"
                        startIcon={<SmartToy />}
                      >
                        Forhåndsvis
                      </Button>
                    </Stack>
                  </Box>
                  
                  <InteractiveElements
                    elements={interactiveElements}
                    onElementAdd={handleElementAdd}
                    onElementUpdate={handleElementUpdate}
                    onElementDelete={handleElementDelete}
                    onElementSelect={handleElementSelect}
                    selectedElementId={selectedElementId}
                  />
                </Box>
              )}
            </Box>
          ) : selectedCategory === 'customization' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Settings color="primary" />
                Tilpasning & Temaer
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Tilpass utseendet og følelsen av CreatorHub med egne temaer, farger, 
                typografi og mer.
              </Typography>
              
              <CustomizationSystem
                theme={theme}
                branding={branding}
                whiteLabel={whiteLabel}
                onThemeChange={handleThemeChange}
                onBrandingChange={handleBrandingChange}
                onWhiteLabelChange={handleWhiteLabelChange}
                onSave={handleSaveCustomization}
                onReset={handleResetCustomization}
                onExport={handleExportCustomization}
                onImport={handleImportCustomization}
              />
            </Box>
          ) : selectedCategory === 'codesandbox' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Code color="primary" />
                Code Sandbox
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Kjøre og teste kode direkte i nettleseren med støtte for flere programmeringsspråk.
              </Typography>
              
              <CodeSandbox
                initialCode="// Skriv din kode her\nconsole.log('Hei fra CreatorHub!');"
                language="javascript"
                theme="light"
                showLineNumbers={true}
                autoRun={false}
                onCodeChange={(code) => console.log('Code changed:', code)}
                onRun={(result) => console.log('Code executed:', result)}
                onError={(error) => console.error('Code error:', error)}
              />
            </Box>
          ) : selectedCategory === 'diagrams' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <AccountTree color="primary" />
                Interaktive Diagrammer
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Lag interaktive diagrammer, flytskjemaer og visuelle representasjoner av data.
              </Typography>
              
              <InteractiveDiagram
                diagramType="flowchart"
                theme="creatorhub"
                interactive={true}
                onNodeClick={(node) => console.log('Node clicked:', node)}
                onEdgeClick={(edge) => console.log('Edge clicked:', edge)}
                onDiagramChange={(nodes, edges) => console.log('Diagram changed:', nodes, edges)}
              />
            </Box>
          ) : selectedCategory === 'simulations' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Timeline color="primary" />
                Steg-for-steg Simuleringer
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Lag interaktive simuleringer og opplæringsoppgaver med steg-for-steg veiledning.
              </Typography>
              
              <StepByStepSimulation
                onSimulationChange={(simulation) => console.log('Simulation changed:', simulation)}
                onStepComplete={(stepId, result) => console.log('Step completed:', stepId, result)}
                onSimulationComplete={(results) => console.log('Simulation completed:', results)}
              />
            </Box>
          ) : selectedCategory === 'ai-analyzer' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <AutoFixHigh color="primary" />
                AI Innholdsanalyse
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                La AI analysere ditt innhold og foreslå forbedringer og interaktive elementer.
              </Typography>
              
              <AIContentAnalyzer
                content={currentContent}
                onApplySuggestion={handleAIAnalysis}
                onGenerateInteractive={handleAIGeneration}
              />
            </Box>
          ) : selectedCategory === 'ai-generator' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <SmartToy color="primary" />
                Smart Innholdsgenerator
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Generer interaktivt innhold automatisk med AI-støtte.
              </Typography>
              
              <SmartContentGenerator
                onGenerate={handleAIGeneration}
                onSave={(content) => console.log('Content saved:', content)}
              />
            </Box>
          ) : selectedCategory === 'ai-learning' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Psychology color="primary" />
                AI Læringsassistent
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Personlige læringsanbefalinger og tilpasset innhold basert på din fremgang.
              </Typography>
              
              <AILearningAssistant
                userId="current-user"
                onRecommendationClick={handleLearningRecommendation}
                onUpdateProfile={handleUpdateLearningProfile}
              />
            </Box>
          ) : selectedCategory === 'collaboration' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Group color="primary" />
                Sanntids Samarbeid
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Samarbeid i sanntid med live redigering, tilstedeværelse og konfliktløsning.
              </Typography>
              
              <RealTimeCollaboration
                documentId="current-document"
                currentUser={currentUser || { id: 'current-user', name: 'Current User', email: 'user@creatorhub.no' }}
                onUserJoin={handleUserJoin}
                onUserLeave={handleUserLeave}
                onContentChange={handleContentChange}
                onCommentAdd={handleCommentAdd}
                onCommentResolve={handleCommentResolve}
              />
            </Box>
          ) : selectedCategory === 'cursor-tracking' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Visibility color="primary" />
                Live Cursor Sporing
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Se hvor andre brukere jobber i sanntid med live cursor-posisjoner.
              </Typography>
              
              <LiveCursorTracking
                documentId="current-document"
                currentUserId="current-user"
                onCursorMove={handleCursorMove}
                onUserHover={handleUserHover}
              />
            </Box>
          ) : selectedCategory === 'version-control' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <History color="primary" />
                Versjonskontroll
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Spor endringer, versjoner og samarbeidshistorikk for interaktiv dokumentasjon.
              </Typography>
              
              <VersionControl
                documentId="current-document"
                currentVersion={currentVersion}
                onVersionChange={handleVersionChange}
                onVersionCreate={handleVersionCreate}
                onBranchCreate={handleBranchCreate}
                onBranchMerge={handleBranchMerge}
                onVersionRestore={handleVersionRestore}
              />
            </Box>
          ) : selectedCategory === 'analytics' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Assessment color="primary" />
                Analytics Dashboard
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Spor ytelse, engasjement og brukeradferd for interaktiv dokumentasjon.
              </Typography>
              
              <AnalyticsDashboard
                onExport={handleAnalyticsExport}
                onFilterChange={handleAnalyticsFilterChange}
                onMetricClick={handleMetricClick}
              />
            </Box>
          ) : selectedCategory === 'behavior-tracking' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Psychology color="primary" />
                Brukeradferd Sporing
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Overvåk brukerinteraksjoner og oppdag mønstre i brukeradferd.
              </Typography>
              
              <UserBehaviorTracker
                onUserSelect={handleUserSelect}
                onPatternDetected={handlePatternDetected}
                onExport={(data) => console.log('Exporting behavior data:', data)}
              />
            </Box>
          ) : selectedCategory === 'performance' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Timeline color="primary" />
                Ytelsesmonitor
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Overvåk ytelse, ressursbruk og optimaliser interaktiv dokumentasjon.
              </Typography>
              
              <PerformanceMonitor
                onAlert={handlePerformanceAlert}
                onOptimize={handleOptimize}
                onExport={(data) => console.log('Exporting performance data:', data)}
              />
            </Box>
          ) : selectedCategory === 'achievements' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Star color="primary" />
                Achievement System
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Track your achievements and unlock rewards for your progress.
              </Typography>
              
              <AchievementSystem
                onAchievementUnlocked={handleAchievementUnlocked}
                onLevelUp={handleLevelUp}
                onBadgeEarned={handleBadgeEarned}
              />
            </Box>
          ) : selectedCategory === 'progress-tracking' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Timeline color="primary" />
                Progress Tracking
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Set goals and track your progress towards achieving them.
              </Typography>
              
              <ProgressTracking
                onGoalCompleted={handleGoalCompleted}
                onMilestoneReached={handleMilestoneReached}
                onProgressUpdate={handleProgressUpdate}
              />
            </Box>
          ) : selectedCategory === 'rewards' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Star color="primary" />
                Reward System
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Earn and use rewards for your achievements and progress.
              </Typography>
              
              <RewardSystem
                onRewardEarned={handleRewardEarned}
                onRewardUsed={handleRewardUsed}
                onShopPurchase={handleShopPurchase}
              />
            </Box>
          ) : selectedCategory === 'mobile-nav' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Menu color="primary" />
                Mobile Navigation
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Advanced mobile navigation with swipe gestures and responsive design.
              </Typography>
              
              <MobileNavigation
                open={mobileNavOpen}
                onClose={() => setMobileNavOpen(false)}
                onNavigate={handleMobileNavigate}
                userProfile={{
                  name: 'John Doe',
                  level: userLevel,
                  points: userPoints
                }}
              />
            </Box>
          ) : selectedCategory === 'touch-gestures' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <TouchApp color="primary" />
                Touch Gestures
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Advanced touch gesture recognition for mobile devices.
              </Typography>
              
              <TouchGestures
                onGesture={handleTouchGesture}
                onSwipe={handleSwipe}
                onPinch={handlePinch}
                onRotate={handleRotate}
                onTap={handleTap}
                onDoubleTap={handleDoubleTap}
                onLongPress={handleLongPress}
              />
            </Box>
          ) : selectedCategory === 'responsive-layout' ? (
            <Box>
              <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Computer color="primary" />
                Responsive Layout
              </Typography>
              <Typography variant="body1" sx={{ mb: 3 }}>
                Adaptive layout system that responds to different screen sizes and devices.
              </Typography>
              
              <ResponsiveLayout
                onLayoutChange={handleLayoutChange}
                onBreakpointChange={handleBreakpointChange}
              >
                <Box sx={{ p: 2 }}>
                  <Typography variant="h6" gutterBottom>
                    Content Area
                  </Typography>
                  <Typography variant="body2" color="text.secondary">
                    This content adapts to different screen sizes and layout configurations.
                  </Typography>
                </Box>
              </ResponsiveLayout>
            </Box>
          ) : selectedNote || isEditing ? (
            isEditing ? (
              <Box sx={{ height: '100%' }}>
                <RichTextEditor
                  theme="snow"
                  value={currentContent}
                  onChange={setCurrentContent}
                  modules={quillModules}
                  formats={quillFormats}
                  placeholder="Skriv ditt notat her..."
                  style={{ height: 'calc(100% - 50px)' }}
                />
              </Box>
            ) : (
              <Box sx={{ height: '100%', overflow: 'auto' }}>
                <Typography variant="h4" gutterBottom>
                  {selectedNote?.title}
                </Typography>
                <Box
                  dangerouslySetInnerHTML={{ __html: selectedNote?.content || '' }}
                  sx={{
                    '& h1': { fontSize: '1.5rem', mb: 1 },
                    '& h2': { fontSize: '1.25rem', mb: 1 },
                    '& h3': { fontSize: '1.125rem', mb: 1 },
                    '& p': { mb: 1 },
                    '& ul, & ol': { pl: 3, mb: 1 },
                    '& li': { mb: 0.5 },
                    '& blockquote': {
                      borderLeft: 4,
                      borderColor: 'primary.main',
                      bgcolor: 'grey.50',
                      p: 2,
                      m: 1,
                      fontStyle: 'italic',
                    },
                    lineHeight: 1.6,
                  }}
                />
              </Box>
            )
          ) : (
            <Box
              sx={{
                height: '100%',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                flexDirection: 'column',
                color: 'text.secondary',
              }}
            >
              <NotesIcon sx={{ fontSize: 80, mb: 2, opacity: 0.3 }} />
              <Typography variant="h6" gutterBottom>
                Velkommen til CreatorHub Notater
              </Typography>
              <Typography variant="body2" align="center">
                Velg et notat fra listen til venstre eller opprett et nytt
                <br />
                for å komme i gang med avansert notatskriving
              </Typography>
            </Box>
          )}
        </Box>
      </Box>

      {/* ✅ Creator Bot SpeedDial - Avanserte funksjoner */}
      <Fab
        color="primary"
        size="large"
        sx={{ position: 'fixed', bottom: 20, right: 20 }}
        onClick={() => setShowCodeGenDialog(true)}
        title="Creator Bot - Code Generator"
      >
        <SmartToy />
      </Fab>

      {/* ✅ Code Generator Dialog */}
      <Dialog
        open={showCodeGenDialog}
        onClose={() => setShowCodeGenDialog(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <SmartToy color="primary" />
          Creator Bot - Code Generator
        </DialogTitle>
        <DialogContent>
          <Stack spacing={3} sx={{ mt: 1 }}>
            <TextField
              fullWidth
              multiline
              rows={3}
              label="Beskrivelse av krav"
              value={codeGenSettings.requirements}
              onChange={(e) =>
                setCodeGenSettings((prev) => ({
                  ...prev,
                  requirements: e.target.value,
                }))
              }
              placeholder="Beskriv hvilken komponent du vil generere..."
            />

            <GridOn container spacing={2}>
              <GridOn size={{ xs: 4 }}>
                <FormControl fullWidth>
                  <InputLabel>Profesjon</InputLabel>
                  <Select
                    value={codeGenSettings.profession}
                    onChange={(e) =>
                      setCodeGenSettings((prev) => ({
                        ...prev,
                        profession: e.target.value,
                      }))
                    }
                  >
                    <MenuItem value="photographer">Fotograf</MenuItem>
                    <MenuItem value="videographer">Videomaker</MenuItem>
                    <MenuItem value="musician">Musiker</MenuItem>
                    <MenuItem value="vendor">Leverandør</MenuItem>
                  </Select>
                </FormControl>
              </GridOn>
              <GridOn size={{ xs: 4 }}>
                <FormControl fullWidth>
                  <InputLabel>Framework</InputLabel>
                  <Select
                    value={codeGenSettings.framework}
                    onChange={(e) =>
                      setCodeGenSettings((prev) => ({
                        ...prev,
                        framework: e.target.value,
                      }))
                    }
                  >
                    <MenuItem value="react">React</MenuItem>
                    <MenuItem value="vue">Vue.js</MenuItem>
                    <MenuItem value="angular">Angular</MenuItem>
                  </Select>
                </FormControl>
              </GridOn>
              <GridOn size={{ xs: 4 }}>
                <FormControl fullWidth>
                  <InputLabel>Intelligens-nivå</InputLabel>
                  <Select
                    value={codeGenSettings.intelligenceLevel}
                    onChange={(e) =>
                      setCodeGenSettings((prev) => ({
                        ...prev,
                        intelligenceLevel: e.target.value,
                      }))
                    }
                  >
                    <MenuItem value="basic">Basis</MenuItem>
                    <MenuItem value="advanced">Avansert</MenuItem>
                    <MenuItem value="expert">Ekspert</MenuItem>
                  </Select>
                </FormControl>
              </GridOn>
            </GridOn>

            {generateCodeMutation.isPending && (
              <Box sx={{ textAlign: 'center', py: 2 }}>
                <CircularProgress />
                <Typography variant="body2" sx={{ mt: 1 }}>
                  Genererer intelligent kode...
                </Typography>
              </Box>
            )}
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowCodeGenDialog(false)}>Avbryt</Button>
          <Button
            variant="contained"
            onClick={() => generateCodeMutation.mutate(codeGenSettings)}
            disabled={!codeGenSettings.requirements.trim() || generateCodeMutation.isPending}
          >
            Generer kode
          </Button>
        </DialogActions>
