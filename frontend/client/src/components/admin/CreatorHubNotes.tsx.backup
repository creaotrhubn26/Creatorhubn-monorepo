                {paraphraseModes.map((mode) => (
                  <GridOn size={{ xs: 6 }} sm={4} key={mode.value}>
                    <Button
                      fullWidth
                      variant={paraphraseMode === mode.value ? 'contained' : 'outlined'}
                      size="small"
                      onClick={() => setParaphraseMode(mode.value)}
                      disabled={!mode.free}
                      sx={{
                        flexDirection: 'column',
                        minHeight: 60,
                        opacity: !mode.free ? 0.6 : 1,
                      }}
                    >
                      <Typography variant="caption" fontWeight="bold">
                        {mode.label}
                      </Typography>
                      <Typography variant="caption" fontSize="0.7rem">
                        {mode.description}
                      </Typography>
                    </Button>
                  </GridOn>
                ))}
              </GridOn>
            </GridOn>

            <GridOn size={{ xs: 12 }}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Tekst som skal omskrives"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Skriv eller lim inn tekst her..."
              />
            </GridOn>

            <GridOn size={{ xs: 12 }}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Omskrevet tekst"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </GridOn>
          </GridOn>
