/**
 * AI Todo Tracker with Real-Time Progress
 * 
 * Features:
 * - Contextual todos based on what you're doing
 * - Real-time line counter as code is written
 * - Visual progress indicators
 * - Shows what's blocked and why
 * - "Complete this → Enables that" chains
 */

import React, { useState, useEffect } from 'react';
import {
  Box,
  Card,
  CardContent,
  Typography,
  Checkbox,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Chip,
  LinearProgress,
  Alert,
  Paper,
  Collapse,
  IconButton,
} from '@mui/material';
import {
  CheckCircle as DoneIcon,
  RadioButtonUnchecked as PendingIcon,
  PlayArrow as InProgressIcon,
  ExpandMore as ExpandIcon,
  TrendingFlat as EnablesIcon,
  Lock as LockedIcon,
  Code as CodeIcon,
} from '@mui/icons-material';
import { useTheming } from '../../utils/theming-helper';
import { useEnhancedMasterIntegration } from '../../integration/EnhancedMasterIntegrationProvider';

interface Todo {
  id: string;
  title: string;
  description: string;
  status: 'pending' | 'in_progress' | 'completed' | 'blocked';
  priority: 'critical' | 'high' | 'medium' | 'low';
  difficulty: 'easy' | 'medium' | 'hard';
  estimatedLines?: number;
  currentLines?: number;
  file?: string;
  whatItEnables: string[];
  blockedBy?: string[];
  dependencies: string[];
}

export const AITodoTracker: React.FC = () => {
  const theming = useTheming('prototype_tester');
  const { communication, componentRegistry } = useEnhancedMasterIntegration();
  
  const [todos, setTodos] = useState<Todo[]>([]);
  const [expandedTodos, setExpandedTodos] = useState<Set<string>>(new Set());
  const [currentFile, setCurrentFile] = useState<string>('');
  const [linesWritten, setLinesWritten] = useState<number>(0);

  // Register component
  useEffect(() => {
    componentRegistry.registerComponent({
      id: 'ai-todo-tracker',
      name: 'AI Todo Tracker',
      type: 'admin',
      category: 'task-management',
      capabilities: ['todos', 'todo-completed', 'track', 'widget', 'task-management'],
      dependencies: [],
      props: [],
      events: ['todo-completed'],
      dataKeys: ['todos', 'current-file', 'lines-written'],
      version: '1.0.0',
      description: 'Real-time AI todo tracker with line counting'
    });

    return () => componentRegistry.unregisterComponent('ai-todo-tracker');
}, [componentRegistry]);

  // Listen for code generation events
  useEffect(() => {
    const unsubscribe = communication.onMessage((message: any) => {
      // When API key is added → Generate todos
      if (message.type === 'code-generation:started' && message.data) {
        const service = message.data.provider;
        
        const apiTodos: Todo[] = [
          {
            id: `${service}-1`,
            title: `✅ API key saved to .env`,
            description: `${service.toUpperCase()}_API_KEY has been added`,
            status: 'completed',
            priority: 'critical',
            difficulty: 'easy',
            currentLines: 1,
            estimatedLines: 1,
            whatItEnables: [
              'Service can authenticate',
              'API calls will work',
            ],
            dependencies: [],
        },
          {
            id: `${service}-2`,
            title: `Generate ${service} service wrapper`,
            description: `Create server/services/${service}-service.ts`,
            status: 'in_progress',
            priority: 'critical',
            difficulty: 'easy',
            currentLines: 0,
            estimatedLines: 100,
            file: `server/services/${service}-service.ts`,
            whatItEnables: [
              'Backend can call API',
              'Routes can use service',
              'Type-safe API calls',
            ],
            dependencies: [`${service}-1`],
        },
          {
            id: `${service}-3`,
            title: `Generate API routes`,
            description: `Create server/routes/${service}-api-routes.ts`,
            status: 'pending',
            priority: 'high',
            difficulty: 'easy',
            estimatedLines: 80,
            file: `server/routes/${service}-api-routes.ts`,
            whatItEnables: [
              'Frontend can call API',
              'Express endpoints available',
              'Routes auto-registered',
            ],
            blockedBy: ['Service must be generated first'],
            dependencies: [`${service}-2`],
        },
          {
            id: `${service}-4`,
            title: `Generate React Query hook`,
            description: `Create client/src/hooks/use${service}Api.ts`,
            status: 'pending',
            priority: 'high',
            difficulty: 'easy',
            estimatedLines: 60,
            file: `client/src/hooks/use${service.charAt(0).toUpperCase() + service.slice(1)}Api.ts`,
            whatItEnables: [
              'Components can use hook',
              'Data fetching is easy',
              'Loading states managed',
            ],
            blockedBy: ['Routes must exist first'],
            dependencies: [`${service}-3`],
        },
          {
            id: `${service}-5`,
            title: `Generate UI component`,
            description: `Create client/src/components/integrations/${service}Chat.tsx`,
            status: 'pending',
            priority: 'medium',
            difficulty: 'medium',
            estimatedLines: 200,
            file: `client/src/components/integrations/${service.charAt(0).toUpperCase() + service.slice(1)}Chat.tsx`,
            whatItEnables: [
              'Users can interact with API',
              'Beautiful Material-UI interface',
              'Ready to use in Visual Editor',
            ],
            blockedBy: ['Hook must be generated first'],
            dependencies: [`${service}-4`],
        },
          {
            id: `${service}-6`,
            title: `Connect to Master Integration`,
            description: `Add useEnhancedMasterIntegration to component`,
            status: 'pending',
            priority: 'low',
            difficulty: 'easy',
            estimatedLines: 25,
            whatItEnables: [
              'Component can broadcast events',
              'Visual Editor integration',
              'Cross-component communication',
            ],
            dependencies: [`${service}-5`],
        },
        ];

        setTodos(apiTodos);
    }

      // When file is being written → Update line count
      if (message.type === 'code-generation:file:writing' && message.data) {
        setCurrentFile(message.data.file);
        setLinesWritten(message.data.currentLines);
        
        // Update corresponding todo
        setTodos(prev => prev.map(todo => {
          if (todo.file === message.data.file) {
            return {
              ...todo,
              currentLines: message.data.currentLines,
              status: message.data.currentLines >= (todo.estimatedLines || 0) ? 'completed' : 'in_progress'
          };
        }
          return todo;
      }));
    }

      // When file is completed → Mark todo complete
      if (message.type === 'code-generation:file:complete' && message.data) {
        setTodos(prev => prev.map(todo => {
          if (todo.file === message.data.file) {
            return {
              ...todo,
              status: 'completed' as const,
              currentLines: message.data.totalLines,
          };
        }
          // Auto-unblock next todo
          if (todo.dependencies.includes(message.data.todoId)) {
            const allDepsComplete = todo.dependencies.every(depId =>
              prev.find(t => t.id === depId)?.status === 'completed'
            );
            if (allDepsComplete) {
              return { ...todo, blockedBy: undefined };
          }
        }
          return todo;
      }));
    }

      // When generation is complete → All todos done
      if (message.type === 'code-generation:complete' && message.data.success) {
        setTodos(prev => prev.map(todo => ({
          ...todo,
          status: todo.status === 'pending' ? 'completed' as const : todo.status
      })));
    }
  });

    return unsubscribe;
}, [communication]);

  const completedCount = todos.filter(t => t.status === 'completed').length;
  const progress = todos.length > 0 ? Math.round((completedCount / todos.length) * 100) : 0;

  const toggleExpanded = (todoId: string) => {
    const newExpanded = new Set(expandedTodos);
    if (newExpanded.has(todoId)) {
      newExpanded.delete(todoId);
  } else {
      newExpanded.add(todoId);
  }
    setExpandedTodos(newExpanded);
};

  const getStatusIcon = (todo: Todo) => {
    if (todo.status === 'completed') return <DoneIcon color="success" />;
    if (todo.status === 'in_progress') return <InProgressIcon color="primary" />;
    if (todo.status === 'blocked' || todo.blockedBy) return <LockedIcon color="error" />;
    return <PendingIcon color="action" />;
};

  const getPriorityColor = (priority: string): any => {
    switch (priority) {
      case 'critical': return 'error';
      case 'high': return 'warning';
      case 'medium': return 'info';
      case 'low': return 'success';
      default: return 'default';
  }
};

  if (todos.length === 0) {
    return (
      <Card sx={{ maxWidth: 400 }}>
        <CardContent>
          <Alert severity="info">
            <Typography variant="body2">
              Todos will appear when you:
            </Typography>
            <Box component="ul" sx={{ mt: 1, mb: 0 }}>
              <li>Add an API key</li>
              <li>Start code generation</li>
              <li>Scan for linting errors</li>
            </Box>
          </Alert>
        </CardContent>
      </Card>
    );
}

  return (
    <Card sx={{ maxWidth: 600 }}>
      <CardContent>
        {/* Header with Progress */}
        <Box sx={{ mb: 3 }}>
          <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 1 }}>
            <Typography variant="h6">
              🎯 AI-Generated Tasks
            </Typography>
            <Chip 
              label={`${completedCount}/${todos.length}`} 
              color={progress === 100 ? 'success' : 'primary'}
            />
          </Box>
          <LinearProgress 
            variant="determinate" 
            value={progress} 
            sx={{ height: 6, borderRadius: 1, mb: 1 }}
          />
          <Typography variant="caption" color="text.secondary">
            {progress}% complete
          </Typography>
        </Box>

        {/* Current Activity */}
        {currentFile && (
          <Alert severity="info" sx={{ mb: 2 }}>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
              <CodeIcon fontSize="small" />
              <Box sx={{ flex: 1 }}>
                <Typography variant="body2" fontWeight="bold">
                  Writing: {currentFile.split('/').pop()}
                </Typography>
                <Typography variant="caption">
                  {linesWritten} lines written...
                </Typography>
              </Box>
            </Box>
          </Alert>
        )}

        {/* Todo List */}
        <List sx={{ p: 0 }}>
          {todos.map((todo, index) => {
            const isBlocked = todo.blockedBy && todo.blockedBy.length > 0;
            const isExpanded = expandedTodos.has(todo.id);

            return (
              <Paper 
                key={todo.id} 
                sx={{ 
                  mb: 1,
                  border: 1,
                  borderColor: todo.status === 'in_progress' ? 'primary.main' : 'divider',
                  borderLeft: 4,
                  borderLeftColor: 
                    todo.status === 'completed' ? 'success.main' :
                    todo.status === 'in_progress' ? 'primary.main' :
                    isBlocked ? 'error.main' : 'grey.300'
              }}
              >
                <ListItem 
                  onClick={() => toggleExpanded(todo.id)}
                  sx={{ 
                    bgcolor: todo.status === 'completed' ? 'success.light' : 
                            todo.status === 'in_progress' ? 'primary.light' :
                            'transparent',
                    opacity: isBlocked ? 0.6 : 1,
                    cursor: 'pointer',
                    '&:hover': { bgcolor: 'action.hover' }
                }}
                >
                  <ListItemIcon>
                    {getStatusIcon(todo)}
                  </ListItemIcon>
                  <ListItemText
                    primary={
                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                        <Typography variant="body2" sx={{ flex: 1 }}>
                          {todo.title}
                        </Typography>
                        {todo.estimatedLines && (
                          <Chip 
                            label={`${todo.currentLines || 0}/${todo.estimatedLines} lines`}
                            size="small"
                            variant="outlined"
                          />
                        )}
                        <Chip 
                          label={todo.priority} 
                          size="small" 
                          color={getPriorityColor(todo.priority)}
                        />
                      </Box>
                  }
                    secondary={
                      <Box sx={{ mt: 0.5 }}>
                        {todo.status === 'in_progress' && todo.estimatedLines && (
                          <LinearProgress 
                            variant="determinate" 
                            value={((todo.currentLines || 0) / todo.estimatedLines) * 100}
                            sx={{ height: 4, borderRadius: 1, mb: 0.5 }}
                          />
                        )}
                        <Typography variant="caption" color="text.secondary">
                          {todo.description}
                        </Typography>
                      </Box>
                  }
                  />
                  <IconButton size="small">
                    <ExpandIcon 
                      sx={{ 
                        transform: isExpanded ? 'rotate(180deg)' : 'rotate(0deg)',
                        transition: 'transform 0.3s'
                    }}
                    />
                  </IconButton>
                </ListItem>

                <Collapse in={isExpanded}>
                  <Box sx={{ p: 2, bgcolor: 'grey.50' }}>
                    {/* Blocked By */}
                    {isBlocked && (
                      <Alert severity="error" sx={{ mb: 2 }}>
                        <Typography variant="subtitle2" gutterBottom>
                          🔒 Blocked By:
                        </Typography>
                        {todo.blockedBy!.map((reason, i) => (
                          <Typography key={i} variant="body2">
                            • {reason}
                          </Typography>
                        ))}
                      </Alert>
                    )}

                    {/* What It Enables */}
                    <Paper sx={{ p: 2, mb: 2, bgcolor: 'success.light' }}>
                      <Typography 
                        variant="subtitle2" 
                        gutterBottom 
                        sx={{ display: 'flex', alignItems: 'center', gap: 1, color: 'success.contrastText' }}
                      >
                        <EnablesIcon fontSize="small" />
                        Completing This Will Enable:
                      </Typography>
                      {todo.whatItEnables.map((benefit, i) => (
                        <Box 
                          key={i} 
                          sx={{ 
                            display: 'flex', 
                            alignItems: 'center', 
                            gap: 1, 
                            mt: 1,
                            color: 'success.contrastText'
                        }}
                        >
                          <DoneIcon fontSize="small" />
                          <Typography variant="body2">{benefit}</Typography>
                        </Box>
                      ))}
                    </Paper>

                    {/* File Info */}
                    {todo.file && (
                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 1 }}>
                        <CodeIcon fontSize="small" color="action" />
                        <Typography variant="caption" color="text.secondary">
                          {todo.file}
                        </Typography>
                      </Box>
                    )}

                    {/* Line Counter (if in progress) */}
                    {todo.status === 'in_progress' && todo.estimatedLines && (
                      <Box sx={{ mt: 2 }}>
                        <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 1 }}>
                          <Typography variant="caption" color="text.secondary">
                            Writing code...
                          </Typography>
                          <Typography variant="caption" fontWeight="bold">
                            {todo.currentLines || 0} / {todo.estimatedLines} lines
                          </Typography>
                        </Box>
                        <LinearProgress 
                          variant="determinate" 
                          value={((todo.currentLines || 0) / todo.estimatedLines) * 100}
                          sx={{ height: 6, borderRadius: 1 }}
                        />
                      </Box>
                    )}
                  </Box>
                </Collapse>
              </Paper>
            );
        })}
        </List>

        {/* Summary */}
        {progress === 100 && (
          <Alert severity="success" sx={{ mt: 2 }}>
            <Typography variant="body2" fontWeight="bold">
              🎉 All tasks completed! Your integration is ready to use.
            </Typography>
          </Alert>
        )}
      </CardContent>
    </Card>
  );
};

export default AITodoTracker;

