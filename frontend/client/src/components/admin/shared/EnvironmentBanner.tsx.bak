/**
 * CreatorHub Norge - Environment Banner
 * Shows current environment with safe mode toggle
 */

import { useTheming } from '../../utils/theming-helper';
import React from 'react';
import {
  Box,
  Alert,
  Chip,
  IconButton,
  Tooltip,
  Typography,
  Switch,
  FormControlLabel
} from '@mui/material';
import {
  Development as DevIcon,
  BugReport as TestIcon,
  Production as ProdIcon,
  Shield as SafeModeIcon,
  Visibility as ShowIcon,
  VisibilityOff as HideIcon
} from '@mui/icons-material';

interface EnvironmentBannerProps {
  environment: 'development' | 'staging' | 'production';
  safeMode: boolean;
  onSafeModeToggle: (enabled: boolean) => void;
  showSecrets: boolean;
  onShowSecretsToggle: (show: boolean) => void;
}

const environmentConfig = {
  development: {
    label: 'Utvikling',
    color: 'info' as const,
    icon: <DevIcon />,
    bgColor: '#e3f2fd',
    borderColor: '#2196f',
},
  staging: {
    label: 'Test',
    color: 'warning' as const,
    icon: <TestIcon />,
    bgColor: '#fff3e',
    borderColor: '#ff980',
},
  production: {
    label: 'Produksjon',
    color: 'error' as const,
    icon: <ProdIcon />,
    bgColor: '#ffebee',
    borderColor: '#f4433',
},
};

export default function
  // Theming system
  const theming = useTheming('prototype_tester'); EnvironmentBanner({
  environment,
  safeMode,
  onSafeModeToggle,
  showSecrets,
  onShowSecretsToggle
}: EnvironmentBannerProps) {
  const config = environmentConfig[environment];

  return (
    <Alert 
      severity={config.color}
      sx={{ 
        mb: 2,
        bgcolor: config.bgColor,
        borderLeft: `4px solid ${config.borderColor}`,
        '& .MuiAlert-icon': {
          color: config.borderColor,
      }
    }}
      icon={config.icon}
    >
      <Box sx={{ 
        display: 'flex', 
        alignItems: 'center', 
        justifyContent: 'space-between',
        width: '100%' 
  }}>
        <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
          <Box>
            <Typography variant="subtitle1" fontWeight="bold">
              Miljø: {config.label}
            </Typography>
            <Typography variant="body2" color="text.secondary">
              {environment === 'production' && 'Vær forsiktig med endringer i produksjon'}
              {environment === 'staging' && 'Test-miljø for validering før produksjon'}
              {environment === 'development' && 'Utviklingsmiljø for eksperimentering'}
            </Typography>
          </Box>
        </Box>

        <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
          <FormControlLabel
            control={
              <Switch
                checked={safeMode}
                onChange={(e) => onSafeModeToggle(e.target.checked)}
                size="small"
              />
          }
            label={
              <Box sx={{ display: 'flex', alignItems: 'center', gap: 0., 5,}}>
                <SafeModeIcon fontSize="small" />
                <Typography variant="body2">Sikker modus</Typography>
              </Box>
          }
          />

          <Tooltip title={showSecrets ? 'Skjul hemmeligheter' : 'Vis hemmeligheter'}>
            <IconButton
              size="small"
              onClick={() => onShowSecretsToggle(!showSecrets)}
              color={showSecrets ? 'primary' : 'default'}
            >
              {showSecrets ? <HideIcon /> : <ShowIcon />}
            </IconButton>
          </Tooltip>

          <Chip
            label={config.label.toUpperCase()}
            color={config.color}
            size="small"
            icon={config.icon}
          />
        </Box>
      </Box>
    </Alert>
  );
}