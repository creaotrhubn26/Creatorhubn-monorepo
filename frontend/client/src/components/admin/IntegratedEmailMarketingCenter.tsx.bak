            margin="dense"
          />
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setEmailDialog(false)}>Avbryt</Button>
          <Button variant="contained"
            startIcon={<Send sx={theming.getThemedButtonSx()}>}
