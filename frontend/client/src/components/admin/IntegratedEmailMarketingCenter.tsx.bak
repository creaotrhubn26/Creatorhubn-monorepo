              background: 'linear-gradient(135deg, #FF8C00 0%, #FF6B00 100%)',
              '&:hover': { background: 'linear-gradient(135deg, #FF6B00 0%, #E55A00 100%)' }
          }}
          >
            Send E-post
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}