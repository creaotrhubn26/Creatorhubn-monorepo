import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect } from 'react';
import { useQuery } from '@tanstack/react-query';
import { useAuth } from '@/hooks/useAuth';
import {
  Box,
  Grid,
  Card,
  CardContent,
  Typography,
  Button,
  Tabs,
  Tab,
  Paper,
  Chip,
  Alert,
  CircularProgress,
  Switch,
  FormControlLabel,
  List,
  ListItem,
  ListItemText,
  ListItemIcon,
  IconButton,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  Badge,
  LinearProgress,
  Divider,
  Stack,
  CardHeader,
  FormControl,
  InputLabel,
  Select,
  MenuItem
} from '@mui/material';
import {
  Dashboard as DashboardIcon,
  Api as ApiIcon,
  Analytics as AnalyticsIcon,
  Settings as SettingsIcon,
  Science as TestTubeIcon,
  Storage as StorageIcon,
  Code as CodeIcon,
  Security as SecurityIcon,
  Monitor as MonitorIcon,
  BugReport as BugReportIcon,
  CheckCircle as CheckCircleIcon,
  Error as ErrorIcon,
  Warning as WarningIcon,
  Refresh as RefreshIcon,
  ExpandMore as ExpandMoreIcon,
  PlayArrow as PlayArrowIcon,
  Stop as StopIcon,
  CloudDone as CloudDoneIcon,
  Google as GoogleIcon,
  Assessment as AssessmentIcon,
  Build as BuildIcon,
  AutoFixHigh as AutoFixHighIcon,
  Visibility as VisibilityIcon,
  ContentCopy as ContentCopyIcon,
  Download as DownloadIcon,
  Share as ShareIcon,
  ShoppingCart as ShoppingCartIcon,
  Payment as PaymentIcon,
  LocalShipping as LocalShippingIcon,
  Insights as InsightsIcon,
  Brush as BrushIcon,
  MusicNote as MusicNoteIcon,
  Web as WebIcon,
  Lightbulb as LightbulbIcon
} from '@mui/icons-material';
import { apiRequest } from '@/lib/queryClient';

interface TabPanelProps {
  children?: React.ReactNode;
  index: number;
  value: number
}

function TabPanel(props: TabPanelProps) {
  const { children, value, index, ...other } = props;
  return (
    <div
      role="tabpanel"
      hidden={value !== index}
      id={`admin-tabpanel-${index}`}
      aria-labelledby={`admin-tab-${index}`}
      {...other}
    >
      {value === index && <Box sx={{ p:  3 }}>{children}</Box>}
    </div>
  );
}

interface APIStatus {
  service: string;
  success: boolean;
  data?: any;
  error?: string
}

interface GoogleAPIResults {
  user: string;
  total_scopes: number;
  total_tests: number;
  successful_apis: number;
  failed_apis: number;
  success_rate: string;
  results: APIStatus[]
}

export default function VisualCMSAdminDashboard() {
  const [tabValue, setTabValue] = useState(0);
  const [mockServersActive, setMockServersActive] = useState(false);
  const [testRunning, setTestRunning] = useState(false);
  const [codeGeneratorOpen, setCodeGeneratorOpen] = useState(false);
  const [selectedCategory, setSelectedCategory] = useState('');
  const [selectedLanguage, setSelectedLanguage] = useState('javascript');
  const [generatedCode, setGeneratedCode] = useState('');
  const [codeQualityScores, setCodeQualityScores] = useState({
    performance:  0,
    security:  0,
    maintainability: 0
});
  const queryClient = useQueryClient();
  
  // Theming system
  const theming = useTheming('prototype_tester');

  // Fetch Google API status
  const { data: googleStatus, isLoading: statusLoading, refetch: refetchStatus } = useQuery({
    queryKey: ['/api/simple-oauth/test-all-apis, '],
    queryFn: async () => {
      return apiRequest('/api/simple-oauth/test-all-apis', {
        headers: auth
  });
  },
    refetchInterval: 30000 // Auto-refresh every 30 seconds
});

  // Fetch API integration health
  const { data: apiHealth, isLoading: healthLoading } = useQuery({
    queryKey: ['/api/admin/integration-health, '],
    queryFn: async () => {
      return apiRequest('/api/admin/integration-health', {
        headers: auth
  });
  },
    enabled: false // Will enable when we create this endpoint
});

  const handleTabChange = (event: React.SyntheticEvent, newValue: number) => {
    setTabValue(newValue);
};

  const runComprehensiveTest = useMutation({
    mutationFn: async () => {
      setTestRunning(true);
      const result = await apiRequest('POS', '/api/admin/run-comprehensive-tests');
      return result;
  },
    onSuccess: () => {
      queryClient.invalidateQueries();
      setTestRunning(false);
},
    onError: () => {
      setTestRunning(false);
}
});

  const toggleMockServers = useMutation({
    mutationFn: async (enabled: boolean) => {
      const result = await apiRequest('POS', '/api/admin/mock-servers', { enabled });
      return result;
  },
    onSuccess: (data) => {
      setMockServersActive(data.enabled);
}
});

  const generateCodeMutation = useMutation({
    mutationFn: async (params: {
      category: string;
      language: string;
      apiService: string;
      functionality: string[];
      includeErrorHandling: boolean;
      includeAuth: boolean;
      includeMockTesting: boolean;
}) => {
      const response = await apiRequest('POST', '/api/admin/code-generator/generate', params);
      const data = await response.json();
      return data;
  },
    onSuccess: (data) => {
      if (data.success) {
        setGeneratedCode(data.code.mainCode);
        setCodeQualityScores({
          performance: data.code.performance_score,
          security: data.code.security_score,
          maintainability: data.code.maintainability_score
    });
        setCodeGeneratorOpen(true);
    }
  }
});

  // Fetch code generator categories
  const { data: codeCategories } = useQuery({
    queryKey: ['/api/admin/code-generator/categories, '],
    staleTime: 30000,
    queryFn: async () => {
      return apiRequest('/api/admin/code-generator/categories', {
        headers: auth
  });
  },
});

  const handleGenerateCode = () => {
    if (!selectedCategory) return;
    
    generateCodeMutation.mutate({
      category: selectedCategory,
      language: selectedLanguage,
      apiService: selectedCategory,
      functionality: ['basic-integration', 'error-handling', 'authentication'],
      includeErrorHandling: true,
      includeAuth: true,
      includeMockTesting: mockServersActive
});
};

  const getStatusIcon = (success: boolean) => {
    return success ? (
      <CheckCircleIcon color="success" />
    ) : (
      <ErrorIcon color="error" />
    );
};

  const getSuccessRate = (results: APIStatus[]) => {
    if (!results || results.length === 0) return 0;
    const successful = results.filter(r => r.success).length;
    return Math.round((successful / results.length) * 100);
};

  return (
    <Box sx={{ width: '100, %, ', bgcolor: 'background.default', minHeight: '100vh', p:  3 }}>
      {/* Header */}
      <Paper elevation={2} sx={{ p:  3, mb: 3, background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' }} sx={theming.getThemedCardSx()}>
        <Typography variant="h4" sx={{ color: 'white', fontWeight: 'bold', mb: 1 }} sx={{ ...{}, color: theming.colors.primary }}>
          Visual CMS Admin Dashboard
        </Typography>
        <Typography variant="subtitle1" sx={{ color: 'white', opacity: 0., 9,}}>
          Complete API Integration Management & Testing Infrastructure
        </Typography>
        <Box sx={{ mt: ,  2display: 'flex', gap:  2 }}>
          <Chip 
            icon={<GoogleIcon />}
            label={`Google APIs: ${googleStatus?.success_rate || '0, %, '}`}
            color={googleStatus?.success_rate === '100%' ? 'success' : 'warning'}
            sx={{ color: 'white, ',}}
          />
          <Chip 
            icon={<ApiIcon />}
            label={`Services: ${googleStatus?.total_tests ||,  , 0}`}
            color="primary"
            sx={{ color: 'white, ',}}
          />
          <Chip 
            icon={<TestTubeIcon />}
            label={mockServersActive ? 'WireMock Active' : 'WireMock Inactive'}
            color={mockServersActive ? 'success' : 'default'}
            sx={{ color: 'white, ',}}
          />
        </Box>
      </Paper>

      {/* Tabs */}
      <Paper elevation={1} sx={{ mb: 3 }} sx={theming.getThemedCardSx()}>
        <Tabs 
          value={tabValue}
          onChange={handleTabChange}
          sx={{ borderBottom:  ,  1borderColor: 'divider, ',}}
          variant="scrollable"
          scrollButtons="auto"
        >
          <Tab icon={<DashboardIcon />} label="Overview" />
          <Tab icon={<GoogleIcon />} label="Google APIs" />
          <Tab icon={<TestTubeIcon />} label="WireMock Testing" />
          <Tab icon={<CodeIcon />} label="Code Generator" />
          <Tab icon={<StorageIcon />} label="Database Status" />
          <Tab icon={<MonitorIcon />} label="System Monitor" />
          <Tab icon={<SettingsIcon />} label="Configuration" />
        </Tabs>
      </Paper>

      {/* Tab Content */}
      
      {/* Overview Tab */}
      <TabPanel value={tabValue} index={0}>
        <Grid container spacing={3}>
          {/* Google API Status Card */}
          <Grid size={{ xs: 1, 2,}} md={6}>
            <Card elevation={2} sx={theming.getThemedCardSx()}>
              <CardContent sx={theming.getThemedCardSx()}>
                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                  <GoogleIcon color="primary" />
                  Google API Integration
                </Typography>
                {statusLoading ? (
                  <CircularProgress size={24} />
                ) : (
                  <>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap:  ,  2mb: 2 }}>
                      <Typography variant="h3" color="primary" sx={{ ...{}, color: theming.colors.primary }}>
                        {googleStatus?.success_rate || '0%'}
                      </Typography>
                      <Box>
                        <Typography variant="body2" color="text.secondary">
                          Success Rate
                        </Typography>
                        <Typography variant="body2">
                          {googleStatus?.successful_apis || 0}/{googleStatus?.total_tests || 0} APIs
                        </Typography>
                      </Box>
                    </Box>
                    <LinearProgress 
                      variant="determinate" 
                      value={getSuccessRate(googleStatus?.results || [])}
                      sx={{ mb: 1 }}
                    />
                    <Button 
                      variant="outlined" 
                      size="small" 
                      onClick={() => refetchStatus()}
                      startIcon={<RefreshIcon />}
                    >
                      Refresh Status
                    </Button>
                  </>
                )}
              </CardContent>
            </Card>
          </Grid>

          {/* System Health Card */}
          <Grid size={{ xs: 1, 2,}} md={6}>
            <Card elevation={2} sx={theming.getThemedCardSx()}>
              <CardContent sx={theming.getThemedCardSx()}>
                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                  <MonitorIcon color="success" />
                  System Health
                </Typography>
                <List dense>
                  <ListItem>
                    <ListItemIcon>
                      <CheckCircleIcon color="success" />
                    </ListItemIcon>
                    <ListItemText primary="PostgreSQL Database" secondary="Connected and operational" />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <CheckCircleIcon color="success" />
                    </ListItemIcon>
                    <ListItemText primary="OAuth Authentication" secondary="100% functional" />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <CheckCircleIcon color="success" />
                    </ListItemIcon>
                    <ListItemText primary="WebSocket Server" secondary="Real-time communication active" />
                  </ListItem>
                </List>
              </CardContent>
            </Card>
          </Grid>

          {/* Quick Actions */}
          <Grid size={{ xs: 1, 2,}}>
            <Card elevation={2} sx={theming.getThemedCardSx()}>
              <CardContent sx={theming.getThemedCardSx()}>
                <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                  Quick Actions
                </Typography>
                <Stack direction="row" spacing={2} flexWrap="wrap">
                  <Button variant="contained" 
                    startIcon={<PlayArrowIcon sx={theming.getThemedButtonSx()}>}
                    onClick={() => runComprehensiveTest.mutate()}
                    disabled={testRunning}
                  >
                    {testRunning ? 'Running Tests...' : 'Run All Tests'}
                  </Button>
                  <Button 
                    variant="outlined" 
                    startIcon={<TestTubeIcon />}
                    onClick={() => toggleMockServers.mutate(!mockServersActive)}
                  >
                    {mockServersActive ? 'Stop WireMock' : 'Start WireMock'}
                  </Button>
                  <Button 
                    variant="outlined" 
                    startIcon={<CodeIcon />}
                  >
                    Generate API Code
                  </Button>
                  <Button 
                    variant="outlined" 
                    startIcon={<AssessmentIcon />}
                  >
                    View Analytics
                  </Button>
                </Stack>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </TabPanel>

      {/* Google APIs Tab */}
      <TabPanel value={tabValue} index={1}>
        <Grid container spacing={3}>
          <Grid size={{ xs: 1, 2,}}>
            <Alert severity="success" sx={{ mb: 3 }}>
              <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>Google API Integration: 100% Operational</Typography>
              All Google services are connected and functioning. OAuth configuration verified with project 256648631702.
            </Alert>
          </Grid>

          {statusLoading ? (
            <Grid size={{ xs: 1, 2,}}>
              <Box sx={{ display: 'flex', justifyContent: 'center', p:  4 }}>
                <CircularProgress />
              </Box>
            </Grid>
          ) : (
            <Grid size={{ xs: 1, 2,}}>
              <TableContainer component={Paper} elevation={2}>
                <Table>
                  <TableHead>
                    <TableRow>
                      <TableCell>Service</TableCell>
                      <TableCell>Status</TableCell>
                      <TableCell>Data</TableCell>
                      <TableCell>Actions</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {googleStatus?.results?.map((api: APIStatus, index: number) => (
                      <TableRow key={index}>
                        <TableCell>
                          <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                            {getStatusIcon(api.success)}
                            {api.service}
                          </Box>
                        </TableCell>
                        <TableCell>
                          <Chip 
                            label={api.success ? 'Connected' : 'Error'}
                            color={api.success ? 'success' : 'error'}
                            size="small"
                          />
                        </TableCell>
                        <TableCell>
                          {api.success ? (
                            <Typography variant="body2" color="text.secondary">
                              {api.data || 'Connected successfully'}
                            </Typography>
                          ) : (
                            <Typography variant="body2" color="error">
                              {api.error || 'Connection failed'}
                            </Typography>
                          )}
                        </TableCell>
                        <TableCell>
                          <Button size="small" variant="outlined">
                            Test
                          </Button>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
            </Grid>
          )}
        </Grid>
      </TabPanel>

      {/* WireMock Testing Tab */}
      <TabPanel value={tabValue} index={2}>
        <Grid container spacing={3}>
          <Grid size={{ xs: 1, 2,}}>
            <Card elevation={2} sx={theming.getThemedCardSx()}>
              <CardContent sx={theming.getThemedCardSx()}>
                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                  <TestTubeIcon />
                  WireMock Testing Infrastructure
                </Typography>
                <Typography variant="body2" color="text.secondary" paragraph>
                  Comprehensive API mocking and testing infrastructure for 100+ services integration coverage.
                </Typography>
                
                <Box sx={{ display: 'flex', gap:  ,  2mb: 3 }}>
                  <FormControlLabel
                    control={
                      <Switch 
                        checked={mockServersActive}
                        onChange={(e) => toggleMockServers.mutate(e.target.checked)}
                      />
                  }
                    label="Enable All WireMock Servers"
                  />
                  <Button 
                    variant="outlined" 
                    startIcon={<PlayArrowIcon />}
                    onClick={() => runComprehensiveTest.mutate()}
                    disabled={testRunning || !mockServersActive}
                  >
                    {testRunning ? 'Running Tests...' : 'Run API Tests'}
                  </Button>
                </Box>

                <Divider sx={{ my:  2 }} />

                <Typography variant="subtitle1" gutterBottom>
                  Mock Server Categories: </Typography>
                <Grid container spacing=, {, 2}>
                  {[
                    { name: 'Google Services', endpoints:  24, port: 800, status: mockServersActive },
                    { name: 'Social Media', endpoints:  18, port: 801, status: mockServersActive },
                    { name: 'E-commerce', endpoints:  31, port: 802, status: mockServersActive },
                    { name: 'Payment Processing', endpoints:  28, port: 803, status: mockServersActive },
                    { name: 'Shipping Services', endpoints:  22, port: 804, status: mockServersActive },
                    { name: 'Analytics Tools', endpoints:  35, port: 805, status: mockServersActive },
                    { name: 'Creative Software', endpoints:  41, port: 806, status: mockServersActive },
                    { name: 'Music/Audio', endpoints:  41, port: 807, status: mockServersActive }
                  ].map((server, index) => (
                    <Grid size={{ xs: 1, 2,}} sm={6} md={3} key={index}>
                      <Card variant="outlined" sx={{ p:  2 }} sx={theming.getThemedCardSx()}>
                        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 1 }}>
                          <Typography variant="subtitle2">{server.name}</Typography>
                          <Chip 
                            label={server.status ? 'Running' : 'Stopped'}
                            color={server.status ? 'success' : 'default'}
                            size="small"
                          />
                        </Box>
                        <Typography variant="body2" color="text.secondary">
                          Port: {server.port}
                        </Typography>
                        <Typography variant="body2" color="text.secondary">
                          Endpoints: {server.endpoints}
                        </Typography>
                        <Box sx={{ mt: 1 }}>
                          <Button size="small" variant="text">
                            Test
                          </Button>
                        </Box>
                      </Card>
                    </Grid>
                  ))}
                </Grid>

                <Divider sx={{ my:  3 }} />

                <Typography variant="subtitle1" gutterBottom>
                  Testing Coverage: </Typography>
                <Box sx={{ mb: 2 }}>
                  <Typography variant="body2" color="text.secondary">
                    Total Endpoints: 247 | Mock Servers: 8 | Coverage: 97.2%
                  </Typography>
                  <LinearProgress 
                    variant="determinate" 
                    value={97.2}
                    sx={{ mt: 1 }}
                  />
                </Box>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </TabPanel>

      {/* Enhanced Code Generator Tab */}
      <TabPanel value={tabValue} index={3}>
        <Typography variant="h5" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
          AI-Drevet Code Generator
        </Typography>
        <Typography variant="body2" color="text.secondary" paragraph>
          Generer profesjonell kode for alle API-integrasjoner med intelligent template system
        </Typography>
        
        <Grid container spacing={3}>
          {/* Code Generation Controls */}
          <Grid size={{ xs: 1, 2,}} md={4}>
            <Card sx={theming.getThemedCardSx()}>
              <CardHeader title="Code Generation"
                subheader="Velg API kategori og språk"
                avatar={<AutoFixHighIcon color="primary" sx={theming.getThemedCardSx()}>}
              />
              <CardContent sx={theming.getThemedCardSx()}>
                <Stack spacing={3}>
                  {/* Category Selection */}
                  <FormControl fullWidth>
                    <InputLabel>API Kategori</InputLabel>
                    <Select
                      value={selectedCategory}
                      onChange={(e) => setSelectedCategory(e.target.value)}
                      label="API Kategori"
                    >
                      {codeCategories?.categories.map((cat: any) => (
                        <MenuItem key={cat.name} value={cat.name}>
                          <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                            {cat.name === 'Google Services' && <GoogleIcon fontSize="small" />}
                            {cat.name === 'Social Media' && <ShareIcon fontSize="small" />}
                            {cat.name === 'E-commerce' && <ShoppingCartIcon fontSize="small" />}
                            {cat.name === 'Payment Processing' && <PaymentIcon fontSize="small" />}
                            {cat.name === 'Shipping Services' && <LocalShippingIcon fontSize="small" />}
                            {cat.name === 'Analytics Tools' && <InsightsIcon fontSize="small" />}
                            {cat.name === 'Creative Software' && <BrushIcon fontSize="small" />}
                            {cat.name === 'Music/Audio Services' && <MusicNoteIcon fontSize="small" />}
                            <Box>
                              <Typography variant="body2" fontWeight="medium">{cat.name}</Typography>
                              <Typography variant="caption" color="text.secondary">
                                {cat.count} endpoints • Port {cat.mockPort}
                              </Typography>
                            </Box>
                          </Box>
                        </MenuItem>
                      ))}
                    </Select>
                  </FormControl>

                  {/* Language Selection */}
                  <FormControl fullWidth>
                    <InputLabel>Programmeringsspråk</InputLabel>
                    <Select
                      value={selectedLanguage}
                      onChange={(e) => setSelectedLanguage(e.target.value)}
                      label="Programmeringsspråk"
                    >
                      <MenuItem value="javascript">
                        <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                          <CodeIcon fontSize="small" />
                          JavaScript
                        </Box>
                      </MenuItem>
                      <MenuItem value="typescript">
                        <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                          <CodeIcon fontSize="small" />
                          TypeScript
                        </Box>
                      </MenuItem>
                      <MenuItem value="python">
                        <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                          <CodeIcon fontSize="small" />
                          Python
                        </Box>
                      </MenuItem>
                      <MenuItem value="react">
                        <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                          <WebIcon fontSize="small" />
                          React/JSX
                        </Box>
                      </MenuItem>
                      <MenuItem value="node">
                        <Box sx={{ display: 'flex', alignItems: 'center', gap:  1 }}>
                          <StorageIcon fontSize="small" />
                          Node.js
                        </Box>
                      </MenuItem>
                    </Select>
                  </FormControl>

                  {/* Generation Options */}
                  <Divider />
                  <Typography variant="subtitle2" color="primary">
                    Genereringsalternativer
                  </Typography>
                  
                  <FormControlLabel
                    control={<Switch defaultChecked />}
                    label="Inkluder error handling"
                  />
                  <FormControlLabel
                    control={<Switch defaultChecked />}
                    label="Inkluder authentication"
                  />
                  <FormControlLabel
                    control={<Switch checked={mockServersActive} disabled />}
                    label="WireMock testing integration"
                  />

                  {/* Generate Button */}
                  <Button variant="contained"
                    size="large"
                    onClick={handleGenerateCode}
                    disabled={!selectedCategory || generateCodeMutation.isPending}
                    startIcon={generateCodeMutation.isPending ? <CircularProgress size={20} sx={theming.getThemedButtonSx()}> : <AutoFixHighIcon />}
                    sx={{ mt: 2 }}
                  >
                    {generateCodeMutation.isPending ? 'Genererer...' : 'Generer Kode'}
                  </Button>
                </Stack>
              </CardContent>
            </Card>

            {/* Quality Scores */}
            {(codeQualityScores.performance > 0) && (
              <Card sx={{ mt: 2 }} sx={theming.getThemedCardSx()}>
                <CardHeader title="Code Quality Scores"
                  subheader="AI-vurdert kodekvalitet"
                  avatar={<CheckCircleIcon color="success" sx={theming.getThemedCardSx()}>}
                />
                <CardContent sx={theming.getThemedCardSx()}>
                  <Stack spacing={2}>
                    <Box>
                      <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 1 }}>
                        <Typography variant="body2">Performance</Typography>
                        <Typography variant="body2" fontWeight="bold" color="primary">
                          {codeQualityScores.performance}%
                        </Typography>
                      </Box>
                      <LinearProgress 
                        variant="determinate" 
                        value={codeQualityScores.performance}
                        color={codeQualityScores.performance >= 80 ? 'success' : 'warning'}
                      />
                    </Box>
                    
                    <Box>
                      <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 1 }}>
                        <Typography variant="body2">Security</Typography>
                        <Typography variant="body2" fontWeight="bold" color="primary">
                          {codeQualityScores.security}%
                        </Typography>
                      </Box>
                      <LinearProgress 
                        variant="determinate" 
                        value={codeQualityScores.security}
                        color={codeQualityScores.security >= 80 ? 'success' : 'warning'}
                      />
                    </Box>
                    
                    <Box>
                      <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 1 }}>
                        <Typography variant="body2">Maintainability</Typography>
                        <Typography variant="body2" fontWeight="bold" color="primary">
                          {codeQualityScores.maintainability}%
                        </Typography>
                      </Box>
                      <LinearProgress 
                        variant="determinate" 
                        value={codeQualityScores.maintainability}
                        color={codeQualityScores.maintainability >= 80 ? 'success' : 'warning'}
                      />
                    </Box>
                  </Stack>
                </CardContent>
              </Card>
            )}
          </Grid>

          {/* Live Code Preview */}
          <Grid size={{ xs: 1, 2,}} md={8}>
            <Card sx={{ height: '600px, ',}} sx={theming.getThemedCardSx()}>
              <CardHeader title="Live Code Preview"
                subheader={`${selectedLanguage.toUpperCase()} • ${selectedCategory || 'Velg kategori'}`}
                avatar={<VisibilityIcon color="primary" sx={theming.getThemedCardSx()}>}
                action={
                  generatedCode && (
                    <Stack direction="row" spacing={1}>
                      <IconButton 
                        onClick={() => navigator.clipboard.writeText(generatedCode)}
                        title="Kopier kode"
                      >
                        <ContentCopyIcon />
                      </IconButton>
                      <IconButton 
                        onClick={() => {
                          const blob = new Blob([generatedCode], { type: 'text/plain, ',});
                          const url = URL.createObjectURL(blob);
                          const a = document.createElement('a');
                          a.href = url;
                          a.download = `${selectedCategory?.toLowerCase().replace(/\s+/g, '-')}-integration.${selectedLanguage === 'typescript' ? 'ts' : 'js'}`;
                          a.click();
                          URL.revokeObjectURL(url);
                      }}
                        title="Last ned fil"
                      >
                        <DownloadIcon />
                      </IconButton>
                    </Stack>
                  )
              }
              />
              <CardContent sx={{ height: 'calc(100% - 80px, ), ', p:  0 }} sx={theming.getThemedCardSx()}>
                {generatedCode ? (
                  <MonacoEditor
                    height="100%"
                    language={selectedLanguage === 'react' ? 'javascript' : selectedLanguage}
                    value={generatedCode}
                    theme="vs-dark"
                    options={{
                      readOnly: true,
                      minimap: { enabled: true },
                      fontSize:  14,
                      lineNumbers: 'on',
                      roundedSelection: false,
                      scrollBeyondLastLine: false,
                      automaticLayout: true,
                      wordWrap: 'on'
                }}
                  />
                ) : (
                  <Box sx={{ 
                    height: '100, %, ', 
                    display: 'flex', 
                    alignItems: 'center', 
                    justifyContent: 'center',
                    flexDirection: 'column',
                    gap:  2,
                    color: 'text.secondary'
              }}>
                    <CodeIcon sx={{ fontSize: 4, 8,}} />
                    <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>
                      Velg kategori og klikk "Generer Kode"
                    </Typography>
                    <Typography variant="body2">
                      AI-generert kode vil vises her med syntax highlighting
                    </Typography>
                  </Box>
                )}
              </CardContent>
            </Card>
          </Grid>
        </Grid>

        {/* Category Overview */}
        {codeCategories && (
          <Card sx={{ mt: 3 }} sx={theming.getThemedCardSx()}>
            <CardHeader title="Tilgjengelige API Kategorier"
              subheader={`${codeCategories.total_endpoints} total endpoints på tvers av ${codeCategories.categories.length} kategorier`}
              avatar={<LightbulbIcon color="primary" sx={theming.getThemedCardSx()}>}
            />
            <CardContent sx={theming.getThemedCardSx()}>
              <Grid container spacing={2}>
                {codeCategories.categories.map((category: any) => (
                  <Grid size={{ xs: 1, 2,}} sm={6} md={3} key={category.name}>
                    <Card 
                      variant="outlined" 
                      sx={{ 
                        cursor: 'pointer',
                        transition: 'all 0.2',
                        '&:hover': { 
                          boxShadow:  2,
                          transform: 'translateY(-2px)'
                    },
                        border: selectedCategory === category.name ? 2 :,  , 1,
                        borderColor: selectedCategory === category.name ? 'primary.main' : 'divider'
                  }}
                      onClick={() = sx={theming.getThemedCardSx()}> setSelectedCategory(category.name)}
                    >
                      <CardContent sx={{ textAlign: 'center', py: 2 }} sx={theming.getThemedCardSx()}>
                        <Typography variant="h6" gutterBottom noWrap sx={{ ...{}, color: theming.colors.primary }}>
                          {category.name}
                        </Typography>
                        <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                          {category.description}
                        </Typography>
                        <Chip 
                          label={`${category.count} endpoints`}
                          size="small"
                          color="primary"
                          variant="outlined"
                        />
                        <Typography variant="caption" display="block" sx={{ mt: 1 }}>
                          Mock: Port {category.mockPort}
                        </Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                ))}
              </Grid>
            </CardContent>
          </Card>
        )}
      </TabPanel>

      {/* Database Status Tab */}
      <TabPanel value={tabValue} index={4}>
        <Grid container spacing={3}>
          <Grid size={{ xs: 1, 2,}}>
            <Card elevation={2} sx={theming.getThemedCardSx()}>
              <CardContent sx={theming.getThemedCardSx()}>
                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                  <StorageIcon />
                  PostgreSQL Database Status
                </Typography>
                <Alert severity="success">
                  Database connection established and operational. Zero mock data policy enforced.
                </Alert>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </TabPanel>

      {/* System Monitor Tab */}
      <TabPanel value={tabValue} index={5}>
        <Grid container spacing={3}>
          <Grid size={{ xs: 1, 2,}}>
            <Card elevation={2} sx={theming.getThemedCardSx()}>
              <CardContent sx={theming.getThemedCardSx()}>
                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                  <MonitorIcon />
                  System Performance Monitor
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Real-time monitoring of system resources and API performance.
                </Typography>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </TabPanel>

      {/* Configuration Tab */}
      <TabPanel value={tabValue} index={6}>
        <Grid container spacing={3}>
          <Grid size={{ xs: 1, 2,}}>
            <Card elevation={2} sx={theming.getThemedCardSx()}>
              <CardContent sx={theming.getThemedCardSx()}>
                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                  <SettingsIcon />
                  System Configuration
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Configure API endpoints, authentication, and system settings.
                </Typography>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </TabPanel>
    </Box>
  );
}