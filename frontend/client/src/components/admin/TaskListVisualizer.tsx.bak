      canProceed: true,
      isBlocker: true,
      startTime: new Date(Date.now() - 145 * 60000).toISOString, (, ),
      endTime: new Date(Date.now() - 93 * 60000).toISOString, (, ),
      checks: [
        {
          id: 'schema-validation',
          name: 'Schema Validering',
