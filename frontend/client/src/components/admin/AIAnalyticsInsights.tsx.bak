/**
 * AI Analytics Insights Component
 * Displays AI-powered insights, predictions, and recommendations
 */

import React, { useState } from 'react';
import { useQuery } from '@tanstack/react-query';
import { apiRequest } from '../../lib/queryClient';
import {
  Box,
  Card,
  CardContent,
  Typography,
  Grid,
  Chip,
  Button,
  Alert,
  LinearProgress,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Divider,
  Badge,
  IconButton,
  Tooltip
} from '@mui/material';
import {
  TrendingUp,
  TrendingDown,
  Warning,
  Info,
  Lightbulb,
  Psychology,
  Analytics,
  Refresh,
  ExpandMore,
  CheckCircle,
  Error,
  Report,
  Timeline,
  AutoAwesome,
  Insights
} from '@mui/icons-material';

interface AIInsight {
  type: 'anomaly' | 'trend' | 'prediction' | 'recommendation';
  severity: 'low' | 'medium' | 'high' | 'critical';
  title: string;
  description: string;
  impact: string;
  recommendation: string;
  confidence: number;
  timestamp: string;
  metrics: {
    metric: string;
    current: number;
    previous: number;
    change: number;
  }[];
}

interface PredictionData {
  metric: string;
  currentValue: number;
  predictedValue: number;
  confidence: number;
  timeframe: string;
  factors: string[];
}

interface AIAnalyticsInsightsProps {
  dateRange?: string;
  autoRefresh?: boolean;
}

export default function AIAnalyticsInsights({ 
  dateRange = '30daysAgo', 
  autoRefresh = true 
}: AIAnalyticsInsightsProps) {
  const [expandedInsight, setExpandedInsight] = useState<string | false>(false);

  // AI Insights Query
  const { data: insightsData, refetch: refetchInsights, isLoading: insightsLoading } = useQuery({
    queryKey: ['/api/ai/analytics/insights', dateRange],
    queryFn: () => apiRequest(`/api/ai/analytics/insights?startDate=${dateRange}&endDate=today`),
    refetchInterval: autoRefresh ? 300000 : false, // 5 minutes
    staleTime: 0
  });

  // Predictions Query
  const { data: predictionsData, isLoading: predictionsLoading } = useQuery({
    queryKey: ['/api/ai/analytics/predictions', dateRange],
    queryFn: () => apiRequest(`/api/ai/analytics/predictions?startDate=${dateRange}&endDate=today`),
    refetchInterval: autoRefresh ? 600000 : false, // 10 minutes
    staleTime: 0
  });

  // Report Query
  const { data: reportData, isLoading: reportLoading } = useQuery({
    queryKey: ['/api/ai/analytics/report', dateRange],
    queryFn: () => apiRequest(`/api/ai/analytics/report?startDate=${dateRange}&endDate=today`),
    refetchInterval: autoRefresh ? 900000 : false, // 15 minutes
    staleTime: 0
  });

  const handleRefresh = () => {
    refetchInsights();
  };

  const getSeverityColor = (severity: string) => {
    switch (severity) {
      case 'critical': return '#f44336';
      case 'high': return '#ff9800';
      case 'medium': return '#2196f3';
      case 'low': return '#4caf50';
      default: return '#9e9e9e';
    }
  };

  const getSeverityIcon = (severity: string) => {
    switch (severity) {
      case 'critical': return <Error />;
      case 'high': return <Warning />;
      case 'medium': return <Info />;
      case 'low': return <CheckCircle />;
      default: return <Info />;
    }
  };

  const getTypeIcon = (type: string) => {
    switch (type) {
      case 'anomaly': return <Warning />;
      case 'trend': return <TrendingUp />;
      case 'prediction': return <Psychology />;
      case 'recommendation': return <Lightbulb />;
      default: return <Analytics />;
    }
  };

  const insights: AIInsight[] = insightsData?.data?.insights || [];
  const predictions: PredictionData[] = predictionsData?.data?.predictions || [];
  const report = reportData?.data?.report;

  return (
    <Box sx={{ mb: 4 }}>
      {/* Header */}
      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
        <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
          <AutoAwesome sx={{ color: '#ff6b35', fontSize: 32 }} />
          <Box>
            <Typography variant="h5" sx={{ fontWeight: 700, color: '#ffffff' }}>
              AI Analytics Insights
            </Typography>
            <Typography variant="body2" sx={{ color: '#ffa726' }}>
              Intelligent analysis and predictions powered by AI
            </Typography>
          </Box>
        </Box>
        <Button
          variant="contained"
          startIcon={<Refresh />}
          onClick={handleRefresh}
          disabled={insightsLoading}
          sx={{ 
            background: 'linear-gradient(135deg, #ff6b35 0%, #ffa726 100%)',
            '&:hover': { background: '#ff6b35' }
          }}
        >
          Refresh AI
        </Button>
      </Box>

      {/* Summary Cards */}
      {insightsData?.data?.summary && (
        <Grid container spacing={2} sx={{ mb: 4 }}>
          <Grid item xs={12} sm={6} md={3}>
            <Card sx={{ background: '#2d2d2d', border: '1px solid #404040' }}>
              <CardContent sx={{ textAlign: 'center', p: 2 }}>
                <Typography variant="h4" sx={{ color: '#ffffff', fontWeight: 'bold' }}>
                  {insightsData.data.summary.total}
                </Typography>
                <Typography variant="caption" sx={{ color: '#ffa726' }}>
                  Total Insights
                </Typography>
              </CardContent>
            </Card>
          </Grid>
          <Grid item xs={12} sm={6} md={3}>
            <Card sx={{ background: '#2d2d2d', border: '1px solid #404040' }}>
              <CardContent sx={{ textAlign: 'center', p: 2 }}>
                <Typography variant="h4" sx={{ color: '#f44336', fontWeight: 'bold' }}>
                  {insightsData.data.summary.critical}
                </Typography>
                <Typography variant="caption" sx={{ color: '#ffa726' }}>
                  Critical Issues
                </Typography>
              </CardContent>
            </Card>
          </Grid>
          <Grid item xs={12} sm={6} md={3}>
            <Card sx={{ background: '#2d2d2d', border: '1px solid #404040' }}>
              <CardContent sx={{ textAlign: 'center', p: 2 }}>
                <Typography variant="h4" sx={{ color: '#ff9800', fontWeight: 'bold' }}>
                  {insightsData.data.summary.high}
                </Typography>
                <Typography variant="caption" sx={{ color: '#ffa726' }}>
                  High Priority
                </Typography>
              </CardContent>
            </Card>
          </Grid>
          <Grid item xs={12} sm={6} md={3}>
            <Card sx={{ background: '#2d2d2d', border: '1px solid #404040' }}>
              <CardContent sx={{ textAlign: 'center', p: 2 }}>
                <Typography variant="h4" sx={{ color: '#4caf50', fontWeight: 'bold' }}>
                  {predictions.length}
                </Typography>
                <Typography variant="caption" sx={{ color: '#ffa726' }}>
                  Predictions
                </Typography>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      )}

      {/* AI Insights */}
      <Card sx={{ background: '#2d2d2d', border: '1px solid #404040', mb: 3 }}>
        <CardContent>
          <Typography variant="h6" sx={{ 
            fontWeight: 600, 
            color: '#ffffff',
            mb: 3,
            display: 'flex',
            alignItems: 'center',
            gap: 1
          }}>
            <Insights sx={{ color: '#ff6b35' }} />
            AI Insights & Recommendations
          </Typography>

          {insightsLoading ? (
            <Box sx={{ p: 3 }}>
              <LinearProgress sx={{ mb: 2 }} />
              <Typography variant="body2" sx={{ color: '#ffa726' }}>
                AI is analyzing your data...
              </Typography>
            </Box>
          ) : insights.length === 0 ? (
            <Alert severity="info" sx={{ backgroundColor: '#2d2d2d', color: '#ffffff' }}>
              No insights generated. Try refreshing or check back later.
            </Alert>
          ) : (
            <Box>
              {insights.map((insight, index) => (
                <Accordion
                  key={index}
                  expanded={expandedInsight === `insight-${index}`}
                  onChange={(_, isExpanded) => setExpandedInsight(isExpanded ? `insight-${index}` : false)}
                  sx={{ 
                    backgroundColor: '#1a1a1a',
                    border: '1px solid #404040',
                    mb: 1,
                    '&:before': { display: 'none' }
                  }}
                >
                  <AccordionSummary
                    expandIcon={<ExpandMore sx={{ color: '#ffa726' }} />}
                    sx={{ minHeight: 56 }}
                  >
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, width: '100%' }}>
                      <Badge
                        badgeContent={insight.confidence}
                        color="primary"
                        sx={{ '& .MuiBadge-badge': { backgroundColor: getSeverityColor(insight.severity) } }}
                      >
                        {getSeverityIcon(insight.severity)}
                      </Badge>
                      <Box sx={{ flex: 1 }}>
                        <Typography variant="subtitle1" sx={{ color: '#ffffff', fontWeight: 600 }}>
                          {insight.title}
                        </Typography>
                        <Typography variant="body2" sx={{ color: '#ffa726' }}>
                          {insight.description}
                        </Typography>
                      </Box>
                      <Box sx={{ display: 'flex', gap: 1 }}>
                        <Chip
                          label={insight.type}
                          size="small"
                          icon={getTypeIcon(insight.type)}
                          sx={{ 
                            backgroundColor: getSeverityColor(insight.severity),
                            color: '#ffffff',
                            '& .MuiChip-icon': { color: '#ffffff' }
                          }}
                        />
                        <Chip
                          label={insight.severity}
                          size="small"
                          sx={{ 
                            backgroundColor: getSeverityColor(insight.severity),
                            color: '#ffffff'
                          }}
                        />
                      </Box>
                    </Box>
                  </AccordionSummary>
                  <AccordionDetails>
                    <Box sx={{ p: 2 }}>
                      <Typography variant="body2" sx={{ color: '#ffffff', mb: 2 }}>
                        <strong>Impact:</strong> {insight.impact}
                      </Typography>
                      <Typography variant="body2" sx={{ color: '#ffffff', mb: 2 }}>
                        <strong>Recommendation:</strong> {insight.recommendation}
                      </Typography>
                      
                      {insight.metrics && insight.metrics.length > 0 && (
                        <Box>
                          <Typography variant="subtitle2" sx={{ color: '#ffa726', mb: 1 }}>
                            Metrics:
                          </Typography>
                          <List dense>
                            {insight.metrics.map((metric, metricIndex) => (
                              <ListItem key={metricIndex} sx={{ py: 0 }}>
                                <ListItemIcon>
                                  {metric.change > 0 ? 
                                    <TrendingUp sx={{ color: '#4caf50', fontSize: 16 }} /> :
                                    <TrendingDown sx={{ color: '#f44336', fontSize: 16 }} />
                                  }
                                </ListItemIcon>
                                <ListItemText
                                  primary={`${metric.metric}: ${metric.current.toLocaleString()}`}
                                  secondary={`${metric.change > 0 ? '+' : ''}${metric.change}% vs previous`}
                                  sx={{ 
                                    '& .MuiListItemText-primary': { color: '#ffffff', fontSize: '0.875rem' },
                                    '& .MuiListItemText-secondary': { color: '#ffa726', fontSize: '0.75rem' }
                                  }}
                                />
                              </ListItem>
                            ))}
                          </List>
                        </Box>
                      )}
                    </Box>
                  </AccordionDetails>
                </Accordion>
              ))}
            </Box>
          )}
        </CardContent>
      </Card>

      {/* AI Predictions */}
      {predictions.length > 0 && (
        <Card sx={{ background: '#2d2d2d', border: '1px solid #404040', mb: 3 }}>
          <CardContent>
            <Typography variant="h6" sx={{ 
              fontWeight: 600, 
              color: '#ffffff',
              mb: 3,
              display: 'flex',
              alignItems: 'center',
              gap: 1
            }}>
              <Psychology sx={{ color: '#ff6b35' }} />
              AI Predictions
            </Typography>

            <Grid container spacing={2}>
              {predictions.map((prediction, index) => (
                <Grid item xs={12} sm={6} md={4} key={index}>
                  <Card sx={{ 
                    background: '#1a1a1a',
                    border: '1px solid #404040',
                    height: '100%'
                  }}>
                    <CardContent>
                      <Typography variant="subtitle1" sx={{ 
                        color: '#ffffff', 
                        fontWeight: 600,
                        mb: 1,
                        textTransform: 'capitalize'
                      }}>
                        {prediction.metric}
                      </Typography>
                      
                      <Box sx={{ mb: 2 }}>
                        <Typography variant="h6" sx={{ color: '#ffffff' }}>
                          {prediction.currentValue.toLocaleString()}
                        </Typography>
                        <Typography variant="body2" sx={{ color: '#ffa726' }}>
                          Current Value
                        </Typography>
                      </Box>

                      <Box sx={{ mb: 2 }}>
                        <Typography variant="h6" sx={{ color: '#ff6b35' }}>
                          {prediction.predictedValue.toLocaleString()}
                        </Typography>
                        <Typography variant="body2" sx={{ color: '#ffa726' }}>
                          Predicted ({prediction.timeframe})
                        </Typography>
                      </Box>

                      <Box sx={{ mb: 2 }}>
                        <Typography variant="body2" sx={{ color: '#ffa726', mb: 1 }}>
                          Confidence: {prediction.confidence}%
                        </Typography>
                        <LinearProgress 
                          variant="determinate" 
                          value={prediction.confidence} 
                          sx={{ 
                            backgroundColor: '#404040',
                            '& .MuiLinearProgress-bar': { backgroundColor: '#ff6b35' }
                          }}
                        />
                      </Box>

                      {prediction.factors && prediction.factors.length > 0 && (
                        <Box>
                          <Typography variant="caption" sx={{ color: '#ffa726' }}>
                            Based on: {prediction.factors.join(', ')}
                          </Typography>
                        </Box>
                      )}
                    </CardContent>
                  </Card>
                </Grid>
              ))}
            </Grid>
          </CardContent>
        </Card>
      )}

      {/* AI Report Summary */}
      {report && (
        <Card sx={{ background: '#2d2d2d', border: '1px solid #404040' }}>
          <CardContent>
            <Typography variant="h6" sx={{ 
              fontWeight: 600, 
              color: '#ffffff',
              mb: 3,
              display: 'flex',
              alignItems: 'center',
              gap: 1
            }}>
              <Report sx={{ color: '#ff6b35' }} />
              AI-Generated Report
            </Typography>

            <Alert severity="info" sx={{ backgroundColor: '#1a1a1a', color: '#ffffff', mb: 3 }}>
              <Typography variant="body2" sx={{ whiteSpace: 'pre-line', fontFamily: 'monospace' }}>
                {report.summary}
              </Typography>
            </Alert>

            <Grid container spacing={2}>
              <Grid item xs={12} md={6}>
                <Typography variant="subtitle2" sx={{ color: '#ffa726', mb: 1 }}>
                  Key Metrics:
                </Typography>
                <List dense>
                  <ListItem sx={{ py: 0 }}>
                    <ListItemText
                      primary={`Total Users: ${report.keyMetrics.totalUsers.toLocaleString()}`}
                      sx={{ '& .MuiListItemText-primary': { color: '#ffffff', fontSize: '0.875rem' } }}
                    />
                  </ListItem>
                  <ListItem sx={{ py: 0 }}>
                    <ListItemText
                      primary={`Total Revenue: ${report.keyMetrics.totalRevenue.toLocaleString()} kr`}
                      sx={{ '& .MuiListItemText-primary': { color: '#ffffff', fontSize: '0.875rem' } }}
                    />
                  </ListItem>
                  <ListItem sx={{ py: 0 }}>
                    <ListItemText
                      primary={`Conversion Rate: ${report.keyMetrics.conversionRate}%`}
                      sx={{ '& .MuiListItemText-primary': { color: '#ffffff', fontSize: '0.875rem' } }}
                    />
                  </ListItem>
                </List>
              </Grid>
              <Grid item xs={12} md={6}>
                <Typography variant="subtitle2" sx={{ color: '#ffa726', mb: 1 }}>
                  Top Recommendations:
                </Typography>
                <List dense>
                  {report.recommendations.slice(0, 3).map((recommendation, index) => (
                    <ListItem key={index} sx={{ py: 0 }}>
                      <ListItemIcon>
                        <Lightbulb sx={{ color: '#ff6b35', fontSize: 16 }} />
                      </ListItemIcon>
                      <ListItemText
                        primary={recommendation}
                        sx={{ '& .MuiListItemText-primary': { color: '#ffffff', fontSize: '0.875rem' } }}
                      />
                    </ListItem>
                  ))}
                </List>
              </Grid>
            </Grid>
          </CardContent>
        </Card>
      )}
    </Box>
  );
}
