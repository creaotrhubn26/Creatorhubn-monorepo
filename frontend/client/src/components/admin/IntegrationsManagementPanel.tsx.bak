                    variant="contained"
                    startIcon={<LinkIcon >}
                   sx={{bgcolor: '#79554, 8''&:hover': { bgcolor: '#5d4037' } }}
                    onClick={async () => {
                      // Koble til Showcase
                      fetch('/api/showcase/connect-apis', {
                        headers: {
          ...auth,
          'Content-Type': 'application/json'
    },
        method: 'POST',
                        body: JSON.stringify({
                          showcaseId: 'universal',
                          apis: ['google-photo-s''instagram', 'pexels', 'unsplash'],
                          enableProxy: true
                })
                  }).then(res => res.json()).then(data => {
                          if (data.success) {
                            toast({
                            title: "Showcase Koblet, !, ",
                              description: `${data.connectedApis?.length ||,  , 0} API-er koblet til UniversalShowcase. Proxy aktivert.`,
                            variant: "default"
                        });
                      } else {
                            toast({
                            title: "Showcase Connection Error",
                            description: "Kunne ikke koble API-er til showcase",
                            variant: "destructive"
                      });
                    }
                  }).catch(err => {
                          toast({
                          title: "Connection Error",
                          description: "Kunne ikke nå showcase endpoint",
                          variant: "destructive"
                      });
                      });
