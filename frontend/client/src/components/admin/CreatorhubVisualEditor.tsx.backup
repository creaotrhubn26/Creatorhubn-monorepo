                    <Select value="typescript" label="Language">
                      <MenuItem value="typescript">TypeScript</MenuItem>
                      <MenuItem value="javascript">JavaScript</MenuItem>
                    </Select>
                  </FormControl>
                </Grid>
                <Grid size={{ xs: 12 }}>
                  <FormControlLabel
                    control={<Switch checked={true} />}
                    label="Include TypeScript Types"
                  />
                </Grid>
                <Grid size={{ xs: 12 }}>
                  <FormControlLabel
                    control={<Switch checked={true} />}
                    label="Generate Storybook Stories"
                  />
                </Grid>
                <Grid size={{ xs: 12 }}>
                  <FormControlLabel
                    control={<Switch />}
                    label="Include Unit Tests"
                  />
                </Grid>
              </Grid>
            </Box>

            {/* Publishing Tab */}
            <Box sx={{ display: 'none' }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Publishing Options</Typography>
              <Grid container spacing={2}>
                <Grid size={{ xs: 6 }}>
                  <Button
                    variant="outlined"
                    fullWidth
                    startIcon={<CloudUpload />}
                    onClick={() => {
                      onNotificationCreate?.({
                        id: `publish_${Date.now()}`,
                        type: 'publish',
                        title: 'Publishing to Web',
                        message: 'Publishing your design to the web...',
                        priority: 'high',
                        timestamp: new Date().toISOString(),
                        source: 'visual_editor'
                      });
                    }}
                  >
                    Publish to Web
                  </Button>
                </Grid>
                <Grid size={{ xs: 6 }}>
                  <Button
                    variant="outlined"
                    fullWidth
                    startIcon={<GitHub />}
                    onClick={() => {
                      onNotificationCreate?.({
                        id: `github_${Date.now()}`,
                        type: 'github',
                        title: 'Export to GitHub',
                        message: 'Exporting code to GitHub repository...',
                        priority: 'medium',
                        timestamp: new Date().toISOString(),
                        source: 'visual_editor'
                      });
                    }}
                  >
                    Export to GitHub
                  </Button>
                </Grid>
                <Grid size={{ xs: 6 }}>
                  <Button
                    variant="outlined"
                    fullWidth
                    startIcon={<Download />}
                    onClick={() => {
                      onNotificationCreate?.({
                        id: `download_${Date.now()}`,
                        type: 'download',
                        title: 'Download Package',
