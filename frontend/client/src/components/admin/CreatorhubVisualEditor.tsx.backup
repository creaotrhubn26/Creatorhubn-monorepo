      });
      
    } catch (error) {
      console.error('Failed to load Google Docs:', error);
      onNotificationCreate?.({
        id: `google_docs_error_${Date.now()}`,
        type: 'error',
        title: 'Google Docs Error',
        message: 'Failed to load Google Docs. Please check your connection.',
