        tags: ['sync', 'google-docs']
      });
      
      onNotificationCreate?.({
        id: `google_docs_loaded_${Date.now()}`,
        type: 'google_docs_loaded',
        title: 'Google Docs Loaded',
        message: `Successfully loaded ${docs.length} documents from Google Docs`,
