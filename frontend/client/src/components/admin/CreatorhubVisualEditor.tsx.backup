    const newElements = copyBuffer.map((element, index) => ({
          ...element,
      id: `${element.type}-${Date.now()}-${index}`,
      x: element.x + 20,
      y: element.y + 20
    }));

    // Convert array to Record<string, EditorElement>
    const newElementsRecord = newElements.reduce((acc, element) => {
      acc[element.id] = element;
      return acc;
    }, {} as Record<string, EditorElement>);

    setProject(prev => ({
      ...prev,
      elements: { ...prev.elements, ...newElementsRecord }
    }));

    addToHistory({
      ...project,
      elements: { ...project.elements, ...newElementsRecord }
