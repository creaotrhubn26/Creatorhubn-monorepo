                        <Stack spacing={1}>
                          <Chip label="fotograf Norge" variant="outlined" size="small" />
                          <Chip label="kreativ plattform" variant="outlined" size="small" />
                          <Chip label="portefølje verktøy" variant="outlined" size="small" />
                          <Chip label="norske kreative" variant="outlined" size="small" />
                          <Chip label="GDPR-kompatibel" variant="outlined" size="small" />
                        </Stack>
                      </Grid>
                      <Grid size={{ xs: 12, md: 6 }}>
                        <Typography variant="subtitle2" sx={{ mb: 1 }}>Local SEO Factors</Typography>
                        <List dense>
                          <ListItem>
                            <ListItemIcon>
                              <CheckCircleIcon color="success" />
                            </ListItemIcon>
                            <ListItemText primary="Norwegian language content" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <CheckCircleIcon color="success" />
                            </ListItemIcon>
                            <ListItemText primary="Norway-specific business info" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <CheckCircleIcon color="success" />
                            </ListItemIcon>
                            <ListItemText primary="GDPR compliance statements" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <CheckCircleIcon color="success" />
                            </ListItemIcon>
                            <ListItemText primary="Norwegian cultural references" />
                          </ListItem>
                        </List>
                      </Grid>
                    </Grid>
                    <Button 
                      variant="contained" 
                      fullWidth 
                      sx={{ mt: 2 }}
                      onClick={() => {
                        // Trigger unified workflow event for Norwegian market optimization
                        onProjectUpdate?.({
                          ...selectedProject,
                          id: selectedProject?.id || 'unknown',
                          name: selectedProject?.name || 'Unknown Project',
                          description: selectedProject?.description || 'No description available',
                          status: selectedProject?.status || 'in-progress',
                          clientId: selectedProject?.clientId || 'default',
                          dueDate: selectedProject?.dueDate || new Date(),
                          priority: selectedProject?.priority || 'medium',
                          tags: selectedProject?.tags || [],
                          norwegianMarketOptimization: true,
                          optimizationType: 'seo_localization',
                          timestamp: new Date().toISOString()
                        });
                        
                        onNotificationCreate?.({
                          id: `norwegian_optimization_${Date.now()}`,
                          type: 'norwegian_optimization',
                          title: 'Norwegian Market Optimization',
                          message: 'Optimizing design for Norwegian market and SEO',
                          priority: 'high',
                          timestamp: new Date().toISOString(),
                          source: 'visual_editor'
                        });
                      }}
                    >
                      Optimize for Norwegian Market
                    </Button>
                  </CardContent>
                </Card>
              </Grid>
            </Grid>
          </Box>
        )}

        {/* Live Preview */}
        {(selectedView as string) === 'preview' && (
          <Box sx={{ flex: 1, p: 2 }}>
            <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
              <Typography variant="h6">
                Live Preview
              </Typography>
              <ButtonGroup size="small" variant="outlined">
                <Button
                  variant={previewMode === 'desktop' ? 'contained' : 'outlined'}
                  onClick={() => setPreviewMode('desktop')}
                >
                  Desktop (1200px)
                </Button>
                <Button
                  variant={previewMode === 'tablet' ? 'contained' : 'outlined'}
                  onClick={() => setPreviewMode('tablet')}
                >
                  Tablet (768px)
                </Button>
                <Button
                  variant={previewMode === 'mobile' ? 'contained' : 'outlined'}
                  onClick={() => setPreviewMode('mobile')}
                >
                  Mobile (375px)
                </Button>
              </ButtonGroup>
            </Box>

            <Box sx={{ 
                display: 'flex',
                justifyContent: 'center',
                border: '1px solid #e0e0e0',
                borderRadius: 1,
                p: 2,
                backgroundColor: '#f5f5f5',
              minHeight: 'calc(100vh - 180px)'
            }}>
              <Box
                sx={{
                  width: getCanvasWidth(),
                  backgroundColor: 'white',
                  borderRadius: 1,
                  boxShadow: 2,
                  p: 3
                }}
              >
                {/* Live rendered preview */}
                <Card sx={{ maxWidth: 600, mx: 'auto' }}>
                  <CardContent>
                    <Typography variant="h4" gutterBottom sx={{ color: '#1976d2', fontWeight: 600 }}>
                      CreatorHub Norge
                    </Typography>
                    <Typography variant="body1" paragraph sx={{ color: '#666666', lineHeight: 1.6 }}>
                      Professional creative platform for Norwegian artists and creators. 
                      Build your portfolio, manage clients, and grow your creative business with our comprehensive tools.
                    </Typography>
                    <Box sx={{ display: 'flex', gap: 2, mt: 3 }}>
                      <Button variant="contained" color="primary" size="large">
                        Get Started
                      </Button>
                      <Button variant="outlined" size="large">
                        Learn More
                      </Button>
                    </Box>
                  </CardContent>
                </Card>
              </Box>
            </Box>
          </Box>
        )}
      </Box>

      {/* Floating Action Button */}
      <Fab
        color="primary"
        sx={{ position: 'fixed', bottom: 16, right: 16 }}
        onClick={() => setFabMenuOpen(!fabMenuOpen)}
      >
        <AddIcon />
      </Fab>

      {/* FAB Menu */}
      <Dialog
        open={fabMenuOpen}
        onClose={() => setFabMenuOpen(false)}
        PaperProps={{
          sx: {
            position: 'fixed',
            bottom: 80,
            right: 16,
            m: 0,
            maxHeight: 'none'
          }
        }}
      >
        <DialogContent sx={{ p: 1 }}>
          <Stack spacing={1}>
            <Button
              startIcon={<ImageIcon />}
              onClick={() => {
                fileInputRef.current?.click();
                setFabMenuOpen(false);
              }}
            >
              Upload Asset
            </Button>
            <Button
              startIcon={<SearchIcon />}
              onClick={() => {
                setShowSeoDashboard(true);
                setFabMenuOpen(false);
              }}
            >
              Advanced SEO
            </Button>
            <Button
              startIcon={<SaveIcon />}
              onClick={() => {
                handleDesignSave();
                setFabMenuOpen(false);
              }}
            >
              Save Project
            </Button>
            <Button
              startIcon={<CodeIcon />}
              onClick={() => {
                showExportModal();
                setFabMenuOpen(false);
              }}
            >
              Export Code
            </Button>
            <Button
              startIcon={<SettingsIcon />}
              onClick={() => {
                showSettingsModal();
                setFabMenuOpen(false);
              }}
            >
              Settings
            </Button>
          </Stack>
        </DialogContent>
      </Dialog>

      {/* Enhanced Modal System Integration */}
      
      {/* Modal Toolbar Integration */}
      <ModalToolbar
        title="CreatorHub Visual Editor"
        showNavigation={true}
        showPreview={true}
        showGuardRails={true}
        onAction={(action, data) => {
          console.log('Toolbar action:', action, data);
          switch (action) {
            case 'save':
              handleDesignSave();
              break;
            case 'export':
              showExportModal();
              break;
            case 'settings':
              showSettingsModal();
              break;
            case 'ai-assistant':
              showAIAssistantModal();
              break;
            case 'ar-preview':
              showARPreviewModal();
              break;
            case 'vr-preview':
              showVRPreviewModal();
              break;
            case 'voice-control':
              showVoiceControlModal();
              break;
            case 'advanced-features':
              showAdvancedFeaturesModal();
              break;
            default:
              console.log('Unhandled toolbar action:', action);
          }
        }}
      />

      {/* AI Assistant Modal */}
      <AIAssistantModal
        open={modalStates.aiAssistant}
        onClose={() => setModalStates(prev => ({ ...prev, aiAssistant: false }))}
        context={{
          user: {
            id: user?.id || '1',
            preferences: {},
            history: [],
            behavior: {}
          },
          session: {
            id: Date.now().toString(),
            startTime: Date.now(),
            interactions: 0
          },
          environment: {
            device: 'desktop',
            platform: 'web',
            capabilities: ['voice', 'gesture', 'ai']
          }
        }}
      />

      {/* AR Preview Modal */}
      <ARModal
        open={modalStates.arPreview}
        onClose={() => setModalStates(prev => ({ ...prev, arPreview: false }))}
        title="AR Preview"
        config={{
          mode: 'ar',
          device: 'mobile',
          orientation: 'portrait',
          interactions: ['touch', 'gesture'],
          quality: 'high',
          framerate: 60,
          resolution: { width: 1920, height: 1080 },
          fieldOfView: 75,
          near: 0.1,
          far: 1000,
          antialiasing: true,
          shadows: true,
          lighting: true,
          physics: false,
          audio: false,
          haptics: true
        }}
        onObjectAdd={(object) => console.log('AR object added:', object)}
        onObjectRemove={(id) => console.log('AR object removed:', id)}
        onCapture={(image) => console.log('AR captured:', image)}
        onShare={() => console.log('AR shared')}
      >
        <Box sx={{ p: 2 }}>
          <Typography variant="h6" gutterBottom>
            AR Preview Mode
          </Typography>
          <Typography variant="body2" color="text.secondary">
            Use your mobile device to preview your design in augmented reality.
          </Typography>
        </Box>
      </ARModal>

      {/* VR Preview Modal */}
      <VRModal
        open={modalStates.vrPreview}
        onClose={() => setModalStates(prev => ({ ...prev, vrPreview: false }))}
        title="VR Preview"
        config={{
          mode: 'vr',
          device: 'headset',
          orientation: 'landscape',
          interactions: ['controller', 'hand'],
          quality: 'ultra',
          framerate: 90,
          resolution: { width: 2160, height: 1200 },
          fieldOfView: 110,
          near: 0.01,
          far: 10000,
          antialiasing: true,
          shadows: true,
          lighting: true,
          physics: true,
          audio: true,
          haptics: true
        }}
        onObjectAdd={(object) => console.log('VR object added:', object)}
        onObjectRemove={(id) => console.log('VR object removed:', id)}
        onCapture={(image) => console.log('VR captured:', image)}
        onShare={() => console.log('VR shared')}
      >
        <Box sx={{ p: 2 }}>
          <Typography variant="h6" gutterBottom>
            VR Preview Mode
          </Typography>
          <Typography variant="body2" color="text.secondary">
            Immerse yourself in your design with virtual reality.
          </Typography>
        </Box>
      </VRModal>

      {/* Voice Control Modal */}
      <VoiceGestureControl
        onCommand={(command) => {
          console.log('Voice command:', command);
          switch (command) {
            case 'save':
              handleDesignSave();
              break;
            case 'undo':
              handleUndo();
              break;
            case 'redo':
              handleRedo();
              break;
            case 'delete':
              if (selectedElement) {
                deleteElement(selectedElement);
              }
              break;
            default:
              console.log('Unhandled command:', command);
          }
        }}
        onGesture={(gesture, event) => {
          console.log('Gesture detected:', gesture, event);
        }}
        showVisualFeedback={true}
        showCommands={true}
        showGestures={true}
      />

      {/* Advanced Features Modal - Placeholder for future implementation */}
      {/* <AdvancedFeaturesPanel /> */}

      {/* Settings Dialog - Keep for backward compatibility */}
      <Dialog
        open={false}
        onClose={() => {}}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle>Editor Settings</DialogTitle>
        <DialogContent>
          <Stack spacing={2} sx={{ mt: 1 }}>
            <FormControlLabel
              control={
                <Switch
                  checked={showGrid}
                  onChange={(e) => setShowGrid(e.target.checked)}
                />
              }
              label="Show Grid"
            />
            <FormControlLabel
              control={
                <Switch
                  checked={extendedThinking}
                  onChange={(e) => setExtendedThinking(e.target.checked)}
                />
              }
              label="Extended Thinking Mode"
            />
            <FormControlLabel
              control={
                <Switch
                  checked={highPowerMode}
                  onChange={(e) => setHighPowerMode(e.target.checked)}
                />
              }
              label="High Power Mode"
            />
            <Box>
              <Typography variant="subtitle2" gutterBottom>
                Canvas Zoom: {Math.round(canvasZoom * 100)}%
              </Typography>
              <Slider
                value={canvasZoom}
                onChange={(_, value) => setCanvasZoom(value as number)}
                min={0.5}
                max={2}
                step={0.1}
              />
    </Box>
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => {}}>Close</Button>
        </DialogActions>
      </Dialog>

      {/* Advanced Export Dialog - Replaced with Modal System */}
      <Dialog
        open={false}
        onClose={() => {}}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>Advanced Export & Publishing</DialogTitle>
        <DialogContent>
          <Box sx={{ mt: 2 }}>
            <Tabs value={0} sx={{ mb: 3 }}>
              <Tab label="Image Export" />
              <Tab label="Code Export" />
              <Tab label="Publishing" />
            </Tabs>

            {/* Image Export Tab */}
            <Box sx={{ display: 0 === 0 ? 'block' : 'none' }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Image Export</Typography>
              <Grid container spacing={2}>
                <Grid size={{ xs: 6 }}>
                  <FormControl fullWidth sx={{ mb: 2 }}>
                    <InputLabel>Format</InputLabel>
                    <Select value="png" label="Format">
                      <MenuItem value="png">PNG Image</MenuItem>
                      <MenuItem value="jpg">JPG Image</MenuItem>
                      <MenuItem value="svg">SVG Vector</MenuItem>
                      <MenuItem value="pdf">PDF Document</MenuItem>
                      <MenuItem value="webp">WebP Image</MenuItem>
                    </Select>
                  </FormControl>
                </Grid>
                <Grid size={{ xs: 6 }}>
                  <FormControl fullWidth sx={{ mb: 2 }}>
                    <InputLabel>Resolution</InputLabel>
                    <Select value="1x" label="Resolution">
                      <MenuItem value="0.5x">0.5x (Low)</MenuItem>
                      <MenuItem value="1x">1x (Standard)</MenuItem>
                      <MenuItem value="2x">2x (Retina)</MenuItem>
                      <MenuItem value="3x">3x (High DPI)</MenuItem>
                    </Select>
                  </FormControl>
                </Grid>
                <Grid size={{ xs: 6 }}>
                  <TextField
                    label="Width"
                    type="number"
                    defaultValue={800}
                    fullWidth
                  />
                </Grid>
                <Grid size={{ xs: 6 }}>
                  <TextField
                    label="Height"
                    type="number"
                    defaultValue={600}
                    fullWidth
                  />
                </Grid>
                <Grid size={{ xs: 6 }}>
                  <TextField
                    label="Quality"
                    type="number"
                    defaultValue={100}
                    fullWidth
                  />
                </Grid>
                <Grid size={{ xs: 6 }}>
                  <FormControlLabel
                    control={<Switch checked={true} />}
                    label="Transparent Background"
                  />
                </Grid>
              </Grid>
            </Box>

            {/* Code Export Tab */}
            <Box sx={{ display: 'none' }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Code Export</Typography>
              <Grid container spacing={2}>
                <Grid size={{ xs: 6 }}>
                  <FormControl fullWidth sx={{ mb: 2 }}>
                    <InputLabel>Framework</InputLabel>
                    <Select value="react" label="Framework">
                      <MenuItem value="react">React</MenuItem>
                      <MenuItem value="vue">Vue.js</MenuItem>
                      <MenuItem value="angular">Angular</MenuItem>
                      <MenuItem value="svelte">Svelte</MenuItem>
