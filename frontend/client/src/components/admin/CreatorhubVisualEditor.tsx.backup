      />

      {/* Advanced Visual Editor Dialogs */}
      
      {/* Text Editor Dialog */}
      <Dialog 
        open={textEditorOpen} 
        onClose={() => setTextEditorOpen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>Advanced Text Editor</DialogTitle>
        <DialogContent>
          {selectedTextElement && (
            <Box sx={{ mt: 2 }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Text Content</Typography>
              <TextField
                fullWidth
                multiline
                rows={4}
                defaultValue={project.elements[selectedTextElement]?.props?.text || ''}
                onChange={(e) => {
                  updateElement(selectedTextElement, {
                    props: { text: e.target.value }
                  });
                }}
              />
              
              <Typography variant="h6" sx={{ mt: 3, mb: 2 }}>Text Effects</Typography>
              <Grid container spacing={2}>
                <Grid size={{ xs: 6 }}>
                  <TextField
                    label="Text Shadow"
                    value={textEffects[selectedTextElement]?.shadow || ''}
                    onChange={(e) => applyTextEffect(selectedTextElement, 'shadow', e.target.value)}
                    fullWidth
                  />
                </Grid>
                <Grid size={{ xs: 6 }}>
                  <TextField
                    label="Text Stroke"
                    value={textEffects[selectedTextElement]?.stroke || ''}
                    onChange={(e) => applyTextEffect(selectedTextElement, 'stroke', e.target.value)}
                    fullWidth
                  />
                </Grid>
              </Grid>
            </Box>
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setTextEditorOpen(false)}>Close</Button>
        </DialogActions>
      </Dialog>

      {/* Animation Timeline Dialog */}
      <Dialog 
        open={animationTimeline.length > 0} 
        onClose={() => setAnimationTimeline([])}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>Animation Timeline</DialogTitle>
        <DialogContent>
          <Box sx={{ mt: 2 }}>
            <Typography variant="h6" sx={{ mb: 2 }}>Timeline Controls</Typography>
            <ButtonGroup>
              <Button startIcon={<PlayArrow />}>Play</Button>
              <Button startIcon={<Pause />}>Pause</Button>
              <Button startIcon={<Stop />}>Stop</Button>
            </ButtonGroup>
            
            <Box sx={{ mt: 3 }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Keyframes</Typography>
              {animationTimeline.map((keyframe, index) => (
                <Card key={index} sx={{ mb: 2, p: 2 }}>
                  <Typography variant="subtitle1">Element: {keyframe.elementId}</Typography>
                  <Typography variant="body2">Duration: {keyframe.duration}ms</Typography>
                  <Typography variant="body2">Easing: {keyframe.easing}</Typography>
                </Card>
              ))}
            </Box>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setAnimationTimeline([])}>Close</Button>
        </DialogActions>
      </Dialog>

      {/* Comments Dialog */}
      <Dialog 
        open={Object.keys(comments).length > 0} 
        onClose={() => setComments({})}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>Comments & Feedback</DialogTitle>
        <DialogContent>
          <Box sx={{ mt: 2 }}>
            {Object.entries(comments).map(([elementId, elementComments]) => (
              <Card key={elementId} sx={{ mb: 2, p: 2 }}>
                <Typography variant="subtitle1">Element: {elementId}</Typography>
                {elementComments.map((comment: any) => (
                  <Box key={comment.id} sx={{ mt: 1, p: 1, backgroundColor: '#f5f5f5', borderRadius: 1 }}>
                    <Typography variant="body2">{comment.text}</Typography>
                    <Typography variant="caption" color="text.secondary">
                      {comment.author} - {new Date(comment.timestamp).toLocaleString()}
                    </Typography>
