      tooltip: 'Preview your design in Virtual Reality',
      group: 'preview'
    });

    toolbar.addAction({
      id: 'voice-control',
      label: 'Voice Control',
      icon: <MicIcon />,
      onClick: showVoiceControlModal,
      tooltip: 'Enable voice commands for hands-free editing',
      group: 'accessibility'
    });

    toolbar.addAction({
      id: 'advanced-features',
      label: 'Advanced Features',
      icon: <TuneIcon />,
      onClick: showAdvancedFeaturesModal,
      tooltip: 'Access advanced features and configurations',
      group: 'tools'
    });

    // Enhanced AI-Powered Toolbar Actions
    toolbar.addAction({
      id: 'ai-insights',
      label: 'AI Insights',
      icon: <PsychologyIcon />,
      onClick: () => setShowAIPanel(!showAIPanel),
      tooltip: 'Open AI-powered insights panel',
      group: 'ai'
    });

    toolbar.addAction({
      id: 'voice-tutorial',
      label: 'Voice Tutorial',
      icon: <VoiceIcon />,
      onClick: () => setShowVoiceTutorial(!showVoiceTutorial),
      tooltip: 'Start voice-guided tutorial',
      group: 'learning'
    });

    toolbar.addAction({
      id: 'gamification',
      label: 'Progress',
      icon: <TrophyIcon />,
      onClick: () => setShowGamificationPanel(!showGamificationPanel),
      tooltip: 'View your learning progress and achievements',
      group: 'learning'
    });

    // Advanced Analytics Toolbar Actions
    toolbar.addAction({
      id: 'analytics-dashboard',
      label: 'Analytics',
      icon: <AnalyticsIcon />,
      onClick: () => setShowAnalyticsDashboard(!showAnalyticsDashboard),
      tooltip: 'Advanced learning analytics and insights dashboard',
      group: 'analytics'
    });

    toolbar.addAction({
      id: 'predictive-suggestions',
      label: 'Predictions',
      icon: <AutoAwesomeIcon />,
      onClick: () => setShowPredictiveSuggestions(!showPredictiveSuggestions),
      tooltip: 'AI-powered predictive suggestions based on your patterns',
      group: 'analytics'
    });

    toolbar.addAction({
      id: 'auto-fix-engine',
      label: 'Auto-Fix',
      icon: <BuildIcon />,
      onClick: () => setShowAutoFixEngine(!showAutoFixEngine),
      tooltip: 'Automatically fix common code issues and improvements',
      group: 'analytics'
    });

    // Add guard rails for better user experience
    guardRails.add({
      id: 'unsaved-changes',
      type: 'warning',
      title: 'Unsaved Changes',
      message: 'You have unsaved changes. Save your work before closing.',
      priority: 'high',
      conditions: [
        { field: 'hasUnsavedChanges', operator: 'equals', value: true }
      ],
      action: {
        label: 'Save Now',
        onClick: () => handleDesignSave()
      }
    });

    guardRails.add({
      id: 'performance-warning',
      type: 'info',
      title: 'Performance Optimization',
      message: 'Consider optimizing your design for better performance.',
      priority: 'medium',
      conditions: [
        { field: 'elementCount', operator: 'greaterThan', value: 50 }
      ]
    });

    return () => {
      // Cleanup toolbar actions
      toolbar.removeAction('ai-assistant');
      toolbar.removeAction('ar-preview');
      toolbar.removeAction('vr-preview');
      toolbar.removeAction('voice-control');
      toolbar.removeAction('advanced-features');
    };
  }, [toolbar, guardRails, showAIAssistantModal, showARPreviewModal, showVRPreviewModal, showVoiceControlModal, showAdvancedFeaturesModal]);

