            <ImageList cols={4} gap={8}>
              {uploadedAssets.map((asset, index) => (
                <ImageListItem key={index}>
                  <img
                    src={asset.url}
                    alt={asset.name}
                    loading="lazy"
                    style={{ cursor: 'pointer' }}
                    onClick={() => {
                      // Add asset to canvas
                    }}
                  />
                  <ImageListItemBar
                    title={asset.name}
                    subtitle={asset.type}
                    actionIcon={
                      <IconButton
                        onClick={() => {
                          if (asset.type.startsWith('image/')) {
                            setImageCropOpen(true);
                          } else if (asset.type === 'image/svg+xml') {
                            setSvgEditorOpen(true);
                          }
                        }}
                      >
                        <Edit />
                      </IconButton>
                    }
                  />
                </ImageListItem>
              ))}
            </ImageList>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setAssetLibraryOpen(false)}>Close</Button>
        </DialogActions>
      </Dialog>
      
      {/* Font Library Dialog */}
      <Dialog 
        open={fontLibraryOpen} 
        onClose={() => setFontLibraryOpen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>
          <Box display="flex" alignItems="center" gap={1}>
            <FormatPaint />
            Font Library
          </Box>
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2} sx={{ mt: 1 }}>
            {googleFonts.map((font, index) => (
              <Grid size={{ xs: 12, sm: 6, md: 4 }} key={index}>
                <Card 
                  sx={{ 
                    cursor: 'pointer',
                    border: selectedFont === font.family ? 2 : 1,
                    borderColor: selectedFont === font.family ? 'primary.main' : 'divider',
                    '&:hover': { borderColor: 'primary.main' }
                  }}
                  onClick={() => setSelectedFont(font.family)}
                >
                  <CardContent>
                    <Typography 
                      variant="h6" 
                      sx={{ 
                        fontFamily: font.family,
                        mb: 1 
                      }}
                    >
                      {font.family}
                    </Typography>
                    <Typography variant="body2" color="text.secondary">
                      {font.category}
                    </Typography>
                  </CardContent>
                </Card>
              </Grid>
            ))}
          </Grid>
          
          {/* Font Controls */}
          <Box sx={{ mt: 3 }}>
            <Typography variant="h6" gutterBottom>Font Settings</Typography>
            <Grid container spacing={2}>
              <Grid size={{ xs: 12, sm: 6 }}>
                <FormControl fullWidth>
                  <InputLabel>Font Weight</InputLabel>
                  <Select
                    value={fontWeights[0]}
                    onChange={(e) => setFontWeights([e.target.value, ...fontWeights.slice(1)])}
                  >
                    {['100', '200', '300', '400', '500', '600', '700', '800', '900'].map(weight => (
                      <MenuItem key={weight} value={weight}>{weight}</MenuItem>
                    ))}
                  </Select>
                </FormControl>
              </Grid>
              <Grid size={{ xs: 12, sm: 6 }}>
                <FormControl fullWidth>
                  <InputLabel>Font Style</InputLabel>
                  <Select
                    value={fontStyles[0]}
                    onChange={(e) => setFontStyles([e.target.value, ...fontStyles.slice(1)])}
                  >
                    <MenuItem value="normal">Normal</MenuItem>
                    <MenuItem value="italic">Italic</MenuItem>
                    <MenuItem value="oblique">Oblique</MenuItem>
                  </Select>
                </FormControl>
              </Grid>
            </Grid>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setFontLibraryOpen(false)}>Cancel</Button>
          <Button 
            variant="contained" 
            onClick={() => {
              applyFont(selectedFont, fontWeights[0], fontStyles[0]);
              setFontLibraryOpen(false);
            }}
          >
            Apply Font
          </Button>
        </DialogActions>
      </Dialog>

      {/* Icon Library Dialog */}
      <Dialog 
        open={iconLibraryOpen} 
        onClose={() => setIconLibraryOpen(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>
          <Box display="flex" alignItems="center" gap={1}>
            <Tag />
            Icon Library
          </Box>
        </DialogTitle>
        <DialogContent>
          <Tabs value={0} sx={{ mb: 2 }}>
            <Tab label="CreatorHub Icons" />
            <Tab label="Material UI Icons" />
          </Tabs>
          
          <Grid container spacing={1}>
            {/* CreatorHub Icons */}
            {Object.entries({
              'Photography': PhotographyIcon,
              'Videography': VideographyIcon,
              'Music': MusicProductionIcon,
              'Corporate': CorporateIcon,
              'Wedding': RingIcon,
              'AI': AIIcon,
              'Analytics': AnalyticsIcon,
              'Collaboration': CollaborationIcon
            }).map(([name, IconComponent], index) => (
              <Grid size={{ xs: 6, sm: 4, md: 3 }} key={index}>
                <Card 
                  sx={{ 
                    cursor: 'pointer',
                    p: 2,
                    textAlign: 'center',
                    '&:hover': { bgcolor: 'action.hover' }
                  }}
                  onClick={() => {
                    // Add icon to selected elements
                    selectedElements.forEach(elementId => {
                      updateElement(elementId, { icon: name });
                    });
                    setIconLibraryOpen(false);
                  }}
                >
                  <IconComponent sx={{ fontSize: 40, mb: 1 }} />
                  <Typography variant="caption">{name}</Typography>
                </Card>
              </Grid>
            ))}
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setIconLibraryOpen(false)}>Close</Button>
        </DialogActions>
      </Dialog>

      {/* Color Picker Dialog */}
      <Dialog 
        open={colorPickerOpen} 
        onClose={() => setColorPickerOpen(false)}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle>
          <Box display="flex" alignItems="center" gap={1}>
            <ColorLens />
            Color Picker
          </Box>
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
                <Grid size={{ xs: 12 }}>
              <Typography variant="h6" gutterBottom>Solid Colors</Typography>
              <Box display="flex" flexWrap="wrap" gap={1}>
                {['#000000', '#FFFFFF', '#FF0000', '#00FF00', '#0000FF', '#FFFF00', '#FF00FF', '#00FFFF'].map(color => (
                  <Box
                    key={color}
                    sx={{
                      width: 40,
                      height: 40,
                      bgcolor: color,
                      border: selectedColor === color ? 3 : 1,
                      borderColor: selectedColor === color ? 'primary.main' : 'divider',
                      cursor: 'pointer',
                      borderRadius: 1
                    }}
                    onClick={() => setSelectedColor(color)}
                  />
                ))}
              </Box>
            </Grid>
            
                <Grid size={{ xs: 12 }}>
              <Typography variant="h6" gutterBottom>Gradient Colors</Typography>
              <Box display="flex" flexWrap="wrap" gap={1}>
                {[
                  ['#FF6B6B', '#4ECDC4'],
                  ['#A8E6CF', '#FFD93D'],
                  ['#6C5CE7', '#A29BFE'],
                  ['#FD79A8', '#FDCB6E']
                ].map((gradient, index) => (
                  <Box
                    key={index}
                    sx={{
                      width: 80,
                      height: 40,
                      background: `linear-gradient(45deg, ${gradient[0]}, ${gradient[1]})`,
                      border: 1,
                      borderColor: 'divider',
                      cursor: 'pointer',
                      borderRadius: 1
                    }}
                    onClick={() => {
                      setGradientColors(gradient);
                      setGradientMode(true);
                    }}
                  />
                ))}
              </Box>
            </Grid>
            
                <Grid size={{ xs: 12 }}>
              <Typography variant="h6" gutterBottom>Color History</Typography>
              <Box display="flex" flexWrap="wrap" gap={1}>
                {colorHistory.map((color, index) => (
                  <Box
                    key={index}
                    sx={{
                      width: 30,
                      height: 30,
                      bgcolor: color,
                      border: 1,
                      borderColor: 'divider',
                      cursor: 'pointer',
                      borderRadius: 1
                    }}
                    onClick={() => setSelectedColor(color)}
                  />
                ))}
              </Box>
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setColorPickerOpen(false)}>Cancel</Button>
          <Button 
            variant="contained" 
            onClick={() => {
              if (gradientMode) {
                applyGradient(gradientColors);
              } else {
                applyColor(selectedColor);
              }
              setColorPickerOpen(false);
            }}
          >
            Apply Color
          </Button>
        </DialogActions>
      </Dialog>

      {/* ScrollStories Component */}
      <ScrollStory
        open={scrollStoriesOpen} 
        onClose={() => setScrollStoriesOpen(false)}
        stories={scrollStories}
        onStoriesChange={(stories) => {
          // Update stories through the hook
          stories.forEach(story => {
            if (!scrollStories.find(s => s.id === story.id)) {
              createStory(story);
            }
          });
        }}
        currentStory={currentStory}
        onCurrentStoryChange={selectStory}
        onNotificationCreate={onNotificationCreate}
        onProjectUpdate={onProjectUpdate}
        onWorklogCreate={onWorklogCreate}
        onMeetingCreate={onMeetingCreate}
      />

      {/* Advanced Code Generation Dialog */}
      <Dialog 
        open={codeGenerationOpen} 
        onClose={() => setCodeGenerationOpen(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>
          <Typography variant="h6">Scroll Stories Code Generation</Typography>
        </DialogTitle>
        <DialogContent>
          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
            <Typography variant="h6">Scroll Stories</Typography>
            <Box sx={{ display: 'flex', gap: 1 }}>
              <Button 
                variant="outlined" 
                startIcon={<CloudUpload />}
                onClick={() => setPdfImportOpen(true)}
              >
                Import PDF
              </Button>
              <Button 
                variant="outlined" 
                startIcon={<Image />}
                onClick={() => setMediaImportOpen(true)}
              >
                Import Media
              </Button>
              <Button 
                variant="contained" 
                startIcon={<Add />}
                onClick={() => createScrollStory({ name: 'New Scroll Story' })}
              >
                Create Story
              </Button>
            </Box>
          </Box>
          
          <Grid container spacing={2}>
            {scrollStories.map((story) => (
              <Grid size={{ xs: 12, md: 6 }} key={story.id}>
                <Card 
                  sx={{ 
                    cursor: 'pointer',
                    border: currentStory?.id === story.id ? '2px solid #1976d2' : '1px solid #e0e0e0'
                  }}
                  onClick={() => selectStory(story)}
                >
                  <CardContent>
                    <Typography variant="h6">{story.name}</Typography>
                    <Typography variant="body2" color="text.secondary">
                      {story.elements?.length || 0} elements • {story.scrollTriggers?.length || 0} triggers
                    </Typography>
                    <Typography variant="caption" color="text.secondary">
                      Created: {new Date(story.createdAt).toLocaleDateString()}
                    </Typography>
                  </CardContent>
                  <CardActions>
                    <Button size="small" onClick={() => selectStory(story)}>
                      Edit
                    </Button>
                    <Button size="small" onClick={() => exportScrollStory()}>
                      Export
                    </Button>
                  </CardActions>
                </Card>
              </Grid>
            ))}
          </Grid>

          {/* Timeline Tab */}
          <Box sx={{ display: activeTab === 1 ? 'block' : 'none' }}>
            <Typography variant="h6" sx={{ mb: 2 }}>Scroll Timeline</Typography>
            <Box sx={{ 
              height: 200, 
              border: '1px solid #e0e0e0', 
              borderRadius: 1, 
              p: 2,
              backgroundColor: '#f5f5f5'
            }}>
              <Typography variant="body2" color="text.secondary">
                Scroll Progress: {Math.round(scrollProgress * 100)}%
              </Typography>
              <LinearProgress 
                variant="determinate" 
                value={scrollProgress * 100} 
                sx={{ mt: 1, mb: 2 }}
              />
              
              {scrollTimeline.map((trigger, index) => (
                <Box key={trigger.id} sx={{ 
                  display: 'flex', 
                  alignItems: 'center', 
                  mb: 1,
                  p: 1,
                  backgroundColor: 'white',
                  borderRadius: 1,
                  border: '1px solid #e0e0e0'
                }}>
                  <Box sx={{ 
                    width: 8, 
                    height: 8, 
                    borderRadius: '50%', 
                    backgroundColor: '#1976d2',
                    mr: 2
                  }} />
                  <Typography variant="body2">
                    {trigger.animation} at {Math.round(trigger.triggerPoint * 100)}%
                  </Typography>
                </Box>
              ))}
            </Box>
            </Box>

          {/* Animations Tab */}
          <Box sx={{ display: activeTab === 2 ? 'block' : 'none' }}>
            <Typography variant="h6" sx={{ mb: 2 }}>Scroll Animations</Typography>
            
            {selectedElements.length > 0 && (
                <Box sx={{ mb: 3, p: 2, backgroundColor: '#e3f2fd', borderRadius: 1 }}>
                  <Typography variant="subtitle2" sx={{ mb: 1 }}>
                    Add Animation to Selected Elements
                  </Typography>
                  <ButtonGroup>
                    <Button 
                      size="small"
                      onClick={() => selectedElements.forEach(id => 
                        addScrollAnimation(id, { type: 'fadeIn', triggerPoint: 0.5 })
                      )}
                    >
                      Fade In
                    </Button>
                    <Button 
                      size="small"
                      onClick={() => selectedElements.forEach(id => 
                        addScrollAnimation(id, { type: 'slideIn', triggerPoint: 0.3 })
                      )}
                    >
                      Slide In
                    </Button>
                    <Button 
                      size="small"
                      onClick={() => selectedElements.forEach(id => 
                        addScrollAnimation(id, { type: 'scaleIn', triggerPoint: 0.7 })
                      )}
                    >
                      Scale In
                    </Button>
                  </ButtonGroup>
                </Box>
              )}

              <Grid container spacing={2}>
                {Object.entries(scrollAnimations).map(([elementId, animation]) => (
                  <Grid size={{ xs: 12 }} key={elementId}>
                    <Card>
                      <CardContent>
                        <Typography variant="subtitle1">
                          Element: {elementId}
                        </Typography>
                        <Typography variant="body2">
                          Type: {animation.type} • Trigger: {Math.round(animation.triggerPoint * 100)}%
                        </Typography>
                        <Typography variant="body2">
                          Duration: {animation.duration}ms • Delay: {animation.delay}ms
                        </Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                ))}
              </Grid>
            </Box>

            {/* Presets Tab */}
            <Box sx={{ display: activeTab === 3 ? 'block' : 'none' }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Animation Presets</Typography>
              
              <Grid container spacing={2}>
                {animationPresets.map((preset) => (
                  <Grid size={{ xs: 12, md: 6 }} key={preset.id}>
                    <Card 
                      sx={{ 
                        cursor: 'pointer',
                        '&:hover': { backgroundColor: '#f5f5f5' }
                      }}
                      onClick={() => {
                        if (selectedElements.length > 0) {
                          selectedElements.forEach(id => 
                            addAdvancedAnimation(id, preset.properties)
                          );
                        }
                      }}
                    >
                      <CardContent>
                        <Typography variant="h6">{preset.name}</Typography>
                        <Typography variant="body2" color="text.secondary">
                          {preset.type} • {preset.properties.duration}ms
                        </Typography>
                        <Typography variant="caption">
                          {preset.properties.easing}
                        </Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                ))}
              </Grid>

              <Divider sx={{ my: 3 }} />
              
              <Typography variant="h6" sx={{ mb: 2 }}>Easing Functions</Typography>
              <Grid container spacing={1}>
                {easingFunctions.map((easing) => (
                  <Grid size={{ xs: 6, md: 3 }} key={easing.id}>
                    <Button
                      variant="outlined"
                      size="small"
                      fullWidth
                      onClick={() => {
                        // Apply easing to selected animations
                        console.log('Apply easing:', easing.function);
                      }}
                    >
                      {easing.name}
                    </Button>
                  </Grid>
                ))}
              </Grid>

              <Divider sx={{ my: 3 }} />
              
              <Typography variant="h6" sx={{ mb: 2 }}>Advanced Effects</Typography>
              <Grid container spacing={2}>
                <Grid size={{ xs: 12, md: 6 }}>
                  <Card>
                    <CardContent>
                      <Typography variant="h6">Parallax Effects</Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        Add depth with parallax scrolling
                      </Typography>
                      <ButtonGroup>
                        <Button 
                          size="small"
                          onClick={() => selectedElements.forEach(id => 
                            addParallaxEffect(id, { speed: 0.5, direction: 'vertical' })
                          )}
                        >
                          Slow Parallax
                        </Button>
                        <Button 
                          size="small"
                          onClick={() => selectedElements.forEach(id => 
                            addParallaxEffect(id, { speed: 0.8, direction: 'vertical' })
                          )}
                        >
                          Fast Parallax
                        </Button>
                      </ButtonGroup>
                    </CardContent>
                  </Card>
                </Grid>
                
                <Grid size={{ xs: 12, md: 6 }}>
                  <Card>
                    <CardContent>
                      <Typography variant="h6">Particle Systems</Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        Add dynamic particle effects
                      </Typography>
                      <ButtonGroup>
                        <Button 
                          size="small"
                          onClick={() => selectedElements.forEach(id => 
                            addParticleSystem(id, { count: 30, behavior: 'float' })
                          )}
                        >
                          Float Particles
                        </Button>
                        <Button 
                          size="small"
                          onClick={() => selectedElements.forEach(id => 
                            addParticleSystem(id, { count: 50, behavior: 'explode' })
                          )}
                        >
                          Explode Particles
                        </Button>
                      </ButtonGroup>
                    </CardContent>
                  </Card>
                </Grid>
              </Grid>
            </Box>

            {/* Google Services Tab */}
            <Box sx={{ display: activeTab === 4 ? 'block' : 'none' }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Google Services Integration</Typography>
              
              <Grid container spacing={2} sx={{ mb: 3 }}>
                <Grid size={{ xs: 12, md: 6 }}>
                  <Card>
                    <CardContent>
                      <Typography variant="h6" sx={{ mb: 2 }}>Google Drive</Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        Import files from Google Drive
                      </Typography>
                      <Button 
                        variant={googleServices.drive ? "contained" : "outlined"}
                        onClick={loadGoogleDriveFiles}
                        disabled={!googleServices.drive}
                        startIcon={<CloudUpload />}
                      >
                        {googleServices.drive ? 'Load Drive Files' : 'Drive Not Available'}
                      </Button>
                      {googleDriveFiles.length > 0 && (
                        <Button 
                          variant="contained" 
                          onClick={() => createScrollStoryFromGoogle('drive', googleDriveFiles)}
                          sx={{ ml: 1 }}
                        >
                          Create Story ({googleDriveFiles.length})
                        </Button>
                      )}
                    </CardContent>
                  </Card>
                </Grid>
                
                <Grid size={{ xs: 12, md: 6 }}>
                  <Card>
                    <CardContent>
                      <Typography variant="h6" sx={{ mb: 2 }}>Google Photos</Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        Import photos from Google Photos
                      </Typography>
                      <Button 
                        variant={googleServices.photos ? "contained" : "outlined"}
                        onClick={loadGooglePhotos}
                        disabled={!googleServices.photos}
                        startIcon={<Image />}
                      >
                        {googleServices.photos ? 'Load Photos' : 'Photos Not Available'}
                      </Button>
                      {googlePhotos.length > 0 && (
                        <Button 
                          variant="contained" 
                          onClick={() => createScrollStoryFromGoogle('photos', googlePhotos)}
                          sx={{ ml: 1 }}
                        >
                          Create Story ({googlePhotos.length})
                        </Button>
                      )}
                    </CardContent>
                  </Card>
                </Grid>
                
                <Grid size={{ xs: 12, md: 6 }}>
                  <Card>
                    <CardContent>
                      <Typography variant="h6" sx={{ mb: 2 }}>YouTube</Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        Import videos from YouTube
                      </Typography>
                      <Button 
                        variant={googleServices.youtube ? "contained" : "outlined"}
                        onClick={loadYouTubeVideos}
                        disabled={!googleServices.youtube}
                        startIcon={<PlayArrow />}
                      >
                        {googleServices.youtube ? 'Load Videos' : 'YouTube Not Available'}
                      </Button>
                      {youtubeVideos.length > 0 && (
                        <Button 
                          variant="contained" 
                          onClick={() => createScrollStoryFromGoogle('videos', youtubeVideos)}
                          sx={{ ml: 1 }}
                        >
                          Create Story ({youtubeVideos.length})
                        </Button>
                      )}
                    </CardContent>
                  </Card>
                </Grid>
                
                <Grid size={{ xs: 12, md: 6 }}>
                  <Card>
                    <CardContent>
                      <Typography variant="h6" sx={{ mb: 2 }}>Google Docs</Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        Import documents from Google Docs
                      </Typography>
                      <Button 
                        variant={googleServices.docs ? "contained" : "outlined"}
                        onClick={loadGoogleDocs}
                        disabled={!googleServices.docs}
                        startIcon={<Description />}
                      >
                        {googleServices.docs ? 'Load Docs' : 'Docs Not Available'}
                      </Button>
                      {googleDocs.length > 0 && (
                        <Button 
                          variant="contained" 
                          onClick={() => createScrollStoryFromGoogle('docs', googleDocs)}
                          sx={{ ml: 1 }}
                        >
                          Create Story ({googleDocs.length})
                        </Button>
                      )}
                    </CardContent>
                  </Card>
                </Grid>
              </Grid>

              <Divider sx={{ my: 3 }} />
              
              <Typography variant="h6" sx={{ mb: 2 }}>Note Editor Integration</Typography>
              <Box sx={{ 
                border: '1px solid #e0e0e0', 
                borderRadius: 1, 
                p: 2,
                backgroundColor: '#f9f9f9'
              }}>
                <NoteEditor
                  value="<p>Create rich text content for your scroll stories...</p>"
                  onChange={(html) => {
                    // Handle note editor changes with unified workflow integration
                    onProjectUpdate?.({
                      ...selectedProject,
                      id: selectedProject?.id || 'unknown',
                      name: selectedProject?.name || 'Unknown Project',
                      description: selectedProject?.description || 'No description available',
                      status: selectedProject?.status || 'in-progress',
                      clientId: selectedProject?.clientId || 'default',
                      dueDate: selectedProject?.dueDate || new Date(),
                      priority: selectedProject?.priority || 'medium',
                      tags: selectedProject?.tags || [],
                      lastNoteUpdate: new Date().toISOString(),
                      noteContent: html
                    });
                    
                    onWorklogCreate?.({
                      id: `note_updated_${Date.now()}`,
                      projectId: selectedProject?.id || 'unknown',
                      task: 'Content Update',
                      description: 'Updated scroll story content in NoteEditor',
                      timeSpent: 5,
                      date: new Date(),
                      status: 'completed',
                      tags: ['content', 'update']
                    });
                    
                    onNotificationCreate?.({
                      id: `note_updated_${Date.now()}`,
                      type: 'note_updated',
                      title: 'Content Updated',
                      message: 'Scroll story content has been updated',
                      priority: 'low',
                      source: 'visual_editor',
                      timestamp: new Date().toISOString()
                    });
                  }}
                  placeholder="Write your scroll story content here..."
                />
              </Box>
            </Box>

            {/* Performance Tab */}
            <Box sx={{ display: activeTab === 5 ? 'block' : 'none' }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Performance Monitor</Typography>
              
              <Box sx={{ mb: 3 }}>
                <Button 
                  variant="contained" 
                  onClick={optimizePerformance}
                  startIcon={<Speed />}
                >
                  Analyze Performance
                </Button>
              </Box>

              {Object.keys(performanceMetrics).length > 0 && (
                <Grid container spacing={2}>
                  <Grid size={{ xs: 12, md: 3 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="primary">
                          {performanceMetrics.totalAnimations}
                        </Typography>
                        <Typography variant="body2">Total Animations</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                  
                  <Grid size={{ xs: 12, md: 3 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="success.main">
                          {performanceMetrics.gpuAccelerated}
                        </Typography>
                        <Typography variant="body2">GPU Accelerated</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                  
                  <Grid size={{ xs: 12, md: 3 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="warning.main">
                          {performanceMetrics.memoryUsage}MB
                        </Typography>
                        <Typography variant="body2">Memory Usage</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                  
                  <Grid size={{ xs: 12, md: 3 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="info.main">
                          {performanceMetrics.fps}
                        </Typography>
                        <Typography variant="body2">FPS</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                </Grid>
              )}

              {performanceMetrics.recommendations && performanceMetrics.recommendations.length > 0 && (
                <Box sx={{ mt: 3 }}>
                  <Typography variant="h6" sx={{ mb: 2 }}>Recommendations</Typography>
                  {performanceMetrics.recommendations.map((rec: string, index: number) => (
                    <Alert key={index} severity="info" sx={{ mb: 1 }}>
                      {rec}
                    </Alert>
                  ))}
                </Box>
              )}

              <Box sx={{ mt: 3 }}>
                <FormControlLabel
                  control={
                    <Switch
                      checked={reducedMotion}
                      onChange={(e) => setReducedMotion(e.target.checked)}
                    />
                  }
                  label="Respect Reduced Motion Preference"
                />
                <Typography variant="caption" display="block" color="text.secondary">
                  Automatically disable animations for users with motion sensitivity
                </Typography>
              </Box>
            </Box>

            {/* Preview Tab */}
            <Box sx={{ display: activeTab === 6 ? 'block' : 'none' }}>
              <Typography variant="h6" sx={{ mb: 2 }}>Scroll Preview</Typography>
              
              <Box sx={{ 
                height: 400, 
                border: '2px dashed #ccc', 
                borderRadius: 1,
                display: 'flex',
                flexDirection: 'column',
                alignItems: 'center',
                justifyContent: 'center',
                backgroundColor: '#f9f9f9'
              }}>
                <Typography variant="h6" sx={{ mb: 2 }}>
                  Scroll Story Preview
                </Typography>
                <Typography variant="body2" color="text.secondary" sx={{ mb: 3 }}>
                  Preview your scroll-triggered animations
                </Typography>
                
                <ButtonGroup>
                  <Button 
                    variant="contained"
                    startIcon={<PlayArrow />}
                    onClick={previewStory}
                    disabled={isScrollPreview}
                  >
                    {isScrollPreview ? 'Playing...' : 'Preview'}
                  </Button>
                  <Button 
                    variant="outlined"
                    startIcon={<Stop />}
                    onClick={stopPreview}
                  >
                    Stop
                  </Button>
                </ButtonGroup>
                
                {isScrollPreview && (
                  <Box sx={{ mt: 2, width: '100%', px: 2 }}>
                    <LinearProgress variant="determinate" value={scrollProgress * 100} />
                    <Typography variant="caption" sx={{ mt: 1, display: 'block' }}>
                      Progress: {Math.round(scrollProgress * 100)}%
                    </Typography>
                  </Box>
                )}
              </Box>
            </Box>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setCodeGenerationOpen(false)}>Close</Button>
          <Button 
            variant="contained" 
            onClick={exportScrollStory}
            disabled={!currentStory}
          >
            Export Story
          </Button>
        </DialogActions>
      </Dialog>

      {/* PDF Import Dialog */}
      <Dialog 
        open={pdfImportOpen} 
        onClose={() => setPdfImportOpen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>
          <Box display="flex" alignItems="center" gap={1}>
            CloudUpload
            Import PDF for ScrollStories
          </Box>
        </DialogTitle>
        <DialogContent>
          <Box sx={{ mt: 2 }}>
            <Typography variant="body1" sx={{ mb: 3 }}>
              Upload a PDF file to automatically create a scroll story with page-by-page animations.
            </Typography>
            
            {!importedPdf ? (
              <Box sx={{ 
                border: '2px dashed #ccc', 
                borderRadius: 2, 
                p: 4, 
                textAlign: 'center',
                backgroundColor: '#f9f9f9'
              }}>
                <CloudUpload sx={{ fontSize: 48, color: '#666', mb: 2 }} />
                <Typography variant="h6" sx={{ mb: 1 }}>
                  Choose PDF File
                </Typography>
                <Typography variant="body2" color="text.secondary" sx={{ mb: 3 }}>
                  Select a PDF file to convert into an interactive scroll story
                </Typography>
                
                <input
                  type="file"
                  accept=".pdf"
                  onChange={handlePdfFileUpload}
                  style={{ display: 'none' }}
                  id="pdf-upload-input"
                />
                <label htmlFor="pdf-upload-input">
                  <Button 
                    variant="contained" 
                    component="span"
                    startIcon={<CloudUpload />}
                    disabled={isProcessingPdf}
                  >
                    {isProcessingPdf ? 'Processing...' : 'Select PDF File'}
                  </Button>
                </label>
                
                {isProcessingPdf && (
                  <Box sx={{ mt: 2 }}>
                    <LinearProgress 
                      variant="determinate" 
                      value={pdfImportProgress} 
                      sx={{ mb: 1 }}
                    />
                    <Typography variant="caption">
                      Processing PDF... {pdfImportProgress}%
                    </Typography>
                  </Box>
                )}
              </Box>
            ) : (
              <Box>
                <Typography variant="h6" sx={{ mb: 2 }}>
                  PDF Imported Successfully!
                </Typography>
                
                <Grid container spacing={2} sx={{ mb: 3 }}>
                  <Grid size={{ xs: 12, md: 4 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="primary">
                          {pdfPages.length}
                        </Typography>
                        <Typography variant="body2">Pages</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                  <Grid size={{ xs: 12, md: 4 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="success.main">
                          {pdfTextContent.length}
                        </Typography>
                        <Typography variant="body2">Text Blocks</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                  <Grid size={{ xs: 12, md: 4 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="info.main">
                          {pdfImages.length}
                        </Typography>
                        <Typography variant="body2">Images</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                </Grid>

                <Typography variant="h6" sx={{ mb: 2 }}>Preview</Typography>
                <Box sx={{ 
                  maxHeight: 300, 
                  overflow: 'auto', 
                  border: '1px solid #e0e0e0', 
                  borderRadius: 1,
                  p: 2
                }}>
                  {pdfPages.map((page, index) => (
                    <Box key={page.id} sx={{ mb: 2, p: 2, backgroundColor: '#f5f5f5', borderRadius: 1 }}>
                      <Typography variant="subtitle2" sx={{ mb: 1 }}>
                        Page {page.number}
                      </Typography>
                      <Typography variant="body2" color="text.secondary">
                        {page.content}
                      </Typography>
                      {page.elements.map((element: any) => (
                        <Box key={element.id} sx={{ mt: 1, fontSize: '0.875rem' }}>
                          • {element.type}: {element.content || 'Image'}
                        </Box>
                      ))}
                    </Box>
                  ))}
                </Box>
              </Box>
            )}
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setPdfImportOpen(false)}>
            Cancel
          </Button>
          {importedPdf && (
            <Button 
              variant="contained" 
              onClick={createScrollStoryFromPdf}
              startIcon={<ViewStream />}
            >
              Create Scroll Story
            </Button>
          )}
        </DialogActions>
      </Dialog>

      {/* Multimedia Import Dialog */}
      <Dialog 
        open={mediaImportOpen} 
        onClose={() => setMediaImportOpen(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>
          <Box display="flex" alignItems="center" gap={1}>
            Image
            Import Multimedia for ScrollStories
          </Box>
        </DialogTitle>
        <DialogContent>
          <Box sx={{ mt: 2 }}>
            <Typography variant="body1" sx={{ mb: 3 }}>
              Upload images, videos, audio files, and documents to create rich multimedia scroll stories.
            </Typography>
            
            {importedMedia.length === 0 ? (
              <Box sx={{ 
                border: '2px dashed #ccc', 
                borderRadius: 2, 
                p: 4, 
                textAlign: 'center',
                backgroundColor: '#f9f9f9'
              }}>
                <Image sx={{ fontSize: 48, color: '#666', mb: 2 }} />
                <Typography variant="h6" sx={{ mb: 1 }}>
                  Choose Media Files
                </Typography>
                <Typography variant="body2" color="text.secondary" sx={{ mb: 3 }}>
                  Select multiple files to create an interactive multimedia scroll story
                </Typography>
                
                <input
                  type="file"
                  accept="image/*,video/*,audio/*,.pdf,.doc,.docx"
                  multiple
                  onChange={handleMediaFileUpload}
                  style={{ display: 'none' }}
                  id="media-upload-input"
                />
                <label htmlFor="media-upload-input">
                  <Button 
                    variant="contained" 
                    component="span"
                    startIcon={<Image />}
                    disabled={isProcessingMedia}
                  >
                    {isProcessingMedia ? 'Processing...' : 'Select Media Files'}
                  </Button>
                </label>
                
                {isProcessingMedia && (
                  <Box sx={{ mt: 2 }}>
                    <LinearProgress 
                      variant="determinate" 
                      value={mediaImportProgress} 
                      sx={{ mb: 1 }}
                    />
                    <Typography variant="caption">
                      Processing media... {Math.round(mediaImportProgress)}%
                    </Typography>
                  </Box>
                )}
              </Box>
            ) : (
              <Box>
                <Typography variant="h6" sx={{ mb: 2 }}>
                  Media Imported Successfully!
                </Typography>
                
                <Grid container spacing={2} sx={{ mb: 3 }}>
                  <Grid size={{ xs: 12, md: 3 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="primary">
                          {mediaTypes.images.length}
                        </Typography>
                        <Typography variant="body2">Images</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                  <Grid size={{ xs: 12, md: 3 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="success.main">
                          {mediaTypes.videos.length}
                        </Typography>
                        <Typography variant="body2">Videos</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                  <Grid size={{ xs: 12, md: 3 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="info.main">
                          {mediaTypes.audio.length}
                        </Typography>
                        <Typography variant="body2">Audio</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                  <Grid size={{ xs: 12, md: 3 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h4" color="warning.main">
                          {mediaTypes.documents.length}
                        </Typography>
                        <Typography variant="body2">Documents</Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                </Grid>

                <Typography variant="h6" sx={{ mb: 2 }}>Media Preview</Typography>
                <Box sx={{ 
                  maxHeight: 400, 
                  overflow: 'auto', 
                  border: '1px solid #e0e0e0', 
                  borderRadius: 1,
                  p: 2
                }}>
                  <Grid container spacing={2}>
                    {importedMedia.map((media, index) => (
                      <Grid size={{ xs: 12, md: 6 }} key={media.id}>
                        <Card sx={{ height: '100%' }}>
                          <CardMedia
                            component="img"
                            height="120"
                            image={media.thumbnail}
                            alt={media.name}
                            sx={{ objectFit: 'cover' }}
                          />
                          <CardContent>
                            <Typography variant="subtitle2" noWrap>
                              {media.name}
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              {media.type.toUpperCase()} • {(media.size / 1024 / 1024).toFixed(1)}MB
                            </Typography>
                            {media.duration && (
                              <Typography variant="caption" color="text.secondary" display="block">
                                Duration: {Math.round(media.duration)}s
                              </Typography>
                            )}
                            {media.width && media.height && (
                              <Typography variant="caption" color="text.secondary" display="block">
                                {media.width} × {media.height}px
                              </Typography>
                            )}
                          </CardContent>
                        </Card>
                      </Grid>
                    ))}
                  </Grid>
                </Box>
              </Box>
            )}
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setMediaImportOpen(false)}>
            Cancel
          </Button>
          {importedMedia.length > 0 && (
            <Button 
              variant="contained" 
              onClick={createScrollStoryFromMedia}
              startIcon={<ViewStream />}
            >
              Create Media Story
            </Button>
          )}
        </DialogActions>
      </Dialog>

      {/* ✅ Quality Analysis Dialog (from CompleteDeploymentManager) */}
      <Dialog 
        open={showAnalysisDialog}
        onClose={handleCloseAnalysisDialog}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>
          <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
            <Science />
            Quality Analysis - CreatorhubVisualEditor
          </Box>
        </DialogTitle>
        <DialogContent>
          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
            <Box>
              <Typography variant="h6" gutterBottom>
                🔍 Comprehensive Quality Analysis
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Analyze code quality, type safety, security, and performance
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', gap: 2 }}>
              <Button
                variant="outlined"
                startIcon={<Refresh />}
                onClick={handleRunQualityAnalysis}
                disabled={analysisLoading}
              >
                {analysisLoading ? 'Analyzing...' : 'Run Analysis'}
              </Button>
            </Box>
          </Box>

          {/* Overall Quality Score */}
          {qualityAnalysis && (
            <Card sx={{ mb: 3 }}>
              <CardContent>
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 2 }}>
                  <Box sx={{ 
                    width: 80, 
                    height: 80, 
                    borderRadius: '50%', 
                    display: 'flex', 
                    alignItems: 'center', 
                    justifyContent: 'center',
                  bgcolor: (qualityAnalysis?.overallScore ?? 0) >= 8 ? 'success.light' : 
                           (qualityAnalysis?.overallScore ?? 0) >= 6 ? 'warning.light' : 'error.light',
                  color: (qualityAnalysis?.overallScore ?? 0) >= 8 ? 'success.contrastText' : 
                         (qualityAnalysis?.overallScore ?? 0) >= 6 ? 'warning.contrastText' : 'error.contrastText'
                  }}>
                    <Typography variant="h4" sx={{ fontWeight: 'bold' }}>
                      {qualityAnalysis?.overallScore.toFixed(1)}
                    </Typography>
                  </Box>
                  <Box>
                    <Typography variant="h5" sx={{ fontWeight: 600 }}>
                      Overall Quality Score
                    </Typography>
                    <Typography variant="body2" color="text.secondary">
                      Last analyzed: {qualityAnalysis?.lastAnalyzed ? new Date(qualityAnalysis?.lastAnalyzed || new Date()).toLocaleString() : 'Never'}
                    </Typography>
                  </Box>
                </Box>

                {/* Quality Categories */}
                <Grid container spacing={2}>
                  {qualityAnalysis?.categories && Object.entries(qualityAnalysis?.categories || {}).map(([category, data]) => (
                    <Grid size={{ xs: 12, sm: 6, md: 4 }} key={category}>
                      <Card sx={{ 
                        border: 1, 
                        borderColor: data.score >= 8 ? 'success.main' : 
                                     data.score >= 6 ? 'warning.main' : 'error.main',
                        bgcolor: data.score >= 8 ? 'success.light' : 
                                 data.score >= 6 ? 'warning.light' : 'error.light'
                      }}>
                        <CardContent sx={{ p: 2 }}>
                          <Typography variant="h6" sx={{ 
                            textTransform: 'capitalize', 
                            fontWeight: 600,
                            color: data.score >= 8 ? 'success.contrastText' : 
                                   data.score >= 6 ? 'warning.contrastText' : 'error.contrastText'
                          }}>
                            {category.replace(/([A-Z])/g, ' $1').trim()}
                          </Typography>
                          <Typography variant="h4" sx={{ 
                            fontWeight: 'bold',
                            color: data.score >= 8 ? 'success.contrastText' : 
                                   data.score >= 6 ? 'warning.contrastText' : 'error.contrastText'
                          }}>
                            {data.score.toFixed(1)}/10
                          </Typography>
                          <Typography variant="body2" sx={{ 
                            color: data.score >= 8 ? 'success.contrastText' : 
                                   data.score >= 6 ? 'warning.contrastText' : 'error.contrastText'
                          }}>
                            {data.issues.length} issues found
                          </Typography>
                        </CardContent>
                      </Card>
                    </Grid>
                  ))}
                </Grid>
              </CardContent>
            </Card>
          )}

          {/* Critical Issues */}
          {qualityAnalysis?.criticalIssues && (qualityAnalysis?.criticalIssues?.length ?? 0) > 0 && (
            <Card sx={{ mb: 3, border: 1, borderColor: 'error.main' }}>
              <CardContent>
                <Typography variant="h6" color="error" sx={{ mb: 2, display: 'flex', alignItems: 'center', gap: 1 }}>
                  <Error />
                  Critical Issues ({qualityAnalysis?.criticalIssues?.length || 0})
                </Typography>
                <List dense>
                  {qualityAnalysis?.criticalIssues?.map((issue, index) => (
                    <ListItem key={index}>
                      <ListItemIcon>
                        <Error color="error" />
                      </ListItemIcon>
                      <ListItemText primary={issue} />
                    </ListItem>
                  ))}
                </List>
              </CardContent>
            </Card>
          )}

          {/* Component Analysis */}
          {componentAnalyses.length > 0 && (
            <Card>
              <CardContent>
                <Typography variant="h6" gutterBottom>
                  📊 Component Analysis Results
                </Typography>
                <TableContainer>
                  <Table>
                    <TableHead>
                      <TableRow>
                        <TableCell>Component</TableCell>
                        <TableCell>Score</TableCell>
                        <TableCell>Type Safety</TableCell>
                        <TableCell>Security</TableCell>
                        <TableCell>Performance</TableCell>
                        <TableCell>Error Handling</TableCell>
                        <TableCell>Code Quality</TableCell>
                      </TableRow>
                    </TableHead>
                    <TableBody>
                      {componentAnalyses.map((analysis, index) => (
                        <TableRow key={index}>
                          <TableCell>
                            <Typography variant="body2" sx={{ fontWeight: 500 }}>
                              {analysis.componentName}
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              {analysis.filePath}
                            </Typography>
                          </TableCell>
                          <TableCell>
                            <Chip
                              label={`${analysis.score.toFixed(1)}/10`}
                              color={analysis.score >= 8 ? 'success' : analysis.score >= 6 ? 'warning' : 'error'}
                              size="small"
                            />
                          </TableCell>
                          <TableCell>
                            <Typography variant="body2" color={analysis.issues.typeSafety.length === 0 ? 'success.main' : 'error.main'}>
                              {analysis.issues.typeSafety.length} issues
                            </Typography>
                          </TableCell>
                          <TableCell>
                            <Typography variant="body2" color={analysis.issues.security.length === 0 ? 'success.main' : 'error.main'}>
                              {analysis.issues.security.length} issues
                            </Typography>
                          </TableCell>
                          <TableCell>
                            <Typography variant="body2" color={analysis.issues.performance.length === 0 ? 'success.main' : 'error.main'}>
                              {analysis.issues.performance.length} issues
                            </Typography>
                          </TableCell>
                          <TableCell>
                            <Typography variant="body2" color={analysis.issues.errorHandling.length === 0 ? 'success.main' : 'error.main'}>
                              {analysis.issues.errorHandling.length} issues
                            </Typography>
                          </TableCell>
                          <TableCell>
                            <Typography variant="body2" color={analysis.issues.codeQuality.length === 0 ? 'success.main' : 'error.main'}>
                              {analysis.issues.codeQuality.length} issues
                            </Typography>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </TableContainer>
              </CardContent>
            </Card>
          )}

          {/* Recommendations */}
          {qualityAnalysis?.recommendations && (qualityAnalysis?.recommendations?.length ?? 0) > 0 && (
            <Card sx={{ mt: 3 }}>
              <CardContent>
                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                  <Lightbulb color="primary" />
                  Recommendations ({qualityAnalysis?.recommendations?.length || 0})
                </Typography>
                <List>
                  {qualityAnalysis?.recommendations?.map((recommendation, index) => (
                    <ListItem key={index}>
                      <ListItemIcon>
                        <Lightbulb color="primary" />
                      </ListItemIcon>
                      <ListItemText primary={recommendation} />
                    </ListItem>
                  ))}
                </List>
              </CardContent>
            </Card>
          )}

          {!qualityAnalysis && (
            <Card>
              <CardContent sx={{ textAlign: 'center', py: 4 }}>
                <Science sx={{ fontSize: 64, color: 'text.secondary', mb: 2 }} />
                <Typography variant="h6" gutterBottom>
                  Ready to Analyze Code Quality
                </Typography>
                <Typography variant="body2" color="text.secondary" sx={{ mb: 3 }}>
                  Run a comprehensive analysis to check type safety, security, performance, and code quality
                </Typography>
                <Button
                  variant="contained"
                  startIcon={<Science />}
                  onClick={handleRunQualityAnalysis}
                  size="large"
                >
                  Start Quality Analysis
                </Button>
              </CardContent>
            </Card>
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={handleCloseAnalysisDialog}>
            Close
          </Button>
        </DialogActions>
      </Dialog>

      {/* Advanced SEO Dashboard Dialog */}
      <Dialog 
        open={showSeoDashboard} 
        onClose={() => setShowSeoDashboard(false)}
        maxWidth="xl"
        fullWidth
      >
        <DialogTitle>
          <Box display="flex" alignItems="center" gap={2}>
            <SearchIcon />
            <Typography variant="h5">Advanced SEO Dashboard</Typography>
            {seoCrawlResult && (
              <Chip 
                label={`${seoCrawlResult?.totalPages || 0} pages crawled`}
                color="primary"
                variant="outlined"
              />
            )}
          </Box>
        </DialogTitle>
        
        <DialogContent>
          {isCrawling && (
            <Card sx={{ mb: 3 }}>
              <CardContent>
                <Box display="flex" alignItems="center" gap={2}>
                  <CircularProgress />
                  <Typography>Crawling website...</Typography>
                </Box>
                <LinearProgress 
                  variant="determinate" 
                  value={crawlProgress} 
                  sx={{ mt: 2 }}
                />
                <Typography variant="body2" sx={{ mt: 1 }}>
                  {crawlProgress}% complete
                </Typography>
              </CardContent>
            </Card>
          )}

          {!isCrawling && !seoCrawlResult && (
            <Card>
              <CardContent>
                <Typography variant="h6" gutterBottom>
                  Start SEO Crawl
                </Typography>
                <Box display="flex" gap={2} alignItems="center">
                  <TextField
                    label="Website URL"
                    value={crawlUrl}
                    onChange={(e) => setCrawlUrl(e.target.value)}
                    placeholder="https://example.com"
                    fullWidth
                    variant="outlined"
                  />
                  <Button
                    variant="contained"
                    onClick={() => crawlWebsite(crawlUrl)}
                    disabled={!crawlUrl || isCrawling}
                    startIcon={<SearchIcon />}
                  >
                    Start Crawl
                  </Button>
                </Box>
              </CardContent>
            </Card>
          )}

          {seoCrawlResult && (
            <Box>
              {/* SEO Tabs */}
              <Tabs 
                value={activeSeoTab} 
                onChange={(e, newValue) => setActiveSeoTab(newValue)}
                sx={{ mb: 3 }}
              >
                <Tab label="Overview" />
                <Tab label="Technical SEO" />
                <Tab label="Content Analysis" />
                <Tab label="Performance" />
                <Tab label="Issues" />
                <Tab label="Site Architecture" />
              </Tabs>

              {/* Overview Tab */}
              {activeSeoTab === 0 && (
                <Grid container spacing={3}>
                  <Grid size={{ xs: 12, md: 4 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" color="primary">
                          📊 Crawl Summary
                        </Typography>
                        <Box sx={{ mt: 2 }}>
                          <Typography variant="h4" color="primary">
                            {seoCrawlResult?.totalPages || 0}
                          </Typography>
                          <Typography variant="body2">Pages Crawled</Typography>
                        </Box>
                        <Box sx={{ mt: 2 }}>
                          <Typography variant="h4" color="error">
                            {seoCrawlResult?.issues?.filter(i => i.severity === 'critical').length || 0}
                          </Typography>
                          <Typography variant="body2">Critical Issues</Typography>
                        </Box>
                      </CardContent>
                    </Card>
                  </Grid>

                  <Grid size={{ xs: 12, md: 4 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" color="primary">
                          ⚡ Performance
                        </Typography>
                        <Box sx={{ mt: 2 }}>
                          <Typography variant="h4" color="primary">
                            {seoCrawlResult?.performance?.averageLoadTime?.toFixed(0) || '0'}ms
                          </Typography>
                          <Typography variant="body2">Average Load Time</Typography>
                        </Box>
                        <Box sx={{ mt: 2 }}>
                          <Typography variant="h4" color="warning">
                            {seoCrawlResult?.performance?.slowPages?.length || 0}
                          </Typography>
                          <Typography variant="body2">Slow Pages</Typography>
                        </Box>
                      </CardContent>
                    </Card>
                  </Grid>

                  <Grid size={{ xs: 12, md: 4 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" color="primary">
                          🔗 Site Architecture
                        </Typography>
                        <Box sx={{ mt: 2 }}>
                          <Typography variant="h4" color="primary">
                            {seoCrawlResult?.siteArchitecture?.depth || 0}
                          </Typography>
                          <Typography variant="body2">Site Depth</Typography>
                        </Box>
                        <Box sx={{ mt: 2 }}>
                          <Typography variant="h4" color="error">
                            {seoCrawlResult?.siteArchitecture?.brokenLinks?.length || 0}
                          </Typography>
                          <Typography variant="body2">Broken Links</Typography>
                        </Box>
                      </CardContent>
                    </Card>
                  </Grid>
                </Grid>
              )}

              {/* Technical SEO Tab */}
              {activeSeoTab === 1 && (
                <Grid container spacing={3}>
                  <Grid size={{ xs: 12, md: 6 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>
                          🤖 Robots.txt Analysis
                        </Typography>
                        <Box sx={{ mb: 2 }}>
                          <Chip 
                            label={seoCrawlResult?.technicalSEO?.robotsTxt?.valid ? 'Valid' : 'Invalid'}
                            color={seoCrawlResult?.technicalSEO?.robotsTxt?.valid ? 'success' : 'error'}
                          />
                        </Box>
                        {(seoCrawlResult?.technicalSEO?.robotsTxt?.directives?.length ?? 0) > 0 && (
                          <Box>
                            <Typography variant="subtitle2">Directives:</Typography>
                            {seoCrawlResult?.technicalSEO?.robotsTxt?.directives?.map((directive, index) => (
                              <Chip key={index} label={directive} size="small" sx={{ mr: 1, mb: 1 }} />
                            ))}
                          </Box>
                        )}
                      </CardContent>
                    </Card>
                  </Grid>

                  <Grid size={{ xs: 12, md: 6 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>
                          🗺️ Sitemaps
                        </Typography>
                        <Box sx={{ mb: 2 }}>
                          <Typography variant="body2">
                            Found: {seoCrawlResult?.technicalSEO?.sitemaps?.found?.length || 0}
                          </Typography>
                          <Typography variant="body2">
                            Valid: {seoCrawlResult?.technicalSEO?.sitemaps?.valid?.length || 0}
                          </Typography>
                        </Box>
                        {(seoCrawlResult?.technicalSEO?.sitemaps?.found?.length ?? 0) > 0 && (
                          <Box>
                            {seoCrawlResult?.technicalSEO?.sitemaps?.found?.map((sitemap, index) => (
                              <Typography key={index} variant="body2" sx={{ mb: 1 }}>
                                • {sitemap}
                              </Typography>
                            ))}
                          </Box>
                        )}
                      </CardContent>
                    </Card>
                  </Grid>

                  <Grid size={{ xs: 12 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>
                          📋 Structured Data (Schema.org)
                        </Typography>
                        <Grid container spacing={2}>
                          <Grid size={{ xs: 6 }}>
                            <Box textAlign="center">
                              <Typography variant="h4" color="success">
                                {seoCrawlResult?.technicalSEO?.schemaValidation?.valid || 0}
                              </Typography>
                              <Typography variant="body2">Valid Schemas</Typography>
                            </Box>
                          </Grid>
                          <Grid size={{ xs: 6 }}>
                            <Box textAlign="center">
                              <Typography variant="h4" color="error">
                                {seoCrawlResult?.technicalSEO?.schemaValidation?.invalid || 0}
                              </Typography>
                              <Typography variant="body2">Invalid Schemas</Typography>
                            </Box>
                          </Grid>
                        </Grid>
                      </CardContent>
                    </Card>
                  </Grid>
                </Grid>
              )}

              {/* Content Analysis Tab */}
              {activeSeoTab === 2 && (
                <Grid container spacing={3}>
                  <Grid size={{ xs: 12, md: 6 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>
                          📝 Title Issues
                        </Typography>
                        {(seoCrawlResult?.contentAnalysis?.titleIssues?.length ?? 0) > 0 ? (
                          <List dense>
                            {seoCrawlResult?.contentAnalysis?.titleIssues?.slice(0, 5).map((issue, index) => (
                              <ListItem key={index}>
                                <ListItemText
                                  primary={issue.url}
                                  secondary={issue.issue}
                                />
                              </ListItem>
                            ))}
                          </List>
                        ) : (
                          <Typography color="success">No title issues found</Typography>
                        )}
                      </CardContent>
                    </Card>
                  </Grid>

                  <Grid size={{ xs: 12, md: 6 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>
                          📄 Meta Description Issues
                        </Typography>
                        {(seoCrawlResult?.contentAnalysis?.metaDescriptionIssues?.length ?? 0) > 0 ? (
                          <List dense>
                            {seoCrawlResult?.contentAnalysis?.metaDescriptionIssues?.slice(0, 5).map((issue, index) => (
                              <ListItem key={index}>
                                <ListItemText
                                  primary={issue.url}
                                  secondary={issue.issue}
                                />
                              </ListItem>
                            ))}
                          </List>
                        ) : (
                          <Typography color="success">No meta description issues found</Typography>
                        )}
                      </CardContent>
                    </Card>
                  </Grid>

                  <Grid size={{ xs: 12 }}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>
                          🔄 Duplicate Content
                        </Typography>
                        {(seoCrawlResult?.contentAnalysis?.duplicateContent?.length ?? 0) > 0 ? (
                          <List dense>
                            {seoCrawlResult?.contentAnalysis?.duplicateContent?.map((dup, index) => (
                              <ListItem key={index}>
                                <ListItemText
                                  primary={`Similarity: ${(dup.similarity * 100).toFixed(1)}%`}
                                  secondary={dup.urls.join(', ')}
                                />
                              </ListItem>
                            ))}
                          </List>
                        ) : (
                          <Typography color="success">No duplicate content found</Typography>
                        )}
                      </CardContent>
                    </Card>
                  </Grid>
                </Grid>
              )}

              {/* Issues Tab */}
              {activeSeoTab === 4 && (
                <Box>
                  <Box display="flex" gap={2} sx={{ mb: 3 }}>
                    <FormControl size="small">
                      <InputLabel>Severity</InputLabel>
                      <Select
                        value={seoFilters.severity}
                        onChange={(e) => setSeoFilters(prev => ({ ...prev, severity: e.target.value }))}
                        label="Severity"
                      >
                        <MenuItem value="all">All</MenuItem>
                        <MenuItem value="critical">Critical</MenuItem>
                        <MenuItem value="high">High</MenuItem>
                        <MenuItem value="medium">Medium</MenuItem>
                        <MenuItem value="low">Low</MenuItem>
                      </Select>
                    </FormControl>

                    <FormControl size="small">
                      <InputLabel>Category</InputLabel>
                      <Select
                        value={seoFilters.category}
                        onChange={(e) => setSeoFilters(prev => ({ ...prev, category: e.target.value }))}
                        label="Category"
                      >
                        <MenuItem value="all">All</MenuItem>
                        <MenuItem value="technical">Technical</MenuItem>
                        <MenuItem value="content">Content</MenuItem>
                        <MenuItem value="performance">Performance</MenuItem>
                        <MenuItem value="accessibility">Accessibility</MenuItem>
                        <MenuItem value="structured-data">Structured Data</MenuItem>
                      </Select>
                    </FormControl>
                  </Box>

                  <List>
                    {seoIssues
                      .filter(issue => 
                        (seoFilters.severity === 'all' || issue.severity === seoFilters.severity) &&
                        (seoFilters.category === 'all' || issue.category === seoFilters.category)
                      )
                      .map((issue, index) => (
                        <Card key={index} sx={{ mb: 2 }}>
                          <CardContent>
                            <Box display="flex" alignItems="center" gap={2} sx={{ mb: 1 }}>
                              <Chip 
                                label={issue.severity}
                                color={
                                  issue.severity === 'critical' ? 'error' :
                                  issue.severity === 'high' ? 'warning' :
                                  issue.severity === 'medium' ? 'info' : 'default'
                                }
                                size="small"
                              />
                              <Chip 
                                label={issue.category}
                                variant="outlined"
                                size="small"
                              />
                              <Typography variant="h6" sx={{ flexGrow: 1 }}>
                                {issue.title}
                              </Typography>
                            </Box>
                            <Typography variant="body2" sx={{ mb: 2 }}>
                              {issue.description}
                            </Typography>
                            <Typography variant="body2" color="text.secondary">
                              Affected pages: {issue.affectedPages.length}
                            </Typography>
                            {issue.fixSuggestion && (
                              <Alert severity="info" sx={{ mt: 2 }}>
                                <Typography variant="body2">
                                  <strong>Fix suggestion:</strong> {issue.fixSuggestion}
                                </Typography>
                              </Alert>
                            )}
                          </CardContent>
                        </Card>
                      ))}
                  </List>
                </Box>
              )}
            </Box>
          )}
        </DialogContent>
        
        <DialogActions>
          <Button onClick={() => setShowSeoDashboard(false)}>
            Close
          </Button>
          {seoCrawlResult && (
            <Button 
              variant="contained" 
              startIcon={<GetApp />}
              onClick={() => {
                // Export SEO report
                const report = {
                  crawlResult: seoCrawlResult,
                  generatedAt: new Date().toISOString(),
                  url: crawlUrl
                };
                const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `seo-report-${new Date().toISOString().split('T')[0]}.json`;
                a.click();
                URL.revokeObjectURL(url);
              }}
            >
              Export Report
            </Button>
          )}
        </DialogActions>
      </Dialog>
    </Box>
  );
}

// Export with error boundary wrapper
// Enhanced CreatorhubVisualEditor with Full Modal System Integration
function CreatorhubVisualEditorWithProviders(props: CreatorhubVisualEditorProps) {
  return (
    <VisualEditorErrorBoundary>
      <ModalProvider>
        <ToolbarProvider>
          <AIModalProvider>
            <ARVRProvider>
              <VoiceGestureProvider>
                <ModalIntegrationProvider enableAutoModals={true} enablePlatformIntegration={true}>
                  <CreatorhubVisualEditorWithModals {...props} />
                </ModalIntegrationProvider>
              </VoiceGestureProvider>
            </ARVRProvider>
          </AIModalProvider>
        </ToolbarProvider>
      </ModalProvider>
    </VisualEditorErrorBoundary>
  );
}

// Original CreatorhubVisualEditor function (without modal system)
function CreatorhubVisualEditor(props: CreatorhubVisualEditorProps) {
  // This is the original implementation without modal system
  // For now, we'll use the modal-enhanced version as the default
  return <CreatorhubVisualEditorWithModals {...props} />;
}

// Backward compatibility - keep original export
export default function CreatorhubVisualEditorWithErrorBoundary(props: CreatorhubVisualEditorProps) {
  return (
    <VisualEditorErrorBoundary>
      <CreatorhubVisualEditor {...props} />
    </VisualEditorErrorBoundary>
  );
}

// Export the enhanced version as well
export { CreatorhubVisualEditorWithProviders };