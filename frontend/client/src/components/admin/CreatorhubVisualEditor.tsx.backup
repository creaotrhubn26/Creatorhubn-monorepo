                      <Button variant="outlined">Export Link Report</Button>
                    </Box>
                  </CardContent>
                </Card>
              </Grid>

              {/* JSON-LD Structured Data */}
              <Grid size={{ xs: 12, md: 6 }}>
                <Card>
                  <CardContent>
                    <Typography variant="h6" sx={{ mb: 2 }}>
                      📋 JSON-LD Structured Data
                    </Typography>
                    <Stack spacing={2}>
                      <Box sx={{ display: 'flex', gap: 1, flexWrap: 'wrap' }}>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => generateJSONLD('organization')}
                        >
                          Organization
                        </Button>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => generateJSONLD('website')}
                        >
                          Website
                        </Button>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => generateJSONLD('breadcrumb')}
                        >
                          Breadcrumb
                        </Button>
                      </Box>
                      <Box sx={{ display: 'flex', gap: 1, flexWrap: 'wrap' }}>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => validateJSONLD()}
                        >
                          Validate JSON-LD
                        </Button>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => previewJSONLD()}
                        >
                          Preview
                        </Button>
                      </Box>
                      {jsonLDData && (
                        <Box sx={{ mt: 2, p: 2, bgcolor: 'grey.50', borderRadius: 1 }}>
                          <Typography variant="subtitle2" sx={{ mb: 1 }}>
                            Generated JSON-LD:
                          </Typography>
                          <pre style={{ fontSize: '12px', overflow: 'auto', maxHeight: '200px' }}>
                            {JSON.stringify(jsonLDData, null, 2)}
                          </pre>
                        </Box>
                      )}
                      {jsonLDValidation && (
                        <Box sx={{ mt: 2, p: 2, bgcolor: jsonLDValidation.valid ? 'success.50' : 'error.50', borderRadius: 1 }}>
                          <Typography variant="subtitle2" sx={{ mb: 1, color: jsonLDValidation.valid ? 'success.main' : 'error.main' }}>
                            {jsonLDValidation.valid ? '✅ Valid JSON-LD' : '❌ Invalid JSON-LD'}
                          </Typography>
                          {jsonLDValidation.errors && jsonLDValidation.errors.length > 0 && (
                            <Box>
                              {jsonLDValidation.errors.map((error: any, index: number) => (
                                <Typography key={index} variant="caption" color="error" display="block">
                                  {error}
                                </Typography>
                              ))}
                            </Box>
                          )}
                        </Box>
                      )}
                    </Stack>
                  </CardContent>
                </Card>
              </Grid>

              {/* Norwegian Market SEO */}
                <Grid size={{ xs: 12 }}>
                <Card>
                  <CardContent>
                    <Typography variant="h6" sx={{ mb: 2 }}>
                      Norwegian Market SEO Optimization
                    </Typography>
                    <Grid container spacing={2}>
                      <Grid size={{ xs: 12, md: 6 }}>
