          <Typography variant="h6" sx={{ mb: 2 }}>
            Asset Library
          </Typography>
          <input
            ref={fileInputRef}
            type="file"
            multiple
            accept="image/*"
            style={{ display: 'none' }}
            onChange={handleFileUpload}
          />
          <Button
            variant="outlined"
            startIcon={<AddIcon />}
            onClick={() => fileInputRef.current?.click()}
            fullWidth
            sx={{ mb: 2 }}
          >
            Upload Assets
          </Button>
          <List>
            {uploadedAssets.map((asset, index) => (
              <ListItem key={index}>
                <ListItemIcon>
                  <ImageIcon />
                </ListItemIcon>
                <ListItemText
