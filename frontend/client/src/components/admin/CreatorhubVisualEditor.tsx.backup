  // Global Guide Assistant handlers
  const handleGuideIntegrationComplete = useCallback((integration: string) => {
    console.log(`Guide integration completed: ${integration}`);
    
    // Update guide context with completed integration
    setGuideContext((prev: VisualEditorGuideContext) => ({
      ...prev,
      integrations: [...(prev.integrations || []), integration]
    }));
    
    // Create notification for integration completion
