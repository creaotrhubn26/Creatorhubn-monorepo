                            <Box key={index} sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', py: 0.5 }}>
                              <Typography variant="body2">{keyword.term}</Typography>
                              <Typography variant="caption" color="text.secondary">
                                Vol: {keyword.volume}
                              </Typography>
                            </Box>
                          ))}
                        </Box>
                      )}
