        <DialogActions>
          <Button onClick={() => {}}>Cancel</Button>
          <Button variant="contained">Export</Button>
        </DialogActions>
      </Dialog>

      {/* Confirmation Dialog - Replaced with Modal System */}
      <Dialog
        open={false}
        onClose={() => {}}
      >
        <DialogTitle>Delete Element</DialogTitle>
