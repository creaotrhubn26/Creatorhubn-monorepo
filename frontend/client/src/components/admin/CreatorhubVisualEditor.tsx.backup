// Integration props for unified workflow connectivity
interface CreatorhubVisualEditorProps {
  // Integration props for unified workflow connectivity
  onMeetingCreate?: (meeting: Meeting) => void;
  onProjectUpdate?: (project: Project) => void;
  onWorklogCreate?: (worklog: Worklog) => void;
  onClientSelect?: (client: Client) => void;
  onClientUpdate?: (client: Client) => void;
  onShowcaseCreate?: (showcase: Showcase) => void;
  onFileUpload?: (file: FileUpload) => void;
  onFileDownload?: (file: FileDownload) => void;
  selectedProject?: Project;
  onProjectSelect?: (project: Project) => void;
  selectedClient?: Client;
  onSettingsUpdate?: (settings: Settings) => void;
  onNotificationCreate?: (notification: Notification) => void;
}

// Enhanced CreatorhubVisualEditor with Modal System Integration
function CreatorhubVisualEditorWithModals({
  onMeetingCreate,
  onProjectUpdate,
  onWorklogCreate,
  onClientSelect,
  onClientUpdate,
  onShowcaseCreate,
  onFileUpload,
  onFileDownload,
  selectedProject,
  onProjectSelect,
  selectedClient,
  onSettingsUpdate,
  onNotificationCreate
}: CreatorhubVisualEditorProps) {
  // Initialize modal system hooks
  const modal = useModal();
  const modalManager = useModalIntegration();
  const { toolbar, guardRails } = useToolbar();
  const aiModal = useAIModal();
  const arvr = useARVR();
  const voiceGesture = useVoiceGesture();
  // const advancedFeatures = useAdvancedFeatures(); // Remove for now

  // Global Guide Assistant state and context
  const [guideContext, setGuideContext] = useState<VisualEditorGuideContext>({
    selectedElement: undefined,
    currentProject: selectedProject,
    selectedClient: selectedClient,
    activeModal: undefined,
    recentActions: [],
    userLevel: 'intermediate',
    integrations: [],
    configurations: {}
  });

  // AI-Powered Guide Assistant state
  const [aiInsights, setAiInsights] = useState<AIInsight[]>([]);
  const [userLearningProfile, setUserLearningProfile] = useState<UserLearningProfile>({
    skillLevel: 'intermediate',
    interests: ['react', 'typescript', 'ui-design'],
    learningStyle: 'hands-on',
    preferredPace: 'moderate',
    completedGuides: [],
    strengths: ['component-design', 'styling'],
    weaknesses: ['accessibility', 'performance'],
    goals: ['master-react', 'improve-accessibility'],
    timeSpent: 0,
    successRate: 0
  });
  const [learningPatterns, setLearningPatterns] = useState<LearningPattern[]>([]);

  // Voice-Guided Tutorials state
  const [voiceSession, setVoiceSession] = useState<VoiceSession | null>(null);
  const [voiceCommands, setVoiceCommands] = useState<VoiceTutorialCommand[]>([]);
  const [isVoiceEnabled, setIsVoiceEnabled] = useState(false);

  // Gamified Learning System state
  const [userProgress, setUserProgress] = useState<UserProgress | null>(null);
  const [achievements, setAchievements] = useState<Achievement[]>([]);
  const [recentActivities, setRecentActivities] = useState<Activity[]>([]);

  // Enhanced modal states for new features
  const [showAIPanel, setShowAIPanel] = useState(false);
  const [showVoiceTutorial, setShowVoiceTutorial] = useState(false);
  const [showGamificationPanel, setShowGamificationPanel] = useState(false);
  const [activeAITab, setActiveAITab] = useState(0);

  // Advanced Analytics states
  const [showAnalyticsDashboard, setShowAnalyticsDashboard] = useState(false);
  const [showPredictiveSuggestions, setShowPredictiveSuggestions] = useState(false);
  const [showAutoFixEngine, setShowAutoFixEngine] = useState(false);
  const [currentCode, setCurrentCode] = useState<string>('');
  const [learningContext, setLearningContext] = useState({
    currentSkill: 'react',
    skillLevel: 7,
    recentActivities: ['component-creation', 'state-management'],
    timeOfDay: 'morning',
    dayOfWeek: 'monday',
    energyLevel: 8,
    focusLevel: 9,
    availableTime: 60,
    preferredMethod: 'hands-on',
    collaborationPreference: true
  });

  // Backend service states
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [collaborationSession, setCollaborationSession] = useState<any>(null);
  const [connectedPlatforms, setConnectedPlatforms] = useState<any[]>([]);
  const [externalResources, setExternalResources] = useState<any[]>([]);
  // Auth and API integration
  const { user } = useAuth();
  const queryClient = useQueryClient();
  
  // Theme and responsive design
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down('md'));
  
  // Core editor state
  const [selectedElement, setSelectedElement] = useState<string | null>(null);
  const [selectedView, setSelectedView] = useState<'plan' | 'designer' | 'components' | 'code' | 'preview' | 'seo'>('plan');
  const [planMode, setPlanMode] = useState<'brainstorm' | 'tasks' | 'architecture' | 'strategy'>('brainstorm');

  // Dynamic Intelligence state (matching Replit's features)
  const [extendedThinking, setExtendedThinking] = useState(false);
  const [highPowerMode, setHighPowerMode] = useState(false);
  const [usageCount, setUsageCount] = useState({ extendedThinking: 0, highPower: 0 });
  const [dailyLimits] = useState({ free: 3, pro: 100, teams: 500 });
  const [canvasZoom, setCanvasZoom] = useState(1);
  const [previewMode, setPreviewMode] = useState<'desktop' | 'tablet' | 'mobile'>('desktop');
  const [isDragging, setIsDragging] = useState(false);
  const [draggedComponent, setDraggedComponent] = useState<string | null>(null);
  
  // Enhanced Modal State Management
  const [modalStates, setModalStates] = useState({
    settings: false,
    export: false,
    confirmation: false,
    aiAssistant: false,
    arPreview: false,
    vrPreview: false,
    voiceControl: false,
    wizard: false,
    advancedFeatures: false
  });

  // Enhanced Modal Handlers with Advanced Features
  const showSettingsModal = useCallback(() => {
    modal.showSettings({
      title: 'Editor Settings',
      sections: [
        {
          title: 'General',
          description: 'Basic editor preferences',
          fields: [
            {
              name: 'theme',
              label: 'Theme',
              type: 'select',
              value: 'light',
              options: [
                { value: 'light', label: 'Light' },
                { value: 'dark', label: 'Dark' },
                { value: 'auto', label: 'Auto' }
              ]
            },
            {
              name: 'language',
              label: 'Language',
              type: 'select',
              value: 'en',
              options: [
                { value: 'en', label: 'English' },
                { value: 'no', label: 'Norwegian' }
              ]
            }
          ]
        }
      ],
      onSave: (settings) => {
        onSettingsUpdate?.(settings);
        onNotificationCreate?.({
          id: Date.now().toString(),
          type: 'settings_updated',
          title: 'Settings Updated',
          message: 'Your editor settings have been saved successfully.',
          priority: 'medium',
          timestamp: new Date().toISOString(),
          source: 'settings_modal'
        });
      }
    });
  }, [modal, onSettingsUpdate, onNotificationCreate]);

  const showExportModal = useCallback(() => {
    modal.showForm({
      title: 'Advanced Export & Publishing',
      fields: [
        {
          name: 'format',
          label: 'Export Format',
          type: 'select',
          required: true,
          options: [
            { value: 'html', label: 'HTML/CSS/JS' },
            { value: 'react', label: 'React Component' },
            { value: 'vue', label: 'Vue Component' },
            { value: 'angular', label: 'Angular Component' },
            { value: 'flutter', label: 'Flutter Widget' },
            { value: 'pdf', label: 'PDF Document' },
            { value: 'image', label: 'Image (PNG/JPG)' }
          ]
        },
        {
          name: 'quality',
          label: 'Quality',
          type: 'select',
          options: [
            { value: 'high', label: 'High Quality' },
            { value: 'medium', label: 'Medium Quality' },
            { value: 'low', label: 'Low Quality' }
          ]
        },
        {
          name: 'includeAssets',
          label: 'Include Assets',
          type: 'checkbox'
        },
        {
          name: 'optimizeCode',
          label: 'Optimize Code',
          type: 'checkbox'
        }
      ],
      onSubmit: (data) => {
        handleCodeExport(data);
      },
      onCancel: () => {
        console.log('Export cancelled');
      }
    });
  }, [modal]);

  const showConfirmationModal = useCallback((message: string, onConfirm: () => void) => {
    modal.showConfirmation({
      title: 'Confirm Action',
      message,
      confirmText: 'Yes, Continue',
      cancelText: 'Cancel',
      destructive: false,
      onConfirm,
      onCancel: () => console.log('Action cancelled')
    });
  }, [modal]);

  const showAIAssistantModal = useCallback(() => {
    setModalStates(prev => ({ ...prev, aiAssistant: true }));
