// Error Boundary Component for crash protection
interface ErrorBoundaryState {
  hasError: boolean;
  error?: Error;
  errorInfo?: React.ErrorInfo;
}

class VisualEditorErrorBoundary extends Component<
  { children: ReactNode; fallback?: ReactNode },
  ErrorBoundaryState
> {
  constructor(props: { children: ReactNode; fallback?: ReactNode }) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: Error): ErrorBoundaryState {
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {
    console.error('Visual Editor Error Boundary caught an error:', error, errorInfo);
    this.setState({ error, errorInfo });
    
    // Report error to monitoring service
    if (typeof window !== 'undefined' && (window as any).reportError) {
      (window as any).reportError(error, errorInfo);
    }
  }

  render() {
    if (this.state.hasError) {
      return this.props.fallback || (
        <Box sx={{ p: 4, textAlign: 'center' }}>
          <Typography variant="h5" color="error" gutterBottom>
            Something went wrong with the Visual Editor
          </Typography>
          <Typography variant="body1" color="text.secondary" paragraph>
            We're sorry, but the visual editor encountered an unexpected error.
          </Typography>
          <Button 
            variant="contained" 
            onClick={() => this.setState({ hasError: false, error: undefined, errorInfo: undefined })}
            sx={{ mt: 2 }}
          >
            Try Again
          </Button>
          {process.env.NODE_ENV === 'development' && this.state.error && (
            <Box sx={{ mt: 2, p: 2, backgroundColor: '#f5f5f5', borderRadius: 1 }}>
              <Typography variant="caption" component="pre" sx={{ whiteSpace: 'pre-wrap' }}>
                {this.state.error.toString()}
                {this.state.errorInfo?.componentStack}
              </Typography>
            </Box>
          )}
        </Box>
      );
    }

    return this.props.children;
  }
}

// Comprehensive TypeScript Interfaces
interface Meeting {
  id: string;
  title: string;
  date: Date;
  participants: string[];
  agenda: string[];
  notes?: string;
  recordingUrl?: string;
