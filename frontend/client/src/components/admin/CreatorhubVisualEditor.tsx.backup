  const handleProgressUpdate = useCallback((progress: UserProgress) => {
    console.log('User progress updated:', progress);
    setUserProgress(progress);
  }, []);

  // Backend Service Integration
  useEffect(() => {
    if (user?.id) {
      // Load user progress from backend
      progressTrackingService.getUserProgress(user.id).then(progress => {
        // Convert backend UserProgress to component UserProgress format
        const convertedProgress = {
          ...progress,
          achievements: progress.achievements.map(achievement => ({
            ...achievement,
            icon: <TrophyIcon />
          })),
          badges: progress.badges.map(badge => ({
            ...badge,
            icon: <StarIcon />
          }))
        };
        setUserProgress(convertedProgress as any); // Type assertion for compatibility
      });
      
      // Load connected platforms
      externalIntegrationsService.getConnectedPlatforms(user.id).then(setConnectedPlatforms);
      
      // Load external resources
      externalIntegrationsService.getRecommendedResources(user.id).then(setExternalResources);
    }
  }, [user?.id]);

  // AI Analysis Integration
  const handleAIAnalysis = useCallback(async (code: string, context: any) => {
    if (!user?.id) return;
    
    setIsAnalyzing(true);
    try {
      const analysis = await aiAnalysisService.analyzeCode({
        code,
        language: 'typescript',
        context,
        userId: user.id
      });
      
      // Convert backend AIInsight to component AIInsight format
      const convertedInsights = analysis.insights.map(insight => ({
        ...insight,
        data: { category: insight.type, confidence: insight.confidence },
        suggestions: [insight.suggestion],
        severity: insight.severity as 'low' | 'medium' | 'high' | 'critical',
        type: 'optimization' as const // Map to valid type
      }));
      setAiInsights(convertedInsights as any); // Type assertion for compatibility
      
      // Update learning patterns
      const pattern: LearningPattern = {
        id: `pattern-${Date.now()}`,
        userId: user.id,
        action: 'code_analyzed',
        context: { codeLength: code.length, insightsCount: analysis.insights.length },
        timestamp: new Date(),
        outcome: 'success',
        duration: analysis.processingTime,
        suggestions: analysis.insights.map(i => i.suggestion)
      };
      
      setLearningPatterns(prev => [...prev.slice(-99), pattern]);
      await aiAnalysisService.updateLearningPattern(pattern);
      
    } catch (error) {
      console.error('AI Analysis failed:', error);
    } finally {
      setIsAnalyzing(false);
    }
  }, [user?.id]);

  // Collaboration Integration
  const handleStartCollaboration = useCallback(async (projectId: string) => {
    if (!user?.id) return;
    
    try {
      const session = await collaborationService.createSession(projectId, user.id);
      setCollaborationSession(session);
      
      // Connect to WebSocket for real-time collaboration
      collaborationService.connectWebSocket(session.id, user.id);
      
      // Set up event listeners
      collaborationService.on('cursor_move', (data: any) => {
        console.log('Cursor moved:', data);
      });
      
      collaborationService.on('element_select', (data: any) => {
        console.log('Element selected:', data);
      });
      
      collaborationService.on('comment_add', (data: any) => {
        console.log('Comment added:', data);
      });
      
    } catch (error) {
      console.error('Failed to start collaboration:', error);
    }
  }, [user?.id]);

  // External Integrations
  const handleConnectPlatform = useCallback(async (platformId: string) => {
    if (!user?.id) return;
    
    try {
      const connection = await externalIntegrationsService.connectPlatform(platformId, user.id, {});
      setConnectedPlatforms(prev => [...prev, connection]);
      
      // Sync resources after connection
      const syncResult = await externalIntegrationsService.syncPlatformResources(platformId, user.id);
      console.log('Platform synced:', syncResult);
      
    } catch (error) {
      console.error('Failed to connect platform:', error);
    }
  }, [user?.id]);

  // Enhanced AI Insight Handler with Backend Integration
  const handleEnhancedAIInsightAccept = useCallback(async (insight: AIInsight) => {
    console.log(`AI Insight accepted: ${insight.title}`);
    
    // Record activity in backend
    if (user?.id) {
      await progressTrackingService.recordActivity(user.id, {
        type: 'ai_insight',
        title: 'AI Insight Applied',
        description: `Applied "${insight.title}" suggestion`,
        points: 10,
        icon: 'psychology'
      });
      
      // Add experience points
      await progressTrackingService.addExperience(user.id, 10, `Applied AI insight: ${insight.title}`);
    }
    
    // Update learning patterns
    const pattern: LearningPattern = {
      id: `pattern-${Date.now()}`,
      userId: user?.id || 'anonymous',
      action: 'ai_insight_accepted',
      context: { insightId: insight.id, category: insight.type },
      timestamp: new Date(),
      outcome: 'success',
      duration: 0,
      suggestions: [insight.suggestions?.[0] || (insight as any).suggestion || '']
    };
    
    setLearningPatterns(prev => [...prev.slice(-99), pattern]);
    
    // Remove insight from list
    setAiInsights(prev => prev.filter(i => i.id !== insight.id));
    
    // Create notification
    onNotificationCreate?.({
      id: Date.now().toString(),
      type: 'info',
      title: 'AI Insight Applied',
      message: `Applied "${insight.title}" suggestion`,
      priority: 'medium',
      timestamp: new Date().toISOString(),
      source: 'ai-assistant'
    });
  }, [user?.id, onNotificationCreate]);

  // Advanced Analytics Handlers
  const handleAnalyticsInsightClick = useCallback((insight: { id: string; title: string; description: string }) => {
    console.log('Analytics insight clicked:', insight);
    // Could open detailed view or apply the insight
  }, []);

  const handleAnalyticsRecommendationClick = useCallback((recommendation: { id: string; title: string; description: string }) => {
    console.log('Analytics recommendation clicked:', recommendation);
    // Could open detailed view or apply the recommendation
  }, []);

  const handleAnalyticsExport = useCallback((data: any) => {
    console.log('Analytics data exported:', data);
    // Export analytics data to file
  }, []);

  const handleAnalyticsShare = useCallback((data: any) => {
    console.log('Analytics data shared:', data);
    // Share analytics data with team or community
  }, []);

  // Predictive Suggestions Handlers
  const handleSuggestionApply = useCallback((suggestion: any) => {
    console.log('Predictive suggestion applied:', suggestion);
    
    // Record activity
    if (user?.id) {
      progressTrackingService.recordActivity(user.id, {
        type: 'ai_insight', // Using existing type since suggestion_applied doesn't exist
        title: 'Suggestion Applied',
        description: `Applied "${suggestion.title}" suggestion`,
        points: 15,
        icon: 'lightbulb'
      });
    }
    
    // Update learning context
    setLearningContext(prev => ({
      ...prev,
      recentActivities: [...prev.recentActivities, suggestion.type]
    }));
  }, [user?.id]);

  const handleSuggestionFeedback = useCallback((suggestion: any, feedback: 'positive' | 'negative' | 'neutral') => {
    console.log('Suggestion feedback:', suggestion, feedback);
    // Record feedback for ML model improvement
  }, []);

  const handleSuggestionBookmark = useCallback((suggestion: any) => {
    console.log('Suggestion bookmarked:', suggestion);
    // Save suggestion for later reference
  }, []);

  // Auto-Fix Handlers
  const handleIssueFix = useCallback((issue: any, result: any) => {
    console.log('Issue fixed:', issue, result);
    
    // Record activity
    if (user?.id) {
      progressTrackingService.recordActivity(user.id, {
        type: 'ai_insight', // Using existing type since auto_fix_applied doesn't exist
        title: 'Auto-Fix Applied',
        description: `Fixed "${issue.title}" issue`,
        points: 20,
        icon: 'build'
      });
    }
    
    // Update current code
    setCurrentCode(result.fixedCode);
  }, [user?.id]);

  const handleIssueFeedback = useCallback((issue: any, feedback: 'positive' | 'negative' | 'neutral') => {
    console.log('Issue feedback:', issue, feedback);
    // Record feedback for ML model improvement
  }, []);

  const handleCodeUpdate = useCallback((newCode: string) => {
    console.log('Code updated:', newCode);
    setCurrentCode(newCode);
    // Could trigger re-analysis or save to backend
  }, []);

  const handleClientCollaboration = (clientData: any, designData: any) => {
    console.log('👥 Client Collaboration:', clientData, designData);
    
    // Trigger client update
    if (onClientUpdate) {
      onClientUpdate({
        ...clientData,
        lastDesignReview: new Date().toISOString(),
        activeDesign: designData.id,
        collaborationStatus: 'reviewing'
      });
    }
    
    // Trigger meeting creation for design review
    if (onMeetingCreate) {
      onMeetingCreate({
        id: `meeting_${Date.now()}`,
        title: `Design Review: ${designData.name}`,
        clientName: clientData.name,
        date: new Date(Date.now() + 24 * 60 * 60 * 1000), // Tomorrow
        participants: [clientData.name, 'designer'],
        agenda: ['Review design', 'Discuss feedback', 'Plan revisions'],
        status: 'scheduled',
        description: `Design review meeting for ${designData.name}`,
        notes: `Client: ${clientData.email}`
      });
    }
  };

  // Canvas dimensions based on preview mode
  const getCanvasWidth = () => {
    switch (previewMode) {
      case 'mobile': return 375;
      case 'tablet': return 768;
      case 'desktop': return 1200;
      default: return 1200;
    }
  };

  // Element selection handler
  const handleElementClick = (elementId: string, event: React.MouseEvent) => {
    event.stopPropagation();
    setSelectedElement(selectedElement === elementId ? null : elementId);
    
    // Update guide context with selected element
    const element = project.elements[elementId];
    if (element) {
      setGuideContext((prev: VisualEditorGuideContext) => ({
        ...prev,
        selectedElement: {
          id: element.id,
          type: element.type,
          x: element.x,
          y: element.y,
          width: element.width,
          height: element.height,
          styles: element.styles,
          props: element.props,
          children: element.children,
          parent: element.parent,
          icon: element.icon,
          modalConnected: false, // Will be determined by actual integration
          propsConfigured: Object.keys(element.props).length > 0,
          webhookConnected: false, // Will be determined by actual integration
          securityEnabled: false, // Will be determined by actual integration
          accessibilityEnabled: false, // Will be determined by actual integration
          performanceOptimized: false // Will be determined by actual integration
        }
      }));
    }
    
    // Trigger unified workflow event for element selection
    if (selectedElement !== elementId) {
      const element = project.elements[elementId];
      if (element) {
        onProjectUpdate?.({
          ...selectedProject,
          id: selectedProject?.id || 'unknown',
          name: selectedProject?.name || 'Unknown Project',
          description: selectedProject?.description || 'No description available',
          status: selectedProject?.status || 'in-progress',
          clientId: selectedProject?.clientId || 'default',
          dueDate: selectedProject?.dueDate || new Date(),
          priority: selectedProject?.priority || 'medium',
          tags: selectedProject?.tags || [],
          lastElementSelected: elementId,
          selectedElementType: element.type,
          timestamp: new Date().toISOString()
        });
        
        onNotificationCreate?.({
          id: `element_selected_${Date.now()}`,
          type: 'element_selected',
          title: 'Element Selected',
          message: `Selected ${element.type} element: ${elementId}`,
          priority: 'low',
      timestamp: new Date().toISOString(),
          source: 'visual_editor'
        });
      }
    }
  };

  // Canvas click handler (deselect)
  const handleCanvasClick = () => {
    if (selectedElement) {
      // Trigger unified workflow event for element deselection
      onProjectUpdate?.({
        ...selectedProject,
        id: selectedProject?.id || 'unknown',
        name: selectedProject?.name || 'Unknown Project',
        description: selectedProject?.description || 'No description available',
        status: selectedProject?.status || 'in-progress',
        clientId: selectedProject?.clientId || 'default',
        dueDate: selectedProject?.dueDate || new Date(),
        priority: selectedProject?.priority || 'medium',
        tags: selectedProject?.tags || [],
        lastElementDeselected: selectedElement,
        timestamp: new Date().toISOString()
      });
    }
    setSelectedElement(null);
  };

  // Add component to canvas
  const addComponent = (componentType: string, x?: number, y?: number) => {
    const newId = `${componentType}-${Date.now()}`;
    const newElement: EditorElement = {
          id: newId,
      type: componentType as 'button' | 'text' | 'image' | 'card' | 'container' | 'grid',
      x: x ?? (100 + Math.random() * 200),
      y: y ?? (100 + Math.random() * 200),
          width: 200,
          height: 100,
      styles: {
        backgroundColor: componentType === 'button' ? '#1976d2' : '#ffffff',
        color: componentType === 'button' ? '#ffffff' : '#000000',
        padding: '16px',
        borderRadius: '4px'
      },
      props: {
        text: `New ${componentType.charAt(0).toUpperCase() + componentType.slice(1)}`
      }
    };

    const newProject = {
      ...project,
      elements: {
        ...project.elements,
        [newId]: newElement
      }
    };

    setProject(newProject);
    addToHistory(newProject);

    // Trigger design creation workflow event
    handleDesignCreated({
      id: newId,
      type: componentType,
      name: `New ${componentType.charAt(0).toUpperCase() + componentType.slice(1)}`,
      timestamp: new Date().toISOString()
    });
  };




  const generateElementCode = (element: EditorElement, indent: number): string => {
    const spaces = "  ".repeat(indent);
    let code = "";

    switch (element.type) {
      case 'card':
        code += `${spaces}<Card sx={{ maxWidth: ${element.width}, mx: 'auto' }}>\n`;
        code += `${spaces}  <CardContent>\n`;
        if (element.children) {
          element.children.forEach(childId => {
            const child = project.elements[childId];
            if (child) code += generateElementCode(child, indent + 2);
          });
        }
        code += `${spaces}  </CardContent>\n`;
        code += `${spaces}</Card>\n`;
        break;
      case 'text':
        const variant = element.styles.fontSize === '2rem' ? 'h4' : 'body1';
        code += `${spaces}<Typography variant="${variant}" sx={{ mb: 2 }}>\n`;
        code += `${spaces}  ${element.props.text}\n`;
        code += `${spaces}</Typography>\n`;
        break;
      case 'button':
        code += `${spaces}<Button variant="${element.props.variant || 'contained'}" sx={{ mr: 1 }}>\n`;
        code += `${spaces}  ${element.props.text}\n`;
        code += `${spaces}</Button>\n`;
        break;
      case 'container':
        code += `${spaces}<Box sx={{ display: 'flex', gap: 2, mt: 3 }}>\n`;
        if (element.children) {
          element.children.forEach(childId => {
            const child = project.elements[childId];
            if (child) code += generateElementCode(child, indent + 1);
          });
        }
        code += `${spaces}</Box>\n`;
        break;
    }

    return code;
  };

  return (
    <Box sx={{ height: '100vh', display: 'flex', flexDirection: 'column' }}>
      {/* Global Guide Assistant */}
      <VisualEditorGuideIntegration
        context={guideContext}
        onElementSelect={(element: any) => {
          setGuideContext((prev: VisualEditorGuideContext) => ({ ...prev, selectedElement: element }));
        }}
        onProjectUpdate={(project: any) => {
          setGuideContext((prev: VisualEditorGuideContext) => ({ ...prev, currentProject: project }));
        }}
        onIntegrationComplete={handleGuideIntegrationComplete}
        onConfigurationComplete={handleGuideConfigurationComplete}
        showMascot={true}
        autoSuggest={true}
        enableVoiceGuidance={false}
      />

      {/* AI-Powered Guide Assistant */}
      <AIPoweredGuideAssistant
        context={guideContext}
        userProfile={userLearningProfile}
        onInsightAccept={handleEnhancedAIInsightAccept}
        onInsightDismiss={(insight) => {
          setAiInsights(prev => prev.filter(i => i.id !== insight.id));
        }}
        onLearningUpdate={handleLearningProfileUpdate}
        enableML={true}
        enablePredictions={true}
        enableAutoFix={true}
        enablePersonalization={true}
      />

      {/* Voice-Guided Tutorials */}
      {showVoiceTutorial && (
        <Dialog
          open={showVoiceTutorial}
          onClose={() => setShowVoiceTutorial(false)}
          maxWidth="lg"
          fullWidth
          fullScreen={isMobile}
        >
          <DialogTitle>
            <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <Typography variant="h5">
                <VoiceIcon sx={{ mr: 2, verticalAlign: 'middle' }} />
                Voice-Guided Tutorial
              </Typography>
              <IconButton onClick={() => setShowVoiceTutorial(false)}>
                <CloseIcon />
              </IconButton>
            </Box>
          </DialogTitle>
          <DialogContent>
            <VoiceGuidedTutorials
              tutorialId="visual-editor-tutorial"
              onStepComplete={(stepId) => {
                console.log(`Voice tutorial step completed: ${stepId}`);
                // Update learning patterns and progress
              }}
              onTutorialComplete={() => {
                console.log('Voice tutorial completed!');
                setShowVoiceTutorial(false);
                // Unlock achievement
                handleAchievementUnlocked({
                  id: 'voice-tutorial-complete',
                  title: 'Voice Learner',
                  description: 'Complete a voice-guided tutorial',
                  icon: <VoiceIcon />,
                  category: 'learning',
                  rarity: 'uncommon',
                  points: 100,
                  requirements: [],
                  unlocked: true,
                  unlockedAt: new Date(),
                  progress: 100
                });
              }}
              onVoiceCommand={handleVoiceCommand}
              language="en-US"
              speed={1.0}
              volume={0.8}
              enableVoiceControl={true}
              enableAudioFeedback={true}
            />
          </DialogContent>
        </Dialog>
      )}

      {/* Gamified Learning System */}
      {showGamificationPanel && (
        <Dialog
          open={showGamificationPanel}
          onClose={() => setShowGamificationPanel(false)}
          maxWidth="lg"
          fullWidth
          fullScreen={isMobile}
        >
          <DialogTitle>
            <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <Typography variant="h5">
                <TrophyIcon sx={{ mr: 2, verticalAlign: 'middle' }} />
                Your Learning Progress
              </Typography>
              <IconButton onClick={() => setShowGamificationPanel(false)}>
                <CloseIcon />
              </IconButton>
            </Box>
          </DialogTitle>
          <DialogContent>
            <GamifiedLearningSystem
              userId={user?.id || 'anonymous'}
              onAchievementUnlocked={handleAchievementUnlocked}
              onLevelUp={handleLevelUp}
              onStreakMilestone={(streak) => {
                console.log(`Streak milestone achieved: ${streak.currentStreak} days`);
                // Update learning patterns
              }}
              onProgressUpdate={handleProgressUpdate}
              showLeaderboard={true}
              enableNotifications={true}
              enableSharing={true}
            />
          </DialogContent>
        </Dialog>
      )}

      {/* Learning Analytics Dashboard */}
      {showAnalyticsDashboard && (
        <Dialog
          open={showAnalyticsDashboard}
          onClose={() => setShowAnalyticsDashboard(false)}
          maxWidth="xl"
          fullWidth
          fullScreen={isMobile}
        >
          <DialogTitle>
            <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <Typography variant="h5">
                <AnalyticsIcon sx={{ mr: 1, verticalAlign: 'middle' }} />
                Learning Analytics Dashboard
              </Typography>
              <IconButton onClick={() => setShowAnalyticsDashboard(false)}>
                <CloseIcon />
              </IconButton>
            </Box>
          </DialogTitle>
          <DialogContent>
            <LearningAnalyticsDashboard
              userId={user?.id || 'anonymous'}
              onInsightClick={handleAnalyticsInsightClick}
              onRecommendationClick={handleAnalyticsRecommendationClick}
              onExport={(data: any) => handleAnalyticsExport(data)}
              onShare={(data: any) => handleAnalyticsShare(data)}
              enableRealTime={true}
              refreshInterval={30000}
            />
          </DialogContent>
        </Dialog>
      )}

      {/* Predictive Suggestions Engine */}
      {showPredictiveSuggestions && (
        <Dialog
          open={showPredictiveSuggestions}
          onClose={() => setShowPredictiveSuggestions(false)}
          maxWidth="xl"
          fullWidth
          fullScreen={isMobile}
        >
          <DialogTitle>
            <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <Typography variant="h5">
                <AutoAwesomeIcon sx={{ mr: 1, verticalAlign: 'middle' }} />
                Predictive Suggestions Engine
              </Typography>
              <IconButton onClick={() => setShowPredictiveSuggestions(false)}>
                <CloseIcon />
              </IconButton>
            </Box>
          </DialogTitle>
          <DialogContent>
            <PredictiveSuggestionsEngine
              userId={user?.id || 'anonymous'}
              context={learningContext}
              onSuggestionApply={handleSuggestionApply}
              onSuggestionFeedback={handleSuggestionFeedback}
              onSuggestionBookmark={handleSuggestionBookmark}
              enableRealTime={true}
              refreshInterval={60000}
              maxSuggestions={10}
            />
          </DialogContent>
        </Dialog>
      )}

      {/* Auto-Fix Capabilities Engine */}
      {showAutoFixEngine && (
        <Dialog
          open={showAutoFixEngine}
          onClose={() => setShowAutoFixEngine(false)}
          maxWidth="xl"
          fullWidth
          fullScreen={isMobile}
        >
          <DialogTitle>
            <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <Typography variant="h5">
                <BuildIcon sx={{ mr: 1, verticalAlign: 'middle' }} />
                Auto-Fix Capabilities Engine
              </Typography>
              <IconButton onClick={() => setShowAutoFixEngine(false)}>
                <CloseIcon />
              </IconButton>
            </Box>
          </DialogTitle>
          <DialogContent>
            <AutoFixCapabilitiesEngine
              userId={user?.id || 'anonymous'}
              code={currentCode || '// Your code will be analyzed here...'}
              language="typescript"
              onIssueFix={handleIssueFix}
              onIssueFeedback={handleIssueFeedback}
              onCodeUpdate={handleCodeUpdate}
              enableRealTime={true}
              refreshInterval={30000}
              maxIssues={20}
            />
          </DialogContent>
        </Dialog>
      )}
      
      {/* Top Toolbar */}
      <AppBar position="static" color="default" elevation={1}>
        <Toolbar>
          <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, flexGrow: 1 }}>
            <VisualEditorLogoIcon variant="horizontal" size="small" showText={false} />
            <Box sx={{ display: 'flex', flexDirection: 'column' }}>
              <Typography variant="h6" sx={{ fontWeight: 700, color: '#222', lineHeight: 1 }}>
                CreatorHub
          </Typography>
              <Typography variant="body2" sx={{ color: '#0066ff', fontWeight: 500 }}>
                Visual Editor
              </Typography>
            </Box>
          </Box>

          {/* Dynamic Intelligence Controls */}
          <Box sx={{ display: 'flex', alignItems: 'center', mr: 2 }}>
            <Tooltip title="Extended Thinking - Deeper reasoning and analysis (1.25x cost)">
              <FormControlLabel
                control={
                  <Switch
                    checked={extendedThinking}
                    onChange={(e) => setExtendedThinking(e.target.checked)}
                    size="small"
                    color="primary"
                  />
                }
                label={
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                    <ExtendedThinkingIcon fontSize="small" />
                    <Typography variant="caption">Extended</Typography>
                  </Box>
                }
                labelPlacement="start"
                sx={{ mr: 2 }}
              />
            </Tooltip>

            <Tooltip title="High Power Mode - Maximum capability with Claude Opus (5x cost)">
              <FormControlLabel
                control={
                  <Switch
                    checked={highPowerMode}
                    onChange={(e) => setHighPowerMode(e.target.checked)}
                    size="small"
                    color="warning"
                  />
                }
                label={
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                    <HighPowerIcon fontSize="small" />
                    <Typography variant="caption">High Power</Typography>
                  </Box>
                }
                labelPlacement="start"
                sx={{ mr: 1 }}
              />
            </Tooltip>

            {(extendedThinking || highPowerMode) && (
              <Tooltip title={`Usage: Extended ${usageCount.extendedThinking}, High Power ${usageCount.highPower}`}>
                <Badge badgeContent={usageCount.highPower} color="warning">
                  <CostIcon fontSize="small" color="action" />
                </Badge>
              </Tooltip>
            )}
          </Box>

          {/* Integration Actions */}
          <Box sx={{ display: 'flex', alignItems: 'center', mr: 2 }}>
                <Button
              startIcon={<SaveIcon />}
              variant="outlined"
              size="small"
              onClick={handleDesignSave}
              sx={{ mr: 1 }}
            >
              Save Design
                </Button>
                <Button
              startIcon={<CodeIcon />}
              variant="outlined"
              size="small"
              onClick={() => {
                const code = generateCode();
                handleCodeExport(code);
              }}
              sx={{ mr: 1 }}
            >
              Export Code
                </Button>
                <Button
              startIcon={<PlaylistAddCheckIcon />}
              variant="outlined"
              size="small"
              onClick={() => {
                if (selectedClient) {
                  handleClientCollaboration(selectedClient, project);
                }
              }}
              disabled={!selectedClient}
            >
              Share with Client
                </Button>
          </Box>

          {/* View Tabs */}
          <ButtonGroup variant="outlined" size="medium">
            <Button
              startIcon={<SettingsIcon />}
              variant={selectedView === 'plan' ? 'contained' : 'outlined'}
              onClick={() => {
                setSelectedView('plan');
                // Trigger unified workflow event for view change
                onProjectUpdate?.({
                  ...selectedProject,
                  id: selectedProject?.id || 'unknown',
                  name: selectedProject?.name || 'Unknown Project',
                  description: selectedProject?.description || 'No description available',
                  status: selectedProject?.status || 'in-progress',
                  clientId: selectedProject?.clientId || 'default',
                  dueDate: selectedProject?.dueDate || new Date(),
                  priority: selectedProject?.priority || 'medium',
                  tags: selectedProject?.tags || [],
                  currentView: 'plan',
                  timestamp: new Date().toISOString()
                });
              }}
            >
              Plan Mode
            </Button>
            <Button
              startIcon={<LayersIcon />}
              variant={selectedView === 'designer' ? 'contained' : 'outlined'}
              onClick={() => {
                setSelectedView('designer');
                onProjectUpdate?.({
                  ...selectedProject,
                  id: selectedProject?.id || 'unknown',
                  name: selectedProject?.name || 'Unknown Project',
                  description: selectedProject?.description || 'No description available',
                  status: selectedProject?.status || 'in-progress',
                  clientId: selectedProject?.clientId || 'default',
                  dueDate: selectedProject?.dueDate || new Date(),
                  priority: selectedProject?.priority || 'medium',
                  tags: selectedProject?.tags || [],
                  currentView: 'designer',
                  timestamp: new Date().toISOString()
                });
              }}
            >
              Visual Designer
            </Button>
            <Button
              startIcon={<PaletteIcon />}
              variant={selectedView === 'components' ? 'contained' : 'outlined'}
              onClick={() => {
                setSelectedView('components');
                onProjectUpdate?.({
                  ...selectedProject,
                  id: selectedProject?.id || 'unknown',
                  name: selectedProject?.name || 'Unknown Project',
                  description: selectedProject?.description || 'No description available',
                  status: selectedProject?.status || 'in-progress',
                  clientId: selectedProject?.clientId || 'default',
                  dueDate: selectedProject?.dueDate || new Date(),
                  priority: selectedProject?.priority || 'medium',
                  tags: selectedProject?.tags || [],
                  currentView: 'components',
                  timestamp: new Date().toISOString()
                });
              }}
            >
              Components
            </Button>
            <Button
              startIcon={<CodeIcon />}
              variant={selectedView === 'code' ? 'contained' : 'outlined'}
              onClick={() => {
                setSelectedView('code');
                onProjectUpdate?.({
                  ...selectedProject,
                  id: selectedProject?.id || 'unknown',
                  name: selectedProject?.name || 'Unknown Project',
                  description: selectedProject?.description || 'No description available',
                  status: selectedProject?.status || 'in-progress',
                  clientId: selectedProject?.clientId || 'default',
                  dueDate: selectedProject?.dueDate || new Date(),
                  priority: selectedProject?.priority || 'medium',
                  tags: selectedProject?.tags || [],
                  currentView: 'code',
                  timestamp: new Date().toISOString()
                });
              }}
            >
              Code View
            </Button>
            <Button
              startIcon={<PreviewIcon />}
              variant={selectedView === 'preview' ? 'contained' : 'outlined'}
              onClick={() => {
                setSelectedView('preview');
                onProjectUpdate?.({
                  ...selectedProject,
                  id: selectedProject?.id || 'unknown',
                  name: selectedProject?.name || 'Unknown Project',
                  description: selectedProject?.description || 'No description available',
                  status: selectedProject?.status || 'in-progress',
                  clientId: selectedProject?.clientId || 'default',
                  dueDate: selectedProject?.dueDate || new Date(),
                  priority: selectedProject?.priority || 'medium',
                  tags: selectedProject?.tags || [],
                  currentView: 'preview',
                  timestamp: new Date().toISOString()
                });
              }}
            >
              Live Preview
            </Button>
            <Button
              startIcon={<ColorIcon />}
              variant={selectedView === 'seo' ? 'contained' : 'outlined'}
              onClick={() => {
                setSelectedView('seo');
                onProjectUpdate?.({
                  ...selectedProject,
                  id: selectedProject?.id || 'unknown',
                  name: selectedProject?.name || 'Unknown Project',
                  description: selectedProject?.description || 'No description available',
                  status: selectedProject?.status || 'in-progress',
                  clientId: selectedProject?.clientId || 'default',
                  dueDate: selectedProject?.dueDate || new Date(),
                  priority: selectedProject?.priority || 'medium',
                  tags: selectedProject?.tags || [],
                  currentView: 'seo',
                  timestamp: new Date().toISOString()
                });
              }}
            >
              SEO & Audit
            </Button>
          </ButtonGroup>

          {/* Advanced Visual Editor Controls */}
          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />
          
          {/* Grid Controls */}
          <ButtonGroup size="small">
            <Tooltip title="Toggle Grid">
            <Button
                variant={showGrid ? "contained" : "outlined"}
                onClick={toggleGrid}
                startIcon={<GridOn />}
              >
                Grid
            </Button>
            </Tooltip>
            <Tooltip title="Snap to Grid">
              <Button
                variant={snapToGrid ? "contained" : "outlined"}
                onClick={toggleSnapToGrid}
              >
                Snap
              </Button>
            </Tooltip>
          </ButtonGroup>

          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />

          {/* Multi-select Controls */}
          <ButtonGroup size="small">
            <Tooltip title="Multi-select Mode">
              <Button
                variant={multiSelectMode ? "contained" : "outlined"}
                onClick={toggleMultiSelect}
              >
                Multi
              </Button>
            </Tooltip>
            <Tooltip title="Clear Selection">
              <Button
                onClick={clearSelection}
                disabled={selectedElements.length === 0}
              >
                Clear
              </Button>
            </Tooltip>
          </ButtonGroup>

          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />

          {/* Copy/Paste Controls */}
          <ButtonGroup size="small">
            <Tooltip title="Copy Selected">
              <Button
                onClick={copySelectedElements}
                disabled={selectedElements.length === 0}
                startIcon={<ContentCopy />}
              >
                Copy
              </Button>
            </Tooltip>
            <Tooltip title="Paste">
              <Button
                onClick={pasteElements}
                disabled={copyBuffer.length === 0}
                startIcon={<ContentPaste />}
              >
                Paste
              </Button>
            </Tooltip>
          </ButtonGroup>

          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />

          {/* Asset Libraries */}
          <ButtonGroup size="small">
            <Tooltip title="Font Library">
              <Button
                onClick={() => setFontLibraryOpen(true)}
                startIcon={<FormatPaint />}
              >
                Fonts
              </Button>
            </Tooltip>
            <Tooltip title="Icon Library">
              <Button
                onClick={() => setIconLibraryOpen(true)}
                startIcon={<Tag />}
              >
                Icons
              </Button>
            </Tooltip>
            <Tooltip title="Color Picker">
              <Button
                onClick={() => setColorPickerOpen(true)}
                startIcon={<ColorLens />}
              >
                Colors
              </Button>
            </Tooltip>
            <Tooltip title="Asset Library">
              <Button
                onClick={() => setAssetLibraryOpen(true)}
                startIcon={<Image />}
              >
                Assets
              </Button>
            </Tooltip>
          </ButtonGroup>

          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />

          {/* Code Generation */}
          <Button
            variant="contained"
            color="primary"
            onClick={generateCode}
            startIcon={<CodeIcon />}
            size="small"
          >
            Generate Code
          </Button>

          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />

          {/* Advanced Canvas Controls */}
          <ButtonGroup size="small">
            <Tooltip title="Zoom In">
              <Button onClick={() => handleCanvasZoom(0.1)}>
                <ZoomIn />
              </Button>
            </Tooltip>
            <Tooltip title="Zoom Out">
              <Button onClick={() => handleCanvasZoom(-0.1)}>
                <ZoomOut />
              </Button>
            </Tooltip>
            <Tooltip title="Reset View">
              <Button onClick={resetCanvasView}>
                <Refresh />
              </Button>
            </Tooltip>
            <Tooltip title="Fit to Screen">
              <Button onClick={fitToScreen}>
                <Fullscreen />
              </Button>
            </Tooltip>
          </ButtonGroup>

          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />

          {/* Element Manipulation */}
          <ButtonGroup size="small">
            <Tooltip title="Group Selected">
              <Button
                onClick={() => groupElements(selectedElements)}
                disabled={selectedElements.length < 2}
              >
                <Layers />
              </Button>
            </Tooltip>
            <Tooltip title="Lock/Unlock">
              <Button
                onClick={() => selectedElements.forEach(id => toggleElementLock(id))}
                disabled={selectedElements.length === 0}
              >
                <Lock />
              </Button>
            </Tooltip>
            <Tooltip title="Align Left">
              <Button disabled={selectedElements.length < 2}>
                <FormatAlignLeft />
              </Button>
            </Tooltip>
            <Tooltip title="Align Center">
              <Button disabled={selectedElements.length < 2}>
                <FormatAlignCenter />
              </Button>
            </Tooltip>
            <Tooltip title="Align Right">
              <Button disabled={selectedElements.length < 2}>
                <FormatAlignRight />
              </Button>
            </Tooltip>
          </ButtonGroup>

          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />

          {/* Advanced Features */}
          <ButtonGroup size="small">
            <Tooltip title="Text Editor">
              <Button
                onClick={() => selectedElements.length === 1 && openTextEditor(selectedElements[0])}
                disabled={selectedElements.length !== 1}
              >
                <TextFields />
              </Button>
            </Tooltip>
            <Tooltip title="Animation Timeline">
              <Button onClick={() => setAnimationTimeline([])}>
                <ViewTimeline />
              </Button>
            </Tooltip>
            <Tooltip title="ScrollStories">
              <Button 
                onClick={() => setScrollStoriesOpen(true)}
                variant={scrollStories.length > 0 ? "contained" : "outlined"}
              >
                <ViewStream />
              </Button>
            </Tooltip>
            <Tooltip title="Import PDF">
              <Button 
                onClick={() => setPdfImportOpen(true)}
                variant="outlined"
                size="small"
              >
                CloudUpload
              </Button>
            </Tooltip>
            <Tooltip title="Import Media">
              <Button 
                onClick={() => setMediaImportOpen(true)}
                variant="outlined"
                size="small"
              >
                Image
              </Button>
            </Tooltip>
            <Tooltip title="Comments">
              <Button onClick={() => setComments({})}>
                <Comment />
              </Button>
            </Tooltip>
            <Tooltip title="Share">
              <Button onClick={generateShareLink}>
                <Share />
              </Button>
            </Tooltip>
          </ButtonGroup>

          <Divider orientation="vertical" flexItem sx={{ mx: 2 }} />

          {/* Accessibility & Performance */}
          <ButtonGroup size="small">
            <Tooltip title="High Contrast">
              <Button
                variant={highContrastMode ? "contained" : "outlined"}
                onClick={toggleHighContrast}
              >
                <Contrast />
              </Button>
            </Tooltip>
            <Tooltip title="Screen Reader">
              <Button
                variant={screenReaderMode ? "contained" : "outlined"}
                onClick={toggleScreenReaderMode}
              >
                <Accessibility />
              </Button>
            </Tooltip>
            <Tooltip title="Performance">
              <Button onClick={updatePerformanceMetrics}>
                Speed
              </Button>
            </Tooltip>
            
            {/* ✅ Quality Analysis Button */}
            <Tooltip title="Quality Analysis - Analyze code quality, type safety, and performance">
              <Button 
                onClick={handleOpenAnalysisDialog}
                startIcon={<Science />}
                variant="outlined"
                sx={{ ml: 2 }}
              >
                Quality Analysis
                {qualityAnalysis && (
                  <Chip 
                    label={qualityAnalysis.overallScore.toFixed(1)} 
                    size="small" 
                    color={qualityAnalysis.overallScore >= 8 ? 'success' : qualityAnalysis.overallScore >= 6 ? 'warning' : 'error'}
                    sx={{ ml: 1, height: 20 }}
                  />
                )}
              </Button>
            </Tooltip>
          </ButtonGroup>
        </Toolbar>
      </AppBar>

      {/* Main Editor Area */}
      <Box sx={{ flex: 1, display: 'flex', overflow: 'hidden' }}>
        {/* Plan Mode View */}
        {selectedView === 'plan' && (
          <Box sx={{ flex: 1, p: 3 }}>
            <Typography variant="h4" sx={{ mb: 2 }}>
              Plan Mode - Strategisk Planlegging
            </Typography>
            <Typography variant="body1" color="text.secondary" sx={{ mb: 4 }}>
              Brainstorm ideer, planlegg utviklingsarbeid og samarbeid med AI uten å endre kode eller data.
            </Typography>

            {/* Plan Mode Navigation */}
            <ButtonGroup variant="outlined" sx={{ mb: 3 }}>
              <Button
                variant={planMode === 'brainstorm' ? 'contained' : 'outlined'}
                onClick={() => setPlanMode('brainstorm')}
              >
                Brainstorm Ideas
              </Button>
              <Button
                variant={planMode === 'tasks' ? 'contained' : 'outlined'}
                onClick={() => setPlanMode('tasks')}
              >
                Task Planning
              </Button>
              <Button
                variant={planMode === 'architecture' ? 'contained' : 'outlined'}
                onClick={() => setPlanMode('architecture')}
              >
                Project Architecture
              </Button>
              <Button
                variant={planMode === 'strategy' ? 'contained' : 'outlined'}
                onClick={() => setPlanMode('strategy')}
              >
                Strategic Guidance
              </Button>
            </ButtonGroup>

            {/* Brainstorm Mode */}
            {planMode === 'brainstorm' && (
            <Grid container spacing={3}>
              <Grid size={{ xs: 12, md: 8 }}>
                  <Card>
                    <CardContent>
                      <Typography variant="h6" sx={{ mb: 2 }}>
                        Project Brainstorming
                      </Typography>
                      <TextField
                        fullWidth
                        multiline
                        rows={8}
                        placeholder="Describe your project ideas, goals, and vision. What features do you want to build? What problems are you solving?"
                        variant="outlined"
                        sx={{ mb: 2 }}
                      />
                      <Box sx={{ display: 'flex', gap: 1, mb: 2 }}>
                        <Button
                          variant="contained"
                          onClick={() => {
                            setUsageCount(prev => ({ ...prev, extendedThinking: prev.extendedThinking + 1 }));
                            // Trigger unified workflow event for brainstorm action
                            onProjectUpdate?.({
                              ...selectedProject,
                              id: selectedProject?.id || 'unknown',
                              name: selectedProject?.name || 'Unknown Project',
                              description: selectedProject?.description || 'No description available',
                              status: selectedProject?.status || 'in-progress',
                              clientId: selectedProject?.clientId || 'default',
                              dueDate: selectedProject?.dueDate || new Date(),
                              priority: selectedProject?.priority || 'medium',
                              tags: selectedProject?.tags || [],
                              brainstormAction: 'generate_ideas',
                              extendedThinking: extendedThinking,
                              highPowerMode: highPowerMode,
                              timestamp: new Date().toISOString()
                            });
                            
                            onNotificationCreate?.({
                              id: `brainstorm_ideas_${Date.now()}`,
                              type: 'brainstorm_ideas',
                              title: 'Generating Ideas',
                              message: `Generating creative ideas with ${extendedThinking ? 'Extended Thinking' : highPowerMode ? 'High Power Mode' : 'Standard AI'}`,
                              priority: 'medium',
                              timestamp: new Date().toISOString(),
                              source: 'visual_editor'
                            });
                          }}
                          disabled={!extendedThinking && !highPowerMode}
                        >
                          {extendedThinking ? 'Generate Ideas (Extended)' : highPowerMode ? 'Generate Ideas (High Power)' : 'Generate Ideas'}
                        </Button>
                        <Button variant="outlined">AI Suggestions</Button>
                        <Button variant="outlined">Save Notes</Button>
                      </Box>

                      {(extendedThinking || highPowerMode) && (
                        <Card variant="outlined" sx={{ p: 2, backgroundColor: '#e3f2fd' }}>
                          <Typography variant="caption" sx={{ display: 'flex', alignItems: 'center', gap: 0.5, mb: 1 }}>
                            <CostIcon fontSize="small" />
                            Dynamic Intelligence Active
                          </Typography>
                          <Typography variant="body2" color="text.secondary">
                            {extendedThinking && 'Extended Thinking provides deeper reasoning for complex architectural decisions.'}
                            {highPowerMode && ' High Power mode delivers maximum accuracy for critical business logic.'}
                            {extendedThinking && highPowerMode && ' Both features combined for ultimate precision.'}
                          </Typography>
                          {highPowerMode && (
                            <Typography variant="caption" color="warning.main">
                              Estimated cost: ~5x standard rate for this request
                            </Typography>
                          )}
                        </Card>
                      )}
                    </CardContent>
                  </Card>
                </Grid>
                <Grid size={{ xs: 12, md: 4 }}>
                  <Card>
                    <CardContent>
                      <Typography variant="h6" sx={{ mb: 2 }}>
                        Quick Ideas
                      </Typography>
                      <List>
                        <ListItem>
                          <ListItemText
                            primary="Norwegian Creative Platform"
                            secondary="Professional tools for photographers, videographers, and music producers"
                          />
                        </ListItem>
                        <ListItem>
                          <ListItemText
                            primary="AI-Powered Portfolio Builder"
                            secondary="Intelligent layout suggestions and content optimization"
                          />
                        </ListItem>
                        <ListItem>
                          <ListItemText
                            primary="GDPR-Compliant CRM"
                            secondary="Norwegian business-focused client management"
                          />
                        </ListItem>
                      </List>
                    </CardContent>
                  </Card>
                </Grid>
              </Grid>
            )}

            {/* Task Planning Mode */}
            {planMode === 'tasks' && (
              <Card>
                <CardContent>
                  <Typography variant="h6" sx={{ mb: 2 }}>
                    Structured Task Planning
                  </Typography>
                  <Grid container spacing={2}>
                    <Grid size={{ xs: 12, md: 4 }}>
                      <Typography variant="subtitle1" sx={{ mb: 1 }}>To Do</Typography>
                      <List>
                        <ListItem>
                          <ListItemText primary="Design user authentication system" />
                        </ListItem>
                        <ListItem>
                          <ListItemText primary="Implement Google Drive integration" />
                        </ListItem>
                        <ListItem>
                          <ListItemText primary="Create photography portfolio templates" />
                        </ListItem>
                      </List>
                    </Grid>
                    <Grid size={{ xs: 12, md: 4 }}>
                      <Typography variant="subtitle1" sx={{ mb: 1 }}>In Progress</Typography>
                      <List>
                        <ListItem>
                          <ListItemText primary="Visual CMS Editor implementation" />
                        </ListItem>
                        <ListItem>
                          <ListItemText primary="SEO optimization tools" />
                        </ListItem>
                      </List>
                    </Grid>
                    <Grid size={{ xs: 12, md: 4 }}>
                      <Typography variant="subtitle1" sx={{ mb: 1 }}>Completed</Typography>
                      <List>
                        <ListItem>
                          <ListItemText primary="Database schema design" />
                        </ListItem>
                        <ListItem>
                          <ListItemText primary="Basic dashboard structure" />
                        </ListItem>
                      </List>
                    </Grid>
                  </Grid>
                  <Box sx={{ mt: 3 }}>
                    <Button variant="contained" sx={{ mr: 1 }}>Add Task</Button>
                    <Button
                      variant="outlined"
                      sx={{ mr: 1 }}
                      onClick={() => {
                        if (extendedThinking) setUsageCount(prev => ({ ...prev, extendedThinking: prev.extendedThinking + 1 }));
                        if (highPowerMode) setUsageCount(prev => ({ ...prev, highPower: prev.highPower + 1 }));
                      }}
                      disabled={!extendedThinking && !highPowerMode}
                    >
                      {extendedThinking || highPowerMode ? 'AI Task Suggestions (Enhanced)' : 'AI Task Suggestions'}
                    </Button>
                    <Button variant="outlined">Export to Build Mode</Button>

                    {/* Usage Limits Warning */}
                    {highPowerMode && usageCount.highPower >= dailyLimits.free && (
                      <Typography variant="caption" color="warning.main" sx={{ display: 'block', mt: 1 }}>
                        ⚠️ High Power usage: {usageCount.highPower}/{dailyLimits.pro} daily limit (Pro plan)
                      </Typography>
                    )}
                  </Box>
                </CardContent>
              </Card>
            )}

            {/* Architecture Mode */}
            {planMode === 'architecture' && (
              <Card>
                <CardContent>
                  <Typography variant="h6" sx={{ mb: 2 }}>
                    Project Architecture Planning
                  </Typography>
                  <Grid container spacing={3}>
                    <Grid size={{ xs: 12, md: 6 }}>
                      <Typography variant="subtitle1" sx={{ mb: 1 }}>Frontend Architecture</Typography>
                      <List>
                        <ListItem>
                          <ListItemText
                            primary="React.js with TypeScript"
                            secondary="Modern component-based architecture"
                          />
                        </ListItem>
                        <ListItem>
                          <ListItemText
                            primary="Material-UI Design System"
                            secondary="Professional Norwegian-localized UI"
                          />
                        </ListItem>
                        <ListItem>
                          <ListItemText
                            primary="TanStack Query"
                            secondary="Efficient data fetching and caching"
                          />
                        </ListItem>
                      </List>
                    </Grid>
                    <Grid size={{ xs: 12, md: 6 }}>
                      <Typography variant="subtitle1" sx={{ mb: 1 }}>Backend Architecture</Typography>
                      <List>
                        <ListItem>
                          <ListItemText
                            primary="Node.js with Express"
                            secondary="RESTful API with TypeScript"
                          />
                        </ListItem>
                        <ListItem>
                          <ListItemText
                            primary="PostgreSQL Database"
                            secondary="Robust relational data storage"
                          />
                        </ListItem>
                        <ListItem>
                          <ListItemText
                            primary="Google Cloud Services"
                            secondary="Storage, authentication, and analytics"
                          />
                        </ListItem>
                      </List>
                    </Grid>
                  </Grid>
                  <Box sx={{ mt: 3 }}>
                    <Button
                      variant="contained"
                      sx={{ mr: 1 }}
                      onClick={() => {
                        if (extendedThinking) setUsageCount(prev => ({ ...prev, extendedThinking: prev.extendedThinking + 1 }));
                        if (highPowerMode) setUsageCount(prev => ({ ...prev, highPower: prev.highPower + 1 }));
                      }}
                      disabled={!extendedThinking && !highPowerMode}
                    >
                      {extendedThinking || highPowerMode ? 'AI Architecture Review (Enhanced)' : 'AI Architecture Review'}
                    </Button>
                    <Button variant="outlined" sx={{ mr: 1 }}>Export Diagram</Button>
                    <Button variant="outlined">Generate Documentation</Button>

                    {/* Architecture Mode Intelligence Notice */}
                    {(extendedThinking || highPowerMode) && (
                      <Typography variant="body2" color="primary.main" sx={{ mt: 2, p: 1, backgroundColor: '#f3e5f5', borderRadius: 1 }}>
                        💡 With Dynamic Intelligence enabled, architectural reviews include comprehensive trade-off analysis, 
                        scalability considerations, and Norwegian market compliance requirements.
                      </Typography>
                    )}
                  </Box>
                </CardContent>
              </Card>
            )}

            {/* Strategy Mode */}
            {planMode === 'strategy' && (
              <Card>
                <CardContent>
                  <Typography variant="h6" sx={{ mb: 2 }}>
                    Strategic Guidance & Questions
                  </Typography>
                  <TextField
                    fullWidth
                    multiline
                    rows={4}
                    placeholder="Ask strategic questions about your project: market positioning, technical decisions, user experience, business model, etc."
                    variant="outlined"
                    sx={{ mb: 2 }}
                  />
                  <Box sx={{ display: 'flex', gap: 1, mb: 3 }}>
                    <Button
                      variant="contained"
                      onClick={() => {
                        if (extendedThinking) setUsageCount(prev => ({ ...prev, extendedThinking: prev.extendedThinking + 1 }));
                        if (highPowerMode) setUsageCount(prev => ({ ...prev, highPower: prev.highPower + 1 }));
                      }}
                      disabled={!extendedThinking && !highPowerMode}
                    >
                      {extendedThinking || highPowerMode ? 'Get AI Guidance (Enhanced)' : 'Get AI Guidance'}
                    </Button>
                    <Button variant="outlined">Market Analysis</Button>
                    <Button variant="outlined">Competitor Research</Button>
                  </Box>

                  {/* Dynamic Intelligence Status */}
                  {(extendedThinking || highPowerMode) && (
                    <Card variant="outlined" sx={{ mb: 3, p: 2, backgroundColor: '#fff3e0' }}>
                      <Typography variant="subtitle2" sx={{ display: 'flex', alignItems: 'center', gap: 0.5, mb: 1 }}>
                        {extendedThinking && <ExtendedThinkingIcon fontSize="small" color="primary" />}
                        {highPowerMode && <HighPowerIcon fontSize="small" color="warning" />}
                        Dynamic Intelligence: Strategic Analysis Mode
                      </Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                        {extendedThinking && 'Extended Thinking: Comprehensive market analysis with deeper reasoning'}
                        {extendedThinking && highPowerMode && ' + '}
                        {highPowerMode && 'High Power: Maximum accuracy for strategic business decisions'}
                      </Typography>
                      <Typography variant="caption" color="text.secondary">
                        Perfect for: Complex business strategy, competitive positioning, technical architecture decisions
                      </Typography>
                    </Card>
                  )}

                  <Typography variant="subtitle1" sx={{ mb: 1 }}>
                    Common Strategic Questions
                  </Typography>
                  <List>
                    <ListItem>
                      <ListItemText primary="How can I differentiate from international creative platforms?" />
                    </ListItem>
                    <ListItem>
                      <ListItemText primary="What Norwegian market-specific features should I prioritize?" />
                    </ListItem>
                    <ListItem>
                      <ListItemText primary="How do I ensure GDPR compliance for European users?" />
                    </ListItem>
                    <ListItem>
                      <ListItemText primary="What's the best monetization strategy for Norwegian creatives?" />
                    </ListItem>
                  </List>
                </CardContent>
              </Card>
            )}

            {/* Transition to Build Mode */}
            <Card sx={{ mt: 3, backgroundColor: '#e3f2fd' }}>
              <CardContent>
                <Typography variant="h6" sx={{ mb: 1 }}>
                  Ready to Build?
                </Typography>
                <Typography variant="body2" sx={{ mb: 2 }}>
                  When you're ready to implement your plans, seamlessly transition to Visual Designer mode.
                </Typography>
                <Button
                  variant="contained"
                  size="large"
                  onClick={() => setSelectedView('designer')}
                >
                  Go to Build Mode →
                </Button>
              </CardContent>
            </Card>
          </Box>
        )}

        {/* Visual Designer View */}
        {selectedView === 'designer' && (
          <div>
            {/* Left Sidebar - Component Palette */}
            <Paper sx={{ width: 250, p: 2, borderRight: 1, borderColor: 'divider' }}>
              {/* Client Selection */}
              {selectedClient && (
                <Box sx={{ mb: 2, p: 1, backgroundColor: '#e3f2fd', borderRadius: 1 }}>
                  <Typography variant="caption" color="primary">
                    Working with: {selectedClient.name}
                  </Typography>
                </Box>
              )}
              
              <Typography variant="h6" sx={{ mb: 2 }}>
                Components
              </Typography>
              <Stack spacing={1}>
                {componentPaletteWithDrag.map((component) => (
                  <Button
                    key={component.type}
                    variant="outlined"
                    size="small"
                    startIcon={component.icon}
                    onClick={() => addComponent(component.type)}
                    onDragStart={component.onDragStart}
                    onDragEnd={() => {
                      setIsDragging(false);
                      setDraggedComponent(null);
                    }}
                    draggable
                    fullWidth
                    sx={{
                      opacity: isDragging && draggedComponent === component.type ? 0.5 : 1,
                      cursor: 'grab',
                      '&:active': { cursor: 'grabbing' }
                    }}
                  >
                    {component.label}
                  </Button>
                ))}
              </Stack>

              <Divider sx={{ my: 2 }} />

                  <Button
                    variant="outlined"
                startIcon={<ImageIcon />}
                onClick={() => setDrawerOpen(true)}
                    fullWidth
                sx={{ mb: 2 }}
              >
                Asset Library
                    </Button>

              <Typography variant="subtitle2" sx={{ mb: 1 }}>
                Canvas Controls
              </Typography>
              <FormControlLabel
                control={
                  <Switch
                    checked={showGrid}
                    onChange={(e) => {
                      setShowGrid(e.target.checked);
                      // Trigger unified workflow event for grid toggle
                      onProjectUpdate?.({
                        ...selectedProject,
                        id: selectedProject?.id || 'unknown',
                        name: selectedProject?.name || 'Unknown Project',
                        description: selectedProject?.description || 'No description available',
                        status: selectedProject?.status || 'in-progress',
                        clientId: selectedProject?.clientId || 'default',
                        dueDate: selectedProject?.dueDate || new Date(),
                        priority: selectedProject?.priority || 'medium',
                        tags: selectedProject?.tags || [],
                        canvasGridEnabled: e.target.checked,
                        timestamp: new Date().toISOString()
                      });
                    }}
                    size="small"
                  />
                }
                label="Show Grid"
              />
              <Box sx={{ mt: 1 }}>
                <Typography variant="caption">Zoom: {Math.round(canvasZoom * 100)}%</Typography>
                <Slider
                  value={canvasZoom}
                  onChange={(_, value) => {
                    setCanvasZoom(value as number);
                    // Trigger unified workflow event for zoom change
                    onProjectUpdate?.({
                      ...selectedProject,
                      id: selectedProject?.id || 'unknown',
                      name: selectedProject?.name || 'Unknown Project',
                      description: selectedProject?.description || 'No description available',
                      status: selectedProject?.status || 'in-progress',
                      clientId: selectedProject?.clientId || 'default',
                      dueDate: selectedProject?.dueDate || new Date(),
                      priority: selectedProject?.priority || 'medium',
                      tags: selectedProject?.tags || [],
                      canvasZoom: value as number,
                      timestamp: new Date().toISOString()
                    });
                  }}
                  min={0.5}
                  max={2}
                  step={0.1}
                  size="small"
                />
              </Box>
            </Paper>

            {/* Main Canvas */}
            <Box sx={{ flex: 1, position: 'relative', overflow: 'auto' }}>
              {/* Canvas Toolbar */}
              <Box sx={{ 
                  position: 'absolute',
                  top: 10,
                  left: 10,
                  zIndex: 10,
                  display: 'flex',
                gap: 1
              }}>
                <ButtonGroup size="small" variant="outlined">
                  <Tooltip title="Select Tool">
                    <Button startIcon={<SelectIcon />}>Select</Button>
                  </Tooltip>
                  <Tooltip title="Undo">
                    <Button 
                      startIcon={<UndoIcon />}
                      onClick={handleUndo}
                      disabled={historyIndex <= 0}
                    >
                      Undo
                    </Button>
                  </Tooltip>
                  <Tooltip title="Redo">
                    <Button 
                      startIcon={<RedoIcon />}
                      onClick={handleRedo}
                      disabled={historyIndex >= history.length - 1}
                    >
                      Redo
                    </Button>
                  </Tooltip>
                </ButtonGroup>

                <ButtonGroup size="small" variant="outlined">
                  <Button
                    startIcon={<ZoomIn />}
                    onClick={() => setCanvasZoom(Math.min(2, canvasZoom + 0.1))}
                  >
                    Zoom In
                  </Button>
                  <Button
                    startIcon={<ZoomOut />}
                    onClick={() => setCanvasZoom(Math.max(0.5, canvasZoom - 0.1))}
                  >
                    Zoom Out
                  </Button>
                </ButtonGroup>
              </Box>

              {/* Responsive Preview Controls */}
              <Box sx={{ 
                  position: 'absolute',
                  top: 10,
                  right: 10,
                zIndex: 10
              }}>
                <ButtonGroup size="small" variant="outlined">
                  <Button
                    variant={previewMode === 'desktop' ? 'contained' : 'outlined'}
                    onClick={() => {
                      setPreviewMode('desktop');
                      // Trigger unified workflow event for preview mode change
                      onProjectUpdate?.({
                        ...selectedProject,
                        id: selectedProject?.id || 'unknown',
                        name: selectedProject?.name || 'Unknown Project',
                        description: selectedProject?.description || 'No description available',
                        status: selectedProject?.status || 'in-progress',
                        clientId: selectedProject?.clientId || 'default',
                        dueDate: selectedProject?.dueDate || new Date(),
                        priority: selectedProject?.priority || 'medium',
                        tags: selectedProject?.tags || [],
                        timestamp: new Date().toISOString()
                      });
                    }}
                  >
                    Desktop
                  </Button>
                  <Button
                    variant={previewMode === 'tablet' ? 'contained' : 'outlined'}
                    onClick={() => {
                      setPreviewMode('tablet');
                      // Trigger unified workflow event for preview mode change
                      onProjectUpdate?.({
                        ...selectedProject,
                        id: selectedProject?.id || 'unknown',
                        name: selectedProject?.name || 'Unknown Project',
                        description: selectedProject?.description || 'No description available',
                        status: selectedProject?.status || 'in-progress',
                        clientId: selectedProject?.clientId || 'default',
                        dueDate: selectedProject?.dueDate || new Date(),
                        priority: selectedProject?.priority || 'medium',
                        tags: selectedProject?.tags || [],
                        timestamp: new Date().toISOString()
                      });
                    }}
                  >
                    Tablet
                  </Button>
                  <Button
                    variant={previewMode === 'mobile' ? 'contained' : 'outlined'}
                    onClick={() => {
                      setPreviewMode('mobile');
                      // Trigger unified workflow event for preview mode change
                      onProjectUpdate?.({
                        ...selectedProject,
                        id: selectedProject?.id || 'unknown',
                        name: selectedProject?.name || 'Unknown Project',
                        description: selectedProject?.description || 'No description available',
                        status: selectedProject?.status || 'in-progress',
                        clientId: selectedProject?.clientId || 'default',
                        dueDate: selectedProject?.dueDate || new Date(),
                        priority: selectedProject?.priority || 'medium',
                        tags: selectedProject?.tags || [],
                        timestamp: new Date().toISOString()
                      });
                    }}
                  >
                    Mobile
                  </Button>
                </ButtonGroup>
              </Box>

              {/* Advanced Canvas with Rulers */}
              <Box sx={{ position: 'relative' }}>
                {/* Rulers */}
                {showRulers && (
                  <>
                    {/* Horizontal Ruler */}
                    <Box sx={{ 
                      height: 20, 
                      backgroundColor: '#e0e0e0', 
                      borderBottom: '1px solid #ccc',
                      position: 'relative',
                      overflow: 'hidden'
                    }}>
                      <Box sx={{ 
                        width: 20, 
                        height: '100%', 
                        backgroundColor: '#d0d0d0',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        fontSize: 10,
                        fontWeight: 'bold'
                      }}>
                        px
                      </Box>
                      <Box sx={{ 
                        position: 'absolute', 
                        left: 20, 
                        right: 0, 
                        top: 0, 
                        height: '100%',
                        backgroundImage: `linear-gradient(to right, #999 1px, transparent 1px)`,
                        backgroundSize: `${gridSize * canvasZoom}px 20px`,
                        transform: `translateX(${canvasPan.x}px)`
                      }} />
                    </Box>
                    
                    {/* Vertical Ruler */}
                    <Box sx={{ 
                      width: 20, 
                      position: 'absolute', 
                      left: 0, 
                      top: 20, 
                      bottom: 0, 
                      backgroundColor: '#e0e0e0',
                      borderRight: '1px solid #ccc',
                      zIndex: 10
                    }}>
                      <Box sx={{ 
                        height: 20, 
                        width: '100%', 
                        backgroundColor: '#d0d0d0',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        fontSize: 10,
                        fontWeight: 'bold',
                        writingMode: 'vertical-rl'
                      }}>
                        px
                      </Box>
                      <Box sx={{ 
                        position: 'absolute', 
                        top: 20, 
                        left: 0, 
                        right: 0, 
                        bottom: 0,
                        backgroundImage: `linear-gradient(to bottom, #999 1px, transparent 1px)`,
                        backgroundSize: `20px ${gridSize * canvasZoom}px`,
                        transform: `translateY(${canvasPan.y}px)`
                      }} />
                    </Box>
                  </>
                )}

                {/* Canvas */}
                <Paper
                  ref={canvasRef}
                  sx={{
                    m: 2,
                    mt: showRulers ? 0 : 8,
                    ml: showRulers ? 22 : 2,
                    width: getCanvasWidth(),
                    minHeight: 600,
                    mx: showRulers ? 0 : 'auto',
                    position: 'relative',
                    backgroundImage: showGrid ? getGridPattern() : 'none',
                    backgroundSize: showGrid ? `${gridSize * canvasZoom}px ${gridSize * canvasZoom}px` : 'initial',
                    backgroundPosition: `${canvasPan.x}px ${canvasPan.y}px`,
                    transform: `scale(${canvasZoom}) translate(${canvasPan.x}px, ${canvasPan.y}px)`,
                    transformOrigin: 'top left',
                    backgroundColor: canvasBackground,
                    overflow: 'visible',
                    cursor: isPanning ? 'grabbing' : (isDragging ? 'grabbing' : 'grab'),
                    transition: 'transform 0.1s ease-out'
                  }}
                  onClick={handleCanvasClick}
                  onMouseDown={(e) => {
                    if (e.target === e.currentTarget) {
                      setIsPanning(true);
                      setPanStart({ x: e.clientX - canvasPan.x, y: e.clientY - canvasPan.y });
                    }
                  }}
                  onMouseUp={() => setIsPanning(false)}
                  onMouseMove={(e) => {
                    if (isPanning) {
                      setCanvasPan({
                        x: e.clientX - panStart.x,
                        y: e.clientY - panStart.y
                      });
                    }
                  }}
                  onWheel={(e) => {
                    e.preventDefault();
                    const delta = e.deltaY > 0 ? -0.1 : 0.1;
                    handleCanvasZoom(delta);
                  }}
                  onDragOver={(e) => {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'copy';
                  }}
                  onDrop={(e) => {
                    e.preventDefault();
                    const componentType = e.dataTransfer.getData('text/plain');
                    if (componentType && draggedComponent) {
                      const rect = canvasRef.current?.getBoundingClientRect();
                    if (rect) {
                      let x = (e.clientX - rect.left) / canvasZoom;
                      let y = (e.clientY - rect.top) / canvasZoom;
                      
                      // Snap to grid if enabled
                      if (snapToGrid) {
                        x = Math.round(x / gridSize) * gridSize;
                        y = Math.round(y / gridSize) * gridSize;
                      }
                      
                      addComponent(componentType, x, y);
                    }
                    setIsDragging(false);
                    setDraggedComponent(null);
                  }
                }}
              >
                {/* Render Elements */}
                {Object.values(project.elements).map((element) => (
                    <Box
                      key={element.id}
                      onClick={(e) => handleElementClick(element.id, e)}
                      onDoubleClick={() => element.type === 'text' && openTextEditor(element.id)}
                      sx={{
                        position: 'absolute',
                        left: element.x,
                        top: element.y,
                        width: element.width,
                        height: element.type === 'text' ? 'auto' : element.height,
                        border: selectedElement === element.id ? '2px solid #1976d2' : '1px solid transparent',
                        cursor: lockedElements.includes(element.id) ? 'not-allowed' : 'pointer',
                        opacity: lockedElements.includes(element.id) ? 0.7 : 1,
                        '&:hover': {
                          border: selectedElement === element.id ? '2px solid #1976d2' : '1px solid #1976d2'
                        },
                        ...element.styles,
                        ...(highContrastMode && {
                          border: '2px solid #000',
                          backgroundColor: element.styles.backgroundColor || '#fff',
                          color: '#000'
                        }),
                        ...(screenReaderMode && {
                          '&::before': {
                            content: `"${element.type} element"`,
                            position: 'absolute',
                            top: -20,
                            left: 0,
                            fontSize: 12,
                            backgroundColor: '#000',
                            color: '#fff',
                            padding: '2px 4px',
                            borderRadius: 2,
                            zIndex: 1000
                          }
                        })
                      }}
                    >
                      {/* Lock Indicator */}
                      {lockedElements.includes(element.id) && (
                        <Box
                          sx={{
                            position: 'absolute',
                            top: -8,
                            right: -8,
                            backgroundColor: '#ff9800',
                            borderRadius: '50%',
                            width: 16,
                            height: 16,
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                            zIndex: 100
                          }}
                        >
                          <Lock sx={{ fontSize: 10, color: 'white' }} />
                        </Box>
                      )}

                      {/* Resize Handles */}
                      {selectedElement === element.id && !lockedElements.includes(element.id) && (
                        <>
                          {/* Corner handles */}
                          {['nw', 'ne', 'sw', 'se'].map((handle) => (
                            <Box
                              key={handle}
                              sx={{
                                position: 'absolute',
                                width: 8,
                                height: 8,
                                backgroundColor: '#1976d2',
                                border: '1px solid white',
                                cursor: `${handle}-resize`,
                                ...(handle === 'nw' && { top: -4, left: -4 }),
                                ...(handle === 'ne' && { top: -4, right: -4 }),
                                ...(handle === 'sw' && { bottom: -4, left: -4 }),
                                ...(handle === 'se' && { bottom: -4, right: -4 })
                              }}
                              onMouseDown={(e) => {
                                e.stopPropagation();
                                setIsResizing(true);
                                setResizeHandle(handle);
                              }}
                            />
                          ))}
                          
                          {/* Edge handles */}
                          {['n', 's', 'e', 'w'].map((handle) => (
                            <Box
                              key={handle}
                              sx={{
                                position: 'absolute',
                                backgroundColor: '#1976d2',
                                border: '1px solid white',
                                ...(handle === 'n' && { top: -4, left: '50%', transform: 'translateX(-50%)', width: 8, height: 4, cursor: 'n-resize' }),
                                ...(handle === 's' && { bottom: -4, left: '50%', transform: 'translateX(-50%)', width: 8, height: 4, cursor: 's-resize' }),
                                ...(handle === 'e' && { right: -4, top: '50%', transform: 'translateY(-50%)', width: 4, height: 8, cursor: 'e-resize' }),
                                ...(handle === 'w' && { left: -4, top: '50%', transform: 'translateY(-50%)', width: 4, height: 8, cursor: 'w-resize' })
                              }}
                              onMouseDown={(e) => {
                                e.stopPropagation();
                                setIsResizing(true);
                                setResizeHandle(handle);
                              }}
                            />
                          ))}

                          {/* Rotation Handle */}
                          <Box
                            sx={{
                              position: 'absolute',
                              top: -20,
                              left: '50%',
                              transform: 'translateX(-50%)',
                              width: 8,
                              height: 8,
                              backgroundColor: '#ff9800',
                              border: '1px solid white',
                              borderRadius: '50%',
                              cursor: 'grab'
                            }}
                            onMouseDown={(e) => {
                              e.stopPropagation();
                              setIsRotating(true);
                              setRotationCenter({
                                x: element.x + element.width / 2,
                                y: element.y + element.height / 2
                              });
                            }}
                          />
                        </>
                      )}

                      {/* Comments Indicator */}
                      {comments[element.id] && comments[element.id].length > 0 && (
                        <Box
                          sx={{
                            position: 'absolute',
                            top: -8,
                            left: -8,
                            backgroundColor: '#4caf50',
                            borderRadius: '50%',
                            width: 16,
                            height: 16,
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                            zIndex: 100
                          }}
                        >
                          <Comment sx={{ fontSize: 10, color: 'white' }} />
                        </Box>
                      )}

                      {/* ScrollStories Animation Indicator */}
                      {scrollAnimations[element.id] && (
                        <Box
                          sx={{
                            position: 'absolute',
                            top: -8,
                            right: -8,
                            backgroundColor: '#9c27b0',
                            borderRadius: '50%',
                            width: 16,
                            height: 16,
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                            zIndex: 100
                          }}
                        >
                          <ViewStream sx={{ fontSize: 10, color: 'white' }} />
                        </Box>
                      )}
                    {/* Render based on element type */}
                    {element.type === 'text' && (
                      <Typography
                        sx={{
                          fontSize: element.styles.fontSize,
                          fontWeight: element.styles.fontWeight,
                          color: element.styles.color,
                          lineHeight: element.styles.lineHeight
                        }}
                      >
                        {element.props.text}
                      </Typography>
                    )}
                    {element.type === 'button' && (
                      <Button
                        variant={element.props.variant || 'contained'}
                        sx={{
                          backgroundColor: element.styles.backgroundColor,
                          color: element.styles.color,
                          padding: element.styles.padding,
                          borderRadius: element.styles.borderRadius
                        }}
                      >
                        {element.props.text}
                      </Button>
                    )}
                    {element.type === 'card' && (
                      <Card sx={{ width: '100%', height: '100%' }}>
                        <CardContent>
                          <Typography>Card Content</Typography>
                        </CardContent>
                      </Card>
                        )}
                      </Box>
                ))}
              </Paper>
            </Box>
            </Box>

            {/* Right Sidebar - Property Inspector */}
            <Paper sx={{ width: 300, p: 2, borderLeft: 1, borderColor: 'divider' }}>
              <Typography variant="h6" sx={{ mb: 2 }}>
                Properties
              </Typography>

              {selectedElement ? (
                <Stack spacing={2}>
                  <Typography variant="subtitle2">
                    Selected: {project.elements[selectedElement]?.type}
                  </Typography>

                  {/* Element Properties */}
                      <TextField
                        label="Width"
                    value={project.elements[selectedElement]?.width || 'auto'}
                    onChange={(e) => updateElement(selectedElement, { width: parseInt(e.target.value) || 0 })}
                        size="small"
                        fullWidth
                      />
                      <TextField
                        label="Height"
                    value={project.elements[selectedElement]?.height || 'auto'}
                    onChange={(e) => updateElement(selectedElement, { height: parseInt(e.target.value) || 0 })}
                        size="small"
                        fullWidth
                      />
                      <TextField
                        label="X Position"
                    value={project.elements[selectedElement]?.x || 0}
                    onChange={(e) => updateElement(selectedElement, { x: parseInt(e.target.value) || 0 })}
                        size="small"
                        fullWidth
                      />
                      <TextField
                        label="Y Position"
                    value={project.elements[selectedElement]?.y || 0}
                    onChange={(e) => updateElement(selectedElement, { y: parseInt(e.target.value) || 0 })}
                        size="small"
                        fullWidth
                      />
                  
                  {/* Text Content for text/button elements */}
                  {(project.elements[selectedElement]?.type === 'text' || 
                    project.elements[selectedElement]?.type === 'button') && (
                    <TextField
                      label="Text Content"
                      value={project.elements[selectedElement]?.props?.text || ''}
                      onChange={(e) => updateElement(selectedElement, { 
                          props: {
                          ...project.elements[selectedElement].props, 
                          text: e.target.value 
                        }
                      })}
                      size="small"
                      fullWidth
                      multiline
                      rows={2}
                    />
                  )}

                  {/* Style Properties */}
                      <Divider />
                      <Typography variant="subtitle2">Styles</Typography>

                      <TextField
                        label="Background Color"
                    value={project.elements[selectedElement]?.styles?.backgroundColor || '#ffffff'}
                    onChange={(e) => updateElement(selectedElement, {
                            styles: {
                        ...project.elements[selectedElement].styles,
                        backgroundColor: e.target.value
                      }
                    })}
                        size="small"
                        fullWidth
                        type="color"
                      />

                      <TextField
                        label="Text Color"
                    value={project.elements[selectedElement]?.styles?.color || '#000000'}
                    onChange={(e) => updateElement(selectedElement, {
                            styles: {
                        ...project.elements[selectedElement].styles,
                        color: e.target.value
                      }
                    })}
                        size="small"
                        fullWidth
                        type="color"
                      />

                      <TextField
                        label="Padding"
                    value={project.elements[selectedElement]?.styles?.padding || '16px'}
                    onChange={(e) => updateElement(selectedElement, {
                            styles: {
                        ...project.elements[selectedElement].styles,
                        padding: e.target.value
                      }
                    })}
                        size="small"
                        fullWidth
                      />

                      <TextField
                        label="Border Radius"
                    value={project.elements[selectedElement]?.styles?.borderRadius || '4px'}
                    onChange={(e) => updateElement(selectedElement, {
                            styles: {
                        ...project.elements[selectedElement].styles,
                        borderRadius: e.target.value
                      }
                    })}
                        size="small"
                        fullWidth
                      />

                      {/* Font Size for text elements */}
                  {project.elements[selectedElement]?.type === 'text' && (
                        <TextField
                          label="Font Size"
                      value={project.elements[selectedElement]?.styles?.fontSize || '1rem'}
                      onChange={(e) => updateElement(selectedElement, {
                              styles: {
                          ...project.elements[selectedElement].styles,
                          fontSize: e.target.value
                        }
                      })}
                          size="small"
                          fullWidth
                        />
                      )}

                      <Button
                        variant="outlined"
                        color="error"
                        size="small"
                        startIcon={<RemoveIcon />}
                    onClick={() => deleteElement(selectedElement)}
                      >
                        Delete Element
                      </Button>
                </Stack>
              ) : (
                <Typography variant="body2" color="text.secondary">
                  Select an element to view its properties
                </Typography>
              )}

              <Divider sx={{ my: 2 }} />

              {/* Layers Panel */}
              <Typography variant="subtitle2" sx={{ mb: 1 }}>
                Layers
              </Typography>
              <List dense>
                {Object.values(project.elements).map((element) => (
                    <ListItem
                      key={element.id}
                    onClick={() => setSelectedElement(element.id)}
                      sx={{
                        cursor: 'pointer',
                      backgroundColor: selectedElement === element.id ? 'action.selected' : 'transparent'
                      }}
                    >
                      <ListItemIcon>
                        <LayersIcon fontSize="small" />
                      </ListItemIcon>
                      <ListItemText
                        primary={`${element.type} (${element.id})`}
                        secondary={`${element.x}, ${element.y}`}
                      />
                    </ListItem>
                ))}
              </List>
            </Paper>
          </div>
        )}

        {/* Code View */}
        {(selectedView as string) === 'code' && (
          <Box sx={{ flex: 1, p: 2 }}>
            <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
              <Typography variant="h6">
                Generated Code
              </Typography>
                <Button 
                  startIcon={<SaveIcon />}
                onClick={() => {
                  const code = generateCode();
                  handleCodeExport(code);
                }}
              >
                Export Code
                </Button>
            </Box>
            <Paper sx={{ height: 'calc(100vh - 140px)' }}>
              <MonacoEditor
                height="100%"
                defaultLanguage="javascript"
                value={generateCode()}
                options={{
                  minimap: { enabled: false },
                  fontSize: 14,
                  wordWrap: 'on',
                  automaticLayout: true,
                  readOnly: true
                }}
              />
            </Paper>
          </Box>
        )}

        {/* SEO & Audit View */}
        {(selectedView as string) === 'seo' && (
          <Box sx={{ flex: 1, p: 3 }}>
            <Typography variant="h4" sx={{ mb: 2 }}>
              SEO & Google Audit Tools
            </Typography>
            <Typography variant="body1" color="text.secondary" sx={{ mb: 4 }}>
              Manage page links, SEO optimization, and run comprehensive Google audits for performance and accessibility.
            </Typography>

            <Grid container spacing={3}>
              {/* Competitor Analysis */}
              <Grid size={{ xs: 12, md: 6 }}>
                <Card>
                  <CardContent>
                    <Typography variant="h6" sx={{ mb: 2 }}>
                      🏆 Competitor Analysis
                    </Typography>
                    <Stack spacing={2}>
                      <TextField
                        label="Competitor URL"
                        placeholder="https://competitor-website.com"
                        fullWidth
                        size="small"
                        value={competitorUrl || ''}
                        onChange={(e) => setCompetitorUrl(e.target.value)}
                      />
                      <Box sx={{ display: 'flex', gap: 1, flexWrap: 'wrap' }}>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => analyzeCompetitor('keywords')}
                          disabled={!competitorUrl}
                        >
                          Analyze Keywords
                        </Button>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => analyzeCompetitor('backlinks')}
                          disabled={!competitorUrl}
                        >
                          Check Backlinks
                        </Button>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => analyzeCompetitor('content')}
                          disabled={!competitorUrl}
                        >
                          Content Analysis
                        </Button>
                      </Box>
                      {competitorAnalysis && (
                        <Box sx={{ mt: 2, p: 2, bgcolor: 'grey.50', borderRadius: 1 }}>
                          <Typography variant="subtitle2" sx={{ mb: 1 }}>
                            Analysis Results:
                          </Typography>
                          <Typography variant="body2" color="text.secondary">
                            {competitorAnalysis.summary}
                          </Typography>
                          {competitorAnalysis.keywords && (
                            <Box sx={{ mt: 1 }}>
                              <Typography variant="caption" color="primary">
                                Top Keywords: {competitorAnalysis.keywords.slice(0, 5).join(', ')}
                              </Typography>
                            </Box>
                          )}
                        </Box>
                      )}
                    </Stack>
                  </CardContent>
                </Card>
              </Grid>

              {/* Keyword Research */}
              <Grid size={{ xs: 12, md: 6 }}>
                <Card>
                  <CardContent>
                    <Typography variant="h6" sx={{ mb: 2 }}>
                      🔍 Keyword Research
                    </Typography>
                    <Stack spacing={2}>
                      <TextField
                        label="Seed Keyword"
                        placeholder="Norwegian photography"
                        fullWidth
                        size="small"
                        value={seedKeyword || ''}
                        onChange={(e) => setSeedKeyword(e.target.value)}
                      />
                      <Box sx={{ display: 'flex', gap: 1, flexWrap: 'wrap' }}>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => researchKeywords('related')}
                          disabled={!seedKeyword}
                        >
                          Related Keywords
                        </Button>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => researchKeywords('longtail')}
                          disabled={!seedKeyword}
                        >
                          Long-tail Keywords
                        </Button>
                        <Button 
                          variant="outlined" 
                          size="small"
                          onClick={() => researchKeywords('suggestions')}
                          disabled={!seedKeyword}
                        >
                          Suggestions
                        </Button>
                      </Box>
                      {keywordResearch && (
