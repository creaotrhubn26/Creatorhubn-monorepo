    return response.ok;
  };

  const translateText = useCallback(async (text: string, targetLanguage: string) => {
    try {
      const auth = await getAuthHeader();
    const response = await apiRequest('/api/google/translate', {
      headers: {
        ...auth,
        'Content-Type': 'application/json'
      },
      method: 'POST',
      body: JSON.stringify({ text, targetLanguage })
    });
      const result = await response.json();
      return result.translatedText;
    } catch (error) {
      console.error('Translation failed:', error);
      return text;
    }
  }, []);

  // Create ScrollStory from Google content
  const createScrollStoryFromGoogle = useCallback((contentType: string, content: any[]) => {
    const storyName = `Google ${contentType} Story - ${content.length} items`;
    const newStory = {
      id: `google_${contentType}_story_${Date.now()}`,
      name: storyName,
      source: 'google',
      googleData: content,
      elements: [],
      scrollTriggers: [],
      animations: [],
      settings: {
        duration: 1500,
        easing: 'ease-in-out',
        loop: false,
        autoPlay: false,
        googleIntegration: true
      },
      createdAt: new Date().toISOString()
    };
    
    // Convert Google content to scroll story elements
    const storyElements: EditorElement[] = [];
    let currentY = 0;
    
    content.forEach((item, index) => {
      const element: EditorElement = {
        id: `google_${contentType}_${index}`,
        type: contentType === 'photos' ? 'image' : 
              contentType === 'videos' ? 'video' : 
              contentType === 'docs' ? 'text' : 'container',
        x: 50,
        y: currentY,
        width: 500,
        height: contentType === 'photos' ? 300 : 200,
        styles: {
          backgroundColor: '#ffffff',
          border: '1px solid #e0e0e0',
          borderRadius: '8px',
          padding: '20px',
          boxShadow: '0 2px 8px rgba(0,0,0,0.1)'
        },
        props: {
          src: item.thumbnail || item.url,
          alt: item.title || item.name,
          title: item.title || item.name,
          description: item.description || '',
          googleId: item.id,
          googleUrl: item.webViewLink || item.url,
          isGoogleContent: true
        }
      };
      
      storyElements.push(element);
      currentY += (contentType === 'photos' ? 300 : 200) + 100;
    });
    
    // Create the story with elements
    const storyWithElements = {
      ...newStory,
      elements: storyElements
    };
    
    createStory(storyWithElements);
    selectStory(storyWithElements);
    
    // Add scroll animations
    storyElements.forEach((element, index) => {
      addScrollAnimation(element.id, {
        type: 'fadeInUp',
        triggerPoint: index * 0.15,
        duration: 800,
        easing: 'ease-out'
      });
    });
    
    // Trigger unified workflow events
      onProjectUpdate?.({
        ...selectedProject,
        id: selectedProject?.id || 'unknown',
        name: selectedProject?.name || 'Unknown Project',
        description: selectedProject?.description || 'No description available',
        status: selectedProject?.status || 'in-progress',
        clientId: selectedProject?.clientId || 'default',
        dueDate: selectedProject?.dueDate || new Date(),
        priority: selectedProject?.priority || 'medium',
        tags: selectedProject?.tags || [],
        lastGoogleStoryCreated: new Date().toISOString(),
      googleStoriesCount: (selectedProject?.googleStoriesCount || 0) + 1,
      lastStoryType: 'google_content'
    });
    
    onWorklogCreate?.({
      id: `google_story_created_${Date.now()}`,
      projectId: selectedProject?.id || 'unknown',
      task: 'Google Story Creation',
      description: `Created scroll story from Google ${contentType}: "${storyName}"`,
      timeSpent: 45,
      date: new Date(),
      status: 'completed',
      tags: ['story', 'google', contentType]
    });
    
    onMeetingCreate?.({
      id: `google_story_review_${Date.now()}`,
      title: `Review Google ${contentType} Story`,
      description: `Review the newly created scroll story from Google ${contentType}`,
      date: new Date(Date.now() + 30 * 60 * 1000), // 30 minutes from now
      participants: ['designer', 'client'],
      agenda: ['Review story content', 'Provide feedback', 'Plan next steps'],
      status: 'scheduled',
      notes: `Story ID: ${newStory.id}, Content Type: ${contentType}`
    });
    
    onNotificationCreate?.({
      id: `google_story_created_${Date.now()}`,
      type: 'scroll_story_created',
      title: 'Google Content Scroll Story Created',
      message: `"${storyName}" has been created with ${storyElements.length} Google elements`,
      priority: 'medium',
      timestamp: new Date().toISOString(),
      source: 'visual_editor'
    });
  }, [addScrollAnimation, onNotificationCreate, selectedProject, onProjectUpdate, onWorklogCreate, onMeetingCreate]);

  // Memoized canvas dimensions
