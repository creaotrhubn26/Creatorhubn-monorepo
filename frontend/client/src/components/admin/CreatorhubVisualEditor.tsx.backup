  }, [canvasZoom]);

  const handleCanvasPan = useCallback((deltaX: number, deltaY: number) => {
    setCanvasPan(prev => ({
      x: prev.x + deltaX,
      y: prev.y + deltaY
    }));
  }, []);

  const resetCanvasView = useCallback(() => {
    setCanvasZoom(1);
    setCanvasPan({ x: 0, y: 0 });
  }, []);

  const fitToScreen = useCallback(() => {
    setCanvasZoom(0.8);
    setCanvasPan({ x: 0, y: 0 });
  }, []);

  // Element Manipulation Functions
  const handleElementResize = useCallback((elementId: string, handle: string, deltaX: number, deltaY: number) => {
    const element = project.elements[elementId];
    if (!element || lockedElements.includes(elementId)) return;

    let newWidth = element.width;
    let newHeight = element.height;
    let newX = element.x;
    let newY = element.y;

    switch (handle) {
      case 'nw':
        newWidth -= deltaX;
        newHeight -= deltaY;
        newX += deltaX;
        newY += deltaY;
        break;
      case 'ne':
        newWidth += deltaX;
        newHeight -= deltaY;
        newY += deltaY;
        break;
      case 'sw':
        newWidth -= deltaX;
        newHeight += deltaY;
        newX += deltaX;
        break;
      case 'se':
        newWidth += deltaX;
        newHeight += deltaY;
        break;
    }

    updateElement(elementId, {
      x: newX,
      y: newY,
      width: Math.max(20, newWidth),
      height: Math.max(20, newHeight)
    });
  }, [project.elements, lockedElements, updateElement]);

  const handleElementRotation = useCallback((elementId: string, angle: number) => {
    if (lockedElements.includes(elementId)) return;
    
    updateElement(elementId, {
      styles: {
        ...project.elements[elementId].styles,
        transform: `rotate(${angle}deg)`
      }
    });
  }, [project.elements, lockedElements, updateElement]);

