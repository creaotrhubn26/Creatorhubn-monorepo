  // Initialize functions (moved before useEffect)
  const initializeAnimationPresets = useCallback(() => {
    const presets = [
      {
        id: 'fadeInUp',
        name: 'Fade In Up',
        type: 'fadeIn',
        properties: { 
          from: { opacity: 0, transform: 'translateY(30px)' },
          to: { opacity: 1, transform: 'translateY(0)' },
          duration: 800,
          easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)'
        }
      },
      {
        id: 'slideInLeft',
        name: 'Slide In Left',
        type: 'slideIn',
        properties: {
          from: { transform: 'translateX(-100px)' },
          to: { transform: 'translateX(0)' },
          duration: 600,
          easing: 'ease-out'
        }
      },
      {
        id: 'scaleIn',
        name: 'Scale In',
        type: 'scaleIn',
        properties: {
          from: { transform: 'scale(0.8)', opacity: 0 },
          to: { transform: 'scale(1)', opacity: 1 },
          duration: 500,
          easing: 'cubic-bezier(0.68, -0.55, 0.265, 1.55)'
        }
      },
      {
        id: 'rotateIn',
        name: 'Rotate In',
        type: 'rotateIn',
        properties: {
          from: { transform: 'rotate(-180deg) scale(0.5)', opacity: 0 },
          to: { transform: 'rotate(0deg) scale(1)', opacity: 1 },
          duration: 700,
          easing: 'ease-out'
        }
      }
    ];
    setAnimationPresets(presets);
  }, []);

  const initializeEasingFunctions = useCallback(() => {
    const easings = [
      { id: 'ease', name: 'Ease', value: 'ease' },
      { id: 'easeIn', name: 'Ease In', value: 'ease-in' },
      { id: 'easeOut', name: 'Ease Out', value: 'ease-out' },
      { id: 'easeInOut', name: 'Ease In Out', value: 'ease-in-out' },
      { id: 'linear', name: 'Linear', value: 'linear' },
      { id: 'cubicBezier', name: 'Cubic Bezier', value: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)' }
    ];
    setEasingFunctions(easings);
  }, []);

  const initializeGoogleServices = useCallback(async () => {
    try {
      const auth = await getAuthHeader();
      const response = await apiRequest('/api/google/services/initialize', {
        headers: {
          ...auth,
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${localStorage.getItem('token')}`
        },
        method: 'POST'
      });
      
      if (response.ok) {
        const services = await response.json();
        setGoogleServices(services);
      }
    } catch (error) {
      console.error('Failed to initialize Google services:', error);
    }
  }, []);






  // Quality Analysis interfaces (from CompleteDeploymentManager)
  interface QualityAnalysisResult {
    overallScore: number;
    categories: {
      typeSafety: { score: number; issues: string[]; suggestions: string[] };
      security: { score: number; issues: string[]; suggestions: string[] };
      performance: { score: number; issues: string[]; suggestions: string[] };
      errorHandling: { score: number; issues: string[]; suggestions: string[] };
      codeQuality: { score: number; issues: string[]; suggestions: string[] };
      integration: { score: number; issues: string[]; suggestions: string[] };
      iconSystem: { score: number; issues: string[]; suggestions: string[] };
      branding: { score: number; issues: string[]; suggestions: string[] };
    };
    criticalIssues: string[];
    warnings: string[];
    recommendations: string[];
    lastAnalyzed: string;
    componentAnalyses?: ComponentAnalysis[];
  }

  // Advanced SEO Interfaces
  interface CrawledPage {
    url: string;
    title: string;
    metaDescription: string;
    headings: { level: number; text: string; id?: string }[];
    images: { src: string; alt: string; title?: string }[];
    links: { href: string; text: string; title?: string; internal: boolean }[];
    statusCode: number;
    loadTime: number;
    wordCount: number;
    canonicalUrl?: string;
    robotsDirective?: string;
    hreflang?: { lang: string; url: string }[];
    structuredData?: StructuredDataItem[];
    socialMeta?: SocialMetaData;
    accessibility?: AccessibilityCheck[];
    lastCrawled: string;
  }

  interface StructuredDataItem {
    type: string;
    schema: string;
    properties: Record<string, any>;
    validation: {
      valid: boolean;
      errors: string[];
      warnings: string[];
    };
  }

  interface SocialMetaData {
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogType?: string;
    twitterCard?: string;
    twitterTitle?: string;
    twitterDescription?: string;
    twitterImage?: string;
  }

  interface AccessibilityCheck {
    type: 'error' | 'warning' | 'info';
    message: string;
    element?: string;
    wcagLevel?: 'A' | 'AA' | 'AAA';
  }

  interface SEOCrawlResult {
    totalPages: number;
    crawledPages: CrawledPage[];
    issues: SEOIssue[];
    siteArchitecture: SiteArchitecture;
    performance: SitePerformance;
    contentAnalysis: ContentAnalysis;
    technicalSEO: TechnicalSEOAnalysis;
    lastCrawled: string;
  }

  interface SEOIssue {
    id: string;
    type: 'error' | 'warning' | 'info';
    category: 'technical' | 'content' | 'performance' | 'accessibility' | 'structured-data';
    title: string;
    description: string;
    affectedPages: string[];
    severity: 'low' | 'medium' | 'high' | 'critical';
    fixable: boolean;
    fixSuggestion?: string;
  }

  interface SiteArchitecture {
    depth: number;
    orphanPages: string[];
    redirectChains: { from: string; to: string; chain: string[] }[];
    brokenLinks: { url: string; sourcePages: string[]; statusCode: number }[];
    internalLinking: { page: string; incomingLinks: number; outgoingLinks: number }[];
    sitemapIssues: { missing: string[]; orphan: string[]; invalid: string[] };
  }

  interface SitePerformance {
    averageLoadTime: number;
    slowPages: { url: string; loadTime: number }[];
    coreWebVitals: {
      lcp: { value: number; status: 'good' | 'needs-improvement' | 'poor' };
      fid: { value: number; status: 'good' | 'needs-improvement' | 'poor' };
      cls: { value: number; status: 'good' | 'needs-improvement' | 'poor' };
    };
    mobileUsability: { issues: string[]; score: number };
  }

  interface ContentAnalysis {
    duplicateContent: { urls: string[]; similarity: number }[];
    titleIssues: { url: string; issue: string; current: string; suggested?: string }[];
    metaDescriptionIssues: { url: string; issue: string; current: string; suggested?: string }[];
    headingStructure: { url: string; issues: string[] }[];
    contentQuality: { url: string; score: number; issues: string[] }[];
    keywordDensity: { url: string; keywords: { word: string; density: number; count: number }[] }[];
  }

  interface TechnicalSEOAnalysis {
    robotsTxt: { valid: boolean; issues: string[]; directives: string[] };
    sitemaps: { found: string[]; valid: string[]; issues: string[] };
    canonicalIssues: { url: string; issue: string }[];
    hreflangIssues: { url: string; issue: string }[];
    schemaValidation: { valid: number; invalid: number; errors: string[] };
    mobileUsability: { issues: string[]; score: number };
    security: { https: boolean; issues: string[] };
  }

