interface TextEffect {
  type: 'shadow' | 'outline' | 'glow' | 'gradient' | 'emboss' | 'engrave';
  value: string | number;
  color?: string;
  intensity?: number;
}

interface Animation {
  id: string;
  type: 'fade' | 'slide' | 'scale' | 'rotate' | 'bounce' | 'shake' | 'pulse' | 'wiggle';
  duration: number;
  delay: number;
  easing: string;
  direction?: 'in' | 'out' | 'in-out';
  iterations?: number;
  fillMode?: 'none' | 'forwards' | 'backwards' | 'both';
}

interface HoverEffect {
  type: 'scale' | 'glow' | 'shadow' | 'color' | 'rotate' | 'translate';
  value: string | number;
  duration: number;
  easing: string;
}

interface ClickAnimation {
  type: 'bounce' | 'shake' | 'pulse' | 'flash' | 'zoom';
  duration: number;
  intensity: number;
  easing: string;
}

interface ParallaxEffect {
  speed: number;
  direction: 'horizontal' | 'vertical' | 'diagonal';
  intensity: number;
  enabled: boolean;
}

interface ParticleSystem {
  type: 'snow' | 'rain' | 'stars' | 'confetti' | 'fireworks';
  count: number;
  speed: number;
  size: number;
  color: string;
  enabled: boolean;
}

interface ScrollAnimation {
  triggerPoint: number;
  animation: Animation;
  elementId: string;
  enabled: boolean;
}

interface AdvancedAnimation {
  type: 'morph' | 'liquid' | 'elastic' | 'spring' | 'physics';
  properties: Record<string, any>;
  duration: number;
  easing: string;
  loop: boolean;
}

interface Comment {
  id: string;
  author: string;
  content: string;
  timestamp: string;
  elementId: string;
  resolved?: boolean;
  replies?: Comment[];
}

