  // Component palette
  const componentPalette = [
    { type: 'button', label: 'Button', icon: <SelectIcon /> },
    { type: 'text', label: 'Text', icon: <TextFieldsIcon /> },
    { type: 'image', label: 'Image', icon: <ImageIcon /> },
    { type: 'card', label: 'Card', icon: <LayersIcon /> },
    { type: 'container', label: 'Container', icon: <ContainerIcon /> },
    { type: 'grid', label: 'Grid Layout', icon: <GridLayoutIcon /> }
  ];

  // API queries for project persistence
  const { data: savedProject, isLoading: projectLoading } = useQuery({
    queryKey: ['/api/visual-editor/project', selectedProject?.id],
    queryFn: () => apiRequest(`/api/visual-editor/project/${selectedProject?.id}`),
    enabled: !!selectedProject?.id,
    staleTime: 30000
  });

  const { data: userAssets } = useQuery({
    queryKey: ['/api/visual-editor/assets', user?.id],
    queryFn: () => apiRequest(`/api/visual-editor/assets/${user?.id}`),
    enabled: !!user?.id,
    staleTime: 60000
  });

  // Mutations for project operations
  const saveProjectMutation = useMutation({
    mutationFn: async (projectData: EditorProject) => {
      const auth = await getAuthHeader();
      return apiRequest('/api/visual-editor/project', {
        headers: {
          ...auth,
          'Content-Type': 'application/json'
        },
        method: 'POST',
        body: JSON.stringify(projectData)
      });
    },
    onSuccess: (savedProject: any) => {
      queryClient.invalidateQueries({ queryKey: ['/api/visual-editor/project'] });
      onProjectUpdate?.(savedProject);
      onNotificationCreate?.({
        id: `project_saved_${Date.now()}`,
        type: 'project_saved',
        title: 'Project Saved',
        message: `Project "${savedProject.name}" saved successfully`,
        priority: 'low',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    }
  });

  const uploadAssetMutation = useMutation({
    mutationFn: async (file: File) => {
      const formData = new FormData();
      formData.append('file', file);
      formData.append('userId', user?.id || '');
      const auth = await getAuthHeader();
      return apiRequest('/api/visual-editor/upload-asset', {
        headers: auth,
        method: 'POST',
        body: formData
      });
    },
    onSuccess: (asset: any) => {
      setUploadedAssets((prev: any) => [...prev, asset]);
      onFileUpload?.(asset);
      onNotificationCreate?.({
        id: `asset_uploaded_${Date.now()}`,
        type: 'asset_uploaded',
        title: 'Asset Uploaded',
        message: `Asset "${asset.name}" uploaded successfully`,
        priority: 'low',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    }
  });

  // ✅ Quality Analysis mutations (from CompleteDeploymentManager)
  const runQualityAnalysisMutation = useMutation({
    mutationFn: async (targetPath?: string) => {
      const auth = await getAuthHeader();
      return apiRequest('/api/quality-analysis/run', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({ 
          targetPath: targetPath || 'client/src/components/admin/CreatorhubVisualEditor.tsx',
          componentName: 'CreatorhubVisualEditor',
          analysisType: 'comprehensive'
        })
      });
    },
    onSuccess: (data: any) => {
      setQualityAnalysis(data);
      setComponentAnalyses(data.componentAnalyses || []);
      
      // Trigger unified workflow events for quality analysis completion
      onNotificationCreate?.({
        id: `quality_analysis_${Date.now()}`,
        type: 'quality_analysis_completed',
        title: 'Quality Analysis Completed',
        message: `Overall score: ${data.overallScore}/10 (${data.criticalIssues.length} critical issues)`,
        priority: data.overallScore >= 8 ? 'low' : 'medium',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
      
      onWorklogCreate?.({
        id: `quality_analysis_${Date.now()}`,
        projectId: selectedProject?.id || 'unknown',
        task: 'Quality Analysis',
        description: `Quality analysis completed for CreatorhubVisualEditor. Score: ${data.overallScore}/10`,
        timeSpent: 30,
        date: new Date(),
        status: 'completed',
        tags: ['quality', 'analysis']
      });
    },
    onError: (error) => {
      onNotificationCreate?.({
        id: `quality_analysis_error_${Date.now()}`,
        type: 'error',
        title: 'Quality Analysis Failed',
        message: `Failed to run quality analysis: ${error.message}`,
        priority: 'high',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    }
  });

  // Load saved project when available
  useEffect(() => {
    if (savedProject && !isUndoRedo) {
      setProject(savedProject);
      // Initialize history with saved project
      if (history.length === 0) {
        setHistory([savedProject]);
        setHistoryIndex(0);
      }
    }
  }, [savedProject, isUndoRedo]);

  // Initialize ScrollStories presets
  useEffect(() => {
    initializeAnimationPresets();
    initializeEasingFunctions();
    initializeGoogleServices();
  }, [initializeAnimationPresets, initializeEasingFunctions, initializeGoogleServices]);

  // Keyboard shortcuts
  useEffect(() => {
    const handleKeyDown = (event: KeyboardEvent) => {
      // Ctrl/Cmd + Z for undo
      if ((event.ctrlKey || event.metaKey) && event.key === 'z' && !event.shiftKey) {
        event.preventDefault();
        handleUndo();
      }
      // Ctrl/Cmd + Shift + Z for redo
      else if ((event.ctrlKey || event.metaKey) && event.key === 'z' && event.shiftKey) {
        event.preventDefault();
        handleRedo();
      }
      // Ctrl/Cmd + S for save
      else if ((event.ctrlKey || event.metaKey) && event.key === 's') {
        event.preventDefault();
        handleDesignSave();
      }
      // Delete key for selected element
      else if (event.key === 'Delete' && selectedElement) {
        event.preventDefault();
        showConfirmationModal(
          `Are you sure you want to delete "${selectedElement}"? This action cannot be undone.`,
          () => {
            if (selectedElement) {
              deleteElement(selectedElement);
            }
          }
        );
      }
      // Escape to deselect
      else if (event.key === 'Escape') {
        setSelectedElement(null);
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [selectedElement]);

  // Auto-save functionality
  useEffect(() => {
    if (project && !isUndoRedo) {
      const autoSaveTimeout = setTimeout(() => {
        saveProjectMutation.mutate(project);
      }, 5000); // Auto-save after 5 seconds of inactivity

      return () => clearTimeout(autoSaveTimeout);
    }
  }, [project, isUndoRedo]);

  // ✅ Quality Analysis handlers (from CompleteDeploymentManager)
  const handleRunQualityAnalysis = useCallback(async () => {
    setAnalysisLoading(true);
    try {
      await runQualityAnalysisMutation.mutateAsync(undefined);
    } catch (error) {
      console.error('Quality analysis failed:', error);
    } finally {
      setAnalysisLoading(false);
    }
  }, [runQualityAnalysisMutation]);

  const handleOpenAnalysisDialog = useCallback(() => {
    setShowAnalysisDialog(true);
  }, []);

  const handleCloseAnalysisDialog = useCallback(() => {
    setShowAnalysisDialog(false);
  }, []);

  // Advanced callback functions
  const handleUndo = useCallback(() => {
    if (historyIndex > 0) {
      setIsUndoRedo(true);
      setHistoryIndex(prev => prev - 1);
      setProject(history[historyIndex - 1]);
      setTimeout(() => setIsUndoRedo(false), 100);
      
      onNotificationCreate?.({
        id: `undo_${Date.now()}`,
        type: 'undo',
        title: 'Undo',
        message: 'Action undone',
        priority: 'low',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    }
  }, [history, historyIndex, onNotificationCreate]);

  const handleRedo = useCallback(() => {
    if (historyIndex < history.length - 1) {
      setIsUndoRedo(true);
      setHistoryIndex(prev => prev + 1);
      setProject(history[historyIndex + 1]);
      setTimeout(() => setIsUndoRedo(false), 100);
      
      onNotificationCreate?.({
        id: `redo_${Date.now()}`,
        type: 'redo',
        title: 'Redo',
        message: 'Action redone',
        priority: 'low',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    }
  }, [history, historyIndex, onNotificationCreate]);

  const addToHistory = useCallback((newProject: EditorProject) => {
    if (!isUndoRedo) {
      const newHistory = history.slice(0, historyIndex + 1);
      newHistory.push(newProject);
      setHistory(newHistory);
      setHistoryIndex(newHistory.length - 1);
      
      // Limit history to 50 entries
      if (newHistory.length > 50) {
        setHistory(newHistory.slice(-50));
        setHistoryIndex(49);
      }
    }
  }, [history, historyIndex, isUndoRedo]);

  const handleFileUpload = useCallback((event: React.ChangeEvent<HTMLInputElement>) => {
    const files = event.target.files;
    if (files && files.length > 0) {
      Array.from(files).forEach(file => {
        uploadAssetMutation.mutate(file);
      });
    }
  }, [uploadAssetMutation]);

  // Advanced Visual Editor Functions
  
  // Advanced SEO Functions
  const crawlWebsite = useCallback(async (url: string) => {
    setIsCrawling(true);
    setCrawlProgress(0);
    
    try {
      const auth = await getAuthHeader();
      
      // Start crawl
      const crawlResponse = await apiRequest('/api/seo/crawl/start', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({
          url,
          options: {
            maxPages: 1000,
            followRedirects: true,
            checkBrokenLinks: true,
            analyzeContent: true,
            validateStructuredData: true,
            checkMobileUsability: true,
            analyzePerformance: true
          }
        })
      });

      if (!crawlResponse.ok) {
        throw new window.Error('Failed to start crawl');
      }

      const { crawlId } = await crawlResponse.json();

      // Poll for crawl progress
      const pollCrawlProgress = async (): Promise<SEOCrawlResult> => {
        const progressResponse = await apiRequest(`/api/seo/crawl/progress/${crawlId}`, {
          headers: auth
        });

        if (!progressResponse.ok) {
          throw new window.Error('Failed to get crawl progress');
        }

        const progress = await progressResponse.json();
        setCrawlProgress(progress.percentage);

        if (progress.status === 'completed') {
          return progress.result;
        } else if (progress.status === 'failed') {
          throw new window.Error((progress as any).error?.message || 'Crawl failed');
        } else {
          // Continue polling
          await new Promise(resolve => setTimeout(resolve, 2000));
          return pollCrawlProgress();
        }
      };

      const result = await pollCrawlProgress();
      setSeoCrawlResult(result);
      setSeoIssues(result.issues);
      setShowSeoDashboard(true);

      onNotificationCreate?.({
        id: `seo_crawl_${Date.now()}`,
        type: 'seo_audit',
        title: 'SEO Crawl Completed',
        message: `Crawled ${result.totalPages} pages, found ${result.issues.length} issues`,
        priority: 'medium',
        timestamp: new Date().toISOString(),
        source: 'seo-crawler'
      });

    } catch (error) {
      console.error('SEO crawl failed:', error);
      onNotificationCreate?.({
        id: `seo_crawl_error_${Date.now()}`,
        type: 'error',
        title: 'SEO Crawl Failed',
        message: 'SEO crawl failed',
        priority: 'high',
        timestamp: new Date().toISOString(),
        source: 'seo-crawler'
      });
    } finally {
      setIsCrawling(false);
      setCrawlProgress(0);
    }
  }, [onNotificationCreate]);

  const validateSchemaOrg = useCallback(async (url: string) => {
    try {
      const auth = await getAuthHeader();
      const response = await apiRequest('/api/seo/validate-schema', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({ url })
      });

      if (response.ok) {
        const validation = await response.json();
        
        onNotificationCreate?.({
          id: `schema_validation_${Date.now()}`,
          type: 'seo_audit',
          title: 'Schema.org Validation',
          message: `Found ${validation.valid} valid schemas, ${validation.invalid} invalid`,
          priority: validation.invalid > 0 ? 'medium' : 'low',
          timestamp: new Date().toISOString(),
          source: 'schema-validator'
        });

        return validation;
      }
    } catch (error) {
      console.error('Schema validation failed:', error);
    }
  }, [onNotificationCreate]);

  const generateXMLSitemap = useCallback(async (urls: string[]) => {
    try {
      const auth = await getAuthHeader();
      const response = await apiRequest('/api/seo/generate-sitemap', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({
          urls,
          options: {
            lastModified: new Date().toISOString(),
            changeFrequency: 'weekly',
            priority: 0.8
          }
        })
      });

      if (response.ok) {
        const sitemap = await response.json();
        
        onNotificationCreate?.({
          id: `sitemap_generated_${Date.now()}`,
          type: 'seo_audit',
          title: 'XML Sitemap Generated',
          message: `Generated sitemap with ${urls.length} URLs`,
          priority: 'low',
          timestamp: new Date().toISOString(),
          source: 'sitemap-generator'
        });

        return sitemap;
      }
    } catch (error) {
      console.error('Sitemap generation failed:', error);
    }
  }, [onNotificationCreate]);

  const analyzeContentQuality = useCallback(async (content: string) => {
    try {
      const auth = await getAuthHeader();
      const response = await apiRequest('/api/seo/analyze-content', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({
          content,
          options: {
            checkReadability: true,
            analyzeKeywords: true,
            checkGrammar: true,
            checkSpelling: true
          }
        })
      });

      if (response.ok) {
        return await response.json();
      }
    } catch (error) {
      console.error('Content analysis failed:', error);
    }
  }, []);

  const checkBrokenLinks = useCallback(async (urls: string[]) => {
    try {
      const auth = await getAuthHeader();
      const response = await apiRequest('/api/seo/check-broken-links', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({ urls })
      });

      if (response.ok) {
        const results = await response.json();
        
        const brokenLinks = results.filter((link: any) => link.statusCode >= 400);
        if (brokenLinks.length > 0) {
          onNotificationCreate?.({
            id: `broken_links_${Date.now()}`,
            type: 'error',
            title: 'Broken Links Found',
            message: `Found ${brokenLinks.length} broken links`,
            priority: 'high',
            timestamp: new Date().toISOString(),
            source: 'link-checker'
          });
        }

        return results;
      }
    } catch (error) {
      console.error('Broken link check failed:', error);
    }
  }, [onNotificationCreate]);

  const runAdvancedSEOAudit = useCallback(async () => {
    if (!crawlUrl) return;
    
    try {
      setIsCrawling(true);
      
      // Run comprehensive SEO audit
      const audit = await crawlWebsite(crawlUrl);
      
      // Additional checks
      await validateSchemaOrg(crawlUrl);
      
      onNotificationCreate?.({
        id: `advanced_seo_audit_${Date.now()}`,
        type: 'seo_audit',
        title: 'Advanced SEO Audit Completed',
        message: 'Comprehensive SEO analysis finished',
        priority: 'medium',
        timestamp: new Date().toISOString(),
        source: 'seo-audit'
      });
      
    } catch (error) {
      console.error('Advanced SEO audit failed:', error);
    }
  }, [crawlUrl, crawlWebsite, validateSchemaOrg, onNotificationCreate]);

  // Competitor Analysis Functions
  const analyzeCompetitor = useCallback(async (analysisType: 'keywords' | 'backlinks' | 'content') => {
    if (!competitorUrl) return;
    
    setIsAnalyzingCompetitor(true);
    
    try {
      const auth = await getAuthHeader();
      
      // Simulate competitor analysis API call
      const response = await apiRequest('/api/seo/competitor/analyze', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({
          url: competitorUrl,
          analysisType,
          options: {
            depth: 'comprehensive',
            includeSubdomains: true
          }
        })
      });

      const analysisResult = await response.json();
      
      setCompetitorAnalysis({
        type: analysisType,
        url: competitorUrl,
        summary: analysisResult.summary,
        keywords: analysisResult.keywords,
        backlinks: analysisResult.backlinks,
        content: analysisResult.content,
        timestamp: new Date().toISOString()
      });

      // Trigger project update
      onProjectUpdate?.({
        ...selectedProject,
        id: selectedProject?.id || 'unknown',
        name: selectedProject?.name || 'Unknown Project',
        description: selectedProject?.description || 'No description available',
        status: selectedProject?.status || 'in-progress',
        clientId: selectedProject?.clientId || 'default',
        dueDate: selectedProject?.dueDate || new Date(),
        priority: selectedProject?.priority || 'medium',
        tags: selectedProject?.tags || [],
        competitorAnalysis: {
          url: competitorUrl,
          type: analysisType,
          timestamp: new Date().toISOString()
        }
      });

      onNotificationCreate?.({
        id: `competitor_analysis_${Date.now()}`,
        type: 'seo_audit',
        title: 'Competitor Analysis Completed',
        message: `${analysisType} analysis for ${competitorUrl} finished`,
        priority: 'medium',
        timestamp: new Date().toISOString(),
        source: 'competitor-analysis'
      });

    } catch (error) {
      console.error('Competitor analysis failed:', error);
      onNotificationCreate?.({
        id: `competitor_analysis_error_${Date.now()}`,
        type: 'error',
        title: 'Competitor Analysis Failed',
        message: 'Failed to analyze competitor. Please try again.',
        priority: 'high',
        timestamp: new Date().toISOString(),
        source: 'competitor-analysis'
      });
    } finally {
      setIsAnalyzingCompetitor(false);
    }
  }, [competitorUrl, onProjectUpdate, selectedProject, onNotificationCreate]);

  // Keyword Research Functions
  const researchKeywords = useCallback(async (researchType: 'related' | 'longtail' | 'suggestions') => {
    if (!seedKeyword) return;
    
    setIsResearchingKeywords(true);
    
    try {
      const auth = await getAuthHeader();
      
      // Simulate keyword research API call
      const response = await apiRequest('/api/seo/keywords/research', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({
          seedKeyword,
          researchType,
          options: {
            language: 'no', // Norwegian
            country: 'NO',
            maxResults: 100
          }
        })
      });

      const researchResult = await response.json();
      
      setKeywordResearch({
        type: researchType,
        seedKeyword,
        keywords: researchResult.keywords,
        suggestions: researchResult.suggestions,
        timestamp: new Date().toISOString()
      });

      // Trigger project update
      onProjectUpdate?.({
        ...selectedProject,
        id: selectedProject?.id || 'unknown',
        name: selectedProject?.name || 'Unknown Project',
        description: selectedProject?.description || 'No description available',
        status: selectedProject?.status || 'in-progress',
        clientId: selectedProject?.clientId || 'default',
        dueDate: selectedProject?.dueDate || new Date(),
        priority: selectedProject?.priority || 'medium',
        tags: selectedProject?.tags || [],
        keywordResearch: {
          seedKeyword,
          type: researchType,
          keywordsCount: researchResult.keywords?.length || 0,
          timestamp: new Date().toISOString()
        }
      });

      onNotificationCreate?.({
        id: `keyword_research_${Date.now()}`,
        type: 'seo_audit',
        title: 'Keyword Research Completed',
        message: `Found ${researchResult.keywords?.length || 0} keywords for "${seedKeyword}"`,
        priority: 'medium',
        timestamp: new Date().toISOString(),
        source: 'keyword-research'
      });

    } catch (error) {
      console.error('Keyword research failed:', error);
      onNotificationCreate?.({
        id: `keyword_research_error_${Date.now()}`,
        type: 'error',
        title: 'Keyword Research Failed',
        message: 'Failed to research keywords. Please try again.',
        priority: 'high',
        timestamp: new Date().toISOString(),
        source: 'keyword-research'
      });
    } finally {
      setIsResearchingKeywords(false);
    }
  }, [seedKeyword, onProjectUpdate, selectedProject, onNotificationCreate]);

  // JSON-LD Structured Data Functions
  const generateJSONLD = useCallback(async (type: 'organization' | 'website' | 'breadcrumb') => {
    setIsGeneratingJSONLD(true);
    
    try {
      const auth = await getAuthHeader();
      
      // Generate JSON-LD based on type
      const jsonLD = {
        '@context': 'https://schema.org',
        '@type': type === 'organization' ? 'Organization' : 
                 type === 'website' ? 'WebSite' : 'BreadcrumbList',
        ...(type === 'organization' && {
          name: selectedProject?.name || 'CreatorHub Norge',
          url: 'https://creatorhub.no',
          logo: 'https://creatorhub.no/logo.png',
          description: 'Professional creative tools for Norwegian artists and creators',
          address: {
            '@type': 'PostalAddress',
            addressCountry: 'NO',
            addressLocality: 'Oslo',
            addressRegion: 'Oslo'
          },
          contactPoint: {
            '@type': 'ContactPoint',
            telephone: '+47-xxx-xxxx',
            contactType: 'customer service'
          }
        }),
        ...(type === 'website' && {
          name: selectedProject?.name || 'CreatorHub Norge',
          url: 'https://creatorhub.no',
          description: 'Professional creative tools for Norwegian artists and creators',
          publisher: {
            '@type': 'Organization',
            name: 'CreatorHub Norge'
          },
          potentialAction: {
            '@type': 'SearchAction',
            target: 'https://creatorhub.no/search?q={search_term_string}',
            'query-input': 'required name=search_term_string'
          }
        }),
        ...(type === 'breadcrumb' && {
          itemListElement: [
            {
              '@type': 'ListItem',
              position: 1,
              name: 'Home',
              item: 'https://creatorhub.no'
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: selectedProject?.name || 'Project',
              item: `https://creatorhub.no/projects/${selectedProject?.id || 'unknown'}`
            }
          ]
        })
      };
      
      setJsonLDData(jsonLD);

      // Trigger project update
      onProjectUpdate?.({
        ...selectedProject,
        id: selectedProject?.id || 'unknown',
        name: selectedProject?.name || 'Unknown Project',
        description: selectedProject?.description || 'No description available',
        status: selectedProject?.status || 'in-progress',
        clientId: selectedProject?.clientId || 'default',
        dueDate: selectedProject?.dueDate || new Date(),
        priority: selectedProject?.priority || 'medium',
        tags: selectedProject?.tags || [],
        jsonLDGenerated: {
          type,
          timestamp: new Date().toISOString()
        }
      });

      onNotificationCreate?.({
        id: `jsonld_generated_${Date.now()}`,
        type: 'seo_audit',
        title: 'JSON-LD Generated',
        message: `${type} structured data generated successfully`,
        priority: 'medium',
        timestamp: new Date().toISOString(),
        source: 'jsonld-generator'
      });

    } catch (error) {
      console.error('JSON-LD generation failed:', error);
      onNotificationCreate?.({
        id: `jsonld_generation_error_${Date.now()}`,
        type: 'error',
        title: 'JSON-LD Generation Failed',
        message: 'Failed to generate JSON-LD structured data',
        priority: 'high',
        timestamp: new Date().toISOString(),
        source: 'jsonld-generator'
      });
    } finally {
      setIsGeneratingJSONLD(false);
    }
  }, [onProjectUpdate, selectedProject, onNotificationCreate]);

  const validateJSONLD = useCallback(async () => {
    if (!jsonLDData) return;
    
    try {
      const auth = await getAuthHeader();
      
      // Validate JSON-LD using Schema.org validator
      const response = await apiRequest('/api/seo/jsonld/validate', {
        headers: auth,
        method: 'POST',
        body: JSON.stringify({
          jsonLD: jsonLDData,
          validateWith: 'schema.org'
        })
      });

      const validationResult = await response.json();
      
      setJsonLDValidation({
        valid: validationResult.valid,
        errors: validationResult.errors || [],
        warnings: validationResult.warnings || [],
        timestamp: new Date().toISOString()
      });

      onNotificationCreate?.({
        id: `jsonld_validated_${Date.now()}`,
        type: validationResult.valid ? 'seo_audit' : 'error',
        title: validationResult.valid ? 'JSON-LD Valid' : 'JSON-LD Invalid',
        message: validationResult.valid ? 
          'JSON-LD structured data is valid' : 
          `Found ${validationResult.errors?.length || 0} validation errors`,
        priority: validationResult.valid ? 'medium' : 'high',
        timestamp: new Date().toISOString(),
        source: 'jsonld-validator'
      });

    } catch (error) {
      console.error('JSON-LD validation failed:', error);
      onNotificationCreate?.({
        id: `jsonld_validation_error_${Date.now()}`,
        type: 'error',
        title: 'JSON-LD Validation Failed',
        message: 'Failed to validate JSON-LD structured data',
        priority: 'high',
        timestamp: new Date().toISOString(),
        source: 'jsonld-validator'
      });
    }
  }, [jsonLDData, onNotificationCreate]);

