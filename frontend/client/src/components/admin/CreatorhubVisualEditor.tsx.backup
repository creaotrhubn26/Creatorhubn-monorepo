  // Google Photos Integration
  const checkGooglePhotosAccess = async () => {
    const auth = await getAuthHeader();
    const response = await apiRequest('/api/google-photos/test-connection', {
      headers: auth
    });
    return response.ok;
  };

  const loadGooglePhotos = useCallback(async () => {
    try {
      const auth = await getAuthHeader();
    const response = await apiRequest('/api/google-photos/albums', {
      headers: auth
    });
      const albums = await response.json();
      
      // Extract photos from albums
      const allPhotos = [];
      for (const album of albums) {
        try {
          const auth = await getAuthHeader();
          const photosResponse = await apiRequest(`/api/google-photos/albums/${album.id}/photos`, {
            headers: auth
          });
          const photos = await photosResponse.json();
          allPhotos.push(...photos.map((photo: any) => ({
            ...photo,
            albumId: album.id,
            albumTitle: album.title
          })));
        } catch (error) {
          console.error(`Failed to load photos from album ${album.id}:`, error);
        }
      }
      
      setGooglePhotos(allPhotos);
      
      // Trigger unified workflow events
      onProjectUpdate?.({
        ...selectedProject,
        id: selectedProject?.id || 'unknown',
        name: selectedProject?.name || 'Unknown Project',
        description: selectedProject?.description || 'No description available',
        status: selectedProject?.status || 'in-progress',
        clientId: selectedProject?.clientId || 'default',
        dueDate: selectedProject?.dueDate || new Date(),
        priority: selectedProject?.priority || 'medium',
        tags: selectedProject?.tags || [],
        lastGooglePhotosSync: new Date().toISOString(),
        googlePhotosCount: allPhotos.length
      });
      
      onWorklogCreate?.({
        id: `google_photos_sync_${Date.now()}`,
        projectId: selectedProject?.id || 'unknown',
        task: 'Google Photos Sync',
        description: `Synced ${allPhotos.length} photos from Google Photos`,
        timeSpent: 20,
        date: new Date(),
        status: 'completed',
        tags: ['sync', 'google-photos']
      });
      
      onNotificationCreate?.({
        id: `google_photos_loaded_${Date.now()}`,
        type: 'google_photos_loaded',
        title: 'Google Photos Loaded',
        message: `Successfully loaded ${allPhotos.length} photos from Google Photos`,
        priority: 'medium',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
      
    } catch (error) {
      console.error('Failed to load Google Photos:', error);
      onNotificationCreate?.({
        id: `google_photos_error_${Date.now()}`,
        type: 'error',
        title: 'Google Photos Error',
        message: 'Failed to load Google Photos. Please check your connection.',
        priority: 'high',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    }
  }, [selectedProject, onProjectUpdate, onWorklogCreate, onNotificationCreate, user?.email]);

