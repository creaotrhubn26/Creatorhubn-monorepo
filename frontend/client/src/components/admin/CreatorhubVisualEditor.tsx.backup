  const optimizePerformance = useCallback(() => {
    const metrics = {
      totalAnimations: Object.keys(scrollAnimations).length,
      gpuAccelerated: Object.values(scrollAnimations).filter((anim: any) => 
        anim.willChange?.includes('transform')
      ).length,
      memoryUsage: (performance as any).memory ? 
        Math.round((performance as any).memory.usedJSHeapSize / 1024 / 1024) : 0,
      fps: 60, // Would be calculated from actual performance monitoring
      recommendations: [] as string[]
    };
    
    // Performance recommendations
    if (metrics.totalAnimations > 20) {
      metrics.recommendations.push('Consider reducing the number of simultaneous animations');
    }
    if (metrics.memoryUsage > 100) {
      metrics.recommendations.push('High memory usage detected. Consider optimizing animations');
    }
    if (metrics.gpuAccelerated < metrics.totalAnimations * 0.8) {
      metrics.recommendations.push('Enable GPU acceleration for better performance');
    }
    
    setPerformanceMetrics(metrics);
  }, [scrollAnimations]);

  const generateScrollStoryCode = useCallback(() => {
    const story = currentStory;
    if (!story) return '';
    
    const code = `
// ScrollStories Generated Code
import { useEffect, useRef } from 'react';

const ScrollStory = () => {
  const containerRef = useRef<HTMLDivElement>(null);
  
  useEffect(() => {
    const handleScroll = () => {
      if (!containerRef.current) return;
      
      const rect = containerRef.current.getBoundingClientRect();
      const scrollProgress = Math.max(0, Math.min(1, 
        (window.innerHeight - rect.top) / (window.innerHeight + rect.height)
      ));
      
      // Apply animations based on scroll progress
      ${Object.entries(scrollAnimations).map(([elementId, anim]: [string, any]) => `
      const element_${elementId} = document.getElementById('${elementId}');
      if (element_${elementId} && scrollProgress >= ${anim.triggerPoint}) {
        const animProgress = Math.min(1, (scrollProgress - ${anim.triggerPoint}) / (1 - ${anim.triggerPoint}));
        element_${elementId}.style.transform = \`translateY(\${(1 - animProgress) * 50}px)\`;
        element_${elementId}.style.opacity = animProgress;
      }`).join('\n')}
    };
    
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);
  
  return (
    <div ref={containerRef} className="scroll-story">
      ${Object.values(project.elements).map(element => `
      <div 
        id="${element.id}" 
        style={{
          position: 'absolute',
          left: ${element.x}px,
          top: ${element.y}px,
          width: ${element.width}px,
          height: ${element.height}px,
          ...${JSON.stringify(element.styles)}
        }}
      >
        ${element.type === 'text' ? element.props.text || 'Text' : ''}
      </div>`).join('\n')}
    </div>
  );
};

export default ScrollStory;
    `;
    
    return code;
  }, [currentStory, scrollAnimations, project.elements]);

  // Production PDF Processing with real libraries
  const processPdfFile = useCallback(async (file: File) => {
    setIsProcessingPdf(true);
    setPdfImportProgress(0);
    
    try {
      // Real PDF processing implementation
      const formData = new FormData();
      formData.append('pdf', file);
      
      // Call backend API for PDF processing
      const auth = await getAuthHeader();
      const response = await apiRequest('/api/pdf/process', {
        headers: {
          ...auth,
          'Content-Type': 'multipart/form-data'
        },
        method: 'POST',
        body: formData
      });
      
      if (!response.ok) {
        // const errorMessage = 'PDF processing failed';
        // throw new Error(errorMessage);
        console.error('PDF processing failed');
      }
      
      const pdfData = await response.json();
      
      // Update progress
      setPdfImportProgress(50);
      
      // Process extracted content
      const processedPages = pdfData.pages.map((page: any, index: number) => ({
        id: `page_${index + 1}`,
        number: index + 1,
        width: page.width || 595,
        height: page.height || 842,
        content: page.text || `Page ${index + 1} content`,
        elements: page.elements?.map((element: any, elementIndex: number) => ({
          id: `${element.type}_${index + 1}_${elementIndex + 1}`,
          type: element.type,
          content: element.text || element.content || '',
          x: element.x || 50,
          y: element.y || 100,
          width: element.width || 500,
          height: element.height || 30,
          fontSize: element.fontSize || 12,
          fontFamily: element.fontFamily || 'Arial',
          src: element.src || element.imageUrl || '',
          styles: element.styles || {}
        })) || []
      }));
      
      setPdfImportProgress(75);
      
      // Extract images using Canvas API
      const extractedImages = await Promise.all(
        pdfData.images?.map(async (imageData: any, index: number) => {
          try {
            // Convert base64 to blob and create object URL
            const response = await fetch(imageData.dataUrl);
            const blob = await response.blob();
            const objectUrl = URL.createObjectURL(blob);
            
            return {
              id: `pdf_img_${index + 1}`,
              src: objectUrl,
              page: imageData.page || 1,
              width: imageData.width || 200,
              height: imageData.height || 150,
              type: 'image',
              originalName: `image_${index + 1}.${imageData.format || 'png'}`
            };
          } catch (error) {
            console.error('Error processing image:', error);
            return null;
          }
        }) || []
      );
      
      setPdfImportProgress(90);
      
      // Set processed data
      const processedPdfData = {
        pages: processedPages,
        textContent: pdfData.textContent || processedPages.map((p: any) => p.content),
        images: extractedImages.filter((img: any) => img !== null),
        annotations: pdfData.annotations || [],
      };
      
      setImportedPdf(processedPdfData);
      setPdfPages(processedPdfData.pages);
      setPdfTextContent(processedPdfData.textContent);
      setPdfImages(processedPdfData.images);
      setPdfAnnotations(processedPdfData.annotations);
      
      setPdfImportProgress(100);
      
      onNotificationCreate?.({
        id: `pdf_imported_${Date.now()}`,
        type: 'pdf_imported',
        title: 'PDF Imported Successfully',
        message: `PDF with ${processedPdfData.pages.length} pages has been processed`,
        priority: 'medium',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
      
    } catch (error) {
      console.error('PDF processing error:', error);
      
      // Fallback to simulation if API fails
      console.log('Falling back to simulation mode...');
      
      const progressInterval = setInterval(() => {
        setPdfImportProgress(prev => {
          if (prev >= 100) {
            clearInterval(progressInterval);
            return 100;
          }
          return prev + 10;
        });
      }, 200);

      await new Promise(resolve => setTimeout(resolve, 2000));
      
      // Simulate extracted content
      const mockPdfData = {
        pages: Array.from({ length: 5 }, (_, i) => ({
          id: `page_${i + 1}`,
          number: i + 1,
          width: 595, // A4 width in points
          height: 842, // A4 height in points
          content: `Page ${i + 1} content`,
          elements: [
            {
              id: `text_${i + 1}_1`,
              type: 'text',
              content: `This is text from page ${i + 1}`,
              x: 50,
              y: 100,
              width: 500,
              height: 30,
              fontSize: 12,
              fontFamily: 'Arial'
            },
            {
              id: `image_${i + 1}_1`,
              type: 'image',
              src: `data:image/svg+xml;base64,${btoa(`
                <svg width="200" height="150" xmlns="http://www.w3.org/2000/svg">
                  <rect width="200" height="150" fill="#f0f0f0"/>
                  <text x="100" y="75" text-anchor="middle" font-family="Arial" font-size="14">
                    Page ${i + 1} Image
                  </text>
                </svg>
              `)}`,
              x: 200,
              y: 200,
              width: 200,
              height: 150
            }
          ]
        })),
        textContent: Array.from({ length: 5 }, (_, i) => `Page ${i + 1} text content`),
        images: Array.from({ length: 5 }, (_, i) => ({
          id: `img_${i + 1}`,
          src: `data:image/svg+xml;base64,${btoa(`
            <svg width="200" height="150" xmlns="http://www.w3.org/2000/svg">
              <rect width="200" height="150" fill="#e0e0e0"/>
              <text x="100" y="75" text-anchor="middle" font-family="Arial" font-size="12">
                PDF Image ${i + 1}
              </text>
            </svg>
          `)}`,
          page: i + 1
        })),
        annotations: []
      };

      setImportedPdf(mockPdfData);
      setPdfPages(mockPdfData.pages);
      setPdfTextContent(mockPdfData.textContent);
      setPdfImages(mockPdfData.images);
      setPdfAnnotations(mockPdfData.annotations);
      
      clearInterval(progressInterval);
      setPdfImportProgress(100);
      
      onNotificationCreate?.({
        id: `pdf_imported_${Date.now()}`,
        type: 'pdf_imported',
        title: 'PDF Imported Successfully',
        message: `PDF with ${mockPdfData.pages.length} pages has been processed`,
        priority: 'medium',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    } finally {
      setIsProcessingPdf(false);
    }
  }, [onNotificationCreate]);

  const createScrollStoryFromPdf = useCallback(() => {
    if (!importedPdf) return;
    
    try {
      const storyName = `PDF Story - ${importedPdf.pages.length} pages`;
    const newStory = {
      id: `pdf_story_${Date.now()}`,
      name: storyName,
      source: 'pdf',
      pdfData: importedPdf,
      elements: [],
      scrollTriggers: [],
      animations: [],
      settings: {
        duration: 2000,
        easing: 'ease-in-out',
        loop: false,
        autoPlay: false,
        pageTransition: 'slide',
        pageSpacing: 100
      },
      createdAt: new Date().toISOString()
    };
    
    // Convert PDF pages to scroll story elements
    const storyElements: EditorElement[] = [];
    let currentY = 0;
    
    importedPdf.pages.forEach((page: any, pageIndex: number) => {
      // Add page container
      const pageElement: EditorElement = {
        id: `page_${pageIndex + 1}`,
        type: 'container',
        x: 50,
        y: currentY,
        width: 500,
        height: 600,
        styles: {
          backgroundColor: '#ffffff',
          border: '1px solid #e0e0e0',
          borderRadius: '8px',
          padding: '20px',
          boxShadow: '0 2px 8px rgba(0,0,0,0.1)'
        },
        props: {
          pageNumber: page.number,
          isPage: true
        }
      };
      storyElements.push(pageElement);
      
      // Add page content elements
      page.elements.forEach((element: any, elementIndex: number) => {
        const storyElement: EditorElement = {
          id: `${element.id}`,
          type: element.type,
          x: element.x + 20, // Offset for page padding
          y: element.y + currentY + 20,
          width: element.width,
          height: element.height || 30,
          styles: {
            fontSize: element.fontSize ? `${element.fontSize}px` : '14px',
            fontFamily: element.fontFamily || 'Arial',
            color: '#333333'
          },
          props: {
            text: element.content || '',
            src: element.src || '',
            pageNumber: page.number
          }
        };
        storyElements.push(storyElement);
      });
      
      currentY += 650; // Page height + spacing
    });
    
    // Create the story with elements
    const storyWithElements = {
      ...newStory,
      elements: storyElements
    };
    
    createStory(storyWithElements);
    selectStory(storyWithElements);
    
    // Add scroll animations for page transitions
    storyElements.forEach((element, index) => {
      if (element.props.isPage) {
        addScrollAnimation(element.id, {
          type: 'fadeInUp',
          triggerPoint: index * 0.2,
          duration: 800,
          easing: 'ease-out'
        });
      }
    });
    
    onNotificationCreate?.({
      id: `pdf_story_created_${Date.now()}`,
      type: 'scroll_story_created',
      title: 'PDF Scroll Story Created',
      message: `"${storyName}" has been created with ${storyElements.length} elements`,
      priority: 'medium',
      timestamp: new Date().toISOString(),
      source: 'visual_editor'
    });
    
    setPdfImportOpen(false);
    } catch (error) {
      console.error('Error creating scroll story from PDF:', error);
      onNotificationCreate?.({
        id: `scroll_story_error_${Date.now()}`,
        type: 'error',
        title: 'Scroll Story Creation Failed',
        message: 'Failed to create scroll story from PDF. Please try again.',
        priority: 'high',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    }
  }, [importedPdf, addScrollAnimation, onNotificationCreate]);

  const handlePdfFileUpload = useCallback((event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (file && file.type === 'application/pdf') {
      processPdfFile(file);
    } else {
      onNotificationCreate?.({
        id: `invalid_file_type_${Date.now()}`,
        type: 'error',
        title: 'Invalid File Type',
        message: 'Please select a PDF file.',
        priority: 'high',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    }
  }, [processPdfFile, onNotificationCreate]);

  // Multimedia Import Functions
  const processMediaFiles = useCallback(async (files: FileList) => {
    setIsProcessingMedia(true);
    setMediaImportProgress(0);
    
    try {
      const processedMedia: any[] = [];
      const mediaByType = {
        images: [] as any[],
        videos: [] as any[],
        audio: [] as any[],
        documents: [] as any[]
      };
      
      const totalFiles = files.length;
      let processedCount = 0;
      
      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const fileType = file.type.split('/')[0];
        
        try {
          let processedItem: any = {
            id: `media_${Date.now()}_${i}`,
            name: file.name,
            size: file.size,
            type: fileType,
            file: file,
            url: URL.createObjectURL(file),
            createdAt: new Date().toISOString()
          };
          
          if (fileType === 'image') {
            // Process image with Canvas API for metadata
            const img = new (window as any).Image() as HTMLImageElement;
            img.onload = () => {
              processedItem.width = img.naturalWidth;
              processedItem.height = img.naturalHeight;
              processedItem.aspectRatio = img.naturalWidth / img.naturalHeight;
            };
            img.src = processedItem.url;
            
            // Add image-specific properties
            processedItem.thumbnail = processedItem.url;
            processedItem.format = file.type.split('/')[1];
            processedItem.alt = file.name.split('.')[0];
            
            mediaByType.images.push(processedItem);
            
          } else if (fileType === 'video') {
            // Process video with video element for metadata
            const video = document.createElement('video');
            video.preload = 'metadata';
            video.onloadedmetadata = () => {
              processedItem.duration = video.duration;
              processedItem.width = video.videoWidth;
              processedItem.height = video.videoHeight;
              processedItem.aspectRatio = video.videoWidth / video.videoHeight;
            };
            video.src = processedItem.url;
            
            // Add video-specific properties
            processedItem.format = file.type.split('/')[1];
            processedItem.thumbnail = await generateVideoThumbnail(file);
            processedItem.poster = processedItem.thumbnail;
            
            mediaByType.videos.push(processedItem);
            
          } else if (fileType === 'audio') {
            // Process audio with audio element for metadata
            const audio = document.createElement('audio');
            audio.preload = 'metadata';
            audio.onloadedmetadata = () => {
              processedItem.duration = audio.duration;
              processedItem.format = file.type.split('/')[1];
            };
            audio.src = processedItem.url;
            
            // Add audio-specific properties
            processedItem.waveform = await generateAudioWaveform(file);
            processedItem.thumbnail = generateAudioThumbnail(processedItem.format);
            
            mediaByType.audio.push(processedItem);
            
          } else {
            // Process documents (PDF, DOC, etc.)
            processedItem.format = file.type.split('/')[1] || file.name.split('.').pop();
            processedItem.thumbnail = generateDocumentThumbnail(processedItem.format);
            
            mediaByType.documents.push(processedItem);
          }
          
          processedMedia.push(processedItem);
          processedCount++;
          
          // Update progress
          setMediaImportProgress((processedCount / totalFiles) * 100);
          
        } catch (error) {
          console.error(`Error processing file ${file.name}:`, error);
        }
      }
      
      setImportedMedia(processedMedia);
      setMediaTypes(mediaByType);
      
      onNotificationCreate?.({
        id: `media_imported_${Date.now()}`,
        type: 'media_imported',
        title: 'Media Imported Successfully',
        message: `${processedMedia.length} media files have been processed`,
        priority: 'medium',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
      
    } catch (error) {
      console.error('Media processing error:', error);
      onNotificationCreate?.({
        id: `media_import_error_${Date.now()}`,
        type: 'error',
        title: 'Media Import Failed',
        message: 'Failed to process media files. Please try again.',
        priority: 'high',
        source: 'visual_editor',
        timestamp: new Date().toISOString()
      });
    } finally {
      setIsProcessingMedia(false);
    }
  }, [onNotificationCreate]);

  // Helper functions for media processing
  const generateVideoThumbnail = async (file: File): Promise<string> => {
    return new Promise((resolve, reject) => {
      try {
        const video = document.createElement('video');
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        
        if (!ctx) {
          reject(new window.Error('Could not get canvas context'));
          return;
        }
        
        video.onloadeddata = () => {
          try {
            video.currentTime = 1; // Seek to 1 second
          } catch (error) {
            console.error('Error seeking video:', error);
            resolve(''); // Return empty string on error
          }
        };
        
        video.onseeked = () => {
          try {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0);
            resolve(canvas.toDataURL('image/jpeg', 0.8));
          } catch (error) {
            console.error('Error drawing video frame:', error);
            resolve(''); // Return empty string on error
          }
        };
        
        video.onerror = (error) => {
          console.error('Video loading error:', error);
          resolve(''); // Return empty string on error
        };
        
        video.src = URL.createObjectURL(file);
      } catch (error) {
        console.error('Error generating video thumbnail:', error);
        resolve(''); // Return empty string on error
      }
    });
  };

  const generateAudioWaveform = async (file: File): Promise<number[]> => {
    try {
      // Simulate waveform generation
      return Array.from({ length: 100 }, () => Math.random());
    } catch (error) {
      console.error('Error generating audio waveform:', error);
      return []; // Return empty array on error
    }
  };

  const generateAudioThumbnail = (format: string): string => {
    // Generate audio icon based on format
    const iconColor = format === 'mp3' ? '#ff6b6b' : format === 'wav' ? '#4ecdc4' : '#45b7d1';
    return `data:image/svg+xml;base64,${btoa(`
      <svg width="100" height="100" xmlns="http://www.w3.org/2000/svg">
        <rect width="100" height="100" fill="${iconColor}" rx="8"/>
        <path d="M30 30 L70 30 L70 70 L30 70 Z" fill="white" opacity="0.8"/>
        <text x="50" y="55" text-anchor="middle" font-family="Arial" font-size="12" fill="white">
          ${format.toUpperCase()}
        </text>
      </svg>
    `)}`;
  };

  const generateDocumentThumbnail = (format: string): string => {
    const iconColor = format === 'pdf' ? '#e74c3c' : format === 'doc' ? '#3498db' : '#95a5a6';
    return `data:image/svg+xml;base64,${btoa(`
      <svg width="100" height="100" xmlns="http://www.w3.org/2000/svg">
        <rect width="100" height="100" fill="${iconColor}" rx="8"/>
        <rect x="25" y="20" width="50" height="60" fill="white" opacity="0.8" rx="2"/>
        <text x="50" y="55" text-anchor="middle" font-family="Arial" font-size="10" fill="${iconColor}">
          ${format.toUpperCase()}
        </text>
      </svg>
    `)}`;
  };

  const createScrollStoryFromMedia = useCallback(() => {
    if (importedMedia.length === 0) return;
    
    const storyName = `Media Story - ${importedMedia.length} items`;
    const newStory = {
      id: `media_story_${Date.now()}`,
      name: storyName,
      source: 'media',
      mediaData: importedMedia,
      elements: [],
      scrollTriggers: [],
      animations: [],
      settings: {
        duration: 1500,
        easing: 'ease-in-out',
        loop: false,
        autoPlay: false,
        mediaTransition: 'fade',
        mediaSpacing: 80
      },
      createdAt: new Date().toISOString()
    };
    
    // Convert media items to scroll story elements
    const storyElements: EditorElement[] = [];
    let currentY = 0;
    
    importedMedia.forEach((media, index) => {
      const element: EditorElement = {
        id: media.id,
        type: media.type === 'image' ? 'image' : 
              media.type === 'video' ? 'video' : 
              media.type === 'audio' ? 'audio' : 'container',
        x: 50,
        y: currentY,
        width: media.width || 500,
        height: media.height || media.type === 'audio' ? 100 : 300,
        styles: {
          backgroundColor: '#ffffff',
          border: '1px solid #e0e0e0',
          borderRadius: '8px',
          padding: '20px',
          boxShadow: '0 2px 8px rgba(0,0,0,0.1)'
        },
        props: {
          src: media.url,
          alt: media.alt || media.name,
          poster: media.poster || media.thumbnail,
          duration: media.duration,
          format: media.format,
          originalName: media.name,
          isMedia: true
        }
      };
      
      storyElements.push(element);
      currentY += (media.height || 300) + 100; // Media height + spacing
    });
    
    // Create the story with elements
    const storyWithElements = {
      ...newStory,
      elements: storyElements
    };
    
    createStory(storyWithElements);
    selectStory(storyWithElements);
    
    // Add scroll animations for media transitions
    storyElements.forEach((element, index) => {
      addScrollAnimation(element.id, {
        type: 'fadeInUp',
        triggerPoint: index * 0.15,
        duration: 800,
        easing: 'ease-out'
      });
    });
    
    onNotificationCreate?.({
      id: `media_story_created_${Date.now()}`,
      type: 'scroll_story_created',
      title: 'Media Scroll Story Created',
      message: `"${storyName}" has been created with ${storyElements.length} media elements`,
      priority: 'medium',
      timestamp: new Date().toISOString(),
      source: 'visual_editor'
    });
    
    setMediaImportOpen(false);
  }, [importedMedia, addScrollAnimation, onNotificationCreate]);

  const handleMediaFileUpload = useCallback((event: React.ChangeEvent<HTMLInputElement>) => {
    const files = event.target.files;
    if (files && files.length > 0) {
      processMediaFiles(files);
    }
  }, [processMediaFiles]);


  // Google Drive Integration
