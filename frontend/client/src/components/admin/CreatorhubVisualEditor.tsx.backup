      <Dialog 
        open={assetLibraryOpen} 
        onClose={() => setAssetLibraryOpen(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>Advanced Asset Library</DialogTitle>
        <DialogContent>
          <Box sx={{ mt: 2 }}>
            {/* Search and Filter */}
            <Box sx={{ mb: 3 }}>
              <TextField
                fullWidth
                placeholder="Search assets..."
