  const exportScrollStory = useCallback(() => {
    const storyData = {
      ...currentStory,
      scrollTriggers: Object.values(scrollTriggers),
      scrollAnimations: Object.values(scrollAnimations),
      scrollTimeline: scrollTimeline
    };
    
    const blob = new Blob([JSON.stringify(storyData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${currentStory?.name || 'scroll-story'}.json`;
    a.click();
    URL.revokeObjectURL(url);
    
    onNotificationCreate?.({
      id: `scroll_story_exported_${Date.now()}`,
