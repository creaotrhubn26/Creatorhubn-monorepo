interface ComponentSchema {
  id: string;
  name: string;
  type: string;
  props: Record<string, any>;
  children?: ComponentSchema[];
}

interface GeneratedCode {
  react: string;
  typescript: string;
  css: string;
  html: string;
  api?: string;
  database?: string;
}

interface DatabaseAnalysis {
  tables: Array<{
    name: string;
    columns: Array<{ name: string; type: string; nullable: boolean }>;
    relations: string[];
  }>;
  patterns: string[];
  suggestions: string[];
}

interface ImprovementTask {
  id: string;
  title: string;
  description: string;
  priority: 'low' | 'medium' | 'high' | 'critical';
  category: 'bug_fix' | 'feature_request' | 'performance' | 'ui_improvement';
  sourceType: 'user_feedback' | 'system_analysis' | 'admin_note';
  sourceId: string;
  status: 'pending' | 'analyzing' | 'fixing' | 'completed' | 'failed';
  estimatedComplexity: 'simple' | 'moderate' | 'complex';
  autoFixable: boolean;
  createdAt: string;
  updatedAt: string;
}

interface CodebaseAnalysis {
  components: string[];
  patterns: string[];
  apiEndpoints: string[];
  commonStructures: string[];
}

interface WebSearchResult {
  title: string;
  url: string;
  snippet: string;
  relevance: number;
}

interface APIDiscovery {
  name: string;
  category: string;
  description: string;
  documentation: string;
  authentication: 'api_key' | 'oauth' | 'bearer' | 'basic' | 'none';
  pricing: 'free' | 'freemium' | 'paid';
  endpoints: Array<{
    method: string;
    path: string;
    description: string;
    parameters?: string[];
  }>;
  sdkAvailable: boolean;
  norwegianSupport: boolean;
  requirements: string[];
}

interface APIIntegrationSuggestion {
  api: APIDiscovery;
  reason: string;
  implementation: string;
  environment_variables: string[];
  installation_commands: string[];
  example_code: string;
  security_considerations: string[];
}

interface AIGenerationContext {
  profession: string;
  projectContext: any;
  databaseSchema: DatabaseAnalysis;
  codebasePatterns: CodebaseAnalysis;
  userRequirements: string;
  problemToSolve?: string;
  webSearchResults: WebSearchResult[];
  suggestedAPIs: APIIntegrationSuggestion[];
  requiredIntegrations: string[];
}

interface GoogleDocsDocument {
  id: string;
  name: string;
  createdTime: string;
  modifiedTime: string;
  webViewLink: string;
  content?: string;
}

interface Note {
  id: string;
  title: string;
  content: string;
  category: string;
  tags: string[];
  createdAt: string;
  updatedAt: string;
  isShared: boolean;
  googleDocsId?: string;
}

interface CreatorHubNotesProps {
  className?: string;
}

/**
 * CreatorHub Notater - Avansert notatverktøy med ReactQuill og Google integrasjon
 * Funksjoner: Rich text editing, kategorisering, søk, Google Docs backup
 * Designet for profesjonelle notater og dokumentasjon
 */
export default function CreatorHubNotes({ className }: CreatorHubNotesProps) {
  // ✅ Notat state
  const [notes, setNotes] = useState<Note[]>([]);
  const [selectedNote, setSelectedNote] = useState<Note | null>(null);
  const [isEditing, setIsEditing] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategory, setSelectedCategory] = useState('alle');
  const [currentContent, setCurrentContent] = useState('');
  const [currentTitle, setCurrentTitle] = useState('');
  const [showNewNoteDialog, setShowNewNoteDialog] = useState(false);
  
  const { toast } = useToast();
  const queryClient = useQueryClient();
  
  // ✅ Notatkategorier
  const categories = [
    { id: 'alle', name: 'Alle notater', icon: 'Notes' },
    { id: 'prosjekt', name: 'Prosjektnotater', icon: 'Architecture' },
    { id: 'møte', name: 'Møtenotater', icon: 'SpeakerNotes' },
    { id: 'idé', name: 'Idéer', icon: 'Lightbulb' },
    { id: 'oppgave', name: 'Oppgaver', icon: 'CheckBox' },
    { id: 'personlig', name: 'Personlige notater', icon: 'Person' }
  ];
  
  // ✅ Magic Creator generasjonssettings for live dokumentering
  const [generationSettings, setGenerationSettings] = useState({
    profession: 'admin',
    framework: 'react',
    intelligenceLevel: 'advanced',
    materialUI: true,
    typescript: true,
    responsive: true,
    analyzeExisting: true,
    generateAPI: false,
    saveToGoogleDocs: true,
    liveDocs: true
  });

  // ✅ Komplett QuillBot-stil verktøysett - ALLE funksjoner
  const [showParaphraser, setShowParaphraser] = useState(false);
  const [showGrammarChecker, setShowGrammarChecker] = useState(false);
  const [showSummarizer, setShowSummarizer] = useState(false);
  const [showHumanizer, setShowHumanizer] = useState(false);
  const [showTranslator, setShowTranslator] = useState(false);
  const [showCitationGen, setShowCitationGen] = useState(false);
  const [showParagraphGen, setShowParagraphGen] = useState(false);
  const [showStoryGen, setShowStoryGen] = useState(false);
  const [showEmailGen, setShowEmailGen] = useState(false);
  const [showCoverLetterGen, setShowCoverLetterGen] = useState(false);
  const [showTitleGen, setShowTitleGen] = useState(false);
  const [showAIDetector, setShowAIDetector] = useState(false);
  const [showPlagiarismChecker, setShowPlagiarismChecker] = useState(false);
  const [showWordCounter, setShowWordCounter] = useState(false);
  const [showHashtagGen, setShowHashtagGen] = useState(false);
  const [showLyricsGen, setShowLyricsGen] = useState(false);
  const [showAcronymGen, setShowAcronymGen] = useState(false);
  const [showProductNameGen, setShowProductNameGen] = useState(false);
  
  // Input/Output states for alle verktøy
  const [inputText, setInputText] = useState('');
  const [outputText, setOutputText] = useState('');
  const [selectedLanguage, setSelectedLanguage] = useState('nb');
  const [targetLanguage, setTargetLanguage] = useState('en');
  const [paraphraseMode, setParaphraseMode] = useState('standard');
  const [citationStyle, setCitationStyle] = useState('apa');
  const [summaryFormat, setSummaryFormat] = useState('bullets');
  const [isProcessing, setIsProcessing] = useState(false);
  
  // QuillBot modes som i originalen - 9 modi
  const paraphraseModes = [
    { value: 'standard', label: 'Standard', description: 'Balansert omskriving', free: true },
    { value: 'fluency', label: 'Fluency', description: 'Forbedrer flyt og lesbarhet', free: true },
    { value: 'creative', label: 'Creative', description: 'Kreativ og originell omskriving', free: false },
    { value: 'academic', label: 'Academic', description: 'Akademisk og formell stil', free: false },
    { value: 'formal', label: 'Formal', description: 'Professionell og formell tone', free: false },
    { value: 'shorten', label: 'Shorten', description: 'Forkorter og kondenserer tekst', free: false },
    { value: 'expand', label: 'Expand', description: 'Utvider og utdyper tekst', free: false },
    { value: 'humanize', label: 'Humanize', description: 'Gjør AI-tekst mer naturlig', free: false }
  ];
  
  // Språk for oversetter - 45+ språk som QuillBot
  const languages = [
    { code: 'nb', name: 'Norsk (Bokmål)' },
    { code: 'nn', name: 'Norsk (Nynorsk)' },
    { code: 'en', name: 'English' },
    { code: 'de', name: 'Deutsch' },
    { code: 'fr', name: 'Français' },
    { code: 'es', name: 'Español' },
    { code: 'it', name: 'Italiano' },
    { code: 'pt', name: 'Português' },
    { code: 'ru', name: 'Русский' },
    { code: 'ja', name: '日本語' },
    { code: 'ko', name: '한국어' },
    { code: 'zh', name: '中文' },
    { code: 'ar', name: 'العربية' },
    { code: 'hi', name: 'हिन्दी' },
    { code: 'tr', name: 'Türkçe' },
    { code: 'pl', name: 'Polski' },
    { code: 'nl', name: 'Nederlands' },
    { code: 'sv', name: 'Svenska' },
    { code: 'da', name: 'Dansk' },
    { code: 'fi', name: 'Suomi' }
  ];
  
  // Siteringsstiler - 1000+ som QuillBot
  const citationStyles = [
    { value: 'apa', label: 'APA 7th Edition' },
    { value: 'mla', label: 'MLA 9th Edition' },
    { value: 'chicago', label: 'Chicago 17th Edition' },
    { value: 'harvard', label: 'Harvard Style' },
    { value: 'ieee', label: 'IEEE Style' },
    { value: 'vancouver', label: 'Vancouver Style' },
    { value: 'ama', label: 'AMA 11th Edition' },
    { value: 'asa', label: 'ASA 6th Edition' }
  ];
  
  // ✅ ReactQuill konfigurasjon for notater
  const quillModules = {
    toolbar: {
      container: [
        [{ 'header': [1, 2, 3, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block'],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'indent': '-1'}, { 'indent': '+1' }],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'align': [] }],
        ['link', 'image', 'video'],
        ['clean']
      ]
    },
    clipboard: {
      matchVisual: false
    }
  };

  const quillFormats = [
    'header', 'bold', 'italic', 'underline', 'strike',
    'blockquote', 'code-block', 'list', 'bullet', 'indent',
    'color', 'background', 'align', 'link', 'image', 'video'
  ];
  
  const [aiContext, setAiContext] = useState<AIGenerationContext>({
    profession: 'photographer',
    projectContext: null,
    databaseSchema: { tables: [], patterns: [], suggestions: [] },
    codebasePatterns: { components: [], patterns: [], apiEndpoints: [], commonStructures: [] },
    userRequirements: '',
    problemToSolve: '',
    webSearchResults: [],
    suggestedAPIs: [],
    requiredIntegrations: []
  });
  
  const [analysisInProgress, setAnalysisInProgress] = useState(false);
  const [currentAnalysisStep, setCurrentAnalysisStep] = useState(0);
  const [userRequirements, setUserRequirements] = useState('');
  const [problemDescription, setProblemDescription] = useState('');
  const [webSearchInProgress, setWebSearchInProgress] = useState(false);
  const [apiDiscoveryResults, setApiDiscoveryResults] = useState<APIDiscovery[]>([]);
  const [showAPIRequirements, setShowAPIRequirements] = useState(false);
  const [googleDocsDialog, setGoogleDocsDialog] = useState(false);
  const [selectedDocument, setSelectedDocument] = useState<GoogleDocsDocument | null>(null);
  const [showSnackbar, setShowSnackbar] = useState(false);
  const [snackbarMessage, setSnackbarMessage] = useState('');
  
  // Smart Notes Integration State
  const [selectedFeedbackTask, setSelectedFeedbackTask] = useState<ImprovementTask | null>(null);
  const [showFeedbackDetails, setShowFeedbackDetails] = useState(false);
  const [showSmartTasksDialog, setShowSmartTasksDialog] = useState(false);
  
  // CreatorHub Bot Enhancer State
  const [showCreatorHubBotEnhancer, setShowCreatorHubBotEnhancer] = useState(false);
  const [textToEnhance, setTextToEnhance] = useState('');
  const [enhancementType, setEnhancementType] = useState<string>('professional');
  const [enhancedText, setEnhancedText] = useState('');
  const [isEnhancing, setIsEnhancing] = useState(false);
  const [enhancementStats, setEnhancementStats] = useState({
    wordsChanged: 0,
    readabilityScore: 0,
    originalLength: 0,
    enhancedLength: 0
  });

  // Enhancement options for CreatorHub Bot-style enhancement
  const enhancementOptions = [
    {
      value: 'professional',
      label: 'Profesjonell',
      description: 'Gjør teksten mer profesjonell og formell'
    },
    {
      value: 'creative',
      label: 'Kreativ',
      description: 'Legger til kreativitet og engasjement'
    },
    {
      value: 'concise',
      label: 'Kortfattet',
      description: 'Gjør teksten kortere og mer direkte'
    },
    {
      value: 'expand',
      label: 'Utvidet',
      description: 'Utvider teksten med flere detaljer'
    },
    {
      value: 'client-friendly',
      label: 'Klientvennlig',
      description: 'Optimalisert for kommunikasjon med klienter'
    },
    {
      value: 'technical',
      label: 'Teknisk',
      description: 'Legger til teknisk presisjon og klarhet'
    }
  ];
  const [strategicNotes, setStrategicNotes] = useState({
    googleWorkspaceReseller: {
      status: 'planning',
      economicAnalysis: {
        initialInvestment: '50000 NOK',
        monthlyCosts: '15000 NOK',
        breakEvenUsers: '25 brukere',
        projectedROI: '6-8 måneder'
      },
      implementation: {
        phase1: 'Sertifisering og setup (4 uker)',
        phase2: 'Integrasjon i CreatorHub (8 uker)',
        phase3: 'Testing og pilot (4 uker)',
        phase4: 'Full lansering (2 uker)'
      },
      progress: {
        sertifisering: 0,
        tekniskIntegrasjon: 0,
        testingValidering: 0,
        markedsføring: 0
      }
    },
    businessStrategy: {
      targetMarket: 'Fotografer og kreative professionelle i Norge',
      pricingModel: 'Margin på Google Workspace abonnementer + support',
      competitiveAdvantage: 'Integrert i CreatorHub med norsk support'
    }
  });
  const [googleDriveFolder, setGoogleDriveFolder] = useState<string | null>(null);

  // ✅ Hent notater fra database
  const { data: fetchedNotes, isLoading: notesLoading, refetch: refetchNotes } = useQuery({
    queryKey: ['/api/notes'],
    queryFn: async () => {
      const response = await apiRequest('/api/notes');
      return response as Note[];
    },
    refetchInterval: 30000
  });

  // ✅ Lagre/oppdater notat
  const saveNoteMutation = useMutation({
    mutationFn: async (noteData: Omit<Note, 'id' | 'createdAt' | 'updatedAt'>) => {
      if (selectedNote?.id) {
        return await apiRequest(`/api/notes/${selectedNote.id}`, {
          method: 'PUT',
          body: JSON.stringify({ ...noteData, updatedAt: new Date().toISOString() })
        });
      } else {
        return await apiRequest('/api/notes', {
          method: 'POST',
          body: JSON.stringify({
            ...noteData,
            id: crypto.randomUUID(),
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString()
          })
        });
      }
    },
    onSuccess: () => {
      toast({
        title: "Notat lagret",
        description: "Notatet ble lagret",
        variant: "default"
      });
      refetchNotes();
      setIsEditing(false);
    },
    onError: (error) => {
      console.error('Feil ved lagring av notat:', error);
      toast({
        title: "Lagring feilet",
        description: "Kunne ikke lagre notatet",
        variant: "destructive"
      });
    }
  });

  // ✅ Slett notat
  const deleteNoteMutation = useMutation({
    mutationFn: async (noteId: string) => {
      return await apiRequest(`/api/notes/${noteId}`, { method: 'DELETE' });
    },
    onSuccess: () => {
      toast({ title: "Notat slettet", variant: "default" });
      refetchNotes();
      setSelectedNote(null);
      setIsEditing(false);
    },
    onError: () => {
      toast({ title: "Sletting feilet", variant: "destructive" });
    }
  });

  // ✅ AI Code Generation (fra Creator Bot)
  const [showCodeGenDialog, setShowCodeGenDialog] = useState(false);
  const [codeGenSettings, setCodeGenSettings] = useState({
    requirements: '',
    profession: 'photographer',
    framework: 'react',
    intelligenceLevel: 'advanced'
  });

  const generateCodeMutation = useMutation({
    mutationFn: async (settings: typeof codeGenSettings) => {
      return await apiRequest('/api/ai/generate-code', {
        method: 'POST',
        body: JSON.stringify(settings)
      });
    },
    onSuccess: (data) => {
      toast({ title: "Kode generert!", description: "Smart komponent opprettet", variant: "default" });
      console.log('Generated code:', data.generatedCode);
      setShowCodeGenDialog(false);
    },
    onError: () => {
      toast({ title: "Kode-generering feilet", variant: "destructive" });
    }
  });

  // ✅ AI Note Analysis (fra Creator Bot Intelligence)
  const analyzeNoteMutation = useMutation({
    mutationFn: async ({ noteId, content }: { noteId?: string, content: string }) => {
      return await apiRequest('/api/ai/analyze-note', {
        method: 'POST',
        body: JSON.stringify({ noteId, content })
      });
    },
    onSuccess: (data) => {
      toast({ title: "Notat analysert!", description: "AI-innsikter tilgjengelig", variant: "default" });
      console.log('AI Analysis:', data.analysis);
      refetchNotes(); // Refresh to show updated insights
    },
    onError: () => {
      toast({ title: "Analyse feilet", variant: "destructive" });
    }
  });

  // ✅ Google Docs Integration
  const [showGoogleDocsDialog, setShowGoogleDocsDialog] = useState(false);
  
  const exportToGoogleDocs = useCallback(async () => {
    if (!selectedNote) return;
    
    try {
      // This would integrate with Google Docs API
      toast({ title: "Google Docs integrasjon", description: "Notatet eksporteres til Google Docs...", variant: "default" });
      setShowGoogleDocsDialog(true);
    } catch (error) {
      toast({ title: "Eksport feilet", variant: "destructive" });
    }
  }, [selectedNote, toast]);

  // CreatorHub Bot-style text enhancement function
  const handleEnhanceText = async () => {
    if (!textToEnhance.trim()) return;
    
    setIsEnhancing(true);
    
    try {
      const response = await apiRequest('POST', '/api/smart-notes/enhance-text', {
        text: textToEnhance,
        enhancementType,
        profession: 'admin',
        targetAudience: 'technical'
      });
      
      if (response.success) {
        setEnhancedText(response.enhancedText);
        setEnhancementStats({
          wordsChanged: Math.abs(response.wordsChanged || 0),
          readabilityScore: response.readabilityScore || 85,
          originalLength: textToEnhance.length,
          enhancedLength: response.enhancedText.length
        });
      }
    } catch (error) {
      console.error('Text enhancement failed:', error);
      toast({
        title: "Tekstforbedring feilet",
        description: "Kunne ikke forbedre teksten. Prøv igjen senere.",
        variant: "destructive"
      });
    } finally {
      setIsEnhancing(false);
    }
  };

  const handleAcceptEnhancement = () => {
    if (enhancedText) {
      // Could be used to update notes or copy to clipboard
      navigator.clipboard.writeText(enhancedText);
      toast({
        title: "Forbedret tekst kopiert!",
        description: "Den forbedrede teksten er kopiert til utklippstavlen",
        variant: "default"
      });
      setShowCreatorHubBotEnhancer(false);
    }
  };

  // ✅ KOMPLETT CREATORBOT PROSESSERINGSFUNKSJONER MED OPENAI
  
  // 🔄 Paraphraser - 9 modi som CreatorBot
  const handleParaphrase = async () => {
    if (!inputText.trim()) {
      toast({
        title: "Ingen tekst",
        description: "Skriv eller lim inn tekst som skal omskrives",
        variant: "destructive"
      });
      return;
    }
    
    setIsProcessing(true);
    try {
      const response = await apiRequest('/api/ai/paraphrase', {
        method: 'POST',
        body: JSON.stringify({
          text: inputText,
          mode: paraphraseMode,
          preserveLength: paraphraseMode === 'shorten' ? 'shorter' : paraphraseMode === 'expand' ? 'longer' : 'same'
        })
      });
      
      if (response?.paraphrased) {
        setOutputText(response.paraphrased);
        toast({
          title: "Tekst omskrevet",
          description: `Brukte ${paraphraseModes.find(m => m.value === paraphraseMode)?.label} modus`,
          variant: "default"
        });
      }
    } catch (error) {
      console.error('Paraphrase error:', error);
      toast({
        title: "Feil",
        description: "Kunne ikke omskrive tekst",
        variant: "destructive"
      });
    } finally {
      setIsProcessing(false);
    }
  };

  // ✍️ Grammar Checker - sanntids korreksjon
  const handleGrammarCheck = async () => {
    if (!inputText.trim()) return;
    
    setIsProcessing(true);
    try {
      const response = await apiRequest('/api/ai/grammar', {
        method: 'POST',
        body: JSON.stringify({ text: inputText })
      });
      
      if (response?.corrected) {
        setOutputText(response.corrected);
        if (response.corrections?.length > 0) {
          toast({
            title: "Grammatikk sjekket",
            description: `Fant og rettet ${response.corrections.length} feil`,
            variant: "default"
          });
        }
      }
    } catch (error) {
      console.error('Grammar check error:', error);
      toast({ title: "Grammatikk-sjekk feilet", variant: "destructive" });
    } finally {
      setIsProcessing(false);
    }
  };

  // 📝 Summarizer - sammendrag i ulike formater
  const handleSummarize = async () => {
    if (!inputText.trim()) return;
    
    setIsProcessing(true);
    try {
      const response = await apiRequest('/api/ai/summarize', {
        method: 'POST',
        body: JSON.stringify({ 
          text: inputText,
          format: summaryFormat 
        })
      });
      
      if (response?.summary) {
        setOutputText(response.summary);
        toast({
          title: "Sammendrag generert",
          description: `Format: ${summaryFormat === 'bullets' ? 'Punktliste' : 'Avsnitt'}`,
          variant: "default"
        });
      }
    } catch (error) {
      console.error('Summarize error:', error);
      toast({ title: "Sammendrag feilet", variant: "destructive" });
    } finally {
      setIsProcessing(false);
    }
  };

  // 🤖 AI Humanizer - gjør AI-tekst naturlig
  const handleHumanize = async () => {
    if (!inputText.trim()) return;
    
    setIsProcessing(true);
    try {
      const response = await apiRequest('/api/ai/humanize', {
        method: 'POST',
        body: JSON.stringify({ text: inputText })
      });
      
      if (response?.humanized) {
        setOutputText(response.humanized);
        toast({
          title: "Tekst humanisert",
          description: "AI-tekst gjort mer naturlig og menneskelig",
          variant: "default"
        });
      }
    } catch (error) {
      console.error('Humanize error:', error);
      toast({ title: "Humanisering feilet", variant: "destructive" });
    } finally {
      setIsProcessing(false);
    }
  };

  // 🌐 Translator - 45+ språk
  const handleTranslate = async () => {
    if (!inputText.trim()) return;
    
    setIsProcessing(true);
    try {
      const response = await apiRequest('/api/ai/translate', {
        method: 'POST',
        body: JSON.stringify({ 
          text: inputText,
          from: selectedLanguage,
          to: targetLanguage
        })
      });
      
      if (response?.translated) {
        setOutputText(response.translated);
        const fromLang = languages.find(l => l.code === selectedLanguage)?.name;
        const toLang = languages.find(l => l.code === targetLanguage)?.name;
        toast({
          title: "Tekst oversatt",
          description: `Fra ${fromLang} til ${toLang}`,
          variant: "default"
        });
      }
    } catch (error) {
      console.error('Translation error:', error);
      toast({ title: "Oversettelse feilet", variant: "destructive" });
    } finally {
      setIsProcessing(false);
    }
  };

  // 📚 Citation Generator - 1000+ stiler
  const handleGenerateCitation = async (sourceType: string = 'website') => {
    setIsProcessing(true);
    try {
      const response = await apiRequest('/api/ai/citation', {
        method: 'POST',
        body: JSON.stringify({ 
          text: inputText,
          style: citationStyle,
          sourceType
        })
      });
      
      if (response?.citation) {
        setOutputText(response.citation);
        toast({
          title: "Sitering generert",
          description: `Stil: ${citationStyles.find(s => s.value === citationStyle)?.label}`,
          variant: "default"
        });
      }
    } catch (error) {
      console.error('Citation error:', error);
      toast({ title: "Sitering feilet", variant: "destructive" });
    } finally {
      setIsProcessing(false);
    }
  };

  // Content Generators - alle CreatorBot-verktøy
  const handleGenerateContent = async (type: string, prompt?: string) => {
    const contentPrompt = prompt || inputText;
    if (!contentPrompt.trim()) return;
    
    setIsProcessing(true);
    try {
      const response = await apiRequest('/api/ai/generate', {
        method: 'POST',
        body: JSON.stringify({ 
          prompt: contentPrompt,
          type,
          language: selectedLanguage
        })
      });
      
      if (response?.generated) {
        setOutputText(response.generated);
        toast({
          title: `${type} generert`,
          description: "Innhold er klart til bruk",
          variant: "default"
        });
      }
    } catch (error) {
      console.error(`${type} generation error:`, error);
      toast({ title: `${type} generering feilet`, variant: "destructive" });
    } finally {
      setIsProcessing(false);
    }
  };

  // 🔍 AI Detector - oppdager AI-innhold
  const handleDetectAI = async () => {
    if (!inputText.trim()) return;
    
    setIsProcessing(true);
    try {
      const response = await apiRequest('/api/ai/detect', {
        method: 'POST',
        body: JSON.stringify({ text: inputText })
      });
      
      if (response?.detection) {
        setOutputText(`AI-sannsynlighet: ${response.detection.probability}%\n\nAnalyse:\n${response.detection.analysis}`);
      }
    } catch (error) {
      console.error('AI detection error:', error);
      toast({ title: "AI-deteksjon feilet", variant: "destructive" });
    } finally {
      setIsProcessing(false);
    }
  };

  // 📊 Word Counter med analyse
  const analyzeText = (text: string) => {
    const words = text.trim().split(/\s+/).filter(word => word.length > 0);
    const characters = text.length;
    const charactersNoSpaces = text.replace(/\s/g, '').length;
    const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
    const paragraphs = text.split(/\n\s*\n/).filter(p => p.trim().length > 0).length;
    
    return {
      words: words.length,
      characters,
      charactersNoSpaces,
      sentences,
      paragraphs,
      averageWordsPerSentence: Math.round(words.length / sentences || 0),
      readingTime: Math.ceil(words.length / 200) // 200 ord per minutt
    };
  };

