</body>
</html>
`;

  const generateIntelligentAPI = () => `
// 🧠 AI-Generated API Endpoints
import express from 'express';
import { storage } from '../storage';

const router = express.Router();

// Intelligent ${generationSettings.profession} endpoint
router.post('/api/${generationSettings.profession}/intelligent-action', async (req, res) => {
  try {
    const { action, context } = req.body;
    
    // AI-powered logic based on profession
    const result = await processIntelligentAction(action, context, '${generationSettings.profession}');
    
    res.json({ 
      success: true, 
      result,
      generatedBy: 'MagicCreator AI',
      timestamp: new Date().toISOString()
    });
  } catch (error) {
    res.status(500).json({ error: 'Intelligent action failed' });
  }
});

async function processIntelligentAction(action: string, context: any, profession: string) {
  // Profession-specific intelligent processing
  const professionHandlers = {
    photographer: () => optimizePhotographyWorkflow(context),
    videographer: () => optimizeVideoWorkflow(context),
    music_producer: () => optimizeMusicWorkflow(context)
  };
  
  return await professionHandlers[profession]?.() || 'Generic intelligent action';
}

export default router;
`;

  const generateIntelligentDatabase = () => `
-- 🧠 AI-Generated Database Schema
-- Generated for ${generationSettings.profession} profession

CREATE TABLE IF NOT EXISTS ${generationSettings.profession}_intelligence (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id VARCHAR REFERENCES users(id),
  intelligence_data JSONB NOT NULL,
  profession VARCHAR DEFAULT '${generationSettings.profession}',
  ai_insights JSONB,
  performance_metrics JSONB,
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_${generationSettings.profession}_user 
  ON ${generationSettings.profession}_intelligence(user_id);

CREATE INDEX IF NOT EXISTS idx_${generationSettings.profession}_profession 
  ON ${generationSettings.profession}_intelligence(profession);

-- AI-generated insights table
CREATE TABLE IF NOT EXISTS ai_code_generations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id VARCHAR,
  component_type VARCHAR,
  generated_code TEXT,
  intelligence_level VARCHAR DEFAULT '${generationSettings.intelligenceLevel}',
  profession VARCHAR DEFAULT '${generationSettings.profession}',
  google_docs_id VARCHAR,
  created_at TIMESTAMP DEFAULT NOW()
);
`;

  // ✅ Notat-funksjoner
  const handleSaveNote = () => {
    if (!currentTitle.trim()) {
      toast({ title: "Mangler tittel", description: "Notatet trenger en tittel", variant: "destructive" });
      return;
    }
    
    saveNoteMutation.mutate({
      title: currentTitle,
      content: currentContent,
      category: selectedCategory === 'alle' ? 'personlig' : selectedCategory,
      tags: [],
      isShared: false
    });
  };

  const handleSelectNote = (note: Note) => {
    setSelectedNote(note);
    setCurrentTitle(note.title);
    setCurrentContent(note.content);
    setIsEditing(false);
  };

  const startNewNote = () => {
    setSelectedNote(null);
    setCurrentTitle('');
    setCurrentContent('');
    setIsEditing(true);
  };

  // ✅ Filtrer notater
  const filteredNotes = (fetchedNotes || []).filter(note => {
    const matchesSearch = !searchQuery || 
      note.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
      note.content.toLowerCase().includes(searchQuery.toLowerCase());
    const matchesCategory = selectedCategory === 'alle' || note.category === selectedCategory;
    return matchesSearch && matchesCategory;
  });

  return (
    <Box className={className} sx={{ height: '100vh', display: 'flex' }}>
      {/* ✅ Sidebar med notatliste */}
      <Paper sx={{ width: 320, borderRight: 1, borderColor: 'divider', display: 'flex', flexDirection: 'column' }}>
        {/* Header */}
        <Box sx={{ p: 2, borderBottom: 1, borderColor: 'divider' }}>
          <Typography variant="h5" sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 2 }}>
            <NotesIcon color="primary" />
            CreatorHub Notater
          </Typography>
          
          {/* Søk */}
          <TextField
            fullWidth
            size="small"
            placeholder="Søk i notater..."
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            InputProps={{
              startAdornment: <Search sx={{ color: 'text.secondary', mr: 1 }} />
            }}
            sx={{ mb: 2 }}
          />
          
          {/* Ny notat knapp */}
          <Button
            fullWidth
            variant="contained"
            startIcon={<Add />}
            onClick={startNewNote}
            sx={{ mb: 1 }}
          >
            Nytt notat
          </Button>
        </Box>

        {/* Kategorier */}
        <Box sx={{ p: 1 }}>
          <Tabs
            orientation="vertical"
            value={selectedCategory}
            onChange={(_, value) => setSelectedCategory(value)}
            sx={{ minHeight: 'auto' }}
          >
            {categories.map(cat => (
              <Tab
                key={cat.id}
                value={cat.id}
                label={cat.name}
                sx={{ 
                  minHeight: 36, 
                  fontSize: '12px',
                  alignItems: 'flex-start',
                  textAlign: 'left'
                }}
              />
            ))}
          </Tabs>
        </Box>
        
        {/* Notatliste */}
        <Box sx={{ flex: 1, overflow: 'auto' }}>
          {notesLoading ? (
            <Box sx={{ p: 2, textAlign: 'center' }}>
              <CircularProgress size={24} />
            </Box>
          ) : filteredNotes.length > 0 ? (
            <List dense>
              {filteredNotes.map((note) => (
                <ListItem
                  key={note.id}
                  button
                  selected={selectedNote?.id === note.id}
                  onClick={() => handleSelectNote(note)}
                  sx={{ px: 2 }}
                >
                  <ListItemText
                    primary={
                      <Typography variant="body2" noWrap>
                        {note.title}
                      </Typography>
                    }
                    secondary={
                      <Box>
                        <Typography variant="caption" color="text.secondary">
                          {new Date(note.updatedAt).toLocaleDateString('no')}
                        </Typography>
                        <Box 
                          dangerouslySetInnerHTML={{ 
                            __html: note.content.replace(/<[^>]*>/g, '').substring(0, 50) + '...' 
                          }} 
                          sx={{ 
                            fontSize: '11px', 
                            color: 'text.secondary',
                            mt: 0.5,
                            overflow: 'hidden',
                            textOverflow: 'ellipsis'
                          }}
                        />
                      </Box>
                    }
                  />
                </ListItem>
              ))}
            </List>
          ) : (
            <Box sx={{ p: 2, textAlign: 'center', color: 'text.secondary' }}>
              <NotesIcon sx={{ fontSize: 48, mb: 1, opacity: 0.5 }} />
              <Typography variant="body2">
                {searchQuery ? 'Ingen notater funnet' : 'Ingen notater ennå'}
              </Typography>
            </Box>
          )}
        </Box>
      </Paper>

      {/* ✅ Hovedinnhold */}
      <Box sx={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
        
        {/* Toolbar */}
        <Paper sx={{ p: 2, borderBottom: 1, borderColor: 'divider', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
          {selectedNote || isEditing ? (
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, flex: 1 }}>
              <TextField
                size="small"
                placeholder="Notattittel..."
                value={currentTitle}
                onChange={(e) => setCurrentTitle(e.target.value)}
                sx={{ flex: 1 }}
              />
              
              <Box sx={{ display: 'flex', gap: 1 }}>
                <Button
                  variant="contained"
                  size="small"
                  startIcon={<Save />}
                  onClick={handleSaveNote}
                  disabled={saveNoteMutation.isPending || !currentTitle.trim()}
                >
                  {saveNoteMutation.isPending ? 'Lagrer...' : 'Lagre'}
                </Button>
                
                {selectedNote && (
                  <>
                    <Button
                      variant="outlined"
                      size="small"
                      startIcon={isEditing ? <Visibility /> : <Edit />}
                      onClick={() => setIsEditing(!isEditing)}
                    >
                      {isEditing ? 'Forhåndsvis' : 'Rediger'}
                    </Button>
                    
                    <Button
                      variant="outlined"
                      size="small"
                      color="error"
                      startIcon={<Delete />}
                      onClick={() => selectedNote && deleteNoteMutation.mutate(selectedNote.id)}
                      disabled={deleteNoteMutation.isPending}
                    >
                      Slett
                    </Button>
                  </>
                )}
              </Box>
            </Box>
          ) : (
            <Typography variant="h6" color="text.secondary">
              Velg et notat eller opprett et nytt
            </Typography>
          )}
        </Paper>
        
        {/* Editor/Viewer */}
        <Box sx={{ flex: 1, p: 2 }}>
          {selectedNote || isEditing ? (
            isEditing ? (
              <Box sx={{ height: '100%' }}>
                <RichTextEditor
                  theme="snow"
                  value={currentContent}
                  onChange={setCurrentContent}
                  modules={quillModules}
                  formats={quillFormats}
                  placeholder="Skriv ditt notat her..."
                  style={{ height: 'calc(100% - 50px)' }}
                />
              </Box>
            ) : (
              <Box sx={{ height: '100%', overflow: 'auto' }}>
                <Typography variant="h4" gutterBottom>
                  {selectedNote.title}
                </Typography>
                <Box 
                  dangerouslySetInnerHTML={{ __html: selectedNote.content }}
                  sx={{ 
                    '& h1': { fontSize: '1.5rem', mb: 1 },
                    '& h2': { fontSize: '1.25rem', mb: 1 },
                    '& h3': { fontSize: '1.125rem', mb: 1 },
                    '& p': { mb: 1 },
                    '& ul, & ol': { pl: 3, mb: 1 },
                    '& li': { mb: 0.5 },
                    '& blockquote': { 
                      borderLeft: 4, 
                      borderColor: 'primary.main',
                      bgcolor: 'grey.50',
                      p: 2,
                      m: 1,
                      fontStyle: 'italic'
                    },
                    lineHeight: 1.6
                  }}
                />
              </Box>
            )
          ) : (
            <Box sx={{ 
              height: '100%', 
              display: 'flex', 
              alignItems: 'center', 
              justifyContent: 'center',
              flexDirection: 'column',
              color: 'text.secondary'
            }}>
              <NotesIcon sx={{ fontSize: 80, mb: 2, opacity: 0.3 }} />
              <Typography variant="h6" gutterBottom>
                Velkommen til CreatorHub Notater
              </Typography>
              <Typography variant="body2" align="center">
                Velg et notat fra listen til venstre eller opprett et nytt<br/>
                for å komme i gang med avansert notatskriving
              </Typography>
            </Box>
          )}
        </Box>
      </Box>
      
      {/* ✅ Creator Bot SpeedDial - Avanserte funksjoner */}
      <Fab
        color="primary"
        size="large"
        sx={{ position: 'fixed', bottom: 20, right: 20 }}
        onClick={() => setShowCodeGenDialog(true)}
        title="Creator Bot - Code Generator"
      >
        <SmartToy />
      </Fab>
      
      {/* ✅ Code Generator Dialog */}
      <Dialog 
        open={showCodeGenDialog} 
        onClose={() => setShowCodeGenDialog(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <SmartToy color="primary" />
          Creator Bot - Code Generator
        </DialogTitle>
        <DialogContent>
          <Stack spacing={3} sx={{ mt: 1 }}>
            <TextField
              fullWidth
              multiline
              rows={3}
              label="Beskrivelse av krav"
              value={codeGenSettings.requirements}
              onChange={(e) => setCodeGenSettings(prev => ({ ...prev, requirements: e.target.value }))}
              placeholder="Beskriv hvilken komponent du vil generere..."
            />
            
            <Grid container spacing={2}>
              <Grid item xs={4}>
                <FormControl fullWidth>
                  <InputLabel>Profesjon</InputLabel>
                  <Select
                    value={codeGenSettings.profession}
                    onChange={(e) => setCodeGenSettings(prev => ({ ...prev, profession: e.target.value }))}
                  >
                    <MenuItem value="photographer">Fotograf</MenuItem>
                    <MenuItem value="videographer">Videomaker</MenuItem>
                    <MenuItem value="musician">Musiker</MenuItem>
                    <MenuItem value="vendor">Leverandør</MenuItem>
                  </Select>
                </FormControl>
              </Grid>
              <Grid item xs={4}>
                <FormControl fullWidth>
                  <InputLabel>Framework</InputLabel>
                  <Select
                    value={codeGenSettings.framework}
                    onChange={(e) => setCodeGenSettings(prev => ({ ...prev, framework: e.target.value }))}
                  >
                    <MenuItem value="react">React</MenuItem>
                    <MenuItem value="vue">Vue.js</MenuItem>
                    <MenuItem value="angular">Angular</MenuItem>
                  </Select>
                </FormControl>
              </Grid>
              <Grid item xs={4}>
                <FormControl fullWidth>
                  <InputLabel>Intelligens-nivå</InputLabel>
                  <Select
                    value={codeGenSettings.intelligenceLevel}
                    onChange={(e) => setCodeGenSettings(prev => ({ ...prev, intelligenceLevel: e.target.value }))}
                  >
                    <MenuItem value="basic">Basis</MenuItem>
                    <MenuItem value="advanced">Avansert</MenuItem>
                    <MenuItem value="expert">Ekspert</MenuItem>
                  </Select>
                </FormControl>
              </Grid>
            </Grid>
            
            {generateCodeMutation.isPending && (
              <Box sx={{ textAlign: 'center', py: 2 }}>
                <CircularProgress />
                <Typography variant="body2" sx={{ mt: 1 }}>
                  Genererer intelligent kode...
                </Typography>
              </Box>
            )}
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowCodeGenDialog(false)}>Avbryt</Button>
          <Button 
            variant="contained"
            onClick={() => generateCodeMutation.mutate(codeGenSettings)}
            disabled={!codeGenSettings.requirements.trim() || generateCodeMutation.isPending}
          >
            Generer kode
          </Button>
        </DialogActions>
      </Dialog>
      
      {/* ✅ Google Docs Export Dialog */}
      <Dialog 
        open={showGoogleDocsDialog} 
        onClose={() => setShowGoogleDocsDialog(false)}
      >
        <DialogTitle>Eksporter til Google Docs</DialogTitle>
        <DialogContent>
          <Typography variant="body1" gutterBottom>
            Notatet "{selectedNote?.title}" vil bli eksportert til Google Docs.
          </Typography>
          <Alert severity="info" sx={{ mt: 2 }}>
            Google Docs-integrasjon lar deg dele og samarbeide om notater med ditt team.
          </Alert>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowGoogleDocsDialog(false)}>Avbryt</Button>
          <Button variant="contained" startIcon={<CloudDownload />}>
            Eksporter nå
          </Button>
        </DialogActions>
      </Dialog>
      
      {/* ✅ KOMPLETT QUILLBOT DIALOGER - ALLE 20+ VERKTØY */}
      
      {/* 🔄 Paraphraser Dialog - 9 Modi som QuillBot */}
      <Dialog 
        open={showParaphraser} 
        onClose={() => setShowParaphraser(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Transform color="primary" />
          Paraphraser - Omskriv Tekst
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <Typography variant="subtitle2" gutterBottom>Velg Skrivestil:</Typography>
              <Grid container spacing={1}>
                {paraphraseModes.map((mode) => (
                  <Grid item xs={6} sm={4} key={mode.value}>
                    <Button
                      fullWidth
                      variant={paraphraseMode === mode.value ? 'contained' : 'outlined'}
                      size="small"
                      onClick={() => setParaphraseMode(mode.value)}
                      disabled={!mode.free}
                      sx={{ 
                        flexDirection: 'column',
                        minHeight: 60,
                        opacity: !mode.free ? 0.6 : 1
                      }}
                    >
                      <Typography variant="caption" fontWeight="bold">
                        {mode.label}
                      </Typography>
                      <Typography variant="caption" fontSize="0.7rem">
                        {mode.description}
                      </Typography>
                    </Button>
                  </Grid>
                ))}
              </Grid>
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Tekst som skal omskrives"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Skriv eller lim inn tekst her..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Omskrevet tekst"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowParaphraser(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleParaphrase?.()}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Transform />}
          >
            {isProcessing ? 'Prosesserer...' : 'Omskriv'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* ✍️ Grammar Checker Dialog */}
      <Dialog 
        open={showGrammarChecker} 
        onClose={() => setShowGrammarChecker(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Spellcheck color="primary" />
          Grammar Checker
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Tekst som skal sjekkes"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Skriv eller lim inn tekst for grammatikk-sjekking..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Korrigert tekst"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowGrammarChecker(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleGrammarCheck?.()}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Spellcheck />}
          >
            {isProcessing ? 'Sjekker...' : 'Sjekk Grammatikk'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 📝 Summarizer Dialog */}
      <Dialog 
        open={showSummarizer} 
        onClose={() => setShowSummarizer(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Subject color="primary" />
          Summarizer - Sammendrag
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <FormControl fullWidth size="small" sx={{ mb: 2 }}>
                <InputLabel>Sammendrag Format</InputLabel>
                <Select
                  value={summaryFormat}
                  label="Sammendrag Format"
                  onChange={(e) => setSummaryFormat(e.target.value)}
                >
                  <MenuItem value="bullets">Punktliste</MenuItem>
                  <MenuItem value="paragraph">Avsnitt</MenuItem>
                </Select>
              </FormControl>
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={5}
                label="Tekst som skal sammendras"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Skriv eller lim inn lang tekst som skal sammendras..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={3}
                label="Sammendrag"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowSummarizer(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleSummarize?.()}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Subject />}
          >
            {isProcessing ? 'Sammendrar...' : 'Lag Sammendrag'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 🤖 AI Humanizer Dialog */}
      <Dialog 
        open={showHumanizer} 
        onClose={() => setShowHumanizer(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Psychology color="primary" />
          AI Humanizer
        </DialogTitle>
        <DialogContent>
          <Alert severity="info" sx={{ mb: 2 }}>
            Gjør AI-generert tekst mer naturlig og menneskelig
          </Alert>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="AI-tekst som skal humaniseres"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Lim inn AI-generert tekst som skal gjøres mer naturlig..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Humanisert tekst"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowHumanizer(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleHumanize?.()}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Psychology />}
          >
            {isProcessing ? 'Humaniserer...' : 'Humaniser Tekst'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 🌐 Translator Dialog */}
      <Dialog 
        open={showTranslator} 
        onClose={() => setShowTranslator(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Translate color="primary" />
          Translator - 45+ Språk
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={6}>
              <FormControl fullWidth size="small">
                <InputLabel>Fra språk</InputLabel>
                <Select
                  value={selectedLanguage}
                  label="Fra språk"
                  onChange={(e) => setSelectedLanguage(e.target.value)}
                >
                  {languages.map((lang) => (
                    <MenuItem key={lang.code} value={lang.code}>
                      {lang.name}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>
            
            <Grid item xs={6}>
              <FormControl fullWidth size="small">
                <InputLabel>Til språk</InputLabel>
                <Select
                  value={targetLanguage}
                  label="Til språk"
                  onChange={(e) => setTargetLanguage(e.target.value)}
                >
                  {languages.map((lang) => (
                    <MenuItem key={lang.code} value={lang.code}>
                      {lang.name}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Tekst som skal oversettes"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Skriv eller lim inn tekst som skal oversettes..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Oversatt tekst"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowTranslator(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleTranslate?.()}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Translate />}
          >
            {isProcessing ? 'Oversetter...' : 'Oversett'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 📚 Citation Generator Dialog */}
      <Dialog 
        open={showCitationGen} 
        onClose={() => setShowCitationGen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <FormatQuote color="primary" />
          Citation Generator - 1000+ Stiler
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <FormControl fullWidth size="small">
                <InputLabel>Sitering Stil</InputLabel>
                <Select
                  value={citationStyle}
                  label="Sitering Stil"
                  onChange={(e) => setCitationStyle(e.target.value)}
                >
                  {citationStyles.map((style) => (
                    <MenuItem key={style.value} value={style.value}>
                      {style.label}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={3}
                label="Kilde informasjon"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Skriv inn forfatter, tittel, URL eller annen kildeinfo..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={3}
                label="Generert sitering"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowCitationGen(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleGenerateCitation?.()}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <FormatQuote />}
          >
            {isProcessing ? 'Genererer...' : 'Generer Sitering'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 📃 Content Generators - Alle QuillBot Verktøy */}
      
      {/* 📄 Paragraph Generator */}
      <Dialog 
        open={showParagraphGen} 
        onClose={() => setShowParagraphGen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Article color="primary" />
          Paragraph Generator
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                label="Tema eller nøkkelord"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Skriv tema eller nøkkelord for avsnitt..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Generert avsnitt"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowParagraphGen(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleGenerateContent?.('paragraph')}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Article />}
          >
            {isProcessing ? 'Genererer...' : 'Generer Avsnitt'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 📖 Story Generator */}
      <Dialog 
        open={showStoryGen} 
        onClose={() => setShowStoryGen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Book color="primary" />
          Story Generator
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={2}
                label="Historieide eller prompt"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Beskriv historien du vil generere..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={6}
                label="Generert historie"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowStoryGen(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleGenerateContent?.('story')}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Book />}
          >
            {isProcessing ? 'Genererer...' : 'Generer Historie'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* ✉️ Email Generator */}
      <Dialog 
        open={showEmailGen} 
        onClose={() => setShowEmailGen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Email color="primary" />
          Email Generator
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                label="E-post formål"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Beskriv hva e-posten skal handle om..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={5}
                label="Generert e-post"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowEmailGen(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleGenerateContent?.('email')}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Email />}
          >
            {isProcessing ? 'Genererer...' : 'Generer E-post'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 💼 Cover Letter Generator */}
      <Dialog 
        open={showCoverLetterGen} 
        onClose={() => setShowCoverLetterGen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Work color="primary" />
          Cover Letter Generator
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={2}
                label="Stillingsbeskrivelse"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Beskriv stillingen du søker på..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={6}
                label="Generert søknadsbrev"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowCoverLetterGen(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleGenerateContent?.('cover-letter')}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Work />}
          >
            {isProcessing ? 'Genererer...' : 'Generer Søknadsbrev'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 📌 Title Generator */}
      <Dialog 
        open={showTitleGen} 
        onClose={() => setShowTitleGen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Title color="primary" />
          Title Generator
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                label="Innhold eller tema"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Beskriv innholdet som trenger en tittel..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={3}
                label="Genererte titler"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowTitleGen(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier
          </Button>
          <Button 
            variant="contained" 
            onClick={() => handleGenerateContent?.('title')}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Title />}
          >
            {isProcessing ? 'Genererer...' : 'Generer Titler'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 🔍 AI Detector Dialog */}
      <Dialog 
        open={showAIDetector} 
        onClose={() => setShowAIDetector(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Psychology color="primary" />
          AI Content Detector
        </DialogTitle>
        <DialogContent>
          <Alert severity="info" sx={{ mb: 2 }}>
            Analyser tekst for å oppdage AI-generert innhold
          </Alert>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="Tekst som skal analyseres"
                value={inputText}
                onChange={(e) => setInputText(e.target.value)}
                placeholder="Lim inn tekst som skal sjekkes for AI-innhold..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={4}
                label="AI-analyse resultat"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowAIDetector(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => handleDetectAI?.()}
            disabled={!inputText.trim() || isProcessing}
            startIcon={isProcessing ? <CircularProgress size={16} /> : <Psychology />}
          >
            {isProcessing ? 'Analyserer...' : 'Analyser Tekst'}
          </Button>
        </DialogActions>
      </Dialog>

      {/* 📊 Word Counter Dialog */}
      <Dialog 
        open={showWordCounter} 
        onClose={() => setShowWordCounter(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
          <Assignment color="primary" />
          Word Counter & Statistikk
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={5}
                label="Tekst som skal analyseres"
                value={inputText}
                onChange={(e) => {
                  setInputText(e.target.value);
                  if (e.target.value.trim()) {
                    const stats = analyzeText?.(e.target.value);
                    if (stats) {
                      setOutputText(`
📊 TEKSTSTATISTIKK:

• Ord: ${stats.words}
• Tegn: ${stats.characters}
• Tegn (uten mellomrom): ${stats.charactersNoSpaces}
• Setninger: ${stats.sentences}
• Avsnitt: ${stats.paragraphs}
• Gjennomsnittlige ord per setning: ${stats.averageWordsPerSentence}
• Lesetid: ${stats.readingTime} minutter
                      `.trim());
                    }
                  } else {
                    setOutputText('');
                  }
                }}
                placeholder="Skriv eller lim inn tekst for analyse..."
              />
            </Grid>
            
            <Grid item xs={12}>
              <TextField
                fullWidth
                multiline
                rows={6}
                label="Statistikk"
                value={outputText}
                InputProps={{ readOnly: true }}
                sx={{ bgcolor: 'grey.50' }}
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowWordCounter(false)}>Lukk</Button>
          <Button 
            variant="contained" 
            onClick={() => navigator.clipboard.writeText(outputText)}
            disabled={!outputText}
            startIcon={<ContentCopy />}
          >
            Kopier Statistikk
          </Button>
        </DialogActions>
      </Dialog>
      
      {/* ✅ CreatorBot-stil Floating Tools Panel */}
      <Paper
        elevation={6}
        sx={{
          position: 'fixed',
          top: '50%',
          right: 20,
          transform: 'translateY(-50%)',
          width: 280,
          maxHeight: '80vh',
          overflow: 'auto',
          zIndex: 1300,
          borderRadius: 2
        }}
      >
        <Box sx={{ p: 2 }}>
          <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
            <SmartToy color="primary" />
            CreatorBot AI Tools
          </Typography>
          
          {/* CreatorBot Core Tools Grid */}
          <Grid container spacing={1} sx={{ mb: 2 }}>
            {/* Paraphraser */}
            <Grid item xs={6}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowParaphraser(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Transform sx={{ mb: 0.5 }} />
                <Typography variant="caption">Paraphraser</Typography>
              </Button>
            </Grid>
            
            {/* Grammar Checker */}
            <Grid item xs={6}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowGrammarChecker(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Spellcheck sx={{ mb: 0.5 }} />
                <Typography variant="caption">Grammar</Typography>
              </Button>
            </Grid>
            
            {/* Summarizer */}
            <Grid item xs={6}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowSummarizer(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Subject sx={{ mb: 0.5 }} />
                <Typography variant="caption">Summarizer</Typography>
              </Button>
            </Grid>
            
            {/* AI Humanizer */}
            <Grid item xs={6}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowHumanizer(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Psychology sx={{ mb: 0.5 }} />
                <Typography variant="caption">Humanizer</Typography>
              </Button>
            </Grid>
            
            {/* Translator */}
            <Grid item xs={6}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowTranslator(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <Translate sx={{ mb: 0.5 }} />
                <Typography variant="caption">Translator</Typography>
              </Button>
            </Grid>
            
            {/* Citation Generator */}
            <Grid item xs={6}>
              <Button
                fullWidth
                variant="outlined"
                size="small"
                onClick={() => setShowCitationGen(true)}
                sx={{ p: 1, minHeight: 60, flexDirection: 'column' }}
              >
                <FormatQuote sx={{ mb: 0.5 }} />
                <Typography variant="caption">Citations</Typography>
              </Button>
            </Grid>
          </Grid>
          
          {/* Content Generators Accordion */}
          <Accordion>
            <AccordionSummary expandIcon={<ExpandMore />}>
              <Typography variant="subtitle2">Content Generators</Typography>
            </AccordionSummary>
            <AccordionDetails>
              <Stack spacing={1}>
                <Button size="small" variant="text" startIcon={<Article />} onClick={() => setShowParagraphGen(true)}>
                  Paragraph Generator
                </Button>
                <Button size="small" variant="text" startIcon={<Book />} onClick={() => setShowStoryGen(true)}>
                  Story Generator
                </Button>
                <Button size="small" variant="text" startIcon={<Email />} onClick={() => setShowEmailGen(true)}>
                  Email Writer
                </Button>
                <Button size="small" variant="text" startIcon={<Work />} onClick={() => setShowCoverLetterGen(true)}>
                  Cover Letter
                </Button>
                <Button size="small" variant="text" startIcon={<Title />} onClick={() => setShowTitleGen(true)}>
                  Title Generator
                </Button>
              </Stack>
            </AccordionDetails>
          </Accordion>
              
          
          {/* Utilities Accordion */}
          <Accordion>
            <AccordionSummary expandIcon={<ExpandMore />}>
              <Typography variant="subtitle2">Utilities & Analysis</Typography>
            </AccordionSummary>
            <AccordionDetails>
              <Stack spacing={1}>
                <Button size="small" variant="text" startIcon={<Psychology />} onClick={() => setShowAIDetector(true)}>
                  AI Content Detector
                </Button>
                <Button size="small" variant="text" startIcon={<Assignment />} onClick={() => setShowWordCounter(true)}>
                  Word Counter & Stats
                </Button>
                <Button size="small" variant="text" startIcon={<Refresh />} onClick={() => {
                  setInputText('');
                  setOutputText('');
                  toast({ title: "Tilbakestilt", description: "Alle felt er tømt", variant: "default" });
                }}>
                  Clear All Fields
                </Button>
              </Stack>
            </AccordionDetails>
          </Accordion>
        </Box>
      </Paper>
    </Box>
  );
}
