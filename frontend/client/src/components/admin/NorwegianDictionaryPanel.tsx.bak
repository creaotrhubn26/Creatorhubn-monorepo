/**
 * Norwegian Dictionary Panel
 * 
 * Clue-style dictionary integration for CreatorHub
 * Features:
 * - Norwegian ↔ English translation
 * - Technical terminology (business, legal, IT, etc.)
 * - Context-aware suggestions
 * - Word highlighting in editor
 * - Translation history
 * - Pronunciation guide
 * - Usage examples
 */

import React, { useState, useCallback, useEffect, useMemo } from 'react';
import {
  Box,
  Paper,
  Typography,
  TextField,
  Button,
  Stack,
  Chip,
  Divider,
  List,
  ListItem,
  ListItemButton,
  ListItemText,
  IconButton,
  Tooltip,
  CircularProgress,
  Alert,
  Tabs,
  Tab,
  Card,
  CardContent,
  Collapse,
  Badge,
} from '@mui/material';
import {
  Translate as TranslateIcon,
  Search as SearchIcon,
  VolumeUp as VolumeUpIcon,
  History as HistoryIcon,
  Bookmark as BookmarkIcon,
  BookmarkBorder as BookmarkBorderIcon,
  ContentCopy as ContentCopyIcon,
  SwapHoriz as SwapHorizIcon,
  Lightbulb as LightbulbIcon,
  Business as BusinessIcon,
  Gavel as GavelIcon,
  Computer as ComputerIcon,
  ExpandMore as ExpandMoreIcon,
  Star as StarIcon,
} from '@mui/icons-material';
import { useQuery, useMutation } from '@tanstack/react-query';
import { apiRequest } from '@/lib/queryClient';
import { useEnhancedMasterIntegration } from '../../integration/EnhancedMasterIntegrationProvider';

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TYPES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

interface DictionaryEntry {
  word: string;
  translations: Translation[];
  pronunciation?: string;
  wordClass?: string; // noun, verb, adjective, etc.
  domain?: string; // business, legal, IT, etc.
  examples?: Example[];
  synonyms?: string[];
  relatedTerms?: string[];
  frequency?: 'common' | 'uncommon' | 'technical';
}

interface Translation {
  text: string;
  context?: string;
  domain?: string;
  confidence: number;
}

interface Example {
  norwegian: string;
  english: string;
  domain?: string;
}

interface SearchHistory {
  word: string;
  from: 'no' | 'en';
  to: 'no' | 'en';
  timestamp: number;
}

interface Props {
  onWordSelected?: (word: string, translation: string) => void;
  selectedText?: string;
  autoLookup?: boolean;
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// NORWEGIAN DICTIONARY DATA (Starter Set - Can be expanded)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

const DICTIONARY_DATA: Record<string, DictionaryEntry> = {
  // Business Terms
  'bedrift': {
    word: 'bedrift',
    translations: [
      { text: 'company', context: 'general', confidence: 0.95 },
      { text: 'business', context: 'general', confidence: 0.90 },
      { text: 'enterprise', context: 'formal', confidence: 0.85 }
    ],
    pronunciation: 'be-drift',
    wordClass: 'noun',
    domain: 'business',
    examples: [
      { norwegian: 'Vi driver en liten bedrift', english: 'We run a small company' },
      { norwegian: 'Bedriften har 50 ansatte', english: 'The company has 50 employees' }
    ],
    synonyms: ['firma', 'selskap', 'foretak'],
    frequency: 'common'
  },
  'kunde': {
    word: 'kunde',
    translations: [
      { text: 'customer', context: 'general', confidence: 0.95 },
      { text: 'client', context: 'professional services', confidence: 0.90 }
    ],
    pronunciation: 'kun-de',
    wordClass: 'noun',
    domain: 'business',
    examples: [
      { norwegian: 'Kunden er alltid konge', english: 'The customer is always king' },
      { norwegian: 'Vi har 847 kunder', english: 'We have 847 customers' }
    ],
    synonyms: ['klient', 'bruker'],
    frequency: 'common'
  },
  
  // Technical Terms
  'programvare': {
    word: 'programvare',
    translations: [
      { text: 'software', context: 'IT', confidence: 0.98 },
      { text: 'program', context: 'informal', confidence: 0.70 }
    ],
    pronunciation: 'pro-gram-va-re',
    wordClass: 'noun',
    domain: 'IT',
    examples: [
      { norwegian: 'Vi utvikler programvare', english: 'We develop software' },
      { norwegian: 'Programvaren er oppdatert', english: 'The software is updated' }
    ],
    frequency: 'common'
  },
  
  // Marketing Terms
  'markedsføring': {
    word: 'markedsføring',
    translations: [
      { text: 'marketing', context: 'general', confidence: 0.98 },
      { text: 'advertising', context: 'specific', confidence: 0.75 }
    ],
    pronunciation: 'mar-keds-før-ing',
    wordClass: 'noun',
    domain: 'marketing',
    examples: [
      { norwegian: 'Digital markedsføring', english: 'Digital marketing' },
      { norwegian: 'Markedsføringsstrategi', english: 'Marketing strategy' }
    ],
    frequency: 'common'
  },
  
  // Creator Terms
  'fotograf': {
    word: 'fotograf',
    translations: [
      { text: 'photographer', context: 'general', confidence: 0.98 }
    ],
    pronunciation: 'fo-to-graf',
    wordClass: 'noun',
    domain: 'creative',
    examples: [
      { norwegian: 'Bryllupsfotograf', english: 'Wedding photographer' },
      { norwegian: 'Profesjonell fotograf', english: 'Professional photographer' }
    ],
    frequency: 'common'
  },
  'videograf': {
    word: 'videograf',
    translations: [
      { text: 'videographer', context: 'general', confidence: 0.98 },
      { text: 'video producer', context: 'alternative', confidence: 0.85 }
    ],
    pronunciation: 'vi-de-o-graf',
    wordClass: 'noun',
    domain: 'creative',
    frequency: 'common'
  },
  
  // Common Words
  'bryllup': {
    word: 'bryllup',
    translations: [
      { text: 'wedding', context: 'general', confidence: 0.98 }
    ],
    pronunciation: 'bryl-lup',
    wordClass: 'noun',
    examples: [
      { norwegian: 'Bryllupsfotografering', english: 'Wedding photography' },
      { norwegian: 'Bryllupsdag', english: 'Wedding day' }
    ],
    frequency: 'common'
  },
  'prosjekt': {
    word: 'prosjekt',
    translations: [
      { text: 'project', context: 'general', confidence: 0.98 }
    ],
    pronunciation: 'pro-sjekt',
    wordClass: 'noun',
    domain: 'business',
    frequency: 'common'
  }
};

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COMPONENT
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

export default function NorwegianDictionaryPanel({ 
  onWordSelected, 
  selectedText,
  autoLookup = true 
}: Props) {
  const { 
    analytics, 
    performance, 
    auth, 
    features,
    debugging 
  } = useEnhancedMasterIntegration();
  
  // State
  const [searchWord, setSearchWord] = useState('');
  const [fromLang, setFromLang] = useState<'no' | 'en'>('no');
  const [toLang, setToLang] = useState<'no' | 'en'>('en');
  const [currentEntry, setCurrentEntry] = useState<DictionaryEntry | null>(null);
  const [searchHistory, setSearchHistory] = useState<SearchHistory[]>([]);
  const [bookmarkedWords, setBookmarkedWords] = useState<string[]>([]);
  const [showExamples, setShowExamples] = useState(true);
  const [selectedDomain, setSelectedDomain] = useState<string>('all');
  
  // 🔐 User Context
  const userProfile = auth.getUserProfile();
  const userId = userProfile?.id || 'anonymous';
  
  // Load history and bookmarks from localStorage
  useEffect(() => {
    const history = localStorage.getItem('dictionaryHistory');
    if (history) setSearchHistory(JSON.parse(history));
    
    const bookmarks = localStorage.getItem('dictionaryBookmarks');
    if (bookmarks) setBookmarkedWords(JSON.parse(bookmarks));
  }, []);
  
  // Auto-lookup selected text
  useEffect(() => {
    if (autoLookup && selectedText && selectedText.trim().length > 0) {
      const word = selectedText.trim().toLowerCase();
      if (word.length > 2 && word.length < 50) {
        setSearchWord(word);
        lookupWord(word);
      }
    }
  }, [selectedText, autoLookup]);
  
  // 🔍 Lookup word in dictionary
  const lookupWord = useCallback(async (word: string) => {
    const endTiming = performance.startTiming('dictionary_lookup');
    
    try {
      // First check local dictionary
      const localEntry = DICTIONARY_DATA[word.toLowerCase()];
      
      if (localEntry) {
        setCurrentEntry(localEntry);
        
        // Add to history
        const newHistory: SearchHistory = {
          word,
          from: fromLang,
          to: toLang,
          timestamp: Date.now()
        };
        const updated = [newHistory, ...searchHistory.filter(h => h.word !== word)].slice(0, 20);
        setSearchHistory(updated);
        localStorage.setItem('dictionaryHistory', JSON.stringify(updated));
        
        // Track
        analytics.trackEvent('dictionary_lookup', {
          word,
          from: fromLang,
          to: toLang,
          source: 'local',
          userId
        });
        
        features.trackFeatureUsage('dictionary', 'lookup', { word, source: 'local' });
        
        return;
      }
      
      // If not in local dictionary, call API (can integrate with external APIs)
      const headers = await auth.getAuthHeader();
      const response = await apiRequest('/api/dictionary/lookup', {
        method: 'POST',
        body: JSON.stringify({
          word,
          from: fromLang,
          to: toLang,
          userId
        }),
        headers
      });
      
      setCurrentEntry(response as DictionaryEntry);
      
      // Add to history
      const newHistory: SearchHistory = {
        word,
        from: fromLang,
        to: toLang,
        timestamp: Date.now()
      };
      const updated = [newHistory, ...searchHistory.filter(h => h.word !== word)].slice(0, 20);
      setSearchHistory(updated);
      localStorage.setItem('dictionaryHistory', JSON.stringify(updated));
      
      analytics.trackEvent('dictionary_lookup', {
        word,
        from: fromLang,
        to: toLang,
        source: 'api',
        userId
      });
      
      features.trackFeatureUsage('dictionary', 'lookup', { word, source: 'api' });
    } catch (e: any) {
      console.warn('Dictionary lookup failed:', e);
      setCurrentEntry(null);
    } finally {
      endTiming();
    }
  }, [fromLang, toLang, searchHistory, performance, auth, analytics, features, userId]);
  
  // 🔖 Toggle bookmark
  const toggleBookmark = useCallback((word: string) => {
    const updated = bookmarkedWords.includes(word)
      ? bookmarkedWords.filter(w => w !== word)
      : [...bookmarkedWords, word];
    
    setBookmarkedWords(updated);
    localStorage.setItem('dictionaryBookmarks', JSON.stringify(updated));
    
    analytics.trackEvent('dictionary_bookmark_toggled', {
      word,
      bookmarked: updated.includes(word),
      userId
    });
  }, [bookmarkedWords, analytics, userId]);
  
  // 🔄 Swap languages
  const swapLanguages = useCallback(() => {
    setFromLang(toLang);
    setToLang(fromLang);
  }, [fromLang, toLang]);
  
  // 📋 Insert translation into editor
  const insertTranslation = useCallback((translation: string) => {
    if (onWordSelected) {
      onWordSelected(searchWord, translation);
    }
    
    analytics.trackEvent('dictionary_translation_inserted', {
      word: searchWord,
      translation,
      userId
    });
  }, [searchWord, onWordSelected, analytics, userId]);
  
  // 🎯 Domain icons
  const getDomainIcon = (domain?: string) => {
    switch (domain) {
      case 'business': return <BusinessIcon fontSize="small" />;
      case 'legal': return <GavelIcon fontSize="small" />;
      case 'IT': return <ComputerIcon fontSize="small" />;
      default: return <TranslateIcon fontSize="small" />;
    }
  };
  
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // RENDER
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  
  return (
    <Paper sx={{ p: 2 }}>
      <Stack spacing={2}>
        {/* Header */}
        <Stack direction="row" alignItems="center" justifyContent="space-between">
          <Stack direction="row" alignItems="center" spacing={1}>
            <TranslateIcon color="primary" />
            <Typography variant="h6">Norwegian Dictionary</Typography>
          </Stack>
          <Chip 
            label={`${fromLang.toUpperCase()} → ${toLang.toUpperCase()}`}
            size="small"
            color="primary"
          />
        </Stack>
        
        {/* Search Bar */}
        <Stack direction="row" spacing={1}>
          <TextField
            fullWidth
            size="small"
            placeholder={`Search ${fromLang === 'no' ? 'Norwegian' : 'English'} word...`}
            value={searchWord}
            onChange={(e) => setSearchWord(e.target.value)}
            onKeyPress={(e) => {
              if (e.key === 'Enter' && searchWord.trim()) {
                lookupWord(searchWord.trim());
              }
            }}
            InputProps={{
              startAdornment: <SearchIcon sx={{ mr: 1, color: 'text.secondary' }} fontSize="small" />
            }}
          />
          <Tooltip title="Swap languages">
            <IconButton size="small" onClick={swapLanguages}>
              <SwapHorizIcon />
            </IconButton>
          </Tooltip>
          <Button
            variant="contained"
            size="small"
            onClick={() => searchWord.trim() && lookupWord(searchWord.trim())}
            disabled={!searchWord.trim()}
          >
            Search
          </Button>
        </Stack>
        
        {/* Domain Filter */}
        <Stack direction="row" spacing={0.5} flexWrap="wrap">
          {['all', 'business', 'legal', 'IT', 'creative', 'marketing'].map((domain) => (
            <Chip
              key={domain}
              label={domain}
              size="small"
              variant={selectedDomain === domain ? 'filled' : 'outlined'}
              onClick={() => setSelectedDomain(domain)}
              sx={{ fontSize: '0.7rem' }}
            />
          ))}
        </Stack>
        
        <Divider />
        
        {/* Dictionary Entry */}
        {currentEntry ? (
          <Box>
            {/* Word Header */}
            <Stack direction="row" alignItems="center" justifyContent="space-between" mb={2}>
              <Stack direction="row" alignItems="center" spacing={1}>
                <Typography variant="h5" fontWeight="bold" color="primary.main">
                  {currentEntry.word}
                </Typography>
                {currentEntry.pronunciation && (
                  <Chip 
                    label={currentEntry.pronunciation}
                    size="small"
                    variant="outlined"
                    sx={{ fontSize: '0.7rem' }}
                  />
                )}
                {currentEntry.wordClass && (
                  <Chip 
                    label={currentEntry.wordClass}
                    size="small"
                    color="secondary"
                    sx={{ fontSize: '0.7rem' }}
                  />
                )}
              </Stack>
              <Stack direction="row" spacing={0.5}>
                <Tooltip title="Pronounce">
                  <IconButton size="small">
                    <VolumeUpIcon fontSize="small" />
                  </IconButton>
                </Tooltip>
                <Tooltip title={bookmarkedWords.includes(currentEntry.word) ? 'Remove bookmark' : 'Bookmark'}>
                  <IconButton size="small" onClick={() => toggleBookmark(currentEntry.word)}>
                    {bookmarkedWords.includes(currentEntry.word) ? (
                      <BookmarkIcon fontSize="small" color="warning" />
                    ) : (
                      <BookmarkBorderIcon fontSize="small" />
                    )}
                  </IconButton>
                </Tooltip>
              </Stack>
            </Stack>
            
            {/* Domain Badge */}
            {currentEntry.domain && (
              <Stack direction="row" spacing={1} alignItems="center" mb={2}>
                {getDomainIcon(currentEntry.domain)}
                <Chip 
                  label={currentEntry.domain}
                  size="small"
                  variant="outlined"
                />
                {currentEntry.frequency && (
                  <Chip 
                    label={currentEntry.frequency}
                    size="small"
                    color={currentEntry.frequency === 'common' ? 'success' : 'default'}
                    sx={{ fontSize: '0.7rem' }}
                  />
                )}
              </Stack>
            )}
            
            {/* Translations */}
            <Box mb={2}>
              <Typography variant="subtitle2" fontWeight="bold" gutterBottom>
                Translations:
              </Typography>
              <Stack spacing={1}>
                {currentEntry.translations.map((trans, idx) => (
                  <Card key={idx} variant="outlined" sx={{ bgcolor: 'grey.50' }}>
                    <CardContent sx={{ p: 1.5, '&:last-child': { pb: 1.5 } }}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body1" fontWeight="bold">
                            {trans.text}
                          </Typography>
                          {trans.context && (
                            <Typography variant="caption" color="text.secondary">
                              Context: {trans.context}
                            </Typography>
                          )}
                        </Box>
                        <Stack direction="row" spacing={0.5}>
                          <Chip 
                            label={`${(trans.confidence * 100).toFixed(0)}%`}
                            size="small"
                            color={trans.confidence > 0.9 ? 'success' : 'default'}
                            sx={{ fontSize: '0.7rem' }}
                          />
                          <Tooltip title="Insert into note">
                            <IconButton size="small" onClick={() => insertTranslation(trans.text)}>
                              <ContentCopyIcon fontSize="small" />
                            </IconButton>
                          </Tooltip>
                        </Stack>
                      </Stack>
                    </CardContent>
                  </Card>
                ))}
              </Stack>
            </Box>
            
            {/* Examples */}
            {currentEntry.examples && currentEntry.examples.length > 0 && (
              <Box mb={2}>
                <Button
                  size="small"
                  startIcon={<ExpandMoreIcon sx={{ transform: showExamples ? 'rotate(180deg)' : 'none' }} />}
                  onClick={() => setShowExamples(!showExamples)}
                >
                  Usage Examples ({currentEntry.examples.length})
                </Button>
                <Collapse in={showExamples}>
                  <Stack spacing={1} mt={1}>
                    {currentEntry.examples.map((ex, idx) => (
                      <Paper key={idx} variant="outlined" sx={{ p: 1.5, bgcolor: 'info.50' }}>
                        <Typography variant="body2" fontWeight="bold" color="primary.main">
                          🇳🇴 {ex.norwegian}
                        </Typography>
                        <Typography variant="body2" color="text.secondary">
                          🇬🇧 {ex.english}
                        </Typography>
                      </Paper>
                    ))}
                  </Stack>
                </Collapse>
              </Box>
            )}
            
            {/* Synonyms & Related */}
            {(currentEntry.synonyms || currentEntry.relatedTerms) && (
              <Box>
                {currentEntry.synonyms && currentEntry.synonyms.length > 0 && (
                  <Box mb={1}>
                    <Typography variant="caption" fontWeight="bold" gutterBottom display="block">
                      Synonyms:
                    </Typography>
                    <Stack direction="row" spacing={0.5} flexWrap="wrap">
                      {currentEntry.synonyms.map((syn, idx) => (
                        <Chip
                          key={idx}
                          label={syn}
                          size="small"
                          variant="outlined"
                          onClick={() => {
                            setSearchWord(syn);
                            lookupWord(syn);
                          }}
                          sx={{ fontSize: '0.7rem', cursor: 'pointer' }}
                        />
                      ))}
                    </Stack>
                  </Box>
                )}
                
                {currentEntry.relatedTerms && currentEntry.relatedTerms.length > 0 && (
                  <Box>
                    <Typography variant="caption" fontWeight="bold" gutterBottom display="block">
                      Related Terms:
                    </Typography>
                    <Stack direction="row" spacing={0.5} flexWrap="wrap">
                      {currentEntry.relatedTerms.map((term, idx) => (
                        <Chip
                          key={idx}
                          label={term}
                          size="small"
                          variant="outlined"
                          onClick={() => {
                            setSearchWord(term);
                            lookupWord(term);
                          }}
                          sx={{ fontSize: '0.7rem', cursor: 'pointer' }}
                        />
                      ))}
                    </Stack>
                  </Box>
                )}
              </Box>
            )}
          </Box>
        ) : searchWord ? (
          <Alert severity="info">
            <Typography variant="body2">
              No entry found for "{searchWord}". Try a different word or check spelling.
            </Typography>
          </Alert>
        ) : (
          <Box sx={{ textAlign: 'center', py: 2 }}>
            <TranslateIcon sx={{ fontSize: 48, color: 'text.secondary', opacity: 0.3, mb: 1 }} />
            <Typography variant="body2" color="text.secondary">
              Search for a Norwegian or English word
            </Typography>
          </Box>
        )}
        
        <Divider />
        
        {/* Quick Access Tabs */}
        <Tabs value={0} variant="fullWidth" sx={{ borderBottom: 1, borderColor: 'divider' }}>
          <Tab label="History" icon={<HistoryIcon />} />
          <Tab label="Bookmarks" icon={<BookmarkIcon />} />
        </Tabs>
        
        {/* History */}
        <Box>
          <List dense sx={{ maxHeight: 200, overflow: 'auto' }}>
            {searchHistory.slice(0, 10).map((item, idx) => (
              <ListItem key={idx} disablePadding>
                <ListItemButton
                  onClick={() => {
                    setSearchWord(item.word);
                    setFromLang(item.from);
                    setToLang(item.to);
                    lookupWord(item.word);
                  }}
                >
                  <ListItemText
                    primary={item.word}
                    secondary={`${item.from.toUpperCase()} → ${item.to.toUpperCase()}`}
                    primaryTypographyProps={{ variant: 'body2' }}
                    secondaryTypographyProps={{ variant: 'caption' }}
                  />
                </ListItemButton>
              </ListItem>
            ))}
            {searchHistory.length === 0 && (
              <ListItem>
                <ListItemText
                  primary="No search history"
                  primaryTypographyProps={{ variant: 'caption', color: 'text.secondary' }}
                />
              </ListItem>
            )}
          </List>
        </Box>
        
        {/* Quick Translations */}
        <Box>
          <Typography variant="caption" fontWeight="bold" gutterBottom display="block">
            🔥 Common Terms:
          </Typography>
          <Stack direction="row" spacing={0.5} flexWrap="wrap">
            {['bedrift', 'kunde', 'prosjekt', 'fotograf', 'bryllup', 'markedsføring'].map((word) => (
              <Chip
                key={word}
                label={word}
                size="small"
                variant="outlined"
                onClick={() => {
                  setSearchWord(word);
                  lookupWord(word);
                }}
                sx={{ fontSize: '0.7rem', cursor: 'pointer' }}
              />
            ))}
          </Stack>
        </Box>
      </Stack>
    </Paper>
  );
}


