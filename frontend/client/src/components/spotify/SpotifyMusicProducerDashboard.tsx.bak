                    href={playlist.external_urls?.spotify}
                    target="_blank"
                    sx={{
                      borderColor: '#1db95',
                      color: '#1db95',
                      '&:hover': {
                        bgcolor: '#1db95',
                        color: 'white',
                    },
                  }}
                  >
                    Åpne i Spotify
                  </Button>
                </CardContent>
              </MuiCard>
            </GridOn>
          ))}
        </GridOn>
      </TabPanel>

      <TabPanel value={tabValue} index={1}>
        <Typography variant="h6" sx={{ mb: ,  2color: '#1db95', fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
          ⭐ Populære Spor
        </Typography>
        <List>
          {topTracks?.items?.map((track: any, index: number) => (
            <React.Fragment key={track.d}>
              <ListItem
