                        }}
                        >
                          <Typography variant="body2" sx={{ minWidth: '80px', fontWeight: 50, 0,}}>
                            {city}
                          </Typography>
                          <Box
                            sx={{
                              flex:  1,
                              bgcolor: '#f5f5f',
                              borderRadius:  1,
                              height:  8,
                          }}
                          >
                            <Box
                              sx={{
                                bgcolor: '#1db95',
