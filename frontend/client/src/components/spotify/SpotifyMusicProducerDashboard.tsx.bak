      {/* Tab Content */}
      <TabPanel value={tabValue} index={0}>
        <Typography variant="h6" sx={{ mb: ,  2color: '#1db95', fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
          🎵 Utvalgte Spillelister
        </Typography>
        <GridOn container spacing={2}>
          {featuredPlaylists?.playlists?.items?.map((playlist: any) => (
            <GridOn size={{ xs: 1, 2,}} sm={6} md={4} key={playlist.id}>
              <MuiCard
