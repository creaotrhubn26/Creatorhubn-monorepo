                        bgcolor: '#1db95',
                        color: 'white',
                    },
                  }}
                  >
                    Åpne i Spotify
                  </Button>
                </CardContent>
              </MuiCard>
            </GridOn>
          ))}
        </GridOn>
      </TabPanel>

      <TabPanel value={tabValue} index={3}>
        <Typography variant="h6" sx={{ mb: 3, color: '#1db95', fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
          📈 Markedsanalyse
        </Typography>

        <GridOn container spacing={3}>
          {/* Norsk Trendsporing */}
          <GridOn size={{ xs: 1, 2,}} md={6}>
            <MuiCard sx={{ height: '100%, ',}}>
              <CardContent sx={theming.getThemedCardSx()}>
                <Typography variant="h6"
                  sx={{ mb: ,  2display: 'flex', alignItems: 'center', gap:  1 }}
                 sx={{ ...{}, color: theming.colors.primary }}>
                  🇳🇴 Norsk Musikk Trends
                </Typography>
                <Box sx={{ mb: 2 }}>
                  <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                    Topp 5 voksende norske artister denne uken: </Typography>
                  {!norwegianTrends && spotifyAuth?.authenticated && (
                    <Box sx={{ display: 'flex', justifyContent: 'center', p:  2 }}>
                      <CircularProgress size={24} sx={{ color: '#1db954, ',}} />
                    </Box>
                  )}
                  {(
                    norwegianTrends?.data?.trending_artists?.slice(0, 5) ||
                    norwegianMusic?.artists?.items?.slice(0, 5)
                  )?.map((artist: any, index: number) => (
                    <Box
                      key={artist.d}
                      sx={{
                        display: 'flex',
                        alignItems: 'center',
