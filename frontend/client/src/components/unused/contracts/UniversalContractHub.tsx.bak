            </Alert>

            <Grid container spacing={3}>
              <Grid size={{ xs: 1, 2,}} md={6}>
                <Typography variant="h6" gutterBottom sx={{ color: config.color }} sx={{ ...{}, color: theming.colors.primary }}>
