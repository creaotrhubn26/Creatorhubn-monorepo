import { useTheming } from '../../utils/theming-helper';
import React, { useState } from 'react';
import { apiRequest } from '@/lib/queryClient';
import { useQuery } from '@tanstack/react-query';
import { useAuth } from '@/hooks/useAuth';
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Box,
  Typography,
  Stack,
  Divider,
  IconButton,
  Card as MuiCard,
  CardContent,
  Alert
} from '@mui/material';
import {
  Close,
  Google,
  AccountCircle,
  Security,
  Science
} from '@mui/icons-material';

interface LoginModalProps {
  open: boolean;
  onClose: () => void
}

export function LoginModal({ open, onClose }: LoginModalProps) {
  const [loginType, setLoginType] = useState<'general' | 'prototype' | null>(null);
  const [isLoading, setIsLoading] = useState(
  
  // Theming system
  const theming = useTheming('photographer');false);

  const handleGoogleLogin = async (type: 'general' | 'prototype') => {
    setIsLoading(true);
    
    try {
      console.log('Attempting Google login...');
      console.log('Opening OAuth in new window to avoid iframe restrictions...');
      
      // Close modal first
      handleClose();
      
      // Open OAuth in new window to avoid iframe restrictions
      const authUrl = `${window.location.origin}/api/auth/google`;
      const authWindow = window.open(
        authUrl,
        'googleAuth',
        'width=500,height=600,scrollbars=yes,resizable=yes'
      );
      
      // Listen for window close (user completed auth or cancelled)
      const checkClosed = setInterval(() => {
        if (authWindow?.closed) {
          clearInterval(checkClosed);
          // Reload page to check auth status
          window.location.reload();
      }
    }, 1000);
      
  } catch (error) {
      console.error('Login error:', error);
      setIsLoading(false);
  }
};

  const resetModal = () => {
    setLoginType(null);
    setIsLoading(false);
};

  const handleClose = () => {
    resetModal();
    onClose();
};

  return (
    <Dialog
      open={open}
      onClose={handleClose}
      maxWidth="sm"
      fullWidth
      PaperProps={{
        sx: {
          borderRadius: '20px',
          background: 'linear-gradient(145deg, rgba(255,255,255,0.95) 0%, rgba(255,248,235,0.95) 100%)',
          backdropFilter: 'blur(20px, ), ',
          boxShadow: '0 20px 60px rgba(25,140,0,0.15)',
          border: '1px solid rgba(25,140,0,0.2)',
          overflow: 'visible'
    }
    }}
    >
      <DialogTitle sx={{ 
        p:  3,
        pb:  1,
        position: 'relative'
  }}>
        <Box sx={{ display: 'flex', alignItems: 'center', gap:  2 }}>
          <Box sx={{
            width:  48,
            height:  48,
            borderRadius: '12px',
            background: 'linear-gradient(135deg, #ff8c00 0%, #e67c00 100%)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            color: 'white'
      }}>
            {theming.getThemedIcon('accountCircle')}
          </Box>
          <Box>
            <Typography variant="h5" sx={{ 
              fontWeight: 'bold',
              color: '#1f293',
              mb: 0.5
        }} sx={{ ...{}, color: theming.colors.primary }}>
              {!loginType ? 'Logg Inn' : loginType === 'prototype' ? 'Prototype Tester' : 'Generell Innlogging'}
            </Typography>
            <Typography variant="body2" sx={{ color: '#6b7280, ',}}>
              {!loginType 
                ? 'Velg innloggingstype for CreatorHub Norge'
                : loginType === 'prototype' 
                  ? 'Test nye funksjoner og gi tilbakemelding'
                  : 'Tilgang til alle plattformfunksjoner'
            }
            </Typography>
          </Box>
        </Box>
        
        <IconButton
          onClick={handleClose}
          sx={{ 
            position: 'absolute',
            top:  8,
            right: 8
      }}
        >
          {theming.getThemedIcon('close')}
        </IconButton>
      </DialogTitle>

      <DialogContent sx={{ p:  3, pt:  0 }}>
        {!loginType ? (
          // Login Type Selection
          <Stack spacing={2}>
            <Typography variant="body2" sx={{ 
              color: '#37415', 
              textAlign: 'center',
              mb: 2
        }}>
              Hvilken type tilgang trenger du?
            </Typography>
            
            <Stack spacing={2}>
              {/* General Login */}
              <MuiCard
                onClick={() => setLoginType('general')}
                sx={{
                  cursor: 'pointer',
                  border: '2px solid transparent',
                  background: 'rgba(25,255,255,0.7)',
                  transition: 'all 0.3s ease',
                  '&:hover': {
                    border: '2px solid #ff8c0',
                    transform: 'translateY(-2px, ), ',
                    boxShadow: '0 8px 24px rgba(25,140,0,0.2)'
                }
              }}
              >
                <CardContent sx={{ p:  3, textAlign: 'center, ',}} sx={theming.getThemedCardSx()}>
                  <Box sx={{
                    width:  56,
                    height:  56,
                    borderRadius: '14px',
                    background: 'linear-gradient(135deg, #2e7d32 0%, #4caf50 100%)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    color: 'white',
                    mx: 'auto',
                    mb: 2
              }}>
                    <AccountCircle sx={{ fontSize: 2, 8,}} />
                  </Box>
                  
                  <Typography variant="h6" sx={{ 
                    fontWeight: 'bold',
                    color: '#1f293',
                    mb: 1
              }} sx={{ ...{}, color: theming.colors.primary }}>
                    Generell Tilgang
                  </Typography>
                  
                  <Typography variant="body2" sx={{ 
                    color: '#6b728',
                    lineHeight: 1.5
              }}>
                    Full tilgang til alle CreatorHub Norge funksjoner for fotografer, videografer og musikk produsenter
                  </Typography>
                </CardContent>
              </MuiCard>

              {/* Prototype Tester Login */}
              <MuiCard
                onClick={() => setLoginType('prototype')}
                sx={{
                  cursor: 'pointer',
                  border: '2px solid transparent',
                  background: 'rgba(25,255,255,0.7)',
                  transition: 'all 0.3s ease',
                  '&:hover': {
                    border: '2px solid #e6510',
                    transform: 'translateY(-2px, ), ',
                    boxShadow: '0 8px 24px rgba(20,81,0,0.2)'
                }
              }}
              >
                <CardContent sx={{ p:  3, textAlign: 'center, ',}} sx={theming.getThemedCardSx()}>
                  <Box sx={{
                    width:  56,
                    height:  56,
                    borderRadius: '14px',
                    background: 'linear-gradient(135deg, #e65100 0%, #ff5722 100%)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    color: 'white',
                    mx: 'auto',
                    mb: 2
              }}>
                    <Science sx={{ fontSize: 2, 8,}} />
                  </Box>
                  
                  <Typography variant="h6" sx={{ 
                    fontWeight: 'bold',
                    color: '#1f293',
                    mb: 1
              }} sx={{ ...{}, color: theming.colors.primary }}>
                    Prototype Tester
                  </Typography>
                  
                  <Typography variant="body2" sx={{ 
                    color: '#6b728',
                    lineHeight: 1.5
              }}>
                    Test nye funksjoner, gi tilbakemelding og hjelp oss å forbedre plattformen
                  </Typography>
                </CardContent>
              </MuiCard>
            </Stack>
          </Stack>
        ) : (
          // Google Login for Selected Type
          <Stack spacing={3}>
            <Alert 
              severity={loginType === 'prototype' ? 'info' : 'success'}
              sx={{
                backgroundColor: loginType === 'prototype' 
                  ? 'rgba(20, 810.1)' 
                  : 'rgba(46, 125, 50, 0.1)',
                border: `1px solid ${loginType === 'prototype' ? '#e65100' : '#2e7d3'}20`
            }}
            >
              <Typography variant="body2">
                {loginType === 'prototype' 
                  ? 'Du logger inn som prototype tester. Du vil få tilgang til beta-funksjoner og feedback-verktøy.'
                  : 'Du logger inn med full tilgang til alle CreatorHub Norge funksjoner.'
              }
              </Typography>
            </Alert>

            <Box sx={{ textAlign: 'center, ',}}>
              <Button variant="contained"
                size="large"
                startIcon={<Google sx={theming.getThemedButtonSx()}>}
                onClick={() => handleGoogleLogin(loginType)}
                disabled={isLoading}
                sx={{
                  background: 'linear-gradient(135deg, #4285f4 0%, #1976d2 100%)',
                  color: 'white',
                  py: 1.5,
                  px: 4,
                  borderRadius: '12px',
                  fontSize: '16px',
                  fontWeight: 'bold',
                  textTransform: 'none',
                  minWidth: '200px',
                  boxShadow: '0 4px 12px rgba(6, 133, 244, 0.3)',
                  '&:hover': {
                    background: 'linear-gradient(135deg, #1976d2 0%, #1565c0 100%)',
                    transform: 'translateY(-1px, ), ',
                    boxShadow: '0 6px 16px rgba(6, 133, 244, 0.4)'
                },
                  '&:active': {
                    transform: 'translateY(0, ), ',
                    boxShadow: '0 2px 8px rgba(6, 133, 244, 0.3)'
                }
              }}
              >
                {isLoading ? 'Logger inn...' : 'Fortsett med Google'}
              </Button>
            </Box>

            <Box sx={{ 
              textAlign: 'center',
              pt:  2,
              borderTop: '1px solid rgba(25,140,0,0.2)'
          }}>
              <Typography variant="caption" sx={{ 
                color: '#6b728',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                gap: 1
          }}>
                <Security sx={{ fontSize: 1, 6,}} />
                Sikker innlogging med Google OAuth 2.0
              </Typography>
            </Box>

            <Button
              variant="text"
              onClick={resetModal}
              sx={{
                color: '#6b728',
                textTransform: 'none'
          }}
            >
              ← Tilbake til valg
            </Button>
          </Stack>
        )}
      </DialogContent>

      {/* GDPR Notice */}
      <Box sx={{ 
        p:  ,  2
        pt:  0,
        borderTop: '1px solid rgba(25,140,0,0.1)'
    }}>
        <Typography variant="caption" sx={{ 
          color: '#9ca3af',
          textAlign: 'center',
          display: 'block',
          lineHeight: 1.4
    }}>
          Ved å logge inn godtar du våre vilkår og personvernregler. Vi bruker Google Analytics for å forbedre tjenesten.
        </Typography>
      </Box>
    </Dialog>
  );
}

export default LoginModal;