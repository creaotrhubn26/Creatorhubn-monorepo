// client/src/components/notes/NotesSidebar.tsx
import { useTheming } from '../../utils/theming-helper';
import React from 'react';
import type { NoteListItem } from './constants';

type Props = {
  notes: NoteListItem[];
  selectedId?: string;
  search: string;
  onSearchChange: (q: string) => void;
  onSelect: (id: string) => void;
  onCreate?: () => void;
  loading?: boolean;
  headerExtra?: React.ReactNode; // quick filters etc.
};

export default function NotesSidebar({
  notes,
  selectedId,
  search,
  onSearchChange,
  onSelect,
  onCreate,
  loading = false,
  headerExtra,
}: Props) {
  // Theming system
  const theming = useTheming('photographer');
  return (
    <aside
      style={{
        width: 320,
        borderRight: '1px solid rgba(0,0,0,0.08)',
        display: 'flex',
        flexDirection: 'column',
        height: '100%',
    }}
      aria-label="Notatliste"
    >
      <div style={{ padding: 12, display: 'flex', gap: 8, alignItems: 'center' }}>
        <input
          value={search}
          onChange={(e) => onSearchChange(e.target.value)}
          placeholder="Søk i notater…"
          aria-label="Søk"
          style={{
            flex: 1,
            padding: '8px 10px',
            borderRadius: 8,
            border: '1px solid rgba(0,0,0,0.15)',
        }}
        />
        {onCreate && (
          <button onClick={onCreate} style={createBtn} aria-label="Nytt notat">+ Ny</button>
        )}
      </div>

      {headerExtra && (
        <div style={{ padding: '0 12px 8px 12px' }}>{headerExtra}</div>
      )}

      <div style={{ overflow: 'auto' }} role="list" aria-busy={loading}>
        {loading ? (
          <SkeletonList />
        ) : notes.length === 0 ? (
          <div style={{ padding: 16, opacity: 0.7 }}>Ingen notater funnet.</div>
        ) : (
          notes.map((n) => (
            <button
              key={n.id}
              role="listitem"
              onClick={() => onSelect(n.id)}
              style={row(n.id === selectedId)}
              aria-current={n.id === selectedId ? 'true' : 'false'}
            >
              <div style={{ fontWeight: 600, fontSize: 14, marginBottom: 4 }}>
                {n.title || 'Uten tittel'}
              </div>
              <div style={{ fontSize: 12, opacity: 0.8 }}>
                {n.updatedAt ? new Date(n.updatedAt).toLocaleDateString() : '—'}
              </div>
              {n.tags && n.tags.length > 0 && (
                <div style={{ marginTop: 6, display: 'flex', gap: 6, flexWrap: 'wrap' }}>
                  {n.tags.map((t) => (
                    <span key={t} style={chip}>{t}</span>
                  ))}
                </div>
              )}
            </button>
          ))
        )}
      </div>
    </aside>
  );
}

function SkeletonList() {
  return (
    <div style={{ padding: 12 }}>
      {Array.from({ length: 8 }).map((_, i) => (
        <div key={i} style={{
          border: '1px solid rgba(0,0,0,0.08)',
          borderRadius: 10,
          padding: 12,
          marginBottom: 10,
          background: 'linear-gradient(90deg, #f5f5f5, #f0f0f0, #f5f5f5)',
          backgroundSize: '200% 100%',
          animation: 'shimmer 1.2s infinite',
      }}>
          <div style={{ height: 12, width: '60%', background: 'rgba(0,0,0,0.08)', borderRadius: 6, marginBottom: 8 }} />
          <div style={{ height: 10, width: '40%', background: 'rgba(0,0,0,0.06)', borderRadius: 6 }} />
        </div>
      ))}
      <style>{`
        @keyframes shimmer {
          0% { background-position: 200% 0; }
          100% { background-position: -200% 0; }
      }
      `}</style>
    </div>
  );
}

function row(active: boolean): React.CSSProperties {
  return {
    width: '100%',
    textAlign: 'left',
    padding: 12,
    border: '1px solid rgba(0,0,0,0.08)',
    borderRadius: 10,
    background: active ? 'rgba(37,99,235,0.09)' : '#fff',
    outline: 'none',
    cursor: 'pointer',
    margin: '0 12px 10px 12px',
};
}

const createBtn: React.CSSProperties = {
  cursor: 'pointer',
  padding: '8px 12px',
  borderRadius: 8,
  border: '1px solid rgba(0,0,0,0.1)',
  background: '#2563EB',
  color: '#fff',
};

const chip: React.CSSProperties = {
  fontSize: 11,
  padding: '2px 8px',
  borderRadius: 999,
  background: 'rgba(0,0,0,0.06)',
};
