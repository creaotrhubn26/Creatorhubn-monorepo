import React, { Suspense } from 'react';
const ReactQuill = React.lazy(() => import('react-quill'));

type Props = {
  value: string;
  onChange: (html: string) => void;
  modules: any;
  formats: string[];
};

export default function NoteEditor({ value, onChange, modules, formats }: Props) {
  return (
    <Suspense fallback={<div style={{padding:16}}>Laster editor…</div>}>
      <ReactQuill theme="snow" value={value} onChange={onChange} modules={modules} formats={formats} />
    </Suspense>
  );
}
