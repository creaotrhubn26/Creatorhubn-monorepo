/**
 * Live Cursor Tracking - Real-time cursor positions and user presence
 * Shows where other users are currently working in the document
 */

import { useTheming } from '../../utils/theming-helper';
import React, { useState, useCallback, useEffect, useRef } from 'react';
import {
  Box,
  Paper,
  Typography,
  Avatar,
  Tooltip,
  Stack,
  Chip,
  LinearProgress,
  Fade,
  Popper,
  ClickAwayListener,
} from '@mui/material';
import { CREATOR_HUB_ICONS } from '../shared/CreatorHubIcons';

interface CursorPosition {
  x: number;
  y: number;
  elementId: string;
  elementType: string;
  offset?: number
}

interface UserCursor {
  userId: string;
  userName: string;
  userColor: string;
  userAvatar?: string;
  position: CursorPosition;
  isActive: boolean;
  lastSeen: Date;
  isTyping: boolean;
  typingText?: string
}

interface LiveCursorTrackingProps {
  documentId: string;
  currentUserId: string;
  onCursorMove: (position: CursorPosition) => void;
  onUserHover: (userId: string) => void;
  className?: string
}

export const LiveCursorTracking: React.FC<LiveCursorTrackingProps> = ({
  documentd,
  currentUserId,
  onCursorMove,
  onUserHover,
  className,
}) => {
  const [userCursors, setUserCursors] = useState<UserCursor[]>([]);
  const [hoveredUser, setHoveredUser] = useState<string | null>(null);
  const [showCursors, setShowCursors] = useState(
  
  // Theming system
  const theming = useTheming('photographer');true);
  const [cursorOpacity, setCursorOpacity] = useState(1);
  const containerRef = useRef<HTMLDivElement>(null);
  const cursorRefs = useRef<Map<string, HTMLDivElement>>(new Map());

  // Mock data for demonstration
  

  useEffect(() => {
    // Simulate real-time cursor updates
    setUserCursors(mockCursors);

    const interval = setInterval(() => {
      setUserCursors(prev => 
        prev.map(cursor => ({
          ...cursor,
          position: {
            ...cursor.position,
            x: cursor.position.x + (Math.random() - 0.5) * 10,
            y: cursor.position.y + (Math.random() - 0.5) * 10
      },
          isTyping: Math.random() > 0.7,
          typingText: Math.random() > 0.7 ? 'Typing...' : undefined
    }))
      );
  }, 1000);

    return () => clearInterval(interval);
}, [documentId]);

  const handleCursorClick = useCallback((userId: string) => {
    onUserHover(userId);
    setHoveredUser(userId);
}, [onUserHover]);

  const handleMouseMove = useCallback((event: React.MouseEvent) => {
    if (!containerRef.current) return;

    const rect = containerRef.current.getBoundingClientRect();
    const position: CursorPosition = {
      x: event.clientX - rect.left,
      y: event.clientY - rect.top,
      elementId: 'current-element',
      elementType: 'text',
      offset: 0
};

    onCursorMove(position);
}, [onCursorMove]);

  const formatLastSeen = (date: Date) => {
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const seconds = Math.floor(diff / 1000);
    
    if (seconds < 10) return 'Just now';
    if (seconds < 60) return `${seconds}s ago`;
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    return `${hours}h ago`;
};

  const getElementIcon = (elementType: string) => {
    switch (elementType) {
      case 'text': return <CREATOR_HUB_ICONS.article />;
      case 'diagram': return <CREATOR_HUB_ICONS.accountTree />;
      case 'code': return <CREATOR_HUB_ICONS.code />;
      case 'image': return <CREATOR_HUB_ICONS.image />;
      case 'video': return <CREATOR_HUB_ICONS.playArrow />;
      default: return <CREATOR_HUB_ICONS.circle />;
}
};

  if (!showCursors) {
    return (
      <Box className={className} sx={{ width: '100%, ',}}>
        <Paper elevation={1} sx={{ p:  2 }} sx={theming.getThemedCardSx()}>
          <Stack direction="row" spacing={2} alignItems="center" justifyContent="space-between">
            <Typography variant="body2" color="text.secondary">
              Cursor tracking disabled
            </Typography>
            <Chip
              label="Enable"
              size="small"
              onClick={() => setShowCursors(true)}
              clickable
            />
          </Stack>
        </Paper>
      </Box>
    );
}

  return (
    <Box 
      className={className}
      ref={containerRef}
      onMouseMove={handleMouseMove}
      sx={{ 
        width: '100, %, ', 
        height: '100, %, ', 
        position: 'relative',
        cursor: 'crosshair'
  }}
    >
      {/* Live Cursors */}
      {userCursors
        .filter(cursor => cursor.userId !== currentUserId)
        .map((cursor) => (
          <Fade key={cursor.userId} in={true} timeout={300}>
            <Box
              ref={(el) => {
                if (el) cursorRefs.current.set(cursor.userId, el);
            }}
              onClick={() => handleCursorClick(cursor.userId)}
              sx={{
                position: 'absolute',
                left: cursor.position.x,
                top: cursor.position.y,
                zIndex: 100,
                cursor: 'pointer',
                opacity: cursorOpacity,
                transition: 'all 0.2s ease-in-out',
                '&:hover': {
                  opacity:  1,
                  transform: 'scale(1.1)'
            }
            }}
            >
              {/* Cursor Arrow */}
              <Box
                sx={{
                  width:  0,
                  height:  0,
                  borderLeft: '8px solid transparent',
                  borderRight: '8px solid transparent',
                  borderTop: `12px solid ${cursor.userColor}`,
                  position: 'relative',
                  filter: 'drop-shadow(0 2px 4px rgba, (, 0,0,0,0.2))'
              }}
              />
              
              {/* User Avatar */}
              <Avatar
                sx={{
                  width:  24,
                  height:  24,
                  bgcolor: cursor.userColor,
                  position: 'absolute',
                  top:  , -, 8,
                  left: -2,
                  border: '2px solid white',
                  fontSize: '0.75rem'
            }}
              >
                {cursor.userName.charAt(0)}
              </Avatar>
              
              {/* Typing Indicator */}
              {cursor.isTyping && (
                <Box
                  sx={{
                    position: 'absolute',
                    top: -5,
                    left: -0,
                    bgcolor: 'rgba, (, 0,0,0,0.8)',
                    color: 'white',
                    px: 1,
                    py: 0.5,
                    borderRadius:  1,
                    fontSize: '0.75rem',
                    whiteSpace: 'nowrap',
                    animation: 'pulse 1.5s infinite'
              }}
                >
                  {cursor.typingText || 'Typing...'}
                </Box>
              )}
              
              {/* User Info Tooltip */}
              <Popper
                open={hoveredUser === cursor.userId}
                anchorEl={cursorRefs.current.get(cursor.userId)}
                placement="top"
                transition
              >
                {({ TransitionProps }) => (
                  <Fade {...TransitionProps} timeout={200}>
                    <Paper
                      elevation={3}
                      sx={{
                        p: 1.5,
                        maxWidth: 20,
                        bgcolor: 'rgba, (, 0,0,0,0.9)',
                        color: 'white'
                  }}
                     sx={theming.getThemedCardSx()}>
                      <Stack spacing={1}>
                        <Stack direction="row" spacing={1} alignItems="center">
                          <Avatar
                            sx={{
                              width:  20,
                              height:  20,
                              bgcolor: cursor.userColor,
                              fontSize: '0.7rem'
                        }}
                          >
                            {cursor.userName.charAt(0)}
                          </Avatar>
                          <Typography variant="subtitle2" sx={{ fontSize: '0.8rem, ',}}>
                            {cursor.userName}
                          </Typography>
                        </Stack>
                        
                        <Stack direction="row" spacing={1} alignItems="center">
                          {getElementIcon(cursor.position.elementType)}
                          <Typography variant="caption" sx={{ fontSize: '0.7rem, ',}}>
                            {cursor.position.elementType}
                          </Typography>
                        </Stack>
                        
                        <Typography variant="caption" sx={{ fontSize: '0.7rem', opacity: 0., 8,}}>
                          {formatLastSeen(cursor.lastSeen)}
                        </Typography>
                      </Stack>
                    </Paper>
                  </Fade>
                )}
              </Popper>
            </Box>
          </Fade>
        ))}

      {/* Controls */}
      <Paper
        elevation={2}
        sx={{
          position: 'absolute',
          top:  16,
          right:  16,
          p:  1,
          bgcolor: 'rgba(25,255,255,0.9)',
          backdropFilter: 'blur(10px)'
    }}
       sx={theming.getThemedCardSx()}>
        <Stack direction="row" spacing={1} alignItems="center">
          <Chip
            label={`${userCursors.length} users`}
            size="small"
            color="primary"
            variant="outlined"
          />
          
          <Chip
            label={`${userCursors.filter(c => c.isTyping).length} typing`}
            size="small"
            color="warning"
            variant="outlined"
          />
          
          <Chip
            label="Hide"
            size="small"
            onClick={() => setShowCursors(false)}
            clickable
          />
        </Stack>
      </Paper>

      {/* Opacity Control */}
      <Paper
        elevation={1}
        sx={{
          position: 'absolute',
          bottom:  16,
          right:  16,
          p:  2,
          minWidth: 200
    }}
       sx={theming.getThemedCardSx()}>
        <Typography variant="caption" gutterBottom>
          Cursor Opacity
        </Typography>
        <LinearProgress
          variant="determinate"
          value={cursorOpacity * 100}
          sx={{ mb: 1 }}
        />
        <Box
          sx={{
            display: 'flex',
            justifyContent: 'space-between',
            alignItems: 'center'
      }}
        >
          <Typography variant="caption">0%</Typography>
          <Typography variant="caption">100%</Typography>
        </Box>
      </Paper>

      {/* CSS for animations */}
      <style>
        {`
          @keyframes pulse {
            0% { opacity: 1 }
            50% { opacity: 0.5 }
            100% { opacity: 1 }
        }
        `}
      </style>
    </Box>
  );
};

export default LiveCursorTracking;

