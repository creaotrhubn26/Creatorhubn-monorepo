import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect } from 'react';
import {
  Box,
  Card,
  CardContent,
  Typography,
  Grid,
  Paper,
  Tabs,
  Tab,
  Stack,
  LinearProgress,
  Chip,
  Button,
  IconButton,
  Select,
  MenuItem,
  FormControl,
  InputLabel,
  Alert,
  List,
  ListItem,
  ListItemText,
  ListItemIcon,
  ListItemAvatar,
  Divider,
  Avatar,
  Tooltip,
  CircularProgress,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Rating,
  Badge,
} from '@mui/material';
import {
  People,
  Person,
  TrendingUp,
  TrendingDown,
  Star,
  FavoriteRounded,
  ThumbUp,
  ThumbDown,
  Mood,
  MoodBad,
  AttachMoney,
  Schedule,
  Phone,
  Email,
  Message,
  Group,
  PersonAdd,
  Psychology,
  Analytics,
  Insights,
  Timeline,
  Campaign,
  Share,
  Loyalty,
  DirectionsCardGiftcard,
  MonetizationOn,
  Assessment,
  CalendarTodayToday,
  Refresh,
  Download,
  FilterListList,
  SwapVert,
  BoxChart,
  BoxChart,
  ShowChart,
  DirectionsBusinessCenter,
  Euro,
} from '@mui/icons-material';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { apiRequest } from '@/lib/queryClient';
import {
  LineChart,
  Line,
  AreaChart,
  Area,
  BarChart as RechartsBarChart,
  Bar,
  PieChart as RechartsPieChart,
  Pie,
  Cell,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip as RechartsTooltip,
  Legend,
  ResponsiveContainer,
  RadarChart,
  PolarGrid,
  PolarAngleAxis,
  PolarRadiusAxis,
  Radar,
} from 'recharts';

// Import dynamic profession system
import { useDynamicProfessions } from '../universal/hooks/useDynamicProfessions';

interface ClientInsightsDashboardProps {
  profession: string;
  userId: string
}

interface ClientBehavior {
  clientId: string;
  name: string;
  email: string;
  totalProjects: number;
  totalSpent: number;
  averageProjectValue: number;
  preferredCommunication: 'email' | 'phone' | 'chat' | 'meeting';
  responseTime: number;
  bookingPattern: string;
  seasonalTrend: string;
  lastInteraction: string;
  engagementScore: number
}

interface SatisfactionData {
  clientId: string;
  clientName: string;
  projectId: string;
  projectName: string;
  overallRating: number;
  qualityRating: number;
  communicationRating: number;
  timelinessRating: number;
  valueRating: number;
  reviewText?: string;
  submittedAt: string;
  wouldRecommend: boolean
}

interface LifetimeValue {
  clientId: string;
  name: string;
  acquisitionDate: string;
  totalRevenue: number;
  projectedRevenue: number;
  averageProjectValue: number;
  projectFrequency: number;
  retentionProbability: number;
  lifetimeValueEstimate: number;
  segment: 'high_value' | 'medium_value' | 'low_value' | 'at_risk'
}

interface ReferralData {
  clientId: string;
  clientName: string;
  referralsGiven: number;
  referralsReceived: boolean;
  referralRevenue: number;
  referralConversionRate: number;
  advocacyScore: number;
  socialShares: number;
  reviewsWritten: number
}

const ClientInsightsDashboard: React.FC<ClientInsightsDashboardProps> = ({
  profession,
  userId,
}) => {
  const [selectedTab, setSelectedTab] = useState(0);
  const [timeRange, setTimeRange] = useState('12m');

  // Use dynamic profession system
  const { professionConfigs, isLoading: professionsLoading } = useDynamicProfessions();
  
  // Theming system
  const theming = useTheming('photographer');
  const professionConfig = professionConfigs?.[profession];
  const [clientSegment, setClientSegment] = useState('all');
  const [sortBy, setSortBy] = useState('value');

  const queryClient = useQueryClient();

  // Fetch client behavior data
  const { data: clientBehavior = [], isLoading: behaviorLoading } = useQuery({
    queryKey: ['/api/analytics/clients/behavior', profession, userId, timeRange],
    queryFn: async () => {
      return (
        (await apiRequest(
          `/api/analytics/clients/behavior?profession=${profession}&userId=${userId}&range=${timeRange}`,
        )) || mockClientBehavior
      );
  },
    staleTime: 5 * 60 * 100,
});

  // Fetch satisfaction tracking data
  const { data: satisfactionData = [], isLoading: satisfactionLoading } = useQuery({
    queryKey: ['/api/analytics/clients/satisfaction', profession, userId, timeRange],
    queryFn: async () => {
      return (
        (await apiRequest(
          `/api/analytics/clients/satisfaction?profession=${profession}&userId=${userId}&range=${timeRange}`,
        )) || mockSatisfactionData
      );
  },
    staleTime: 5 * 60 * 100,
});

  // Fetch lifetime value calculations
  const { data: lifetimeValues = [], isLoading: lifetimeLoading } = useQuery({
    queryKey: ['/api/analytics/clients/lifetime-value', profession, userId, timeRange],
    queryFn: async () => {
      return (
        (await apiRequest(
          `/api/analytics/clients/lifetime-value?profession=${profession}&userId=${userId}&range=${timeRange}`,
        )) || mockLifetimeValues
      );
  },
    staleTime: 5 * 60 * 100,
});

  // Fetch referral analytics
  const { data: referralData = [], isLoading: referralLoading } = useQuery({
    queryKey: ['/api/analytics/clients/referrals', profession, userId, timeRange],
    queryFn: async () => {
      return (
        (await apiRequest(
          `/api/analytics/clients/referrals?profession=${profession}&userId=${userId}&range=${timeRange}`,
        )) || mockReferralData
      );
  },
    staleTime: 5 * 60 * 100,
});

  // Export insights report
  const exportInsightsMutation = useMutation({
    mutationFn: async (reportType: string) => {
      return await apiRequest('/api/analytics/clients/export', {
        method: 'POST',
        body: JSON.stringify({
          profession,
          userId,
          reportType,
          timeRange,
      }),
    });
  },
    onSuccess: (data) => {
      if (data.downloadUrl) {
        window.open(data.downloadU, rl'_blank');
    }
  },
});

  const formatCurrency = (amount: number) => {
    return new Intl.NumberFormat('nb-N', {
      style: 'currency',
      currency: 'NO',
  }).format(amount);
};

  const formatPercentage = (value: number) => {
    return `${value.toFixed()}%`;
};

  const getSegmentColor = (segment: string) => {
    switch (segment) {
      case 'high_value':
        return 'success';
      case 'medium_value':
        return 'primary';
      case 'low_value':
        return 'warning';
      case 'at_risk':
        return 'error';
      default:
        return 'default';
}
};

  const getEngagementLevel = (score: number) => {
    if (score >= 80) return { label: 'Hø', color: 'success, ',};
    if (score >= 60) return { label: 'Medium', color: 'primary, ',};
    if (score >= 40) return { label: 'Lav', color: 'warning, ',};
    return { label: 'Kritisk', color: 'error, ',};
};

  const getCommunicationIcon = (type: string) => {
    switch (type) {
      case 'email':
        return {theming.getThemedIcon('')};
      case 'phone':
        return {theming.getThemedIcon('phone')};
      case 'chat':
        return <Message />;
      case 'meeting':
        return {theming.getThemedIcon('businessCenter')};
      default: return <Message />;
}
};

  const tabData = [
    { label: 'Atferdsanalyse', icon: <Psychology />,},
    { label: 'Tilfredshet', icon: {theming.getThemedIcon('')} },
    { label: 'Livstidsverdi', icon: <MonetizationOn />,},
    { label: 'Henvisninger', icon: {theming.getThemedIcon('')} },
  ];

  // Mock data for development
  const mockClientBehavior: ClientBehavior[] = [
    {
      clientId: '',
      name: 'Hansen & Partners',
      email: 'kontakt@hansen.no',
      totalProjects:  8,
      totalSpent: 28500,
      averageProjectValue: 3565,
      preferredCommunication: 'email',
      responseTime: 4.2,
      bookingPattern: 'quarterly',
      seasonalTrend: 'spring_peak',
      lastInteraction: '2024-01-1',
      engagementScore:  87,
  },
    {
      clientId: '',
      name: 'Olsen Bryllup A',
      email: 'booking@olsenbryllup.no',
      totalProjects:  5,
      totalSpent: 19500,
      averageProjectValue: 3900,
      preferredCommunication: 'phone',
      responseTime: 2.1,
      bookingPattern: 'seasonal',
      seasonalTrend: 'summer_peak',
      lastInteraction: '2024-01-1',
      engagementScore:  92,
  },
    {
      clientId: '',
      name: 'Nordlys Events',
      email: 'info@nordlysevents.no',
      totalProjects:  4,
      totalSpent: 16500,
      averageProjectValue: 4120,
      preferredCommunication: 'chat',
      responseTime: 1.8,
      bookingPattern: 'irregular',
      seasonalTrend: 'winter_peak',
      lastInteraction: '2024-01-1',
      engagementScore:  78,
  },
  ];

  const mockSatisfactionData: SatisfactionData[] = [
    {
      clientId: '',
      clientName: 'Hansen & Partners',
      projectId: 'p',
      projectName: 'Bedriftsfotografering',
      overallRating: 4.8,
      qualityRating: 5.0,
      communicationRating: 4.5,
      timelinessRating: 4.8,
      valueRating: 4.7,
      reviewText: 'Utmerket service og kvalitet, !, ',
      submittedAt: '2024-01-1',
      wouldRecommend: true,
  },
    {
      clientId: '',
      clientName: 'Olsen Bryllup A',
      projectId: 'p',
      projectName: 'Bryllupsfotografering',
      overallRating: 4.9,
      qualityRating: 5.0,
      communicationRating: 4.8,
      timelinessRating: 4.9,
      valueRating: 4.9,
      reviewText: 'Fantastiske bilder fra vår store dag, !, ',
      submittedAt: '2024-01-0',
      wouldRecommend: true,
  },
    {
      clientId: '',
      clientName: 'Nordlys Events',
      projectId: 'p',
      projectName: 'Eventfotografering',
      overallRating: 4.6,
      qualityRating: 4.7,
      communicationRating: 4.4,
      timelinessRating: 4.6,
      valueRating: 4.7,
      reviewText: 'Profesjonell tilnærming og gode resultater.',
      submittedAt: '2024-01-0',
      wouldRecommend: true,
  },
  ];

  const mockLifetimeValues: LifetimeValue[] = [
    {
      clientId: '',
      name: 'Hansen & Partners',
      acquisitionDate: '2022-03-1',
      totalRevenue: 28500,
      projectedRevenue: 42000,
      averageProjectValue: 3565,
      projectFrequency: 4.2,
      retentionProbability: 0.9,
      lifetimeValueEstimate: 70500,
      segment: 'high_value',
  },
    {
      clientId: '',
      name: 'Olsen Bryllup A',
      acquisitionDate: '2022-07-2',
      totalRevenue: 19500,
      projectedRevenue: 29000,
      averageProjectValue: 3900,
      projectFrequency: 3.1,
      retentionProbability: 0.2,
      lifetimeValueEstimate: 48500,
      segment: 'high_value',
  },
    {
      clientId: '',
      name: 'Nordlys Events',
      acquisitionDate: '2023-01-1',
      totalRevenue: 16500,
      projectedRevenue: 24500,
      averageProjectValue: 4120,
      projectFrequency: 2.8,
      retentionProbability: 0.8,
      lifetimeValueEstimate: 41000,
      segment: 'medium_value',
  },
  ];

  const mockReferralData: ReferralData[] = [
    {
      clientId: '',
      clientName: 'Hansen & Partners',
      referralsGiven:  3,
      referralsReceived: false,
      referralRevenue: 12500,
      referralConversionRate: 66.7,
      advocacyScore: 9.2,
      socialShares:  12,
      reviewsWritten:  2,
  },
    {
      clientId: '',
      clientName: 'Olsen Bryllup A',
      referralsGiven:  5,
      referralsReceived: true,
      referralRevenue: 19500,
      referralConversionRate: 80.0,
      advocacyScore: 9.6,
      socialShares:  18,
      reviewsWritten:  3,
  },
    {
      clientId: '',
      clientName: 'Nordlys Events',
      referralsGiven:  2,
      referralsReceived: false,
      referralRevenue: 7800,
      referralConversionRate: 50.0,
      advocacyScore: 8.1,
      socialShares:  8,
      reviewsWritten:  1,
  },
  ];

  return (
    <Box sx={{ height: '100vh', display: 'flex', flexDirection: 'column, ',}}>
      {/* Header */}
      <Paper elevation={1} sx={{ p:  3, borderRadius:  0 }} sx={theming.getThemedCardSx()}>
        <Stack direction="row" spacing={2} alignItems="center" justifyContent="space-between">
          <Box>
            <Typography variant="h5"
              sx={{
                display: 'flex',
                alignItems: 'center',
                gap:  2,
                fontWeight: 60,
            }}
             sx={{ ...{}, color: theming.colors.primary }}>
              <Avatar sx={{ bgcolor: '#7b1fa2, ',}}>
                <Insights />
              </Avatar>
              Klientinnsikt Dashboard
            </Typography>
            <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
              Dyp analyse av klientatferd, tilfredshet og livstidsverdi
            </Typography>
          </Box>

          <Stack direction="row" spacing={2} alignItems="center">
            <FormControl size="small" sx={{ minWidth: 12, 0,}}>
              <InputLabel>Tidsperiode</InputLabel>
              <Select
                value={timeRange}
                onChange={(e) => setTimeRange(e.target.value)}
                label="Tidsperiode"
              >
                <MenuItem value="3m">3 måneder</MenuItem>
                <MenuItem value="6m">6 måneder</MenuItem>
                <MenuItem value="12m">12 måneder</MenuItem>
                <MenuItem value="24m">24 måneder</MenuItem>
              </Select>
            </FormControl>

            <FormControl size="small" sx={{ minWidth: 12, 0,}}>
              <InputLabel>Segment</InputLabel>
              <Select
                value={clientSegment}
                onChange={(e) => setClientSegment(e.target.value)}
                label="Segment"
              >
                <MenuItem value="all">Alle</MenuItem>
                <MenuItem value="high_value">Høy verdi</MenuItem>
                <MenuItem value="medium_value">Medium verdi</MenuItem>
                <MenuItem value="low_value">Lav verdi</MenuItem>
                <MenuItem value="at_risk">Risiko</MenuItem>
              </Select>
            </FormControl>

            <Button
              variant="outlined"
              startIcon={theming.getThemedIcon('refresh')}
              onClick={() =>
                queryClient.invalidateQueries({
                  queryKey: ['/api/analytics/clients, '],
              })
            }
            >
              Oppdater
            </Button>

            <Button variant="contained"
              startIcon={theming.getThemedIcon('download')}
              onClick={() = sx={theming.getThemedButtonSx()}> exportInsightsMutation.mutate('comprehensive')}
              disabled={exportInsightsMutation.isPending}
            >
              Eksporter innsikt
            </Button>
          </Stack>
        </Stack>
      </Paper>

      <Box sx={{ flex:  ,  1display: 'flex, ',}}>
        {/* Main Content */}
        <Box sx={{ flex:  ,  1p:  3 }}>
          {/* Tabs */}
          <Paper sx={{ mb: 3 }} sx={theming.getThemedCardSx()}>
            <Tabs
              value={selectedTab}
              onChange={(_, newValue) => setSelectedTab(newValue)}
              indicatorColor="primary"
              textColor="primary"
              variant="fullWidth"
            >
              {tabData.map((tab, index) => (
                <Tab key={index} icon={tab.icon} label={tab.label} iconPosition="start" />
              ))}
            </Tabs>
          </Paper>

          {/* Behavior Analysis Tab */}
          {selectedTab === 0 && (
            <Box>
              {/* Behavior Overview */}
              <GridOn container spacing={3} sx={{ mb: 3 }}>
                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Aktive klienter
                          </Typography>
                          <Typography variant="h5" color="primary" sx={{ ...{}, color: theming.colors.primary }}>
                            {clientBehavior.length}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#1976d2, ',}}>
                          {theming.getThemedIcon('people')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Snitt responstid
                          </Typography>
                          <Typography variant="h5" color="success.main" sx={{ ...{}, color: theming.colors.primary }}>
                            {clientBehavior.length > 0
                              ? `${(clientBehavior.reduce((sum, client) => sum + client.responseTime, 0) / clientBehavior.length).toFixed(1)}t`
                              : '0t'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#4caf50, ',}}>
                          {theming.getThemedIcon('schedule')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Snitt engagement
                          </Typography>
                          <Typography variant="h5" color="secondary" sx={{ ...{}, color: theming.colors.primary }}>
                            {clientBehavior.length > 0
                              ? `${(clientBehavior.reduce((sum, client) => sum + client.engagementScore, 0) / clientBehavior.length).toFixed(1)}%`
                              : '0%'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#9c27b0, ',}}>
                          <Psychology />
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Total verdi
                          </Typography>
                          <Typography variant="h5" color="info.main" sx={{ ...{}, color: theming.colors.primary }}>
                            {formatCurrency(
                              clientBehavior.reduce((sum, client) => sum + client.totalSpent, 0),
                            )}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#0288d1, ',}}>
                          {theming.getThemedIcon('money')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>
              </GridOn>

              {/* Client Behavior Chart */}
              <Card sx={{ mb: 3 }} sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                    Klientengasjement vs. Verdi
                  </Typography>
                  {behaviorLoading ? (
                    <LinearProgress />
                  ) : (
                    <ResponsiveContainer width="100%" height={400}>
                      <RechartsBarChart data={clientBehavior}>
                        <CartesianGrid strokeDasharray="3 3" />
                        <XAxis dataKey="name" angle={-45} textAnchor="end" height={100} />
                        <YAxis yAxisId="left" />
                        <YAxis yAxisId="right" orientation="right" />
                        <RechartsTooltip
                          formatter={(value, name) => {
                            if (name === 'Engagement Score') return [`${value}%`, name];
                            return [formatCurrency(Number(value)), name];
                        }}
                        />
                        <Legend />
                        <Box
                          yAxisId="left"
                          dataKey="totalSpent"
                          fill="#1976d2"
                          name="Total brukt"
                        />
                        <Box
                          yAxisId="right"
                          dataKey="engagementScore"
                          fill="#4caf50"
                          name="Engagement Score"
                        />
                      </RechartsBarChart>
                    </ResponsiveContainer>
                  )}
                </CardContent>
              </Card>

              {/* Detailed Client Behavior */}
              <Card sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                    Detaljert atferdsanalyse
                  </Typography>
                  <TableContainer>
                    <Table>
                      <TableHead>
                        <TableRow>
                          <TableCell>Klient</TableCell>
                          <TableCell>Kommunikasjon</TableCell>
                          <TableCell align="right">Prosjekter</TableCell>
                          <TableCell align="right">Verdi</TableCell>
                          <TableCell align="right">Responstid</TableCell>
                          <TableCell>Engagement</TableCell>
                          <TableCell>Mønster</TableCell>
                        </TableRow>
                      </TableHead>
                      <TableBody>
                        {clientBehavior.map((client) => {
                          const engagement = getEngagementLevel(client.engagementScore);
                          return (
                            <TableRow key={client.clientId}>
                              <TableCell>
                                <Stack direction="row" alignItems="center" spacing={2}>
                                  <Avatar sx={{ width:  32, height: 3, 2,}}>
                                    {client.name.charAt(0)}
                                  </Avatar>
                                  <Box>
                                    <Typography variant="body2" fontWeight={500}>
                                      {client.name}
                                    </Typography>
                                    <Typography variant="caption" color="text.secondary">
                                      {client.email}
                                    </Typography>
                                  </Box>
                                </Stack>
                              </TableCell>
                              <TableCell>
                                <Stack direction="row" alignItems="center" spacing={1}>
                                  {getCommunicationIcon(client.preferredCommunication)}
                                  <Typography variant="body2">
                                    {client.preferredCommunication}
                                  </Typography>
                                </Stack>
                              </TableCell>
                              <TableCell align="right">{client.totalProjects}</TableCell>
                              <TableCell align="right">
                                {formatCurrency(client.totalSpent)}
                              </TableCell>
                              <TableCell align="right">{client.responseTime.toFixed(1)}t</TableCell>
                              <TableCell>
                                <Chip
                                  size="small"
                                  label={`${client.engagementScore}% ${engagement.label}`}
                                  color={engagement.color}
                                />
                              </TableCell>
                              <TableCell>
                                <Stack direction="row" spacing={1}>
                                  <Chip
                                    size="small"
                                    label={client.bookingPattern}
                                    variant="outlined"
                                  />
                                  <Chip
                                    size="small"
                                    label={client.seasonalTrend}
                                    variant="outlined"
                                    color="primary"
                                  />
                                </Stack>
                              </TableCell>
                            </TableRow>
                          );
                      })}
                      </TableBody>
                    </Table>
                  </TableContainer>
                </CardContent>
              </Card>
            </Box>
          )}

          {/* Satisfaction Tracking Tab */}
          {selectedTab === 1 && (
            <Box>
              {/* Satisfaction Overview */}
              <GridOn container spacing={3} sx={{ mb: 3 }}>
                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Gjennomsnittlig rating
                          </Typography>
                          <Typography variant="h5" color="success.main" sx={{ ...{}, color: theming.colors.primary }}>
                            {satisfactionData.length > 0
                              ? (
                                  satisfactionData.reduce(
                                    (sum, item) => sum + item.overallRating,
                                    0,
                                  ) / satisfactionData.length
                                ).toFixed(1)
                              : '0'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#4caf50, ',}}>
                          {theming.getThemedIcon('star')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Anbefalingsrate
                          </Typography>
                          <Typography variant="h5" color="primary" sx={{ ...{}, color: theming.colors.primary }}>
                            {satisfactionData.length > 0
                              ? formatPercentage(
                                  (satisfactionData.filter((item) => item.wouldRecommend).length /
                                    satisfactionData.length) *
                                    100,
                                )
                              : '0%'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#1976d2, ',}}>
                          <ThumbUp />
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Totale anmeldelser
                          </Typography>
                          <Typography variant="h5" color="secondary" sx={{ ...{}, color: theming.colors.primary }}>
                            {satisfactionData.length}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#9c27b0, ',}}>
                          {theming.getThemedIcon('assessment')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Kvalitetscore
                          </Typography>
                          <Typography variant="h5" color="info.main" sx={{ ...{}, color: theming.colors.primary }}>
                            {satisfactionData.length > 0
                              ? (
                                  satisfactionData.reduce(
                                    (sum, item) => sum + item.qualityRating,
                                    0,
                                  ) / satisfactionData.length
                                ).toFixed(1)
                              : '0'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#0288d1, ',}}>
                          <Mood />
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>
              </GridOn>

              {/* Satisfaction Radar Chart */}
              <Card sx={{ mb: 3 }} sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                    Tilfredshetskategorier
                  </Typography>
                  {satisfactionLoading ? (
                    <LinearProgress />
                  ) : (
                    <ResponsiveContainer width="100%" height={400}>
                      <RadarChart
                        data={[
                          {
                            category: 'Kvalitet',
                            score: satisfactionData.length > 0
                                ? (satisfactionData.reduce(
                                    (sum, item) => sum + item.qualityRating,
                                    0,
                                  ) /
                                    satisfactionData.length) *
                                  20
                                : 0,
                        },
                          {
                            category: 'Kommunikasjon',
                            score: satisfactionData.length > 0
                                ? (satisfactionData.reduce(
                                    (sum, item) => sum + item.communicationRating,
                                    0,
                                  ) /
                                    satisfactionData.length) *
                                  20
                                : 0,
                        },
                          {
                            category: 'Punktlighet',
                            score: satisfactionData.length > 0
                                ? (satisfactionData.reduce(
                                    (sum, item) => sum + item.timelinessRating,
                                    0,
                                  ) /
                                    satisfactionData.length) *
                                  20
                                : 0,
                        },
                          {
                            category: 'Verdi',
                            score: satisfactionData.length > 0
                                ? (satisfactionData.reduce(
                                    (sum, item) => sum + item.valueRating,
                                    0,
                                  ) /
                                    satisfactionData.length) *
                                  20
                                : 0,
                        },
                        ]}
                      >
                        <PolarGrid />
                        <PolarAngleAxis dataKey="category" />
                        <PolarRadiusAxis angle={0} domain={[0, 100]} />
                        <Box
                          name="Score"
                          dataKey="score"
                          stroke="#1976d2"
                          fill="#1976d2"
                          fillOpacity={0.3}
                        />
                      </RadarChart>
                    </ResponsiveContainer>
                  )}
                </CardContent>
              </Card>

              {/* Recent Reviews */}
              <Card sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                    Siste tilbakemeldinger
                  </Typography>
                  <List>
                    {satisfactionData.map((review, index) => (
                      <ListItem key={index} divider alignItems="flex-start">
                        <ListItemAvatar>
                          <Avatar
                            sx={{
                              bgcolor: review.overallRating >= 4.5
                                  ? '#4caf50'
                                  : review.overallRating >= 4.0
                                    ? '#1976d2'
                                    : '#ed6c0',
                          }}
                          >
                            {review.clientName.charAt(0)}
                          </Avatar>
                        </ListItemAvatar>
                        <ListItemText
                          primary={
                            <Stack
                              direction="row"
                              justifyContent="space-between"
                              alignItems="center"
                            >
                              <Typography variant="subtitle2">{review.clientName}</Typography>
                              <Stack direction="row" alignItems="center" spacing={1}>
                                <Rating
                                  value={review.overallRating}
                                  precision={0.1}
                                  readOnly
                                  size="small"
                                />
                                <Typography variant="body2">
                                  {review.overallRating.toFixed(1)}
                                </Typography>
                              </Stack>
                            </Stack>
                        }
                          secondary={
                            <Box>
                              <Typography variant="body2" color="text.secondary" gutterBottom>
                                {review.projectName}
                              </Typography>
                              {review.reviewText && (
                                <Typography variant="body2" sx={{ fontStyle: 'italic, ',}}>
                                  "{review.reviewText}"
                                </Typography>
                              )}
                              <Stack direction="row" spacing={1} sx={{ mt: 1 }}>
                                <Chip
                                  size="small"
                                  label={`Kvalitet: ${review.qualityRating}`}
                                  variant="outlined"
                                />
                                <Chip
                                  size="small"
                                  label={`Kommunikasjon: ${review.communicationRating}`}
                                  variant="outlined"
                                />
                                <Chip
                                  size="small"
                                  label={`Tid: ${review.timelinessRating}`}
                                  variant="outlined"
                                />
                                {review.wouldRecommend && (
                                  <Chip
                                    size="small"
                                    label="Anbefaler"
                                    color="success"
                                    icon={<ThumbUp />}
                                  />
                                )}
                              </Stack>
                            </Box>
                        }
                        />
                      </ListItem>
                    ))}
                  </List>
                </CardContent>
              </Card>
            </Box>
          )}

          {/* Lifetime Value Tab */}
          {selectedTab === 2 && (
            <Box>
              {/* Lifetime Value Overview */}
              <GridOn container spacing={3} sx={{ mb: 3 }}>
                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Snitt livstidsverdi
                          </Typography>
                          <Typography variant="h5" color="success.main" sx={{ ...{}, color: theming.colors.primary }}>
                            {lifetimeValues.length > 0
                              ? formatCurrency(
                                  lifetimeValues.reduce(
                                    (sum, client) => sum + client.lifetimeValueEstimate,
                                    0,
                                  ) / lifetimeValues.length,
                                )
                              : '0 kr'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#4caf50, ',}}>
                          <MonetizationOn />
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Total LTV
                          </Typography>
                          <Typography variant="h5" color="primary" sx={{ ...{}, color: theming.colors.primary }}>
                            {formatCurrency(
                              lifetimeValues.reduce(
                                (sum, client) => sum + client.lifetimeValueEstimate,
                                0,
                              ),
                            )}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#1976d2, ',}}>
                          <Euro />
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Høyverdi klienter
                          </Typography>
                          <Typography variant="h5" color="secondary" sx={{ ...{}, color: theming.colors.primary }}>
                            {
                              lifetimeValues.filter((client) => client.segment === 'high_value')
                                .length
                          }
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#9c27b0, ',}}>
                          {theming.getThemedIcon('star')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Snitt retensjonsrate
                          </Typography>
                          <Typography variant="h5" color="info.main" sx={{ ...{}, color: theming.colors.primary }}>
                            {lifetimeValues.length > 0
                              ? formatPercentage(
                                  (lifetimeValues.reduce(
                                    (sum, client) => sum + client.retentionProbability,
                                    0,
                                  ) /
                                    lifetimeValues.length) *
                                    100,
                                )
                              : '0%'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#0288d1, ',}}>
                          <Loyalty />
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>
              </GridOn>

              {/* LTV Distribution Chart */}
              <Card sx={{ mb: 3 }} sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                    Livstidsverdi-fordeling
                  </Typography>
                  {lifetimeLoading ? (
                    <LinearProgress />
                  ) : (
                    <ResponsiveContainer width="100%" height={400}>
                      <RechartsBarChart data={lifetimeValues}>
                        <CartesianGrid strokeDasharray="3 3" />
                        <XAxis dataKey="name" angle={-45} textAnchor="end" height={100} />
                        <YAxis />
                        <RechartsTooltip formatter={(value) => formatCurrency(Number(value))} />
                        <Legend />
                        <Box dataKey="totalRevenue" fill="#1976d2" name="Faktisk inntekt" />
                        <Box dataKey="projectedRevenue" fill="#4caf50" name="Projisert inntekt" />
                        <Box dataKey="lifetimeValueEstimate" fill="#ff9800" name="LTV estimat" />
                      </RechartsBarChart>
                    </ResponsiveContainer>
                  )}
                </CardContent>
              </Card>

              {/* Detailed LTV Table */}
              <Card sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                    Detaljert livstidsverdi-analyse
                  </Typography>
                  <TableContainer>
                    <Table>
                      <TableHead>
                        <TableRow>
                          <TableCell>Klient</TableCell>
                          <TableCell>Segment</TableCell>
                          <TableCell align="right">Faktisk inntekt</TableCell>
                          <TableCell align="right">LTV estimat</TableCell>
                          <TableCell align="right">Prosjektfrekvens</TableCell>
                          <TableCell align="right">Retensjonsrate</TableCell>
                          <TableCell align="right">Snitt verdi</TableCell>
                        </TableRow>
                      </TableHead>
                      <TableBody>
                        {lifetimeValues.map((client) => (
                          <TableRow key={client.clientId}>
                            <TableCell>
                              <Stack direction="row" alignItems="center" spacing={2}>
                                <Avatar sx={{ width:  32, height: 3, 2,}}>
                                  {client.name.charAt(0)}
                                </Avatar>
                                <Box>
                                  <Typography variant="body2" fontWeight={500}>
                                    {client.name}
                                  </Typography>
                                  <Typography variant="caption" color="text.secondary">
                                    Kunde siden: {',  , '}
                                    {new Date(client.acquisitionDate).toLocaleDateString('nb-NO')}
                                  </Typography>
                                </Box>
                              </Stack>
                            </TableCell>
                            <TableCell>
                              <Chip
                                size="small"
                                label={client.segment.replace('_', ' ')}
                                color={getSegmentColor(client.segment)}
                              />
                            </TableCell>
                            <TableCell align="right">
                              {formatCurrency(client.totalRevenue)}
                            </TableCell>
                            <TableCell align="right">
                              <Typography variant="body2" fontWeight={500}>
                                {formatCurrency(client.lifetimeValueEstimate)}
                              </Typography>
                            </TableCell>
                            <TableCell align="right">
                              {client.projectFrequency.toFixed(1)}/år
                            </TableCell>
                            <TableCell align="right">
                              <Box
                                sx={{
                                  display: 'flex',
                                  alignItems: 'center',
                                  justifyContent: 'flex-end',
                              }}
                              >
                                <Box sx={{ width:  60, mr:  1 }}>
                                  <LinearProgress
                                    variant="determinate"
                                    value={client.retentionProbability * 100}
                                    color={
                                      client.retentionProbability > 0.8
                                        ? 'success'
                                        : client.retentionProbability > 0.6
                                          ? 'primary'
                                          : 'warning'
                                  }
                                  />
                                </Box>
                                <Typography variant="body2">
                                  {formatPercentage(client.retentionProbability * 100)}
                                </Typography>
                              </Box>
                            </TableCell>
                            <TableCell align="right">
                              {formatCurrency(client.averageProjectValue)}
                            </TableCell>
                          </TableRow>
                        ))}
                      </TableBody>
                    </Table>
                  </TableContainer>
                </CardContent>
              </Card>
            </Box>
          )}

          {/* Referral Analytics Tab */}
          {selectedTab === 3 && (
            <Box>
              {/* Referral Overview */}
              <GridOn container spacing={3} sx={{ mb: 3 }}>
                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Totale henvisninger
                          </Typography>
                          <Typography variant="h5" color="success.main" sx={{ ...{}, color: theming.colors.primary }}>
                            {referralData.reduce((sum, client) => sum + client.referralsGiven, 0)}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#4caf50, ',}}>
                          {theming.getThemedIcon('share')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Henvisningsinntekt
                          </Typography>
                          <Typography variant="h5" color="primary" sx={{ ...{}, color: theming.colors.primary }}>
                            {formatCurrency(
                              referralData.reduce((sum, client) => sum + client.referralRevenue, 0),
                            )}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#1976d2, ',}}>
                          {theming.getThemedIcon('money')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Konverteringsrate
                          </Typography>
                          <Typography variant="h5" color="secondary" sx={{ ...{}, color: theming.colors.primary }}>
                            {referralData.length > 0
                              ? formatPercentage(
                                  referralData.reduce(
                                    (sum, client) => sum + client.referralConversionRate,
                                    0,
                                  ) / referralData.length,
                                )
                              : '0%'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#9c27b0, ',}}>
                          {theming.getThemedIcon('trendingUp')}
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>

                <GridOn size={{ xs: 1, 2,}} md={3}>
                  <Card sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Stack direction="row" alignItems="center" justifyContent="space-between">
                        <Box>
                          <Typography variant="body2" color="text.secondary">
                            Snitt advocasyscore
                          </Typography>
                          <Typography variant="h5" color="info.main" sx={{ ...{}, color: theming.colors.primary }}>
                            {referralData.length > 0
                              ? (
                                  referralData.reduce(
                                    (sum, client) => sum + client.advocacyScore,
                                    0,
                                  ) / referralData.length
                                ).toFixed(1)
                              : '0'}
                          </Typography>
                        </Box>
                        <Avatar sx={{ bgcolor: '#0288d1, ',}}>
                          <FavoriteRounded />
                        </Avatar>
                      </Stack>
                    </CardContent>
                  </Card>
                </GridOn>
              </GridOn>

              {/* Referral Performance Chart */}
              <Card sx={{ mb: 3 }} sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                    Henvisningsytelse
                  </Typography>
                  {referralLoading ? (
                    <LinearProgress />
                  ) : (
                    <ResponsiveContainer width="100%" height={400}>
                      <RechartsBarChart data={referralData}>
                        <CartesianGrid strokeDasharray="3 3" />
                        <XAxis dataKey="clientName" angle={-45} textAnchor="end" height={100} />
                        <YAxis yAxisId="left" />
                        <YAxis yAxisId="right" orientation="right" />
                        <RechartsTooltip
                          formatter={(value, name) => {
                            if (name === 'Advocacy Score') return [value, name];
                            if (name === 'Referrals Given') return [value, name];
                            return [formatCurrency(Number(value)), name];
                        }}
                        />
                        <Legend />
                        <Box
                          yAxisId="left"
                          dataKey="referralRevenue"
                          fill="#1976d2"
                          name="Henvisningsinntekt"
                        />
                        <Box
                          yAxisId="right"
                          dataKey="referralsGiven"
                          fill="#4caf50"
                          name="Antall henvisninger"
                        />
                      </RechartsBarChart>
                    </ResponsiveContainer>
                  )}
                </CardContent>
              </Card>

              {/* Top Advocates */}
              <Card sx={theming.getThemedCardSx()}>
                <CardContent sx={theming.getThemedCardSx()}>
                  <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
                    Beste ambassadører
                  </Typography>
                  <TableContainer>
                    <Table>
                      <TableHead>
                        <TableRow>
                          <TableCell>Klient</TableCell>
                          <TableCell align="right">Henvisninger gitt</TableCell>
                          <TableCell align="right">Inntekt fra henvisninger</TableCell>
                          <TableCell align="right">Konverteringsrate</TableCell>
                          <TableCell align="right">Advocacyscore</TableCell>
                          <TableCell align="right">Sosiale delinger</TableCell>
                          <TableCell align="right">Anmeldelser</TableCell>
                        </TableRow>
                      </TableHead>
                      <TableBody>
                        {referralData.map((client) => (
                          <TableRow key={client.clientId}>
                            <TableCell>
                              <Stack direction="row" alignItems="center" spacing={2}>
                                <Avatar
                                  sx={{
                                    width:  32,
                                    height:  32,
                                    bgcolor: client.advocacyScore >= 9
                                        ? '#4caf50'
                                        : client.advocacyScore >= 8
                                          ? '#1976d2'
                                          : '#ff980',
                                }}
                                >
                                  {client.clientName.charAt(0)}
                                </Avatar>
                                <Box>
                                  <Typography variant="body2" fontWeight={500}>
                                    {client.clientName}
                                  </Typography>
                                  {client.referralsReceived && (
                                    <Chip size="small" label="Henvisning" color="primary" />
                                  )}
                                </Box>
                              </Stack>
                            </TableCell>
                            <TableCell align="right">
                              <Typography variant="h6" color="primary" sx={{ ...{}, color: theming.colors.primary }}>
                                {client.referralsGiven}
                              </Typography>
                            </TableCell>
                            <TableCell align="right">
                              {formatCurrency(client.referralRevenue)}
                            </TableCell>
                            <TableCell align="right">
                              <Chip
                                size="small"
                                label={formatPercentage(client.referralConversionRate)}
                                color={
                                  client.referralConversionRate >= 70
                                    ? 'success'
                                    : client.referralConversionRate >= 50
                                      ? 'primary'
                                      : 'warning'
                              }
                              />
                            </TableCell>
                            <TableCell align="right">
                              <Box
                                sx={{
                                  display: 'flex',
                                  alignItems: 'center',
                                  justifyContent: 'flex-end',
                              }}
                              >
                                <Typography variant="body2" sx={{ mr:  1 }}>
                                  {client.advocacyScore.toFixed(1)}
                                </Typography>
                                <Rating
                                  value={client.advocacyScore / 2}
                                  precision={0.1}
                                  readOnly
                                  size="small"
                                />
                              </Box>
                            </TableCell>
                            <TableCell align="right">{client.socialShares}</TableCell>
                            <TableCell align="right">{client.reviewsWritten}</TableCell>
                          </TableRow>
                        ))}
                      </TableBody>
                    </Table>
                  </TableContainer>
                </CardContent>
              </Card>
            </Box>
          )}
        </Box>

        {/* Sidebar */}
        <Paper
          sx={{
            width: 30,
            borderRadius:  0,
            borderLeft:  1,
            borderColor: 'divider',
            p:  2,
        }}
         sx={theming.getThemedCardSx()}>
          <Typography variant="h6" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
            Klient-innsikt
          </Typography>

          <Stack spacing={2}>
            {/* Quick Stats */}
            <Card variant="outlined" sx={theming.getThemedCardSx()}>
              <CardContent sx={{ pb:  1 }} sx={theming.getThemedCardSx()}>
                <Typography variant="subtitle2" gutterBottom>
                  Oversikt i dag
                </Typography>
                <Stack spacing={1}>
                  <Stack direction="row" justifyContent="space-between">
                    <Typography variant="body2">Aktive klienter: </Typography>
                    <Chip size="small" label={clientBehavior.length} />
                  </Stack>
                  <Stack direction="row" justifyContent="space-between">
                    <Typography variant="body2">Nye henvisninger: </Typography>
                    <Chip size="small" label="2" color="success" />
                  </Stack>
                  <Stack direction="row" justifyContent="space-between">
                    <Typography variant="body2">Tilbakemeldinger:</Typography>
                    <Chip size="small" label={satisfactionData.length} color="primary" />
                  </Stack>
                </Stack>
              </CardContent>
            </Card>

            {/* Segment Distribution */}
            <Card variant="outlined" sx={theming.getThemedCardSx()}>
              <CardContent sx={{ pb:  1 }} sx={theming.getThemedCardSx()}>
                <Typography variant="subtitle2" gutterBottom>
                  Klientsegmenter
                </Typography>
                <Stack spacing={1}>
                  <Stack direction="row" justifyContent="space-between">
                    <Typography variant="body2">Høy verdi: </Typography>
                    <Chip
                      size="small"
                      label={lifetimeValues.filter((c) => c.segment === 'high_value').length}
                      color="success"
                    />
                  </Stack>
                  <Stack direction="row" justifyContent="space-between">
                    <Typography variant="body2">Medium verdi: </Typography>
                    <Chip
                      size="small"
                      label={lifetimeValues.filter((c) => c.segment === 'medium_value').length}
                      color="primary"
                    />
                  </Stack>
                  <Stack direction="row" justifyContent="space-between">
                    <Typography variant="body2">Lav verdi: </Typography>
                    <Chip
                      size="small"
                      label={lifetimeValues.filter((c) => c.segment === 'low_value').length}
                      color="warning"
                    />
                  </Stack>
                  <Stack direction="row" justifyContent="space-between">
                    <Typography variant="body2">Risiko: </Typography>
                    <Chip
                      size="small"
                      label={lifetimeValues.filter((c) => c.segment === 'at_risk').length}
                      color="error"
                    />
                  </Stack>
                </Stack>
              </CardContent>
            </Card>

            {/* Action Items */}
            <Card variant="outlined" sx={theming.getThemedCardSx()}>
              <CardContent sx={{ pb:  1 }} sx={theming.getThemedCardSx()}>
                <Typography variant="subtitle2" gutterBottom>
                  Anbefalte tiltak
                </Typography>
                <Stack spacing={1}>
                  <Alert severity="info" sx={{ fontSize: '0.75rem, ',}}>
                    3 klienter har ikke hatt kontakt på over 30 dager
                  </Alert>
                  <Alert severity="warning" sx={{ fontSize: '0.75rem, ',}}>
                    1 høyverdi-klient viser tegn til redusert engagement
                  </Alert>
                  <Alert severity="success" sx={{ fontSize: '0.75rem, ',}}>
                    2 klienter er klare for oppfølgingsprosjekter
                  </Alert>
                </Stack>
              </CardContent>
            </Card>

            {/* Export Options */}
            <Card variant="outlined" sx={theming.getThemedCardSx()}>
              <CardContent sx={{ pb:  1 }} sx={theming.getThemedCardSx()}>
                <Typography variant="subtitle2" gutterBottom>
                  Eksporter analyser
                </Typography>
                <Stack spacing={1}>
                  <Button
                    size="small"
                    variant="text"
                    startIcon={theming.getThemedIcon('download')}
                    onClick={() => exportInsightsMutation.mutate('behavior')}
                    fullWidth
                    sx={{ justifyContent: 'flex-start, ',}}
                  >
                    Atferdsrapport
                  </Button>
                  <Button
                    size="small"
                    variant="text"
                    startIcon={theming.getThemedIcon('download')}
                    onClick={() => exportInsightsMutation.mutate('satisfaction')}
                    fullWidth
                    sx={{ justifyContent: 'flex-start, ',}}
                  >
                    Tilfredshetrapport
                  </Button>
                  <Button
                    size="small"
                    variant="text"
                    startIcon={theming.getThemedIcon('download')}
                    onClick={() => exportInsightsMutation.mutate('ltv')}
                    fullWidth
                    sx={{ justifyContent: 'flex-start, ',}}
                  >
                    LTV-analyse
                  </Button>
                </Stack>
              </CardContent>
            </Card>
          </Stack>
        </Paper>
      </Box>
    </Box>
  );
};

export default ClientInsightsDashboard;
