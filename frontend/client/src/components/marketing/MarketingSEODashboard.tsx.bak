                      +24 nye denne måneden
                    </Typography>
                  </Box>
                  <Box
                    sx={{
                      bgcolor: 'rgba(25,255,255,0.15)',
                      borderRadius:  2,
                      p: 2.5,
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                  }}
