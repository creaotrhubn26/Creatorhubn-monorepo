                  </Box>
                </Box>
              </CardContent>
            </MuiCard>
          </GridOn>
        </GridOn>

        {/* Google Indexing Quick Actions */}
        <GridOn container spacing={2} sx={{ mb: 3 }}>
          <GridOn size={{ xs: 1, 2,}}>
            <MuiCard>
              <CardHeader title="Google Indeksering"
