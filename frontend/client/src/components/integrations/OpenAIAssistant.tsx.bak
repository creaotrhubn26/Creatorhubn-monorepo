/**
 * OpenAI Assistant - Intelligent Codebase Assistant
 * 
 * Features:
 * - @ mentions to reference files
 * - Smart prompt suggestions based on project
 * - Code templates for common tasks
 * - Context-aware AI responses
 * - Project-specific recommendations
 */

import React, { useState, useRef, useEffect } from 'react';
import { 
  Box, 
  Card, 
  CardContent, 
  Typography, 
  Button, 
  TextField, 
  CircularProgress,
  Paper,
  Avatar,
  Chip,
  List,
  ListItem,
  ListItemText,
  Popper,
  ClickAwayListener,
  Tabs,
  Tab,
  Grid,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  Divider,
} from '@mui/material';
import { 
  Send as SendIcon,
  SmartToy as AIIcon,
  Person as PersonIcon,
  AttachFile as FileIcon,
  Code as CodeIcon,
  Lightbulb as IdeaIcon,
  AutoAwesome as MagicIcon,
  ExpandMore as ExpandIcon,
  BugReport as BugIcon,
  Speed as OptimizeIcon,
  Security as SecurityIcon,
  Build as BuildIcon,
} from '@mui/icons-material';
import useOpenAIApi from '@/hooks/useOpenAIApi';
import { apiRequest } from '@/lib/queryClient';

interface Message {
  role: 'system' | 'user' | 'assistant';
  content: string;
  files?: AttachedFile[];
}

interface AttachedFile {
  path: string;
  content: string;
}

interface PromptTemplate {
  id: string;
  title: string;
  description: string;
  prompt: string;
  category: 'debug' | 'refactor' | 'optimize' | 'security' | 'feature' | 'test';
  icon: React.ReactNode;
  files?: string[];
}

export const OpenAIAssistant: React.FC = () => {
  const { chat, isChatting } = useOpenAIApi();
  const [input, setInput] = useState('');
  const [messages, setMessages] = useState<Message[]>([]);
  const [attachedFiles, setAttachedFiles] = useState<AttachedFile[]>([]);
  const [showFileSuggestions, setShowFileSuggestions] = useState(false);
  const [fileSuggestions, setFileSuggestions] = useState<string[]>([]);
  const [cursorPosition, setCursorPosition] = useState(0);
  const [activeTab, setActiveTab] = useState(0);
  const [isLoadingContext, setIsLoadingContext] = useState(true);
  const inputRef = useRef<HTMLTextAreaElement>(null);
  const anchorRef = useRef<HTMLDivElement>(null);
  
  // Load enhanced system prompt with codebase context
  useEffect(() => {
    const loadCodebaseContext = async () => {
      try {
        setIsLoadingContext(true);
        
        // Get enhanced system prompt from backend
        const response = await apiRequest('/api/ai/context/system-prompt');
        
        if (response.success && response.systemPrompt) {
          setMessages([{
            role: 'system',
            content: response.systemPrompt
        }]);
          console.log('✅ Loaded codebase context for OpenAI');
      } else {
          // Fallback to basic prompt
          setMessages([{
            role: 'system',
            content: 'You are a helpful AI assistant for CreatorHub Norge.'
        }]);
      }
    } catch (error) {
        console.error('Failed to load codebase context:', error);
        // Fallback prompt
        setMessages([{
          role: 'system',
          content: 'You are a helpful AI assistant.'
      }]);
    } finally {
        setIsLoadingContext(false);
    }
  };

    loadCodebaseContext();
}, []);

  // Smart Prompt Templates for CreatorHub Norge
  const promptTemplates: PromptTemplate[] = [
    {
      id: 'debug-component',
      title: 'Debug React Component',
      description: 'Find and fix issues in a React component',
      category: 'debug',
      icon: <BugIcon />,
      prompt: 'Analyze this component for bugs, performance issues, and potential improvements. Check for:\n- React anti-patterns\n- Memory leaks\n- Unnecessary re-renders\n- Type safety issues\n- Missing error handling',
  },
    {
      id: 'refactor-material-ui',
      title: 'Convert to Material-UI',
      description: 'Refactor component to use Material-UI',
      category: 'refactor',
      icon: <BuildIcon />,
      prompt: 'Convert this component to use Material-UI components following CreatorHub Norge patterns:\n- Use Material-UI components (Box, Card, Typography, etc.)\n- Apply theming with useTheming hook\n- Follow existing design system\n- Maintain all functionality',
  },
    {
      id: 'add-master-integration',
      title: 'Add Master Integration',
      description: 'Connect to EnhancedMasterIntegrationProvider',
      category: 'feature',
      icon: <MagicIcon />,
      prompt: 'Integrate this component with EnhancedMasterIntegrationProvider:\n- Add useEnhancedMasterIntegration hook\n- Register component with componentRegistry\n- Set up communication listeners\n- Implement data flow synchronization\n- Add broadcast events for key actions',
  },
    {
      id: 'create-api-integration',
      title: 'Create API Integration',
      description: 'Generate service, routes, and hooks for new API',
      category: 'feature',
      icon: <CodeIcon />,
      prompt: 'Help me create a complete API integration:\n1. Design the service wrapper structure\n2. Create Express routes with error handling\n3. Build React Query hooks\n4. Generate TypeScript types\n5. Add to auto-generation templates',
  },
    {
      id: 'optimize-performance',
      title: 'Optimize Performance',
      description: 'Improve component performance',
      category: 'optimize',
      icon: <OptimizeIcon />,
      prompt: 'Optimize this code for performance:\n- Add useMemo/useCallback where needed\n- Reduce bundle size\n- Lazy load heavy components\n- Optimize re-renders\n- Add code splitting if applicable',
  },
    {
      id: 'security-review',
      title: 'Security Review',
      description: 'Check for security vulnerabilities',
      category: 'security',
      icon: <SecurityIcon />,
      prompt: 'Review this code for security issues:\n- Check for XSS vulnerabilities\n- Validate input/output\n- Review authentication/authorization\n- Check for SQL injection risks\n- Audit API key handling',
  },
    {
      id: 'add-visual-editor-support',
      title: 'Add to Visual Editor',
      description: 'Make component work with Visual Editor',
      category: 'feature',
      icon: <MagicIcon />,
      prompt: 'Make this component compatible with CreatorhubVisualEditorRefactored:\n- Add drag-and-drop support\n- Implement selection broadcasting\n- Add property panel integration\n- Enable real-time updates\n- Support multi-select operations',
  },
    {
      id: 'database-integration',
      title: 'Add Database Integration',
      description: 'Connect to PostgreSQL with Drizzle',
      category: 'feature',
      icon: <CodeIcon />,
      prompt: 'Add database integration using Drizzle ORM:\n- Design schema in database-persistence-schema.ts\n- Create CRUD methods in storage.ts\n- Add API routes\n- Implement frontend hooks\n- Add real-time sync if needed',
  },
  ];

  // Project-specific suggestions based on context
  const getSmartSuggestions = (): string[] => {
    const recentTopics = messages.slice(-3).map(m => m.content.toLowerCase());
    const suggestions: string[] = [];

    // Analyze recent conversation
    if (recentTopics.some(t => t.includes('error') || t.includes('bug'))) {
      suggestions.push('🐛 How do I debug this issue with Chrome DevTools?');
      suggestions.push('🔍 What are common causes of this error in React?');
  }

    if (recentTopics.some(t => t.includes('performance') || t.includes('slow'))) {
      suggestions.push('⚡ How can I optimize re-renders in this component?');
      suggestions.push('📊 What profiling tools should I use?');
  }

    if (recentTopics.some(t => t.includes('visual editor'))) {
      suggestions.push('🎨 How do I add a new component to the Visual Editor?');
      suggestions.push('🔗 How does the Visual Editor broadcast events?');
  }

    // Default suggestions
    if (suggestions.length === 0) {
      suggestions.push('💡 Show me best practices for this codebase');
      suggestions.push('🚀 How do I create a new feature?');
      suggestions.push('🔧 Help me refactor this code');
      suggestions.push('📚 Explain how the Master Integration works');
  }

    return suggestions;
};

  // Detect @ mentions and show file suggestions
  useEffect(() => {
    const lastWord = input.slice(0, cursorPosition).split(/\s/).pop() || '';
    
    if (lastWord.startsWith('@')) {
      const searchTerm = lastWord.slice(1);
      searchFiles(searchTerm);
  } else {
      setShowFileSuggestions(false);
  }
}, [input, cursorPosition]);

  // Search for files in the codebase
  const searchFiles = async (query: string) => {
    if (!query) {
      setFileSuggestions([]);
      setShowFileSuggestions(false);
      return;
  }

    try {
      const response = await apiRequest(`/api/admin/files/search?query=${encodeURIComponent(query)}`);
      const files = response.files || [];
      setFileSuggestions(files.slice(0, 10));
      setShowFileSuggestions(files.length > 0);
  } catch (error) {
      console.error('File search error:', error);
      setShowFileSuggestions(false);
  }
};

  // Handle file selection from suggestions
  const handleFileSelect = async (filePath: string) => {
    try {
      // Get file content
      const fileResponse = await apiRequest(`/api/admin/files/read?path=${encodeURIComponent(filePath)}`);
      const fileContent = fileResponse.content || '';

      // Get enhanced file context (imports, relationships, analysis)
      const contextResponse = await apiRequest('/api/ai/context/files', {
        method: 'POST',
        body: JSON.stringify({ files: [filePath] })
    });

      const enhancedContent = contextResponse.fileContext || fileContent;

      const newFile: AttachedFile = {
        path: filePath,
        content: enhancedContent, // ← Now includes full context!
    };
      setAttachedFiles([...attachedFiles, newFile]);

      const lastAtIndex = input.lastIndexOf('@');
      const beforeAt = input.slice(0, lastAtIndex);
      const afterMention = input.slice(cursorPosition);
      setInput(`${beforeAt}@${filePath.split('/').pop()} ${afterMention}`);
      
      setShowFileSuggestions(false);
      
      console.log('✅ Attached file with enhanced context:', filePath);
  } catch (error) {
      console.error('Error reading file:', error);
  }
};

  // Apply prompt template
  const applyTemplate = (template: PromptTemplate) => {
    setInput(template.prompt);
    setActiveTab(0); // Switch to chat tab
};

  // Apply smart suggestion
  const applySuggestion = (suggestion: string) => {
    setInput(suggestion.replace(/^[🐛🔍⚡📊🎨🔗💡🚀🔧📚]\s*/, ''));
};

  // Remove attached file
  const handleRemoveFile = (index: number) => {
    setAttachedFiles(attachedFiles.filter((_, i) => i !== index));
};

  // Build context-aware message
  const buildMessageWithContext = (): string => {
    if (attachedFiles.length === 0) {
      return input;
  }

    let contextMessage = input + '\n\n---\n\n**Attached Files:**\n\n';
    
    attachedFiles.forEach((file, index) => {
      contextMessage += `### File ${index + 1}: \`${file.path}\`\n\n`;
      contextMessage += '```typescript\n';
      contextMessage += file.content;
      contextMessage += '\n```\n\n';
  });

    return contextMessage;
};

  const handleSend = () => {
    if (!input.trim()) return;

    const userMessage: Message = { 
      role: 'user', 
      content: input,
      files: attachedFiles.length > 0 ? [...attachedFiles] : undefined
  };
    
    const newMessages = [...messages, userMessage];
    setMessages(newMessages);
    setInput('');
    setAttachedFiles([]);

    const messagesToSend = newMessages.map(m => ({
      role: m.role,
      content: m.files && m.files.length > 0 ? buildContextForMessage(m) : m.content
  }));

    chat({ 
      messages: messagesToSend as any,
      model: 'gpt-4'
  }, {
      onSuccess: (data: any) => {
        const assistantMessage: Message = {
          role: 'assistant',
          content: data.data?.choices?.[0]?.message?.content || 'No response'
      };
        setMessages([...newMessages, assistantMessage]);
    },
      onError: (error: any) => {
        const errorMessage: Message = {
          role: 'assistant',
          content: `Error: ${error.message || 'Failed to get response'}`
      };
        setMessages([...newMessages, errorMessage]);
    }
  });
};

  const buildContextForMessage = (message: Message): string => {
    if (!message.files || message.files.length === 0) {
      return message.content;
  }

    let content = message.content + '\n\n---\n\n**Attached Files:**\n\n';
    message.files.forEach((file, index) => {
      content += `### File ${index + 1}: \`${file.path}\`\n\n`;
      content += '```typescript\n';
      content += file.content;
      content += '\n```\n\n';
  });

    return content;
};

  const handleKeyPress = (e: React.KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
  }
};

  const handleInputChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
    setInput(e.target.value);
    setCursorPosition(e.target.selectionStart || 0);
};

  const smartSuggestions = getSmartSuggestions();

  return (
    <Card sx={{ maxWidth: 1200, mx: 'auto', mt: 2 }}>
      <CardContent>
        {/* Header */}
        <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 3 }}>
          <AIIcon sx={{ fontSize: 32, color: 'primary.main' }} />
          <Typography variant="h5" component="h2">
            AI Assistant
          </Typography>
          <Chip label="@ Files" size="small" color="primary" icon={<FileIcon />} />
          <Chip label="Smart Prompts" size="small" color="secondary" icon={<IdeaIcon />} />
          <Chip label="CreatorHub Expert" size="small" color="success" sx={{ ml: 'auto' }} />
        </Box>

        {/* Tabs */}
        <Tabs value={activeTab} onChange={(_, v) => setActiveTab(v)} sx={{ mb: 2 }}>
          <Tab label="Chat" />
          <Tab label="Prompt Templates" />
          <Tab label="Smart Suggestions" />
        </Tabs>

        {/* Chat Tab */}
        {activeTab === 0 && (
          <>
            {/* Loading Context Indicator */}
            {isLoadingContext && (
              <Paper sx={{ p: 2, mb: 2, bgcolor: 'warning.light', display: 'flex', alignItems: 'center', gap: 1 }}>
                <CircularProgress size={16} />
                <Typography variant="body2" sx={{ color: 'warning.contrastText' }}>
                  🧠 Loading codebase context... AI is learning about your project
                </Typography>
              </Paper>
            )}

            {/* Context Loaded */}
            {!isLoadingContext && (
              <Paper sx={{ p: 2, mb: 2, bgcolor: 'success.light' }}>
                <Typography variant="body2" sx={{ color: 'success.contrastText' }}>
                  ✅ <strong>AI is ready!</strong> I understand your CreatorHub Norge codebase. Type <code>@filename</code> to attach files!
                </Typography>
              </Paper>
            )}

            {/* Instructions */}
            <Paper sx={{ p: 2, mb: 2, bgcolor: 'info.light' }}>
              <Typography variant="body2" sx={{ color: 'info.contrastText' }}>
                💡 <strong>Tip:</strong> Type <code>@filename</code> to attach files, or use templates for common tasks!
              </Typography>
            </Paper>

            {/* Chat Messages */}
            <Paper sx={{ p: 2, mb: 2, maxHeight: 400, overflowY: 'auto', bgcolor: 'grey.50' }}>
              {messages
                .filter(msg => msg.role !== 'system')
                .map((msg, i) => (
                  <Box 
                    key={i} 
                    sx={{ 
                      display: 'flex', 
                      gap: 1, 
                      mb: 2,
                      flexDirection: msg.role === 'user' ? 'row-reverse' : 'row'
                  }}
                  >
                    <Avatar 
                      sx={{ 
                        bgcolor: msg.role === 'user' ? 'primary.main' : 'secondary.main',
                        width: 32,
                        height: 32
                    }}
                    >
                      {msg.role === 'user' ? <PersonIcon /> : <AIIcon />}
                    </Avatar>
                    <Box sx={{ maxWidth: '70%' }}>
                      <Paper sx={{ p: 1.5, bgcolor: msg.role === 'user' ? 'primary.light' : 'white' }}>
                        <Typography 
                          variant="body2"
                          sx={{ 
                            color: msg.role === 'user' ? 'primary.contrastText' : 'text.primary',
                            whiteSpace: 'pre-wrap'
                        }}
                        >
                          {msg.content}
                        </Typography>
                      </Paper>
                      
                      {msg.files && msg.files.length > 0 && (
                        <Box sx={{ mt: 1, display: 'flex', gap: 0.5, flexWrap: 'wrap' }}>
                          {msg.files.map((file, idx) => (
                            <Chip
                              key={idx}
                              icon={<CodeIcon />}
                              label={file.path.split('/').pop()}
                              size="small"
                            />
                          ))}
                        </Box>
                      )}
                    </Box>
                  </Box>
                ))}

              {isChatting && (
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                  <CircularProgress size={20} />
                  <Typography variant="caption" color="text.secondary">
                    AI is analyzing your code...
                  </Typography>
                </Box>
              )}
            </Paper>

            {/* Attached Files */}
            {attachedFiles.length > 0 && (
              <Box sx={{ mb: 2 }}>
                <Typography variant="caption" color="text.secondary" gutterBottom>
                  Attached files:
                </Typography>
                <Box sx={{ display: 'flex', gap: 1, flexWrap: 'wrap', mt: 1 }}>
                  {attachedFiles.map((file, index) => (
                    <Chip
                      key={index}
                      icon={<CodeIcon />}
                      label={file.path}
                      onDelete={() => handleRemoveFile(index)}
                      color="primary"
                      variant="outlined"
                    />
                  ))}
                </Box>
              </Box>
            )}

            {/* Input Area */}
            <Box sx={{ position: 'relative' }} ref={anchorRef}>
              <Box sx={{ display: 'flex', gap: 1 }}>
                <TextField
                  fullWidth
                  multiline
                  maxRows={4}
                  value={input}
                  onChange={handleInputChange}
                  onKeyPress={handleKeyPress}
                  placeholder="Ask anything... Use @ to reference files or pick a template"
                  disabled={isChatting}
                  inputRef={inputRef}
                />
                <Button
                  variant="contained"
                  onClick={handleSend}
                  disabled={isChatting || !input.trim()}
                  endIcon={isChatting ? <CircularProgress size={20} /> : <SendIcon />}
                >
                  Send
                </Button>
              </Box>

              {/* File Suggestions Dropdown */}
              {showFileSuggestions && (
                <Popper 
                  open={showFileSuggestions} 
                  anchorEl={anchorRef.current}
                  placement="top-start"
                  sx={{ zIndex: 1300, width: anchorRef.current?.offsetWidth || 400 }}
                >
                  <ClickAwayListener onClickAway={() => setShowFileSuggestions(false)}>
                    <Paper elevation={8} sx={{ maxHeight: 200, overflow: 'auto' }}>
                      <List dense>
                        {fileSuggestions.map((file, index) => (
                          <ListItem 
                            key={index} 
                            onClick={() => handleFileSelect(file)}
                            sx={{ cursor: 'pointer', '&:hover': { bgcolor: 'action.hover' } }}
                          >
                            <FileIcon sx={{ mr: 1, fontSize: 18, color: 'primary.main' }} />
                            <ListItemText 
                              primary={file.split('/').pop()} 
                              secondary={file}
                              primaryTypographyProps={{ variant: 'body2' }}
                              secondaryTypographyProps={{ variant: 'caption' }}
                            />
                          </ListItem>
                        ))}
                      </List>
                    </Paper>
                  </ClickAwayListener>
                </Popper>
              )}
            </Box>
          </>
        )}

        {/* Prompt Templates Tab */}
        {activeTab === 1 && (
          <Box>
            <Typography variant="h6" gutterBottom>
              📚 Prompt Templates for CreatorHub Norge
            </Typography>
            <Grid container spacing={2}>
              {promptTemplates.map((template) => (
                <Grid item xs={12} md={6} key={template.id}>
                  <Accordion>
                    <AccordionSummary expandIcon={<ExpandIcon />}>
                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                        {template.icon}
                        <Typography>{template.title}</Typography>
                      </Box>
                    </AccordionSummary>
                    <AccordionDetails>
                      <Typography variant="body2" color="text.secondary" gutterBottom>
                        {template.description}
                      </Typography>
                      <Divider sx={{ my: 1 }} />
                      <Paper sx={{ p: 1, bgcolor: 'grey.100', mb: 2 }}>
                        <Typography variant="caption" sx={{ whiteSpace: 'pre-wrap', fontFamily: 'monospace' }}>
                          {template.prompt}
                        </Typography>
                      </Paper>
                      <Button
                        variant="contained"
                        size="small"
                        onClick={() => applyTemplate(template)}
                        startIcon={<MagicIcon />}
                      >
                        Use This Prompt
                      </Button>
                    </AccordionDetails>
                  </Accordion>
                </Grid>
              ))}
            </Grid>
          </Box>
        )}

        {/* Smart Suggestions Tab */}
        {activeTab === 2 && (
          <Box>
            <Typography variant="h6" gutterBottom>
              💡 Smart Suggestions
            </Typography>
            <Typography variant="body2" color="text.secondary" gutterBottom>
              Based on your conversation and project context:
            </Typography>
            <List>
              {smartSuggestions.map((suggestion, index) => (
                <ListItem
                  key={index}
                  onClick={() => applySuggestion(suggestion)}
                  sx={{ bgcolor: 'grey.50', mb: 1, borderRadius: 1, cursor: 'pointer', '&:hover': { bgcolor: 'grey.100' } }}
                >
                  <ListItemText 
                    primary={suggestion}
                    primaryTypographyProps={{ variant: 'body2' }}
                  />
                </ListItem>
              ))}
            </List>
          </Box>
        )}
      </CardContent>
    </Card>
  );
};

export default OpenAIAssistant;

