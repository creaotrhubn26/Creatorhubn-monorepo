/**
 * CreatorHub Norge - Resume Exporter
 * Advanced export functionality for resumes
 */

import React, { useState } from 'react';
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Stack,
  Card,
  CardContent,
  Typography,
  Box,
  Radio,
  RadioGroup,
  FormControlLabel,
  FormControl,
  Alert,
  Chip,
  LinearProgress,
  Divider,
} from '@mui/material';
import {
  PictureAsPdf as PdfIcon,
  Description as DocxIcon,
  TextFields as TxtIcon,
  Code as JsonIcon,
  Download as DownloadIcon,
  CheckCircle as CheckIcon,
} from '@mui/icons-material';

interface ResumeExporterProps {
  resume: any;
  open: boolean;
  onClose: () => void;
  onExport: (format: 'pdf' | 'docx' | 'txt' | 'json') => Promise<void>;
}

export default function ResumeExporter({
  resume,
  open,
  onClose,
  onExport,
}: ResumeExporterProps) {
  const [selectedFormat, setSelectedFormat] = useState<'pdf' | 'docx' | 'txt' | 'json'>('pdf');
  const [isExporting, setIsExporting] = useState(false);
  const [exportSuccess, setExportSuccess] = useState(false);

  const exportFormats = [
    {
      value: 'pdf',
      label: 'PDF',
      icon: <PdfIcon sx={{ fontSize: 40, color: '#d32f2f' }} />,
      description: 'Profesjonelt format for jobbsøknader',
      recommended: true,
      pros: ['Universelt akseptert', 'Beholder formatering', 'Print-ready', 'Kan ikke endres'],
      cons: ['Ikke redigerbart'],
      fileSize: '~200 KB',
      atsScore: 100,
    },
    {
      value: 'docx',
      label: 'Microsoft Word (DOCX)',
      icon: <DocxIcon sx={{ fontSize: 40, color: '#2b579a' }} />,
      description: 'Redigerbart format for videre tilpasning',
      recommended: false,
      pros: ['Redigerbart', 'Kompatibelt med Word', 'Kan tilpasses videre'],
      cons: ['Formatering kan endre seg', 'Krever Word/LibreOffice'],
      fileSize: '~100 KB',
      atsScore: 95,
    },
    {
      value: 'txt',
      label: 'Plain Text (TXT)',
      icon: <TxtIcon sx={{ fontSize: 40, color: '#616161' }} />,
      description: 'Enkel tekst for maksimal ATS-kompatibilitet',
      recommended: false,
      pros: ['Maksimal ATS-kompatibilitet', 'Ingen formatering', 'Universelt'],
      cons: ['Ingen visuell design', 'Grunnleggende'],
      fileSize: '~10 KB',
      atsScore: 100,
    },
    {
      value: 'json',
      label: 'JSON',
      icon: <JsonIcon sx={{ fontSize: 40, color: '#ff9800' }} />,
      description: 'Strukturert data for backup og import',
      recommended: false,
      pros: ['Full dataeksport', 'Import/eksport', 'Maskinlesbart'],
      cons: ['Ikke for jobbsøknader', 'Teknisk format'],
      fileSize: '~50 KB',
      atsScore: 0,
    },
  ];

  const handleExport = async () => {
    setIsExporting(true);
    setExportSuccess(false);

    try {
      await onExport(selectedFormat);
      setExportSuccess(true);
      
      // Auto-close after success
      setTimeout(() => {
        setIsExporting(false);
        setExportSuccess(false);
        onClose();
      }, 2000);
    } catch (error) {
      console.error('Export failed:', error);
      setIsExporting(false);
    }
  };

  const selectedFormatData = exportFormats.find((f) => f.value === selectedFormat);

  return (
    <Dialog open={open} onClose={onClose} maxWidth="md" fullWidth>
      <DialogTitle>
        <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
          <DownloadIcon color="primary" />
          <Typography variant="h6">Eksporter CV</Typography>
        </Box>
      </DialogTitle>

      <DialogContent>
        {/* Resume Info */}
        <Card sx={{ mb: 3, bgcolor: 'primary.light', color: 'primary.contrastText' }}>
          <CardContent>
            <Typography variant="h6">{resume.title}</Typography>
            <Typography variant="body2">
              {resume.personalInfo?.fullName} • ATS-Score: {resume.atsScore}%
            </Typography>
          </CardContent>
        </Card>

        {/* Format Selection */}
        <FormControl component="fieldset" fullWidth>
          <RadioGroup
            value={selectedFormat}
            onChange={(e) => setSelectedFormat(e.target.value as any)}
          >
            <Stack spacing={2}>
              {exportFormats.map((format) => (
                <Card
                  key={format.value}
                  sx={{
                    cursor: 'pointer',
                    border: selectedFormat === format.value ? '2px solid' : '1px solid',
                    borderColor: selectedFormat === format.value ? 'primary.main' : 'divider',
                    '&:hover': {
                      borderColor: 'primary.main',
                      boxShadow: 3,
                    },
                  }}
                  onClick={() => setSelectedFormat(format.value as any)}
                >
                  <CardContent>
                    <Box sx={{ display: 'flex', alignItems: 'flex-start', gap: 2 }}>
                      {/* Icon */}
                      <Box>{format.icon}</Box>

                      {/* Content */}
                      <Box sx={{ flex: 1 }}>
                        <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 1 }}>
                          <FormControlLabel
                            value={format.value}
                            control={<Radio />}
                            label={
                              <Typography variant="h6" sx={{ fontWeight: 600 }}>
                                {format.label}
                              </Typography>
                            }
                          />
                          {format.recommended && (
                            <Chip label="Anbefalt" color="success" size="small" />
                          )}
                          {format.atsScore > 0 && (
                            <Chip
                              label={`ATS: ${format.atsScore}%`}
                              size="small"
                              color={format.atsScore >= 95 ? 'success' : 'warning'}
                            />
                          )}
                        </Box>

                        <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                          {format.description}
                        </Typography>

                        {/* Pros and Cons */}
                        <Box sx={{ display: 'flex', gap: 2 }}>
                          {/* Pros */}
                          <Box sx={{ flex: 1 }}>
                            <Typography variant="caption" color="success.main" fontWeight={600}>
                              ✓ Fordeler:
                            </Typography>
                            <Box component="ul" sx={{ fontSize: '12px', pl: 2, mt: 0.5 }}>
                              {format.pros.map((pro, i) => (
                                <li key={i}>{pro}</li>
                              ))}
                            </Box>
                          </Box>

                          {/* Cons */}
                          <Box sx={{ flex: 1 }}>
                            <Typography variant="caption" color="error.main" fontWeight={600}>
                              ⚠ Ulemper:
                            </Typography>
                            <Box component="ul" sx={{ fontSize: '12px', pl: 2, mt: 0.5 }}>
                              {format.cons.map((con, i) => (
                                <li key={i}>{con}</li>
                              ))}
                            </Box>
                          </Box>
                        </Box>

                        {/* File Size */}
                        <Typography variant="caption" color="text.secondary" sx={{ mt: 1, display: 'block' }}>
                          Estimert filstørrelse: {format.fileSize}
                        </Typography>
                      </Box>
                    </Box>
                  </CardContent>
                </Card>
              ))}
            </Stack>
          </RadioGroup>
        </FormControl>

        {/* Tips */}
        {selectedFormatData && (
          <Alert severity="info" sx={{ mt: 3 }}>
            <Typography variant="body2" fontWeight={600} gutterBottom>
              Tips for {selectedFormatData.label}:
            </Typography>
            {selectedFormatData.value === 'pdf' && (
              <Typography variant="body2">
                PDF er det mest profesjonelle formatet og anbefales for alle jobbsøknader. 
                Filen kan ikke endres, noe som sikrer at formateringen din beholdes.
              </Typography>
            )}
            {selectedFormatData.value === 'docx' && (
              <Typography variant="body2">
                DOCX er nyttig hvis du vil gjøre siste justeringer i Word. Husk å sjekke 
                formateringen etter åpning i Word, da den kan variere mellom versjoner.
              </Typography>
            )}
            {selectedFormatData.value === 'txt' && (
              <Typography variant="body2">
                Plain text er perfekt for ATS-systemer som kun aksepterer tekst uten formatering. 
                Bruk dette hvis du har problemer med PDF-opplasting.
              </Typography>
            )}
            {selectedFormatData.value === 'json' && (
              <Typography variant="body2">
                JSON-formatet er for backup og import/eksport mellom systemer. Dette er ikke 
                ment for jobbsøknader, men for å sikre dataene dine.
              </Typography>
            )}
          </Alert>
        )}

        {/* Export Progress */}
        {isExporting && (
          <Box sx={{ mt: 3 }}>
            <LinearProgress />
            <Typography variant="body2" sx={{ mt: 1, textAlign: 'center' }}>
              Eksporterer CV...
            </Typography>
          </Box>
        )}

        {/* Success Message */}
        {exportSuccess && (
          <Alert severity="success" sx={{ mt: 3 }} icon={<CheckIcon />}>
            <Typography variant="body2" fontWeight={600}>
              CV eksportert! Filen lastes ned...
            </Typography>
          </Alert>
        )}
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose} disabled={isExporting}>
          Avbryt
        </Button>
        <Button
          variant="contained"
          onClick={handleExport}
          disabled={isExporting || exportSuccess}
          startIcon={isExporting ? null : <DownloadIcon />}
        >
          {isExporting ? 'Eksporterer...' : `Eksporter som ${selectedFormat.toUpperCase()}`}
        </Button>
      </DialogActions>
    </Dialog>
  );
}

