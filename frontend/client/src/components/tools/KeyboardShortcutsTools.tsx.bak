              {categories.map((category) => (
                <Chip
                  key={category}
                  label={category === 'all' ? 'Alle kategorier' : category}
                  variant={selectedCategory === category ? 'filled' : 'outlined'}
                  onClick={() => setSelectedCategory(category)}
                  size="small"
                  sx={{
                    bgcolor: selectedCategory === category ? currentSoftware?.color : 'transparent',
                    color: selectedCategory === category ? 'white' : currentSoftware?.color,
                    borderColor: currentSoftware?.color,
                    '&:hover': {
                      bgcolor: selectedCategory === category
                          ? currentSoftware?.color + 'dd'
                          : currentSoftware?.color + '1',
                },
              }}
                />
              ))}
            </Box>
          </GridOn>
        </GridOn>
      </Paper>

      {/* Shortcuts List */}
      <Accordion
