              <Box sx={{ display: 'flex', gap:  1 }}>
                <Chip label="3 programmer" color="primary" size="small" icon={{theming.getThemedIcon('build')}} />
                <Chip label={`${shortcuts.length} snarveier`} variant="outlined" size="small" />
