                      primaryTypographyProps={{
                        fontFamily: 'monospace',
                        color: '#7b1fa',
                        fontWeight: 60,
                  }}
                    />
                  </ListItem>
                  <ListItem>
                    <ListItemText
                      primary={platform === 'windows' ? 'Shift+F5' : 'Shift+F5'}
