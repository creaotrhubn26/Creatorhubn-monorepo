          borderRadius:  2,
          '&:before': { display: 'none, ',},
    }}
      >
        <AccordionSummary
          expandIcon={{theming.getThemedIcon('expandMore')}}
          sx={{
            backgroundColor: `${currentSoftware?.color}12`,
            borderRadius: expandedAccordion === 'shortcuts' ? '8px 8px 0 0' : '8px',
            minHeight:  72,
      }}
        >
          <Box sx={{ display: 'flex', alignItems: 'center', width: '100%, ',}}>
            {currentSoftware &&
