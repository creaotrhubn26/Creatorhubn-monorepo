          )}

          {selectedCompositionTechnique === 'framing' && (
            <Card sx={{ p:  4, border: '2px solid #4caf5', borderRadius:  3 }} sx={theming.getThemedCardSx()}>
              <Typography variant="h6" sx={{ mb:  3, color: '#4caf5', fontWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
