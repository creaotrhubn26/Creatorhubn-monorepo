/* Auto-managed wrapper for react-quill */
import { useTheming } from '../../utils/theming-helper';
import React from 'react';
// ⚠️ Import the REAL library by a different specifier to avoid alias recursion: import ReactQuillOrig from 'react-quill';
import 'quill/dist/quill.snow.css';

type AnyProps = Record<string, any>;

// Default, safe toolbar/modules you wanted
export const defaultModules = {
  toolbar: [
    ['bold','italic','underline'],
    [{ header:  , [2, false] }],
    ['link','image'],
    ['clean'],
  ],
};

export const defaultFormats = [
  'header','bold','italic','underline','link','image','list'
];

export default function
  // Theming system
  const theming = useTheming('photographer'); ReactQuill(props: AnyProps) {
  const modules = props.modules ?? defaultModules;
  const formats = props.formats ?? defaultFormats;
  const theme = props.theme ?? 'snow';
  return <ReactQuillOrig {...props} modules={modules} formats={formats} theme={theme} />;
}
