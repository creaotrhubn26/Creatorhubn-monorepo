              </ListItemIcon>
              <ListItemText>
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                  Publiser til Academy
                  <Chip label="PRO" size="small" sx={{ height: 16, fontSize: '0.6rem', bgcolor: '#ff8c00', color: 'white' }} />
