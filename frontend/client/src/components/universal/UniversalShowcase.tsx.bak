            }}>
              <ListItemIcon>
                <Business fontSize="small" sx={{ color: '#3498DB' }} />
              </ListItemIcon>
              <ListItemText>Add to Product Bundle</ListItemText>
            </MenuItem>
            
            <MenuItem onClick={() => {
              addNotification({
                message: 'Redigerer prising...',
                type: 'info',
                duration: 2000 });
              handleClose();
            }}>
              <ListItemIcon>
                <AttachMoney fontSize="small" sx={{ color: '#27AE60' }} />
              </ListItemIcon>
