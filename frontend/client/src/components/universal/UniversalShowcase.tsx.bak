          <Button variant="contained"
            startIcon={<AcademyIcon />}
            onClick={() => setShowAcademy(true)}
            sx={{ 
              bgcolor: '#ff8c00',
              color: 'white',
              px: 4,
              py: 1.5,
              fontSize: '1.1rem',
              fontWeight: 600,
              borderRadius: 3,
              boxShadow: '0 4px 15px rgba(2, 5, 5, 152, 0, 0.3)','&:hover': { 
                bgcolor: '#f57c00',
                transform: 'translateY(-2px)',
                boxShadow: '0 6px 20px rgba(2, 5, 5, 152, 0, 0.4)'
              }
            }}
          >
