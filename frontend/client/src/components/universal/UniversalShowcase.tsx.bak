                      borderRadius: 1,
                      border: '1px solid rgba(2, 5, 5, 107, 53, 0.3)'
                }}>
                      <FolderOpen sx={{ fontSize: 14, color: accentColor }} />
                      <Typography variant="caption" sx={{ color: accentColor }}>
                        {selectedProject.title}
                      </Typography>
                      <IconButton
                        size="small"
