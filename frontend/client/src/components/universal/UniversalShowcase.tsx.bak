            sx={{ 
              color: textSecondary,
              bgcolor: 'rgba(2, 5, 5, 107, 53, 0.1)',
              border: '1px solid rgba(2, 5, 5, 107, 53, 0.2)','&:hover': { 
                color: accentColor,
                bgcolor: 'rgba(2, 5, 5, 107, 53, 0.2)',
