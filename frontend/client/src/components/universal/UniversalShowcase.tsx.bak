              </Typography>
              <Typography variant="caption" sx={{ color: 'rgba(2, 5, 5,255,255,0.5)' }}>
                {getProfessionDisplayName(profession)}
              </Typography>
            </Box>
          </Box>
        </Box>
      </Box>

