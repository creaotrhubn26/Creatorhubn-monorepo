        {/* Publish to Academy - Pro Plan Feature */}
        {features.checkFeatureAccess('publish-to-academy')?.hasAccess && (
          <>
            <Divider sx={{ my: 1 }} />
            <MenuItem onClick={() => {
              setSelectedItemForPublish(item);
