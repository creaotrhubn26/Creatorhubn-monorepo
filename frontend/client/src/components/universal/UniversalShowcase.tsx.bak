                  ) : index === 1 ? (
                    <Star sx={{ fontSize: sidebarOpen ? 16 : 20, color: textSecondary }} />
                  ) : (
                    <Collections sx={{ fontSize: sidebarOpen ? 16 : 20, color: textSecondary }} />
                  )}
                </Box>
                
                {sidebarOpen && (
                  <Typography 
                    variant="body2" 
                    sx={{ 
                      color: (filter === 'all' && index === 0) || filter === category.toLowerCase() 
                        ? textPrimary 
