              fontSize: '0.7rem', 
              fontWeight: 70,
              letterSpacing: '0.15em',
              mb: 3,
              display: 'block',
              textShadow: '0 1px 2px rgba(0,0,0,0.5)'
            }}>
              PORTFOLIO KATEGORIER
            </Typography>
          )}
          
          {getProfessionCategories().map((category, index) => (
            <Tooltip 
              key={category}
