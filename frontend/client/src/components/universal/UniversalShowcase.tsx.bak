              }
            }}
          >
            {sidebarOpen ? <ChevronLeft /> : <MenuIcon />}
          </IconButton>
        </Box>

        {/* Professional Navigation Categories */}
        <Box sx={{ flex: 1, p: sidebarOpen ? 2.5 : 1, pt: 3 }}>
