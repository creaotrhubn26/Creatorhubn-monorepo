              WebkitTextFillColor: 'transparent'
            }}>
              {config.title}
            </Typography>
            
            {/* Feature Analytics Display */}
            <Box sx={{ 
              display: 'flex', 
              alignItems: 'center', 
              gap: 1,
              mt: 1 }}>
              <Typography variant="caption" sx={{ color: textSecondary }}>
