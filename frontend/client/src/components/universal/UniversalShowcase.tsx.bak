                  color: projectState === 'in_review' ? 'rgba(2, 5, 5,255,255,0.2)' : 'rgba(2, 5, 5,255,255,0.5)','&:hover': { color: projectState === 'in_review' ? 'rgba(2, 5, 5,255,255,0.2)' : accentColor }
            }}
