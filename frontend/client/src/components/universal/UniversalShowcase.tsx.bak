        }}>
          <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
            <Avatar sx={{ width: 32, height: 32, bgcolor: config.primaryColor }}>
              D
            </Avatar>
            <Box>
              <Typography variant="body2" sx={{ fontWeight: 600, color: '#fff'}}>
