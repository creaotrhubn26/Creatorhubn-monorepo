            </MenuItem>
            
            <MenuItem onClick={() => {
              addNotification({
                message: 'Legger til varianter...',
                type: 'info',
                duration: 2000 });
              handleClose();
            }}>
              <ListItemIcon>
                <ViewModule fontSize="small" sx={{ color: '#E67E22' }} />
              </ListItemIcon>
