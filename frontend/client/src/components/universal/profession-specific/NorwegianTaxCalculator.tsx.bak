interface NorwegianTaxCalculatorProps {
  profession?: 'photographer' | 'videographer' | 'musicproducer' | 'vendor';
  mode?: 'standalone' | 'integrated';
  onTaxCalculated?: (taxData: any) => void
}

interface TaxCalculation {
  id: string;
  periode: string;
  omsetning: number;
  fradrag: number;
  grunnlagMVA: number;
  mva25: number;
  mva15: number;
  mva12: number;
  mvaIalt: number;
  skattegrunnlag: number;
  skatt: number;
  totalSkattOgMVA: number;
  nettoResultat: number;
  createdAt: Date
}

interface InvoiceData {
  id: string;
  kundeNavn: string;
  belop: number;
  mvaSats: number;
  mvaKode: string;
  beskrivelse: string;
  dato: Date;
  forfallsdato: Date;
  status: 'draft' | 'sent' | 'paid' | 'overdue'
}

interface ExpenseCategory {
  kategori: string;
  beskrivelse: string;
  maksGradFradrag: number;
  MVAFradragsrett: boolean
}

