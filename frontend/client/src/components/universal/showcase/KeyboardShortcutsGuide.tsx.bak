/**
 * Keyboard Shortcuts Guide Component
 * Displays profession-specific keyboard shortcuts overlay
 * Activated by pressing '?' key
 */

import React from 'react';
import { useProfessionConfigs } from '@/hooks/useProfessionConfigs';
import { useProfessionAdapter } from '@/hooks/useProfessionAdapter';
import getProfessionIcon from '@/utils/profession-icons';
import { useDynamicProfessions } from '../hooks/useDynamicProfessions';
import {
  Dialog,
  DialogTitle,
  DialogContent,
  Box,
  Typography,
  Chip,
  Grid,
  Divider,
  IconButton,
  Paper,
  Stack
} from '@mui/material';
import {
  Close,
  Keyboard,
  Star,
  Edit,
  Download,
  Share,
  Delete,
  Fullscreen,
  PlayArrow,
  Pause,
  VolumeUp,
  Comment,
  PhotoLibrary,
  VideoLibrary,
  LibraryMusic,
  Business,
  Search,
  Save,
  RotateRight,
  Info,
  ZoomIn,
  ZoomOut,
  Lock,
  Unlock,
  Copy,
  Cut,
  Paste,
  Refresh,
  FilterList,
  Category,
  Add,
  Remove,
  Settings
} from '@mui/icons-material';

interface KeyboardShortcut {
  key: string;
  description: string;
  category: string;
  icon?: React.ReactNode;
}

interface KeyboardShortcutsGuideProps {
  open: boolean;
  onClose: () => void;
  profession: 'photographer' | 'videographer' | 'music_producer' | 'vendor';
}

export const KeyboardShortcutsGuide: React.FC<KeyboardShortcutsGuideProps> = ({
  open,
  onClose,
  profession
}) => {
  // Universal shortcuts for all professions
  const universalShortcuts: KeyboardShortcut[] = [
    { key: 'Cmd/Ctrl + K', description: 'Open Command Palette', category: 'Navigation', icon: <Keyboard /> },
    { key: 'Cmd/Ctrl + F', description: 'Search/Find', category: 'Navigation', icon: <Search /> },
    { key: 'Cmd/Ctrl + S', description: 'Save', category: 'Actions', icon: <Save /> },
    { key: 'Space', description: 'Quick Preview', category: 'Navigation', icon: <Fullscreen /> },
    { key: 'Esc', description: 'Close/Deselect', category: 'Navigation' },
    { key: '?', description: 'Show This Guide', category: 'Help', icon: <Keyboard /> },
    { key: 'Cmd/Ctrl + A', description: 'Select All (in batch mode)', category: 'Selection' },
    { key: 'Cmd/Ctrl + C', description: 'Copy', category: 'Editing', icon: <Copy /> },
    { key: 'Cmd/Ctrl + X', description: 'Cut', category: 'Editing', icon: <Cut /> },
    { key: 'Cmd/Ctrl + V', description: 'Paste', category: 'Editing', icon: <Paste /> },
    { key: 'Cmd/Ctrl + Z', description: 'Undo', category: 'Editing' },
    { key: 'Cmd/Ctrl + Shift + Z', description: 'Redo', category: 'Editing' },
    { key: 'Delete/Backspace', description: 'Delete Selected', category: 'Actions', icon: <Delete /> },
    { key: '←/→', description: 'Navigate Previous/Next', category: 'Navigation' },
    { key: 'Tab', description: 'Next Field', category: 'Navigation' },
    { key: 'Shift + Tab', description: 'Previous Field', category: 'Navigation' },
  ];

  // Photographer-specific shortcuts
  const photographerShortcuts: KeyboardShortcut[] = [
    { key: '1-5', description: 'Star Rating (1-5 stars)', category: 'Rating', icon: <Star /> },
    { key: 'P', description: 'Pick/Flag Image', category: 'Selection', icon: <Star /> },
    { key: 'X', description: 'Reject Image', category: 'Selection' },
    { key: 'U', description: 'Unflag/Unpick', category: 'Selection' },
    { key: 'C', description: 'Compare Mode', category: 'View' },
    { key: 'B', description: 'Before/After Comparison', category: 'View' },
    { key: 'E', description: 'Quick Enhance', category: 'Editing', icon: <Edit /> },
    { key: 'W', description: 'Apply Watermark', category: 'Editing' },
    { key: 'R', description: 'Rotate Image', category: 'Editing', icon: <RotateRight /> },
    { key: 'Shift + R', description: 'Rotate Counter-clockwise', category: 'Editing' },
    { key: 'I', description: 'Show Info/EXIF Data', category: 'Metadata', icon: <Info /> },
    { key: 'S', description: 'Share with Client', category: 'Sharing', icon: <Share /> },
    { key: 'D', description: 'Download', category: 'Actions', icon: <Download /> },
    { key: 'G', description: 'Toggle Grid/List View', category: 'View' },
    { key: 'F', description: 'Toggle Fullscreen', category: 'View', icon: <Fullscreen /> },
    { key: 'H', description: 'Hide/Show UI Overlay', category: 'View' },
    { key: 'Z', description: 'Zoom In', category: 'View', icon: <ZoomIn /> },
    { key: 'Shift + Z', description: 'Zoom Out', category: 'View', icon: <ZoomOut /> },
    { key: 'L', description: 'Lock/Unlock Image', category: 'Organization', icon: <Lock /> },
    { key: 'N', description: 'Next Image', category: 'Navigation' },
    { key: 'Shift + N', description: 'Previous Image', category: 'Navigation' },
    { key: 'O', description: 'Open in External Editor', category: 'Actions' },
  ];

  // Videographer-specific shortcuts
  const videographerShortcuts: KeyboardShortcut[] = [
    { key: 'J/K/L', description: 'Rewind/Pause/Forward', category: 'Playback', icon: <PlayArrow /> },
    { key: 'Space', description: 'Play/Pause', category: 'Playback', icon: <Pause /> },
    { key: ',/.', description: 'Frame Back/Forward', category: 'Playback' },
    { key: 'Shift + ,/.', description: 'Jump 10 Frames', category: 'Playback' },
    { key: 'I/O', description: 'Set In/Out Points', category: 'Editing' },
    { key: 'Shift + I/O', description: 'Go to In/Out Point', category: 'Navigation' },
    { key: 'X', description: 'Clear In/Out Points', category: 'Editing' },
    { key: 'M', description: 'Add Marker', category: 'Editing' },
    { key: 'Shift + M', description: 'Go to Next Marker', category: 'Navigation' },
    { key: 'R', description: 'Set to Review', category: 'Status' },
    { key: 'V', description: 'Change Version (R1/R2/R3/Final)', category: 'Versioning' },
    { key: 'T', description: 'Add Timecode Comment', category: 'Collaboration', icon: <Comment /> },
    { key: 'S', description: 'Split Clip at Playhead', category: 'Editing' },
    { key: 'D', description: 'Duplicate Clip', category: 'Editing' },
    { key: 'Q', description: 'Ripple Delete', category: 'Editing' },
    { key: 'W', description: 'Extend Edit to Playhead', category: 'Editing' },
    { key: 'E', description: 'Append to Timeline', category: 'Editing' },
    { key: 'F', description: 'Match Frame', category: 'Navigation' },
    { key: 'G', description: 'Go to Timecode', category: 'Navigation' },
    { key: 'Z', description: 'Zoom Timeline In', category: 'View', icon: <ZoomIn /> },
    { key: 'Shift + Z', description: 'Zoom Timeline Out', category: 'View', icon: <ZoomOut /> },
    { key: 'H', description: 'Hand Tool (Pan)', category: 'View' },
    { key: 'C', description: 'Razor Tool', category: 'Editing' },
  ];

  // Music Producer-specific shortcuts
  const musicProducerShortcuts: KeyboardShortcut[] = [
    { key: 'Space', description: 'Play/Pause', category: 'Playback', icon: <PlayArrow /> },
    { key: 'R', description: 'Record', category: 'Recording' },
    { key: 'S', description: 'Solo Track', category: 'Mixing' },
    { key: 'Shift + S', description: 'Unsolo All Tracks', category: 'Mixing' },
    { key: 'M', description: 'Mute Track', category: 'Mixing', icon: <VolumeUp /> },
    { key: 'Shift + M', description: 'Unmute All Tracks', category: 'Mixing' },
    { key: 'B', description: 'Set BPM', category: 'Metadata' },
    { key: 'K', description: 'Set Key', category: 'Metadata' },
    { key: 'E', description: 'Extract Stems', category: 'Processing' },
    { key: '+/-', description: 'Increase/Decrease Volume', category: 'Mixing' },
    { key: 'Shift + +/-', description: 'Fine Volume Adjust', category: 'Mixing' },
    { key: 'L', description: 'Loop Selection', category: 'Playback' },
    { key: 'Shift + L', description: 'Toggle Loop Mode', category: 'Playback' },
    { key: 'Ctrl/Cmd + S', description: 'Split at Playhead', category: 'Editing' },
    { key: 'D', description: 'Duplicate Region', category: 'Editing' },
    { key: 'T', description: 'Time Stretch', category: 'Processing' },
    { key: 'P', description: 'Pitch Shift', category: 'Processing' },
    { key: 'N', description: 'Normalize Audio', category: 'Processing' },
    { key: 'C', description: 'Compressor', category: 'Effects' },
    { key: 'Q', description: 'EQ', category: 'Effects' },
    { key: 'F', description: 'Fade In/Out', category: 'Editing' },
    { key: 'G', description: 'Gain', category: 'Mixing' },
    { key: 'H', description: 'Show/Hide Automation', category: 'View' },
  ];

  // Vendor-specific shortcuts
  const vendorShortcuts: KeyboardShortcut[] = [
    { key: 'N', description: 'New Product', category: 'Product Management', icon: <Add /> },
    { key: 'P', description: 'Edit Pricing', category: 'Product Management' },
    { key: 'I', description: 'Update Inventory', category: 'Product Management' },
    { key: 'V', description: 'Add Variants', category: 'Product Management' },
    { key: 'B', description: 'Add to Bundle', category: 'Product Management' },
    { key: 'F', description: 'Toggle Featured', category: 'Product Management' },
    { key: 'T', description: 'Edit Tags', category: 'Organization' },
    { key: 'C', description: 'Edit Categories', category: 'Organization', icon: <Category /> },
    { key: 'S', description: 'Save Product', category: 'Actions', icon: <Save /> },
    { key: 'D', description: 'Duplicate Product', category: 'Product Management' },
    { key: 'E', description: 'Export Product Data', category: 'Actions', icon: <Download /> },
    { key: 'R', description: 'Refresh Inventory', category: 'Product Management', icon: <Refresh /> },
    { key: 'G', description: 'Toggle Grid/List View', category: 'View' },
    { key: 'O', description: 'Bulk Operations', category: 'Product Management' },
    { key: 'L', description: 'Filter Products', category: 'View', icon: <FilterList /> },
    { key: 'Shift + L', description: 'Clear Filters', category: 'View' },
    { key: 'H', description: 'Product History', category: 'Analytics' },
    { key: 'A', description: 'Add to Archive', category: 'Organization' },
    { key: 'U', description: 'Unarchive Product', category: 'Organization' },
  ];

  // Select shortcuts based on profession
  const professionShortcuts = 
    profession === 'photographer' ? photographerShortcuts :
    profession === 'videographer' ? videographerShortcuts :
    profession === 'music_producer' ? musicProducerShortcuts :
    vendorShortcuts;

  const getProfessionIcon = () => {
    switch (profession) {
      case 'photographer': return <PhotoLibrary sx={{ fontSize: 32, color: '#FF6B35' }} />;
      case 'videographer': return <VideoLibrary sx={{ fontSize: 32, color: '#E74C3C' }} />;
      case 'music_producer': return <LibraryMusic sx={{ fontSize: 32, color: '#9B59B6' }} />;
      case 'vendor': return <Business sx={{ fontSize: 32, color: '#3498DB' }} />;
    }
  };

  const getProfessionColor = () => {
    switch (profession) {
      case 'photographer': return '#FF6B35';
      case 'videographer': return '#E74C3C';
      case 'music_producer': return '#9B59B6';
      case 'vendor': return '#3498DB';
    }
  };

  // Dynamic profession system hooks
  const { professionConfigs, getUserProfessionColor } = useDynamicProfessions();
  const { professionConfigs: apiProfessionConfigs } = useProfessionConfigs();
  const professionAdapter = useProfessionAdapter();
  const currentProfession = profession || professionAdapter.profession || 'photographer';
  const professionIcon = getProfessionIcon(currentProfession);
  const professionConfig = professionConfigs?.[currentProfession];
  const enhancedProfessionConfig = apiProfessionConfigs?.[currentProfession] || professionConfig;
  const professionColor = getUserProfessionColor(currentProfession) || getProfessionColor();
  const professionName = enhancedProfessionConfig?.displayName || professionConfig?.displayName || profession;

  // Group shortcuts by category
  const groupedUniversal = universalShortcuts.reduce((acc, shortcut) => {
    if (!acc[shortcut.category]) acc[shortcut.category] = [];
    acc[shortcut.category].push(shortcut);
    return acc;
  }, {} as Record<string, KeyboardShortcut[]>);

  const groupedProfession = professionShortcuts.reduce((acc, shortcut) => {
    if (!acc[shortcut.category]) acc[shortcut.category] = [];
    acc[shortcut.category].push(shortcut);
    return acc;
  }, {} as Record<string, KeyboardShortcut[]>);

  return (
    <Dialog 
      open={open} 
      onClose={onClose} 
      maxWidth="md" 
      fullWidth
      PaperProps={{
        sx: {
          bgcolor: '#0f1419',
          backgroundImage: 'linear-gradient(135deg, #0f1419 0%, #1a1f2e 50%, #2a1810 100%)',
          color: 'white',
          borderRadius: 3
        }
      }}
    >
      <DialogTitle sx={{ 
        display: 'flex', 
        justifyContent: 'space-between', 
        alignItems: 'center',
        borderBottom: '1px solid rgba(255,255,255,0.1)',
        pb: 2
      }}>
        <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
          {professionIcon && (
            <Box
              sx={{
                display: 'flex',
                alignItems: 'center',
                color: professionColor,
                fontSize: '1.5rem'
              }}
            >
              {professionIcon}
            </Box>
          )}
          <Box>
            <Typography variant="h5" fontWeight="700" sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
              {enhancedProfessionConfig?.displayName ? `${enhancedProfessionConfig.displayName} Keyboard Shortcuts` : 'Keyboard Shortcuts'}
            </Typography>
            <Typography variant="caption" sx={{ color: 'rgba(255,255,255,0.7)' }}>
              {professionName} - Optimized Workflow
            </Typography>
          </Box>
        </Box>
        <IconButton onClick={onClose} sx={{ color: 'white' }}>
          <Close />
        </IconButton>
      </DialogTitle>

      <DialogContent sx={{ pt: 3 }}>
        <Grid container spacing={3}>
          {/* Universal Shortcuts */}
          <Grid item xs={12} md={6}>
            <Paper sx={{ 
              p: 2, 
              bgcolor: 'rgba(255,255,255,0.05)', 
              border: '1px solid rgba(255,255,255,0.1)',
              borderRadius: 2
            }}>
              <Typography variant="h6" gutterBottom sx={{ 
                color: '#4285f4',
                fontWeight: 600,
                display: 'flex',
                alignItems: 'center',
                gap: 1,
                mb: 2
              }}>
                <Keyboard fontSize="small" />
                Universal Shortcuts
              </Typography>
              
              {Object.entries(groupedUniversal).map(([category, shortcuts]) => (
                <Box key={category} sx={{ mb: 2 }}>
                  <Typography variant="caption" sx={{ 
                    color: 'rgba(255,255,255,0.5)',
                    textTransform: 'uppercase',
                    fontWeight: 600,
                    letterSpacing: '0.1em',
                    display: 'block',
                    mb: 1
                  }}>
                    {category}
                  </Typography>
                  <Stack spacing={0.5}>
                    {shortcuts.map((shortcut, index) => (
                      <Box 
                        key={index}
                        sx={{ 
                          display: 'flex', 
                          justifyContent: 'space-between', 
                          alignItems: 'center',
                          p: 1,
                          borderRadius: 1,
                          '&:hover': {
                            bgcolor: 'rgba(255,255,255,0.05)'
                          }
                        }}
                      >
                        <Typography variant="body2" sx={{ color: 'rgba(255,255,255,0.9)' }}>
                          {shortcut.description}
                        </Typography>
                        <Chip 
                          label={shortcut.key} 
                          size="small" 
                          sx={{ 
                            bgcolor: 'rgba(255,255,255,0.1)',
                            color: 'white',
                            fontFamily: 'monospace',
                            fontSize: '0.7rem',
                            fontWeight: 60
                          }} 
                        />
                      </Box>
                    ))}
                  </Stack>
                </Box>
              ))}
            </Paper>
          </Grid>

          {/* Profession-Specific Shortcuts */}
          <Grid item xs={12} md={6}>
            <Paper sx={{ 
              p: 2, 
              bgcolor: `${getProfessionColor()}10`, 
              border: `1px solid ${getProfessionColor()}40`,
              borderRadius: 2
            }}>
              <Typography variant="h6" gutterBottom sx={{ 
                color: getProfessionColor(),
                fontWeight: 600,
                display: 'flex',
                alignItems: 'center',
                gap: 1,
                mb: 2
              }}>
                {professionIcon && (
                  <Box
                    sx={{
                      display: 'flex',
                      alignItems: 'center',
                      color: professionColor,
                      fontSize: '1.2rem',
                      mr: 1
                    }}
                  >
                    {professionIcon}
                  </Box>
                )}
                {enhancedProfessionConfig?.displayName ? `${enhancedProfessionConfig.displayName} Shortcuts` : `${professionName} Shortcuts`}
              </Typography>
              
              {Object.entries(groupedProfession).map(([category, shortcuts]) => (
                <Box key={category} sx={{ mb: 2 }}>
                  <Typography variant="caption" sx={{ 
                    color: 'rgba(255,255,255,0.5)',
                    textTransform: 'uppercase',
                    fontWeight: 600,
                    letterSpacing: '0.1em',
                    display: 'block',
                    mb: 1
                  }}>
                    {category}
                  </Typography>
                  <Stack spacing={0.5}>
                    {shortcuts.map((shortcut, index) => (
                      <Box 
                        key={index}
                        sx={{ 
                          display: 'flex', 
                          justifyContent: 'space-between', 
                          alignItems: 'center',
                          p: 1,
                          borderRadius: 1, '&:hover': {
                            bgcolor: `${getProfessionColor()}20`
                          }
                        }}
                      >
                        <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                          {shortcut.icon && (
                            <Box sx={{ color: getProfessionColor(), display: 'flex' }}>
                              {shortcut.icon}
                            </Box>
                          )}
                          <Typography variant="body2" sx={{ color: 'rgba(255,255,255,0.9)' }}>
                            {shortcut.description}
                          </Typography>
                        </Box>
                        <Chip 
                          label={shortcut.key} 
                          size="small" 
                          sx={{ 
                            bgcolor: `${getProfessionColor()}30`,
                            color: 'white',
                            fontFamily: 'monospace',
                            fontSize: '0.7rem',
                            fontWeight: 600,
                            border: `1px solid ${getProfessionColor()}`
                          }} 
                        />
                      </Box>
                    ))}
                  </Stack>
                </Box>
              ))}
            </Paper>
          </Grid>
        </Grid>

        {/* Tips Section */}
        <Paper sx={{ 
          mt: 3, 
          p: 2, 
          bgcolor: 'rgba(255, 140, 0, 0.05)', 
          border: '1px solid rgba(255, 140, 0, 0.2)',
          borderRadius: 2
        }}>
          <Typography variant="subtitle2" gutterBottom sx={{ 
            color: '#ff8c00',
            fontWeight: 600,
            display: 'flex',
            alignItems: 'center',
            gap: 1
          }}>
            💡 Pro Tips
          </Typography>
          <Box sx={{ display: 'flex', flexDirection: 'column', gap: 1 }}>
            <Typography variant="body2" sx={{ color: 'rgba(255,255,255,0.8)' }}>
              • Hold <Chip label="Shift" size="small" sx={{ mx: 0.5, height: 18 }} /> to select range
            </Typography>
            <Typography variant="body2" sx={{ color: 'rgba(255,255,255,0.8)' }}>
              • Hold <Chip label="Cmd/Ctrl" size="small" sx={{ mx: 0.5, height: 18 }} /> to multi-select
            </Typography>
            <Typography variant="body2" sx={{ color: 'rgba(255,255,255,0.8)' }}>
              • Press <Chip label="?" size="small" sx={{ mx: 0.5, height: 18 }} /> anytime to see this guide
            </Typography>
            {profession === 'videographer' && (
              <Typography variant="body2" sx={{ color: 'rgba(255,255,255,0.8)' }}>
                • Use <Chip label="J/K/L" size="small" sx={{ mx: 0.5, height: 18 }} /> for video scrubbing (like editing software)
              </Typography>
            )}
          </Box>
        </Paper>
      </DialogContent>
    </Dialog>
  );
};

export default KeyboardShortcutsGuide;

