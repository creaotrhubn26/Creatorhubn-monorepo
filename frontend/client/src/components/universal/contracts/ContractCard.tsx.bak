import React from 'react';
import {
  Card,
  CardContent,
  Box,
  Typography,
  Chip,
  Button,
  IconButton,
  Tooltip,
  Checkbox,
} from '@mui/material';
import {
  Launch as LaunchIcon,
  Edit as EditIcon,
  Download as DownloadIcon,
  Delete as DeleteIcon,
  Description as DescriptionIcon,
} from '@mui/icons-material';
import { CircularProgress } from '@mui/material';

interface ContractCardProps {
  contract: any;
  theming: any;
  config: any;
  onViewDetails: (contract: any) => void;
  onEdit: (contract: any) => void;
  onDelete: (contractId: string) => void;
  onDownloadPDF: (contractId: string) => void;
  onCreateESignature: (contractId: string) => void;
  isCreatingESignature: boolean;
  formatDate: (date: any) => string;
  formatContractNumber: (id: string) => string;
  onProjectSelect?: (projectId: string) => void;
  onClientSelect?: (clientId: string, clientName: string) => void;
  isSelected?: boolean;
  onToggleSelect?: (contractId: string) => void;
}

const ContractCard = React.memo<ContractCardProps>(
  ({
    contract,
    theming,
    config,
    onViewDetails,
    onEdit,
    onDelete,
    onDownloadPDF,
    onCreateESignature,
    isCreatingESignature,
    formatDate,
    formatContractNumber,
    onProjectSelect,
    onClientSelect,
    isSelected,
    onToggleSelect,
  }) => {
    return (
      <Card variant="outlined" sx={theming.getThemedCardSx()}>
        <CardContent sx={theming.getThemedCardSx()}>
          {onToggleSelect && (
            <Box sx={{ display: 'flex', alignItems: 'flex-start', gap: 1, mb: 2 }}>
              <Checkbox
                checked={isSelected || false}
                onChange={() => onToggleSelect(contract.id)}
                size="small"
                sx={{ mt: 0.5 }}
              />
              <Box sx={{ flex: 1 }}>
                <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                  <Typography variant="h6" sx={{ color: theming.colors.primary }}>
                    {contract.clientName || 'Ukjent klient'}
                  </Typography>
                  <Chip
                    label={contract.status || 'draft'}
                    color={
                      contract.status === 'draft'
                        ? 'warning'
                        : contract.status === 'active'
                        ? 'success'
                        : 'default'
                    }
                    size="small"
                  />
                </Box>
              </Box>
            </Box>
          )}
          {!onToggleSelect && (
            <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 2 }}>
              <Typography variant="h6" sx={{ color: theming.colors.primary }}>
                {contract.clientName || 'Ukjent klient'}
              </Typography>
              <Chip
                label={contract.status || 'draft'}
                color={
                  contract.status === 'draft'
                    ? 'warning'
                    : contract.status === 'active'
                    ? 'success'
                    : 'default'
                }
                size="small"
              />
            </Box>
          )}

          <Typography variant="body2" color="text.secondary" gutterBottom>
            {contract.projectDescription || 'Ingen beskrivelse'}
          </Typography>

          {/* Project Link */}
          {contract.projectId && onProjectSelect && (
            <Box sx={{ mb: 1 }}>
              <Button
                size="small"
                variant="text"
                onClick={() => onProjectSelect(contract.projectId)}
                sx={{ p: 0, textTransform: 'none', fontSize: '0.75rem' }}
              >
                Prosjekt: {contract.projectName || contract.projectId.substring(0, 8)}
              </Button>
            </Box>
          )}

          {/* Client Link */}
          {contract.clientId && onClientSelect && (
            <Box sx={{ mb: 1 }}>
              <Button
                size="small"
                variant="text"
                onClick={() => onClientSelect(contract.clientId, contract.clientName)}
                sx={{ p: 0, textTransform: 'none', fontSize: '0.75rem' }}
              >
                Klient: {contract.clientName || 'Ukjent'}
              </Button>
            </Box>
          )}

          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 1 }}>
            <Typography variant="h6" sx={{ color: theming.colors.primary }}>
              NOK {contract.totalAmount || 0}
            </Typography>
            <Typography variant="caption" color="text.secondary">
              Opprettet: {formatDate(contract.createdAt)}
            </Typography>
          </Box>

          <Typography variant="body2" color="text.secondary" gutterBottom>
            Kontrakt #: {contract.contractNumber || formatContractNumber(contract.id)}
          </Typography>

          {/* View Details Button */}
          <Button
            size="small"
            variant="text"
            onClick={() => onViewDetails(contract)}
            sx={{ mt: 1, mb: 1 }}
          >
            Se detaljer
          </Button>

          {/* E-Signature Status */}
          {contract.google_doc_id && (
            <Box sx={{ mt: 2, p: 1.5, bgcolor: 'action.hover', borderRadius: 1 }}>
              <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 1 }}>
                <Typography variant="caption" fontWeight="bold">
                  E-Signatur Status:
                </Typography>
                <Chip
                  label={contract.signature_status === 'signed' ? 'Signert' : 'Venter'}
                  color={contract.signature_status === 'signed' ? 'success' : 'warning'}
                  size="small"
                />
              </Box>
              {contract.google_doc_url && (
                <Button
                  size="small"
                  variant="outlined"
                  startIcon={<LaunchIcon />}
                  href={contract.google_doc_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  fullWidth
                  sx={{ mt: 1 }}
                >
                  Åpne i Google Docs
                </Button>
              )}
            </Box>
          )}

          {/* Action Buttons */}
          <Box sx={{ display: 'flex', gap: 1, mt: 2, flexWrap: 'wrap' }}>
            {!contract.google_doc_id && (
              <Button
                size="small"
                variant="outlined"
                startIcon={isCreatingESignature ? <CircularProgress size={16} /> : <DescriptionIcon />}
                disabled={isCreatingESignature}
                onClick={() => onCreateESignature(contract.id)}
              >
                Opprett Signatur
              </Button>
            )}
            <Tooltip title="Last ned PDF">
              <IconButton size="small" onClick={() => onDownloadPDF(contract.id)}>
                <DownloadIcon />
              </IconButton>
            </Tooltip>
            <Button size="small" variant="outlined" startIcon={<EditIcon />} onClick={() => onEdit(contract)}>
              Rediger
            </Button>
            <Tooltip title="Slett kontrakt">
              <IconButton size="small" color="error" onClick={() => onDelete(contract.id)}>
                <DeleteIcon />
              </IconButton>
            </Tooltip>
          </Box>
        </CardContent>
      </Card>
    );
  },
  (prevProps, nextProps) => {
    // Custom comparison function for React.memo
    return (
      prevProps.contract.id === nextProps.contract.id &&
      prevProps.contract.status === nextProps.contract.status &&
      prevProps.contract.signature_status === nextProps.contract.signature_status &&
      prevProps.isCreatingESignature === nextProps.isCreatingESignature &&
      prevProps.isSelected === nextProps.isSelected
    );
  }
);

ContractCard.displayName ='ContractCard';

export default ContractCard;




