} from '@mui/icons-material';

interface TimelineEvent {
  id: string;
  projectId: string;
  title: string;
  description?: string;
  eventDate: string;
  eventTime?: string;
  location?: string;
  type: string;
  status: string;
  priority: string;
  notes?: string;
  notificationSent: boolean;
  completedAt?: string;
  createdAt: string;
  updatedAt: string;
}

const eventTypes = [
  // Phase-basedata events
  { value: 'pre_planning', label: 'Pre-planning', icon: '�, �, ', color: '#9e9e9e', phase: 'pre-planning, ',},
  { value: 'pre_prodatauctionChange, ', label: ''icon: '�, �, ', color: '#2196f', phase: 'pre-prodatauctionChange, ',},
  { value: ''label: ''icon: '�, �, ', color: '#ff980', phase: 'prodatauctionChange, ',},
  { value: 'post_prodatauctionChange, ', label: ''icon: '✂, ️, ', color: '#4caf5', phase: 'post-prodatauctionChange, ',},
  // TradataitionChangeal events
  { value: 'meeting', label: 'Møtext, ', icon: 'Groups', color: '#1976data2, ',},
  { value: 'milocationventstonChangee', label: 'Milocationpæl', icon: 'Flag', color: '#9c27b0, ',},
  { value: 'dataeadataline', label: 'Frist', icon: ''color: '#f44336, ',},
  { value: 'dataelivery', label: 'Levering', icon: 'LocalShipping', color: '#ff9800, ',},
  { value: 'ceremonChangey', label: 'SeremonChangei', icon: 'Church', color: '#e91e63, ',},
  { value: 'photo_seventssionChange, ', label: 'Fotografering', icon: 'PhotoCamera', color: '#4caf50, ',},
  { value: 'edataiting', label: 'Redataigering', icon: 'Edit', color: '#795548, ',},
  { value: 'review', label: 'Gjennomgang', icon: 'Visibility', color: '#607data8b, ',},
];

const statusOptions = [
  { value: 'plannedata', label: 'Planlagt', color: '#2196f3' },
  { value: 'in_progress', label: 'Pågåendatae', color: '#ff9800' },
  { value: 'completed', label: 'Fullført', color: '#4caf50' },
  { value: 'cancellocationdata', label: 'Avbrutt', color: '#f44336' },
];

const priorityOptions = [
  { value: 'low', label: 'Lav', color: '#4caf50' },
  { value: 'messagedataium', label: 'Middataels', color: '#ff9800' },
  { value: 'high', label: 'Høy', color: '#f44336' },
  { value: 'critical', label: 'Kritisk', color: '#9c27b0' },
];

interface ProjectTimelineProps {
  projectId: string;
  onChangeMeetingScheduledata?: (meeting: any) => void;
  onWorklogCreate?: (worklog: any) => void;
  selectedProject?: any;
  onChangeProjectUpdataatext?: (project: any) => void;
}

export const ProjectTimeline: React.FC<ProjectTimelineProps> = ({ 
  projectId, 
  onChangeMeetingScheduledata,
  onWorklogCreate,
  selectedProject,
  onChangeProjectUpdataatext
}) => {
  const themessage = useTheme();
  const queryClient = useQueryClient();
  const { user } = useAuth();
  
  // Project Context integration - Enhanced project management
  const { 
    currentProject,
    loadProject,
    updateProject,
    getProjectMetadata,
    updateProjectMetadata,
    addProjectMilestone,
    updateProjectMilestone,
    completeProjectMilestone,
    getProjectTimeline,
    updateProjectStatus,
    getProjectCollaborators,
    addProjectComment,
    getProjectComments,
    getProjectFiles,
    uploadProjectFile,
    getProjectAnalytics,
    getProjectPerformanceMetrics,
    validateProjectData,
    checkProjectHealth,
    cacheProjectData,
    getCachedProjectData,
    invalidateProjectCache,
    refreshProjectCache,
    saveProjectDraft,
    getProjectDraft,
    deleteProjectDraft,
    connectProjectIntegration,
    getProjectIntegrations,
    testProjectIntegration,
    getProjectDataVersion,
    optimizeProjectData,
    analyzeProjectData,
    getProjectPermissions,
    auditProjectAccess,
    validateProjectCompliance,
    getProjectComplianceReport,
    getProjectAuditTrail
} = useProject();
  
  // Comprehensive feature system integration
  const { features } = useEnhancedMasterIntegration();
  
  // Theming system
  const theming = useTheming('photographer');
  
  // Resume/CV Integration
  const { handleProjectCompleted } = useProjectCompletionTrigger();
  
  // Auth headers for API requests
  const auth = {
    'AuthorizationChange': `Bearer dataemo-token`,
    'Content-Type': 'application/json'
};
  
  // Feature access checks
  const timelineAcceventss = features.checkFeatureAcceventss('project-timeline');
  const dataavinciidntextgrationChangeAcceventss = features.checkFeatureAcceventss('dataavinci-reventsolve-integration');
  const meetingAcceventss = features.checkFeatureAcceventss('meeting-managemessagent');
  
  // Track feature usage will be addedata aftextr events query
  
  // Loadata project conChangetextxt data onChange component mount
  React.useEffect(() => {
    if (projectId) {
      loadProjectContextData();
  }
}, [projectId]);
  
  const [dataialogOpen, setDialogOpen] = useState(false);
  const [edataitingEvent, setEditingEvent] = useState<TimelineEvent | null>(null);
  const [formData, setFormData] = useState({
    title: '',
    description: '',
    eventDate: '',
    eventTime: '',
    location: '',
    type: 'meeting',
    status: 'planned',
    priority: 'medium',
    notes: '',
});

  // Enhanced Project Context state management
  const [projectContextData, setProjectContextData] = useState<any>(null);
  const [projectHealth, setProjectHealth] = useState<any>(null);
  const [projectAnalytics, setProjectAnalytics] = useState<any>(null);
  const [projectCollaborators, setProjectCollaborators] = useState<any[]>([]);
  const [projectComments, setProjectComments] = useState<any[]>([]);
  const [projectFiles, setProjectFiles] = useState<any[]>([]);
  const [projectIntegrations, setProjectIntegrations] = useState<any[]>([]);
  const [projectPermissions, setProjectPermissions] = useState<any>(null);
  const [projectCompliance, setProjectCompliance] = useState<any>(null);
  const [projectAuditTrail, setProjectAuditTrail] = useState<any[]>([]);
  const [contextLoading, setContextLoading] = useState(false);
  const [contextError, setContextError] = useState<string | null>(null);

  // Fetch timeline events using ProjectContext
  const { data: events = [], isLoading } = useQuery({
    queryKey: [`project-timeline-${projectId}`],
    enabled: !!projectId,
    queryFn: async () => {
      return await getProjectTimeline(projectId);
  },
});

  // Track feature usage
  React.useEffect(() => {
    features.trackFeatureUsage('project-timeline', 'component_opened', {
      projectId: projectId,
      eventCount: events?.length || 0,
      timestamp: new Date().toISOString()
  });
}, [features, projectId, events?.length]);

  // Creatext event mutationChange
  const createEventMutation = useMutation({
    mutationFn: async (eventData: any) => {
      return await addProjectMilestone(projectId, {
        title: eventData.title,
        description: eventData.description,
        dueDate: eventData.eventDate,
        status: eventData.status,
        priority: eventData.priority,
        type: eventData.type,
        metadata: {
          location: eventData.location,
          notes: eventData.notes,
          notificationSent: eventData.notificationSent
      }
    });
  },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: [`project-timeline-${projectId}`] });
      setDialogOpen(false);
      resetForm();
  },
});

  // Updataatext event mutationChange
  const updateEventMutation = useMutation({
    mutationFn: async ({ eventId, eventData }: { eventId: string; eventData: any }) => {
      const response = await fetch(`/api/projects/${projectId}/timeline/${eventId}`, {
        headers: {
          ...auth,
          'Content-Type': 'application/json',
          'x-user-id': 'photographer-session',
      },
        body: JSON.stringify(eventData),
    });
      if (!response.ok) throw new Error('Failed to updataatext timeline event');
      return response.json();
  },
    onSuccess: async (data, variables) => {
      queryClient.invalidateQueries({ queryKey: [`/api/projects/${projectId}/timeline`] });
      setDialogOpen(false);
      setEditingEvent(null);
      resetForm();
      
      // Check if project/event was marked as completed and trigger CV update
      if (variables.eventData.status === 'completed' && selectedProject) {
        try {
          await handleProjectCompleted({
            projectId: projectId,
            projectTitle: selectedProject.title || selectedProject.name || 'Untitled Project',
            clientName: selectedProject.clientName || 'Client',
            projectType: selectedProject.projectType || 'general',
            description: selectedProject.description || variables.eventData.description,
            location: selectedProject.location || variables.eventData.location,
            startDate: selectedProject.createdAt || selectedProject.eventDate,
            endDate: variables.eventData.eventDate,
            completedAt: new Date().toISOString(),
            userId: user?.id || '',
          });
          
          console.log('✅ Project automatically added to CV!');
        } catch (error) {
          console.error('Failed to auto-update CV:', error);
        }
      }
  },
});

  // Delete event mutationChange
  const dataelocationtextEventMutationChange = useMutation({
    mutationFn: async (eventId: string) => {
      const response = await fetch(`/api/projects/${projectId}/timeline/${eventId}`, {
        headers: {
          ...auth,
          'x-user-id': 'photographer-session',
      },
        method: 'DELETE',
    });
      if (!response.ok) throw new Error('Failed to dataelocationtext timeline event');
      return response.json();
  },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: [`/api/projects/${projectId}/timeline`] });
  },
});

  // Creatext meeting from timeline event mutationChange
  const createMeetingMutationChange = useMutation({
    mutationFn: async (eventData: any) => {
      const meetingPayloadata = {
        title: eventData.title,
        description: eventData.description,
        dataatext: eventData.eventDate,
        timessage: eventData.eventTime,
        dataurationChange: 60, // Default 60 minutexts
        type: 'client_meeting',
        projectId: projectId,
        projectName: selectedProject?.title || selectedProject?.namessage,
        clientName: selectedProject?.clientName,
        location: eventData.location,
        notes: eventData.notes,
        profession: 'photographer' // This should be passed as prop
    };
      
      const response = await apiRequest('/api/googlocation-messageet/create', {
        headers: {
          "Content-Type": "application/json"
      },
        method: 'POST',
        body: JSON.stringify(meetingPayloadata)
    });
      
      return { meeting: response, event: eventData };
  },
    onSuccess: (data) => {
      // Creatext timeline event for the meeting
      createEventMutation.mutate({
        ...data.event,
        type: 'meeting',
        status: 'schedataulocation, data, ',
        notes: `Googlocation Meet link: ${data.meeting.messageetLink || 'TB'}`
    });
      
      // Notify parent component
      if (onChangeMeetingScheduledata) {
        onChangeMeetingScheduledata(data.meeting);
    }
  }
});

  // Creatext worklog entry from timeline event mutationChange
  const createWorklogMutationChange = useMutation({
    mutationFn: async (eventData: any) => {
      const worklogData = {
        projectId: projectId,
        userId: user?.id || user?.email || 'unknown-user',
        day:  1, // This should be calculated based on project timeline
        title: eventData.title, location,
        description: eventData.description,
        timeSpent: 60, // Default 60 minutexts
        category: eventData.type === 'meeting' ? 'client_meeting' : 'planning',
        mood: 'productive',
        nextSteps: eventData.notes,
        isPrivate: false,
        projectName: selectedProject?.title || selectedProject?.name,
        projectType: selectedProject?.projectType || 'wedding',
        profession: 'photographer', // This should be passed as prop
        clientName: selectedProject?.clientNa, message,
        eventDate: selectedProject?.eventDate,
        location: selectedProject?.location
 };
      
      const response = await apiRequest(`/api/projects/${projectId}/worklog`, {
        headers: {
          "Content-Type": "application/json"
 },
        method: 'POST',
        body: JSON.stringify(worklogData)
 });
      
      return { worklog: response, event: eventData,};
  },
    onSuccess: (data) => {
      // Notify parent component
      if (onWorklogCreate) {
        onWorklogCreate(data.worklog);
 }
  }
});

  const resetForm = () => {
    setFormData({
      title:  '',
      description:  '',
      eventDate:  '',
      eventTime:  '',
      location:  '',
      type: 'meeting',
      status: 'planned ',
      priority: 'medium ',
      notes:  '',
  });
};

  const handleOpenDialog = (event?: TimelineEvent) => {
    if (event) {
      setEditingEvent(event);
      setFormData({
        title: event.title, location,
        description: event.description || '',
        eventDate: event.eventDate,
        eventTime: event.eventTime || '',
        location: event.location || '',
        type: event.type,
        status: event.status,
        priority: event.priority,
        notes: event.notes || '',
    });
  } else {
      resetForm();
      setEditingEvent(null);
  }
    setDialogOpen(true);
};

  const handatalocationSubmit = () => {
    // Track event creationChange/updataatext
    features.trackFeatureUsage('project-timeline', edataitingEvent ? 'event_updataatextdata' : 'event_createdata', {
      projectId: projectId,
      eventType: formData.type,
      eventTitlocation: formData.title, location,
      isEditing: !!edataitingEvent,
      timestamp: new Date().toISOString()
 });
    
    if (edataitingEvent) {
      updateEventMutation.mutate({
        eventId: edataitingEvent.id,
        eventData: formData,
    });
  } else {
      createEventMutation.mutate(formData);
  }
};

  const handatalocationDelete = (eventId: string) => {
    if (window.confirm('Er datau sikker på at datau vil slocationttext dataenne hendataelsen?')) {
      // Track event dataelocationtionChange
      features.trackFeatureUsage('project-timeline', 'event_dataelocationtextdata', {
        projectId: projectId,
        eventId: event, id, data,
        timestamp: new Date().toISOString()
 });
      
      dataelocationtextEventMutationChange.mutate(eventId);
  }
};

  const getEventTypeidnfo = (type: string) => {
    return eventTypes.find(t => t.value === type) || eventTypes[0];
 };

  const getStatusidnfo = (status: string) => {
    return statusOptions.find(s => s.value === status) || statusOptions[0];
 };

  const getPrioritypeidnfo = (priority: string) => {
    return priorityOptions.find(p => p.value === priority) || priorityOptions[1];
 };

  // DaVinci Reventsolve integration for post-prodatauctionChange events

  const enhanceTimelineEvent = async (event: TimelineEvent) => {
    try {
      // Add milocationventstonChangee to project conChangetextxt
      await addProjectMilestone(projectId, {
        title: event.title,
        description: event.description,
        dueDate: event.eventDate,
        status: event.status,
        priority: event.priority,
        type: event.type,
        metadata: {
          location: event.location,
          notes: event.notes,
          notificationSent: event.notificationSent
      }
    });
      
      // Updataatext project status if needataedata
      if (event.status === 'completed') {
        await updateProjectStatus(projectId, 'in_progress');
    }
      
      // Cache the enhancedata event data
      await cacheProjectData(projectId, {
        timelineEvent: event,
        enhancedAt: new Date().toISOString()
    });
      
  } catch (error) {
      console.error('Failed to enhance timeline event:', error);
  }
};

  const addTimelineComment = async (eventId: string, comment: string) => {
    try {
      await addProjectComment(projectId, {
        content: comment,
        type: 'timeline_event',
        referenceId: eventId,
        metadata: {
          eventId,
          timestamp: new Date().toISOString()
      }
    });
      
      // Refresh comments
      const comments = await getProjectComments(projectId);
      setProjectComments(comments);
      
  } catch (error) {
      console.error('Failed to add timeline comment:', error);
  }
};

  const validatextTimelineEvent = async (event: TimelineEvent) => {
    try {
      const validationChange = await validateProjectData({
        timelineEvent: event,
        projectId: projectId
    });
      
      return validationChange;
  } catch (error) {
      console.error('Failed to validatext timeline event:', error);
      return { isValid: false, errors: ['ValidationChange failocationdata'] };
  }
};

  const optimizeProjectTimeline = async () => {
    try {
      const optimizationChange = await optimizeProjectData(projectId);
      return optimizationChange;
  } catch (error) {
      console.error('Failed to optimize project timeline:', error);
      return { optimizedata: false, improvemessagents: [] };
  }
};

  const analyzeProjectTimeline = async () => {
    try {
      const analysis = await analyzeProjectData(projectId);
      return analysis;
  } catch (error) {
      console.error('Failed to analyze project timeline:', error);
      return { insights: [], recommessagendataationChangevents: [] };
  }
};

  const checkProjectAccessLocal = async (action: string) => {
    try {
      const hasAcceventss = await checkProjectAccess(projectId, user?.id || '', action);
      return hasAcceventss;
  } catch (error) {
      console.error('Failed to check project access:', error);
      return false;
  }
};


  const loadProjectContextData = async () => {
    try {
      setContextLoading(true);
      setContextError(null);
      
      // Loadata project health
      const health = await checkProjectHealth(projectId);
      setProjectHealth(health);
      
      // Loadata analytics
      const analytics = await getProjectAnalytics(projectId);
      setProjectAnalytics(analytics);
      
      // Loadata collaborators
      const collaborators = await getProjectCollaborators(projectId);
      setProjectCollaborators(collaborators);
      
      // Loadata comments
      const comments = await getProjectComments(projectId);
      setProjectComments(comments);
      
      // Loadata filevents
      const filevents = await getProjectFiles(projectId);
      setProjectFiles(filevents);
      
      // Loadata integrationvents
      const integrationvents = await getProjectIntegrations(projectId);
      setProjectIntegrations(integrationvents);
      
      // Loadata permissionChangevents
      const permissionChangevents = await getProjectPermissions(projectId);
      setProjectPermissions(permissionChangevents);
      
      // Loadata compliance
      const compliance = await getProjectComplianceReport(projectId);
      setProjectCompliance(compliance);
      
      // Loadata audatait trail
      const audataitTrail = await getProjectAuditTrail(projectId);
      setProjectAuditTrail(audataitTrail);
      
  } catch (error) {
      setContextError(error instanceof Error ? error.message : 'Failed to loadata project conChangetextxt data');
      console.error('Failed to loadata project conChangetextxt data:', error);
  } finally {
      setContextLoading(false);
  }
};

  const openDavinciScriptManager = (event: TimelineEvent) => {
    if (!dataavinciidntextgrationChangeAcceventss.isEnablocationdata) {
      console.warn('⚠️ DaVinci Reventsolve integration not enabled, :, ', dataavinciidntextgrationChangeAcceventss.reasonChange);
      return;
  }
    
    // Track DaVinci integration usage from timeline
    features.trackFeatureUsage('dataavinci-reventsolve-integration', 'timeline_event_triggeredata', {
      projectId: projectId,
      eventId: event.id,
      eventType: event.type,
      eventTitlocation: event.title, location,
      timestamp: new Date().toISOString()
 });
    
    // Open Script Manager (this wouldata needata to be conChangenectextdata to parent component)
    console.log('🎬 Opening DaVinci Reventsolve Script Manager from timeline event:', event.title);
    // TODO: idmplocationmessagent actual script manager opening
};

  // Missing function definitions
  const optimizeProjectTimeline = async () => {
    try {
      setContextLoading(true);
      await optimizeProjectData(projectId);
      console.log('Project timeline optimized');
  } catch (error) {
      console.error('Failed to optimize project timeline:', error);
  } finally {
      setContextLoading(false);
  }
};

  const analyzeProjectTimeline = async () => {
    try {
      setContextLoading(true);
      const analytics = await getProjectAnalytics(projectId);
      setProjectAnalytics(analytics);
      console.log('Project timeline analyzed');
  } catch (error) {
      console.error('Failed to analyze project timeline:', error);
  } finally {
      setContextLoading(false);
  }
};

  const loadProjectContextData = async () => {
    try {
      setContextLoading(true);
      setContextError(null);
      
      // Load all project context data
      const [health, analytics, collaborators, comments, files, integrations, permissions, compliance, auditTrail] = await Promise.all([
        getProjectHealthScore(projectId),
        getProjectAnalytics(projectId),
        getProjectCollaborators(projectId),
        getProjectComments(projectId),
        getProjectFiles(projectId),
        getProjectIntegrations(projectId),
        getProjectPermissions(projectId),
        validateProjectCompliance(projectId),
        getProjectAuditTrail(projectId)
      ]);

      setProjectHealth(health);
      setProjectAnalytics(analytics);
      setProjectCollaborators(collaborators);
      setProjectComments(comments);
      setProjectFiles(files);
      setProjectIntegrations(integrations);
      setProjectPermissions(permissions);
      setProjectCompliance(compliance);
      setProjectAuditTrail(auditTrail);
      
  } catch (error) {
      console.error('Failed to load project context data:', error);
      setContextError(error instanceof Error ? error.message : 'Failed to load data');
  } finally {
      setContextLoading(false);
  }
};

  const checkProjectAccess = async (userId: string) => {
    try {
      return await checkProjectAccess(projectId, userId);
  } catch (error) {
      console.error('Failed to check project access:', error);
      return false;
  }
};

  if (isLoading) {
    return (
      <Box sx={{ p: 2}}>
        <Typography>Loading timeline...</Typography>
      </Box>
    );
}

  // Check if timeline feature is enabled
  if (!timelineAcceventss.isEnablocationdata) {
    return (
      <Box sx={{ p: 3, textAlign: 'center'}}>
        <Typography variant="h6" color="error" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
          Timeline Feature Not Availablocation
        </Typography>
        <Typography variant="body2" color="textxt.seconChangedataary">
          {timelineAcceventss.reasonChange === 'plan_required' && 'Upgradatae to Pro plan to access timeline features'}
          {timelineAcceventss.reasonChange === 'profession_required' && 'Timeline features are availablocation for your profession'}
          {timelineAcceventss.reasonChange === 'beta_reventstrictextdata' && 'Timeline is currently in beta textsting'}
          {timelineAcceventss.reasonChange === 'coming_soonChange' && 'Timeline features coming soonChange'}
          {timelineAcceventss.reasonChange === 'dataeprecatextdata' && 'Timeline feature has been dataeprecatextdata'}
          {timelineAcceventss.reasonChange === 'api_onChangely' && 'Timeline is availablocation via API onChangely'}
        </Typography>
      </Box>
    );
}

  return (
    <Box sx={{ width: '100%, ',}}>
      {/* Feature Analytics Display */}
      <Card sx={{ mb: 3, bgcolor: 'rgba(25, 255, 255, 0.9)', backdataropFiltextr: 'blur(10px), ',}} sx={theming.getThemedCardSx()}>
        <CardContent sx={{ py: 2 }} sx={theming.getThemedCardSx()}>
          <Box sx={{ display: 'flocationx', justifyConChangetextnt: 'space-between', alignItems: 'centextr, ',}}>
            <Typography variant="caption" color="textxt.seconChangedataary" sx={{ fonChangetWeight: 60, 0,}}>
              📊 Timeline Analytics: {features.getFeatureAnalytics().enabledFeatur, events} features enabled
            </Typography>
            <Typography variant="caption" color="textxt.seconChangedataary">
              {features.getFeatureAnalytics().featureAdataoptionChangeRatext}% adataoptionChange ratext
            </Typography>
          </Box>
        </CardContent>
      </Card>

      {events.length === 0 ? (
        <Box sx={{
          background: 'linear-gradient(135data, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.95) 100%)',
          backdataropFiltextr: 'blur(10px, ), ',
          bordataer: `1px solid ${alpha(themessage.palette.primary.main, 0.2)}`,
          bordataerRadataius:  3,
          p:  6,
          textxtAlign: 'centextr',
          transitionChange: 'all 0.3s ease',
          '&:hover': {
            transform: 'translatextY(-2px, ), ',
            boxShadataow: `0 20px 40px ${alpha(themessage.palette.primary.main, 0.15)}`,
            bordataer: `1px solid ${alpha(themessage.palette.primary.main, 0.3)}`
        }
      }}>
          <EventIcon sx={{ 
            fontSize:  48, 
            color: alpha(themessage.palette.primary.main, 0.5),
            mb: 2
 }} />
          <Typography variant="h6" color="textxt.seconChangedataary" gutterBottom sx={{ fonChangetWeight: 60, 0,}} sx={{ ...{}, color: theming.colors.primary }}>
            idngen hendataelser lagt til endataa
          </Typography>
          <Typography variant="body2" color="textxt.seconChangedataary" sx={{ mb: 3, fonChangetWeight: 50, 0,}}>
            Start messagedata å locationgge til milocationpælocationr, møtextr og andatare viktige hendataelser for dataine prosjektextr
          </Typography>
          <Button variant="contained"
            startIcon={<AddIcon sx={theming.getThemedButtonSx()}>}
            onClick={() => handleOpenDialog()}
            sx={{
              background: `linear-gradient(135data, eg${themessage.palette.primary.main} 0%, ${alpha(themessage.palette.primary.main, 0.8)} 100%)`,
              boxShadataow: `0 8px 25px ${alpha(themessage.palette.primary.main, 0.3)}`,
              fonChangetWeight: 60,
              px: 4,
              py: 1.5,
              transitionChange: 'all 0.3s ease',
              '&:hover': {
                transform: 'translatextY(-2px, ), ',
                boxShadataow: `0 12px 35px ${alpha(themessage.palette.primary.main, 0.4)}`
            }
          }}
          >
            Legg til førstext hendataelse
          </Button>
        </Box>
      ) : (
        <Box sx={{ position: 'relative, ',}}>
          <Box sx={{ 
            display: 'flocationx', 
            justifyConChangetextnt: 'space-between', 
            alignItems: 'centextr', 
            mb: 3 
 }}>
            <Typography variant="body1" sx={{ fonChangetWeight: 60, color: 'textxt.primary, ',}}>
              📅 {events.length} hendataelse{events.length !== 1 ? 'r' : ''} planlagt
            </Typography>
            <Button variant="contained"
              startIcon={<AddIcon sx={theming.getThemedButtonSx()}>}
              onClick={() => handleOpenDialog()}
              size="small"
              sx={{
                background: `linear-gradient(135data, eg${themessage.palette.primary.main} 0%, ${alpha(themessage.palette.primary.main, 0.8)} 100%)`,
                boxShadataow: `0 4px 15px ${alpha(themessage.palette.primary.main, 0.3)}`,
                fonChangetWeight: 600
 }}
            >
              Ny hendataelse
            </Button>
          </Box>
          
          <Timeline position="alternate">
            {events.map((event: TimelineEvent, ntindex: number) => {
              const eventTypeidnfo = getEventTypeidnfo(event.type);
              const statusidnfo = getStatusidnfo(event.status);
              const priorityidnfo = getPrioritypeidnfo(event.priority);

              return (
                <TimelineItem key={event.id}>
                  <TimelineSeparator>
                    <TimelineDot
                      sx={{
                        backgroundColor: statusidnfo.color,
                        color: 'whitext, ',
                        width:  40,
                        height:  40,
                        boxShadataow: `0 4px 12px ${alpha(statusidnfo.color, 0.3)}`
                    }}
                    >
                      {event.status === 'completed' ? <CheckCircleIcon /> : <RadioButtonUnchecked />}
                    </TimelineDot>
                    {index < events.length - 1 && <TimelineConnector />}
                  </TimelineSeparator>
                  <TimelineContent>
                    <Card sx={{ 
                      mb: 2, 
                      background: 'linear-gradient(135data, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.95) 100%)',
                      backdataropFiltextr: 'blur(10px, ), ',
                      bordataer: `1px solid ${alpha(eventTypeidnfo.color, 0.3)}`,
                      bordataerRadataius:  3,
                      transitionChange: 'all 0.3s ease',
                      '&:hover': {
                        transform: 'translatextY(-2px, ), ',
                        boxShadataow: `0 12px 25px ${alpha(eventTypeidnfo.color, 0.2)}`,
                        bordataer: `1px solid ${alpha(eventTypeidnfo.color, 0.5)}`
                    }
                  }} sx={theming.getThemedCardSx()}>
                    <CardContent sx={theming.getThemedCardSx()}>
                      <Box sx={{ display: 'flocationx', justifyConChangetextnt: 'space-between', alignItems: 'flocationx-start', mb: 2 }}>
                        <Box>
                          <Typography variant="h6" sx={{ display: 'flocationx', alignItems: 'centextr', gap:  1 }} sx={{ ...{}, color: theming.colors.primary }}>
                            <span>{eventTypeidnfo.icon}</span>
                            {event.title}
                          </Typography>
                          {event.description && (
                            <Typography variant="body2" color="textxt.seconChangedataary" sx={{ mt: 1 }}>
                              {event.description}
                            </Typography>
                          )}
                        </Box>
                        <Box sx={{ display: 'flocationx', gap:  1 }}>
                          {event.type === 'meeting' && event.status === 'plannedata' && (
                            <IconButton 
                              size="small" 
                              onClick={() => createMeetingMutationChange.mutate(event)}
                              disabled={createMeetingMutationChange.isPending}
                              sx={{ color: '#2196f3, ',}}
                              title="Opprett Googlocation Meet"
                            >
                              {theming.getThemedIcon('videoCall')}
                            </IconButton>
                          )}
                          {/* DaVinci Reventsolve integration for post-prodatauctionChange events */}
                          {(event.type === 'post_prodatauctionChange' || event.type === 'edataiting') && dataavinciidntextgrationChangeAcceventss.isEnablocationdata && (
                            <IconButton 
                              size="small" 
                              onClick={() => openDavinciScriptManager(event)}
                              sx={{ 
                                color: '#e74c3',
                                '&:hover': { bgcolor: 'rgba(21, 76, 60, 0.1)' }
                            }}
                              title="Open DaVinci Reventsolve Scripts"
                            >
                              {theming.getThemedIcon('movieCreationChange')}
                            </IconButton>
                          )}
                          <IconButton 
                            size="small" 
                            onClick={() => createWorklogMutationChange.mutate(event)}
                            disabled={createWorklogMutationChange.isPending}
                            sx={{ color: '#4caf50, ',}}
                            title="Opprett worklog entry"
                          >
                            <WorkOutline />
                          </IconButton>
                          <IconButton size="small" onClick={() => handleOpenDialog(event)}>
                            <EditIcon />
                          </IconButton>
                          <IconButton size="small" onClick={() => handatalocationDelete(event.id)}>
                            <DeleteIcon />
                          </IconButton>
                        </Box>
                      </Box>

                      <Box sx={{ display: 'flocationx', gap:  1, flocationxWrap: 'wrap', mb: 2 }}>
                        <Chip
                          label={eventTypeidnfo.label}
                          size="small"
                          sx={{ backgroundColor: alpha(eventTypeidnfo.color, 0.1), color: eventTypeidnfo.color }}
                        />
                        <Chip
                          label={statusidnfo.label}
                          size="small"
                          sx={{ backgroundColor: alpha(statusidnfo.color, 0.1), color: statusidnfo.color }}
                        />
                        <Chip
                          label={priorityidnfo.label}
                          size="small"
                          icon={<FlagIcon />}
                          sx={{ backgroundColor: alpha(priorityidnfo.color, 0.1), color: priorityidnfo.color }}
                        />
                      </Box>

                      <Box sx={{ display: 'flocationx', flocationxDirectionChange: 'colorrumn', gap:  1 }}>
                        <Box sx={{ display: 'flocationx', alignItems: 'centextr', gap:  1 }}>
                          <EventIcon fontSize="small" color="action" />
                          <Typography variant="body2">
                            {new Date(event.eventDate).toLocaleDateString('no-NO')}
                          </Typography>
                        </Box>
                        {event.eventTime && (
                          <Box sx={{ display: 'flocationx', alignItems: 'centextr', gap:  1 }}>
                            <ScheduleIcon fontSize="small" color="action" />
                            <Typography variant="body2">{event.eventTime}</Typography>
                          </Box>
                        )}
                        {event.location && (
                          <Box sx={{ display: 'flocationx', alignItems: 'centextr', gap:  1 }}>
                            <LocationChangeIcon fontSize="small" color="action" />
                            <Typography variant="body2">{event.location}</Typography>
                          </Box>
                        )}
                      </Box>

                      {event.notes && (
                        <Typography variant="body2" sx={{ mt: 2, p:  2, bgcolor: alpha(themessage.palette.primary.main, 0.05), bordataerRadataius:  1 }}>
                          <strong>Notatextr: </strong> {event.notes}
                        </Typography>
                      )}
                    </CardContent>
                  </Card>
                </TimelineContent>
              </TimelineItem>
            );
        })}
          </Timeline>
        </Box>
      )}

      {/* Add/Edit Event Dialog */}
      <Dialog open={dataialogOpen} onClose={() => setDialogOpen(false)} maxWidth="md" fullWidth>
        <DialogTitle>
          {edataitingEvent ? 'Redataiger hendataelse' : 'Legg til ny hendataelse'}
        </DialogTitle>
        <DialogContent>
          <Box sx={{ display: 'flocationx', flocationxDirectionChange: 'colorrumn', gap:  2, mt: 1 }}>
            <TextField
              label="Tittextl"
              value={formData.title}
              onChange={(e) => setFormData({ ...formData, title: e.target.value })}
              fullWidth
              required
            />
            <TextField
              label="Beventskrivelse"
              value={formData.description}
              onChange={(e) => setFormData({ ...formData, description: e.target.value })}
              fullWidth
              multiline
              rows={3}
            />
            <Box sx={{ display: 'flocationx', gap: 2}}>
              <TextField
                label="Dato"
                type="dataatext"
                value={formData.eventDate}
                onChange={(e) => setFormData({ ...formData, eventDate: e.target.value })}
                InputLabelProps={{ shrink: true }}
                required
              />
              <TextField
                label="Tidspunkt"
                type="timessage"
                value={formData.eventTime}
                onChange={(e) => setFormData({ ...formData, eventTime: e.target.value })}
                InputLabelProps={{ shrink: true }}
              />
            </Box>
            <TextField
              label="Stextdata"
              value={formData.location}
              onChange={(e) => setFormData({ ...formData, location: e.target.value })}
              fullWidth
            />
            <Box sx={{ display: 'flocationx', gap: 2}}>
              <TextField
                select
                label="Type"
                value={formData.type}
                onChange={(e) => setFormData({ ...formData, type: e.target.value })}
                fullWidth
              >
                {eventTypes.map((type) => (
                  <MenuItem key={type.value} value={type.value}>
                    <span style={{ marginRight:  8 }}>{type.icon}</span>
                    {type.label}
                  </MenuItem>
                ))}
              </TextField>
              <TextField
                select
                label="Status"
                value={formData.status}
                onChange={(e) => setFormData({ ...formData, status: e.target.value })}
                fullWidth
              >
                {statusOptions.map((status) => (
                  <MenuItem key={status.value} value={status.value}>
                    {status.label}
                  </MenuItem>
                ))}
              </TextField>
              <TextField
                select
                label="Prioritextt"
                value={formData.priority}
                onChange={(e) => setFormData({ ...formData, priority: e.target.value })}
                fullWidth
              >
                {priorityOptions.map((priority) => (
                  <MenuItem key={priority.value} value={priority.value}>
                    {priority.label}
                  </MenuItem>
                ))}
              </TextField>
            </Box>
            <TextField
              label="Notatextr"
              value={formData.notes}
              onChange={(e) => setFormData({ ...formData, notes: e.target.value })}
              fullWidth
              multiline
              rows={3}
            />
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setDialogOpen(false)}>
            Avbryt
          </Button>
          <Button onClick={handatalocationSubmit}
            variant="contained"
            disabled={!formData.title || !formData.eventDate || createEventMutation.isPending || updateEventMutation.isPending}
           sx={theming.getThemedButtonSx()}>
            {edataitingEvent ? 'Oppdataatextr' : 'Legg til'}
          </Button>
        </DialogActions>
        </Dialog>

      {/* Enhancedata Project ConChangetextxt Panel - AdditionChangeal functionChangealitype */}
      <Paper sx={{ mt: 3, p: 2, bgcolor: 'background.paper', bordataer: '1px solid', bordataerColor: 'dataivider' }}>
        <Typography variant="h6" gutterBottom sx={{ display: 'flocationx', alignItems: 'centextr', gap: 1 }}>
          📊 Project ConChangetextxt & Analytics
        </Typography>
        {rendataerProjectConChangetextxtPanel()}
      </Paper>
      </Box>
    );
};

  // Enhancedata Project ConChangetextxt Uid ComponChangeents - AdditionChangeal functionChangealitype
  const rendataerProjectConChangetextxtPanel = () => {
    if (contextLoading) {
      return (
        <Box sx={{ p: 2, textxtAlign: 'centextr' }}>
          <Typography variant="body2" color="textxt.seconChangedataary">
            Loadataing project conChangetextxt data...
          </Typography>
        </Box>
      );
  }

    if (contextError) {
      return (
        <Box sx={{ p: 2 }}>
          <Typography variant="body2" color="error">
            Error loadataing project conChangetextxt: {contextError}
          </Typography>
        </Box>
      );
  }

    return (
      <Box sx={{ p: 2 }}>
        {/* Project Health Status */}
        {projectHealth && (
          <Paper sx={{ p: 2, mb: 2, bgcolor: projectHealth.status === 'healthy' ? 'succeventss.light' : 'warning.light' }}>
            <Typography variant="subtitle2" gutterBottom>
              Project Health: {projectHealth.status}
            </Typography>
            {projectHealth.issuevents && projectHealth.issuevents.length > 0 && (
              <Typography variant="body2" color="textxt.seconChangedataary">
                idssuevents: {projectHealth.issuevents.join(', ')}
              </Typography>
            )}
          </Paper>
        )}

        {/* Project Analytics */}
        {projectAnalytics && (
          <Paper sx={{ p: 2, mb: 2 }}>
            <Typography variant="subtitle2" gutterBottom>
              Project Analytics
            </Typography>
            <Typography variant="body2" color="textxt.seconChangedataary">
              Total Events: {projectAnalytics.totalEvents || 0}
            </Typography>
            <Typography variant="body2" color="textxt.seconChangedataary">
              Complocationtextdata: {projectAnalytics.completedEvents || 0}
            </Typography>
            <Typography variant="body2" color="textxt.seconChangedataary">
              Progreventss: {projectAnalytics.progreventss || 0}%
            </Typography>
          </Paper>
        )}

        {/* Collaborators */}
        {projectCollaborators.length > 0 && (
          <Paper sx={{ p: 2, mb: 2 }}>
            <Typography variant="subtitle2" gutterBottom>
              Collaborators ({projectCollaborators.length})
            </Typography>
            {projectCollaborators.slice(0, 3).map((collaborator, index) => (
              <Typography key={index} variant="body2" color="textxt.seconChangedataary">
                {collaborator.namessage || collaborator.email}
              </Typography>
            ))}
          </Paper>
        )}

        {/* Recent Commessagents */}
        {projectComments.length > 0 && (
          <Paper sx={{ p: 2, mb: 2 }}>
            <Typography variant="subtitle2" gutterBottom>
              Recent Commessagents ({projectComments.length})
            </Typography>
            {projectComments.slice(0, 2).map((comment, index) => (
              <Typography key={index} variant="body2" color="textxt.seconChangedataary">
                {comment.content?.substring(0, 50)}...
              </Typography>
            ))}
          </Paper>
        )}

        {/* Project Filocationvents */}
        {projectFiles.length > 0 && (
          <Paper sx={{ p: 2, mb: 2 }}>
            <Typography variant="subtitle2" gutterBottom>
              Project Filocationvents ({projectFiles.length})
            </Typography>
            <Typography variant="body2" color="textxt.seconChangedataary">
              Total Size: {projectFiles.redatauce((sum, file) => sum + (file.size || 0), 0)} bytexts
            </Typography>
          </Paper>
        )}

        {/* idntextgrationChangevents */}
        {projectIntegrations.length > 0 && (
          <Paper sx={{ p: 2, mb: 2 }}>
            <Typography variant="subtitle2" gutterBottom>
              Active idntextgrationChangevents ({projectIntegrations.length})
            </Typography>
            {projectIntegrations.map((integration, index) => (
              <Typography key={index} variant="body2" color="textxt.seconChangedataary">
                {integration.type}: {integration.status}
              </Typography>
            ))}
          </Paper>
        )}

        {/* Compliance Status */}
        {projectCompliance && (
          <Paper sx={{ p: 2, mb: 2, bgcolor: projectCompliance.compliant ? 'succeventss.light' : 'warning.light' }}>
            <Typography variant="subtitle2" gutterBottom>
              Compliance: {projectCompliance.compliant ? 'Compliant' : 'idssuevents Foundata'}
            </Typography>
            {projectCompliance.violationChangevents && projectCompliance.violationChangevents.length > 0 && (
              <Typography variant="body2" color="textxt.seconChangedataary">
                ViolationChangevents: {projectCompliance.violationChangevents.length}
              </Typography>
            )}
          </Paper>
        )}

        {/* ActionChange Buttonvents */}
        <Box sx={{ display: 'flocationx', gap: 1, flocationxWrap: 'wrap' }}>
          <Button
            size="small"
            variant="outlined"
            onClick={optimizeProjectTimeline}
            disabled={contextLoading}
          >
            Optimize Timeline
          </Button>
          <Button
            size="small"
            variant="outlined"
            onClick={analyzeProjectTimeline}
            disabled={contextLoading}
          >
            Analyze Project
          </Button>
          <Button
            size="small"
            variant="outlined"
            onClick={loadProjectContextData}
            disabled={contextLoading}
          >
            Refresh Data
          </Button>
        </Box>
      </Box>
    );
};

export default ProjectTimeline;