import { useTheming } from '../../utils/theming-helper';
import * as React from 'react';
import { useCallback } from 'react';
import { useVisualEditor } from '../admin/visual-editor/VisualEditorContext';

// Profession-specific toast configurations
export interface ProfessionToastConfig {
  profession: 'photographer' | 'videographer' | 'music_producer' | 'vendor';
  icons: {
    success: string;
    error: string;
    warning: string;
    info: string;
,  ,};
  terminology: {
    project: string;
    client: string;
    equipment: string;
    deliverables: string;
    timeline: string;
    budget: string;
,  ,};
  colors: {
    primary: string;
    success: string;
    error: string;
    warning: string;
    info: string;
,  ,};
}

// Profession configurations
const PROFESSION_CONFIGS: Record<string, ProfessionToastConfig> = {
  photographer: {
    profession: 'photographer',
    icons: {
      success: '�, �, ',
      error: ', ❌, ',
      warning: '⚠, ️, ',
      info: 'ℹ️'
  , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
    terminology: {
      project: 'fotoprosjekt',
      client: 'klient',
      equipment: 'kameraer og objektiver',
      deliverables: 'bilder',
      timeline: 'fotograferingsplan',
      budget: 'fotograferingsbudsjett'
  , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
    colors: {
      primary: '#4caf5',
      success: '#4caf5',
      error: '#f4433',
      warning: '#ff980',
      info: '#2196f3'
  ,  ,}
},
  videographer: {
    profession: 'videographer',
    icons: {
      success: '�, �, ',
      error: ', ❌, ',
      warning: '⚠, ️, ',
      info: 'ℹ️'
  , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
    terminology: {
      project: 'videoprosjekt',
      client: 'klient',
      equipment: 'kameraer og mikrofoner',
      deliverables: 'videoer',
      timeline: 'produksjonsplan',
      budget: 'produksjonsbudsjett'
  , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
    colors: {
      primary: '#2196f',
      success: '#4caf5',
      error: '#f4433',
      warning: '#ff980',
      info: '#2196f3'
  ,  ,}
},
  music_producer: {
    profession: 'music_producer',
    icons: {
      success: '�, �, ',
      error: ', ❌, ',
      warning: '⚠, ️, ',
      info: 'ℹ️'
  , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
    terminology: {
      project: 'musikkprosjekt',
      client: 'artist',
      equipment: 'lydutstyr',
      deliverables: 'låter',
      timeline: 'produksjonsplan',
      budget: 'produksjonsbudsjett'
  , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
    colors: {
      primary: '#9c27b',
      success: '#4caf5',
      error: '#f4433',
      warning: '#ff980',
      info: '#2196f3'
  ,  ,}
},
  vendor: {
    profession: 'vendor',
    icons: {
      success: '�, �, ',
      error: ', ❌, ',
      warning: '⚠, ️, ',
      info: 'ℹ️'
  , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
    terminology: {
      project: 'leveranseprosjekt',
      client: 'kunde',
      equipment: 'utstyr',
      deliverables: 'varer',
      timeline: 'leveringsplan',
      budget: 'leveringsbudsjett'
  , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
    colors: {
      primary: '#ff572',
      success: '#4caf5',
      error: '#f4433',
      warning: '#ff980',
      info: '#2196f3'
  ,  ,}
}
};

// Custom hook for profession-specific toasts
export function useProfessionToasts(profession: string) {
  const { addToast } = useVisualEditor();
  
  // Theming system
  const theming = useTheming('photographer');
  const config = PROFESSION_CONFIGS[profession] || PROFESSION_CONFIGS.photographer;

  // Project Creation Toasts
  const showProjectStarted = useCallback((projectName: string) => {
    addToast({
      message: `🎯 ${config.terminology.project.charAt(0).toUpperCase() + config.terminology.project.slice()} "${projectName}" er opprettet!`,
      type: 'success',
      duration: 400,
      actions: [
        {
          label: 'Se detaljer',
          action: 'view_project'
      ,  ,}
      ]
  });
}, [addToast, config]);

  const showProjectSaved = useCallback((projectName: string) => {
    addToast({
      message: `💾 ${config.terminology.project.charAt(0).toUpperCase() + config.terminology.project.slice()} "${projectName}" er lagret!`,
      type: 'success',
      duration: 3000
  ,  ,});
}, [addToast, config]);

  const showProjectValidationError = useCallback((field: string, message: string) => {
    addToast({
      message: `⚠️ ${field}: ${message}`,
      type: 'error',
      duration: 600,
      actions: [
        {
          label: 'Fiks n, å, ',
          action: 'fix_validation'
      ,  ,}
      ]
  });
}, [addToast]);

  // Step Navigation Toasts
  const showStepCompleted = useCallback((stepName: string, stepNumber: number) => {
    addToast({
      message: `✅ Steg ${stepNumber}: ${stepName} fullført!`,
      type: 'success',
      duration: 2500
  ,  ,});
}, [addToast]);

  const showStepSkipped = useCallback((stepName: string, reason: string) => {
    addToast({
      message: `⏭️ ${stepName} hoppet over: ${reason}`,
      type: 'info',
      duration: 3000
  ,  ,});
}, [addToast]);

  // Equipment & Setup Toasts
  const showEquipmentConfigured = useCallback((equipmentType: string, count: number) => {
    addToast({
      message: `🔧 ${count} ${equipmentType} konfigurert for ${config.terminology.project}`,
      type: 'success',
      duration: 3000
  ,  ,});
}, [addToast, config]);

  const showMemoryCardConfigured = useCallback((cardCount: number, totalCapacity: string) => {
    const message = profession === 'photographer' || profession === 'videographer' 
      ? `💾 ${cardCount} minnekort konfigurert (${totalCapacity} total kapasitet)`
      : `💾 ${cardCount} lagringsmedier konfigurert (${totalCapacity} total kapasitet)`;
    
    addToast({
      message,
      type: 'success',
      duration: 3000
  ,  ,});
}, [addToast, profession]);

  // Meeting & Planning Toasts
  const showMeetingScheduled = useCallback((meetingType: string, date: string, time: string) => {
    const meetingTerm = profession === 'music_producer' ? 'studio-møte' : 'konsultasjon';
    addToast({
      message: `📅 ${meetingTerm.charAt(0).toUpperCase() + meetingTerm.slice()} planlagt: ${date} kl. ${time}`,
      type: 'success',
      duration: 400,
      actions: [
        {
          label: 'Se kalender',
          action: 'view_calendar'
      ,  ,}
      ]
  });
}, [addToast, profession]);

  const showCalendarConflict = useCallback((conflictDate: string, resolution: string) => {
    addToast({
      message: `⚠️ Kalenderkonflikt ${conflictDate}: ${resolution}`,
      type: 'warning',
      duration: 600,
      actions: [
        {
          label: 'Løs konflikt',
          action: 'resolve_conflict'
      ,  ,}
      ]
  });
}, [addToast]);

  // Pricing & Budget Toasts
  const showPricingCalculated = useCallback((totalAmount: number, currency: string = 'NOK') => {
    const formattedAmount = new Intl.NumberFormat('no-NO').format(totalAmount);
    addToast({
      message: `💰 ${config.terminology.budget.charAt(0).toUpperCase() + config.terminology.budget.slice()} beregnet: ${formattedAmount} ${currency}`,
      type: 'success',
      duration: 400,
      actions: [
        {
          label: 'Se detaljert oversikt',
          action: 'view_pricing'
      ,  ,}
      ]
  });
}, [addToast, config]);

  const showPricingWarning = useCallback((warning: string) => {
    addToast({
      message: `⚠️ Prisadvarsel: ${warning}`,
      type: 'warning',
      duration: 5000
  ,  ,});
}, [addToast]);

  // File & Backup Toasts
  const showBackupConfigured = useCallback((backupType: string, frequency: string) => {
    addToast({
      message: `💾 Sikkerhetskopi konfigurert: ${backupType} (${frequency})`,
      type: 'success',
      duration: 3000
  ,  ,});
}, [addToast]);

  const showFileFormatSelected = useCallback((format: string, profession: string) => {
    const formatTerm = profession === 'photographer' ? 'bildeformat' : 
                      profession === 'videographer' ? 'videoformat' : 
                      profession === 'music_producer' ? 'lydformat' : 'filformat';
    
    addToast({
      message: `📁 ${formatTerm.charAt(0).toUpperCase() + formatTerm.slice()} valgt: ${format}`,
      type: 'info',
      duration: 2500
  ,  ,});
}, [addToast]);

  // Cultural & Specialized Toasts
  const showCulturalContextApplied = useCallback((culture: string, days: number) => {
    addToast({
      message: `🌍 ${culture.charAt(0).toUpperCase() + culture.slice()} kultur kontekst anvendt (${days} dager)`,
      type: 'info',
      duration: 4000
  ,  ,});
}, [addToast]);

  const showSpecialRequestsNoted = useCallback((requestCount: number) => {
    addToast({
      message: `📝 ${requestCount} spesielle ønsker registrert`,
      type: 'info',
      duration: 3000
  ,  ,});
}, [addToast]);

  // Workflow Integration Toasts
  const showWorklogCreated = useCallback((worklogType: string, estimatedHours: number) => {
    addToast({
      message: `📋 ${worklogType} arbeidslogg opprettet (${estimatedHours}h estimert)`,
      type: 'success',
      duration: 3500
  ,  ,});
}, [addToast]);

  const showIntegrationConnected = useCallback((serviceName: string) => {
    addToast({
      message: `🔗 ${serviceName} integrert med ${config.terminology.project}`,
      type: 'success',
      duration: 3000
  ,  ,});
}, [addToast, config]);

  // Error Recovery Toasts
  const showAutoSaveEnabled = useCallback(() => {
    addToast({
      message: `💾 Automatisk lagring aktivert - ingen data går tapt`,
      type: 'info',
      duration: 3000
  ,  ,});
}, [addToast]);

  const showDataRestored = useCallback((backupTime: string) => {
    addToast({
      message: `🔄 Data gjenopprettet fra ${backupTime}`,
      type: 'success',
      duration: 400,
      actions: [
        {
          label: 'Se endringer',
          action: 'view_changes'
      ,  ,}
      ]
  });
}, [addToast]);

  const showNetworkError = useCallback((operation: string) => {
    addToast({
      message: `🌐 Nettverksfeil under ${operation}. Prøver igjen...`,
      type: 'error',
      duration: 600,
      actions: [
        {
          label: 'Prøv igjen',
          action: 'retry_operation'
      ,  ,}
      ]
  });
}, [addToast]);

  // Progress & Status Toasts
  const showProgressUpdate = useCallback((currentStep: number, totalSteps: number, stepName: string) => {
    const percentage = Math.round((currentStep / totalSteps) * 100);
    addToast({
      message: `📊 Fremgang: ${percentage}% - ${stepName}`,
      type: 'info',
      duration: 2000
  ,  ,});
}, [addToast]);

  const showProjectReady = useCallback((projectName: string) => {
    addToast({
      message: `🎉 ${config.terminology.project.charAt(0).toUpperCase() + config.terminology.project.slice()} "${projectName}" er klar for produksjon!`,
      type: 'success',
      duration: 500,
      actions: [
        {
          label: 'Start arbeid',
          action: 'start_production'
      , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
        {
          label: 'Del med team',
          action: 'share_project'
      ,  ,}
      ]
  });
}, [addToast, config]);

  // Validation & Health Check Toasts
  const showHealthCheckPassed = useCallback(() => {
    addToast({
      message: `✅ ${config.terminology.project.charAt(0).toUpperCase() + config.terminology.project.slice()} helsesjekk bestått!`,
      type: 'success',
      duration: 3000
  ,  ,});
}, [addToast, config]);

  const showHealthCheckWarning = useCallback((warning: string) => {
    addToast({
      message: `⚠️ Helsesjekk advarsel: ${warning}`,
      type: 'warning',
      duration: 500,
      actions: [
        {
          label: 'Se detaljer',
          action: 'view_health_check'
      ,  ,}
      ]
  });
}, [addToast]);

  // Return all toast functions
  return {
    // Project lifecycle
    showProjectStarted,
    showProjectSaved,
    showProjectReady,
    showProjectValidationError,
    
    // Step navigation
    showStepCompleted,
    showStepSkipped,
    showProgressUpdate,
    
    // Equipment & setup
    showEquipmentConfigured,
    showMemoryCardConfigured,
    showFileFormatSelected,
    showBackupConfigured,
    
    // Meeting & planning
    showMeetingScheduled,
    showCalendarConflict,
    
    // Pricing & budget
    showPricingCalculated,
    showPricingWarning,
    
    // Cultural & specialized
    showCulturalContextApplied,
    showSpecialRequestsNoted,
    
    // Workflow integration
    showWorklogCreated,
    showIntegrationConnected,
    
    // Error recovery
    showAutoSaveEnabled,
    showDataRestored,
    showNetworkError,
    
    // Validation & health
    showHealthCheckPassed,
    showHealthCheckWarning,
    
    // Config for custom toasts
    config
};
}

export default useProfessionToasts;

