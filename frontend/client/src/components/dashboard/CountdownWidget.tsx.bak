import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect } from 'react';
import { Card as MuiCard, CardContent } from '@mui/material';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { useQuery } from '@tanstack/react-query';
import { UpcomingEventsCountdownView } from './UpcomingEventsCountdownView';
import {
  Timer,
  Heart,
  Users,
  Camera,
  Video,
  Music,
  Building,
  Clock,
  Circle,
  Zap,
} from 'lucide-react';

interface CountdownWidgetProps {
  profession: 'photographer' | 'videographer' | 'music_producer' | 'vendor';
  className?: string
}

export function CountdownWidget({ profession, className }: CountdownWidgetProps) {
  const [showCountdownView, setShowCountdownView] = useState(
  
  // Theming system
  const theming = useTheming('photographer');false);
  const [currentTime, setCurrentTime] = useState(new Date());

  // Update current time every minute for real-time countdown
  useEffect(() => {
    const timer = setInterval(() => {
      setCurrentTime(new Date());
  }, 60000);
    return () => clearInterval(timer);
}, []);

  // Profession-inspired countdown design components
  const ProfessionCountdownDesign = ({ profession, countdown, nextEvent }) => {
    // Professional color schemes
    const professionStyles = {
      photographer: {
        primary: 'from-slate-700 to-slate-90',
        accent: 'from-amber-400 to-amber-60',
        glow: 'shadow-amber-500/2',
        lens: 'bg-gradient-to-br from-gray-800 via-gray-700 to-black',
        display: 'bg-amber-500 text-black',
    },
      videographer: {
        primary: 'from-red-700 to-red-90',
        accent: 'from-red-400 to-red-60',
        glow: 'shadow-red-500/2',
        lens: 'bg-gradient-to-br from-red-800 via-red-700 to-black',
        display: 'bg-red-500 text-white',
    },
      music_producer: {
        primary: 'from-purple-700 to-purple-90',
        accent: 'from-purple-400 to-purple-60',
        glow: 'shadow-purple-500/2',
        lens: 'bg-gradient-to-br from-purple-800 via-purple-700 to-black',
        display: 'bg-purple-500 text-white',
    },
      vendor: {
        primary: 'from-emerald-700 to-emerald-90',
        accent: 'from-emerald-400 to-emerald-60',
        glow: 'shadow-emerald-500/2',
        lens: 'bg-gradient-to-br from-emerald-800 via-emerald-700 to-black',
        display: 'bg-emerald-500 text-white',
    },
  };

    const style = professionStyles[profession] || professionStyles.photographer;

    // Render profession-specific design
    if (profession === 'photographer') {
      return <CameraDesign style={style} countdown={countdown} nextEvent={nextEvent} />;
  } else if (profession === 'videographer') {
      return <FilmStripDesign style={style} countdown={countdown} nextEvent={nextEvent} />;
  } else if (profession === 'music_producer') {
      return <StudioDesign style={style} countdown={countdown} nextEvent={nextEvent} />;
  } else if (profession === 'vendor') {
      return <BusinessDesign style={style} countdown={countdown} nextEvent={nextEvent} />;
  } else {
      return <CameraDesign style={style} countdown={countdown} nextEvent={nextEvent} />;
  }
};

  // Camera-inspired design for photographers
  const CameraDesign = ({ style, countdown, nextEvent }) => {
    return (
      <div className="relative">
        {/* Camera Body - Intelligent designed glassmorphism effect */}
        <div
          className={`relative bg-gradient-to-br ${style.primary} rounded-2xl p-6 shadow-2xl ${style.glow} border border-white/10 backdrop-blur-sm`}
        >
          {/* Camera Top Elements */}
          <div className="flex justify-between items-start mb-4">
            {/* Viewfinder */}
            <div className="w-8 h-4 bg-black/50 rounded-sm border border-gray-600 relative">
              <div className="absolute inset-1 bg-gradient-to-b from-gray-700 to-black rounded-xs"></div>
            </div>

            {/* Flash */}
            <div className="w-3 h-3 bg-gradient-to-br from-white via-gray-100 to-gray-300 rounded-full border border-gray-400 shadow-inner"></div>

            {/* Mode dial */}
            <div className="w-6 h-6 bg-gradient-to-br from-gray-600 to-gray-800 rounded-full border border-gray-500 relative">
              <div className="absolute top-1 left-1/2 w-0.5 h-2 bg-white transform -translate-x-1/2 rounded-full"></div>
            </div>
          </div>

          {/* Main Lens Area with Clock Integration */}
          <div className="flex items-center justify-center mb-4">
            <div
              className={`relative w-24 h-24 ${style.lens} rounded-full shadow-2xl border-4 border-gray-600`}
            >
              {/* Lens rings */}
              <div className="absolute inset-2 border-2 border-gray-500 rounded-full opacity-30"></div>
              <div className="absolute inset-4 border border-gray-400 rounded-full opacity-20"></div>

              {/* Clock display in center of lens */}
              <div
                className={`absolute inset-0 flex items-center justify-center text-lg font-bold ${countdown.urgent ? 'animate-pulse' : ''}`}
              >
                <div className={`px-2 py-1 rounded text-xs ${style.display} shadow-lg font-mono`}>
                  {countdown.text}
                </div>
              </div>

              {/* Lens reflection effect */}
              <div className="absolute top-2 left-2 w-4 h-4 bg-white/20 rounded-full blur-sm"></div>
            </div>
          </div>

          {/* Camera Bottom - Event Info Display */}
          <div className="bg-black/30 rounded-lg p-3 backdrop-blur-sm border border-white/10">
            <div className="text-center">
              <div className="text-white/90 text-sm font-medium truncate">{nextEvent?.title}</div>
              <div className="text-white/70 text-xs mt-1">
                {nextEvent?.clientName} • {nextEvent?.date}
              </div>
            </div>
          </div>

          {/* Professional Icon */}
          <div
            className={`absolute -top-2 -right-2 w-8 h-8 bg-gradient-to-br ${style.accent} rounded-full flex items-center justify-center shadow-lg border-2 border-white/20`}
          >
            {profession === 'photographer' && <CameraAlt className="w-4 h-4 text-white" />}
            {profession === 'videographer' && <Videocam className="w-4 h-4 text-white" />}
            {profession === 'music_producer' && <MusicNote className="w-4 h-4 text-white" />}
            {profession === 'vendor' && <Building className="w-4 h-4 text-white" />}
          </div>

          {/* Urgency indicator */}
          {countdown.urgent && (
            <div className="absolute -top-1 -left-1 w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
          )}
        </div>
      </div>
    );
};

  // Film strip-inspired design for videographers
  const FilmStripDesign = ({ style, countdown, nextEvent }) => {
    return (
      <div className="relative">
        {/* Film Strip Body */}
        <div
          className={`relative bg-gradient-to-br ${style.primary} rounded-lg p-6 shadow-2xl ${style.glow} border border-white/10 backdrop-blur-sm`}
        >
          {/* Film perforations on sides */}
          <div className="absolute left-1 top-4 bottom-4 w-2 flex flex-col justify-around">
            {[...Array(6)].map((_, i) => (
              <div key={i} className="w-2 h-3 bg-black/40 rounded-sm border border-gray-600"></div>
            ))}
          </div>
          <div className="absolute right-1 top-4 bottom-4 w-2 flex flex-col justify-around">
            {[...Array(6)].map((_, i) => (
              <div key={i} className="w-2 h-3 bg-black/40 rounded-sm border border-gray-600"></div>
            ))}
          </div>

          {/* Film frame content */}
          <div className="mx-4">
            {/* Frame border */}
            <div className="border-2 border-gray-600 rounded p-4 bg-black/20">
              {/* Countdown display */}
              <div className="flex items-center justify-center mb-4">
                <div
                  className={`px-4 py-2 rounded-lg text-xl font-mono font-bold ${style.display} shadow-lg ${countdown.urgent ? 'animate-pulse' : ''}`}
                >
                  {countdown.text}
                </div>
              </div>

              {/* Event info */}
              <div className="text-center">
                <div className="text-white/90 text-sm font-medium truncate">{nextEvent?.title}</div>
                <div className="text-white/70 text-xs mt-1">
                  {nextEvent?.clientName} • {nextEvent?.date}
                </div>
              </div>
            </div>
          </div>

          {/* Video icon */}
          <div
            className={`absolute -top-2 -right-2 w-8 h-8 bg-gradient-to-br ${style.accent} rounded-full flex items-center justify-center shadow-lg border-2 border-white/20`}
          >
            <Videocam className="w-4 h-4 text-white" />
          </div>

          {/* Urgency indicator */}
          {countdown.urgent && (
            <div className="absolute -top-1 -left-1 w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
          )}
        </div>
      </div>
    );
};

  // Studio/audio equipment-inspired design for music producers
  const StudioDesign = ({ style, countdown, nextEvent }) => {
    return (
      <div className="relative">
        {/* Studio Equipment Body */}
        <div
          className={`relative bg-gradient-to-br ${style.primary} rounded-xl p-6 shadow-2xl ${style.glow} border border-white/10 backdrop-blur-sm`}
        >
          {/* Studio top controls */}
          <div className="flex justify-between items-start mb-4">
            {/* EQ indicators */}
            <div className="flex space-x-1">
              {[...Array(5)].map((_, i) => (
                <div
                  key={i}
                  className={`w-2 h-${i + 2} bg-gradient-to-t ${style.accent} rounded-full opacity-70`}
                ></div>
              ))}
            </div>

            {/* Level meters */}
            <div className="flex space-x-1">
              {[...Array(8)].map((_, i) => (
                <div
                  key={i}
                  className={`w-1 h-8 bg-gradient-to-t from-green-500 via-yellow-500 to-red-500 rounded-full opacity-${i < 5 ? '100' : '30'}`}
                ></div>
              ))}
            </div>
          </div>

          {/* Main display area */}
          <div className="bg-black/40 rounded-lg p-4 mb-4 border border-gray-600">
            {/* Waveform visualization */}
            <div className="flex items-end justify-center space-x-1 mb-3 h-12">
              {[...Array(12)].map((_, i) => (
                <div
                  key={i}
                  className={`w-2 bg-gradient-to-t ${style.accent} rounded-t animate-pulse`}
                  style={{
                    height: `${Math.random() * 40 + 10}px`,
                    animationDelay: `${i * 0.1}s`,
                }}
                ></div>
              ))}
            </div>

            {/* Countdown display */}
            <div className="text-center">
              <div
                className={`px-3 py-1 rounded text-lg font-mono font-bold ${style.display} shadow-lg ${countdown.urgent ? 'animate-pulse' : ''}`}
              >
                {countdown.text}
              </div>
            </div>
          </div>

          {/* Studio knobs and buttons */}
          <div className="flex justify-between items-center mb-3">
            {[...Array(3)].map((_, i) => (
              <div
                key={i}
                className="w-6 h-6 bg-gradient-to-br from-gray-500 to-gray-700 rounded-full border border-gray-400 relative"
              >
                <div className="absolute top-1 left-1/2 w-0.5 h-1.5 bg-white transform -translate-x-1/2 rounded-full"></div>
              </div>
            ))}
          </div>

          {/* Event info display */}
          <div className="bg-black/30 rounded-lg p-3 backdrop-blur-sm border border-white/10">
            <div className="text-center">
              <div className="text-white/90 text-sm font-medium truncate">{nextEvent?.title}</div>
              <div className="text-white/70 text-xs mt-1">
                {nextEvent?.clientName} • {nextEvent?.date}
              </div>
            </div>
          </div>

          {/* Music icon */}
          <div
            className={`absolute -top-2 -right-2 w-8 h-8 bg-gradient-to-br ${style.accent} rounded-full flex items-center justify-center shadow-lg border-2 border-white/20`}
          >
            <MusicNote className="w-4 h-4 text-white" />
          </div>

          {/* Urgency indicator */}
          {countdown.urgent && (
            <div className="absolute -top-1 -left-1 w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
          )}
        </div>
      </div>
    );
};

  // Business/logistics-inspired design for vendors
  const BusinessDesign = ({ style, countdown, nextEvent }) => {
    return (
      <div className="relative">
        {/* Business Dashboard Body */}
        <div
          className={`relative bg-gradient-to-br ${style.primary} rounded-lg p-6 shadow-2xl ${style.glow} border border-white/10 backdrop-blur-sm`}
        >
          {/* Business header with metrics */}
          <div className="flex justify-between items-center mb-4">
            <div className="flex space-x-2">
              {[...Array(3)].map((_, i) => (
                <div
                  key={i}
                  className={`w-3 h-3 bg-gradient-to-br ${style.accent} rounded-full opacity-${100 - i * 20}`}
                ></div>
              ))}
            </div>

            {/* Progress indicators */}
            <div className="flex space-x-1">
              {[...Array(5)].map((_, i) => (
                <div
                  key={i}
                  className={`w-1 h-4 bg-gradient-to-t ${i < 3 ? style.accent : 'from-gray-500 to-gray-600'} rounded-full`}
                ></div>
              ))}
            </div>
          </div>

          {/* Main display area */}
          <div className="bg-black/30 rounded-lg p-4 mb-4 border border-white/10">
            {/* Countdown display */}
            <div className="text-center mb-3">
              <div
                className={`px-4 py-2 rounded-md text-lg font-bold ${style.display} shadow-lg ${countdown.urgent ? 'animate-pulse' : ''}`}
              >
                {countdown.text}
              </div>
            </div>

            {/* Business metrics visualization */}
            <div className="grid grid-cols-3 gap-2 mb-3">
              {[...Array(3)].map((_, i) => (
                <div
                  key={i}
                  className="h-8 bg-gradient-to-t from-emerald-600/50 to-emerald-400/50 rounded opacity-70"
                ></div>
              ))}
            </div>
          </div>

          {/* Event info */}
          <div className="bg-black/30 rounded-lg p-3 backdrop-blur-sm border border-white/10">
            <div className="text-center">
              <div className="text-white/90 text-sm font-medium truncate">{nextEvent?.title}</div>
              <div className="text-white/70 text-xs mt-1">
                {nextEvent?.clientName} • {nextEvent?.date}
              </div>
            </div>
          </div>

          {/* Business icon */}
          <div
            className={`absolute -top-2 -right-2 w-8 h-8 bg-gradient-to-br ${style.accent} rounded-full flex items-center justify-center shadow-lg border-2 border-white/20`}
          >
            <Building className="w-4 h-4 text-white" />
          </div>

          {/* Urgency indicator */}
          {countdown.urgent && (
            <div className="absolute -top-1 -left-1 w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
          )}
        </div>
      </div>
    );
};

  // Fetch upcoming events
  const { data: upcomingEvents, isLoading } = useQuery({
    queryKey: ['/api/dashboard/upcoming-events', profession],
    refetchInterval: 5 * 60 * 100,
});

  // Find next most urgent event
  const getNextEvent = () => {
    if (!upcomingEvents || upcomingEvents.length === 0) return null;

    // Sort by urgency: today first, then by days until
    // Mock data removed - using database connection
};

  // Calculate real-time countdown
  const calculateCountdown = (eventDate: string, eventTime?: string) => {
    const now = new Date();
    const event = new Date(`${eventDate}${eventTime ? ` ${eventTime}` : ''}`);
    const diffMs = event.getTime() - now.getTime();

    if (diffMs <= 0) {
      return {
        text: 'N, å, ',
        className: 'text-red-600 font-bold animate-pulse',
        urgent: true,
    };
  }

    const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

    if (days === 0) {
      if (hours === 0) {
        return {
          text: `${minutes}m`,
          className: 'text-red-600 font-bold animate-pulse text-2xl',
          urgent: true,
      };
    }
      return {
        text: `${hours}t ${minutes}m`,
        className: 'text-red-600 font-bold text-xl',
        urgent: true,
    };
  } else if (days === 1) {
      return {
        text: 'I morgen',
        className: 'text-orange-600 font-semibold text-lg',
        urgent: true,
    };
  } else if (days < 7) {
      return {
        text: `${days} dager`,
        className: 'text-orange-600 font-medium text-lg',
        urgent: false,
    };
  } else if (days < 14) {
      return {
        text: `${Math.ceil(days / 7)} uke`,
        className: 'text-blue-600 font-medium',
        urgent: false,
    };
  } else {
      return {
        text: `${Math.ceil(days / 7)} uker`,
        className: 'text-gray-60',
        urgent: false,
    };
  }
};

  // Get event icon
  const getEventIcon = (type: string, profession: string) => {
    if (type === 'wedding') return Heart;
    if (type === 'meeting') return Users;

    switch (profession) {
      case 'photographer':
        return Camera;
      case 'videographer':
        return Video;
      case 'music_producer':
        return Music;
      case 'vendor':
        return Building;
      default:
        return Timer;
}
};

  // Get profession-specific terminology
  const getProfessionLabel = (profession: string, eventType?: string) => {
    if (eventType === 'wedding') return 'Neste bryllup';

    switch (profession) {
      case 'photographer':
        return 'Neste fotografering';
      case 'videographer':
        return 'Neste videoproduksjon';
      case 'music_producer':
        return 'Neste studioøkt';
      case 'vendor':
        return 'Neste leveranse';
      default: return 'Neste hendelse';
}
};

  const nextEvent = getNextEvent();

  // Don't render if no events or still loading
  if (isLoading || !nextEvent) {
    return null;
}

  const countdown = calculateCountdown(nextEvent.date, nextEvent.time);
  const EventIcon = getEventIcon(nextEvent.type, nextEvent.profession);
  const professionLabel = getProfessionLabel(profession, nextEvent.type);

  return (
    <>
      <div
        className={`${className} cursor-pointer transition-all duration-500 hover: scale-105 hover:shadow-2xl`}
        onClick={() => setShowCountdownView(true)}
      >
        <ProfessionCountdownDesign
          profession={profession}
          countdown={countdown}
          nextEvent={nextEvent}
        />

        {/* Additional info badge */}
        {upcomingEvents && upcomingEvents.length > 1 && (
          <div className="flex justify-center mt-2">
            <Badge variant="outline" className="text-xs bg-white/90 backdrop-blur-sm">
              +{upcomingEvents.length - 1} flere hendelser
            </Badge>
          </div>
        )}
      </div>

      <UpcomingEventsCountdownView
        profession={profession}
        isOpen={showCountdownView}
        onClose={() => setShowCountdownView(false)}
      />
    </>
  );
}
