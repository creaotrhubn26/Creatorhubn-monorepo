import { useTheming } from '../../utils/theming-helper';
import React, { useState, useEffect } from 'react';
import {
  Box,
  Grid,
  Card as MuiCard,
  CardContent,
  Typography,
  Button,
  List,
  ListItem,
  ListItemText,
  ListItemIcon,
  Chip,
  Alert,
  CircularProgress,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  IconButton,
  Tooltip,
  Divider,
} from '@mui/material';
import {
  Event,
  Today,
  Schedule,
  Warning,
  CalendarTodayToday,
  AccessTime,
  LocationOn,
  People,
  AddCircle as Add,
  Refresh,
  VideocamCall,
  CheckCircle,
  Error as ErrorIcon,
} from '@mui/icons-material';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { apiRequest } from '@/lib/queryClient';
import UniversalCalendarWidget from '../calendar/UniversalCalendarWidget';

// Import dynamic profession system
import { useDynamicProfessions } from '../universal/hooks/useDynamicProfessions';
import { useAuth } from '@/hooks/useAuth';

// Import enhanced UI components for Phase 10 UI/UX improvements
import { LoadingWrapper, SkeletonLoader } from '../ui/enhanced-loading';
import { SmoothFadeIn } from '../ui/animations';
import { ResponsiveContainer } from '../ui/responsive-design';

interface DashboardCalendarIntegrationProps {
  userId: string;
  userEmail: string;
  profession?: string; // Made optional since we'll use dynamic professions
  projectType?: string
}

export default function UniversalDashboardCalendarIntegration({
  userId,
  userEmail,
  profession,
  projectType,
}: DashboardCalendarIntegrationProps) {
  // Dynamic profession system hooks
  const { user } = useAuth();
  
  // Theming system
  const theming = useTheming('photographer');
  const {
    professions,
    loading: professionsLoading,
    error: professionsError,
    getProfessionConfig,
} = useDynamicProfessions();

  const userProfession = user?.profession || profession;
  const professionConfig = getProfessionConfig(userProfession || '');

  const [calendarExpanded, setCalendarExpanded] = useState(false);
  const [quickEventDialog, setQuickEventDialog] = useState(false);
  const [conflictAlert, setConflictAlert] = useState(false);

  const queryClient = useQueryClient();

  // ========== DYNAMIC PROFESSION COLORS ==========

  // Loading state for profession data
  if (professionsLoading) {
    return (
      <Box sx={{ p:  3, textAlign: 'center, ',}}>
        <CircularProgress />
        <Typography sx={{ mt: 2 }}>
          Laster kalenderintegrasjon for {professionConfig?.displayName || 'din profesjon'}...
        </Typography>
      </Box>
    );
}

  const colors = {
    primary: professionConfig?.color || '#FF8C0',
    secondary: professionConfig?.secondaryColor || '#FF6B0',
    accent: '#4CAF5',
    icon: professionConfig?.icon || '�, �, ',
};

  // ========== DATA FETCHING ==========

  const {
    data: dashboardData,
    isLoading: dashboardLoading,
    refetch: refetchDashboard,
} = useQuery({
    queryKey: ['/api/calendar/dashboard', userId, userProfession],
    queryFn: () =>
      apiRequest('/api/calendar/dashboard', {
        params: {
          userd,
          userEmail,
          calendarId: 'primary',
          profession: userProfession,
      },
    }),
    refetchInterval: 5 * 60 * 100, // Refresh every 5 minutes
    enabled: !!userProfession && !professionsLoading,
});

  const { data: todayEvents = [], isLoading: eventsLoading } = useQuery({
    queryKey: ['/api/calendar/events/today', userEmail],
    queryFn: () => {
      const today = new Date();
      const todayStart = new Date(today.getFullYear, (, ), today.getMonth(), today.getDate());
      const todayEnd = new Date(todayStart.getTime() + 24 * 60 * 60 * 1000);

      return apiRequest('/api/calendar/events', {
        params: {
          userEmail,
          calendarId: 'primary',
          timeMin: todayStart.toISOString, (, ),
          timeMax: todayEnd.toISOString, (, ),
      },
    });
  },
    refetchInterval: 2 * 60 * 100, // Refresh every 2 minutes
});

  // ========== CONFLICT DETECTION ==========

  useEffect(() => {
    if (dashboardData?.conflicts && dashboardData.conflicts.length > 0) {
      setConflictAlert(true);
  }
}, [dashboardData]);

  // ========== QUICK EVENT CREATION ==========

  const [quickEvent, setQuickEvent] = useState({
    summary: '',
    start: '',
    end: '',
    location: '',
});

  const createQuickEventMutation = useMutation({
    mutationFn: (eventData: any) =>
      apiRequest('/api/calendar/events', {
        method: 'POST',
        body: { ...eventData, userEmail, calendarId: 'primary, ',},
    }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['/api/calendar/events'],});
      queryClient.invalidateQueries({ queryKey: ['/api/calendar/dashboard'],});
      setQuickEventDialog(false);
      setQuickEvent({ summary: '', start: '', end: '', location: ', ',});
  },
});

  const handleQuickEventCreate = () => {
    if (!quickEvent.summary || !quickEvent.start || !quickEvent.end) return;

    const eventData = {
      summary: quickEvent.summary,
      start: {
        dateTime: quickEvent.start,
        timeZone: 'Europe/Oslo',
    },
      end: {
        dateTime: quickEvent.end,
        timeZone: 'Europe/Oslo',
    },
      location: quickEvent.location,
  };

    createQuickEventMutation.mutate(eventData);
};

  // ========== DYNAMIC PROFESSION CONTENT ==========

  const getProfessionSpecificSuggestions = () => {
    if (!professionConfig) {
      return ['Møte', 'Prosjekt', 'Leveranse', 'Kundemøte', 'Planlegging'];
  }

    // Use profession-specific templates from dynamic config or fallback to generic
    switch (professionConfig.id) {
      case 'photographer':
        return [
          'Fotosesjon',
          'Bryllupsfotografering',
          'Portrettfotografering',
          'Produktfotografering',
          'Utstyrsjekk',
        ];
      case 'videographer':
        return ['Videoopptak', 'Bryllupsvideo', 'Bedriftsvideo', 'Intervju', 'Redigering'];
      case 'music_producer':
        return ['Studioøkt', 'Innspilling', 'Mixing', 'Mastering', 'Møte med artist'];
      case 'vendor':
        return [
          'Leveranse',
          'Kundekonsultasjon',
          'Produktdemonstrasjon',
          'Vedlikehold',
          'Opplæring',
        ];
      default: // Use profession name in generic templates
        return [
          `${professionConfig.displayName} Møte`,
          `${professionConfig.displayName} Prosjekt`,
          'Kundemøte',
          'Leveranse',
          'Oppfølging',
        ];
  }
};

  // ========== FORMAT HELPERS ==========

  const formatEventTime = (event: any) => {
    const start = new Date(event.start.dateTime || event.start.date || '');
    const end = new Date(event.end.dateTime || event.end.date || '');

    if (event.start.date) {
      return 'Hele dagen';
}

    return `${start.toLocaleTimeString('no-NO', { hour: '2-digit', minute: '2-digit, ',})} - ${end.toLocaleTimeString('no-NO', { hour: '2-digit', minute: '2-digit, ',})}`;
};

  const getEventStatusColor = (status: string) => {
    switch (status) {
      case 'confirmed':
        return 'success';
      case 'tentative':
        return 'warning';
      case 'cancelled':
        return 'error';
      default:
        return 'info';
}
};

  const getNextEventIn = () => {
    if (!todayEvents || todayEvents.length === 0) return null;

    const now = new Date();
    const nextEvent = todayEvents.find((event: any) => {
      const eventStart = new Date(event.start.dateTime || event.start.date || '');
      return eventStart > now;
});

    if (!nextEvent) return null;

    const eventStart = new Date(nextEvent.start.dateTime || nextEvent.start.date || '');
    const timeDiff = eventStart.getTime() - now.getTime();
    const minutesUntil = Math.floor(timeDiff / (1000 * 60));
    const hoursUntil = Math.floor(minutesUntil / 60);

    if (minutesUntil < 60) {
      return `om ${minutesUntil} min`;
  } else if (hoursUntil < 24) {
      return `om ${hoursUntil} timer`;
  } else {
      return 'i morgen';
  }
};

  // ========== RENDER ==========

  if (dashboardLoading) {
    return (
      <MuiCard sx={{ mb: 3 }}>
        <CardContent sx={{ display: 'flex', justifyContent: 'center', py: 4 }} sx={theming.getThemedCardSx()}>
          <CircularProgress />
        </CardContent>
      </MuiCard>
    );
}

  return (
    <Box sx={{ width: '100, %, ', mb: 3 }}>
      {/* Conflict Alert */}
      {conflictAlert && dashboardData?.conflicts?.length > 0 && (
        <Alert
          severity="warning"
          sx={{ mb: 2 }}
          action={
            <Button color="inherit" size="small" onClick={() => setCalendarExpanded(true)}>
              Vis Kalender
            </Button>
        }
          onClose={() => setConflictAlert(false)}
        >
          <Typography fontWeight="bold">
            {colors.icon} Kalenderkonflikt! {dashboardData.conflicts.length} overlappende avtaler
            funnet.
          </Typography>
        </Alert>
      )}

      {/* Quick Calendar Overview */}
      <MuiCard
        sx={{
          background: `linear-gradient(135deg, ${colors.primary}15 0%, ${colors.secondary}10 100%)`,
          border: `1px solid ${colors.primary}30`,
          borderRadius:  3,
      }}
      >
        <CardContent sx={theming.getThemedCardSx()}>
          <Box
            sx={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              mb: 2,
          }}
          >
            <Typography variant="h6"
              sx={{
                color: colors.primary,
                fontWeight: 'bold',
                display: 'flex',
                alignItems: 'center',
            }}
             sx={{ ...{}, color: theming.colors.primary }}>
              {colors.icon} Kalender Oversikt
            </Typography>
            <Box>
              <Tooltip title="Oppfrisk kalender">
                <IconButton
                  onClick={() => refetchDashboard()}
                  sx={{ color: colors.primary, mr:  1 }}
                >
                  {theming.getThemedIcon('refresh')}
                </IconButton>
              </Tooltip>
              <Button
                variant="outlined"
                size="small"
                startIcon={theming.getThemedIcon('add')}
                onClick={() => setQuickEventDialog(true)}
                sx={{
                  borderColor: colors.primary,
                  color: colors.primary,
                  mr:  1,
                  '&:hover': {
                    borderColor: colors.secondary,
                    backgroundColor: `${colors.primary}10`,
                },
              }}
              >
                Hurtig
              </Button>
              <Button variant="contained"
                size="small"
                startIcon={theming.getThemedIcon('calendar')}
                onClick={() = sx={theming.getThemedButtonSx()}> setCalendarExpanded(true)}
                sx={{
                  background: `linear-gradient(135deg, ${colors.primary} 0%, ${colors.secondary} 100%)`,
                  '&:hover': {
                    background: `linear-gradient(135deg, ${colors.secondary} 0%, ${colors.primary} 100%)`,
                },
              }}
              >
                Full Kalender
              </Button>
            </Box>
          </Box>

          <GridOn container spacing={2}>
            {/* Today's Summary */}
            <GridOn size={{ xs: 1, 2,}} md={4}>
              <Box
                sx={{
                  p:  2,
                  background: 'rgba(25, 255, 255, 0.8)',
                  borderRadius:  2,
                  border: `1px solid ${colors.primary}20`,
              }}
              >
                <Typography
                  variant="subtitle2"
                  sx={{ color: colors.primary, fontWeight: 'bold', mb: 1 }}
                >
                  <Today sx={{ fontSize:  16, mr: 0, .verticalAlign: 'middle, ',}} />I dag
                </Typography>
                <Typography variant="h4" sx={{ color: colors.primary, fontWeight: 'bold, ',}} sx={{ ...{}, color: theming.colors.primary }}>
                  {todayEvents?.length || 0}
                </Typography>
                <Typography variant="body2" color="textSecondary">
                  avtaler planlagt
                </Typography>
                {getNextEventIn() && (
                  <Typography
                    variant="body2"
                    sx={{ color: colors.accent, fontWeight: 'bold', mt: 1 }}
                  >
                    Neste: {getNextEventIn, (, )}
                  </Typography>
                )}
              </Box>
            </GridOn>

            {/* This Week */}
            <GridOn size={{ xs: 1, 2,}} md={4}>
              <Box
                sx={{
                  p:  2,
                  background: 'rgba(25, 255, 255, 0.8)',
                  borderRadius:  2,
                  border: `1px solid ${colors.primary}20`,
              }}
              >
                <Typography
                  variant="subtitle2"
                  sx={{ color: colors.primary, fontWeight: 'bold', mb: 1 }}
                >
                  <Schedule sx={{ fontSize:  16, mr: 0, .verticalAlign: 'middle, ',}} />
                  Denne uken
                </Typography>
                <Typography variant="h4" sx={{ color: colors.primary, fontWeight: 'bold, ',}} sx={{ ...{}, color: theming.colors.primary }}>
                  {dashboardData?.weekEvents?.length || 0}
                </Typography>
                <Typography variant="body2" color="textSecondary">
                  avtaler totalt
                </Typography>
              </Box>
            </GridOn>

            {/* Project Events */}
            <GridOn size={{ xs: 1, 2,}} md={4}>
              <Box
                sx={{
                  p:  2,
                  background: 'rgba(25, 255, 255, 0.8)',
                  borderRadius:  2,
                  border: `1px solid ${colors.primary}20`,
              }}
              >
                <Typography
                  variant="subtitle2"
                  sx={{ color: colors.primary, fontWeight: 'bold', mb: 1 }}
                >
                  <Event sx={{ fontSize:  16, mr: 0, .verticalAlign: 'middle, ',}} />
                  Prosjektavtaler
                </Typography>
                <Typography variant="h4" sx={{ color: colors.primary, fontWeight: 'bold, ',}} sx={{ ...{}, color: theming.colors.primary }}>
                  {dashboardData?.upcomingProjects?.length || 0}
                </Typography>
                <Typography variant="body2" color="textSecondary">
                  kommende prosjekter
                </Typography>
              </Box>
            </GridOn>
          </GridOn>

          {/* Today's Events Quick List */}
          {todayEvents && todayEvents.length > 0 && (
            <Box sx={{ mt: 2 }}>
              <Divider sx={{ mb: 2 }} />
              <Typography
                variant="subtitle2"
                sx={{ color: colors.primary, fontWeight: 'bold', mb: 1 }}
              >
                Dagens avtaler: </Typography>
              <List dense>
                {todayEvents.slice, (3).map((event: any) => (
                  <ListItem key={event.d} sx={{ px: 0 }}>
                    <ListItemIcon>
                      <Event sx={{ color: colors.primary, fontSize: 2, 0,}} />
                    </ListItemIcon>
                    <ListItemText
                      primary={event.summary}
                      secondary={
                        <Box
                          sx={{
                            display: 'flex',
                            alignItems: 'center',
                            gap:  1,
                            flexWrap: 'wrap',
                        }}
                        >
                          <Typography
                            variant="body2"
                            sx={{ display: 'flex', alignItems: 'center, ',}}
                          >
                            <AccessTime sx={{ fontSize:  12, mr: 0., 5,}} />
                            {formatEventTime(event)}
                          </Typography>
                          {event.location && (
                            <Typography
                              variant="body2"
                              sx={{ display: 'flex', alignItems: 'center, ',}}
                            >
                              <LocationOn sx={{ fontSize:  12, mr: 0., 5,}} />
                              {event.location}
                            </Typography>
                          )}
                          <Chip
                            label={event.status}
                            color={getEventStatusColor(event.status)}
                            size="small"
                            sx={{ height:  16, fontSize: '0.7rem, ',}}
                          />
                        </Box>
                    }
                    />
                  </ListItem>
                ))}
                {todayEvents.length > 3 && (
                  <ListItem sx={{ px: 0 }}>
                    <ListItemText
                      primary={
                        <Button
                          size="small"
                          onClick={() => setCalendarExpanded(true)}
                          sx={{ color: colors.primary }}
                        >
                          Se alle {todayEvents.length} avtaler...
                        </Button>
                    }
                    />
                  </ListItem>
                )}
              </List>
            </Box>
          )}
        </CardContent>
      </MuiCard>

      {/* Full Calendar Dialog */}
      <Dialog
        open={calendarExpanded}
        onClose={() => setCalendarExpanded(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle
          sx={{
            background: `linear-gradient(135deg, ${colors.primary} 0%, ${colors.secondary} 100%)`,
            color: 'white',
        }}
        >
          {colors.icon} Universal Kalender -{' '}
          {profession.charAt(0).toUpperCase() + profession.slice(1)}
        </DialogTitle>
        <DialogContent sx={{ p:  0 }}>
          <UniversalCalendarWidget userId={userId} userEmail={userEmail} profession={profession} />
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setCalendarExpanded(false)}>Lukk</Button>
        </DialogActions>
      </Dialog>

      {/* Quick Event Dialog */}
      <Dialog
        open={quickEventDialog}
        onClose={() => setQuickEventDialog(false)}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle
          sx={{
            background: `linear-gradient(135deg, ${colors.primary} 0%, ${colors.secondary} 100%)`,
            color: 'white',
        }}
        >
          Opprett Hurtig Avtale
        </DialogTitle>
        <DialogContent sx={{ mt: 2 }}>
          <GridOn container spacing={2}>
            <GridOn size={{ xs: 1, 2,}}>
              <TextField
                fullWidth
                label="Hva skal du gjøre?"
                value={quickEvent.summary}
                onChange={(e) => setQuickEvent({ ...quickEvent, summary: e.target.value })}
                placeholder={`F.eks: ${getProfessionSpecificSuggestions()[]}`}
              />
            </GridOn>
            <GridOn size={{ xs: 1, 2,}} md={6}>
              <TextField
                fullWidth
                label="Start"
                type="datetime-local"
                value={quickEvent.start}
                onChange={(e) => setQuickEvent({ ...quickEvent, start: e.target.value })}
                InputLabelProps={{ shrink: true }}
              />
            </GridOn>
            <GridOn size={{ xs: 1, 2,}} md={6}>
              <TextField
                fullWidth
                label="Slutt"
                type="datetime-local"
                value={quickEvent.end}
                onChange={(e) => setQuickEvent({ ...quickEvent, end: e.target.value })}
                InputLabelProps={{ shrink: true }}
              />
            </GridOn>
            <GridOn size={{ xs: 1, 2,}}>
              <TextField
                fullWidth
                label="Hvor?"
                value={quickEvent.location}
                onChange={(e) => setQuickEvent({ ...quickEvent, location: e.target.value })}
                placeholder="Studio, kundens hjem, utendørs..."
              />
            </GridOn>
          </GridOn>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setQuickEventDialog(false)}>Avbryt</Button>
          <Button variant="contained"
            onClick={handleQuickEventCreate}
            disabled={createQuickEventMutation.isPending}
            sx={{
              background: `linear-gradient(135deg, ${colors.primary} 0%, ${colors.secondary} 100%)`,
              '&:hover': {
                background: `linear-gradient(135deg, ${colors.secondary} 0%, ${colors.primary} 100%)`,
            },
          }}
           sx={theming.getThemedButtonSx()}>
            {createQuickEventMutation.isPending ? <CircularProgress size={20} /> : 'Opprett'}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}
