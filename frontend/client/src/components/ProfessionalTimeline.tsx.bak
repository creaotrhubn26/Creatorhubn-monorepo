import React, { useState, useCallback, useRef, useEffect, useMemo } from 'react';
import { Box, Typography, Paper, Stack, Chip, Tooltip } from '@mui/material';
import { BeatClip, Track } from '../services/storyArcDataIntegration';
import { useTheming, storyArcStudioColors } from '@/lib/theming-helper';

interface ProfessionalTimelineProps {
  clips: BeatClip[];
  tracks: Track[];
  zoom: number;                // 1.0 = base; pixelsPerSecond = zoom * 10
  currentTime: number;         // seconds
  totalDuration: number;       // seconds
  isPlaying: boolean;
  selectedClips: Set<string>;
  onClipSelect: (clipId: string, multiSelect?: boolean) => void;
  onClipMove: (clipId: string, newStart: number, newTrackId: string) => void;
  onTimelineClick: (time: number) => void;
  onCurrentTimeChange: (time: number) => void;
}

interface DragState {
  clipId: string;
  startX: number;          // px relative to timeline scroll area
  startTime: number;       // sec
  originalTrackId: string;
}

const TRACK_HEADER_WIDTH = 120;
const RULER_HEIGHT = 32;
const SNAP_THRESHOLD = 5;  // px
const GRID_INTERVAL = 30;  // sec (base, adjusts with zoom)

export default function ProfessionalTimeline({
  clips,
  tracks,
  zoom,
  currentTime,
  totalDuration,
  isPlaying,
  selectedClips,
  onClipSelect,
  onClipMove,
  onTimelineClick,
}: ProfessionalTimelineProps) {
  const theming = useTheming();

  const [dragState, setDragState] = useState<DragState | null>(null);
  const [hoverTime, setHoverTime] = useState<number | null>(null);

  const timelineRef = useRef<HTMLDivElement>(null);
  const playheadRef = useRef<HTMLDivElement>(null);

  // scaling
  const pixelsPerSecond = useMemo(() => zoom * 10, [zoom]);
  const timeToPixels = useCallback(
    (time: number) => time * pixelsPerSecond,
    [pixelsPerSecond]
  );
  const pixelsToTime = useCallback(
    (px: number) => px / pixelsPerSecond,
    [pixelsPerSecond]
  );

  const timelineWidth = useMemo(
    () => Math.max(800, timeToPixels(totalDuration)),
    [timeToPixels, totalDuration]
  );

  // grid
  const gridLines = useMemo(() => {
    const lines: { time: number; position: number; isMain: boolean }[] = [];
    // adjust density with zoom
    const intervalBase = GRID_INTERVAL / Math.max(zoom, 0.01);
    const adjustedInterval =
      intervalBase < 1 ? 1 :
      intervalBase < 5 ? 5 :
      intervalBase < 10 ? 10 :
      intervalBase < 30 ? 30 : 60;

    for (let t = 0; t <= totalDuration; t += adjustedInterval) {
      const pos = timeToPixels(t);
      lines.push({
        time: t,
        position: pos,
        isMain: t % (adjustedInterval * 4) === 0,
      });
    }
    return lines;
  }, [zoom, totalDuration, timeToPixels]);

  // time formatting
  const formatTime = useCallback((seconds: number) => {
    const s = Math.max(0, seconds);
    const mins = Math.floor(s / 60);
    const secs = Math.floor(s % 60);
    const frames = Math.floor((s % 1) * 25); // 25 fps
    return `${mins}:${secs.toString().padStart(2, '0')}:${frames
      .toString()
      .padStart(2, '0')}`;
  }, []);

  // snapping
  const getSnapPosition = useCallback(
    (positionPx: number, clipId: string) => {
      const targets: number[] = [];

      // grid
      for (const line of gridLines) targets.push(line.position);

      // clip edges
      for (const clip of clips) {
        if (clip.id === clipId) continue;
        targets.push(timeToPixels(clip.start));
        targets.push(timeToPixels(clip.start + clip.duration));
      }

      // playhead
      targets.push(timeToPixels(currentTime));

      if (targets.length === 0) return positionPx;

      targets.sort((a, b) => Math.abs(positionPx - a) - Math.abs(positionPx - b));
      const closest = targets[0];
      return Math.abs(positionPx - closest) <= SNAP_THRESHOLD ? closest : positionPx;
    },
    [gridLines, clips, currentTime, timeToPixels]
  );

  // drag handlers
  const handleMouseMove = useCallback(
    (e: MouseEvent) => {
      if (!dragState || !timelineRef.current) return;

      // Determine target track by Y position
      const containerTop = timelineRef.current.getBoundingClientRect().top;
      const y = e.clientY - containerTop - RULER_HEIGHT; // beneath ruler
      let newTrackId = dragState.originalTrackId;
      let yCursor = 0;
      for (const track of tracks) {
        if (y >= yCursor && y < yCursor + track.height) {
          newTrackId = track.id;
          break;
        }
        yCursor += track.height;
      }

      // X → time
      const rect = timelineRef.current.getBoundingClientRect();
      const currentX = e.clientX - rect.left + timelineRef.current.scrollLeft;
      const deltaX = currentX - dragState.startX;
      const newStartRaw = dragState.startTime + pixelsToTime(deltaX);
      const snappedPx = getSnapPosition(timeToPixels(newStartRaw), dragState.clipId);
      const snappedTime = pixelsToTime(snappedPx);

      onClipMove(dragState.clipId, Math.max(0, snappedTime), newTrackId);
    },
    [dragState, tracks, getSnapPosition, pixelsToTime, timeToPixels, onClipMove]
  );

  const handleMouseUp = useCallback(() => {
    setDragState(null);
    window.removeEventListener('mousemove', handleMouseMove);
    window.removeEventListener('mouseup', handleMouseUp);
  }, [handleMouseMove]);

  const handleMouseDown = useCallback(
    (e: React.MouseEvent, clipId: string) => {
      e.preventDefault();
      e.stopPropagation();
      if (!timelineRef.current) return;

      const rect = timelineRef.current.getBoundingClientRect();
      const clip = clips.find((c) => c.id === clipId);
      if (!clip) return;

      setDragState({
        clipId,
        startX: e.clientX - rect.left + timelineRef.current.scrollLeft,
        startTime: clip.start,
        originalTrackId: clip.trackId,
      });

      window.addEventListener('mousemove', handleMouseMove);
      window.addEventListener('mouseup', handleMouseUp);
    },
    [clips, handleMouseMove, handleMouseUp]
  );

  // click + hover on timeline
  const handleTimelineClick = useCallback(
    (e: React.MouseEvent) => {
      if (!timelineRef.current || dragState) return;
      const rect = timelineRef.current.getBoundingClientRect();
      const x = e.clientX - rect.left + timelineRef.current.scrollLeft;
      const time = pixelsToTime(x);
      onTimelineClick(Math.max(0, Math.min(totalDuration, time)));
    },
    [dragState, pixelsToTime, onTimelineClick, totalDuration]
  );

  const handleMouseMoveHover = useCallback((e: MouseEvent) => {
    if (!timelineRef.current) return;
    const rect = timelineRef.current.getBoundingClientRect();
    const x = e.clientX - rect.left + timelineRef.current.scrollLeft;
    const time = pixelsToTime(x);
    setHoverTime(Math.max(0, Math.min(totalDuration, time)));
  }, [pixelsToTime, totalDuration]);

  const handleMouseLeaveHover = useCallback(() => {
    setHoverTime(null);
  }, []);
}, [pixelsToTime, totalDuration]);

  return (
    <Box sx={{ ...{}, flex: 1, display: 'flex', flexDirection: 'column', overflow: 'hidden', ...theming.getThemedBoxSx() }}>
      <Box sx={{ ...{}, px: 2, py: 1, bgcolor: 'background.paper', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
        <Typography variant="subtitle1" color="text.secondary">
          Timeline
        </Typography>
        <Box sx={{ ...{}, display: 'flex', alignItems: 'center', gap: 1 }}>
          <Button variant="contained" color="primary" onClick={handlePlayPause}>
            {isPlaying ? 'Pause' : 'Play'}
          </Button>
          <Button variant="contained" color="primary" onClick={handleRewind}>
            <Rewind className="w-4 h-4" />
          </Button>
          <Button variant="contained" color="primary" onClick={handleFastForward}>
            <FastForward className="w-4 h-4" />
          </Button>
        </Box>
      </Box>
      <Box sx={{ ...{}, height: RULER_HEIGHT, borderBottom: 1, borderColor: 'divider', bgcolor: 'background.paper', position: 'relative' }}>
        <div ref={rulerRef} style={{ position: 'absolute', top: 0, left: 0, right: 0, height: RULER_HEIGHT }}>
          {gridLines.map((line) => (
            <div key={line.time} style={{ position: 'absolute', left: line.position, width: 1, height: RULER_HEIGHT, backgroundColor: line.isMain ? 'white' : 'gray' }} />
          ))}
        </div>
      </Box>
      <Box sx={{ ...{}, height: timelineWidth, position: 'relative' }}>
        <div ref={timelineRef} style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0 }}>
          {clips.map((clip) => (
            <div key={clip.id} style={{ position: 'absolute', left: timeToPixels(clip.start), width: timeToPixels(clip.duration), height: '100%', backgroundColor: clip.trackId === 'V1' ? 'red' : clip.trackId === 'V2' ? 'blue' : clip.trackId === 'A1' ? 'green' : 'yellow' }} />
          ))}
        </div>
      </Box>
    </Box>
    );
}

function ProfessionalTimeline({
  clips,
  tracks,
  zoom,
  currentTime,
  totalDuration,
  isPlaying,
  selectedClips,
  onClipSelect,
  onClipMove,
  onTimelineClick,
}: ProfessionalTimelineProps) {
  const [isPlaying, setIsPlaying] = useState(false);
  const [currentTime, setCurrentTime] = useState(0);
  const [totalDuration, setTotalDuration] = useState(0);
  const [selectedClips, setSelectedClips] = useState<Set<string>>(new Set());
  const [onClipSelect, setOnClipSelect] = useState<((clipId: string, multiSelect?: boolean) => void)>(() => {});
  const [onClipMove, setOnClipMove] =  useCallback<((clipId: string, newStart: number, newTrackId: string) => void)>(onClipMove, [onClipMove]);
  const [onTimelineClick, setOnTimelineClick] = useCallback<((time: number) => void)>(onTimelineClick, [onTimelineClick]);
  const [rulerRef, setRulerRef] = useState<HTMLDivElement | null>(null);
  const [timelineRef, setTimelineRef] = useState<HTMLDivElement | null>(null);
  const [playheadRef, setPlayheadRef] = useState<HTMLDivElement | null>(null);
  const [dragState, setDragState] = useState<DragState | null>(null);
  const [hoverTime, setHoverTime] = useState<number | null>(null);
  const [pixelsPerSecond, setPixelsPerSecond] = useState(zoom * 10);
  const [timeToPixels, setTimeToPixels] = useState<((time: number) => number)>(() => (time) => time * pixelsPerSecond);
  const [pixelsToTime, setPixelsToTime] = useState<((px: number) => number)>(() => (px) => px / pixelsPerSecond);
  const [timelineWidth, setTimelineWidth] = useState<number>(Math.max(800, timeToPixels(totalDuration)));
  const [gridLines, setGridLines] = useState<{ time: number; position: number; isMain: boolean }[]>([]);
  const [formatTime, setFormatTime] = useState<((seconds: number) => string)>(() => (seconds) => {
    const s = Math.max(0, seconds);
    const mins = Math.floor(s / 60);
    const secs = Math.floor(s % 60);
    const frames = Math.floor((s % 1) * 25); // 25 fps
    return `${mins}:${secs.toString().padStart(2, '0')}:${frames.toString().padStart(2, '0')}`;
  });
  const [getSnapPosition, setGetSnapPosition] = useState<((positionPx: number, clipId: string) => number)>(() => (positionPx, clipId) => {
    const targets: number[] = [];
    for (const line of gridLines) targets.push(line.position);
    for (const clip of clips) if (clip.id !== clipId) {
      targets.push(timeToPixels(clip.start));
      targets.push(timeToPixels(clip.start + clip.duration));
    }
    targets.push(timeToPixels(currentTime));
    if (targets.length === 0) return positionPx;
    targets.sort((a, b) => Math.abs(positionPx - a) - Math.abs(positionPx - b));
    const closest = targets[0];
    return Math.abs(positionPx - closest) <= SNAP_THRESHOLD ? closest : positionPx;
  });
  const [handleMouseMove, setHandleMouseMove] = useState<((e: MouseEvent) => void)>(() => (e) => {
    if (!dragState || !timelineRef) return;
    const containerTop = timelineRef.getBoundingClientRect().top;
    const y = e.clientY - containerTop - RULER_HEIGHT;
    let newTrackId = dragState.originalTrackId;
    let yCursor = 0;
    for (const track of tracks) {
      if (y >= yCursor && y < yCursor + track.height) {
        newTrackId = track.id;
        break;
      }
      yCursor += track.height;
    }
    const rect = timelineRef.getBoundingClientRect();
    const currentX = e.clientX - rect.left + timelineRef.scrollLeft;
    const deltaX = currentX - dragState.startX;
    const newStartRaw = dragState.startTime + pixelsToTime(deltaX);
    const snappedPx = getSnapPosition(timeToPixels(newStartRaw), dragState.clipId);
    const snappedTime = pixelsToTime(snappedPx);
    onClipMove(dragState.clipId, Math.max(0, snappedTime), newTrackId);
  });
  const [handleMouseUp, setHandleMouseUp] = useState<(() => void)>(() => () => {
    setDragState(null);
    window.removeEventListener('mousemove', handleMouseMove);
    window.removeEventListener('mouseup', handleMouseUp);
  });
  const [handleMouseDown, setHandleMouseDown] = useState<((e: React.MouseEvent, clipId: string) => void)>(() => (e, clipId) => {
function handlePlayPause() {
  setIsPlaying(!isPlaying);
}

function handleRewind() {
  setCurrentTime(currentTime - 10);
  }, [currentTime]);

function handleFastForward() {
  setCurrentTime(currentTime + 10);
  }, [currentTime]);
}, [onClipMove]);

function handleTimelineClick(time: number) {
  setCurrentTime(Math.max(0, Math.min(totalDuration, time)));
  }, [currentTime, totalDuration]);
}, [onTimelineClick]);

function handleMouseMoveHover(e: MouseEvent) {
  if (!timelineRef) return;
  const rect = timelineRef.getBoundingClientRect();
  const x = e.clientX - rect.left + timelineRef.scrollLeft;
  const time = pixelsToTime(x);
  setHoverTime(Math.max(0, Math.min(totalDuration, time)));
}, [pixelsToTime, totalDuration]);

function handleMouseLeaveHover() {
  setHoverTime(null);
}
}, [pixelsToTime, totalDuration]);

function handleMouseDown(e: React.MouseEvent, clipId: string) {
  if (!timelineRef) return;
  const rect = timelineRef.getBoundingClientRect();
  const clip = clips.find((c) => c.id === clipId);
  if (!clip) return;
  setDragState({ clipId, startX: e.clientX - rect.left + timelineRef.scrollLeft, startTime: clip.start, originalTrackId: clip.trackId });
  window.addEventListener('mousemove', handleMouseMove);
  window.addEventListener('mouseup', handleMouseUp);
}
}, [clips, handleMouseMove, handleMouseUp]);

function handleMouseUp() {
  setDragState(null);
  window.removeEventListener('mousemove', handleMouseMove);
  window.removeEventListener('mouseup', handleMouseUp);
}
}, [handleMouseMove, handleMouseUp]);

function handleMouseMove(e: MouseEvent) {
  if (!dragState || !timelineRef) return;
  const containerTop = timelineRef.getBoundingClientRect().top;
  const y = e.clientY - containerTop - RULER_HEIGHT;
  let newTrackId = dragState.originalTrackId;
  let yCursor = 0;
  for (const track of tracks) {
