                  }
                  >
                    <MenuItem value="caller">Caller (Klient)</MenuItem>
                    <MenuItem value="listener">Listener (Server)</MenuItem>
                    <MenuItem value="rendezvous">Rendezvous (P2P)</MenuItem>
                  </Select>
                </FormControl>

                <TextField
                  fullWidth
                  label="Adresse"
                  value={srtConfig.address}
                  onChange={(e) =>
