                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <CheckCircle color="success" />
                    </ListItemIcon>
                    <ListItemText
                      primary="H.264/AAC codec støtte"
                      secondary="Industristandard for høy kvalitet og kompatibilitet"
                    />
