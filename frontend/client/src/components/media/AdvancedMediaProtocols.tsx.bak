                />

                <Typography gutterBottom>
                  Segment Varighet: {hlsConfig.segmentDuration} sekunder
                </Typography>
                <Slider
                  value={hlsConfig.segmentDuration}
                  onChange={(e, value) =>
                    setHlsConfig((prev) => ({
                      ...prev,
