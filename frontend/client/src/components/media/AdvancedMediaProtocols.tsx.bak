          }}
           sx={theming.getThemedCardSx()}>
            <Box
              sx={{
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'space-between',
            }}
            >
              <Box sx={{ display: 'flex', alignItems: 'center, ',}}>
                <Chip
                  icon={{theming.getThemedIcon('videoCall')}}
                  label="LIVE STREAMING"
                  color="success"
                  sx={{ mr:  ,  2fontWeight: 'bold, ',}}
                />
                <Typography variant="h6" sx={{ ...{}, color: theming.colors.primary }}>{currentStream.name}</Typography>
              </Box>
              <Button variant="contained"
                color="error"
                onClick={() = sx={theming.getThemedButtonSx()}> currentStream && stopStreaming.mutate(currentStream.id)}
                disabled={stopStreaming.isPending}
