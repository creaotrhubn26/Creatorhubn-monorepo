// Helper Functions
export function getProfessionBranding(profession: keyof typeof PROFESSION_BRANDING) {
  return PROFESSION_BRANDING[profession];
}

export function getProjectCategoryBranding(category: keyof typeof PROJECT_CATEGORY_BRANDING) {
  return PROJECT_CATEGORY_BRANDING[category];
}

export function getBrandColor(colorName: keyof typeof CREATOR_HUB_BRAND_COLORS) {
  return CREATOR_HUB_BRAND_COLORS[colorName];
}

// Brand Validation
export function validateBrandColor(color: string): boolean {
  const validColors = Object.values(CREATOR_HUB_BRAND_COLORS);
  return validColors.includes(color as any);
}

// Brand Consistency Checker
export function checkBrandConsistency(componentName: string, usedColor: string, expectedColor: string): void {
  if (usedColor !== expectedColor) {
    console.warn(`⚠️ Brand Inconsistency in ${componentName}: Expected ${expectedColor}, got ${usedColor}`);
}
}

// Export all branding as a single object for easy access
export const CREATOR_HUB_BRANDING = {
  colors: CREATOR_HUB_BRAND_COLORS,
  professions: PROFESSION_BRANDING,
  projectCategories: PROJECT_CATEGORY_BRANDING,
  typography: BRAND_TYPOGRAPHY,
  spacing: BRAND_SPACING,
  shadows: BRAND_SHADOWS,
  borderRadius: BRAND_BORDER_RADIUS,
  helpers: {
    getProfessionBranding,
    getProjectCategoryBranding,
    getBrandColor,
    validateBrandColor,
    checkBrandConsistency,
},
} as const;

// Type exports for TypeScript
export type ProfessionType = keyof typeof PROFESSION_BRANDING;
export type ProjectCategoryType = keyof typeof PROJECT_CATEGORY_BRANDING;
export type BrandColorType = keyof typeof CREATOR_HUB_BRAND_COLORS;
