import { useTheming } from '../utils/theming-helper';
import React, { useState, Suspense } from 'react';
import {
  Container,
  Paper,
  Typography,
  Button,
  TextField,
  Box,
  Alert,
  CircularProgress,
  List,
  ListItem,
  ListItemText,
  ListItemIcon,
  Divider,
  Card as MuiCard,
  CardContent,
} from '@mui/material';
import {
  Security as SecurityIcon,
  Link as LinkIcon,
  Key as KeyIcon,
  Check as CheckIcon,
  Email as EmailIcon,
} from '@mui/icons-material';

interface AuthUrlResponse {
  success: boolean;
  authUrl?: string;
  instructions?: string[];
  error?: string; 
}

interface TokenResponse {
  success: boolean;
  tokens?: any;
  nextSteps?: string[];
  error?: string; 
}

interface TestResponse {
  success: boolean;
  status?: string;
  gmailAccess?: boolean;
  userProfile?: any;
  error?: string; 
}

const GoogleOAuthSetupPage: React.FC = () => {
  const [step, setStep] = useState<'start' | 'authorize' | 'complete'>('start');
  const [authUrl, setAuthUrl] = useState<string>('');
  const [instructions, setInstructions] = useState<string[]>([]);
  const [authCode, setAuthCode] = useState<string>('');
  const [loading, setLoading] = useState(false);
  
  // Theming system
  const theming = useTheming('photographer');
  const [error, setError] = useState<string>('');
  const [successMessage, setSuccessMessage] = useState<string>('');
  const [refreshToken, setRefreshToken] = useState<string>('');
  const [testResult, setTestResult] = useState<TestResponse | null>(null);

  // Check for OAuth callback parameters
  React.useEffect(() => {
    const urlParams = new URLSearchParams(window.location.search);
    const code = urlParams.get('code');
    const callbackError = urlParams.get('error');

    if (callbackError) {
      setError(`OAuth error: ${callbackError}`);
  } else if (code) {
      setAuthCode(code);
      setStep('authorize');
      setSuccessMessage('Autorisasjonskode mottatt! Klikk "Hent Tokens" for å fullføre.');
  }
}, []);

  const generateAuthUrl = async () => {
    setLoading(true);
    setError('');

    try {
      const response = await fetch('/api/google-oauth/setup');
      const data: AuthUrlResponse = await response.json();

      if (data.success && data.authUrl) {
        setAuthUrl(data.authUrl);
        setInstructions(data.instructions || []);
        setStep('authorize');
  } else {
        setError(data.error || 'Failed to generate authorization URL');
    }
  } catch (err) {
      setError('Network error while generating authorization URL');
  } finally {
      setLoading(false);
  }
};

  const exchangeCodeForTokens = async () => {
    if (!authCode.trim()) {
      setError('Vennligst skriv inn autorisasjonskoden');
      return;
  }

    setLoading(true);
    setError('');

    try {
      const response = await fetch('/api/google-oauth/exchange', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ code: authCode }),
      });

      const data: TokenResponse = await response.json();

      if (data.success && data.tokens) {
        setRefreshToken(data.tokens.refresh_token);
        setSuccessMessage('OAuth tokens hentet vellykket!');
        setStep('complete');
  } else {
        setError(data.error || 'Failed to exchange authorization code');
    }
  } catch (err) {
      setError('Network error while exchanging authorization code');
  } finally {
      setLoading(false);
  }
};

  const testCurrentConfiguration = async () => {
    setLoading(true);
    setError('');

    try {
      const response = await fetch('/api/google-oauth/test');
      const data: TestResponse = await response.json();
      setTestResult(data);

      if (!data.success) {
        setError(data.error || 'OAuth test failed');
  }
  } catch (err) {
      setError('Network error during OAuth test');
  } finally {
      setLoading(false);
  }
};

  return (
    <Container maxWidth="md" sx={{ py: 4 }}>
      <Paper elevation={3} sx={{ p: 4, ...theming.getThemedCardSx() }}>
        <Box sx={{ display: 'flex', alignItems: 'center', mb: 3 }}>
          <SecurityIcon sx={{ mr: 2, fontSize: 32, color: 'primary.main' }} />
          <Typography variant="h4" component="h1" sx={{ color: theming.colors.primary }}>
            Google OAuth Setup - CreatorHub Norge
          </Typography>
        </Box>

        <Typography variant="body1" sx={{ mb: 3, color: 'text.secondary' }}>
          Sett opp Google OAuth for å aktivere e-postsending via Gmail API i CreatorHub Norge.
        </Typography>

        {error && (
          <Alert severity="error" sx={{ mb: 3 }}>
            {error}
          </Alert>
        )}

        {successMessage && (
          <Alert severity="success" sx={{ mb: 3 }}>
            {successMessage}
          </Alert>
        )}

        {step === 'start' && (
          <MuiCard sx={{ mb: 3, ...theming.getThemedCardSx() }}>
            <CardContent>
              <Typography variant="h6" sx={{ mb: 2, display: 'flex', alignItems: 'center', color: theming.colors.primary }}>
                <KeyIcon sx={{ mr: 1 }} />
                Steg 1: Generer autorisasjons-URL
              </Typography>
              <Typography variant="body2" sx={{ mb: 3 }}>
                Klikk knappen nedenfor for å generere en Google OAuth autorisasjons-URL. Dette vil
                gi deg instruksjoner for å få en refresh token.
              </Typography>
              <Button variant="contained"
                onClick={generateAuthUrl}
                disabled={loading}
                startIcon={loading ? <CircularProgress size={20} /> : <LinkIcon />}
                sx={theming.getThemedButtonSx()}
                size="large"
              >
                {loading ? 'Genererer...' : 'Generer Autorisasjons-URL'}
              </Button>
            </CardContent>
          </MuiCard>
        )}

        {step === 'authorize' && (
          <MuiCard sx={{ mb: 3 }}>
            <CardContent sx={theming.getThemedCardSx()}>
              <Typography variant="h6" sx={{ mb: 2, display: 'flex', alignItems: 'center', color: theming.colors.primary }}>
                <LinkIcon sx={{ mr: 1 }} />
                Steg 2: Autoriser og få kode
              </Typography>

              <Alert severity="success" sx={{ mb: 3 }}>
                <Typography variant="body2" sx={{ fontWeight: 'bold', mb: 1 }}>
                  ✅ OAuth Konfigurert!
                </Typography>
                <Typography variant="body2" sx={{ mb: 2 }}>
                  Systemet bruker nå Replit-domenet ditt som allerede er konfigurert i Google Cloud
                  Console: </Typography>
                <Typography
                  variant="body2"
                  sx={{
                    fontFamily: 'monospace',
                    bgcolor: 'grey.10',
                    p:  1,
                    borderRadius:  1,
                    mb: 2,
                }}
                >
                  https: //37a8abc6-e715-4168-a2ed-60eadcd68aa2-00-2hx7yy23lwlhk.kirk.replit.dev/auth/google/callback
                </Typography>
                <Typography variant="body2">
                  Denne URI-en er allerede lagt til i Google Cloud Console, så OAuth skal fungere
                  direkte!
                </Typography>
              </Alert>

              <Alert severity="info" sx={{ mb: 3 }}>
                <Typography variant="body2" sx={{ fontWeight: 'bold', mb: 1 }}>
                  Etter Google Cloud Console er konfigurert: </Typography>
                <List dense>
                  {instructions.map((instruction, index) => (
                    <ListItem key={index} sx={{ py: 0.5 }}>
                      <ListItemIcon sx={{ minWidth: 30 }}>
                        <Typography variant="body2" sx={{ fontWeight: 'bold' }}>
                          {index + 1}.
                        </Typography>
                      </ListItemIcon>
                      <ListItemText primary={instruction} />
                    </ListItem>
                  ))}
                </List>
              </Alert>

              <Button variant="contained"
                color="primary"
                href={authUrl}
                target="_blank"
                rel="noopener noreferrer"
                sx={{ mb: 3, mr: 2, ...theming.getThemedButtonSx() }}
                startIcon={<LinkIcon />}
              >
                Åpne Google OAuth
              </Button>

              <Divider sx={{ my: 3 }} />

              <Typography variant="body2" sx={{ mb: 2 }}>
                Når du har fulgt stegene over, skriv inn autorisasjonskoden her: </Typography>

              <TextField
                fullWidth
                label="Autorisasjonskode"
                value={authCode}
                onChange={(e) => setAuthCode(e.target.value)}
                placeholder="Lim inn koden fra Google"
                sx={{ mb: 3 }}
                multiline
                rows={2}
              />

              <Button variant="contained"
                onClick={exchangeCodeForTokens}
                disabled={loading || !authCode.trim()}
                startIcon={loading ? <CircularProgress size={20} /> : <KeyIcon />}
                sx={theming.getThemedButtonSx()}
                size="large"
              >
                {loading ? 'Behandler...' : 'Hent Tokens'}
              </Button>
            </CardContent>
          </MuiCard>
        )}

        {step === 'complete' && refreshToken && (
          <MuiCard sx={{ mb: 3 }}>
            <CardContent sx={theming.getThemedCardSx()}>
              <Typography variant="h6"
                sx={{
                  mb: 2,
                  display: 'flex',
                  alignItems: 'center',
                  color: 'success.main',
              }}
               sx={{ ...{}, color: theming.colors.primary }}>
                <CheckIcon sx={{ mr: 1 }} />
                Steg 3: Konfigurasjon Fullført!
              </Typography>

              <Alert severity="success" sx={{ mb: 3 }}>
                OAuth tokens er generert vellykket! Legg til refresh token i miljøvariabler.
              </Alert>

              <Typography variant="body2" sx={{ mb: 2, fontWeight: 'bold' }}>
                Legg til denne miljøvariabelen i Replit Secrets: </Typography>

              <Paper sx={{ p: 2, bgcolor: 'grey.100', mb: 3, ...theming.getThemedCardSx() }}>
                <Typography
                  variant="body2"
                  sx={{ fontFamily: 'monospace', wordBreak: 'break-all' }}
                >
                  <strong>GOOGLE_WORKSPACE_REFRESH_TOKEN</strong>
                  <br />
                  {refreshToken}
                </Typography>
              </Paper>

              <Typography variant="body2" sx={{ mb: 3, color: 'text.secondary' }}>
                Etter at du har lagt til denne miljøvariabelen, restart serveren for å aktivere
                OAuth2-autentisering.
              </Typography>
            </CardContent>
          </MuiCard>
        )}

        <Divider sx={{ my: 3 }} />

        <MuiCard>
          <CardContent sx={theming.getThemedCardSx()}>
            <Typography variant="h6" sx={{ mb: 2, display: 'flex', alignItems: 'center', color: theming.colors.primary }}>
              <EmailIcon sx={{ mr: 1 }} />
              Test Nåværende Konfigurasjon
            </Typography>

            <Typography variant="body2" sx={{ mb: 2 }}>
              Test om OAuth-konfigurasjonen fungerer med eksisterende innstillinger.
            </Typography>

            <Button
              variant="outlined"
              onClick={testCurrentConfiguration}
              disabled={loading}
              startIcon={loading ? <CircularProgress size={20} /> : <CheckIcon />}
              sx={{ mb: 2 }}
            >
              {loading ? 'Tester...' : 'Test OAuth Konfigurasjon'}
            </Button>

            {testResult && (
              <Alert severity={testResult.success ? 'success' : 'warning'} sx={{ mt: 2 }}>
                <Typography variant="body2" sx={{ fontWeight: 'bold, ',}}>
                  Status: {testResult.status}
                </Typography>
                {testResult.success && testResult.userProfile && (
                  <Typography variant="body2">
                    E-post: {testResult.userProfile.emailAddress}
                  </Typography>
                )}
                {testResult.success && testResult.gmailAccess && (
                  <Typography variant="body2" sx={{ color: 'success.main' }}>
                    Gmail API-tilgang bekreftet
                  </Typography>
                )}
              </Alert>
            )}
          </CardContent>
        </MuiCard>
      </Paper>
    </Container>
  );
};

export default GoogleOAuthSetupPage;
