          <Tab label="Videografer" />
          <Tab label="Musikere" />
          <Tab label="Animasjonstyper" />
          <Tab label="Admin View" />
        </Tabs>
      </Paper>

      {/* Tab Panels */}
      <TabPanel value={currentTab} index={0}>
        <CompanyProfileGrid
          title="Alle Kreative Bedrifter"
          showFilters={true}
          showSearch={true}
          animation="stagger"
          onProfileSelect={handleProfileSelect}
          onProfileContact={handleProfileContact}
        />
      </TabPanel>

      <TabPanel value={currentTab} index={1}>
        <CompanyProfileGrid
          title="Fotografer"
          showFilters={true}
          showSearch={true}
          animation="slide"
          filterIndustries={['Fotograftjenester']}
          onProfileSelect={handleProfileSelect}
          onProfileContact={handleProfileContact}
        />
      </TabPanel>

      <TabPanel value={currentTab} index={2}>
