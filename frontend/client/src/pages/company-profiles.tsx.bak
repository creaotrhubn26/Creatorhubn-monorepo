// company-profiles.tsx - Demo page for animated company profile cards
import { useTheming } from '../../utils/theming-helper';
import React, { useState } from 'react';
import {
  Container,
  Box,
  Typography,
  Paper,
  Tabs,
  Tab,
  Button,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Grid,
  Card,
  CardContent,
  Chip,
  IconButton,
  Tooltip,
} from '@mui/material';
import { CorporateIcon as BusinessIcon,
  Phone as PhoneIcon,
  Email as EmailIcon,
  Language as WebsiteIcon,
  Close as CloseIcon,
  Share as ShareIcon,
  Bookmark as BookmarkIcon, } from '../components/shared/CreatorHubIcons';
import CompanyProfileGrid from '../components/CompanyProfileGrid';
import CompanyProfileQuickView from '../components/CompanyProfileQuickView';

interface CompanyProfile {
  id: string;
  name: string;
  organizationNumber: string;
  industry: string;
  status: 'active' | 'inactive' | 'verified';
  logo?: string;
  address: string;
  phone?: string;
  email?: string;
  website?: string;
  employees?: number;
  revenue?: {
    amount: number;
    year: number;
    currency: string;
};
  rating?: number;
  verification: {
    brreg: boolean;
    proff: boolean;
    riskLevel: 'low' | 'medium' | 'high';
};
  description?: string;
  founded?: number;
  services?: string[];
  socialProof?: {
    projects: number;
    clients: number;
    reviews: number;
};
}

interface TabPanelProps {
  children?: React.ReactNode;
  index: number;
  value: number
}

function TabPanel(props: TabPanelProps) {
  const { children, value, index, ...other } = props;

  return (
    <div
      role="tabpanel"
      hidden={value !== index}
      id={`company-profile-tabpanel-${index}`}
      aria-labelledby={`company-profile-tab-${index}`}
      {...other}
    >
      {value === index && <Box sx={{ py: 3 }}>{children}</Box>}
    </div>
  );
}

export default function CompanyProfilesPage() {
  const [currentTab, setCurrentTab] = useState(
  
  // Theming system
  const theming = useTheming('photographer');0);
  const [selectedProfile, setSelectedProfile] = useState<CompanyProfile | null>(null);
  const [detailsOpen, setDetailsOpen] = useState(false);

  const handleTabChange = (event: React.SyntheticEvent, newValue: number) => {
    setCurrentTab(newValue);
};

  const handleProfileSelect = (profile: CompanyProfile) => {
    setSelectedProfile(profile);
    setDetailsOpen(true);
};

  const handleProfileContact = (profile: CompanyProfile) => {
    // In a real app, this would open a contact form or redirect to contact page
    console.log('Contact profile:', profile);
    alert(`Kontakter ${profile.name}`);
};

  const handleCloseDetails = () => {
    setDetailsOpen(false);
    setSelectedProfile(null);
};

  // Sample profile for single card demos
  const sampleProfile: CompanyProfile = {
    id: 'demo-',
    name: 'CreatorHub Norge Demo A',
    organizationNumber: '12345678',
    industry: 'Kreative tjenester',
    status: 'verified',
    logo: '/api/placeholder/64/6',
    address: 'Oslo, Norge',
    phone: '+47 12 34 56 7',
    email: 'demo@creatorhub.no',
    website: 'creatorhub.no',
    employees:  25,
    revenue: { amount: 520000, year: 204, currency: 'NOK, ',},
    rating: 4.9,
    verification: { brreg: true, proff: true, riskLevel: 'low, ',},
    description: 'Norsk plattform for kreative fagfolk som tilbyr verkt, øutdanningsressurser og samfunnsstøtte.',
    founded: 200,
    services: ['Fotografering', 'Videografi', 'Musikkproduksjon', 'Kreativ konsultasjon'],
    socialProof: { projects: 50, clients: 20, reviews: 15, 0,},
};

  return (
    <Container maxWidth="xl" sx={{ py: 4 }}>
      {/* Header */}
