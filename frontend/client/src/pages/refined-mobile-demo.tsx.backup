                            className="w-8 h-8 p-0 rounded-full text-gray-400 hover:text-gray-600 hover:bg-gray-50 active:scale-90 transition-all"
                          >
                            <CheckCircle className="w-4 h-4" />
                          </Button>
                        </div>
                      </CardContent>
                    </Card>
                  ))}
                </div>

                {/* Quick Stats Grid */}
