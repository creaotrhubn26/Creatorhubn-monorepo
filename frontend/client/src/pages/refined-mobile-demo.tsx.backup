            <Card className="bg-white/40 backdrop-blur-xl border border-blue-200/50 shadow-2xl shadow-blue-500/20 rounded-3xl overflow-hidden hover:shadow-2xl hover:shadow-blue-500/30 hover:bg-white/50 transition-all duration-300">
