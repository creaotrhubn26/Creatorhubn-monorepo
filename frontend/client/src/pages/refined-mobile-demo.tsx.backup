            >
              {item.isSpecial ? (
                <div className={`w-14 h-14 bg-gradient-to-r from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30 border-4 border-white transition-all duration-200 ${
                  touchedButtons.has(`nav-${idx}`) ? 'scale-95 shadow-xl' : 'hover:scale-105 active:scale-95'
                }`}>
                  <item.icon className="w-6 h-6 text-white" />
                </div>
              ) : (
                <>
                  <div className="w-6 h-6 mb-1">
                    <item.icon className="w-full h-full" />
                  </div>
                  <span className="text-xs font-medium">{item.label}</span>
                  {item.active && (
                    <div className="w-1 h-1 bg-amber-500 rounded-full mt-1"></div>
                  )}
                </>
              )}
            </button>
          ))}
        </div>
      </div>
    </div>
  );
};

export default RefinedMobileDemo;