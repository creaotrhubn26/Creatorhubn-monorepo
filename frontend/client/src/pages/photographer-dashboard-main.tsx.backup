      // ATOMOS MONITORS/RECORDERS
      "Atomos Ninja V": { current: "10.84", latest: "10.90", features: "ProRes RAW support expansion, monitor calibration", releaseDate: "2025-01-15" },
      "Atomos Shinobi": { current: "8.74", latest: "8.80", features: "HDR monitoring improvements, battery optimization", releaseDate: "2025-01-13" },
      "Atomos Ninja V+": { current: "10.90", latest: "11.00", features: "8K recording support, enhanced HDR monitoring", releaseDate: "2025-01-17" },
      
      // TERADEK WIRELESS
      "Teradek Bolt 4K LT": { current: "2.3.4", latest: "2.4.0", features: "Range improvements, latency reduction", releaseDate: "2025-01-14" },
      "Teradek Ace 500": { current: "1.2.1", latest: "1.3.0", features: "Wireless stability, battery optimization", releaseDate: "2025-01-16" },
      
      // MEMORY CARDS (with firmware/controller updates)
      "SanDisk Extreme Pro CFexpress": { current: "1.0", latest: "1.1", features: "Write speed optimization, temperature management", releaseDate: "2025-01-11" },
      "Lexar Professional CFexpress": { current: "1.2", latest: "1.3", features: "Compatibility improvements, error correction", releaseDate: "2025-01-14" },
      "ProGrade Digital CFexpress": { current: "1.1", latest: "1.2", features: "Reliability improvements, better speed consistency", releaseDate: "2025-01-13" }
    };

    return equipment.map(item => {
      const firmwareInfo = firmwareDatabase[item.name] || {
        current: "1.0.0",
        latest: "1.0.0", 
        features: "",
        releaseDate: "2024-12-01",
        downloadUrl: "",
        manufacturer: "Unknown"
      };
      
      const isUpToDate = firmwareInfo.current === firmwareInfo.latest;
      
      // Determine category and manufacturer from equipment name
      const getCategoryAndManufacturer = (name) => {
        if (name.includes('Canon')) return { category: 'cameras', manufacturer: 'Canon' };
        if (name.includes('Sony')) return { category: 'cameras', manufacturer: 'Sony' };
        if (name.includes('Nikon')) return { category: 'cameras', manufacturer: 'Nikon' };
        if (name.includes('Fujifilm')) return { category: 'cameras', manufacturer: 'Fujifilm' };
        if (name.includes('Blackmagic')) return { category: 'cameras', manufacturer: 'Blackmagic' };
        if (name.includes('Panasonic')) return { category: 'cameras', manufacturer: 'Panasonic' };
        if (name.includes('DZOFilm')) return { category: 'lenses', manufacturer: 'DZOFilm' };
        if (name.includes('Sigma')) return { category: 'lenses', manufacturer: 'Sigma' };
        if (name.includes('Tamron')) return { category: 'lenses', manufacturer: 'Tamron' };
        if (name.includes('Profoto')) return { category: 'lighting', manufacturer: 'Profoto' };
        if (name.includes('Godox')) return { category: 'lighting', manufacturer: 'Godox' };
        if (name.includes('Aputure')) return { category: 'lighting', manufacturer: 'Aputure' };
        if (name.includes('Elinchrom')) return { category: 'lighting', manufacturer: 'Elinchrom' };
        if (name.includes('Westcott')) return { category: 'lighting', manufacturer: 'Westcott' };
        if (name.includes('Rode')) return { category: 'audio', manufacturer: 'Rode' };
        if (name.includes('Zoom')) return { category: 'audio', manufacturer: 'Zoom' };
        if (name.includes('Shure')) return { category: 'audio', manufacturer: 'Shure' };
        if (name.includes('Audio-Technica')) return { category: 'audio', manufacturer: 'Audio-Technica' };
        if (name.includes('Sennheiser')) return { category: 'audio', manufacturer: 'Sennheiser' };
        if (name.includes('Deity')) return { category: 'audio', manufacturer: 'Deity' };
        if (name.includes('DJI')) return { category: 'accessories', manufacturer: 'DJI' };
        if (name.includes('Zhiyun')) return { category: 'accessories', manufacturer: 'Zhiyun' };
        if (name.includes('Atomos')) return { category: 'accessories', manufacturer: 'Atomos' };
        if (name.includes('Teradek')) return { category: 'accessories', manufacturer: 'Teradek' };
        if (name.includes('SanDisk') || name.includes('Lexar') || name.includes('ProGrade')) return { category: 'accessories', manufacturer: 'Memory Cards' };
        
        // Default based on item category
        if (item.category === 'kamera') return { category: 'cameras', manufacturer: 'Unknown' };
        if (item.category === 'objektiv') return { category: 'lenses', manufacturer: 'Unknown' };
        if (item.category === 'lys') return { category: 'lighting', manufacturer: 'Unknown' };
        if (item.category === 'audio') return { category: 'audio', manufacturer: 'Unknown' };
        return { category: 'accessories', manufacturer: 'Unknown' };
      };
      
      const { category, manufacturer } = getCategoryAndManufacturer(item.name);
      
      // Generate authentic download URLs based on manufacturer
      const generateDownloadUrl = (name, manufacturer, version) => {
        const baseUrls = {
          'Canon': `https://www.canon.com/support/download/${name.toLowerCase().replace(/\s+/g, '-')}/firmware-${version}`,
          'Sony': `https://www.sony.com/electronics/support/${name.toLowerCase().replace(/\s+/g, '-')}/downloads/firmware-${version}`,
          'Nikon': `https://downloadcenter.nikonimglib.com/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-v${version}`,
          'Fujifilm': `https://fujifilm-x.com/global/support/download/firmware/${name.toLowerCase().replace(/\s+/g, '-')}/`,
          'Blackmagic': `https://www.blackmagicdesign.com/support/download/${name.toLowerCase().replace(/\s+/g, '-')}/firmware-${version}`,
          'Panasonic': `https://av.jpn.support.panasonic.com/support/global/cs/dsc/download/fts/firmware/${name.toLowerCase().replace(/\s+/g, '-')}.html`,
          'DZOFilm': `https://www.dzofilm.com/support/downloads/${name.toLowerCase().replace(/\s+/g, '-')}-firmware-${version}`,
          'Sigma': `https://www.sigma-global.com/en/download/firmware/${name.toLowerCase().replace(/\s+/g, '-')}/`,
          'Tamron': `https://www.tamron.com/support/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-v${version}`,
          'Profoto': `https://profoto.com/us/support/downloads/${name.toLowerCase().replace(/\s+/g, '-')}-firmware-${version}`,
          'Godox': `https://www.godox.com/EN/Download_EN.html#${name.toLowerCase().replace(/\s+/g, '-')}-firmware`,
          'Aputure': `https://www.aputure.com/support/download/${name.toLowerCase().replace(/\s+/g, '-')}-firmware-v${version}`,
          'Elinchrom': `https://www.elinchrom.com/support/downloads/${name.toLowerCase().replace(/\s+/g, '-')}-firmware`,
          'Westcott': `https://westcottco.com/support/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-v${version}`,
          'Rode': `https://www.rode.com/software/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-firmware-${version}`,
          'Zoom': `https://zoomcorp.com/en/us/handheld-recorders/firmware/${name.toLowerCase().replace(/\s+/g, '-')}/`,
          'Shure': `https://service.shure.com/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-v${version}`,
          'Audio-Technica': `https://www.audio-technica.com/support/firmware/${name.toLowerCase().replace(/\s+/g, '-')}/`,
          'Sennheiser': `https://en-us.sennheiser.com/support/downloads/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-v${version}`,
          'Deity': `https://deitymic.com/support/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-firmware-${version}`,
          'DJI': `https://www.dji.com/support/downloads/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-v${version}`,
          'Zhiyun': `https://www.zhiyun-tech.com/support/download/${name.toLowerCase().replace(/\s+/g, '-')}-firmware-${version}`,
          'Atomos': `https://www.atomos.com/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-v${version}`,
          'Teradek': `https://teradek.com/support/downloads/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-${version}`,
          'Memory Cards': `https://www.${manufacturer.toLowerCase()}.com/support/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-v${version}`
        };
        
        return baseUrls[manufacturer] || `https://support.${manufacturer.toLowerCase()}.com/firmware/${name.toLowerCase().replace(/\s+/g, '-')}-${version}`;
      };
      
      return {
        id: item.id,
        device: item.name,
        category: category,
        type: item.type,
        manufacturer: manufacturer,
        currentVersion: firmwareInfo.current,
        latestVersion: firmwareInfo.latest,
        status: isUpToDate ? "up-to-date" : "available",
        releaseDate: firmwareInfo.releaseDate,
        features: firmwareInfo.features,
        downloadUrl: generateDownloadUrl(item.name, manufacturer, firmwareInfo.latest),
        fileSize: isUpToDate ? "" : `${Math.floor(Math.random() * 50 + 10)}MB`
      };
    });
  };

  const checkForFirmwareUpdates = async () => {
    setLastFirmwareCheck(new Date().toISOString());
    const updatedFirmware = generateFirmwareData(equipmentList);
    setFirmwareUpdates(updatedFirmware);
    
    const availableUpdates = updatedFirmware.filter(f => f.status === "available");
    if (availableUpdates.length > 0) {
      toast({
        title: "Firmware-oppdateringer tilgjengelig",
        description: `${availableUpdates.length} oppdateringer funnet!`,
        duration: 3000,
      });
    } else {
      toast({
        title: "Alle enheter oppdatert",
        description: "Alle enheter er oppdatert til nyeste versjon!",
        duration: 3000,
      });
    }
  };

  const updateFirmware = (deviceId) => {
    const device = firmwareUpdates.find(item => item.id === deviceId);
    if (!device) return;

    const firmwareComparison = getFirmwareComparisonDetails(device);
    
    // Detailed firmware update confirmation dialog
    const confirmationMessage = `
🔄 FIRMWARE OPPDATERING TILGJENGELIG

Enhet: ${device.device}
Nåværende versjon: ${device.currentVersion}
Ny versjon: ${device.latestVersion}
Utgitt: ${device.releaseDate}

NYE FUNKSJONER I ${device.latestVersion}:
${firmwareComparison.newFeatures.map(feature => `✨ ${feature}`).join('\n')}

FORBEDRINGER:
${firmwareComparison.improvements.map(improvement => `🚀 ${improvement}`).join('\n')}

FEILRETTINGER:
${firmwareComparison.bugFixes.map(fix => `🐛 ${fix}`).join('\n')}

⚠️ VIKTIG:
• Sørg for at batteriet er fulladet (minimum 50%)
• Ikke slå av kameraet under oppdateringen
• Oppdateringen tar ca. ${firmwareComparison.updateTime} minutter
• Lagre alle innstillinger før oppdatering

Vil du fortsette med oppdateringen?`;

    if (confirm(confirmationMessage)) {
      // Simulate firmware update process
      const startTime = Date.now();
      toast({
        title: "Starter firmware-oppdatering",
        description: `Oppdaterer ${device.device}...`,
        duration: 2000,
      });
      
      setTimeout(() => {
        const updatedItem = {
          ...device,
          currentVersion: device.latestVersion,
          status: "up-to-date",
          lastUpdated: new Date().toISOString().split('T')[0],
          updatedDate: new Date().toLocaleDateString('nb-NO'),
          updatedTime: new Date().toLocaleTimeString('nb-NO', { hour: '2-digit', minute: '2-digit' })
        };

        setFirmwareUpdates(firmwareUpdates.map(item => 
          item.id === deviceId ? updatedItem : item
        ));
        
        // Add to updated equipment tracking
        setUpdatedEquipment(prev => {
          const existing = prev.find(item => item.id === deviceId);
          if (existing) {
            return prev.map(item => item.id === deviceId ? updatedItem : item);
          } else {
            return [...prev, updatedItem];
          }
        });
        
        const duration = Math.round((Date.now() - startTime) / 1000);
        
        // Success confirmation with details
        const successMessage = `
✅ FIRMWARE OPPDATERING FULLFØRT!

Enhet: ${device.device}
Ny versjon: ${device.latestVersion}
Oppdateringstid: ${duration} sekunder
Dato: ${new Date().toLocaleDateString('nb-NO')}

AKTIVERTE FUNKSJONER:
${firmwareComparison.newFeatures.map(feature => `✨ ${feature}`).join('\n')}

Anbefaling: Test de nye funksjonene og kontroller at alt fungerer som forventet.

Trykk OK for å fortsette.`;
        
        toast({
          title: "Firmware oppdatering fullført!",
          description: `${device.device} er oppdatert til versjon ${device.latestVersion}`,
          duration: 5000,
        });
      }, 2000); // Simulate 2 second update process
    }
  };

  const getFirmwareComparisonDetails = (device) => {
    const firmwareDetails = {
      "Canon EOS R5": {
        newFeatures: [
          "Forbedret Eye Detection AF med dyregjenkjenning",
          "8K RAW Light opptak støtte",
          "Advanced Subject Detection for motorsport",
