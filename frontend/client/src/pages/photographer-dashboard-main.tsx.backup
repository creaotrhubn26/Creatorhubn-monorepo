            </Tabs>
          </TabsContent>

          {/* Comprehensive Firmware Management Tab */}
          <TabsContent value="firmware" className="space-y-6">
            <div className="p-6 bg-gradient-to-r from-orange-50 to-red-50 rounded-lg border-orange-200">
              <h3 className="font-bold text-orange-900 mb-3 flex items-center">
                <Download className="h-6 w-6 mr-2" />
                ⚙️ Firmware-oppdateringer - Kategorisert etter utstyrstype
              </h3>
              <div className="text-sm text-orange-700">
                Hold alt utstyr oppdatert med siste firmware fra alle produsenter verden over. Klikk "Last ned" for direkte tilgang til produsentens nedlastingssider.
              </div>
            </div>

            {/* Categorized Firmware Updates */}
            <div className="space-y-8">
              {['cameras', 'lenses', 'lighting', 'audio', 'accessories'].map(category => {
                const categoryUpdates = firmwareUpdates.filter(f => f.status === 'available' && f.category === category);
                if (categoryUpdates.length === 0) return null;
                
                const categoryInfo = {
                  cameras: { name: '📷 Kameraer', icon: '📷', color: 'blue', bgColor: 'bg-blue-50', borderColor: 'border-blue-200', textColor: 'text-blue-800' },
                  lenses: { name: '🔍 Objektiver', icon: '🔍', color: 'purple', bgColor: 'bg-purple-50', borderColor: 'border-purple-200', textColor: 'text-purple-800' },
                  lighting: { name: '💡 Lys & Blitz', icon: '💡', color: 'yellow', bgColor: 'bg-yellow-50', borderColor: 'border-yellow-200', textColor: 'text-yellow-800' },
                  audio: { name: '🎤 Audio', icon: '🎤', color: 'green', bgColor: 'bg-green-50', borderColor: 'border-green-200', textColor: 'text-green-800' },
                  accessories: { name: '🎒 Tilbehør & Gimbals', icon: '🎒', color: 'gray', bgColor: 'bg-gray-50', borderColor: 'border-gray-200', textColor: 'text-gray-800' }
                };
                
                const info = categoryInfo[category];
                
                return (
                  <div key={category} className="p-6 bg-blue-50 rounded-xl border-blue-200 border-2">
                    <div className="flex items-center gap-3 mb-6">
                      <span className="text-3xl">{info.icon}</span>
                      <div>
                        <h4 className="text-xl font-bold text-blue-800">{info.name}</h4>
                        <div className="flex items-center gap-2">
                          <Badge variant="outline" className="bg-blue-50 text-blue-800 border-blue-200 font-semibold">
                            {categoryUpdates.length} oppdatering{categoryUpdates.length !== 1 ? 'er' : ''} tilgjengelig
                          </Badge>
                          <span className="text-sm text-gray-600">Verdensomspennende produsenter</span>
                        </div>
                      </div>
                    </div>
                    
                    <div className="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4">
                      {categoryUpdates.map((firmware) => (
                        <div key={firmware.id} className="p-5 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border-white/60 rounded-lg hover:bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 transition-colors duration-200 shadow-sm hover:shadow-lg">
                          <div className="flex items-start space-x-3">
                            <div className="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center flex-shrink-0">
                              <span className="text-2xl">{info.icon}</span>
                            </div>
                            <div className="flex-1 min-w-5">
                              <div className="mb-2">
                                <h5 className="font-bold text-gray-800 text-sm leading-tight mb-1">{firmware.device}</h5>
                                <div className="flex flex-wrap items-center gap-1 mb-2">
                                  <Badge variant="outline" className="bg-blue-100 text-blue-800 border-blue-300 text-sm px-2 py-0.5">
                                    {firmware.manufacturer}
                                  </Badge>
                                  <Badge variant="outline" className="bg-green-100 text-green-800 border-green-300 text-sm px-2 py-0.5">
                                    v{firmware.latestVersion}
                                  </Badge>
                                  {firmware.fileSize && (
                                    <Badge variant="outline" className="bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600 border-amber-300/60 text-sm px-2 py-0.5">
                                      {firmware.fileSize}
                                    </Badge>
                                  )}
                                </div>
                              </div>
                              
                              <div className="text-sm text-gray-600 mb-3 space-y-1">
                                <div className="flex items-center gap-2">
                                  <span className="font-mono bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg px-2 py-0.5 rounded-xl text-sm">{firmware.currentVersion}</span>
                                  <span>→</span>
                                  <span className="font-mono bg-blue-100 px-2 py-0.5 rounded-xl text-blue-800 text-sm">{firmware.latestVersion}</span>
                                </div>
                                <div>Utgitt: {firmware.releaseDate}</div>
                              </div>
                              
                              <p className="text-sm text-gray-700 mb-3 line-clamp-2">{firmware.features}</p>
                              
                              <div className="flex flex-col gap-2">
                                <Button
                                  size="sm"
                                  onClick={() => window.open(firmware.downloadUrl, '_blank')}
                                  className="bg-green-600 hover:bg-green-700 text-gray-800 dark:text-white w-full text-sm py-1.5"
                                >
                                  <Download className="h-5 w-5 mr-1" />
                                  Last ned firmware
                                </Button>
                                <div className="flex gap-1">
                                  <Button
                                    variant="outline"
                                    size="sm"
                                    onClick={() => {
                                      setSelectedFirmware(firmware);
                                      setShowChangelogViewer(true);
                                    }}
                                    className="text-blue-600 hover:text-blue-700 hover:bg-blue-50 flex-1 text-sm py-1.5"
                                  >
                                    <FileText className="h-5 w-5 mr-1" />
                                    Detaljer
                                  </Button>
                                  <Button
                                    size="sm"
                                    onClick={() => updateFirmware(firmware.id)}
                                    className="bg-orange-600 hover:bg-orange-700 text-gray-800 dark:text-white flex-1 text-sm py-1.5"
                                  >
                                    <RefreshCw className="h-5 w-5 mr-1" />
                                    Installer
                                  </Button>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>

            {/* Legacy Equipment Updates */}
            <div className="space-y-4">
              {(equipmentList || []).filter(item => item.category === "kamera" || item.category === "objektiv").map((item) => (
                <div key={item.id} className="p-4 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border rounded-lg hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg transition-colors">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center space-x-4">
                      <div className="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                        <span className="text-2xl">{item.category === "kamera" ? "📷" : "🔍"}</span>
                      </div>
                      <div>
                        <div className="flex items-center space-x-2">
                          <h3 className="font-semibold">{item.name}</h3>
                          <Badge variant="outline" className="bg-orange-100 text-orange-800 border-orange-300">
                            Oppdatering tilgjengelig
                          </Badge>
                        </div>
                        <p className="text-sm text-gray-600">
                          Nåværende versjon: 1.2.0 → Ny versjon: 1.3.0
                        </p>
                        <p className="text-sm text-blue-600">
                          Estimert oppdateringstid: 5-8 minutter
                        </p>
                      </div>
                    </div>
                    <div className="flex space-x-2">
                      <Button
                        variant="outline"
                        size="sm"
                        onClick={() => {
                          const firmwareData = {
                            device: item.name,
                            currentVersion: "1.2.0",
                            latestVersion: "1.3.0",
                            releaseDate: "2025-01-07",
                            updateTime: 7
                          };
                          setSelectedFirmware(firmwareData);
                          setShowChangelogViewer(true);
                        }}
                        className="text-blue-600 hover:text-blue-700 hover:bg-blue-50 border-blue-200 hover:border-blue-300"
                      >
                        <FileText className="h-5 w-5 mr-1" />
                        Se detaljer
                      </Button>
                      <Button
                        size="sm"
                        onClick={() => {
                          // Mock firmware update process
                          const updatedItem = {
                            ...item,
                            currentVersion: "1.3.0",
                            updatedDate: new Date().toLocaleDateString('nb-NO'),
                            updatedTime: new Date().toLocaleTimeString('nb-NO', { hour: '2-digit', minute: '2-digit' })
                          };
                          setUpdatedEquipment(prev => [...prev, updatedItem]);
                          toast({
                            title: "Firmware oppdatering fullført!",
                            description: `${item.name} er oppdatert til versjon 1.3.0`,
                            duration: 3000,
                          });
                        }}
                        className="bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white"
                      >
                        <Download className="h-5 w-5 mr-1" />
                        Oppdater
                      </Button>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            {/* Firmware Notification Settings */}
            <div className="mt-6 p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg border-blue-200">
              <div className="flex items-center justify-between">
                <div>
                  <h5 className="font-semibold text-blue-900 flex items-center">
                    <Bell className="h-5 w-5 mr-2" />
                    Automatiske firmware-varsler
                  </h5>
                  <p className="text-sm text-blue-700 mt-1">
                    Få e-postvarsler når nye firmware-oppdateringer blir tilgjengelige for ditt utstyr
                  </p>
                  <div className="text-sm text-blue-600 mt-2">
                    Sist sjekket: {new Date(lastFirmwareCheck).toLocaleDateString('nb-NO')} • 
                    {firmwareNotifications ? ' Varsler aktivert' : ' Varsler deaktivert'}
                  </div>
                </div>
                <Button
                  variant={firmwareNotifications ? "default" : "outline"}
                  size="sm"
                  onClick={() => toggleFirmwareNotifications()}
                  className={firmwareNotifications 
                    ? "bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white" 
                    : "text-blue-600 hover:text-blue-700 hover:bg-blue-100 border-blue-300"
                  }
                >
                  <Bell className="h-5 w-5 mr-1" />
                  {firmwareNotifications ? '✓ Aktivert' : 'Aktiver varsler'}
                </Button>
              </div>
            </div>

            {/* Updated Equipment Display */}
            {updatedEquipment.length > 0 && (
              <div className="mt-6">
                <h4 className="font-semibold text-green-800 mb-4 flex items-center">
                  <CheckCircle className="h-5 w-5 mr-2" />
                  Nylig oppdatert utstyr ({updatedEquipment.length})
                </h4>
                <div className="space-y-3">
                  {updatedEquipment.map((item) => (
                    <div key={item.id} className="p-3 bg-green-50 border-green-200 rounded-lg">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center space-x-3">
                          <CheckCircle className="h-6 w-6 text-green-600" />
                          <div>
                            <h5 className="font-medium text-green-900">{item.device || item.name}</h5>
                            <p className="text-sm text-green-700">
                              Oppdatert til versjon {item.currentVersion} • {item.updatedDate} kl. {item.updatedTime}
                            </p>
                          </div>
                        </div>
                        <Badge className="bg-green-100 text-green-800">✓ Fullført</Badge>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </TabsContent>
        </Tabs>
      </div>
    );
  };
  
  const [projectName, setProjectName] = useState("");
  const [projectDate, setProjectDate] = useState("");
  const [projectBudget, setProjectBudget] = useState("");
  const [projectDescription, setProjectDescription] = useState("");
  
  // Client form state
  const [clientName, setClientName] = useState("");
  const [clientEmail, setClientEmail] = useState("");
  const [clientPhone, setClientPhone] = useState("");
  const [clientCompany, setClientCompany] = useState("");
  const [isAddingClient, setIsAddingClient] = useState(false);
  
  const [galleries, setGalleries] = useState([]);
  const [invoices, setInvoices] = useState([]);

  // Mock user object (no authentication required)
  const user = { 
    firstName: 'Daniel',
    lastName: 'Qazi'
  };

  // Remove placeholder stats - using database stats from businessStats useQuery above

  // AI-powered camera search
  const searchCameras = async (searchQuery) => {
    if (!searchQuery || searchQuery.length < 2) {
      setCameraSearchResults([]);
      setAiSuggestions([]);
      return;
    }

    setIsSearching(true);
    try {
      const response = await fetch('/api/search-cameras', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: searchQuery })
      });
      
      const data = await response.json();
      setCameraSearchResults(data.cameras || []);
      setAiSuggestions(data.suggestions || []);
    } catch (error) {
      console.error('Camera search error:', error);
      setCameraSearchResults([]);
      setAiSuggestions([]);
    } finally {
      setIsSearching(false);
    }
  };

  // AI-powered lens search
  const searchLenses = async (searchQuery) => {
    if (!searchQuery || searchQuery.length < 2) {
      setLensSearchResults([]);
      setLensAiSuggestions([]);
      return;
    }

    setIsSearchingLens(true);
    try {
      const response = await fetch('/api/search-lenses', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: searchQuery })
      });
      
      const data = await response.json();
      setLensSearchResults(data.lenses || []);
      setLensAiSuggestions(data.suggestions || []);
    } catch (error) {
      console.error('Lens search error:', error);
      setLensSearchResults([]);
      setLensAiSuggestions([]);
    } finally {
      setIsSearchingLens(false);
    }
  };

  // Equipment categories and types
  const equipmentCategories = {
    kamera: {
      name: "Kamera",
      icon: "📷",
      lucideIcon: <CameraIcon className="h-5 w-5" />,
      types: ["Speilløs", "DSLR", "Medium format", "Film"]
    },
    objektiv: {
      name: "Objektiv", 
      icon: "🔍",
      lucideIcon: <Target className="h-5 w-5" />,
      types: ["Standard zoom", "Telezoom", "Vidvinkel", "Makro", "Prime", "Tilt-shift"]
    },
    lys: {
      name: "Lys & Blitz",
      icon: "💡",
      lucideIcon: <Zap className="h-5 w-5" />,
      types: ["Blitz", "LED-panel", "Kontinuerlig lys", "Ring light", "Softbox", "Reflektor"]
    },
    tilbehor: {
      name: "Tilbehør",
      icon: "🎒",
      lucideIcon: <Package className="h-5 w-5" />,
      types: ["Stativ", "Gimbal", "Filter", "Minnekort", "Batteri", "Bag/Case", "Remote"]
    },
    audio: {
      name: "Audio",
      icon: "🎤",
      lucideIcon: <Mic2 className="h-5 w-5" />,
      types: ["Mikrofon", "Recorder", "Mixer", "Monitor", "Wireless system"]
    }
  };

  // Calculate total equipment value
  const getTotalEquipmentValue = () => {
    return (equipmentList || []).reduce((total, item) => {
      return total + (item.price || 0);
    }, 0);
  };

  // Get equipment count by category
  const getEquipmentByCategory = () => {
    const categoryStats = {};
    Object.keys(equipmentCategories).forEach(key => {
      const items = (equipmentList || []).filter(item => item.category === key);
      categoryStats[key] = {
        count: items.length,
        value: items.reduce((sum, item) => sum + (item.price || 0), 0)
      };
    });
    return categoryStats;
  };

  // Rental comparison functionality
  const searchRentalPrices = async (equipmentName) => {
    try {
      const response = await fetch('/api/rental-comparison', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ equipment: equipmentName })
      });
      
      const data = await response.json();
      setRentalData(data.rentals || []);
    } catch (error) {
      console.error('Rental search error:', error);
      setRentalData([]);
    }
  };

  // Calculate buy vs rent recommendation
  const calculateRentalRecommendation = (buyPrice, dailyRental, usageDaysPerYear = 30) => {
    const yearlyRentalCost = dailyRental * usageDaysPerYear;
    const breakEvenPoint = Math.round(buyPrice / dailyRental);
    
    return {
      yearlyRentalCost,
      breakEvenPoint,
      recommendation: breakEvenPoint <= usageDaysPerYear ? 'buy' : 'rent',
      savings: breakEvenPoint <= usageDaysPerYear 
        ? yearlyRentalCost - (buyPrice / 3) // 3-year depreciation
        : buyPrice - (yearlyRentalCost * 3)
    };
  };

  // Actionable functions
  const addEquipment = () => {
    if (selectedCamera && selectedLens) {
      const newEquipment = {
        id: Date.now(),
        camera: selectedCamera,
        lens: selectedLens,
        added: new Date().toISOString().split('T')[0],
        cameraPrice: selectedCameraPrice || 0,
        lensPrice: selectedLensPrice || 0
      };
      setEquipmentList([...(equipmentList || []), newEquipment]);
      
      // Reset all states
      setSelectedCamera("");
      setSelectedLens("");
      setCameraSearch("");
      setCameraSearchResults([]);
      setAiSuggestions([]);
      setLensSearch("");
      setLensSearchResults([]);
      setLensAiSuggestions([]);
      setSelectedCameraPrice(0);
      setSelectedLensPrice(0);
      
      const totalCost = (selectedCameraPrice || 0) + (selectedLensPrice || 0);
      toast({
        title: "Utstyr lagt til!",
        description: `${selectedCamera} med ${selectedLens} - Kostnad: ${(totalCost || 0).toLocaleString('nb-NO')} kr`,
        duration: 3000,
      });
    } else {
      toast({
        title: "Velg utstyr",
        description: "Velg både kamera og objektiv først",
        variant: "destructive",
      });
    }
  };

  const removeEquipment = (equipmentId) => {
    const equipment = (equipmentList || []).find(item => item.id === equipmentId);
    if (!equipment) return;
    
    setEquipmentToRemove(equipment);
    setShowRemoveDialog(true);
  };

  const confirmRemoveEquipment = () => {
    if (!equipmentToRemove) return;

    // Remove from equipment list
    setEquipmentList((equipmentList || []).filter(item => item.id !== equipmentToRemove.id));
    
    // Remove from firmware updates list
    setFirmwareUpdates(firmwareUpdates.filter(item => item.id !== equipmentToRemove.id));
    
    // Remove from updated equipment list
    setUpdatedEquipment(updatedEquipment.filter(item => item.id !== equipmentToRemove.id));
    
    setShowRemoveDialog(false);
    setEquipmentToRemove(null);
  };

  // Real Actionable Gamification Functions
  const addMaintenanceAction = (actionType) => {
    const newStreakData = { ...streakData };
    let xpGain = 25;
    let actionDescription = "Vedlikehold registrert";
    
    // Different XP rewards based on action type
    switch (actionType) {
      case 'equipment_update':
        xpGain = 50;
        actionDescription = "Utstyr oppdatert";
        break;
      case 'client_project':
        xpGain = 100;
        actionDescription = "Prosjekt fullført";
        break;
      case 'invoice_sent':
        xpGain = 75;
        actionDescription = "Faktura sendt";
        break;
      case 'photo_delivery':
        xpGain = 60;
        actionDescription = "Bilder levert";
        break;
      default:
        xpGain = 25;
        actionDescription = "Vedlikehold registrert";
    }
    
    newStreakData.totalMaintenanceActions += 1;
    newStreakData.thisWeekActions += 1;
    newStreakData.currentStreak += 1;
    newStreakData.xp += xpGain;
    
    // Check for level up
    if (newStreakData.xp >= newStreakData.xpToNextLevel) {
      newStreakData.level += 1;
      newStreakData.xp = newStreakData.xp - newStreakData.xpToNextLevel;
      newStreakData.xpToNextLevel += 200;
      
      toast({
        title: "Nivå opp! 🎉",
        description: `Du har nådd nivå ${newStreakData.level}! Fortsett det gode arbeidet.`,
      });
    }
    
    // Update longest streak
    if (newStreakData.currentStreak > newStreakData.longestStreak) {
      newStreakData.longestStreak = newStreakData.currentStreak;
    }
    
    setStreakData(newStreakData);
    checkForNewAchievements(newStreakData);
    
    toast({
      title: `${actionDescription}! ⚡`,
      description: `+${xpGain} XP | Streak: ${newStreakData.currentStreak} dager`,
    });
  };

  // Real business action integrations with tab navigation
  const handleBusinessAction = (actionType, additionalData = {}) => {
    switch (actionType) {
      case 'complete_project':
        addMaintenanceAction('client_project');
        // Switch to projects tab for real integration
        setActiveTab('projects');
        toast({
          title: "Navigerer til Prosjekter 📸",
          description: "Fullfør et prosjekt for å opptjene 100 XP",
        });
        break;
      case 'send_invoice':
        addMaintenanceAction('invoice_sent');
        // Switch to invoices tab for real integration
        setActiveTab('invoices');
        toast({
          title: "Navigerer til Fakturaer 💰",
          description: "Send en faktura for å opptjene 75 XP",
        });
        break;
      case 'deliver_photos':
        addMaintenanceAction('photo_delivery');
        // Switch to delivery tab for real integration
        setActiveTab('delivery');
        toast({
          title: "Navigerer til Leveranse 📷",
          description: "Lever bilder for å opptjene 60 XP",
        });
        break;
      case 'update_equipment':
        addMaintenanceAction('equipment_update');
        // Switch to equipment tab for real integration
        setActiveTab('equipment');
        toast({
          title: "Navigerer til Utstyr ⚙️",
          description: "Oppdater utstyr for å opptjene 50 XP",
        });
        break;
      default:
        addMaintenanceAction('daily_check');
    }
  };

  const checkForNewAchievements = (currentStreakData) => {
    const updatedAchievements = [...achievements];
    let newUnlocks = [];

    updatedAchievements.forEach(achievement => {
      if (!achievement.unlocked) {
        let shouldUnlock = false;
        
        switch (achievement.id) {
          case 'month_master':
            if (currentStreakData.currentStreak >= 30) shouldUnlock = true;
            achievement.progress = currentStreakData.currentStreak;
            break;
          case 'perfectionist':
            const updatedCount = updatedEquipment.length;
            if (updatedCount >= 12) shouldUnlock = true;
            achievement.progress = updatedCount;
            break;
          case 'centurion':
            if (currentStreakData.totalMaintenanceActions >= 100) shouldUnlock = true;
            achievement.progress = currentStreakData.totalMaintenanceActions;
            break;
        }
        
        if (shouldUnlock) {
          achievement.unlocked = true;
          achievement.unlockedDate = new Date().toISOString().split('T')[0];
          newUnlocks.push(achievement);
        }
      }
    });

    if (newUnlocks.length > 0) {
      setAchievements(updatedAchievements);
      newUnlocks.forEach(achievement => {
        toast({
          title: `Prestasjon låst opp! ${achievement.icon}`,
          description: `${achievement.name}: ${achievement.description}`,
        });
      });
    }
  };

  // Enhanced firmware management functions
  const generateFirmwareData = (equipment) => {
    const firmwareDatabase = {
      // =================== CAMERA FIRMWARE - ALL MANUFACTURERS ===================
      
