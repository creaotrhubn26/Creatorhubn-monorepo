                        <div>• Siste oppdatering: {updatedEquipment.length > 0 ? updatedEquipment[updatedEquipment.length - 1]?.updatedDate : 'Ingen'}</div>
                        <div>• Firmware automatisk backup: Aktivert</div>
                      </div>
                    </div>
                  </div>
                )}
              </CardContent>
