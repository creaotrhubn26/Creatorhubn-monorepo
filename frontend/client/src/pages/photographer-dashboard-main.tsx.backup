                          <div className="text-xs text-gray-500">Arbeid uten internettforbindelse</div>
                        </div>
                        <button
                          onClick={() => setSettings(prev => ({ ...prev, offlineMode: !prev.offlineMode }))}
                          className={`w-10 h-6 rounded-full flex items-center px-1 transition-colors ${
                            settings.offlineMode ? 'bg-green-500 justify-end' : 'bg-gray-300 justify-start'
                          }`}
                        >
                          <div className="w-4 h-4 bg-white rounded-full"></div>
                        </button>
                      </div>
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-sm font-medium text-gray-700">Varsler</div>
