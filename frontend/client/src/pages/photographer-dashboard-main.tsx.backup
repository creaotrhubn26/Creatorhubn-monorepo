                        </div>
                        <button
                          onClick={() => setSettings(prev => ({ ...prev, realTimeUpdates: !prev.realTimeUpdates }))}
                          className={`w-10 h-6 rounded-full flex items-center px-1 transition-colors ${
                            settings.realTimeUpdates ? 'bg-green-500 justify-end' : 'bg-gray-300 justify-start'
                          }`}
                        >
                          <div className="w-4 h-4 bg-white rounded-full"></div>
                        </button>
