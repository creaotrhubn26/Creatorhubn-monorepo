              <TabsContent value="kvittering" className="space-y-6 mt-6">
                {/* Receipt Management Section */}
            <div className="bg-gradient-to-br from-purple-50 via-indigo-50 to-blue-50 rounded-xl border-purple-200 shadow-sm overflow-hidden">
              <div className="p-6">
                <div className="flex items-center justify-between mb-4">
                  <div className="flex items-center space-x-3">
                    <div className="p-2 bg-purple-100 rounded-lg">
                      <Receipt className="h-6 w-6 text-purple-600" />
                    </div>
                    <div>
                      <h3 className="text-xl font-semibold text-purple-900">Kvittering & Garanti</h3>
                      <p className="text-sm text-purple-700">OCR-basert kvitteringsgjenkjenning • Norsk garantiinformasjon</p>
                    </div>
                  </div>
                  <div className="text-sm text-purple-600 bg-purple-100 px-2 py-1 rounded-full">
                    {receipts.length} kvitteringer
                  </div>
                </div>

                {/* Upload Receipt Section */}
                <div className="mb-6 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-lg p-4 border-purple-100">
                  <div className="flex items-center space-x-2 mb-3">
                    <Upload className="h-5 w-5 text-purple-600" />
                    <h4 className="font-medium text-purple-900">Last opp kvittering</h4>
                  </div>
                  <div className="border-2 border-dashed border-purple-300 rounded-lg p-6 text-center">
                    <ScanLine className="h-12 w-12 mx-auto text-purple-400 mb-3" />
                    <p className="text-purple-700 mb-2">
                      <span className="font-medium">Dra og slipp kvittering her</span> eller klikk for å velge fil
                    </p>
                    <p className="text-sm text-purple-600 mb-4">
                      OCR gjenkjenner automatisk: utstyr, pris, butikk, og kjøpsdato
                    </p>
                    <input
                      type="file"
                      accept="image/*,.pdf"
                      onChange={handleReceiptUpload}
                      disabled={uploadingReceipt}
                      className="hidden"
                      id="receipt-upload"
                    />
                    <label
                      htmlFor="receipt-upload"
                      className="inline-flex items-center space-x-2 px-4 py-3 bg-purple-600 text-gray-800 dark:text-white rounded-lg hover:bg-purple-700 disabled:opacity-50 cursor-pointer transition-colors"
                    >
                      {uploadingReceipt ? (
                        <>
                          <RefreshCw className="h-5 w-5 animate-spin" />
                          <span>Behandler OCR...</span>
                        </>
                      ) : (
                        <>
                          <Upload className="h-5 w-5" />
                          <span>Velg kvittering</span>
                        </>
                      )}
                    </label>
                  </div>
                  <div className="mt-3 text-sm text-purple-600">
                    Støtter: JPG, PNG, PDF • OCR gjenkjenner norske kvitteringer fra Foto Video AS, Kamerahuset, Scandinavian Photo, foto.no
                  </div>
                </div>

                {/* Receipt List */}
                <div className="space-y-3">
                  <div className="flex items-center justify-between">
                    <h4 className="font-medium text-purple-900">Kvitteringshistorikk</h4>
                    <Badge variant="outline" className="border-purple-200 text-purple-700">
                      {receipts.length} dokumenter
                    </Badge>
                  </div>
                  
                  {receipts.map((receipt) => (
                    <div key={receipt.id} className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-lg p-4 border-purple-100">
                      <div className="flex items-start justify-between">
                        <div className="flex items-start space-x-3">
                          <div className="p-2 bg-purple-100 rounded-lg">
                            <Receipt className="h-5 w-5 text-purple-600" />
                          </div>
                          <div className="flex-1">
                            <div className="flex items-center space-x-2 mb-1">
                              <h5 className="font-medium text-purple-900">{receipt.equipmentName}</h5>
                              <Badge 
                                variant={receipt.ocrStatus === 'completed' ? 'default' : 'secondary'}
                                className="text-sm"
                              >
                                {receipt.ocrStatus === 'completed' ? 'OCR fullført' : 'Behandler'}
                              </Badge>
                            </div>
                            <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                              <div>
                                <span className="text-purple-600 font-medium">Butikk:</span>
                                <div className="text-purple-800">{receipt.store}</div>
                              </div>
                              <div>
                                <span className="text-purple-600 font-medium">Pris:</span>
                                <div className="text-purple-800 font-semibold">{(receipt.price || 0).toLocaleString('nb-NO')} kr</div>
                              </div>
                              <div>
                                <span className="text-purple-600 font-medium">Kjøpsdato:</span>
                                <div className="text-purple-800">{receipt.purchaseDate}</div>
                              </div>
                              <div>
                                <span className="text-purple-600 font-medium">Garanti:</span>
                                <div className="text-purple-800">{receipt.warrantyPeriod}</div>
                              </div>
                            </div>
                            <div className="mt-2 p-2 bg-green-50 rounded-lg border-green-200">
                              <div className="flex items-center space-x-2 mb-1">
                                <ShieldCheck className="h-5 w-5 text-green-600" />
                                <span className="text-sm font-medium text-green-800">Norsk garanti: {receipt.norwegianWarranty.type}</span>
                              </div>
                              <div className="text-sm text-green-700">
                                {receipt.norwegianWarranty.coverage} • {receipt.norwegianWarranty.additionalInfo}
                              </div>
                            </div>
                          </div>
                        </div>
                        <div className="flex items-center space-x-2">
                          <Button
                            variant="outline"
                            size="sm"
                            onClick={() => {
                              setSelectedReceipt(receipt);
                              setShowReceiptViewer(true);
                            }}
                            className="border-purple-200 text-purple-700 hover:bg-purple-50"
                          >
                            <Eye className="h-5 w-5 mr-1" />
                            Se detaljer
                          </Button>
                        </div>
                      </div>
                    </div>
                  ))}
                  
                  {receipts.length === 0 && (
                    <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-lg p-8 border-purple-100 text-center">
                      <Receipt className="h-12 w-12 mx-auto text-purple-300 mb-3" />
                      <h4 className="font-medium text-purple-700 mb-2">Ingen kvitteringer enda</h4>
                      <p className="text-sm text-purple-600">
                        Last opp kvitteringer for automatisk OCR-gjenkjenning og garantisporing
                      </p>
                    </div>
                  )}
                </div>
              </div>
