      // BLACKMAGIC ACCESSORIES
      "Blackmagic Video Assist 12G": { current: "3.3", latest: "3.4", features: "Recording codec updates, monitoring improvements", releaseDate: "2025-01-14" },
      "Blackmagic HyperDeck Shuttle HD": { current: "2.1", latest: "2.2", features: "SSD compatibility improvements, playback stability", releaseDate: "2025-01-16" },
