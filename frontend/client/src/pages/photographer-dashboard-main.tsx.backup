          {/* Main Tab Categories - Premium Apple Liquid Glass Design - Responsive */}
          <div className="relative flex flex-col lg:flex-row justify-center w-full bg-gradient-to-r from-white/90 via-white/95 to-white/90 backdrop-blur-2xl border-white/40 shadow-[0_8px_32px_rgba(0,0,0,0.12)] rounded-3xl mb-6 lg:mb-10 p-4 lg:p-6 gap-3 lg:gap-6 before:absolute before:inset-0 before:rounded-3xl before:bg-gradient-to-r before:from-orange-100/20 before:via-transparent before:to-blue-100/20 before:pointer-events-none">



