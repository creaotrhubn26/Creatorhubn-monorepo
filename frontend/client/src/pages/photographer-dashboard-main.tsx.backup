              <TabsTrigger value="workflow" className="text-pink-700 data-[state=active]:bg-gradient-to-br data-[state=active]:from-pink-200/60 data-[state=active]:via-pink-100/80 data-[state=active]:to-pink-50/60 data-[state=active]:text-pink-900 data-[state=active]:shadow-[0_3px_12px_rgba(236,72,153,0.25)] data-[state=active]:border-pink-300/70 data-[state=active]:ring-1 data-[state=active]:ring-pink-200/50 font-medium transition-colors duration-300 px-4 lg:px-6 py-3 lg:py-3 text-sm lg:text-base rounded-xl border-transparent hover:bg-pink-50/70 hover:shadow-[0_2px_8px_rgba(236,72,153,0.1)] backdrop-blur-lg">
                <span className="flex items-center gap-1 lg:gap-2">
                  <Sparkles className="w-3 h-3 lg:w-4 lg:h-4 text-pink-600" />
                  <span className="font-semibold">Arbeidsflyt</span>
                </span>
              </TabsTrigger>
              <TabsTrigger value="assets" className="text-pink-700 data-[state=active]:bg-gradient-to-br data-[state=active]:from-pink-200/60 data-[state=active]:via-pink-100/80 data-[state=active]:to-pink-50/60 data-[state=active]:text-pink-900 data-[state=active]:shadow-[0_3px_12px_rgba(236,72,153,0.25)] data-[state=active]:border-pink-300/70 data-[state=active]:ring-1 data-[state=active]:ring-pink-200/50 font-medium transition-colors duration-300 px-4 lg:px-6 py-3 lg:py-3 text-sm lg:text-base rounded-xl border-transparent hover:bg-pink-50/70 hover:shadow-[0_2px_8px_rgba(236,72,153,0.1)] backdrop-blur-lg">
                <span className="flex items-center gap-1 lg:gap-2">
                  <Image className="w-3 h-3 lg:w-4 lg:h-4 text-pink-600" />
                  <span className="font-semibold">Assets</span>
                </span>
              </TabsTrigger>
              <TabsTrigger value="quality" className="text-pink-700 data-[state=active]:bg-gradient-to-br data-[state=active]:from-pink-200/60 data-[state=active]:via-pink-100/80 data-[state=active]:to-pink-50/60 data-[state=active]:text-pink-900 data-[state=active]:shadow-[0_3px_12px_rgba(236,72,153,0.25)] data-[state=active]:border-pink-300/70 data-[state=active]:ring-1 data-[state=active]:ring-pink-200/50 font-medium transition-colors duration-300 px-4 lg:px-6 py-3 lg:py-3 text-sm lg:text-base rounded-xl border-transparent hover:bg-pink-50/70 hover:shadow-[0_2px_8px_rgba(236,72,153,0.1)] backdrop-blur-lg">
                <span className="flex items-center gap-1 lg:gap-2">
                  <CheckCircle className="w-3 h-3 lg:w-4 lg:h-4 text-pink-600" />
