                          <div className="text-xs text-gray-500">Synkroniser data hvert {settings.refreshInterval} sekund</div>
                        </div>
                        <button
                          onClick={() => setSettings(prev => ({ ...prev, autoSync: !prev.autoSync }))}
                          className={`w-10 h-6 rounded-full flex items-center px-1 transition-colors ${
                            settings.autoSync ? 'bg-green-500 justify-end' : 'bg-gray-300 justify-start'
                          }`}
