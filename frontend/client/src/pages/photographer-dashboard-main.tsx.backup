            <Card className="p-4">
              <div className="flex items-center justify-between">
                <div>
                  <h4 className="font-semibold">Sony A7R V</h4>
                  <p className="text-sm text-gray-600">Foto Video</p>
                </div>
                <div className="text-right">
                  <div className="text-lg font-bold">47 990 kr</div>
                  <div className="text-sm text-red-600">+1% denne uken</div>
                </div>
              </div>
            </Card>
          </div>
          <Button variant="outline" className="w-full" onClick={() => {
            toast({
              title: "Prissporing",
              description: "Åpner detaljert prissammenligning",
              duration: 2000,
            });
            setActiveTab("equipment");
          }}>
            <ShoppingCart className="h-5 w-5 mr-2" />
            Se alle priser
          </Button>
        </div>
      )}
    </div>
  );

  const PhotoDelivery = () => (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {galleries.map(gallery => (
          <Card key={gallery.id} className="p-4">
            <div className="flex items-center justify-between">
              <div>
                <h4 className="font-semibold">{gallery.client}</h4>
                <p className="text-sm text-gray-600">{gallery.type} - {gallery.photos} bilder</p>
              </div>
              <Badge className="bg-white border rounded-lg p-4">
                {gallery.status}
              </Badge>
            </div>
          </Card>
        ))}
      </div>
      <Button className="w-full" onClick={createGallery}>
        <Upload className="h-5 w-5 mr-2" />
        Opprett nytt galleri
      </Button>
    </div>
  );

  const ProjectPlanner = () => {
    const [plannerActiveTab, setPlannerActiveTab] = useState("submissions");
    
    return (
      <div className="space-y-6">
        <Tabs value={plannerActiveTab} onValueChange={setPlannerActiveTab} className="w-full">
          <TabsList className="grid w-full grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 bg-amber-500/10 backdrop-blur-xl border-amber-500/20 rounded-3xl shadow-2xl p-2 lg:p-3 gap-1 lg:gap-2">
            <TabsTrigger 
              value="submissions" 
              className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm rounded-3xl transition-colors duration-500 hover:bg-amber-500/20 data-[state=active]:bg-amber-500/30 data-[state=active]:backdrop-blur-xl data-[state=active]:shadow-lg data-[state=active]:text-amber-900"
            >
              <MessageSquare className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Kundehenvendelser</span>
              <span className="sm:hidden">Kunder</span>
            </TabsTrigger>
            <TabsTrigger 
              value="embeddable-forms" 
              className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm rounded-3xl transition-colors duration-500 hover:bg-amber-500/20 data-[state=active]:bg-amber-500/30 data-[state=active]:backdrop-blur-xl data-[state=active]:shadow-lg data-[state=active]:text-amber-900"
            >
              <Share2 className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Innebygde skjemaer</span>
              <span className="sm:hidden">Skjema</span>
            </TabsTrigger>
            <TabsTrigger 
              value="manual" 
              className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm rounded-3xl transition-colors duration-500 hover:bg-amber-500/20 data-[state=active]:bg-amber-500/30 data-[state=active]:backdrop-blur-xl data-[state=active]:shadow-lg data-[state=active]:text-amber-900"
            >
              <Plus className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Manuell opprettelse</span>
              <span className="sm:hidden">Manuell</span>
            </TabsTrigger>
          </TabsList>
          
          <TabsContent value="submissions" className="space-y-4 mt-6">
            <CustomerSubmissionManager />
          </TabsContent>
          
          <TabsContent value="embeddable-forms" className="space-y-4 mt-6">
            <EmbeddableFormManager />
          </TabsContent>
          
          <TabsContent value="manual" className="space-y-6 mt-6">
            <div className="bg-amber-500/10 backdrop-blur-xl rounded-3xl p-6 border-amber-500/20 shadow-2xl hover:shadow-3xl hover:bg-amber-500/15 transition-colors duration-500">
              <div className="space-y-4">
                <div className="space-y-2">
                  <label className="text-sm font-medium text-amber-900/80">Prosjektnavn</label>
                  <Input 
                    placeholder="F.eks. Bryllup i Stavanger Domkirke" 
                    value={projectName}
                    onChange={(e) => setProjectName(e.target.value)}
                    className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300"
                  />
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="space-y-2">
                    <label className="text-sm font-medium text-amber-900/80">Dato</label>
                    <Input 
                      type="date" 
                      value={projectDate}
                      onChange={(e) => setProjectDate(e.target.value)}
                      className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300"
                    />
                  </div>
                  <div className="space-y-2">
                    <label className="text-sm font-medium text-amber-900/80">Budsjett</label>
                    <Input 
                      placeholder="35 000 kr" 
                      value={projectBudget}
                      onChange={(e) => setProjectBudget(e.target.value)}
                      className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300"
                    />
                  </div>
                </div>
                <div className="space-y-2">
                  <label className="text-sm font-medium text-amber-900/80">Beskrivelse</label>
                  <Textarea 
                    placeholder="Detaljer om fotograferingen..." 
                    value={projectDescription}
                    onChange={(e) => setProjectDescription(e.target.value)}
                    className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300 min-h-[100px]"
                  />
                </div>
                <Button 
                  className="w-full bg-gradient-to-r from-amber-500/80 to-orange-500/80 hover:from-amber-600/90 hover:to-orange-600/90 backdrop-blur-xl rounded-xl border-amber-500/30 shadow-lg hover:shadow-xl hover:shadow-amber-500/20 transition-colors duration-500 transform hover:scale-[1.02] text-gray-800 dark:text-white font-medium" 
                  onClick={createProject}
                  disabled={createProjectMutation.isPending}
                >
                  <Briefcase className="h-5 w-5 mr-2" />
                  {createProjectMutation.isPending ? 'Oppretter...' : 'Opprett prosjekt'}
                </Button>
              </div>
            </div>
            
            {/* Current Projects */}
            {projects.length > 0 && (
              <div className="bg-amber-500/10 backdrop-blur-xl rounded-3xl p-6 border-amber-500/20 shadow-2xl">
                <div className="flex items-center space-x-2 mb-4">
                  <FolderOpen className="h-5 w-5 text-amber-600" />
                  <h4 className="font-medium text-amber-900/80">Mine prosjekter ({projects.length})</h4>
                </div>
                <div className="space-y-3">
                  {projects.map(project => (
                    <div key={project.id} className="bg-amber-500/20 backdrop-blur-lg rounded-xl p-4 border-amber-500/30 shadow-lg hover:shadow-xl hover:shadow-amber-500/10 transition-colors duration-300 hover:bg-amber-500/30 hover:scale-[1.01]">
                      <div className="flex items-center justify-between">
                        <div className="flex-1">
                          <div className="flex items-center space-x-2 mb-1">
                            <Camera className="h-4 w-4 text-amber-600/80" />
                            <div className="font-medium text-amber-900/90">{project.title}</div>
                          </div>
                          <div className="text-sm text-amber-800/80 mb-1">{project.description}</div>
                          <div className="flex items-center space-x-4 text-sm text-amber-700/80">
                            <div className="flex items-center space-x-1">
                              <Calendar className="h-3 w-3" />
                              <span>{project.date}</span>
                            </div>
                            <div className="flex items-center space-x-1">
                              <Banknote className="h-3 w-3" />
                              <span>{(project.budget || 0).toLocaleString('nb-NO')} kr</span>
                            </div>
                          </div>
                        </div>
                        <Badge className="bg-gradient-to-r from-amber-500/20 to-orange-500/20 text-amber-800 border-amber-300/30 backdrop-blur-lg">
                          {project.status === 'planning' ? 'Planlegger' : project.status}
                        </Badge>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </TabsContent>
        </Tabs>
      </div>
    );
  };

  const EmbeddableFormManager = () => {
    const [activeFormTab, setActiveFormTab] = useState("forms");
    const [selectedForm, setSelectedForm] = useState(null);
    const [showCreateDialog, setShowCreateDialog] = useState(false);
    const [showEmbedDialog, setShowEmbedDialog] = useState(false);
    const [formData, setFormData] = useState({
      name: '',
      title: 'Kontakt oss',
      description: '',
      successMessage: 'Takk for din henvendelse! Vi kontakter deg snart.',
      primaryColor: '#f59e0b',
      secondaryColor: '#92400e',
      backgroundColor: '#ffffff',
      textColor: '#1f2937',
      enableBranding: true,
      isActive: true
    });

    // Fetch embeddable forms
    const { data: formsData, isLoading: formsLoading } = useQuery({
      queryKey: ['/api/embeddable-forms'],
      refetchInterval: 30000
    });

    // Create form mutation
    const createFormMutation = useMutation({
      mutationFn: async (data) => {
        const response = await fetch('/api/embeddable-forms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(data)
        });
        
        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.error || 'Failed to create form');
        }
        
        return response.json();
      },
      onSuccess: () => {
        queryClient.invalidateQueries({ queryKey: ['/api/embeddable-forms'] });
        setShowCreateDialog(false);
        setFormData({
          name: '',
          title: 'Kontakt oss',
          description: '',
          successMessage: 'Takk for din henvendelse! Vi kontakter deg snart.',
          primaryColor: '#f59e0b',
          secondaryColor: '#92400e',
          backgroundColor: '#ffffff',
          textColor: '#1f2937',
          enableBranding: true,
          isActive: true
        });
        toast({
          title: "Skjema opprettet!",
          description: "Det innebygde skjemaet er klart til bruk.",
          duration: 5000,
        });
      },
      onError: (error) => {
        toast({
          title: "Feil ved opprettelse",
          description: error.message,
          variant: "destructive",
        });
      }
    });

    // Generate embed code mutation
    const generateEmbedMutation = useMutation({
      mutationFn: async (formId) => {
        const response = await fetch(`/api/embeddable-forms/${formId}/embed-code`, {
          method: 'GET',
          credentials: 'include'
        });
        
        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.error || 'Failed to generate embed code');
        }
        
        return response.json();
      },
      onSuccess: (data) => {
        navigator.clipboard.writeText(data.embedCode);
        toast({
          title: "Embed-kode kopiert!",
          description: "Koden er kopiert til utklippstavlen og klar til å limes inn på din nettside.",
          duration: 5000,
        });
        setShowEmbedDialog(false);
      },
      onError: (error) => {
        toast({
          title: "Feil ved generering",
          description: error.message,
          variant: "destructive",
        });
      }
    });

    // Update form mutation
    const updateFormMutation = useMutation({
      mutationFn: async ({ id, updates }) => {
        const response = await fetch(`/api/embeddable-forms/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(updates)
        });
        
        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.error || 'Failed to update form');
        }
        
        return response.json();
      },
      onSuccess: () => {
        queryClient.invalidateQueries({ queryKey: ['/api/embeddable-forms'] });
        toast({
          title: "Skjema oppdatert!",
          description: "Endringene er lagret.",
          duration: 3000,
        });
      },
      onError: (error) => {
        toast({
          title: "Feil ved oppdatering",
          description: error.message,
          variant: "destructive",
        });
      }
    });

    const forms = formsData?.forms || [];

    if (formsLoading) {
      return (
        <div className="bg-amber-500/10 backdrop-blur-xl rounded-3xl p-6 border-amber-500/20 shadow-2xl">
          <div className="flex items-center space-x-2 mb-4">
            <Share2 className="h-5 w-5 text-amber-600 animate-pulse" />
            <h4 className="font-medium text-amber-900/80">Laster innebygde skjemaer...</h4>
          </div>
          <div className="space-y-3">
            {[1, 2, 3].map(i => (
              <div key={i} className="bg-amber-500/20 backdrop-blur-lg rounded-xl p-4 border-amber-500/30 animate-pulse">
                <div className="h-4 bg-amber-500/30 rounded-xl w-3/4 mb-2"></div>
                <div className="h-3 bg-amber-500/20 rounded-xl w-1/2"></div>
              </div>
            ))}
          </div>
        </div>
      );
    }

    return (
      <div className="space-y-6">
        <Tabs value={activeFormTab} onValueChange={setActiveFormTab} className="w-full">
          <TabsList className="grid w-full grid-cols-2 bg-amber-500/10 backdrop-blur-xl border-amber-500/20 rounded-3xl shadow-2xl p-2 lg:p-3 gap-1 lg:gap-2">
            <TabsTrigger 
              value="forms" 
              className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm rounded-3xl transition-colors duration-500 hover:bg-amber-500/20 data-[state=active]:bg-amber-500/30 data-[state=active]:backdrop-blur-xl data-[state=active]:shadow-lg data-[state=active]:text-amber-900"
            >
              <Share2 className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Mine skjemaer</span>
              <span className="sm:hidden">Skjema</span>
            </TabsTrigger>
            <TabsTrigger 
              value="create" 
              className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm rounded-3xl transition-colors duration-500 hover:bg-amber-500/20 data-[state=active]:bg-amber-500/30 data-[state=active]:backdrop-blur-xl data-[state=active]:shadow-lg data-[state=active]:text-amber-900"
            >
              <Plus className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Nytt skjema</span>
              <span className="sm:hidden">Ny</span>
            </TabsTrigger>
          </TabsList>
          
          <TabsContent value="forms" className="space-y-4 mt-6">
            <div className="bg-amber-500/10 backdrop-blur-xl rounded-3xl p-6 border-amber-500/20 shadow-2xl">
              <div className="flex items-center justify-between mb-4">
                <div className="flex items-center space-x-2">
                  <Share2 className="h-5 w-5 text-amber-600" />
                  <h4 className="font-medium text-amber-900/80">Innebygde skjemaer ({forms.length})</h4>
                </div>
                <Button 
                  onClick={() => setShowCreateDialog(true)}
                  className="bg-gradient-to-r from-amber-500/80 to-orange-500/80 hover:from-amber-600/90 hover:to-orange-600/90 backdrop-blur-xl rounded-xl border-amber-500/30 shadow-lg hover:shadow-xl hover:shadow-amber-500/20 transition-colors duration-500 transform hover:scale-[1.02] text-gray-800 dark:text-white font-medium text-sm px-4 py-3"
                >
                  <Plus className="h-4 w-4 mr-2" />
                  Nytt skjema
                </Button>
              </div>
              
              {forms.length === 0 ? (
                <div className="text-center py-8">
                  <Share2 className="h-12 w-12 text-amber-500/50 mx-auto mb-4" />
                  <h3 className="text-lg font-medium text-amber-900/80 mb-2">Ingen skjemaer ennå</h3>
                  <p className="text-amber-700/60 mb-4">
                    Opprett ditt første innebygde skjema for å begynne å motta henvendelser direkte fra din nettside.
                  </p>
                  <Button 
                    onClick={() => setShowCreateDialog(true)}
                    className="bg-gradient-to-r from-amber-500/80 to-orange-500/80 hover:from-amber-600/90 hover:to-orange-600/90 backdrop-blur-xl rounded-xl border-amber-500/30 shadow-lg hover:shadow-xl hover:shadow-amber-500/20 transition-colors duration-500 transform hover:scale-[1.02] text-gray-800 dark:text-white font-medium"
                  >
                    <Plus className="h-4 w-4 mr-2" />
                    Opprett første skjema
                  </Button>
                </div>
              ) : (
                <div className="space-y-3">
                  {forms.map(form => (
                    <div key={form.id} className="bg-amber-500/20 backdrop-blur-lg rounded-xl p-4 border-amber-500/30 shadow-lg hover:shadow-xl hover:shadow-amber-500/10 transition-colors duration-300 hover:bg-amber-500/30 hover:scale-[1.01]">
                      <div className="flex items-center justify-between">
                        <div className="flex-1">
                          <div className="flex items-center space-x-2 mb-1">
                            <Share2 className="h-4 w-4 text-amber-600/80" />
                            <div className="font-medium text-amber-900/90">{form.name}</div>
                            <Badge className="bg-white border rounded-lg p-4">
                              {form.isActive ? 'Aktiv' : 'Inaktiv'}
                            </Badge>
                          </div>
                          <div className="text-sm text-amber-800/80 mb-1">{form.title}</div>
                          <div className="flex items-center space-x-4 text-sm text-amber-700/80">
                            <div className="flex items-center space-x-1">
                              <Calendar className="h-3 w-3" />
                              <span>{new Date(form.createdAt).toLocaleDateString('nb-NO')}</span>
                            </div>
                            <div className="flex items-center space-x-1">
                              <MessageCircle className="h-3 w-3" />
                              <span>{form.submissionCount || 0} henvendelser</span>
                            </div>
                          </div>
                        </div>
                        <div className="flex items-center space-x-2">
                          <Button 
                            variant="outline" 
                            size="sm"
                            onClick={() => {
                              setSelectedForm(form);
                              setShowEmbedDialog(true);
                            }}
                            className="bg-amber-500/20 hover:bg-amber-500/30 border-amber-500/30 text-amber-900 hover:text-amber-900 rounded-xl transition-colors duration-300"
                          >
                            <Share className="h-4 w-4 mr-1" />
                            Få kode
                          </Button>
                          <Button 
                            variant="outline" 
                            size="sm"
                            onClick={() => updateFormMutation.mutate({ 
                              id: form.id, 
                              updates: { isActive: !form.isActive } 
                            })}
                            disabled={updateFormMutation.isPending}
                            className="bg-amber-500/20 hover:bg-amber-500/30 border-amber-500/30 text-amber-900 hover:text-amber-900 rounded-xl transition-colors duration-300"
                          >
                            {form.isActive ? <Eye className="h-4 w-4" /> : <X className="h-4 w-4" />}
                          </Button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </TabsContent>
          
          <TabsContent value="create" className="space-y-6 mt-6">
            <div className="bg-amber-500/10 backdrop-blur-xl rounded-3xl p-6 border-amber-500/20 shadow-2xl hover:shadow-3xl hover:bg-amber-500/15 transition-colors duration-500">
              <div className="space-y-4">
                <div className="flex items-center space-x-2 mb-6">
                  <Plus className="h-5 w-5 text-amber-600" />
                  <h4 className="font-medium text-amber-900/80">Opprett nytt innebygd skjema</h4>
                </div>
                
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="space-y-2">
                    <label className="text-sm font-medium text-amber-900/80">Skjemanavn</label>
                    <Input 
                      placeholder="F.eks. Hovedkontaktskjema" 
                      value={formData.name}
                      onChange={(e) => setFormData({...formData, name: e.target.value})}
                      className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300"
                    />
                  </div>
                  <div className="space-y-2">
                    <label className="text-sm font-medium text-amber-900/80">Skjematittel</label>
                    <Input 
                      placeholder="Kontakt oss" 
                      value={formData.title}
                      onChange={(e) => setFormData({...formData, title: e.target.value})}
                      className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300"
                    />
                  </div>
                </div>
                
                <div className="space-y-2">
                  <label className="text-sm font-medium text-amber-900/80">Suksessmelding</label>
                  <Input 
                    placeholder="Takk for din henvendelse! Vi kontakter deg snart." 
                    value={formData.successMessage}
                    onChange={(e) => setFormData({...formData, successMessage: e.target.value})}
                    className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300"
                  />
                </div>
                
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                  <div className="space-y-2">
                    <label className="text-sm font-medium text-amber-900/80">Primærfarge</label>
                    <Input 
                      type="color" 
                      value={formData.primaryColor}
                      onChange={(e) => setFormData({...formData, primaryColor: e.target.value})}
                      className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300 h-12"
                    />
                  </div>
                  <div className="space-y-2">
                    <label className="text-sm font-medium text-amber-900/80">Sekundærfarge</label>
                    <Input 
                      type="color" 
                      value={formData.secondaryColor}
                      onChange={(e) => setFormData({...formData, secondaryColor: e.target.value})}
                      className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300 h-12"
                    />
                  </div>
                  <div className="space-y-2">
                    <label className="text-sm font-medium text-amber-900/80">Bakgrunnsfarge</label>
                    <Input 
                      type="color" 
                      value={formData.backgroundColor}
                      onChange={(e) => setFormData({...formData, backgroundColor: e.target.value})}
                      className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300 h-12"
                    />
                  </div>
                  <div className="space-y-2">
                    <label className="text-sm font-medium text-amber-900/80">Tekstfarge</label>
                    <Input 
                      type="color" 
                      value={formData.textColor}
                      onChange={(e) => setFormData({...formData, textColor: e.target.value})}
                      className="bg-amber-500/20 backdrop-blur-lg border-amber-500/30 rounded-xl focus:bg-amber-500/30 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 transition-colors duration-300 h-12"
                    />
                  </div>
                </div>
                
                <Button 
                  className="w-full bg-gradient-to-r from-amber-500/80 to-orange-500/80 hover:from-amber-600/90 hover:to-orange-600/90 backdrop-blur-xl rounded-xl border-amber-500/30 shadow-lg hover:shadow-xl hover:shadow-amber-500/20 transition-colors duration-500 transform hover:scale-[1.02] text-gray-800 dark:text-white font-medium" 
                  onClick={() => createFormMutation.mutate(formData)}
                  disabled={createFormMutation.isPending || !formData.name || !formData.title}
                >
                  <Plus className="h-5 w-5 mr-2" />
                  {createFormMutation.isPending ? 'Oppretter skjema...' : 'Opprett skjema'}
                </Button>
              </div>
            </div>
          </TabsContent>
        </Tabs>
        
        {/* Embed Code Dialog */}
        {showEmbedDialog && selectedForm && (
          <div className="fixed inset-0 bg-black/50 backdrop-blur-lg flex items-center justify-center z-50">
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-3xl p-6 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
              <div className="flex items-center justify-between mb-4">
                <h3 className="text-lg font-semibold text-amber-900">Embed-kode for {selectedForm.name}</h3>
                <Button 
                  variant="ghost" 
                  size="sm"
                  onClick={() => setShowEmbedDialog(false)}
                  className="text-amber-900 hover:bg-amber-500/20"
                >
                  <X className="h-4 w-4" />
                </Button>
              </div>
              
              <div className="space-y-4">
                <div className="bg-amber-500/10 rounded-xl p-4 border-amber-500/20">
                  <h4 className="font-medium text-amber-900 mb-2">Instruksjoner:</h4>
                  <ol className="text-sm text-amber-800 space-y-1">
                    <li>1. Klikk "Generer og kopier kode" nedenfor</li>
                    <li>2. Lim inn koden på din nettside der du vil at skjemaet skal vises</li>
                    <li>3. Henvendelser kommer automatisk til ditt CreatorHub Norge dashboard</li>
                    <li>4. Alle innbygde funksjoner som mission type-detection fungerer automatisk</li>
                  </ol>
                </div>
                
                <div className="flex justify-between space-x-2">
                  <Button 
                    variant="outline"
                    onClick={() => setShowEmbedDialog(false)}
                    className="flex-1 bg-amber-500/20 hover:bg-amber-500/30 border-amber-500/30 text-amber-900 hover:text-amber-900 rounded-xl transition-colors duration-300"
                  >
                    Lukk
                  </Button>
                  <Button 
                    onClick={() => generateEmbedMutation.mutate(selectedForm.id)}
                    disabled={generateEmbedMutation.isPending}
                    className="flex-1 bg-gradient-to-r from-amber-500/80 to-orange-500/80 hover:from-amber-600/90 hover:to-orange-600/90 backdrop-blur-xl rounded-xl border-amber-500/30 shadow-lg hover:shadow-xl hover:shadow-amber-500/20 transition-colors duration-500 transform hover:scale-[1.02] text-gray-800 dark:text-white font-medium"
                  >
                    <Share className="h-4 w-4 mr-2" />
                    {generateEmbedMutation.isPending ? 'Genererer...' : 'Generer og kopier kode'}
                  </Button>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    );
  };

  const CustomerSubmissionManager = () => {
    const [selectedSubmission, setSelectedSubmission] = useState(null);
    const [showConvertDialog, setShowConvertDialog] = useState(false);
    const [convertFormData, setConvertFormData] = useState({
      projectName: '',
      finalMissionType: '',
      reviewNotes: ''
    });

    // Fetch customer submissions
    const { data: submissionsData, isLoading: submissionsLoading } = useQuery({
      queryKey: ['/api/photographer/submissions'],
      refetchInterval: 30000 // Refresh every 30 seconds
    });

    // Fetch submission statistics
    const { data: statsData } = useQuery({
      queryKey: ['/api/photographer/submissions/stats'],
      refetchInterval: 60000 // Refresh every minute
    });

    // Convert submission to project mutation
    const convertSubmissionMutation = useMutation({
      mutationFn: async (data) => {
        const response = await fetch('/api/submissions/convert-to-project', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(data)
        });
        
        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.error || 'Failed to convert submission');
        }
        
        return response.json();
      },
      onSuccess: () => {
        queryClient.invalidateQueries({ queryKey: ['/api/photographer/submissions'] });
        queryClient.invalidateQueries({ queryKey: ['/api/photographer/submissions/stats'] });
        queryClient.invalidateQueries({ queryKey: ['/api/photographer/projects'] });
        setShowConvertDialog(false);
        setSelectedSubmission(null);
        setConvertFormData({ projectName: '', finalMissionType: '', reviewNotes: '' });
        toast({
          title: "Prosjekt opprettet!",
          description: "Kundehenvendelsen har blitt konvertert til et prosjekt med OneDrive-struktur.",
          duration: 5000,
        });
      },
      onError: (error) => {
        toast({
          title: "Feil ved konvertering",
          description: error.message,
          variant: "destructive",
        });
      }
    });

    // Update submission status mutation
    const updateSubmissionMutation = useMutation({
      mutationFn: async ({ id, status, priority, reviewNotes }) => {
        const response = await fetch(`/api/submissions/${id}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ status, priority, reviewNotes })
        });
        
        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.error || 'Failed to update submission');
        }
        
        return response.json();
      },
      onSuccess: () => {
        queryClient.invalidateQueries({ queryKey: ['/api/photographer/submissions'] });
        queryClient.invalidateQueries({ queryKey: ['/api/photographer/submissions/stats'] });
        toast({
          title: "Henvendelse oppdatert",
          description: "Statusen har blitt oppdatert.",
        });
      },
      onError: (error) => {
        toast({
          title: "Feil ved oppdatering",
          description: error.message,
          variant: "destructive",
        });
      }
    });

    const handleConvertToProject = () => {
      if (!selectedSubmission) return;

      const finalMissionType = convertFormData.finalMissionType || selectedSubmission.detectedMissionType;
      const projectName = convertFormData.projectName || `${finalMissionType} - ${selectedSubmission.customerName}`;

      convertSubmissionMutation.mutate({
        submissionId: selectedSubmission.id,
        finalMissionType,
        projectName,
        reviewNotes: convertFormData.reviewNotes
      });
    };

    const getMissionTypeBadgeColor = (type) => {
      switch (type) {
        case 'Bryllup': return 'bg-pink-100 text-pink-800';
        case 'Bedrift': return 'bg-blue-100 text-blue-800';
        case 'Privat': return 'bg-green-100 text-green-800';
        case 'Kommersiell': return 'bg-purple-100 text-purple-800';
        default: return 'bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-800';
      }
    };

    const getStatusBadgeColor = (status) => {
      switch (status) {
        case 'pending': return 'bg-yellow-100 text-yellow-800';
        case 'reviewed': return 'bg-blue-100 text-blue-800';
        case 'converted': return 'bg-green-100 text-green-800';
        case 'declined': return 'bg-red-100 text-red-800';
        default: return 'bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-800';
      }
    };

    const getStatusText = (status) => {
      switch (status) {
        case 'pending': return 'Venter';
        case 'reviewed': return 'Vurdert';
        case 'converted': return 'Konvertert';
        case 'declined': return 'Avvist';
        default: return status;
      }
    };

    if (submissionsLoading) {
      return (
        <div className="flex items-center justify-center p-8">
          <div className="flex items-center space-x-2">
            <RefreshCw className="h-5 w-5 animate-spin" />
            <span>Laster kundehenvendelser...</span>
          </div>
        </div>
      );
    }

    const submissions = submissionsData?.submissions || [];
    const stats = statsData?.stats || {};

    return (
      <div className="space-y-6">
        {/* Statistics Overview */}
        {Object.keys(stats).length > 0 && (
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Card className="p-4">
              <div className="flex items-center justify-between">
                <div>
                  <div className="text-2xl font-bold">{stats.totalSubmissions || 0}</div>
                  <div className="text-sm text-gray-600">Totale henvendelser</div>
                </div>
                <MessageSquare className="h-8 w-8 text-blue-500" />
              </div>
            </Card>
            <Card className="p-4">
              <div className="flex items-center justify-between">
                <div>
                  <div className="text-2xl font-bold">{stats.conversionRate || 0}%</div>
                  <div className="text-sm text-gray-600">Konverteringsrate</div>
                </div>
                <TrendingUp className="h-8 w-8 text-green-500" />
              </div>
            </Card>
            <Card className="p-4">
              <div className="flex items-center justify-between">
                <div>
                  <div className="text-2xl font-bold">{stats.byStatus?.pending || 0}</div>
                  <div className="text-sm text-gray-600">Venter på svar</div>
                </div>
                <Clock className="h-8 w-8 text-orange-500" />
              </div>
            </Card>
          </div>
        )}

        {/* Submissions List */}
        <div className="space-y-4">
          <div className="flex items-center justify-between">
            <h4 className="text-lg sm:text-xl font-bold text-orange-900 dark:text-orange-100">Kundehenvendelser ({submissions.length})</h4>
            <Button 
              variant="outline" 
              size="sm"
              onClick={() => queryClient.invalidateQueries({ queryKey: ['/api/photographer/submissions'] })}
            >
              <RefreshCw className="h-4 w-4 mr-2" />
              Oppdater
            </Button>
          </div>

          {submissions.length === 0 ? (
            <Card className="p-8 text-center">
              <MessageSquare className="h-12 w-12 text-gray-400 mx-auto mb-4" />
              <h3 className="text-lg font-medium text-gray-800 mb-2">Ingen henvendelser ennå</h3>
              <p className="text-gray-600">Når kunder sender henvendelser gjennom kontaktskjemaet, vil de vises her.</p>
            </Card>
          ) : (
            <div className="space-y-4">
              {submissions.map((submission) => (
                <Card key={submission.id} className="p-4">
                  <div className="space-y-4">
                    {/* Header */}
                    <div className="flex items-start justify-between">
                      <div className="flex-1">
                        <div className="flex items-center space-x-2 mb-2">
                          <h4 className="font-medium">{submission.customerName}</h4>
                          <Badge className="bg-white border rounded-lg p-4">
                            {getStatusText(submission.status)}
                          </Badge>
                          {submission.detectedMissionType && (
                            <Badge className="bg-white border rounded-lg p-4">
                              {submission.detectedMissionType}
                            </Badge>
                          )}
                          {submission.detectionConfidence && (
                            <Badge variant="outline" className="text-xs">
                              {Math.round(submission.detectionConfidence * 100)}% sikkerhet
                            </Badge>
                          )}
                        </div>
                        <div className="text-sm text-gray-600 space-y-1">
                          <div className="flex items-center space-x-4">
                            <div className="flex items-center space-x-1">
                              <Mail className="h-4 w-4" />
                              <span>{submission.customerEmail}</span>
                            </div>
                            {submission.customerPhone && (
                              <div className="flex items-center space-x-1">
                                <Phone className="h-4 w-4" />
                                <span>{submission.customerPhone}</span>
                              </div>
                            )}
                          </div>
                          {submission.eventDate && (
                            <div className="flex items-center space-x-1">
                              <CalendarIcon className="h-4 w-4" />
                              <span>{new Date(submission.eventDate).toLocaleDateString('nb-NO')}</span>
                            </div>
                          )}
                          {submission.location && (
                            <div className="flex items-center space-x-1">
                              <MapPin className="h-4 w-4" />
                              <span>{submission.location}</span>
                            </div>
                          )}
                        </div>
                      </div>
                      <div className="text-right text-sm text-gray-500">
                        {new Date(submission.createdAt).toLocaleDateString('nb-NO', {
                          day: '2-digit',
                          month: '2-digit',
                          year: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit'
                        })}
                      </div>
                    </div>

                    {/* Message */}
                    <div className="bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg rounded-lg p-3">
                      <div className="text-sm">
                        <div className="font-medium mb-1">Melding:</div>
                        <div className="text-gray-700">{submission.message}</div>
                      </div>
                    </div>

                    {/* AI Detection Results */}
                    {submission.detectionExplanation && (
                      <div className="bg-blue-50 rounded-lg p-3">
                        <div className="text-sm">
                          <div className="font-medium mb-1 flex items-center">
                            <ScanLine className="h-4 w-4 mr-1" />
                            Analyse av kunden:
                          </div>
                          <div className="text-blue-700">{submission.detectionExplanation}</div>
                          {submission.detectionKeywords && submission.detectionKeywords.length > 0 && (
                            <div className="mt-2">
                              <div className="text-xs font-medium mb-1">Oppdagede nøkkelord:</div>
                              <div className="flex flex-wrap gap-1">
                                {submission.detectionKeywords.map((keyword, idx) => (
                                  <span key={idx} className="bg-blue-100 text-blue-800 px-2 py-1 rounded-xl text-xs">
                                    {keyword}
                                  </span>
                                ))}
                              </div>
                            </div>
                          )}
                        </div>
                      </div>
                    )}

                    {/* Automatic Notes */}
                    {submission.autoNotes && (
                      <div className="bg-green-50 rounded-lg p-3">
                        <div className="text-sm">
                          <div className="font-medium mb-1 flex items-center">
                            <FileText className="h-4 w-4 mr-1" />
                            Automatiske notater:
                          </div>
                          <div className="text-green-700 whitespace-pre-line text-xs font-mono">
                            {submission.autoNotes}
                          </div>
                        </div>
                      </div>
                    )}

                    {/* Actions */}
                    <div className="flex items-center space-x-2">
                      {submission.status === 'pending' && (
                        <>
                          <Button 
                            size="sm"
                            onClick={() => {
                              setSelectedSubmission(submission);
                              setConvertFormData({
                                projectName: `${submission.detectedMissionType || 'Prosjekt'} - ${submission.customerName}`,
                                finalMissionType: submission.detectedMissionType || '',
                                reviewNotes: ''
                              });
                              setShowConvertDialog(true);
                            }}
                          >
                            <CheckCircle className="h-4 w-4 mr-2" />
                            Konverter til prosjekt
                          </Button>
                          <Button 
                            variant="outline" 
                            size="sm"
                            onClick={() => {
                              updateSubmissionMutation.mutate({
                                id: submission.id,
                                status: 'reviewed',
                                priority: 'normal',
                                reviewNotes: 'Vurdert av fotograf'
                              });
                            }}
                          >
                            <Eye className="h-4 w-4 mr-2" />
                            Marker som vurdert
                          </Button>
                        </>
                      )}
                      
                      {submission.status === 'converted' && submission.convertedToProjectId && (
                        <div className="flex items-center space-x-2 text-green-700">
                          <CheckCircle className="h-4 w-4" />
                          <span className="text-sm">Konvertert til prosjekt</span>
                        </div>
                      )}
                    </div>
                  </div>
                </Card>
              ))}
            </div>
          )}
        </div>

        {/* Convert to Project Dialog */}
        {showConvertDialog && selectedSubmission && (
          <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
            <Card className="w-full max-w-md">
              <CardHeader>
                <CardTitle>Konverter til prosjekt</CardTitle>
                <CardDescription>
                  Opprett et nytt prosjekt fra kundehenvendelsen
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-4">
                <div className="space-y-2">
                  <label className="text-sm font-medium">Prosjektnavn</label>
                  <Input 
                    placeholder="Prosjektnavn"
                    value={convertFormData.projectName}
                    onChange={(e) => setConvertFormData(prev => ({ ...prev, projectName: e.target.value }))}
                  />
                </div>
                
                <div className="space-y-2">
                  <label className="text-sm font-medium">Oppdragstype</label>
                  <Select 
                    value={convertFormData.finalMissionType} 
                    onValueChange={(value) => setConvertFormData(prev => ({ ...prev, finalMissionType: value }))}
                  >
                    <SelectTrigger>
                      <SelectValue placeholder="Velg oppdragstype" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="Bryllup">Bryllup</SelectItem>
                      <SelectItem value="Bedrift">Bedrift</SelectItem>
                      <SelectItem value="Privat">Privat</SelectItem>
                      <SelectItem value="Kommersiell">Kommersiell</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
                
                <div className="space-y-2">
                  <label className="text-sm font-medium">Vurderingsnotater</label>
                  <Textarea 
                    placeholder="Notater om vurdering..."
                    value={convertFormData.reviewNotes}
                    onChange={(e) => setConvertFormData(prev => ({ ...prev, reviewNotes: e.target.value }))}
                  />
                </div>

                <div className="flex space-x-2">
                  <Button 
                    onClick={handleConvertToProject}
                    disabled={convertSubmissionMutation.isPending}
                    className="flex-1"
                  >
                    {convertSubmissionMutation.isPending ? (
                      <RefreshCw className="h-4 w-4 mr-2 animate-spin" />
                    ) : (
                      <CheckCircle className="h-4 w-4 mr-2" />
                    )}
                    {convertSubmissionMutation.isPending ? 'Konverterer...' : 'Opprett prosjekt'}
                  </Button>
                  <Button 
                    variant="outline" 
                    onClick={() => {
                      setShowConvertDialog(false);
                      setSelectedSubmission(null);
                      setConvertFormData({ projectName: '', finalMissionType: '', reviewNotes: '' });
                    }}
                  >
                    Avbryt
                  </Button>
                </div>
              </CardContent>
            </Card>
          </div>
        )}
      </div>
    );
  };

  const InvoiceManager = () => (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {invoices.map(invoice => (
          <Card key={invoice.id} className="p-4">
            <div className="flex items-center justify-between">
              <div>
                <h4 className="font-semibold">{invoice.number}</h4>
                <p className="text-sm text-gray-600">{invoice.client}</p>
              </div>
              <div className="text-right">
                <div className="text-lg font-bold">{(invoice.amount || 0).toLocaleString('nb-NO')} kr</div>
                <Badge className={
                  invoice.status === "Betalt" ? "bg-green-100 text-green-800" : 
                  invoice.status === "Sendt" ? "bg-orange-100 text-orange-800" : 
                  "bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-800"
                }>
                  {invoice.status}
                </Badge>
              </div>
            </div>
          </Card>
        ))}
      </div>
      <Button className="w-full" onClick={createInvoice}>
        <CreditCard className="h-5 w-5 mr-2" />
        Opprett faktura
      </Button>
    </div>
  );

  const CloudIntegration = () => (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Button variant="outline" className="h-20 flex flex-col" onClick={() => {
          toast({
            title: "OneDrive Backup",
            description: "Starter synkronisering av filer",
            duration: 2000,
          });
          // Navigate to cloud storage section
          setActiveTab("cloud");
        }}>
          <div className="h-8 w-8 bg-blue-100 rounded-xl mb-2 flex items-center justify-center">
            <Archive className="h-5 w-5 text-blue-600" />
          </div>
          <span className="text-sm">OneDrive Backup</span>
        </Button>
        <Button variant="outline" className="h-20 flex flex-col" onClick={() => {
          toast({
            title: "Google Drive",
            description: "Åpner filvelger for Google Drive",
            duration: 2000,
          });
          // Navigate to cloud storage section
          setActiveTab("cloud");
        }}>
          <div className="h-8 w-8 bg-green-100 rounded-xl mb-2 flex items-center justify-center">
            <Archive className="h-5 w-5 text-green-600" />
          </div>
          <span className="text-sm">Google Drive</span>
        </Button>
      </div>
      <Button className="w-full" onClick={() => {
        toast({
          title: "Integrasjonsinnstillinger",
          description: "Åpner konfigurasjonspanel for tjenester",
          duration: 2000,
        });
        setActiveTab("innstillinger");
      }}>
        <Settings className="h-5 w-5 mr-2" />
        Konfigurer integrasjoner
      </Button>
    </div>
  );

