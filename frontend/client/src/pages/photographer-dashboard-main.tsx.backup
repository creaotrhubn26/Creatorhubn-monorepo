        ],
        updateTime: "4-7"
      }
    };

    return firmwareDetails[device.device] || {
      newFeatures: ["Forbedret ytelse og stabilitet"],
      improvements: ["Generelle systmeforbedringer"],
      bugFixes: ["Mindre feilrettinger"],
      updateTime: "3-5"
    };
