              <div className="bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:bg-gray-800/50 p-4 rounded-xl">
                <h4 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white mb-3">Klientstatus oversikt</h4>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div className="bg-green-50 dark:bg-green-900/20 p-3 rounded-lg">
                    <div className="flex items-center gap-2 mb-2">
                      <div className="w-3 h-3 bg-green-500 rounded-full"></div>
                      <span className="text-sm font-medium text-green-700 dark:text-green-300">Lavrisiko</span>
                    </div>
                    <p className="text-2xl font-bold text-green-700 dark:text-green-300">0</p>
                    <p className="text-sm text-green-600 dark:text-green-400">Stabile klienter</p>
                  </div>
                  
                  <div className="bg-amber-50 dark:bg-amber-900/20 p-3 rounded-lg">
                    <div className="flex items-center gap-2 mb-2">
                      <div className="w-3 h-3 bg-amber-500 rounded-full"></div>
                      <span className="text-sm font-medium text-amber-700 dark:text-amber-300">Mediumrisiko</span>
                    </div>
                    <p className="text-2xl font-bold text-amber-700 dark:text-amber-300">0</p>
                    <p className="text-sm text-amber-600 dark:text-amber-400">Krever oppfølging</p>
                  </div>
                  
                  <div className="bg-red-50 dark:bg-red-900/20 p-3 rounded-lg">
                    <div className="flex items-center gap-2 mb-2">
                      <div className="w-3 h-3 bg-red-500 rounded-full"></div>
                      <span className="text-sm font-medium text-red-700 dark:text-red-300">Høyrisiko</span>
                    </div>
                    <p className="text-2xl font-bold text-red-700 dark:text-red-300">0</p>
                    <p className="text-sm text-red-600 dark:text-red-400">Krever umiddelbar handling</p>
                  </div>
                </div>
              </div>

              {/* Recent Activity */}
              <div className="bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:bg-gray-800/50 p-4 rounded-xl">
                <h4 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white mb-3">Nylig aktivitet</h4>
                <div className="space-y-3">
                  <div className="flex items-center gap-3 p-3 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-700 rounded-lg">
                    <div className="w-8 h-8 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center">
                      <Mail className="h-4 w-4 text-blue-600 dark:text-blue-400" />
                    </div>
                    <div className="flex-1">
                      <p className="text-sm font-medium text-gray-800 dark:text-gray-800 dark:text-white">Ingen aktivitet enda</p>
                      <p className="text-xs text-gray-500 dark:text-gray-400">Begynn å registrere klienter for å se aktivitet</p>
                    </div>
                  </div>
                </div>
              </div>

              {/* Quick Client Management Tools */}
              <div className="bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 p-4 rounded-xl">
                <h4 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white mb-3">Hurtigverktøy</h4>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <button className="flex items-center gap-3 p-3 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-700 rounded-lg hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:hover:bg-gray-600 transition-colors">
                    <Settings className="h-5 w-5 text-gray-600 dark:text-gray-400" />
                    <div className="text-left">
                      <p className="text-sm font-medium text-gray-800 dark:text-gray-800 dark:text-white">Administrer klienttyper</p>
                      <p className="text-xs text-gray-500 dark:text-gray-400">Tilpass klientkategorier</p>
                    </div>
                  </button>
                  
                  <button className="flex items-center gap-3 p-3 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-700 rounded-lg hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:hover:bg-gray-600 transition-colors">
                    <Edit3 className="h-5 w-5 text-gray-600 dark:text-gray-400" />
                    <div className="text-left">
                      <p className="text-sm font-medium text-gray-800 dark:text-gray-800 dark:text-white">Tilpass felt</p>
                      <p className="text-xs text-gray-500 dark:text-gray-400">Legg til egendefinerte felt</p>
                    </div>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Project Management Dialog */}
      {showProjectDialog && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-lg flex items-center justify-center p-4 z-50">
          <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-800 rounded-xl max-w-md w-full p-6 shadow-2xl">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white">Prosjektadministrasjon</h3>
              <button 
                onClick={() => setShowProjectDialog(false)}
                className="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
              >
                <X className="h-5 w-5" />
              </button>
            </div>
            <div className="space-y-4">
              <p className="text-gray-600 dark:text-gray-400">Administrer dine fotograferingsprosjekter.</p>
              <div className="flex gap-3">
                <Button 
                  onClick={() => {
                    setShowProjectDialog(false);
                    setActiveMainTab('core-business');
                    setActiveSubTab('projects');
                  }}
                  className="flex-1"
                >
                  <Camera className="h-4 w-4 mr-2" />
                  Vis prosjekter
                </Button>
                <Button 
                  variant="outline" 
                  onClick={() => {
                    setShowProjectDialog(false);
                    handleCreateProject();
                  }}
                  className="flex-1"
                >
                  <Plus className="h-4 w-4 mr-2" />
                  Nytt prosjekt
                </Button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Revenue Management Dialog */}
      {showRevenueDialog && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-lg flex items-center justify-center p-4 z-50">
          <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-800 rounded-xl max-w-md w-full p-6 shadow-2xl">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white">Inntektsadministrasjon</h3>
              <button 
                onClick={() => setShowRevenueDialog(false)}
                className="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
              >
                <X className="h-5 w-5" />
              </button>
            </div>
            <div className="space-y-4">
              <p className="text-gray-600 dark:text-gray-400">Administrer inntekter og fakturaer.</p>
              <div className="flex gap-3">
                <Button 
                  onClick={() => {
                    setShowRevenueDialog(false);
                    setActiveMainTab('core-business');
                    setActiveSubTab('invoices');
                  }}
                  className="flex-1"
                >
                  <DollarSign className="h-4 w-4 mr-2" />
                  Vis fakturaer
                </Button>
                <Button 
                  variant="outline" 
                  onClick={() => {
                    setShowRevenueDialog(false);
                    toast({ title: "Ny faktura", description: "Fakturaoppretting startet..." });
                  }}
                  className="flex-1"
                >
                  <Plus className="h-4 w-4 mr-2" />
                  Ny faktura
                </Button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Equipment Management Dialog */}
      {showEquipmentDialog && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-lg flex items-center justify-center p-4 z-50">
          <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-800 rounded-xl max-w-md w-full p-6 shadow-2xl">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white">Utstyrsadministrasjon</h3>
              <button 
                onClick={() => setShowEquipmentDialog(false)}
                className="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
              >
                <X className="h-5 w-5" />
              </button>
            </div>
            <div className="space-y-4">
              <p className="text-gray-600 dark:text-gray-400">Administrer ditt fotografutstyr og vedlikehold.</p>
              <div className="flex gap-3">
                <Button 
                  onClick={() => {
                    setShowEquipmentDialog(false);
                    setActiveMainTab('equipment-tools');
                    setActiveSubTab('equipment');
                  }}
                  className="flex-1"
                >
                  <Wrench className="h-4 w-4 mr-2" />
                  Vis utstyr
                </Button>
                <Button 
                  variant="outline" 
                  onClick={() => {
                    setShowEquipmentDialog(false);
                    handleAddEquipment();
                  }}
                  className="flex-1"
                >
                  <Plus className="h-4 w-4 mr-2" />
                  Nytt utstyr
                </Button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Floating Action Button for Quick Actions - Desktop Only */}
      <div className="hidden lg:block fixed bottom-6 right-6 z-40">
        <div className="relative group">
          <Button
            size="lg"
            className="w-14 h-14 rounded-full bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-gray-800 dark:text-white shadow-lg hover:shadow-xl transition-colors duration-300 hover:scale-[1.02]"
            onClick={() => {/* Toggle FAB menu */}}
          >
            <Plus className="h-6 w-6" />
          </Button>
          
          {/* Customizable Quick Action Menu */}
          <div className="absolute bottom-16 right-0 w-64 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-lg shadow-xl border-white/20 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-colors duration-200">
            <div className="py-3">
              {/* Primary Actions */}
              <div className="px-4 py-1">
                <div className="text-xs font-medium text-gray-500 uppercase tracking-wide">Primære handlinger</div>
              </div>
              <button 
                onClick={createProject}
                className="w-full text-left px-4 py-3 text-sm hover:bg-orange-50 flex items-center justify-between transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center">
                    <Plus className="h-4 w-4 text-orange-600" />
                  </div>
                  <div>
                    <div className="font-medium text-gray-800">Nytt prosjekt</div>
                    <div className="text-xs text-gray-500">Opprett nytt fotografering</div>
                  </div>
                </div>
                <kbd className="px-2 py-1 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600 text-xs rounded-xl opacity-0 group-hover:opacity-100 transition-opacity">Ctrl+N</kbd>
              </button>
              <button 
                onClick={() => setShowClientManagement(true)}
                className="w-full text-left px-4 py-3 text-sm hover:bg-blue-50 flex items-center justify-between transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                    <Users className="h-4 w-4 text-blue-600" />
                  </div>
                  <div>
                    <div className="font-medium text-gray-800">Administrer klienter</div>
                    <div className="text-xs text-gray-500">Ny eller rediger klient</div>
                  </div>
                </div>
                <kbd className="px-2 py-1 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600 text-xs rounded-xl opacity-0 group-hover:opacity-100 transition-opacity">Ctrl+C</kbd>
              </button>
              <button 
                onClick={() => setActiveTab('delivery')}
                className="w-full text-left px-4 py-3 text-sm hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 flex items-center space-x-3 transition-colors"
              >
                <div className="w-8 h-8 bg-emerald-100 rounded-full flex items-center justify-center">
                  <Send className="h-4 w-4 text-emerald-600" />
                </div>
                <div>
                  <div className="font-medium text-gray-800">Lever bilder</div>
                  <div className="text-xs text-gray-500">Send bilder til klient</div>
                </div>
              </button>
              <button 
                onClick={() => {
                  toast({
                    title: "Priskalkulatoren",
                    description: "Kalkulerer priser basert på prosjekttype og varighet",
                  });
                }}
                className="w-full text-left px-4 py-3 text-sm hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 flex items-center justify-between transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="w-8 h-8 bg-sky-100 rounded-full flex items-center justify-center">
                    <Calculator className="h-4 w-4 text-sky-600" />
                  </div>
                  <div>
                    <div className="font-medium text-gray-800">Priskalkulatoren</div>
                    <div className="text-xs text-gray-500">Beregn prosjektpriser raskt</div>
                  </div>
                </div>
                <kbd className="px-2 py-1 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600 text-xs rounded-xl opacity-0 group-hover:opacity-100 transition-opacity">Ctrl+P</kbd>
              </button>
              <button 
                onClick={() => {
                  toast({
                    title: "Møteplanlegger",
                    description: "Planlegger møte med klient eller team",
                  });
                }}
                className="w-full text-left px-4 py-3 text-sm hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 flex items-center space-x-3 transition-colors"
              >
                <div className="w-8 h-8 bg-violet-100 rounded-full flex items-center justify-center">
                  <Calendar className="h-4 w-4 text-violet-600" />
                </div>
                <div>
                  <div className="font-medium text-gray-800">Planlegg møte</div>
                  <div className="text-xs text-gray-500">Avtale med klient</div>
                </div>
              </button>
              
              {/* Business Actions */}
              <hr className="my-2 border-white/20" />
              <div className="px-4 py-1">
                <div className="text-xs font-medium text-gray-500 uppercase tracking-wide">Forretning</div>
              </div>
              <button 
                onClick={() => setShowRevenueManagement(true)}
                className="w-full text-left px-4 py-3 text-sm hover:bg-green-50 flex items-center justify-between transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                    <DollarSign className="h-4 w-4 text-green-600" />
                  </div>
                  <div>
                    <div className="font-medium text-gray-800">Registrer inntekt</div>
                    <div className="text-xs text-gray-500">Legg til ny inntekt</div>
                  </div>
                </div>
                <kbd className="px-2 py-1 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600 text-xs rounded-xl opacity-0 group-hover:opacity-100 transition-opacity">Ctrl+R</kbd>
              </button>
              <button 
                onClick={() => setActiveTab('invoices')}
                className="w-full text-left px-4 py-3 text-sm hover:bg-yellow-50 flex items-center space-x-3 transition-colors"
              >
                <div className="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center">
                  <Receipt className="h-4 w-4 text-yellow-600" />
                </div>
                <div>
                  <div className="font-medium text-gray-800">Send faktura</div>
                  <div className="text-xs text-gray-500">Opprett og send faktura</div>
                </div>
              </button>
              <button 
                onClick={() => {
                  toast({
                    title: "Utgifter registrert",
                    description: "Ny utgift lagt til for skatterapportering",
                  });
                }}
                className="w-full text-left px-4 py-3 text-sm hover:bg-red-50 flex items-center space-x-3 transition-colors"
              >
                <div className="w-8 h-8 bg-red-100 rounded-full flex items-center justify-center">
                  <Minus className="h-4 w-4 text-red-600" />
                </div>
                <div>
                  <div className="font-medium text-gray-800">Registrer utgift</div>
                  <div className="text-xs text-gray-500">Legg til forretningsutgift</div>
                </div>
              </button>
              
              {/* Tools & Equipment */}
              <hr className="my-2 border-white/20" />
              <div className="px-4 py-1">
                <div className="text-xs font-medium text-gray-500 uppercase tracking-wide">Verktøy</div>
              </div>
              <button 
                onClick={() => setActiveTab('equipment')}
                className="w-full text-left px-4 py-3 text-sm hover:bg-purple-50 flex items-center justify-between transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                    <Camera className="h-4 w-4 text-purple-600" />
                  </div>
                  <div>
                    <div className="font-medium text-gray-800">Administrer utstyr</div>
                    <div className="text-xs text-gray-500">Legg til eller sjekk utstyr</div>
                  </div>
                </div>
                <kbd className="px-2 py-1 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600 text-xs rounded-xl opacity-0 group-hover:opacity-100 transition-opacity">Ctrl+U</kbd>
              </button>
              <button 
                onClick={() => setShowMaintenanceScheduler(true)}
                className="w-full text-left px-4 py-3 text-sm hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 flex items-center space-x-3 transition-colors"
              >
                <div className="w-8 h-8 bg-teal-100 rounded-full flex items-center justify-center">
                  <Wrench className="h-4 w-4 text-teal-600" />
                </div>
                <div>
                  <div className="font-medium text-gray-800">Vedlikehold</div>
                  <div className="text-xs text-gray-500">Planlegg utstyrsservice</div>
                </div>
              </button>
              <button 
                onClick={() => setActiveTab('nyheter')}
                className="w-full text-left px-4 py-3 text-sm hover:bg-indigo-50 flex items-center space-x-3 transition-colors"
              >
                <div className="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center">
                  <Bell className="h-4 w-4 text-indigo-600" />
                </div>
                <div>
                  <div className="font-medium text-gray-800">Bransjenyheter</div>
                  <div className="text-xs text-gray-500">Siste utstyr og trender</div>
                </div>
              </button>
              <button 
                onClick={() => {
                  toast({
                    title: "Fotosessjon sjekkliste",
                    description: "Sjekkliste for utstyr og forberedelser opprettet",
                  });
                }}
                className="w-full text-left px-4 py-3 text-sm hover:bg-amber-50 flex items-center justify-between transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="w-8 h-8 bg-amber-100 rounded-full flex items-center justify-center">
                    <CheckSquare className="h-4 w-4 text-amber-600" />
                  </div>
                  <div>
                    <div className="font-medium text-gray-800">Fotosessjon sjekkliste</div>
                    <div className="text-xs text-gray-500">Utstyr og forberedelser</div>
                  </div>
                </div>
                <kbd className="px-2 py-1 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600 text-xs rounded-xl opacity-0 group-hover:opacity-100 transition-opacity">Ctrl+L</kbd>
              </button>
              <button 
                onClick={() => {
                  toast({
                    title: "Bildesikkerhetskopi",
                    description: "Starter automatisk sikkerhetskopi til sky",
                  });
                }}
                className="w-full text-left px-4 py-3 text-sm hover:bg-cyan-50 flex items-center justify-between transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="w-8 h-8 bg-cyan-100 rounded-full flex items-center justify-center">
                    <Archive className="h-4 w-4 text-cyan-600" />
                  </div>
                  <div>
                    <div className="font-medium text-gray-800">Sikkerhetskopi</div>
                    <div className="text-xs text-gray-500">Sikkerhetskopier bilder</div>
                  </div>
                </div>
                <kbd className="px-2 py-1 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600 text-xs rounded-xl opacity-0 group-hover:opacity-100 transition-opacity">Ctrl+B</kbd>
              </button>
              
              {/* Settings */}
              <hr className="my-2 border-white/20" />
              <button 
                onClick={() => setShowSettings(true)}
                className="w-full text-left px-4 py-3 text-sm hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg flex items-center space-x-3 transition-colors"
              >
                <div className="w-8 h-8 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg rounded-full flex items-center justify-center">
                  <Settings className="h-4 w-4 text-gray-600" />
                </div>
                <div>
                  <div className="font-medium text-gray-800">Innstillinger</div>
                  <div className="text-xs text-gray-500">Tilpass dashbordet</div>
                </div>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

// Wrapped main component with comprehensive platform integration and universal layout system
export default function PhotographerDashboardMain() {
  return (
    <PhotographerMobileInterface>
      <PhotographerDashboardContent />
      
      {/* Universal Prototype Testing Feedback Widget */}
      <UniversalPrototypeFeedback 
        dashboardType="photographer" 
        isTestingMode={true}
      />
    </PhotographerMobileInterface>
  );
}