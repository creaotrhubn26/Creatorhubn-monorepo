                        </div>
                        <button
                          onClick={() => setSettings(prev => ({ ...prev, notifications: !prev.notifications }))}
                          className={`w-10 h-6 rounded-full flex items-center px-1 transition-colors ${
                            settings.notifications ? 'bg-green-500 justify-end' : 'bg-gray-300 justify-start'
                          }`}
                        >
                          <div className="w-4 h-4 bg-white rounded-full"></div>
                        </button>
                      </div>
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-sm font-medium text-gray-700">Automatisk lagring</div>
                          <div className="text-xs text-gray-500">Lagre endringer automatisk etter 1 sekund</div>
                        </div>
                        <button
                          onClick={() => setSettings(prev => ({ ...prev, autoSaveEnabled: !prev.autoSaveEnabled }))}
                          className={`w-10 h-6 rounded-full flex items-center px-1 transition-colors ${
                            settings.autoSaveEnabled ? 'bg-green-500 justify-end' : 'bg-gray-300 justify-start'
                          }`}
                        >
                          <div className="w-4 h-4 bg-white rounded-full"></div>
                        </button>
                      </div>
                    </div>
                    
                    {/* Refresh Interval Selector */}
                    <div className="mt-4 pt-4 border-t border-amber-200/30">
                      <div className="flex items-center justify-between mb-2">
                        <label className="text-sm font-medium text-gray-700">Oppdateringsintervall</label>
                        <span className="text-xs text-gray-500">{settings.refreshInterval} sekunder</span>
                      </div>
                      <div className="flex gap-2">
                        {[15, 30, 60, 120].map((interval) => (
                          <button
                            key={interval}
                            onClick={() => setSettings(prev => ({ ...prev, refreshInterval: interval }))}
                            className={`px-3 py-1 rounded-lg text-xs font-medium transition-colors ${
                              settings.refreshInterval === interval
                                ? 'bg-amber-500 text-white'
                                : 'bg-white/60 text-gray-600 hover:bg-amber-100'
                            }`}
                          >
                            {interval}s
                          </button>
                        ))}
                      </div>
                    </div>
                  </div>

                  {/* Manual Controls */}
                  <div className="flex gap-3 flex-wrap">
                    <Button 
                      onClick={refreshAllData}
                      disabled={projectsLoading || clientsLoading || equipmentLoading}
                      className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg text-amber-600 hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 border-amber-200/50 disabled:opacity-50"
                    >
                      <RefreshCw className="w-4 h-4 mr-2 " />
                      Manuell oppdatering
                    </Button>
                    
                    {/* Manual Save Button - shown when auto-save is disabled */}
                    {!settings.autoSaveEnabled && (
                      <Button 
                        onClick={() => autoSaveMutation.mutate(settings)}
                        disabled={autoSaveMutation.isPending}
                        className="bg-gradient-to-br from-green-50/95 via-green-100/20 to-green-50/95 backdrop-blur-lg text-green-600 hover:bg-gradient-to-br from-green-100/30 to-green-200/20 border-green-200/50 disabled:opacity-50"
                      >
                        <Save className="w-4 h-4 mr-2 " />
                        {autoSaveMutation.isPending ? 'Lagrer...' : 'Lagre innstillinger'}
                      </Button>
                    )}
                    
                    <Button 
                      variant="outline"
                      onClick={() => {
                        queryClient.clear();
                        toast({
                          title: "Cache tømt",
                          description: "Lokal cache er tømt og data vil lastes på nytt",
                        });
                        setTimeout(() => {
                          window.location.reload();
                        }, 1000);
                      }}
                      className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg text-gray-600 hover:bg-gradient-to-br from-gray-50/30 to-slate-50/20 border-gray-200/50"
                    >
                      <Trash2 className="w-4 h-4 mr-2" />
                      Tøm cache
                    </Button>
                  </div>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          <TabsContent value="firmware" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center">
                  <DollarSign className="h-5 w-5 mr-2 text-green-600" />
                  Total utstyr verdi
                </CardTitle>
                <CardDescription>
                  Beregnet markedsverdi av ditt utstyr basert på norske priser
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-6">
                  {/* Total Value Overview */}
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div className="p-6 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg border-green-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-green-800 font-semibold">Total verdi</div>
                          <div className="text-3xl font-bold text-green-900">
                            {(equipmentList || []).reduce((total, item) => total + (item.price || 0), 0).toLocaleString('nb-NO')} kr
                          </div>
                        </div>
                        <DollarSign className="h-12 w-10 text-green-600" />
                      </div>
                    </div>
                    
                    <div className="p-6 bg-gradient-to-r from-blue-50 to-cyan-50 rounded-lg border-blue-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-blue-800 font-semibold">Antall enheter</div>
                          <div className="text-3xl font-bold text-blue-900">{(equipmentList || []).length}</div>
                        </div>
                        <Camera className="h-12 w-10 text-blue-600" />
                      </div>
                    </div>
                    
                    <div className="p-6 bg-gradient-to-r from-purple-50 to-violet-50 rounded-lg border-purple-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-purple-800 font-semibold">Snittverdi</div>
                          <div className="text-3xl font-bold text-purple-900">
                            {(equipmentList || []).length > 0 
                              ? Math.round((equipmentList || []).reduce((total, item) => total + (item.price || 0), 0) / (equipmentList || []).length).toLocaleString('nb-NO')
                              : '0'
                            } kr
                          </div>
                        </div>
                        <TrendingUp className="h-12 w-10 text-purple-600" />
                      </div>
                    </div>
                  </div>

                  {/* Insurance and Tax Information */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div className="p-4 bg-blue-50 rounded-lg border-blue-200">
                      <div className="flex items-center space-x-2 mb-2">
                        <Shield className="h-5 w-5 text-blue-600" />
                        <h4 className="font-medium text-blue-900">Forsikringsverdi</h4>
                      </div>
                      <div className="text-sm text-blue-700 space-y-1">
                        <div>Anbefalt forsikringssum: {((equipmentList || []).reduce((total, item) => total + (item.price || 0), 0) * 1.1).toLocaleString('nb-NO')} kr</div>
                        <div>Inkluderer 10% buffer for tilbehør og verdiøkning</div>
                      </div>
                    </div>
                    
                    <div className="p-4 bg-yellow-50 rounded-lg border-yellow-200">
                      <div className="flex items-center space-x-2 mb-2">
                        <FileText className="h-5 w-5 text-yellow-600" />
                        <h4 className="font-medium text-yellow-900">Skattefradrag</h4>
                      </div>
                      <div className="text-sm text-yellow-700 space-y-1">
                        <div>Avskrivbar verdi: {((equipmentList || []).reduce((total, item) => total + (item.price || 0), 0) * 0.8).toLocaleString('nb-NO')} kr</div>
                        <div>Basert på 80% av innkjøpspris over 3 år</div>
                      </div>
                    </div>
                  </div>
                </div>
              </CardContent>
            </Card>





          </TabsContent>

          <TabsContent value="value" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center">
                  <DollarSign className="h-5 w-5 mr-2 text-green-600" />
                  Total utstyr verdi
                </CardTitle>
                <CardDescription>
                  Beregnet markedsverdi av ditt utstyr basert på norske priser
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-6">
                  {/* Total Value Overview */}
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div className="p-6 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg border-green-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-green-800 font-semibold">Total verdi</div>
                          <div className="text-3xl font-bold text-green-900">
                            {(equipmentList || []).reduce((total, item) => total + (item.price || 0), 0).toLocaleString('nb-NO')} kr
                          </div>
                        </div>
                        <DollarSign className="h-12 w-10 text-green-600" />
                      </div>
                    </div>
                    
                    <div className="p-6 bg-gradient-to-r from-blue-50 to-cyan-50 rounded-lg border-blue-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-blue-800 font-semibold">Antall enheter</div>
                          <div className="text-3xl font-bold text-blue-900">{(equipmentList || []).length}</div>
                        </div>
                        <Camera className="h-12 w-10 text-blue-600" />
                      </div>
                    </div>
                    
                    <div className="p-6 bg-gradient-to-r from-purple-50 to-violet-50 rounded-lg border-purple-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-purple-800 font-semibold">Snittverdi</div>
                          <div className="text-3xl font-bold text-purple-900">
                            {(equipmentList || []).length > 0 
                              ? Math.round((equipmentList || []).reduce((total, item) => total + (item.price || 0), 0) / (equipmentList || []).length).toLocaleString('nb-NO')
                              : '0'
                            } kr
                          </div>
                        </div>
                        <TrendingUp className="h-12 w-10 text-purple-600" />
                      </div>
                    </div>
                  </div>

                  {/* Equipment Value Breakdown by Category */}
                  <div className="space-y-4">
                    <h3 className="text-lg font-semibold">Verdi per kategori</h3>
                    {Object.entries(equipmentCategories).map(([categoryKey, category]) => {
                      const categoryItems = (equipmentList || []).filter(item => item.category === categoryKey);
                      const categoryValue = categoryItems.reduce((total, item) => total + (item.price || 0), 0);
                      
                      if (categoryItems.length === 0) return null;
                      
                      return (
                        <div key={categoryKey} className="p-4 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-lg border-amber-200/50">
                          <div className="flex items-center justify-between mb-3">
                            <div className="flex items-center space-x-3">
                              <span className="text-2xl">{category.icon}</span>
                              <div>
                                <h4 className="font-medium">{category.name}</h4>
                                <p className="text-sm text-gray-600">{categoryItems.length} enheter</p>
                              </div>
                            </div>
                            <div className="text-right">
                              <div className="text-xl font-bold text-gray-800">
                                {(categoryValue || 0).toLocaleString('nb-NO')} kr
                              </div>
                              <div className="text-sm text-gray-500">
                                {((categoryValue / (equipmentList || []).reduce((total, item) => total + (item.price || 0), 0)) * 100).toFixed(1)}% av total
                              </div>
                            </div>
                          </div>
                          
                          {/* Individual items in category */}
                          <div className="space-y-2">
                            {categoryItems.map(item => (
                              <div key={item.id} className="flex items-center justify-between py-3 px-4 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg rounded-xl">
                                <div>
                                  <span className="font-medium">{item.name}</span>
                                  <span className="text-sm text-gray-600 ml-2">• {item.type}</span>
                                </div>
                                <span className="font-medium">{(item.price || 0).toLocaleString('nb-NO')} kr</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      );
                    })}
                  </div>

                  {/* Insurance and Tax Information */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div className="p-4 bg-blue-50 rounded-lg border-blue-200">
                      <div className="flex items-center space-x-2 mb-2">
                        <Shield className="h-5 w-5 text-blue-600" />
                        <h4 className="font-medium text-blue-900">Forsikringsverdi</h4>
                      </div>
                      <div className="text-sm text-blue-700 space-y-1">
                        <div>Anbefalt forsikringssum: {((equipmentList || []).reduce((total, item) => total + (item.price || 0), 0) * 1.1).toLocaleString('nb-NO')} kr</div>
                        <div>Inkluderer 10% buffer for tilbehør og verdiøkning</div>
                      </div>
                    </div>
                    
                    <div className="p-4 bg-yellow-50 rounded-lg border-yellow-200">
                      <div className="flex items-center space-x-2 mb-2">
                        <FileText className="h-5 w-5 text-yellow-600" />
                        <h4 className="font-medium text-yellow-900">Skattefradrag</h4>
                      </div>
                      <div className="text-sm text-yellow-700 space-y-1">
                        <div>Avskrivbar verdi: {((equipmentList || []).reduce((total, item) => total + (item.price || 0), 0) * 0.8).toLocaleString('nb-NO')} kr</div>
                        <div>Basert på 80% av innkjøpspris over 3 år</div>
                      </div>
                    </div>
                  </div>
                </div>
              </CardContent>
            </Card>

            {/* Price Tracking Section */}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center">
                  <BarChart3 className="h-5 w-5 mr-2 text-orange-600" />
                  Prissporing Norge
                </CardTitle>
                <CardDescription>Hold øye med utstyrspriser i Norge</CardDescription>
              </CardHeader>
              <CardContent>
                <PriceTracker />
              </CardContent>
            </Card>
          </TabsContent>

          <TabsContent value="firmware" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center">
                  <Cpu className="h-5 w-5 mr-2 text-blue-600" />
                  Firmware status
                </CardTitle>
                <CardDescription>
                  Overvåk og administrer firmware-oppdateringer for ditt utstyr
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-6">
                  {/* Firmware Status Overview */}
                  <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div className="p-4 bg-green-50 rounded-lg border-green-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-sm text-green-700">Oppdatert</div>
                          <div className="text-2xl font-bold text-green-900">
                            {firmwareUpdates.filter(f => f.status === 'up-to-date').length}
                          </div>
                        </div>
                        <CheckCircle className="h-8 w-8 text-green-600" />
                      </div>
                    </div>
                    
                    <div className="p-4 bg-orange-50 rounded-lg border-orange-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-sm text-orange-700">Oppdateringer</div>
                          <div className="text-2xl font-bold text-orange-900">
                            {firmwareUpdates.filter(f => f.status === 'available').length}
                          </div>
                        </div>
                        <AlertCircle className="h-8 w-8 text-orange-600" />
                      </div>
                    </div>
                    
                    <div className="p-4 bg-blue-50 rounded-lg border-blue-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-sm text-blue-700">Total utstyr</div>
                          <div className="text-2xl font-bold text-blue-900">{firmwareUpdates.length}</div>
                        </div>
                        <Camera className="h-8 w-8 text-blue-600" />
                      </div>
                    </div>
                    
                    <div className="p-4 bg-purple-50 rounded-lg border-purple-200">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-sm text-purple-700">Sist sjekket</div>
                          <div className="text-sm font-bold text-purple-900">
                            {new Date(lastFirmwareCheck).toLocaleDateString('nb-NO')}
                          </div>
                        </div>
                        <Clock className="h-8 w-8 text-purple-600" />
                      </div>
                    </div>
                  </div>

                  {/* Available Updates */}
                  {firmwareUpdates.filter(f => f.status === 'available').length > 0 && (
                    <div className="space-y-4">
                      <h3 className="text-lg font-semibold text-orange-800">Tilgjengelige oppdateringer</h3>
                      {firmwareUpdates.filter(f => f.status === 'available').map((firmware) => (
                        <div key={firmware.id} className="p-4 bg-orange-50 border-orange-200 rounded-lg">
                          <div className="flex items-center justify-between">
                            <div className="flex items-center space-x-4">
                              <div className="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center">
                                <span className="text-2xl">{equipmentCategories[firmware.category]?.icon || "📷"}</span>
                              </div>
                              <div>
                                <div className="flex items-center space-x-2">
                                  <h3 className="font-semibold text-orange-900">{firmware.device}</h3>
                                  <Badge className="bg-orange-100 text-orange-800">
                                    {firmware.currentVersion} → {firmware.latestVersion}
                                  </Badge>
                                </div>
                                <p className="text-sm text-orange-700">
                                  {equipmentCategories[firmware.category]?.name} • Utgitt: {firmware.releaseDate}
                                </p>
                                <p className="text-sm text-orange-600">
                                  Oppdateringstid: {getFirmwareComparisonDetails(firmware).updateTime} minutter
                                </p>
                              </div>
                            </div>
                            <div className="flex space-x-2">
                              <Button
                                variant="outline"
                                size="sm"
                                onClick={() => {
                                  setSelectedFirmware(firmware);
                                  setShowChangelogViewer(true);
                                }}
                                className="text-blue-600 hover:text-blue-700 hover:bg-blue-50"
                              >
                                <FileText className="h-5 w-5 mr-1" />
                                Se detaljer
                              </Button>
                              <Button
                                size="sm"
                                onClick={() => updateFirmware(firmware.id)}
                                className="bg-orange-600 hover:bg-orange-700 text-gray-800 dark:text-white"
                              >
                                <RefreshCw className="h-5 w-5 mr-1" />
                                Oppdater
                              </Button>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}

                  {/* Up-to-date Equipment */}
                  {firmwareUpdates.filter(f => f.status === 'up-to-date').length > 0 && (
                    <div className="space-y-4">
                      <h3 className="text-lg font-semibold text-green-800">Oppdatert utstyr</h3>
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {firmwareUpdates.filter(f => f.status === 'up-to-date').map((firmware) => (
                          <div key={firmware.id} className="p-4 bg-green-50 border-green-200 rounded-lg">
                            <div className="flex items-center space-x-3">
                              <span className="text-2xl">{equipmentCategories[firmware.category]?.icon || "📷"}</span>
                              <div className="flex-1">
                                <div className="flex items-center space-x-2">
                                  <h4 className="font-medium text-green-900">{firmware.device}</h4>
                                  <Badge className="bg-green-100 text-green-800 text-sm">
                                    <CheckCircle className="h-5 w-5 mr-1" />
                                    v{firmware.currentVersion}
                                  </Badge>
                                </div>
                                <p className="text-sm text-green-700">
                                  {equipmentCategories[firmware.category]?.name}
                                </p>
                                {firmware.updatedDate && (
                                  <p className="text-sm text-green-600">
                                    Oppdatert: {firmware.updatedDate}
                                  </p>
                                )}
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Firmware Notification Settings */}
                  <div className="p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg border-blue-200">
                    <div className="flex items-center justify-between">
                      <div>
                        <h5 className="font-semibold text-blue-900 flex items-center">
                          <Bell className="h-5 w-5 mr-2" />
                          Automatiske firmware-varsler
                        </h5>
                        <p className="text-sm text-blue-700 mt-1">
                          Få e-postvarsler når nye firmware-oppdateringer blir tilgjengelige
                        </p>
                        <div className="text-sm text-blue-600 mt-2">
                          Sist sjekket: {new Date(lastFirmwareCheck).toLocaleDateString('nb-NO')} • 
                          {firmwareNotifications ? ' Varsler aktivert' : ' Varsler deaktivert'}
                        </div>
                      </div>
                      <Button
                        variant={firmwareNotifications ? "default" : "outline"}
                        size="sm"
                        onClick={() => setFirmwareNotifications(!firmwareNotifications)}
                        className={firmwareNotifications 
                          ? "bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white" 
                          : "text-blue-600 hover:text-blue-700 hover:bg-blue-100"
                        }
                      >
                        <Bell className="h-5 w-5 mr-1" />
                        {firmwareNotifications ? '✓ Aktivert' : 'Aktiver varsler'}
                      </Button>
                    </div>
                  </div>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          <TabsContent value="updated" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center">
                  <CheckCircle className="h-5 w-5 mr-2 text-green-600" />
                  Oppdatert utstyr
                </CardTitle>
                <CardDescription>
                  Utstyr som har fått firmware-oppdateringer ({updatedEquipment.length} enheter)
                </CardDescription>
              </CardHeader>
              <CardContent>
                {updatedEquipment.length === 0 ? (
                  <div className="text-center py-8">
                    <CheckCircle className="h-12 w-12 text-gray-400 mx-auto mb-4" />
                    <h3 className="text-lg font-medium text-gray-800 mb-2">Ingen oppdateringer ennå</h3>
                    <p className="text-gray-600">
                      Utstyr som får firmware-oppdateringer vil vises her med detaljer om hva som ble forbedret.
                    </p>
                  </div>
                ) : (
                  <div className="space-y-4">
                    {updatedEquipment.map((item) => (
                      <div key={item.id} className="p-4 bg-green-50 border-green-200 rounded-lg">
                        <div className="flex items-center justify-between">
                          <div className="flex items-center space-x-4">
                            <div className="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                              <span className="text-2xl">{equipmentCategories[item.category]?.icon || "📷"}</span>
                            </div>
                            <div>
                              <div className="flex items-center space-x-2">
                                <h3 className="font-semibold text-green-900">{item.device}</h3>
                                <Badge className="bg-green-100 text-green-800">✓ Oppdatert</Badge>
                              </div>
                              <p className="text-sm text-green-700">
                                Oppdatert til versjon {item.currentVersion} • {item.updatedDate} kl. {item.updatedTime}
                              </p>
                              <p className="text-sm text-green-600">
                                {equipmentCategories[item.category]?.name} • Utgitt: {item.releaseDate}
                              </p>
                            </div>
                          </div>
                          <div className="flex space-x-2">
                            <Button
                              variant="outline"
                              size="sm"
                              onClick={() => {
                                setSelectedFirmware(item);
                                setShowChangelogViewer(true);
                              }}
                              className="text-green-600 hover:text-green-700 hover:bg-green-50 border-green-200 hover:border-green-300"
                            >
                              <FileText className="h-5 w-5 mr-1" />
                              Se endringer
                            </Button>
                          </div>
                        </div>
                        <div className="mt-3 pt-3 border-t border-green-200">
                          <div className="text-sm text-green-700">
                            <div className="font-medium mb-1">Viktigste forbedringer:</div>
                            <div className="space-y-1">
                              {getFirmwareComparisonDetails(item).newFeatures.slice(0, 2).map((feature, idx) => (
                                <div key={idx} className="flex items-center space-x-2">
                                  <span className="text-green-600">✨</span>
                                  <span>{feature}</span>
                                </div>
                              ))}
                            </div>
                          </div>
                        </div>
                      </div>
                    ))}
                    
                    <div className="mt-6 p-4 bg-blue-50 border-blue-200 rounded-lg">
                      <div className="flex items-center space-x-2 mb-2">
                        <CheckCircle className="h-5 w-5 text-blue-600" />
