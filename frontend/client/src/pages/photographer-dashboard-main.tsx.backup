                    <div>Selve utstyret påvirkes ikke. Du kan legge det til igjen senere via "Legg til utstyr".</div>
                  </div>
                </div>
              </div>
            </div>

            {/* Footer */}
            <div className="border-t p-4 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg rounded-b-xl">
