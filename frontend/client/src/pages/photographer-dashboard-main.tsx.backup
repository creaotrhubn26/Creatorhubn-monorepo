            <CreatorHubLogo size="lg" />
            <Button 
              onClick={() => setShowMaintenanceScheduler(false)}
              className="mt-4 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 hover:bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 text-gray-800 dark:text-white border-white/20"
            >
              ← Tilbake til dashboard
            </Button>
          </div>
          <React.Suspense fallback={<div className="text-center text-gray-800 dark:text-white">Laster vedlikeholdsplanlegger...</div>}>
            <EquipmentMaintenanceScheduler />
