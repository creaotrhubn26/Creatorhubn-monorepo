      {/* Universal Chat Widget */}
      <UniversalChatWidget 
        userType="photographer"
        projectId={selectedProject?.id}
        projectName={selectedProject?.name}
      />
      
      {/* Top Navigation Bar - Enhanced Responsive Premium Apple Liquid Glass */}
      <div className="bg-gradient-to-r from-white/95 to-amber-50/30 backdrop-blur-lg border-b border border-amber-200/50 shadow-lg sticky top-0 z-50">
        <div className="max-w-7xl mx-auto px-4 sm:px-4 lg:px-6 xl:px-8">
          <div className="flex flex-col lg:flex-row justify-between items-start lg:items-center py-3 sm:py-4 space-y-3 lg:space-y-0">
            <div className="flex items-center space-x-3 sm:space-x-4 min-w-0 w-full lg:w-auto">
              <div className="w-8 h-8 sm:w-10 sm:h-12 bg-gradient-to-r from-amber-500 to-orange-600 rounded-full flex items-center justify-center backdrop-blur-lg flex-shrink-0 shadow-lg">
                <CreatorHubLogo size="sm" />
              </div>
              <div className="min-w-0 flex-1 lg:flex-initial">
                <h1 className="text-lg sm:text-xl lg:text-2xl font-bold text-gray-800 truncate">CreatorHub Norge</h1>
                <p className="text-xs sm:text-sm text-gray-700 truncate">Profesjonell Fotografdashboard</p>
              </div>
