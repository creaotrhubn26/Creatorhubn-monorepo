      "DZOFilm Vespid 21mm T2.1": { current: "1.0", latest: "1.1", features: "Wide-angle correction, improved sharpness", releaseDate: "2025-01-16" },
      "DZOFilm PAVO 2x Anamorphic 40mm T2.1": { current: "1.0", latest: "1.1", features: "Anamorphic flare optimization, better coating", releaseDate: "2025-01-17" },
      "DZOFilm Pictor Zoom 20-55mm T2.8": { current: "1.0", latest: "1.1", features: "Parfocal improvements, zoom smoothness", releaseDate: "2025-01-18" },
      
      // SIGMA LENSES
