  // Interactive Firmware Changelog Viewer Component
  const FirmwareChangelogViewer = ({ firmware, onClose }) => {
    const details = getFirmwareComparisonDetails(firmware);
    const [activeChangelogTab, setActiveChangelogTab] = useState("overview");

    const getBeforeAfterComparison = (firmware) => {
      const comparisons = {
        "Canon EOS R5": {
          autofocus: {
            before: "Menneske Eye Detection kun",
            after: "Menneske + Dyre Eye Detection med AI-forbedringer",
            improvement: "40% mer nøyaktig gjenkjenning"
          },
          video: {
            before: "8K RAW (30fps, 20min opptak)",
            after: "8K RAW Light + normal (ubegrenset opptak)",
            improvement: "Ingen overoppheting, kontinuerlig opptak"
          },
          connectivity: {
            before: "Kun USB-C tethering",
            after: "Wireless tethering via app + USB-C",
            improvement: "Trådløs workflow, 15% raskere overføring"
          },
          battery: {
            before: "620 bilder per lading",
            after: "680 bilder per lading (+9%)",
            improvement: "Forbedret strømhåndtering i dvale-modus"
          }
        },
        "Sony A7R V": {
          processing: {
            before: "BIONZ XR prosessor (standard hastighet)",
            after: "BIONZ XR prosessor (50% raskere)",
            improvement: "Dobbelt så rask bildebehandling og buffer"
          },
          recognition: {
            before: "Menneske, dyr (hund/katt), fugl",
            after: "Menneske, dyr (15+ arter), fugl, insekt, fly",
            improvement: "AI gjenkjenner nå motorsport og ekstreme sports"
          },
          storage: {
            before: "CFexpress Type A (120MB/s skriving)",
            after: "CFexpress Type A (200MB/s skriving)",
            improvement: "67% raskere lagring, bedre kompatibilitet"
          },
          iso: {
            before: "Støyreduksjon opp til ISO 12800",
            after: "Forbedret støyreduksjon opp til ISO 25600",
            improvement: "2 stops bedre ytelse i lavt lys"
          }
        },
        "24-70mm f/2.8": {
          stabilization: {
            before: "IS Mode 1 & 2 (standard stabilisering)",
            after: "IS Mode 1, 2 & 3 (panning stabilisering)",
            improvement: "Perfekt for motorsport og bevegelse"
          },
          focus: {
            before: "Autofokus hastighet: 0.8 sekunder",
            after: "Autofokus hastighet: 0.5 sekunder",
            improvement: "35% raskere fokus, bedre tracking"
          },
          optical: {
            before: "Optisk kvalitet: god i hjørnene",
            after: "Optisk kvalitet: excellent i hjørnene",
            improvement: "Mindre vignetting og distorsjon"
          }
        }
      };

      return comparisons[firmware.device] || {};
    };

    const comparison = getBeforeAfterComparison(firmware);

    return (
      <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
        <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-xl shadow-2xl max-w-6xl w-full max-h-[90vh] overflow-hidden">
          {/* Header */}
          <div className="bg-gradient-to-r from-blue-600 to-indigo-600 text-gray-800 dark:text-white p-6">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-4">
                <span className="text-3xl">{equipmentCategories[firmware.category]?.icon || "📷"}</span>
                <div>
                  <h2 className="text-2xl font-bold">{firmware.device}</h2>
                  <p className="text-blue-100">
                    Firmware {firmware.currentVersion} → {firmware.latestVersion} • {firmware.releaseDate}
                  </p>
                </div>
              </div>
              <Button
                variant="ghost"
                size="sm"
                onClick={onClose}
                className="text-gray-800 dark:text-white hover:bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 "
              >
                ✕ Lukk
              </Button>
            </div>
          </div>

          {/* Navigation Tabs */}
          <div className="border-b">
            <div className="flex">
              {[
                { id: "overview", label: "📋 Oversikt", icon: "📋" },
                { id: "features", label: "✨ Nye funksjoner", icon: "✨" },
                { id: "improvements", label: "🚀 Forbedringer", icon: "🚀" },
                { id: "bugfixes", label: "🐛 Feilrettinger", icon: "🐛" },
                { id: "comparison", label: "⚖️ Før/Etter", icon: "⚖️" }
              ].map(tab => (
                <button
                  key={tab.id}
                  onClick={() => setActiveChangelogTab(tab.id)}
                  className="bg-white border rounded-lg p-4"
                >
                  {tab.label}
                </button>
              ))}
            </div>
          </div>

          {/* Content Area */}
          <div className="p-6 max-h-[60vh] overflow-y-auto">
            
            {/* Overview Tab */}
            {activeChangelogTab === "overview" && (
              <div className="space-y-6">
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div className="bg-green-50 p-4 rounded-lg border-green-200">
                    <div className="text-green-800 font-semibold">Nye funksjoner</div>
                    <div className="text-2xl font-bold text-green-900">{details.newFeatures.length}</div>
                  </div>
                  <div className="bg-blue-50 p-4 rounded-lg border-blue-200">
                    <div className="text-blue-800 font-semibold">Forbedringer</div>
                    <div className="text-2xl font-bold text-blue-900">{details.improvements.length}</div>
                  </div>
                  <div className="bg-purple-50 p-4 rounded-lg border-purple-200">
                    <div className="text-purple-800 font-semibold">Feilrettinger</div>
                    <div className="text-2xl font-bold text-purple-900">{details.bugFixes.length}</div>
                  </div>
                </div>

                <div className="bg-orange-50 p-4 rounded-lg border-orange-200">
                  <h3 className="font-semibold text-orange-900 mb-2">⚠️ Viktige oppdateringsdetaljer</h3>
                  <div className="text-sm text-orange-800 space-y-1">
                    <div>• Estimert oppdateringstid: {details.updateTime} minutter</div>
                    <div>• Minimum batterinivå: 50%</div>
                    <div>• Anbefalt å backup innstillinger først</div>
                    <div>• Test alle funksjoner etter oppdatering</div>
                  </div>
                </div>
              </div>
            )}

            {/* Features Tab */}
            {activeChangelogTab === "features" && (
              <div className="space-y-4">
                <h3 className="text-xl font-semibold text-green-800 mb-4">✨ Nye funksjoner i versjon {firmware.latestVersion}</h3>
                {details.newFeatures.map((feature, index) => (
                  <div key={index} className="bg-green-50 p-4 rounded-lg border-green-200 hover:bg-green-100 transition-colors">
                    <div className="flex items-start gap-3">
                      <span className="text-green-600 text-xl">✨</span>
                      <div>
                        <div className="font-medium text-green-900">{feature}</div>
                        <div className="text-sm text-green-700 mt-1">
                          {index === 0 && "Funksjonen forbedrer kreative muligheter betydelig"}
                          {index === 1 && "Profesjonell funksjon som sparer tid i arbeidsflyten"}
                          {index === 2 && "Avansert teknologi for bedre resultater"}
                          {index >= 3 && "Ytterligere forbedring for profesjonell bruk"}
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {/* Improvements Tab */}
            {activeChangelogTab === "improvements" && (
              <div className="space-y-4">
                <h3 className="text-xl font-semibold text-blue-800 mb-4">🚀 Ytelsesforbedringer</h3>
                {details.improvements.map((improvement, index) => (
                  <div key={index} className="bg-blue-50 p-4 rounded-lg border-blue-200 hover:bg-blue-100 transition-colors">
                    <div className="flex items-start gap-3">
                      <span className="text-blue-600 text-xl">🚀</span>
                      <div>
                        <div className="font-medium text-blue-900">{improvement}</div>
                        <div className="text-sm text-blue-700 mt-1">
                          Forbedret ytelse og brukeropplevelse
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {/* Bug Fixes Tab */}
            {activeChangelogTab === "bugfixes" && (
              <div className="space-y-4">
                <h3 className="text-xl font-semibold text-purple-800 mb-4">🐛 Løste problemer</h3>
                {details.bugFixes.map((fix, index) => (
                  <div key={index} className="bg-purple-50 p-4 rounded-lg border-purple-200 hover:bg-purple-100 transition-colors">
                    <div className="flex items-start gap-3">
                      <span className="text-purple-600 text-xl">🐛</span>
                      <div>
                        <div className="font-medium text-purple-900">{fix}</div>
                        <div className="text-sm text-purple-700 mt-1">
                          Problem rapportert av brukere og nå løst
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {/* Before/After Comparison Tab */}
            {activeChangelogTab === "comparison" && (
              <div className="space-y-6">
                <h3 className="text-xl font-semibold text-gray-800 mb-4">⚖️ Før og etter sammenligning</h3>
                {Object.entries(comparison).map(([category, data]) => (
                  <div key={category} className="bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg p-6 rounded-lg border">
                    <h4 className="font-semibold text-gray-800 mb-4 capitalize">
                      {category.replace(/([A-Z])/g, ' $1').trim()}
                    </h4>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div className="bg-red-50 p-4 rounded-lg border-red-200">
                        <div className="text-red-800 font-medium mb-2">❌ FØR ({firmware.currentVersion})</div>
                        <div className="text-red-700">{data.before}</div>
                      </div>
                      <div className="bg-green-50 p-4 rounded-lg border-green-200">
                        <div className="text-green-800 font-medium mb-2">✅ ETTER ({firmware.latestVersion})</div>
                        <div className="text-green-700">{data.after}</div>
                      </div>
                    </div>
                    <div className="mt-3 p-3 bg-blue-50 rounded-lg border-blue-200">
                      <div className="text-blue-800 font-medium">📈 Forbedring:</div>
                      <div className="text-blue-700">{data.improvement}</div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Footer Actions */}
          <div className="border-t p-4 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg">
            <div className="flex justify-between items-center">
              <div className="text-sm text-gray-600">
                Firmware-størrelse: ~{Math.floor(Math.random() * 200 + 50)}MB • 
                Nedlastingstid: ~{Math.floor(Math.random() * 5 + 2)} minutter
              </div>
              <div className="flex gap-3">
                <Button variant="outline" onClick={onClose}>
                  Lukk
                </Button>
                <Button 
                  onClick={() => {
                    onClose();
                    updateFirmware(firmware.id);
                  }}
                  className="bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white"
                >
                  <RefreshCw className="h-5 w-5 mr-2" />
                  Oppdater til {firmware.latestVersion}
                </Button>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  };

  const toggleFirmwareNotifications = () => {
    setFirmwareNotifications(!firmwareNotifications);
    toast({
      title: firmwareNotifications ? "Firmware-varsler deaktivert" : "Firmware-varsler aktivert",
      description: firmwareNotifications ? "Du får ikke lenger varsler om firmware-oppdateringer" : "Du får nå varsler om firmware-oppdateringer",
      duration: 2000,
    });
  };

  // Initialize firmware data when equipment list changes
  useEffect(() => {
    const firmwareData = generateFirmwareData(equipmentList);
    setFirmwareUpdates(firmwareData);
  }, [equipmentList]);

  // Keyboard shortcuts for quick actions
  useEffect(() => {
    const handleKeyDown = (e) => {
      // Ctrl/Cmd + K for quick actions
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        toast({
          title: "Hurtighandlinger",
          description: "Bruk Ctrl+N for nytt prosjekt, Ctrl+U for utstyr, Ctrl+C for klienter",
        });
      }
      // Ctrl/Cmd + N for new project
      if ((e.ctrlKey || e.metaKey) && e.key === 'n') {
        e.preventDefault();
        createProject();
      }
      // Ctrl/Cmd + U for equipment
      if ((e.ctrlKey || e.metaKey) && e.key === 'u') {
        e.preventDefault();
        setActiveTab('equipment');
      }
      // Ctrl/Cmd + C for clients
      if ((e.ctrlKey || e.metaKey) && e.key === 'c') {
        e.preventDefault();
        setShowClientManagement(true);
      }
      // Ctrl/Cmd + R for revenue
      if ((e.ctrlKey || e.metaKey) && e.key === 'r') {
        e.preventDefault();
        setShowRevenueManagement(true);
      }
      // Ctrl/Cmd + P for price calculator
      if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
        e.preventDefault();
        toast({
          title: "Priskalkulatoren",
          description: "Kalkulerer priser basert på prosjekttype og varighet",
        });
      }
      // Ctrl/Cmd + L for checklist
      if ((e.ctrlKey || e.metaKey) && e.key === 'l') {
        e.preventDefault();
        toast({
          title: "Fotosessjon sjekkliste",
          description: "Sjekkliste for utstyr og forberedelser opprettet",
        });
      }
      // Ctrl/Cmd + B for backup
      if ((e.ctrlKey || e.metaKey) && e.key === 'b') {
        e.preventDefault();
        toast({
          title: "Bildesikkerhetskopi",
          description: "Starter automatisk sikkerhetskopi til sky",
        });
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  // Enhanced project creation with backend integration
  const createProjectMutation = useMutation({
    mutationFn: async (projectData) => {
      return apiRequest('/api/photographer/project-quick-create', {
        method: 'POST',
        body: JSON.stringify(projectData)
      });
    },
    onSuccess: (data, variables) => {
      toast({
        title: "Prosjekt opprettet",
        description: `${variables.title} er lagt til`,
      });
      
      // Clear form and update local state
      setProjectName("");
      setProjectDate("");
      setProjectBudget("");
      setProjectDescription("");
      setShowCreateProjectDialog(false);
      
      // Invalidate projects query to refresh the list
      queryClient.invalidateQueries({ queryKey: ['/api/photographer/projects'] });
      
      // Auto-suggest equipment based on project type
      if (variables.title.toLowerCase().includes('bryllup')) {
        setTimeout(() => {
          setActiveTab('equipment');
          toast({
            title: "Utstyrforslag",
            description: "Sjekk anbefalte bryllupsutstyr i utstyrsfanen",
          });
        }, 1500);
      }
    },
    onError: (error) => {
      toast({
        title: "Feil ved opprettelse",
        description: "Kunne ikke opprette prosjekt. Prøv igjen.",
        variant: "destructive"
      });
    }
  });

  // Client creation mutation
  const createClientMutation = useMutation({
    mutationFn: async (clientData) => {
      return apiRequest('/api/photographer/clients', {
        method: 'POST',
        body: JSON.stringify(clientData)
      });
    },
    onSuccess: (data, variables) => {
      toast({
        title: "Klient lagt til",
        description: `${variables.name} er lagt til systemet`,
        duration: 3000,
      });
      
      // Clear form
      setClientName('');
      setClientEmail('');
      setClientPhone('');
      setClientCompany('');
      setIsAddingClient(false);
      
      // Invalidate and refetch clients
      queryClient.invalidateQueries({ queryKey: ['/api/photographer/clients'] });
    },
    onError: (error) => {
      toast({
        title: "Feil ved opprettelse",
        description: "Kunne ikke opprette klient. Prøv igjen.",
        variant: "destructive"
      });
    }
  });

  const submitProject = () => {
    if (projectName && projectDate && projectBudget) {
      const projectData = {
        title: projectName,
        description: projectDescription || "Nytt fotografiprosjekt",
        budget: parseInt(projectBudget.replace(/\D/g, '')),
        date: projectDate,
        status: "planning",
        type: projectName.toLowerCase().includes('bryllup') ? 'wedding' : 
              projectName.toLowerCase().includes('portrett') ? 'portrait' : 'general'
      };
      createProjectMutation.mutate(projectData);
      setShowCreateProjectDialog(false);
    } else {
      toast({
        title: "Manglende informasjon",
        description: "Fyll ut navn, dato og budsjett",
        variant: "destructive"
      });
    }
  };

  const createClient = () => {
    if (clientName && clientEmail) {
      const clientData = {
        name: clientName,
        email: clientEmail,
        phone: clientPhone || '',
        company: clientCompany || '',
        status: 'active'
      };
      
      createClientMutation.mutate(clientData);
    } else {
      toast({
        title: "Manglende informasjon",
        description: "Fyll ut navn og e-post",
        variant: "destructive"
      });
    }
  };

  const createGallery = () => {
    const clientName = prompt("Skriv inn klientnavn:");
    if (clientName) {
      const newGallery = {
        id: Date.now(),
        client: clientName,
        type: "Ny fotografering",
        photos: 0,
        status: "Opprettes"
      };
      setGalleries([...galleries, newGallery]);
      toast({
        title: "Galleri opprettet!",
        description: `Galleri opprettet for ${clientName}`,
        duration: 3000,
      });
    }
  };

  const createInvoice = () => {
    const clientName = prompt("Skriv inn klientnavn:");
    const amount = prompt("Skriv inn beløp (kr):");
    if (clientName && amount) {
      const newInvoice = {
        id: Date.now(),
        number: `INV-2025-${String(invoices.length + 1).padStart(3, '0')}`,
        client: clientName,
        amount: parseInt(amount),
        status: "Utkast"
      };
      setInvoices([...invoices, newInvoice]);
      toast({
        title: "Faktura opprettet!",
        description: `Faktura ${newInvoice.number} opprettet for ${clientName}`,
        duration: 3000,
      });
    }
  };

  // Enhanced Client Management Component
  const EnhancedClientManagement = () => {
    const [selectedClient, setSelectedClient] = useState(null);
    const [showCreateClient, setShowCreateClient] = useState(false);
    const [clientFilter, setClientFilter] = useState('all');
    const [searchTerm, setSearchTerm] = useState('');
    const [showAnalytics, setShowAnalytics] = useState(false);
    const [newClientData, setNewClientData] = useState({
      name: '',
      email: '',
      phone: '',
      company: '',
      clientType: '',
      notes: ''
    });

    // Fetch client data using React Query
    const { data: clientMetrics, isLoading: metricsLoading } = useQuery({
      queryKey: ['/api/photographer/client-metrics'],
      retry: false,
    });

    const { data: clientsData, isLoading: clientsLoading } = useQuery({
      queryKey: ['/api/photographer/clients', { status: clientFilter, search: searchTerm }],
      retry: false,
    });

    const { data: clientTypes } = useQuery({
      queryKey: ['/api/photographer/client-types'],
      retry: false,
    });

    const { data: recentActivity } = useQuery({
      queryKey: ['/api/photographer/recent-client-activity'],
      retry: false,
    });

    const { data: quickActions } = useQuery({
      queryKey: ['/api/photographer/client-quick-actions'],
      retry: false,
    });

    const clients = clientsData?.clients || [];
    const metrics = clientMetrics || {
      totalClients: 0,
      activeClients: 0,
      newThisMonth: 0,
      averageProjectValue: 0,
      atRiskClients: 0,
      highValueClients: 0
    };

    // Microsoft integration handler
    const handleMicrosoftIntegration = async (clientId) => {
      try {
        // Get Microsoft auth URL
        const response = await fetch('/api/microsoft/auth-url');
        const data = await response.json();
        
        if (data.success) {
          // Store client ID in session for callback
          sessionStorage.setItem('microsoftClientId', clientId);
          
          // Redirect to Microsoft OAuth
          window.location.href = data.authUrl;
        } else {
          toast({
            title: "Microsoft integrasjon feilet",
            description: "Kunne ikke starte Microsoft tilkobling",
            variant: "destructive"
          });
        }
      } catch (error) {
        console.error('Microsoft integration error:', error);
        toast({
          title: "Feil ved Microsoft integrasjon",
          description: "Kunne ikke koble til Microsoft tjenester",
          variant: "destructive"
        });
      }
    };

    // Form submission handler
    const handleCreateClient = async () => {
      if (!newClientData.name || !newClientData.email) {
        toast({
          title: "Feil",
          description: "Navn og e-post er påkrevd",
          variant: "destructive"
        });
        return;
      }
      
      try {
        toast({
          title: "Klient opprettet!",
          description: `${newClientData.name} er lagt til i systemet`,
        });
        
        // Reset form and close modal
        setNewClientData({
          name: '',
          email: '',
          phone: '',
          company: '',
          clientType: '',
          notes: ''
        });
        setShowCreateClient(false);
        
        // Refresh client list
        queryClient.invalidateQueries({ queryKey: ['/api/photographer/clients'] });
        queryClient.invalidateQueries({ queryKey: ['/api/photographer/client-metrics'] });
        
      } catch (error) {
        toast({
          title: "Feil",
          description: "Kunne ikke opprette klient",
          variant: "destructive"
        });
      }
    };

    // Filter clients based on search term
    const filteredClients = clients.filter(client => {
      const matchesSearch = client.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||
                           client.email?.toLowerCase().includes(searchTerm.toLowerCase()) ||
                           client.company?.toLowerCase().includes(searchTerm.toLowerCase());
      
      if (clientFilter === 'all') return matchesSearch;
      if (clientFilter === 'active') return matchesSearch && client.status === 'active';
      if (clientFilter === 'inactive') return matchesSearch && client.status === 'inactive';
      if (clientFilter === 'prospect') return matchesSearch && client.status === 'prospect';
      
      return matchesSearch;
    });

    return (
      <div className="space-y-6">
        {/* Client Metrics Dashboard */}
        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          <div className="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-xl">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm font-medium text-blue-600 dark:text-blue-400">Totale klienter</p>
                <p className="text-2xl font-bold text-blue-700 dark:text-blue-300">
                  {metricsLoading ? '...' : metrics.totalClients}
                </p>
              </div>
              <Users className="h-6 w-6 text-blue-500" />
            </div>
          </div>

          <div className="bg-green-50 dark:bg-green-900/20 p-4 rounded-xl">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm font-medium text-green-600 dark:text-green-400">Aktive</p>
                <p className="text-2xl font-bold text-green-700 dark:text-green-300">
                  {metricsLoading ? '...' : metrics.activeClients}
                </p>
              </div>
              <UserCheck className="h-6 w-6 text-green-500" />
            </div>
          </div>

          <div className="bg-amber-50 dark:bg-amber-900/20 p-4 rounded-xl">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm font-medium text-amber-600 dark:text-amber-400">Nye (måned)</p>
                <p className="text-2xl font-bold text-amber-700 dark:text-amber-300">
                  {metricsLoading ? '...' : metrics.newThisMonth}
                </p>
              </div>
              <Calendar className="h-6 w-6 text-amber-500" />
            </div>
          </div>

          <div className="bg-purple-50 dark:bg-purple-900/20 p-4 rounded-xl">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm font-medium text-purple-600 dark:text-purple-400">Snitt verdi</p>
                <p className="text-lg font-bold text-purple-700 dark:text-purple-300">
                  {metricsLoading ? '...' : `${metrics.averageProjectValue} NOK`}
                </p>
              </div>
              <TrendingUp className="h-6 w-6 text-purple-500" />
            </div>
          </div>

          <div className="bg-red-50 dark:bg-red-900/20 p-4 rounded-xl">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm font-medium text-red-600 dark:text-red-400">Risiko</p>
                <p className="text-2xl font-bold text-red-700 dark:text-red-300">
                  {metricsLoading ? '...' : metrics.atRiskClients}
                </p>
              </div>
              <AlertCircle className="h-6 w-6 text-red-500" />
            </div>
          </div>

          <div className="bg-indigo-50 dark:bg-indigo-900/20 p-4 rounded-xl">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm font-medium text-indigo-600 dark:text-indigo-400">Høyverdi</p>
                <p className="text-2xl font-bold text-indigo-700 dark:text-indigo-300">
                  {metricsLoading ? '...' : metrics.highValueClients}
                </p>
              </div>
              <TrendingUp className="h-6 w-6 text-indigo-500" />
            </div>
          </div>
        </div>

        {/* Client Management Actions */}
        <div className="flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
          <div className="flex gap-2">
            <Button 
              onClick={() => setShowCreateClient(true)}
              className="bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white"
            >
              <UserPlus className="h-4 w-4 mr-2" />
              Ny klient
            </Button>
            <Button variant="outline" onClick={() => setShowAnalytics(true)}>
              <BarChart3 className="h-4 w-4 mr-2" />
              Detaljert analyse
            </Button>
          </div>
          
          <div className="flex gap-2 w-full sm:w-auto">
            <Input
              placeholder="Søk klienter..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full sm:w-64"
            />
            <Select value={clientFilter} onValueChange={setClientFilter}>
              <SelectTrigger className="w-32">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">Alle</SelectItem>
                <SelectItem value="active">Aktive</SelectItem>
                <SelectItem value="inactive">Inaktive</SelectItem>
                <SelectItem value="prospect">Prospekter</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>

        {/* Client Types Overview */}
        {clientTypes && (
          <div className="bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:bg-gray-800/50 p-4 rounded-xl">
            <h4 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white mb-3">Klienttyper</h4>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
              {clientTypes.map((type) => (
                <div key={type.id} className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-700 p-3 rounded-lg text-center">
                  <div className="h-6 w-6 mx-auto mb-1" style={{ color: type.color }}>
                    {type.icon === 'User' && <User className="h-6 w-6" />}
                    {type.icon === 'Building' && <Building className="h-6 w-6" />}
                    {type.icon === 'Heart' && <Heart className="h-6 w-6" />}
                    {type.icon === 'Camera' && <Camera className="h-6 w-6" />}
                  </div>
                  <p className="text-sm font-medium text-gray-800 dark:text-gray-800 dark:text-white">{type.displayName}</p>
                  <p className="text-lg font-bold" style={{ color: type.color }}>0</p>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Client List */}
        <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-800 rounded-xl p-4">
          <div className="flex items-center justify-between mb-4">
            <h4 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white">Klientliste</h4>
            <Badge variant="secondary">{filteredClients.length} klienter</Badge>
          </div>
          
          {clientsLoading ? (
            <div className="space-y-3">
              {[...Array(3)].map((_, i) => (
                <div key={i} className="h-16 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg dark:bg-gray-700 rounded-lg animate-pulse"></div>
              ))}
            </div>
          ) : filteredClients.length === 0 ? (
            <div className="text-center py-8">
              <Users className="h-12 w-12 text-gray-400 mx-auto mb-4" />
              <h3 className="text-lg font-medium text-gray-800 dark:text-gray-800 dark:text-white mb-2">Ingen klienter enda</h3>
              <p className="text-gray-500 dark:text-gray-400 mb-4">
                Begynn å bygge din klientbase ved å legge til din første klient.
              </p>
              <Button onClick={() => setShowCreateClient(true)}>
                <UserPlus className="h-4 w-4 mr-2" />
                Legg til første klient
              </Button>
            </div>
          ) : (
            <div className="space-y-3">
              {filteredClients.map((client) => (
                <div 
                  key={client.id} 
                  className="p-4 border-amber-200/50 dark:border-gray-700 rounded-lg hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:hover:bg-gray-700/50 cursor-pointer transition-colors"
                  onClick={() => setSelectedClient(client)}
                >
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-12 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center">
                        <User className="h-5 w-5 text-blue-600 dark:text-blue-400" />
                      </div>
                      <div>
                        <h5 className="font-medium text-gray-800 dark:text-gray-800 dark:text-white">{client.name}</h5>
                        <p className="text-sm text-gray-500 dark:text-gray-400">{client.email}</p>
                      </div>
                    </div>
                    <div className="text-right">
                      <div className="flex items-center justify-end gap-2 mb-1">
                        <p className="text-sm font-medium text-gray-800 dark:text-gray-800 dark:text-white">
                          {client.totalRevenue ? `${client.totalRevenue} NOK` : 'Ny klient'}
                        </p>
                        {client.microsoftConnected && (
                          <div className="w-5 h-5 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center">
                            <svg className="h-3 w-3 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M0 0h11.377v11.372H0V0zm12.623 0H24v11.372H12.623V0zM0 12.623h11.377V24H0V12.623zm12.623 0H24V24H12.623V12.623z"/>
                            </svg>
                          </div>
                        )}
                      </div>
                      <p className="text-xs text-gray-500 dark:text-gray-400">
                        {client.totalProjects || 0} prosjekter
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Quick Actions for Client Management */}
        {quickActions && quickActions.length > 0 && (
          <div className="bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 p-4 rounded-xl">
            <h4 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white mb-3">Anbefalte handlinger</h4>
            <div className="space-y-3">
              {quickActions.map((action) => (
                <div key={action.id} className="flex items-center justify-between p-3 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-700 rounded-lg">
                  <div className="flex items-center gap-3">
                    <div className="w-8 h-8 rounded-full flex items-center justify-center bg-blue-100 text-blue-600">
                      {action.type === 'follow_up' && <Clock className="h-4 w-4" />}
                      {action.type === 'satisfaction' && <CheckCircle className="h-4 w-4" />}
                      {action.type === 'contact' && <Mail className="h-4 w-4" />}
                    </div>
                    <div>
                      <p className="font-medium text-gray-800 dark:text-gray-800 dark:text-white">{action.title}</p>
                      <p className="text-sm text-gray-500 dark:text-gray-400">{action.description}</p>
                    </div>
                  </div>
                  <Button size="sm" variant="outline">
                    Handle
                  </Button>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Recent Activity */}
        {recentActivity && recentActivity.length > 0 && (
          <div className="bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:bg-gray-800/50 p-4 rounded-xl">
            <h4 className="text-lg font-semibold text-gray-800 dark:text-gray-800 dark:text-white mb-3">Nylig aktivitet</h4>
            <div className="space-y-3">
              {recentActivity.map((activity, index) => (
                <div key={index} className="flex items-center gap-3 p-3 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-700 rounded-lg">
                  <div className="w-8 h-8 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center">
                    <Mail className="h-4 w-4 text-blue-600 dark:text-blue-400" />
                  </div>
                  <div className="flex-1">
                    <p className="text-sm font-medium text-gray-800 dark:text-gray-800 dark:text-white">{activity.description}</p>
                    <p className="text-xs text-gray-500 dark:text-gray-400">{activity.timestamp}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Client Creation Modal */}
        {showCreateClient && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-800 rounded-xl p-6 w-full max-w-2xl mx-4">
              <div className="flex items-center justify-between mb-6">
                <h3 className="text-xl font-semibold text-gray-800 dark:text-gray-800 dark:text-white">Opprett ny klient</h3>
                <Button variant="outline" size="sm" onClick={() => setShowCreateClient(false)}>
                  <X className="h-4 w-4" />
                </Button>
              </div>
              
              <div className="space-y-4">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                      Navn *
                    </label>
                    <Input 
                      placeholder="Klientens navn" 
                      value={newClientData.name}
                      onChange={(e) => setNewClientData({...newClientData, name: e.target.value})}
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                      E-post *
                    </label>
                    <Input 
                      type="email" 
                      placeholder="epost@example.com" 
                      value={newClientData.email}
                      onChange={(e) => setNewClientData({...newClientData, email: e.target.value})}
                    />
                  </div>
                </div>
                
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                      Telefon
                    </label>
                    <Input 
                      placeholder="+47 123 45 678" 
                      value={newClientData.phone}
                      onChange={(e) => setNewClientData({...newClientData, phone: e.target.value})}
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                      Firma
                    </label>
                    <Input 
                      placeholder="Firmanavn (valgfritt)" 
                      value={newClientData.company}
                      onChange={(e) => setNewClientData({...newClientData, company: e.target.value})}
                    />
                  </div>
                </div>
                
                <div>
                  <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Klienttype
                  </label>
                  <Select value={newClientData.clientType} onValueChange={(value) => setNewClientData({...newClientData, clientType: value})}>
                    <SelectTrigger>
                      <SelectValue placeholder="Velg klienttype" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="individual">Privatkunde</SelectItem>
                      <SelectItem value="business">Bedriftskunde</SelectItem>
                      <SelectItem value="wedding">Bryllupskunde</SelectItem>
                      <SelectItem value="event">Arrangementskunde</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
                
                <div>
                  <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Notater
                  </label>
                  <Textarea 
                    placeholder="Tilleggsnotater om klienten..." 
                    value={newClientData.notes}
                    onChange={(e) => setNewClientData({...newClientData, notes: e.target.value})}
                  />
                </div>
                
                <div className="flex justify-end gap-3 pt-4">
                  <Button variant="outline" onClick={() => setShowCreateClient(false)}>
                    Avbryt
                  </Button>
                  <Button 
                    className="bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white"
                    onClick={handleCreateClient}
                  >
                    <UserPlus className="h-4 w-4 mr-2" />
                    Opprett klient
                  </Button>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Client Detail Modal */}
        {selectedClient && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-800 rounded-xl p-6 w-full max-w-4xl mx-4 max-h-[90vh] overflow-y-auto">
              <div className="flex items-center justify-between mb-6">
                <div className="flex items-center gap-3">
                  <div className="w-12 h-12 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center">
                    <User className="h-6 w-6 text-blue-600 dark:text-blue-400" />
                  </div>
                  <div>
                    <h3 className="text-xl font-semibold text-gray-800 dark:text-gray-800 dark:text-white">{selectedClient.name}</h3>
                    <p className="text-gray-500 dark:text-gray-400">{selectedClient.email}</p>
                  </div>
                </div>
                <Button variant="outline" size="sm" onClick={() => setSelectedClient(null)}>
                  <X className="h-4 w-4" />
                </Button>
              </div>
              
              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div className="lg:col-span-2 space-y-6">
                  <div className="bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:bg-gray-700/50 p-4 rounded-lg">
                    <h4 className="font-medium text-gray-800 dark:text-gray-800 dark:text-white mb-3">Kontaktinformasjon</h4>
                    <div className="space-y-2 text-sm">
                      <div className="flex items-center gap-2">
                        <Mail className="h-4 w-4 text-gray-400" />
                        <span>{selectedClient.email}</span>
                      </div>
                      {selectedClient.phone && (
                        <div className="flex items-center gap-2">
                          <Phone className="h-4 w-4 text-gray-400" />
                          <span>{selectedClient.phone}</span>
                        </div>
                      )}
                      {selectedClient.company && (
                        <div className="flex items-center gap-2">
                          <Building className="h-4 w-4 text-gray-400" />
                          <span>{selectedClient.company}</span>
                        </div>
                      )}
                    </div>
                  </div>
                  
                  <div className="bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:bg-gray-700/50 p-4 rounded-lg">
                    <h4 className="font-medium text-gray-800 dark:text-gray-800 dark:text-white mb-3">Prosjekthistorikk</h4>
                    <p className="text-sm text-gray-500 dark:text-gray-400">
                      {selectedClient.totalProjects || 0} prosjekter totalt
                    </p>
                  </div>
                </div>
                
                <div className="space-y-4">
                  <div className="bg-green-50 dark:bg-green-900/20 p-4 rounded-lg">
                    <h4 className="font-medium text-green-700 dark:text-green-300 mb-2">Total omsetning</h4>
                    <p className="text-2xl font-bold text-green-800 dark:text-green-200">
                      {selectedClient.totalRevenue || 0} NOK
                    </p>
                  </div>
                  
                  <div className="space-y-2">
                    <Button className="w-full" variant="outline">
                      <Edit3 className="h-4 w-4 mr-2" />
                      Rediger klient
                    </Button>
                    <Button className="w-full" variant="outline">
                      <FileText className="h-4 w-4 mr-2" />
                      Nytt prosjekt
                    </Button>
                    <Button className="w-full" variant="outline">
                      <Mail className="h-4 w-4 mr-2" />
                      Send e-post
                    </Button>
                    <Button 
                      className="w-full bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white"
                      onClick={() => handleMicrosoftIntegration(selectedClient.id)}
                    >
                      <svg className="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M0 0h11.377v11.372H0V0zm12.623 0H24v11.372H12.623V0zM0 12.623h11.377V24H0V12.623zm12.623 0H24V24H12.623V12.623z"/>
                      </svg>
                      Koble til Microsoft
                    </Button>
                    
                    {/* Microsoft Integration Status */}
                    {selectedClient.microsoftConnected && (
                      <div className="mt-4 p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
                        <h5 className="font-medium text-blue-700 dark:text-blue-300 mb-2">Microsoft integrasjon aktiv</h5>
                        <div className="space-y-2 text-sm">
                          <div className="flex items-center gap-2">
                            <CheckCircle className="h-4 w-4 text-green-600" />
                            <span>OneDrive tilgang</span>
                          </div>
                          <div className="flex items-center gap-2">
                            <CheckCircle className="h-4 w-4 text-green-600" />
                            <span>Office 365 samarbeid</span>
                          </div>
                          <div className="flex items-center gap-2">
                            <CheckCircle className="h-4 w-4 text-green-600" />
                            <span>Outlook kontakt sync</span>
                          </div>
                        </div>
                        <div className="mt-3 space-y-1">
                          <Button size="sm" variant="outline" className="w-full">
                            <FolderOpen className="h-4 w-4 mr-2" />
                            Åpne OneDrive mappe
                          </Button>
                          <Button size="sm" variant="outline" className="w-full">
                            <Share2 className="h-4 w-4 mr-2" />
                            Del prosjektfiler
                          </Button>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Analytics Modal */}
        {showAnalytics && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-800 rounded-xl p-6 w-full max-w-4xl mx-4 max-h-[90vh] overflow-y-auto">
              <div className="flex items-center justify-between mb-6">
                <h3 className="text-xl font-semibold text-gray-800 dark:text-gray-800 dark:text-white">Detaljert klientanalyse</h3>
                <Button variant="outline" size="sm" onClick={() => setShowAnalytics(false)}>
                  <X className="h-4 w-4" />
                </Button>
              </div>
              
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg">
                  <h4 className="font-medium text-blue-900 dark:text-blue-100 mb-2">Kundelojalitet</h4>
                  <p className="text-2xl font-bold text-blue-600 dark:text-blue-400">
                    {Math.round(metrics.totalClients * 0.73)}%
                  </p>
                  <p className="text-sm text-blue-700 dark:text-blue-300">
                    Gjennomsnittlig gjentagelsesrate
                  </p>
                </div>
                
                <div className="bg-green-50 dark:bg-green-900/20 p-4 rounded-lg">
                  <h4 className="font-medium text-green-900 dark:text-green-100 mb-2">Månedlig vekst</h4>
                  <p className="text-2xl font-bold text-green-600 dark:text-green-400">
                    +{Math.round(metrics.newThisMonth * 1.2)}%
                  </p>
                  <p className="text-sm text-green-700 dark:text-green-300">
                    Sammenligning med forrige måned
                  </p>
                </div>
                
                <div className="bg-purple-50 dark:bg-purple-900/20 p-4 rounded-lg">
                  <h4 className="font-medium text-purple-900 dark:text-purple-100 mb-2">Konverteringsrate</h4>
                  <p className="text-2xl font-bold text-purple-600 dark:text-purple-400">
                    {Math.round((metrics.activeClients / Math.max(metrics.totalClients, 1)) * 100)}%
                  </p>
                  <p className="text-sm text-purple-700 dark:text-purple-300">
                    Prospekter til aktive kunder
                  </p>
                </div>
                
                <div className="bg-orange-50 dark:bg-orange-900/20 p-4 rounded-lg">
                  <h4 className="font-medium text-orange-900 dark:text-orange-100 mb-2">Gjennomsnittlig ordre</h4>
                  <p className="text-2xl font-bold text-orange-600 dark:text-orange-400">
                    {metrics.averageProjectValue} NOK
                  </p>
                  <p className="text-sm text-orange-700 dark:text-orange-300">
                    Per prosjekt inkludert mva
                  </p>
                </div>
              </div>
              
              <div className="mt-6 p-4 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg dark:bg-gray-700/50 rounded-lg">
                <h4 className="font-medium text-gray-800 dark:text-gray-800 dark:text-white mb-3">Anbefalinger</h4>
                <ul className="space-y-2 text-sm text-gray-600 dark:text-gray-400">
                  <li>• Fokuser på risikokunder for å forbedre kundelojalitet</li>
                  <li>• Utvid høyverdi-tjenester basert på suksessrate</li>
                  <li>• Implementer oppfølgingsrutiner for inaktive kunder</li>
                  <li>• Vurder prisjusteringer basert på markedsdata</li>
                </ul>
              </div>
            </div>
          </div>
        )}
      </div>
    );
  };

  const quickActions = {
    newClient: () => {
      toast({
        title: "Ny klient",
        description: "Åpner klientskjema for ny registrering",
        duration: 2000,
      });
      setSelectedBusinessCategory('information');
      setActiveTab("kunder");
    },
    bookAppointment: () => {
      toast({
        title: "Booking",
        description: "Åpner kalender for ny avtale",
        duration: 2000,
      });
      setSelectedBusinessCategory('core-business');
      setActiveTab("dashboard");
    },
    uploadPhotos: () => {
      toast({
        title: "Opplasting",
        description: "Åpner filvelger for foto-opplasting",
        duration: 2000,
      });
      setSelectedBusinessCategory('core-business');
      setActiveTab("delivery");
    },
    sendGallery: () => {
      toast({
        title: "Galleri",
        description: "Genererer delingslink for galleri",
        duration: 2000,
      });
      setSelectedBusinessCategory('core-business');
      setActiveTab("delivery");
    },
    generateInvoice: () => createInvoice()
  };

  // Built-in Professional Photography Tools
  // Gamified Streak Tracker Component
  const StreakTracker = () => (
    <div className="space-y-6">
      {/* Level and XP Progress */}
      <Card className="bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-purple-900/30 dark:to-indigo-900/30 backdrop-blur-xl border-purple-200/30">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <span className="text-2xl">🎯</span>
            <span className="text-orange-900 dark:text-orange-100">Vedlikeholds-Champion</span>
            <Badge className="bg-purple-100 text-purple-800 ml-2">Nivå {streakData.level}</Badge>
          </CardTitle>
          <CardDescription className="text-orange-700 dark:text-orange-300">
            Hold utstyret ditt i toppform og oppnå prestasjonsmål!
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-4">
          {/* XP Progress Bar */}
          <div className="space-y-2">
            <div className="flex justify-between text-sm">
              <span className="text-purple-700 dark:text-purple-300">XP Fremgang</span>
              <span className="text-purple-800 dark:text-purple-200 font-semibold">
                {streakData.xp} / {streakData.xpToNextLevel} XP
              </span>
            </div>
            <Progress 
              value={(streakData.xp / streakData.xpToNextLevel) * 100} 
              className="h-5 bg-purple-100 dark:bg-purple-900"
            />
            <p className="text-sm text-purple-600 dark:text-purple-400">
              {streakData.xpToNextLevel - streakData.xp} XP til neste nivå
            </p>
          </div>

          {/* Streak Stats Grid */}
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-800/60 backdrop-blur-lg rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-orange-600 dark:text-orange-400">
                {streakData.currentStreak}
              </div>
              <div className="text-sm text-gray-600 dark:text-gray-400">Gjeldende streak</div>
            </div>
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-800/60 backdrop-blur-lg rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-green-600 dark:text-green-400">
                {streakData.longestStreak}
              </div>
              <div className="text-sm text-gray-600 dark:text-gray-400">Lengste streak</div>
            </div>
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-800/60 backdrop-blur-lg rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-blue-600 dark:text-blue-400">
                {streakData.thisWeekActions}/{streakData.weeklyGoal}
              </div>
              <div className="text-sm text-gray-600 dark:text-gray-400">Ukemål</div>
            </div>
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-800/60 backdrop-blur-lg rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-purple-600 dark:text-purple-400">
                {streakData.totalMaintenanceActions}
              </div>
              <div className="text-sm text-gray-600 dark:text-gray-400">Total handlinger</div>
            </div>
          </div>

          {/* Real Business Action Buttons */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
            <Button 
              onClick={() => handleBusinessAction('complete_project')}
              className="bg-gradient-to-r from-green-500 to-emerald-500 hover:from-green-600 hover:to-emerald-600 text-gray-800 dark:text-white shadow-lg transition-colors duration-300 hover:shadow-xl"
            >
              <span className="mr-2">📸</span>
              Gå til Prosjekter (+100 XP)
            </Button>
            <Button 
              onClick={() => handleBusinessAction('send_invoice')}
              className="bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-600 hover:to-cyan-600 text-gray-800 dark:text-white shadow-lg transition-colors duration-300 hover:shadow-xl"
            >
              <span className="mr-2">💰</span>
              Gå til Fakturaer (+75 XP)
            </Button>
            <Button 
              onClick={() => handleBusinessAction('deliver_photos')}
              className="bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600 text-gray-800 dark:text-white shadow-lg transition-colors duration-300 hover:shadow-xl"
            >
              <span className="mr-2">📷</span>
              Gå til Leveranse (+60 XP)
            </Button>
            <Button 
              onClick={() => handleBusinessAction('update_equipment')}
              className="bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-gray-800 dark:text-white shadow-lg transition-colors duration-300 hover:shadow-xl"
            >
              <span className="mr-2">⚙️</span>
              Gå til Utstyr (+50 XP)
            </Button>
          </div>
        </CardContent>
      </Card>

      {/* Achievement Gallery */}
      <Card className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-900/70 backdrop-blur-xl border-white/30">
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-orange-900 dark:text-orange-100">
            <span className="text-2xl">🏆</span>
            Prestasjonsgalleri
          </CardTitle>
          <CardDescription className="text-orange-700 dark:text-orange-300">
            Lås opp merker ved å vedlikeholde utstyret ditt
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {achievements.map((achievement) => (
              <div
                key={achievement.id}
                className="p-4 rounded-lg border-2 transition-colors bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg border-amber-200/50"
              >
                <div className="flex items-start gap-3">
                  <div className="text-3xl grayscale">
                    {achievement.icon}
                  </div>
                  <div className="flex-1">
                    <h3 className="font-semibold text-gray-600">
                      {achievement.name}
                    </h3>
                    <p className="text-sm text-gray-500">
                      {achievement.description}
                    </p>
                    
                    {achievement.unlocked ? (
                      <Badge className="mt-2 bg-yellow-100 text-yellow-800">
                        Låst opp {achievement.unlockedDate}
                      </Badge>
                    ) : achievement.progress !== undefined ? (
                      <div className="mt-2 space-y-1">
                        <div className="flex justify-between text-sm">
                          <span>Fremgang</span>
                          <span>{achievement.progress}/{achievement.target}</span>
                        </div>
                        <Progress 
                          value={(achievement.progress / achievement.target) * 100} 
                          className="h-5"
                        />
                      </div>
                    ) : (
                      <Badge className="mt-2 bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg text-gray-600">
                        Ikke låst opp
                      </Badge>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </CardContent>
      </Card>

      {/* Weekly Challenge */}
      <Card className="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/30 dark:to-emerald-900/30 backdrop-blur-xl border-green-200/30">
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-orange-900 dark:text-orange-100">
            <span className="text-2xl">📅</span>
            Ukeutfordring
          </CardTitle>
        </CardHeader>
        <CardContent>
          <div className="space-y-3">
            <div className="flex justify-between items-center">
              <span className="text-green-700 dark:text-green-300">Vedlikehold {streakData.weeklyGoal} ganger denne uken</span>
              <Badge className={`${
                streakData.thisWeekActions >= streakData.weeklyGoal 
                  ? 'bg-green-100 text-green-800' 
                  : 'bg-orange-100 text-orange-800'
              }`}>
                {streakData.thisWeekActions}/{streakData.weeklyGoal}
              </Badge>
            </div>
            <Progress 
              value={(streakData.thisWeekActions / streakData.weeklyGoal) * 100} 
              className="h-5 bg-green-100 dark:bg-green-900"
            />
            {streakData.thisWeekActions >= streakData.weeklyGoal ? (
              <p className="text-sm text-green-600 dark:text-green-400 font-semibold">
                🎉 Ukemål fullført! Fortsett den gode vanen.
              </p>
            ) : (
              <p className="text-sm text-green-600 dark:text-green-400">
                {streakData.weeklyGoal - streakData.thisWeekActions} vedlikehold igjen for å fullføre ukemålet
              </p>
            )}
          </div>
        </CardContent>
      </Card>

      {/* Real Business Dashboard Integration - Apple Liquid Glass */}
      <div className="bg-gradient-to-br from-orange-50 to-red-50 dark:from-orange-900/30 dark:to-red-900/30 backdrop-blur-xl border-orange-200/30 rounded-xl shadow-lg">
        <div className="p-6">
          <div className="flex items-center mb-6">
            <div className="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-4">
              <TrendingUp className="h-6 w-6 text-orange-600" />
            </div>
            <div>
              <h2 className="text-xl font-bold text-orange-900 dark:text-orange-100">Forretningsstatistikk</h2>
              <p className="text-orange-700 dark:text-orange-300 text-sm">Viktige nøkkeltall for din fotografvirksomhet</p>
            </div>
          </div>
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div 
              className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-800/60 backdrop-blur-xl rounded-xl p-4 text-center cursor-pointer hover:bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:hover:bg-gray-700/60 transition-colors duration-300 hover:scale-[1.02] hover:shadow-lg border-white/20"
              onClick={() => setShowClientManagement(true)}
            >
              <div className="text-2xl font-bold text-green-600 dark:text-green-400">
                {businessStats.totalClients}
              </div>
              <div className="text-sm text-gray-600 dark:text-gray-400 mt-1">Totale klienter</div>
              <div className="text-sm text-green-600 mb-2">
                {businessStats.totalClients === 0 ? 'Start med din første' : `+${businessStats.newClientsThisMonth} denne måneden`}
              </div>
              <div className="text-sm text-orange-600 dark:text-orange-400 font-medium">👆 Klikk for å administrere</div>
            </div>
            <div 
              className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-800/60 backdrop-blur-xl rounded-xl p-4 text-center cursor-pointer hover:bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:hover:bg-gray-700/60 transition-colors duration-300 hover:scale-[1.02] hover:shadow-lg border-white/20"
              onClick={() => setShowProjectManagement(true)}
            >
              <div className="text-2xl font-bold text-blue-600 dark:text-blue-400">
                {businessStats.activeProjects}
              </div>
              <div className="text-sm text-gray-600 dark:text-gray-400 mt-1">Aktive prosjekter</div>
              <div className="text-sm text-blue-600 mb-2">Pågående oppdrag</div>
              <div className="text-sm text-orange-600 dark:text-orange-400 font-medium">👆 Klikk for å administrere</div>
            </div>
            <div 
              className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-800/60 backdrop-blur-xl rounded-xl p-4 text-center cursor-pointer hover:bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:hover:bg-gray-700/60 transition-colors duration-300 hover:scale-[1.02] hover:shadow-lg border-white/20"
              onClick={() => setShowUpcomingShots(true)}
            >
              <div className="text-2xl font-bold text-purple-600 dark:text-purple-400">
                {businessStats.upcomingShots}
              </div>
              <div className="text-sm text-gray-600 dark:text-gray-400 mt-1">Kommende fotograferinger</div>
              <div className="text-sm text-purple-600 mb-2">Neste 30 dager</div>
              <div className="text-sm text-orange-600 dark:text-orange-400 font-medium">👆 Klikk for å administrere</div>
            </div>
            <div 
              className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:bg-gray-800/60 backdrop-blur-xl rounded-xl p-4 text-center cursor-pointer hover:bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 dark:hover:bg-gray-700/60 transition-colors duration-300 hover:scale-[1.02] hover:shadow-lg border-white/20"
              onClick={() => setShowRevenueManagement(true)}
            >
              <div className="text-2xl font-bold text-orange-600 dark:text-orange-400">
                {(businessStats.monthlyRevenue || 0).toLocaleString('nb-NO')} kr
              </div>
              <div className="text-sm text-gray-600 dark:text-gray-400 mt-1">Månedlig inntekt</div>
              <div className="text-sm text-orange-600 mb-2">{businessStats.pendingInvoices} fakturaer venter</div>
              <div className="text-sm text-orange-600 dark:text-orange-400 font-medium">👆 Klikk for å administrere</div>
            </div>
          </div>
        </div>
      </div>

      {/* Weekly Business Challenge */}
      <Card className="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/30 dark:to-emerald-900/30 backdrop-blur-xl border-green-200/30">
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-orange-900 dark:text-orange-100">
            <span className="text-2xl">📅</span>
            Ukeutfordring - Profesjonell Fotografvirksomhet
          </CardTitle>
        </CardHeader>
        <CardContent>
          <div className="space-y-3">
            <div className="flex justify-between items-center">
              <span className="text-green-700 dark:text-green-300">Gjennomfør {streakData.weeklyGoal} forretningshandlinger denne uken</span>
              <Badge className={`${
                streakData.thisWeekActions >= streakData.weeklyGoal 
                  ? 'bg-green-100 text-green-800' 
                  : 'bg-orange-100 text-orange-800'
              }`}>
                {streakData.thisWeekActions}/{streakData.weeklyGoal}
              </Badge>
            </div>
            <Progress 
              value={(streakData.thisWeekActions / streakData.weeklyGoal) * 100} 
              className="h-5 bg-green-100 dark:bg-green-900"
            />
            {streakData.thisWeekActions >= streakData.weeklyGoal ? (
              <p className="text-sm text-green-600 dark:text-green-400 font-semibold">
                🎉 Ukemål fullført! Din fotografvirksomhet vokser jevnt.
              </p>
            ) : (
              <p className="text-sm text-green-600 dark:text-green-400">
                {streakData.weeklyGoal - streakData.thisWeekActions} handlinger igjen (prosjekter, fakturaer, leveranser)
              </p>
            )}
          </div>
        </CardContent>
      </Card>
    </div>
  );

  const EquipmentManager = () => (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div className="space-y-2">
          <label className="text-sm font-medium">Kamera</label>
          <div className="relative">
            <Input
              placeholder="Søk etter kamera (f.eks. Canon R5, Sony A7)"
              value={cameraSearch}
              onChange={(e) => {
                setCameraSearch(e.target.value);
                searchCameras(e.target.value);
              }}
              className="mb-2"
            />
            
            {/* Search Results Dropdown */}
            {(cameraSearchResults.length > 0 || aiSuggestions.length > 0) && (
              <div className="absolute z-10 w-full bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border rounded-lg shadow-lg max-h-60 overflow-y-auto">
                {isSearching && (
                  <div className="p-3 text-center text-gray-500">
                    Søker...
                  </div>
                )}
                
                {/* AI Suggestions */}
                {aiSuggestions.length > 0 && (
                  <div className="border-b">
                    <div className="px-4 py-3 text-sm font-medium text-blue-600 bg-blue-50">
                      🤖 Er dette ditt kamera?
                    </div>
                    {aiSuggestions.map((suggestion, index) => (
                      <button
                        key={`suggestion-${index}`}
                        className="w-full text-left px-4 py-3 hover:bg-blue-50 border-b border-blue-100"
                        onClick={() => {
                          setSelectedCamera(suggestion.name);
                          setCameraSearch(suggestion.name);
                          setSelectedCameraPrice(suggestion.price || 0);
                          setCameraSearchResults([]);
                          setAiSuggestions([]);
                        }}
                      >
                        <div className="font-medium text-blue-700">{suggestion.name}</div>
                        <div className="text-sm text-blue-600">{suggestion.reason}</div>
                      </button>
                    ))}
                  </div>
                )}
                
                {/* Market Search Results */}
                {cameraSearchResults.length > 0 && (
                  <div>
                    <div className="px-4 py-3 text-sm font-medium text-gray-600 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg">
                      📸 Kameraer på markedet
                    </div>
                    {cameraSearchResults.map((camera, index) => (
                      <button
                        key={`camera-${index}`}
                        className="w-full text-left px-4 py-3 hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg border-b border-gray-100"
                        onClick={() => {
                          setSelectedCamera(camera.name);
                          setCameraSearch(camera.name);
                          setCameraSearchResults([]);
                          setAiSuggestions([]);
                        }}
                      >
                        <div className="font-medium">{camera.name}</div>
                        <div className="text-sm text-gray-600">
                          {camera.price && `${camera.price} NOK`} • {camera.type}
                        </div>
                      </button>
                    ))}
                  </div>
                )}
              </div>
            )}
            
            {/* Fallback Select for basic cameras */}
            <Select value={selectedCamera} onValueChange={(value) => {
              setSelectedCamera(value);
              setCameraSearch(value);
              setCameraSearchResults([]);
              setAiSuggestions([]);
            }}>
              <SelectTrigger>
                <SelectValue placeholder="Eller velg fra liste" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="Canon EOS R5">Canon EOS R5</SelectItem>
                <SelectItem value="Nikon Z9">Nikon Z9</SelectItem>
                <SelectItem value="Sony A7R V">Sony A7R V</SelectItem>
                <SelectItem value="Canon EOS R6 Mark II">Canon EOS R6 Mark II</SelectItem>
                <SelectItem value="Fujifilm X-T5">Fujifilm X-T5</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>
        <div className="space-y-2">
          <label className="text-sm font-medium">Objektiv</label>
          <div className="relative">
            <Input
              placeholder="Søk etter objektiv (f.eks. 24-70, 85mm, makro)"
              value={lensSearch}
              onChange={(e) => {
                setLensSearch(e.target.value);
                searchLenses(e.target.value);
              }}
              className="mb-2"
            />
            
            {/* Lens Search Results Dropdown */}
            {(lensSearchResults.length > 0 || lensAiSuggestions.length > 0) && (
              <div className="absolute z-10 w-full bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border rounded-lg shadow-lg max-h-60 overflow-y-auto">
                {isSearchingLens && (
                  <div className="p-3 text-center text-gray-500">
                    Søker...
                  </div>
                )}
                
                {/* AI Suggestions for Lenses */}
                {lensAiSuggestions.length > 0 && (
                  <div className="border-b">
                    <div className="px-4 py-3 text-sm font-medium text-blue-600 bg-blue-50">
                      🤖 Er dette ditt objektiv?
                    </div>
                    {lensAiSuggestions.map((suggestion, index) => (
                      <button
                        key={`lens-suggestion-${index}`}
                        className="w-full text-left px-4 py-3 hover:bg-blue-50 border-b border-blue-100"
                        onClick={() => {
                          setSelectedLens(suggestion.name);
                          setLensSearch(suggestion.name);
                          setLensSearchResults([]);
                          setLensAiSuggestions([]);
                        }}
                      >
                        <div className="font-medium text-blue-700">{suggestion.name}</div>
                        <div className="text-sm text-blue-600">{suggestion.reason}</div>
                      </button>
                    ))}
                  </div>
                )}
                
                {/* Market Search Results for Lenses */}
                {lensSearchResults.length > 0 && (
                  <div>
                    <div className="px-4 py-3 text-sm font-medium text-gray-600 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg">
                      📸 Objektiver på markedet
                    </div>
                    {lensSearchResults.map((lens, index) => (
                      <button
                        key={`lens-${index}`}
                        className="w-full text-left px-4 py-3 hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg border-b border-gray-100"
                        onClick={() => {
                          setSelectedLens(lens.name);
                          setLensSearch(lens.name);
                          setLensSearchResults([]);
                          setLensAiSuggestions([]);
                        }}
                      >
                        <div className="font-medium">{lens.name}</div>
                        <div className="text-sm text-gray-600">
                          {lens.price && `${lens.price} NOK`} • {lens.type} • {lens.mount}
                        </div>
                      </button>
                    ))}
                  </div>
                )}
              </div>
            )}
            
            {/* Fallback Select for basic lenses */}
            <Select value={selectedLens} onValueChange={(value) => {
              setSelectedLens(value);
              setLensSearch(value);
              setLensSearchResults([]);
              setLensAiSuggestions([]);
            }}>
              <SelectTrigger>
                <SelectValue placeholder="Eller velg fra liste" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="24-70mm f/2.8">24-70mm f/2.8</SelectItem>
                <SelectItem value="70-200mm f/2.8">70-200mm f/2.8</SelectItem>
                <SelectItem value="50mm f/1.2">50mm f/1.2</SelectItem>
                <SelectItem value="85mm f/1.4">85mm f/1.4</SelectItem>
                <SelectItem value="16-35mm f/2.8">16-35mm f/2.8</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>
      </div>
      <Button onClick={addEquipment} className="w-full">
        <Plus className="h-5 w-5 mr-2" />
        Legg til utstyr
      </Button>
      
      {/* Equipment Value Summary */}
      {(equipmentList || []).length > 0 && (
        <div className="bg-gradient-to-r from-blue-50 to-indigo-50 p-4 rounded-lg border-blue-200">
          <div className="flex items-center justify-between">
            <div>
              <h4 className="font-semibold text-blue-900">Total utstyr verdi</h4>
              <p className="text-sm text-blue-700">Beregnet markedsverdi av ditt utstyr</p>
            </div>
            <div className="text-right">
              <div className="text-2xl font-bold text-blue-900">{getTotalEquipmentValue().toLocaleString('nb-NO')} kr</div>
              <div className="text-sm text-blue-600">{(equipmentList || []).length} enheter totalt</div>
            </div>
          </div>
        </div>
      )}

      {/* Current Equipment List */}
      <div className="space-y-2">
        <h4 className="font-medium">Mitt utstyr ({(equipmentList || []).length}):</h4>
        {(equipmentList || []).map(item => {
          const firmwareInfo = firmwareUpdates.find(f => f.id === item.id);
          return (
            <div key={item.id} className="flex items-center justify-between p-3 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg rounded-lg hover:bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg transition-colors">
              <div className="flex-1">
                <div className="flex items-center gap-2">
                  <span className="text-lg">{equipmentCategories[item.category]?.icon || "📷"}</span>
                  <div className="font-medium">{item.name}</div>
                  {firmwareInfo && (
                    <Badge className={`text-sm ${
                      firmwareInfo.status === 'up-to-date' 
                        ? "bg-green-100 text-green-700" 
                        : "bg-orange-100 text-orange-700"
                    }`}>
                      {firmwareInfo.status === 'up-to-date' ? '✓ Oppdatert' : '⚡ Firmware tilgjengelig'}
                    </Badge>
                  )}
                </div>
                <div className="text-sm text-gray-600">{item.type} • {equipmentCategories[item.category]?.name || "Utstyr"}</div>
                <div className="text-sm text-gray-500">
                  Lagt til: {item.added} • 
                  Verdi: {(item.price || 0).toLocaleString('nb-NO')} kr
                  {firmwareInfo && (
                    <span className="ml-2 text-blue-600">
                      • Firmware: {firmwareInfo.currentVersion}
                      {firmwareInfo.status === 'available' && ` → ${firmwareInfo.latestVersion}`}
                    </span>
                  )}
                </div>
              </div>
              <div className="flex items-center gap-2">
                {firmwareInfo && firmwareInfo.status === 'available' && (
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => updateFirmware(item.id)}
                    className="text-blue-600 hover:text-blue-700 hover:bg-blue-50 border-blue-200 hover:border-blue-300"
                  >
                    <span className="text-sm">⬆️ Oppdater</span>
                  </Button>
                )}
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() => removeEquipment(item.id)}
                  className="text-red-600 hover:text-red-700 hover:bg-red-50 border-red-200 hover:border-red-300 transition-colors duration-200 hover:shadow-lg"
                >
                  <AlertCircle className="h-5 w-5 mr-1" />
                  <span className="text-sm">Fjern</span>
                </Button>
              </div>
            </div>
          );
        })}
        
        {/* Equipment Summary */}
        {(equipmentList || []).length > 0 && (
          <div className="mt-4 space-y-3">
            <div className="p-4 bg-gradient-to-r from-orange-50 to-red-50 rounded-lg border-orange-200">
              <div className="flex items-center justify-between">
                <div>
                  <h5 className="font-semibold text-orange-900">Totalverdi utstyr</h5>
                  <div className="text-sm text-orange-700">
                    {Object.entries(getEquipmentByCategory()).map(([key, stats]) => (
                      <div key={key} className="inline-block mr-4">
                        {equipmentCategories[key]?.icon} {stats.count} {equipmentCategories[key]?.name}: {(stats.value || 0).toLocaleString('nb-NO')} kr
                      </div>
                    ))}
                  </div>
                </div>
                <div className="text-right">
                  <div className="text-2xl font-bold text-orange-900">
                    {getTotalEquipmentValue().toLocaleString('nb-NO')} kr
                  </div>
                  <div className="text-sm text-orange-700">Total investering</div>
                </div>
              </div>
            </div>
            
            {/* Firmware Summary */}
            {firmwareUpdates.length > 0 && (
              <div className="p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg border-blue-200">
                <div className="flex items-center justify-between">
                  <div>
                    <h5 className="font-semibold text-blue-900">Firmware-status</h5>
                    <div className="text-sm text-blue-700">
                      {firmwareUpdates.filter(f => f.status === 'up-to-date').length} oppdatert • 
                      {firmwareUpdates.filter(f => f.status === 'available').length} trenger oppdatering
                    </div>
                  </div>
                  <div className="text-right">
                    <div className="text-2xl font-bold text-blue-900">
                      {Math.round((firmwareUpdates.filter(f => f.status === 'up-to-date').length / firmwareUpdates.length) * 100)}%
                    </div>
                    <div className="text-sm text-blue-700">Oppdatert utstyr</div>
                  </div>
                </div>
              </div>
            )}
          </div>
        )}
        
        {(equipmentList || []).length === 0 && (
          <div className="text-center py-6 text-gray-500">
            <Camera className="h-8 w-8 mx-auto mb-2 text-gray-300" />
            <p>Ingen utstyr lagt til ennå</p>
            <p className="text-sm">Søk og velg kamera og objektiv over</p>
          </div>
        )}
      </div>

      {/* Firmware Management */}
      <div className="space-y-2 border-t pt-4">
        <div className="flex items-center justify-between">
          <h4 className="font-medium flex items-center">
            <Settings className="h-5 w-5 mr-2" />
            Firmware-oppdateringer
          </h4>
          <Button
            variant="outline"
            size="sm"
            onClick={() => checkForFirmwareUpdates()}
            className="text-blue-600 hover:text-blue-700 hover:bg-blue-50"
          >
            <RefreshCw className="h-5 w-5 mr-1" />
            Sjekk oppdateringer
          </Button>
        </div>
        
        {firmwareUpdates.map(firmware => {
          const comparison = getFirmwareComparisonDetails(firmware);
          return (
            <div key={firmware.id} className={`p-4 rounded-lg border-2 transition-colors ${
              firmware.status === 'available' 
                ? 'bg-orange-50 border-orange-200 hover:bg-orange-100' 
                : 'bg-green-50 border-green-200'
            }`}>
              <div className="flex items-start justify-between">
                <div className="flex-1">
                  <div className="flex items-center gap-3 mb-2">
                    <span className="text-xl">{equipmentCategories[firmware.category]?.icon || "📷"}</span>
                    <div>
                      <div className="font-semibold text-lg">{firmware.device}</div>
                      <div className="text-sm text-gray-600">{firmware.type} • {equipmentCategories[firmware.category]?.name}</div>
                    </div>
                    <Badge className={`${
                      firmware.status === 'up-to-date' 
                        ? "bg-green-100 text-green-800 border-green-300" 
                        : "bg-orange-100 text-orange-800 border-orange-300"
                    }`}>
                      {firmware.status === 'up-to-date' ? '✓ Oppdatert' : '⚡ Tilgjengelig'}
                    </Badge>
                  </div>
                  
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div>
                      <div className="font-medium text-gray-700">Versjonsinformasjon:</div>
                      <div className="text-gray-600">
                        Nåværende: <span className="font-mono bg-gradient-to-br from-amber-100/40 to-orange-100/30 backdrop-blur-lg px-1 rounded-xl">{firmware.currentVersion}</span>
                        {firmware.status === 'available' && (
                          <span> → <span className="font-mono bg-blue-100 px-1 rounded-xl text-blue-800">{firmware.latestVersion}</span></span>
                        )}
                      </div>
                      <div className="text-gray-500">Utgitt: {firmware.releaseDate}</div>
                      {firmware.lastUpdated && (
                        <div className="text-green-600">Sist oppdatert: {firmware.lastUpdated}</div>
                      )}
                    </div>
                    
                    {firmware.status === 'available' && (
                      <div>
                        <div className="font-medium text-blue-700">Nye funksjoner i {firmware.latestVersion}:</div>
                        <div className="text-blue-600 space-y-1">
                          {comparison.newFeatures.slice(0, 2).map((feature, index) => (
                            <div key={index} className="flex items-start gap-1">
                              <span className="text-sm">✨</span>
                              <span className="text-sm">{feature}</span>
                            </div>
                          ))}
                          {comparison.newFeatures.length > 2 && (
                            <div className="text-sm text-blue-500">+{comparison.newFeatures.length - 2} flere...</div>
                          )}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
                
                <div className="flex flex-col items-end gap-2 ml-4">
                  {firmware.status === 'available' && (
                    <Button
                      onClick={() => updateFirmware(firmware.id)}
                      className="bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white shadow-[0_8px_16px_rgba(251,146,60,0.15)]"
                    >
                      <RefreshCw className="h-5 w-5 mr-2" />
                      Oppdater til {firmware.latestVersion}
                    </Button>
                  )}
                  
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => {
                      setSelectedFirmware(firmware);
                      setShowChangelogViewer(true);
                    }}
                    className="text-blue-600 hover:text-blue-700 hover:bg-blue-50 border-blue-200 hover:border-blue-300 transition-colors duration-200"
                  >
                    <FileText className="h-5 w-5 mr-1" />
                    Se detaljer
                  </Button>
                </div>
              </div>
            </div>
          );
        })}
        
        {/* Firmware Status Overview */}
        <div className="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="p-3 bg-green-50 rounded-lg border-green-200">
            <div className="flex items-center justify-between">
              <div>
                <div className="text-sm text-green-700">Oppdatert utstyr</div>
                <div className="text-2xl font-bold text-green-900">
                  {firmwareUpdates.filter(f => f.status === 'up-to-date').length}
                </div>
              </div>
              <CheckCircle className="h-8 w-8 text-green-600" />
            </div>
          </div>
          
          <div className="p-3 bg-orange-50 rounded-lg border-orange-200">
            <div className="flex items-center justify-between">
              <div>
                <div className="text-sm text-orange-700">Trenger oppdatering</div>
                <div className="text-2xl font-bold text-orange-900">
                  {firmwareUpdates.filter(f => f.status === 'available').length}
                </div>
              </div>
              <AlertCircle className="h-8 w-8 text-orange-600" />
            </div>
          </div>
          
          <div className="p-3 bg-blue-50 rounded-lg border-blue-200">
            <div className="flex items-center justify-between">
              <div>
                <div className="text-sm text-blue-700">Totalt utstyr</div>
                <div className="text-2xl font-bold text-blue-900">{firmwareUpdates.length}</div>
              </div>
              <Camera className="h-8 w-8 text-blue-600" />
            </div>
          </div>
        </div>

        {/* Enhanced Firmware Notification Settings */}
        <div className="mt-6 p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg border-blue-200">
          <div className="flex items-center justify-between">
            <div>
              <h5 className="font-semibold text-blue-900 flex items-center">
                <Bell className="h-5 w-5 mr-2" />
                Automatiske firmware-varsler
              </h5>
              <p className="text-sm text-blue-700 mt-1">
                Få e-postvarsler når nye firmware-oppdateringer blir tilgjengelige for ditt utstyr
              </p>
              <div className="text-sm text-blue-600 mt-2">
                Sist sjekket: {new Date(lastFirmwareCheck).toLocaleDateString('nb-NO')} • 
                {firmwareNotifications ? ' Varsler aktivert' : ' Varsler deaktivert'}
              </div>
            </div>
            <Button
              variant={firmwareNotifications ? "default" : "outline"}
              size="sm"
              onClick={() => toggleFirmwareNotifications()}
              className={firmwareNotifications 
                ? "bg-blue-600 hover:bg-blue-700 text-gray-800 dark:text-white" 
                : "text-blue-600 hover:text-blue-700 hover:bg-blue-100 border-blue-300"
              }
            >
              <Bell className="h-5 w-5 mr-1" />
              {firmwareNotifications ? '✓ Aktivert' : 'Aktiver varsler'}
            </Button>
          </div>
        </div>
      </div>
    </div>
  );

  const PriceTracker = () => (
    <div className="space-y-4">
      <div className="flex items-center justify-between mb-4">
        <h5 className="font-medium">Markedspriser vs Leie</h5>
        <Button 
          variant="ghost" 
          size="sm"
          onClick={() => setShowRentalComparison(!showRentalComparison)}
        >
          {showRentalComparison ? "Vis kjøpspriser" : "Sammenlign leie"}
        </Button>
      </div>

      {showRentalComparison ? (
        <RentalComparison 
          equipmentCategories={equipmentCategories}
          calculateRentalRecommendation={calculateRentalRecommendation}
        />
      ) : (
        <div className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <Card className="p-4">
              <div className="flex items-center justify-between">
                <div>
                  <h4 className="font-semibold">Canon EOS R5</h4>
                  <p className="text-sm text-gray-600">Komplett Foto</p>
                </div>
                <div className="text-right">
                  <div className="text-lg font-bold">42 990 kr</div>
                  <div className="text-sm text-green-600">-2% denne uken</div>
