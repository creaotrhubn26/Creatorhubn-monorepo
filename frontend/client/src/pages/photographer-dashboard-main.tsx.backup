            <div className="sticky top-0 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg dark:bg-gray-800 border-b border-amber-200/50 dark:border-gray-700 p-6 rounded-t-xl">
              <div className="flex items-center justify-between">
