function PhotographerDashboardContent() {
  const [activeMainTab, setActiveMainTab] = useState("creative-workflow");
  const [activeSubTab, setActiveSubTab] = useState("dashboard");
  const [showCreateProjectDialog, setShowCreateProjectDialog] = useState(false);
  const [showClientDialog, setShowClientDialog] = useState(false);
  const [showProjectDialog, setShowProjectDialog] = useState(false);
  const [showRevenueDialog, setShowRevenueDialog] = useState(false);
  const [showEquipmentDialog, setShowEquipmentDialog] = useState(false);
  const [selectedProject, setSelectedProject] = useState(null);
  const [selectedBusinessCategory, setSelectedBusinessCategory] = useState('core-business');
  const [activeTab, setActiveTab] = useState('dashboard');
  const [activeCategory, setActiveCategory] = useState('core-business');
  const [showMaintenanceScheduler, setShowMaintenanceScheduler] = useState(false);
  const { toast } = useToast();
  const queryClient = useQueryClient();

  // Live data queries for settings page
  const { data: projectsData, isLoading: projectsLoading } = useQuery({
    queryKey: ['/api/photographer/projects'],
    refetchInterval: 30000, // Refresh every 30 seconds
  });

  const { data: clientsData, isLoading: clientsLoading } = useQuery({
    queryKey: ['/api/photographer/clients'], 
    refetchInterval: 30000,
  });

  const { data: equipmentData, isLoading: equipmentLoading } = useQuery({
    queryKey: ['/api/equipment/list'],
    refetchInterval: 60000, // Refresh every minute
  });

  const { data: microsoftStatus, isLoading: microsoftLoading } = useQuery({
    queryKey: ['/api/microsoft/status'],
    refetchInterval: 30000,
  });

  const { data: onedriveStatus, isLoading: onedriveLoading } = useQuery({
    queryKey: ['/api/onedrive/status'],
    refetchInterval: 30000,
  });

  const { data: platformStatus } = useQuery({
    queryKey: ['/api/platform/status'],
    refetchInterval: 60000,
  });

  // Settings state with auto-save
  const [settings, setSettings] = useState({
    autoSync: true,
    realTimeUpdates: true,
    offlineMode: false,
    refreshInterval: 30,
    notifications: true,
    theme: 'light',
    language: 'no',
    autoSaveEnabled: true
  });

  // Auto-save mutation
  const autoSaveMutation = useMutation({
    mutationFn: async (newSettings: any) => {
      const response = await fetch('/api/settings/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newSettings)
      });
      if (!response.ok) throw new Error('Failed to save settings');
      return response.json();
    },
    onSuccess: () => {
      toast({
        title: "Innstillinger lagret",
        description: "Dine innstillinger er automatisk lagret",
      });
    },
    onError: () => {
      toast({
        title: "Feil ved lagring",
        description: "Kunne ikke lagre innstillinger",
        variant: "destructive"
      });
    }
  });

  // Load settings on component mount
  useEffect(() => {
    const loadSettings = async () => {
      try {
        const response = await fetch('/api/settings/load');
        if (response.ok) {
          const data = await response.json();
          if (data.success) {
            setSettings(data.settings);
          }
        }
      } catch (error) {
        console.error('Failed to load settings:', error);
      }
    };
    
    loadSettings();
  }, []);

  // Auto-save effect - only runs if auto-save is enabled
  useEffect(() => {
    if (!settings.autoSaveEnabled) return;
    
    const timeoutId = setTimeout(() => {
      autoSaveMutation.mutate(settings);
    }, 1000); // Auto-save 1 second after changes

    return () => clearTimeout(timeoutId);
  }, [settings]);

  // Manual refresh all data
  const refreshAllData = () => {
    queryClient.invalidateQueries({ queryKey: ['/api/photographer/projects'] });
    queryClient.invalidateQueries({ queryKey: ['/api/photographer/clients'] });
    queryClient.invalidateQueries({ queryKey: ['/api/equipment/list'] });
    queryClient.invalidateQueries({ queryKey: ['/api/microsoft/status'] });
    queryClient.invalidateQueries({ queryKey: ['/api/onedrive/status'] });
    queryClient.invalidateQueries({ queryKey: ['/api/platform/status'] });
    
    toast({
      title: "Data oppdatert",
      description: "Alle data er synkronisert med serveren",
    });
  };

  // Project creation function
  const createProject = () => {
    console.log('createProject function called - opening dialog');
    console.log('showCreateProjectDialog before:', showCreateProjectDialog);
    setShowCreateProjectDialog(true);
    console.log('setShowCreateProjectDialog called with true');
  };

  // Button handlers for dashboard actions
  const handleCreateProject = () => {
    console.log('FIXED handleCreateProject called - redirecting to createProject');
    createProject();
  };

  const handleAddClient = () => {
    console.log('Adding new client...');
    toast({
      title: "Ny klient",
      description: "Klientregistrering startet...",
    });
    setActiveMainTab('core-business');
    setActiveSubTab('kunder');
  };

  const handleAddEquipment = () => {
    console.log('Adding equipment...');
    toast({
      title: "Nytt utstyr",
      description: "Utstyrsregistrering startet...",
    });
    setActiveMainTab('equipment-tools');
    setActiveSubTab('equipment');
  };

  const handleOpenSettings = () => {
    console.log('Opening settings...');
    toast({
      title: "Innstillinger",
      description: "Åpner innstillinger...",
    });
    setSelectedBusinessCategory('information');
    setActiveTab('settings');
  };
  
  // Unified business category tabs
  const businessCategories = [
    {
      id: "core-business",
      label: "CORE BUSINESS",
      labelNorwegian: "Kjerneforretning",
      icon: Briefcase,
      color: "orange",
      tabs: ["dashboard", "projects", "delivery", "invoices"]
    },
    {
      id: "equipment-tools", 
      label: "EQUIPMENT & TOOLS",
      labelNorwegian: "Utstyr & Verktøy",
      icon: Camera,
      color: "blue",
      tabs: ["equipment", "tools"]
    },
    {
      id: "information",
      label: "INFORMATION",
      labelNorwegian: "Informasjon",
      icon: Info,
      color: "green",
      tabs: ["kunder", "nyheter", "varsler", "settings"]
    },
    {
      id: "integration",
      label: "ULTIMATE INTEGRATION",
      labelNorwegian: "Ultimate Integrasjon",
      icon: Globe,
      color: "purple",
      tabs: ["collaboration", "search", "performance", "security", "admin"]
    }
  ];

  // Dynamic tab organization based on business category
  const getTabsForCategory = () => {
    const category = businessCategories.find(cat => cat.id === selectedBusinessCategory);
    return category ? category.tabs : businessCategories[0].tabs;
  };

  // Set default tab when category changes
  const handleCategoryChange = (category: string) => {
    setActiveCategory(category);
    const categoryTabs = getTabsForCategory();
    if (categoryTabs.length > 0) {
      setActiveTab(categoryTabs[0]);
    }
  };
  const [showQuickActions, setShowQuickActions] = useState(false);
  const [showClientManagement, setShowClientManagement] = useState(false);
  const [showProjectManagement, setShowProjectManagement] = useState(false);
  // Temporarily removing problematic system integration
  // const systemIntegration = useSystemIntegration();
  // Removed problematic platform integration that causes unhandled promise rejections
  // const platformIntegration = usePlatformIntegration();
  const [showUpcomingShots, setShowUpcomingShots] = useState(false);
  const [showRevenueManagement, setShowRevenueManagement] = useState(false);
  const [showSettings, setShowSettings] = useState(false);
  const [showCreateClient, setShowCreateClient] = useState(false);
  const [selectedClient, setSelectedClient] = useState(null);
  const [clientSearchTerm, setClientSearchTerm] = useState("");
  
  // State management for all tools
  const [selectedCamera, setSelectedCamera] = useState("");
  const [selectedLens, setSelectedLens] = useState("");
  const [cameraSearch, setCameraSearch] = useState("");
  const [cameraSearchResults, setCameraSearchResults] = useState([]);
  const [isSearching, setIsSearching] = useState(false);
  const [aiSuggestions, setAiSuggestions] = useState([]);
  const [lensSearch, setLensSearch] = useState("");
  const [lensSearchResults, setLensSearchResults] = useState([]);
  const [isSearchingLens, setIsSearchingLens] = useState(false);
  const [lensAiSuggestions, setLensAiSuggestions] = useState([]);
  const [selectedCameraPrice, setSelectedCameraPrice] = useState(0);
  const [selectedLensPrice, setSelectedLensPrice] = useState(0);
  const [selectedCategory, setSelectedCategory] = useState("kamera");
  const [selectedEquipmentType, setSelectedEquipmentType] = useState("");
  const [selectedEquipmentName, setSelectedEquipmentName] = useState("");
  const [selectedEquipmentPrice, setSelectedEquipmentPrice] = useState(0);
  const [showRentalComparison, setShowRentalComparison] = useState(false);
  const [rentalData, setRentalData] = useState([]);
  const [firmwareUpdates, setFirmwareUpdates] = useState([]);
  const [firmwareNotifications, setFirmwareNotifications] = useState(true);
  const [lastFirmwareCheck, setLastFirmwareCheck] = useState(new Date().toISOString());
  const [selectedFirmware, setSelectedFirmware] = useState(null);
  const [showChangelogViewer, setShowChangelogViewer] = useState(false);
  const [showRemoveDialog, setShowRemoveDialog] = useState(false);
  const [equipmentToRemove, setEquipmentToRemove] = useState(null);
  const [updatedEquipment, setUpdatedEquipment] = useState([]);
  const [equipmentList, setEquipmentList] = useState([]);
  
  // Price search state
  const [priceSearchQuery, setPriceSearchQuery] = useState("");
  const [priceSearchCategory, setPriceSearchCategory] = useState("");
  const [priceSearchResults, setPriceSearchResults] = useState([]);
  const [isSearchingPrices, setIsSearchingPrices] = useState(false);
  
  // Query client for cache invalidation available above

  // Fetch projects from backend
  const { data: projects = [], isLoading: projectsLoading } = useQuery({
    queryKey: ['/api/photographer/projects'],
    staleTime: 5 * 60 * 1000, // 5 minutes
  });

  // Fetch clients from backend
  const { data: clientsResponse = { clients: [] }, isLoading: clientsLoading } = useQuery({
    queryKey: ['/api/photographer/clients'],
    staleTime: 5 * 60 * 1000, // 5 minutes
  });
  
  const clients = clientsResponse.clients || [];
  
  // Authentic business stats from database
  const businessStats = {
    totalClients: clients.length,
    newClientsThisMonth: clients.filter(c => {
      const created = new Date(c.createdAt);
      const now = new Date();
      return created.getMonth() === now.getMonth() && created.getFullYear() === now.getFullYear();
    }).length,
    activeProjects: projects.filter(p => p.status === 'planning' || p.status === 'in_progress').length,
    upcomingShots: projects.length,
    monthlyRevenue: projects.reduce((sum, p) => sum + (p.budget || 0), 0),
    pendingInvoices: 0,
    deliveredPhotos: 0
  };

  // Gamified Streak Tracker State - Fetched from Database
  const streakData = {
    currentStreak: 0,
    longestStreak: 0,
    totalMaintenanceActions: 0,
    weeklyGoal: 5,
    thisWeekActions: 0,
    level: 1,
    xp: 0,
    xpToNextLevel: 100
  };
  
  const achievements = [];
  
  // Receipt management - fetched from database
  const receipts = [];
  const [uploadingReceipt, setUploadingReceipt] = useState(false);
  const [selectedReceipt, setSelectedReceipt] = useState(null);
  const [showReceiptViewer, setShowReceiptViewer] = useState(false);
  
  // Price search function using real API
  const handlePriceSearch = async () => {
    if (!priceSearchQuery.trim()) return;
    
    setIsSearchingPrices(true);
    try {
      const response = await fetch(`/api/equipment/price-search?query=${encodeURIComponent(priceSearchQuery)}&category=${priceSearchCategory}`);
      const results = await response.json();
      
      setPriceSearchResults(results);
      toast({
        title: "Prisresultater funnet",
        description: `Fant ${results.length} priser for ${priceSearchQuery}`,
      });
    } catch (error) {
      toast({
        title: "Søk feilet",
        description: "Kunne ikke hente priser. Prøv igjen.",
        variant: "destructive",
      });
    } finally {
      setIsSearchingPrices(false);
    }
  };
  
  // Receipt upload and OCR function using real API
  const handleReceiptUpload = async (event) => {
    const file = event.target.files[0];
    if (!file) return;
    
    setUploadingReceipt(true);
    try {
      const formData = new FormData();
      formData.append('receipt', file);
      
      const response = await fetch('/api/photographer/receipts/upload-ocr', {
        method: 'POST',
        body: formData
      });
      
      const ocrResult = await response.json();
      
      // Refresh data from server
      queryClient.invalidateQueries({ queryKey: ['/api/photographer/receipts'] });
      queryClient.invalidateQueries({ queryKey: ['/api/photographer/equipment'] });
      
      toast({
        title: "Kvittering lastet opp",
        description: `OCR fullført: ${ocrResult.equipmentName} funnet og lagt til utstyr`,
      });
      
    } catch (error) {
      toast({
        title: "Opplasting feilet",
        description: "Kunne ikke behandle kvittering. Prøv igjen.",
        variant: "destructive",
      });
    } finally {
      setUploadingReceipt(false);
    }
  };
  
  // Receipt viewer component
  const ReceiptViewer = ({ receipt, onClose }) => {
    if (!receipt) return null;
    
    return (
      <div className="fixed inset-0 bg-black/50 backdrop-blur-lg flex items-center justify-center z-50">
        <div className="bg-gradient-to-br from-slate-900 to-slate-800 rounded-xl p-6 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
          <div className="flex justify-between items-center mb-4">
            <h3 className="text-xl font-bold text-gray-800 dark:text-white">Kvitteringsdetaljer</h3>
            <Button 
              variant="ghost" 
              size="sm"
              onClick={onClose}
              className="text-gray-800 dark:text-white hover:bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 "
            >
              ✕
            </Button>
          </div>
          
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div className="space-y-4">
              <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 rounded-lg p-4">
                <h4 className="font-semibold text-gray-800 dark:text-white mb-2">Utstyr informasjon</h4>
                <div className="space-y-2 text-sm">
                  <div><span className="text-gray-300">Produkt:</span> <span className="text-gray-800 dark:text-white">{receipt.equipmentName}</span></div>
                  <div><span className="text-gray-300">Butikk:</span> <span className="text-gray-800 dark:text-white">{receipt.store}</span></div>
                  <div><span className="text-gray-300">Pris:</span> <span className="text-gray-800 dark:text-white">{(receipt.price || 0).toLocaleString()} kr</span></div>
                  <div><span className="text-gray-300">Kjøpsdato:</span> <span className="text-gray-800 dark:text-white">{receipt.purchaseDate}</span></div>
                </div>
              </div>
              
              <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 rounded-lg p-4">
                <h4 className="font-semibold text-gray-800 dark:text-white mb-2">Garanti informasjon</h4>
                <div className="space-y-2 text-sm">
                  <div><span className="text-gray-300">Garanti:</span> <span className="text-gray-800 dark:text-white">{receipt.warrantyPeriod}</span></div>
                  <div><span className="text-gray-300">Utløper:</span> <span className="text-gray-800 dark:text-white">{receipt.warrantyExpiry}</span></div>
                  <div><span className="text-gray-300">Type:</span> <span className="text-gray-800 dark:text-white">{receipt.norwegianWarranty.type}</span></div>
                  <div><span className="text-gray-300">Dekning:</span> <span className="text-gray-800 dark:text-white">{receipt.norwegianWarranty.coverage}</span></div>
                  <div><span className="text-gray-300">Info:</span> <span className="text-gray-800 dark:text-white">{receipt.norwegianWarranty.additionalInfo}</span></div>
                </div>
              </div>
            </div>
            
            <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 rounded-lg p-4">
              <h4 className="font-semibold text-gray-800 dark:text-white mb-2">Kvittering</h4>
              <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 rounded-lg p-4 text-center">
                <Receipt className="w-12 h-12 mx-auto text-gray-400 mb-2" />
                <p className="text-sm text-gray-300">Kvitteringsbilde</p>
                <p className="text-sm text-gray-400">OCR Status: {receipt.ocrStatus === 'completed' ? 'Fullført' : 'Behandler'}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  };
  
  // Equipment Management Component with Category Tabs
  const EquipmentManagerWithTabs = () => {
    const [activeEquipmentTab, setActiveEquipmentTab] = useState("camera");
    
    return (
      <div className="space-y-6">
        {/* Equipment Category Tabs */}
        <Tabs value={activeEquipmentTab} onValueChange={setActiveEquipmentTab} className="w-full">
          <TabsList className="grid w-full grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 bg-gradient-to-r from-white/95 to-amber-50/30 backdrop-blur-lg border-amber-200/50 shadow-md rounded-xl mb-6 lg:mb-8 p-2 lg:p-4 gap-1 lg:gap-2">
            <TabsTrigger value="camera" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-orange-100 data-[state=active]:text-orange-900 font-medium transition-colors rounded-lg">
              <Camera className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Kamera</span>
            </TabsTrigger>
            <TabsTrigger value="lens" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-orange-100 data-[state=active]:text-orange-900 font-medium transition-colors rounded-lg">
              <Search className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Objektiv</span>
            </TabsTrigger>
            <TabsTrigger value="lighting" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-orange-100 data-[state=active]:text-orange-900 font-medium transition-colors rounded-lg">
              <Lightbulb className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Lys</span>
            </TabsTrigger>
            <TabsTrigger value="accessory" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-orange-100 data-[state=active]:text-orange-900 font-medium transition-colors rounded-lg">
              <Package className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Tilbehør</span>
            </TabsTrigger>
            <TabsTrigger value="audio" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-orange-100 data-[state=active]:text-orange-900 font-medium transition-colors rounded-lg">
              <Mic className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden sm:inline">Audio</span>
            </TabsTrigger>
            <TabsTrigger value="value-pricing" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-orange-100 data-[state=active]:text-orange-900 font-medium transition-colors rounded-lg">
              <Gem className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden md:inline">Verdi</span>
            </TabsTrigger>
            <TabsTrigger value="firmware" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-orange-100 data-[state=active]:text-orange-900 font-medium transition-colors rounded-lg">
              <Settings className="w-3 h-3 lg:w-4 lg:h-4" />
              <span className="hidden md:inline">Vedlikehold</span>
            </TabsTrigger>
          </TabsList>

          {/* Camera Tab */}
          <TabsContent value="camera" className="space-y-4">
            <div className="p-4 bg-blue-50 rounded-lg border-blue-200">
              <h3 className="font-semibold text-blue-900 mb-2">📷 Kamera - Typer støttet:</h3>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm text-blue-700">
                <div>• Speilløs</div>
                <div>• DSLR</div>
                <div>• Medium format</div>
                <div>• Film</div>
              </div>
            </div>
            <div className="space-y-2">
              <label className="text-sm font-medium">Søk etter kamera</label>
              <div className="relative">
                <Input
                  placeholder="Søk etter kamera (f.eks. Canon R5, Sony A7)"
                  value={cameraSearch}
                  onChange={(e) => {
                    setCameraSearch(e.target.value);
                    searchCameras(e.target.value);
                  }}
                  className="mb-2"
                />
                
                {/* Search Results Dropdown */}
                {(cameraSearchResults.length > 0 || aiSuggestions.length > 0) && (
                  <div className="absolute z-10 w-full bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border rounded-lg shadow-lg max-h-60 overflow-y-auto">
                    {isSearching && (
                      <div className="p-3 text-center text-gray-500">
                        Søker...
                      </div>
                    )}
                    
                    {/* AI Suggestions */}
                    {aiSuggestions.length > 0 && (
                      <div className="border-b">
                        <div className="px-4 py-3 text-sm font-medium text-blue-600 bg-blue-50">
                          🤖 Er dette ditt kamera?
                        </div>
                        {aiSuggestions.map((suggestion, index) => (
                          <button
                            key={`suggestion-${index}`}
                            className="w-full text-left px-4 py-3 hover:bg-blue-50 border-b border-blue-100"
                            onClick={() => {
                              setSelectedCamera(suggestion.name);
                              setCameraSearch(suggestion.name);
                              setSelectedCameraPrice(suggestion.price || 0);
                              setCameraSearchResults([]);
                              setAiSuggestions([]);
                            }}
                          >
                            <div className="font-medium text-blue-700">{suggestion.name}</div>
                            <div className="text-sm text-blue-600">{suggestion.reason}</div>
                          </button>
                        ))}
                      </div>
                    )}
                    
                    {/* Market Search Results */}
                    {cameraSearchResults.length > 0 && (
                      <div>
                        <div className="px-4 py-3 text-sm font-medium text-gray-600 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg">
                          📸 Kameraer på markedet
                        </div>
                        {cameraSearchResults.map((camera, index) => (
                          <button
                            key={`camera-${index}`}
                            className="w-full text-left px-4 py-3 hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg border-b border-gray-100"
                            onClick={() => {
                              setSelectedCamera(camera.name);
                              setCameraSearch(camera.name);
                              setCameraSearchResults([]);
                              setAiSuggestions([]);
                            }}
                          >
                            <div className="font-medium">{camera.name}</div>
                            <div className="text-sm text-gray-600">
                              {camera.price && `${camera.price} NOK`} • {camera.type}
                            </div>
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </div>
              
              <Select value={selectedCamera} onValueChange={setSelectedCamera}>
                <SelectTrigger>
                  <SelectValue placeholder="Eller velg fra liste" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="Canon EOS R5 Mark II">Canon EOS R5 Mark II (Speilløs)</SelectItem>
                  <SelectItem value="Sony A7R V">Sony A7R V (Speilløs)</SelectItem>
                  <SelectItem value="Nikon Z9">Nikon Z9 (Speilløs)</SelectItem>
                  <SelectItem value="Canon EOS 5D Mark IV">Canon EOS 5D Mark IV (DSLR)</SelectItem>
                  <SelectItem value="Fujifilm GFX 100S">Fujifilm GFX 100S (Medium format)</SelectItem>
                  <SelectItem value="Leica M11">Leica M11 (Film/Digital)</SelectItem>
                </SelectContent>
              </Select>
            </div>
            {selectedCamera && (
              <Button onClick={addEquipment} className="w-full">
                <Plus className="h-5 w-5 mr-2" />
                Legg til {selectedCamera}
              </Button>
            )}
          </TabsContent>

          {/* Lens Tab */}
          <TabsContent value="lens" className="space-y-4">
            <div className="p-4 bg-green-50 rounded-lg border-green-200">
              <h3 className="font-semibold text-green-900 mb-2">🔍 Objektiv - Typer støttet:</h3>
              <div className="grid grid-cols-2 md:grid-cols-3 gap-2 text-sm text-green-700">
                <div>• Standard zoom</div>
                <div>• Telezoom</div>
                <div>• Vidvinkel</div>
                <div>• Makro</div>
                <div>• Prime</div>
                <div>• Tilt-shift</div>
              </div>
            </div>
            <div className="space-y-2">
              <label className="text-sm font-medium">Søk etter objektiv</label>
              <div className="relative">
                <Input
                  placeholder="Søk etter objektiv (f.eks. 24-70mm f/2.8)"
                  value={lensSearch}
                  onChange={(e) => {
                    setLensSearch(e.target.value);
                    searchLenses(e.target.value);
                  }}
                  className="mb-2"
                />
                
                {/* Lens Search Results */}
                {lensSearchResults.length > 0 && (
                  <div className="absolute z-10 w-full bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border rounded-lg shadow-lg max-h-60 overflow-y-auto">
                    <div className="px-4 py-3 text-sm font-medium text-gray-600 bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg">
                      🔍 Objektiver på markedet
                    </div>
                    {lensSearchResults.map((lens, index) => (
                      <button
                        key={`lens-${index}`}
                        className="w-full text-left px-4 py-3 hover:bg-gradient-to-br from-amber-50/30 to-orange-50/20 backdrop-blur-lg border-b border-gray-100"
                        onClick={() => {
                          setSelectedLens(lens.name);
                          setLensSearch(lens.name);
                          setLensSearchResults([]);
                        }}
                      >
                        <div className="font-medium">{lens.name}</div>
                        <div className="text-sm text-gray-600">
                          {lens.price && `${lens.price} NOK`} • {lens.type}
                        </div>
                      </button>
                    ))}
                  </div>
                )}
              </div>
              
              <Select value={selectedLens} onValueChange={setSelectedLens}>
                <SelectTrigger>
                  <SelectValue placeholder="Eller velg fra liste" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="24-70mm f/2.8">24-70mm f/2.8 (Standard zoom)</SelectItem>
                  <SelectItem value="70-200mm f/2.8">70-200mm f/2.8 (Telezoom)</SelectItem>
                  <SelectItem value="16-35mm f/2.8">16-35mm f/2.8 (Vidvinkel)</SelectItem>
                  <SelectItem value="100mm f/2.8 Macro">100mm f/2.8 (Makro)</SelectItem>
                  <SelectItem value="50mm f/1.2">50mm f/1.2 (Prime)</SelectItem>
                  <SelectItem value="24mm f/3.5 Tilt-Shift">24mm f/3.5 (Tilt-shift)</SelectItem>
                </SelectContent>
              </Select>
            </div>
            {selectedLens && (
              <Button onClick={addEquipment} className="w-full">
                <Plus className="h-5 w-5 mr-2" />
                Legg til {selectedLens}
              </Button>
            )}
          </TabsContent>

          {/* Lighting Tab */}
          <TabsContent value="lighting" className="space-y-4">
            <div className="p-4 bg-yellow-50 rounded-lg border-yellow-200">
              <h3 className="font-semibold text-yellow-900 mb-2">💡 Lys & Blitz - Typer støttet:</h3>
              <div className="grid grid-cols-2 md:grid-cols-3 gap-2 text-sm text-yellow-700">
                <div>• Blitz</div>
                <div>• LED-panel</div>
                <div>• Kontinuerlig lys</div>
                <div>• Ring light</div>
                <div>• Softbox</div>
                <div>• Reflektor</div>
              </div>
            </div>
            <div className="space-y-2">
              <label className="text-sm font-medium">Legg til lysutstyr</label>
              <Input
                placeholder="Søk etter lysutstyr (f.eks. Godox, Profoto, Aputure)"
                className="mb-2"
              />
              <Select onValueChange={(value) => {
                const newEquipment = {
                  id: `lighting-${Date.now()}`,
                  name: value,
                  category: 'lys',
                  type: value.includes('Blitz') ? 'Blitz' : value.includes('LED') ? 'LED-panel' : 'Kontinuerlig lys',
                  price: 5000,
                  added: new Date().toLocaleDateString('nb-NO')
                };
                setEquipmentList([...(equipmentList || []), newEquipment]);
              }}>
                <SelectTrigger>
                  <SelectValue placeholder="Eller velg fra liste" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="Canon Speedlite 600EX II-RT">Canon Speedlite 600EX II-RT (Blitz)</SelectItem>
                  <SelectItem value="Godox SL-60W">Godox SL-60W (LED-panel)</SelectItem>
                  <SelectItem value="Aputure 120D Mark II">Aputure 120D Mark II (Kontinuerlig)</SelectItem>
                  <SelectItem value="Neewer Ring Light 18">Neewer Ring Light 18" (Ring light)</SelectItem>
                  <SelectItem value="Godox SB-UE95">Godox SB-UE95 (Softbox)</SelectItem>
                  <SelectItem value="5-in-1 Reflector">5-in-1 Reflector (Reflektor)</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </TabsContent>

          {/* Accessory Tab */}
          <TabsContent value="accessory" className="space-y-4">
            <div className="p-4 bg-purple-50 rounded-lg border-purple-200">
              <h3 className="font-semibold text-purple-900 mb-2">🎒 Tilbehør - Typer støttet:</h3>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm text-purple-700">
                <div>• Stativ</div>
                <div>• Gimbal</div>
                <div>• Filter</div>
                <div>• Minnekort</div>
                <div>• Batteri</div>
                <div>• Bag/Case</div>
                <div>• Remote</div>
              </div>
            </div>
            <div className="space-y-2">
              <label className="text-sm font-medium">Legg til tilbehør</label>
              <Input
                placeholder="Søk etter tilbehør (f.eks. Manfrotto, Peak Design, DJI)"
                className="mb-2"
              />
              <Select onValueChange={(value) => {
                const newEquipment = {
                  id: `accessory-${Date.now()}`,
                  name: value,
                  category: 'tilbehor',
                  type: value.includes('Stativ') ? 'Stativ' : value.includes('Gimbal') ? 'Gimbal' : 'Tilbehør',
                  price: 2000,
                  added: new Date().toLocaleDateString('nb-NO')
                };
                setEquipmentList([...(equipmentList || []), newEquipment]);
              }}>
                <SelectTrigger>
                  <SelectValue placeholder="Eller velg fra liste" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="Manfrotto MT055CXPRO4">Manfrotto MT055CXPRO4 (Stativ)</SelectItem>
                  <SelectItem value="DJI Ronin-S">DJI Ronin-S (Gimbal)</SelectItem>
                  <SelectItem value="B+W XS-Pro UV-Filter">B+W XS-Pro UV-Filter (Filter)</SelectItem>
                  <SelectItem value="SanDisk Extreme Pro 128GB">SanDisk Extreme Pro 128GB (Minnekort)</SelectItem>
                  <SelectItem value="Canon LP-E6NH">Canon LP-E6NH (Batteri)</SelectItem>
                  <SelectItem value="Peak Design Everyday Backpack">Peak Design Everyday Backpack (Bag)</SelectItem>
                  <SelectItem value="Canon RC-6">Canon RC-6 (Remote)</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </TabsContent>

          {/* Audio Tab */}
          <TabsContent value="audio" className="space-y-4">
            <div className="p-4 bg-red-50 rounded-lg border-red-200">
              <h3 className="font-semibold text-red-900 mb-2">🎤 Audio - Typer støttet:</h3>
              <div className="grid grid-cols-2 md:grid-cols-3 gap-2 text-sm text-red-700">
                <div>• Mikrofon</div>
                <div>• Recorder</div>
                <div>• Mixer</div>
                <div>• Monitor</div>
                <div>• Wireless system</div>
              </div>
            </div>
            <div className="space-y-2">
              <label className="text-sm font-medium">Legg til audioutstyr</label>
              <Input
                placeholder="Søk etter audioutstyr (f.eks. Rode, Zoom, Sony)"
                className="mb-2"
              />
              <Select onValueChange={(value) => {
                const newEquipment = {
                  id: `audio-${Date.now()}`,
                  name: value,
                  category: 'audio',
                  type: value.includes('Mikrofon') ? 'Mikrofon' : value.includes('Recorder') ? 'Recorder' : 'Audio utstyr',
                  price: 3000,
                  added: new Date().toLocaleDateString('nb-NO')
                };
                setEquipmentList([...(equipmentList || []), newEquipment]);
              }}>
                <SelectTrigger>
                  <SelectValue placeholder="Eller velg fra liste" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="Rode VideoMic Pro Plus">Rode VideoMic Pro Plus (Mikrofon)</SelectItem>
                  <SelectItem value="Zoom H5 Handy Recorder">Zoom H5 Handy Recorder (Recorder)</SelectItem>
                  <SelectItem value="Behringer Xenyx Q802USB">Behringer Xenyx Q802USB (Mixer)</SelectItem>
                  <SelectItem value="Sony MDR-7506">Sony MDR-7506 (Monitor)</SelectItem>
                  <SelectItem value="Rode Wireless GO II">Rode Wireless GO II (Wireless system)</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </TabsContent>

          {/* Value & Pricing Tab with Sub-tabs */}
          <TabsContent value="value-pricing" className="space-y-6">
            <Tabs defaultValue="value" className="w-full">
              <TabsList className="grid w-full grid-cols-3 bg-gradient-to-r from-white/95 to-amber-50/30 backdrop-blur-lg border-amber-200/50 shadow-md rounded-xl mb-4 lg:mb-6 p-2 lg:p-3 gap-1 lg:gap-2">
                <TabsTrigger value="value" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-green-100 data-[state=active]:text-green-900 font-medium transition-colors rounded-lg">
                  <Gem className="w-3 h-3 lg:w-4 lg:h-4" />
                  <span className="hidden sm:inline">Verdi</span>
                </TabsTrigger>
                <TabsTrigger value="pricing" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-green-100 data-[state=active]:text-green-900 font-medium transition-colors rounded-lg">
                  <TrendingUp className="w-3 h-3 lg:w-4 lg:h-4" />
                  <span className="hidden sm:inline">Priser</span>
                </TabsTrigger>
                <TabsTrigger value="kvittering" className="flex items-center justify-center space-x-1 lg:space-x-2 px-2 lg:px-4 py-3 lg:py-3 text-xs lg:text-sm data-[state=active]:bg-green-100 data-[state=active]:text-green-900 font-medium transition-colors rounded-lg">
                  <Receipt className="w-3 h-3 lg:w-4 lg:h-4" />
                  <span className="hidden sm:inline">Kvittering</span>
                </TabsTrigger>
              </TabsList>

              {/* Value Sub-tab */}
              <TabsContent value="value" className="space-y-6 mt-6">
            {/* Total Equipment Value Section - Enhanced */}
            <div className="bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 rounded-xl border-green-200 shadow-sm overflow-hidden">
              <div className="p-6">
                <div className="flex items-center justify-between mb-4">
                  <div className="flex items-center space-x-3">
                    <div className="p-2 bg-green-100 rounded-lg">
                      <Gem className="h-6 w-6 text-green-600" />
                    </div>
                    <h3 className="text-xl font-semibold text-green-900">Total utstyr verdi</h3>
                  </div>
                  <div className="text-sm text-green-600 bg-green-100 px-2 py-1 rounded-full">
                    {(equipmentList || []).length} enheter
                  </div>
                </div>

                {/* Main Value Display */}
                <div className="mb-6">
                  <div className="text-4xl font-bold text-green-800 mb-2">
                    {(equipmentList || []).reduce((total, item) => total + (item.price || 0), 0).toLocaleString('nb-NO')} kr
                  </div>
                  <div className="flex items-center space-x-2 text-green-700">
                    <TrendingUp className="h-5 w-5" />
                    <span className="text-sm font-medium">Basert på norske markedspriser</span>
                  </div>
                </div>

                {/* Value Breakdown Grid */}
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border border-amber-200/50 shadow-lg rounded-xl p-4">
                    <div className="flex items-center space-x-2 mb-2">
                      <Calculator className="h-5 w-5 text-amber-600" />
                      <span className="text-sm font-medium text-gray-800">Gjennomsnitt</span>
                    </div>
                    <div className="text-lg font-semibold text-amber-600">
                      {(equipmentList || []).length > 0 
                        ? Math.round((equipmentList || []).reduce((total, item) => total + (item.price || 0), 0) / (equipmentList || []).length).toLocaleString('nb-NO')
                        : '0'
                      } kr
                    </div>
                    <div className="text-sm text-gray-700">per enhet</div>
                  </div>

                  <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border border-amber-200/50 shadow-lg rounded-xl p-4">
                    <div className="flex items-center space-x-2 mb-2">
                      <Shield className="h-5 w-5 text-amber-600" />
                      <span className="text-sm font-medium text-gray-800">Forsikring</span>
                    </div>
                    <div className="text-lg font-semibold text-amber-600">
                      {((equipmentList || []).reduce((total, item) => total + (item.price || 0), 0) * 1.1).toLocaleString('nb-NO')} kr
                    </div>
                    <div className="text-sm text-gray-700">anbefalt sum</div>
                  </div>

                  <div className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg border border-amber-200/50 shadow-lg rounded-xl p-4">
                    <div className="flex items-center space-x-2 mb-2">
                      <Package className="h-5 w-5 text-amber-600" />
                      <span className="text-sm font-medium text-gray-800">Høyeste verdi</span>
                    </div>
                    <div className="text-lg font-semibold text-amber-600">
                      {(equipmentList || []).length > 0 
                        ? Math.max(...(equipmentList || []).map(item => item.price || 0)).toLocaleString('nb-NO')
                        : '0'
                      } kr
                    </div>
                    <div className="text-sm text-gray-700">mest verdifull</div>
                  </div>
                </div>

                {/* Category Breakdown */}
                <div className="mt-6 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-lg p-4 border-green-100">
                  <h4 className="font-medium text-green-900 mb-3 flex items-center">
                    <BarChart3 className="h-5 w-5 mr-2" />
                    Verdi per kategori
                  </h4>
                  <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                    {Object.entries(
                      (equipmentList || []).reduce((acc, item) => {
                        const category = item.category || 'annet';
                        acc[category] = (acc[category] || 0) + (item.price || 0);
                        return acc;
                      }, {} as Record<string, number>)
                    ).map(([category, value]) => (
                      <div key={category} className="flex justify-between items-center bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 rounded-xl px-4 py-3">
                        <span className="text-sm font-medium capitalize text-gray-700">{category}</span>
                        <span className="text-sm font-semibold text-green-700">{(value || 0).toLocaleString('nb-NO')} kr</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* Price Tracking Section - Enhanced with Search */}
            <div className="bg-gradient-to-br from-orange-50 via-amber-50 to-yellow-50 rounded-xl border-orange-200 shadow-sm overflow-hidden">
              <div className="p-6">
                <div className="flex items-center justify-between mb-6">
                  <div className="flex items-center space-x-3">
                    <div className="p-2 bg-orange-100 rounded-lg">
                      <BarChart3 className="h-6 w-6 text-orange-600" />
                    </div>
                    <div>
                      <h3 className="text-xl font-semibold text-orange-900">Prissporing Norge</h3>
                      <p className="text-sm text-orange-700">Søk og sammenlign utstyrspriser • Finn nytt utstyr</p>
                    </div>
                  </div>
                  <div className="text-sm text-orange-600 bg-orange-100 px-2 py-1 rounded-full">
                    Live priser
                  </div>
                </div>

                {/* Equipment Search */}
                <div className="mb-6 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-lg p-4 border-orange-100">
                  <div className="flex items-center space-x-2 mb-3">
                    <Search className="h-5 w-5 text-orange-600" />
                    <h4 className="font-medium text-orange-900">Søk etter utstyr</h4>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div className="space-y-2">
                      <input
                        type="text"
                        placeholder="Søk etter kamera, objektiv, lys..."
                        className="w-full px-4 py-3 border-orange-200 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                        value={priceSearchQuery}
                        onChange={(e) => setPriceSearchQuery(e.target.value)}
                      />
                      <div className="flex flex-wrap gap-2">
                        {['Canon EOS R5', 'Sony A7R V', 'Profoto B10', 'MacBook Pro'].map((suggestion) => (
                          <button
                            key={suggestion}
                            onClick={() => setPriceSearchQuery(suggestion)}
                            className="text-sm px-2 py-1 bg-orange-100 text-orange-700 rounded-full hover:bg-orange-200 transition-colors"
                          >
                            {suggestion}
                          </button>
                        ))}
                      </div>
                    </div>
                    <div className="space-y-2">
                      <select
                        className="w-full px-4 py-3 border-orange-200 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                        value={priceSearchCategory}
                        onChange={(e) => setPriceSearchCategory(e.target.value)}
                      >
                        <option value="">Alle kategorier</option>
                        <option value="kamera">Kamera</option>
                        <option value="objektiv">Objektiv</option>
                        <option value="lys">Lys & Blitz</option>
                        <option value="tilbehor">Tilbehør</option>
                        <option value="audio">Audio</option>
                      </select>
                      <button
                        onClick={handlePriceSearch}
                        disabled={!priceSearchQuery.trim()}
                        className="w-full px-4 py-3 bg-orange-600 text-gray-800 dark:text-white rounded-lg hover:bg-orange-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors flex items-center justify-center space-x-2"
                      >
                        <Search className="h-5 w-5" />
                        <span>Søk priser</span>
                      </button>
                    </div>
                  </div>
                </div>

                {/* Price Search Results */}
                {priceSearchResults.length > 0 && (
                  <div className="mb-6 bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 backdrop-blur-lg rounded-lg p-4 border-orange-100">
                    <h4 className="font-medium text-orange-900 mb-3 flex items-center">
                      <ShoppingCart className="h-5 w-5 mr-2" />
                      Prisresultater for "{priceSearchQuery}"
                    </h4>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                      {priceSearchResults.map((item, index) => (
                        <div key={index} className="bg-gradient-to-br from-white/95 via-amber-50/20 to-white/95 rounded-lg p-3 border-orange-100">
                          <div className="flex justify-between items-start mb-2">
                            <h5 className="font-medium text-gray-800 text-sm">{item.name}</h5>
                            <span className="text-sm font-semibold text-orange-600">{(item.price || 0).toLocaleString('nb-NO')} kr</span>
                          </div>
                          <div className="text-sm text-gray-600 mb-2">{item.store}</div>
                          <div className="flex justify-between items-center">
                            <span className="text-sm text-gray-500">Oppdatert: {item.lastUpdated}</span>
                            <button
                              onClick={() => {
                                setEquipmentList(prev => [...prev, {
                                  id: Date.now(),
                                  name: item.name,
                                  category: priceSearchCategory || 'annet',
                                  price: item.price,
                                  addedDate: new Date().toLocaleDateString('nb-NO')
                                }]);
                                toast({
                                  title: "Utstyr lagt til",
                                  description: `${item.name} er lagt til utstyrslisten din`,
                                });
                              }}
                              className="text-sm px-2 py-1 bg-green-100 text-green-700 rounded-xl hover:bg-green-200 transition-colors"
                            >
                              + Legg til
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

