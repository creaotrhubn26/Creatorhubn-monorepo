                : "text-pink-700 hover:bg-gradient-to-br hover:from-pink-50/80 hover:to-pink-100/60 hover:shadow-[0_4px_16px_rgba(236,72,153,0.15)] hover:scale-102 border-pink-200/30"} 
                font-semibold transition-colors duration-500 ease-out px-8 lg:px-16 py-4 lg:py-8 text-sm lg:text-base rounded-xl border backdrop-blur-xl relative overflow-hidden group`}
              onClick={() => {
