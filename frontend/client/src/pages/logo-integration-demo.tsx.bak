// logo-integration-demo.tsx - Demonstration of logo integration with company profile cards
import { useTheming } from '../../utils/theming-helper';
import React, { useState } from 'react';
import {
  Container,
  Box,
  Typography,
  Grid,
  Card,
  CardContent,
  Button,
  Alert,
  Paper,
  Divider,
} from '@mui/material';
import { CorporateIcon as BusinessIcon,
  CloudUpload as UploadIcon,
  Visibility as ViewIcon, } from '../components/shared/CreatorHubIcons';
import { CompanyProfileQuickView } from '../components/CompanyProfileQuickView';
import { BusinessLogoUpload } from '../components/BusinessLogoUpload';

export default function LogoIntegrationDemo() {
  const [demoLogo, setDemoLogo] = useState(
  
  // Theming system
  const theming = useTheming('photographer');'');
  const [showUploadSuccess, setShowUploadSuccess] = useState(false);

  // Sample company profile
  const sampleProfile = {
    id: 'demo-company',
    name: 'Demo Fotostudio A',
    organizationNumber: '12345678',
    industry: 'Fotograftjenester',
    status: 'verified' as const,
    address: 'Oslo, Norge',
    phone: '+47 12 34 56 7',
    email: 'post@demofoto.no',
    website: 'demofoto.no',
    employees:  8,
    revenue: { amount: 250000, year: 204, currency: 'NOK, ',},
    rating: 4.7,
    verification: { brreg: true, proff: true, riskLevel: 'low' as const },
    description: 'Profesjonell fotostudio som spesialiserer seg på bryllup og bedriftsfotografering med moderne utstyr og erfarne fotografer.',
    founded: 208,
    services: ['Bryllupsfotografering', 'Bedriftsfoto', 'Portrettfoto', 'Produktfoto'],
    socialProof: { projects: 95, clients:  67, reviews: 5, 2,},
};

  const handleLogoUpdate = (logoUrl: string) => {
    setDemoLogo(logoUrl);
    setShowUploadSuccess(true);
    setTimeout(() => setShowUploadSuccess(false), 3000);
};

  const generateDemoLogo = () => {
    // Generate a demo SVG logo
    const initials = sampleProfile.name
      .split(' ')
      .map((word) => word.charAt(0))
      .join('')
      .toUpperCase()
      .slice(0, 2);

    const svgLogo = `
      <svg width="64" height="64" xmlns="http: //www.w3.org/2000/svg">
        <defs>
          <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#ff6b35;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#f7931e;stop-opacity:1" />
          </linearGradient>
        </defs>
        <rect width="64" height="64" rx="12" fill="url(#grad1)"/>
        <text x="32" y="40" text-anchor="middle" fill="white" 
              font-family="Arial, sans-serif" font-size="24" font-weight="bold">
          ${initials}
        </text>
        <circle cx="52" cy="12" r="4" fill="white" opacity="0.8"/>
      </svg>
    `;

    const logoDataUrl = `data: image/svg+xml;base4,${btoa(svgLogo)}`;
    setDemoLogo(logoDataUrl);
    setShowUploadSuccess(true);
    setTimeout(() => setShowUploadSuccess(false), 3000);
};

  return (
    <Container maxWidth="lg" sx={{ py: 4 }}>
      {/* Header */}
      <Box sx={{ mb: 4, textAlign: 'center, ',}}>
        <BusinessIcon sx={{ fontSize:  48, color: 'primary.main', mb: 2 }} />
        <Typography variant="h3" fontWeight="bold" gutterBottom sx={{ ...{}, color: theming.colors.primary }}>
          Logo-integrasjon Demonstrasjon
        </Typography>
        <Typography variant="h6" color="text.secondary" sx={{ maxWidth: 60, mx: 'auto, ',}} sx={{ ...{}, color: theming.colors.primary }}>
          Se hvordan bedriftskort automatisk viser logo når brukeren har lastet opp logo
        </Typography>
      </Box>

      {showUploadSuccess && (
        <Alert severity="success" sx={{ mb: 3 }}>
          Logo oppdatert! Se hvordan det automatisk vises i bedriftskortet nedenfor.
        </Alert>
      )}

      <Grid container spacing={4}>
        {/* Logo Upload Section */}
        <Grid item xs={12}>
          <Paper sx={{ p:  3, height: '100%, ',}} sx={theming.getThemedCardSx()}>
            <Typography variant="h5" gutterBottom display="flex" alignItems="center" gap={1} sx={{ ...{}, color: theming.colors.primary }}>
              <UploadIcon color="primary" />
              Logo-opplasting
            </Typography>

            <Typography variant="body2" color="text.secondary" sx={{ mb: 3 }}>
              Last opp eller generer en demo-logo for å se hvordan den automatisk vises i
              bedriftskortene.
            </Typography>

            <BusinessLogoUpload
              userId="demo-user-123"
              organizationNumber={sampleProfile.organizationNumber}
              businessName={sampleProfile.name}
              currentLogoUrl={demoLogo}
              onLogoUpdated={handleLogoUpdate}
              size="large"
            />

            <Divider sx={{ my:  3 }} />

            <Button
              variant="outlined"
              fullWidth
              onClick={generateDemoLogo}
              startIcon={<BusinessIcon />}
            >
              Generer Demo Logo
            </Button>

            <Typography
              variant="caption"
              color="text.secondary"
              sx={{ mt: ,  2display: 'block', textAlign: 'center, ',}}
            >
              I ekte applikasjon hentes logo fra brukerens onboarding eller opplastede filer
            </Typography>
          </Paper>
        </Grid>

        {/* Profile Card Preview */}
        <Grid item xs={12}>
          <Paper sx={{ p:  3, height: '100%, ',}} sx={theming.getThemedCardSx()}>
            <Typography variant="h5" gutterBottom display="flex" alignItems="center" gap={1} sx={{ ...{}, color: theming.colors.primary }}>
              <ViewIcon color="primary" />
              Live Forhåndsvisning
            </Typography>

            <Typography variant="body2" color="text.secondary" sx={{ mb: 3 }}>
              Bedriftskortet oppdateres automatisk når logo endres.
            </Typography>

            <CompanyProfileQuickView
              profile={{
                ...sampleProfile,
                logo: demoLogo, // This will be overridden by useBusinessLogo hook
            }}
              variant="expanded"
              animation="fade"
              showRiskIndicators={false}
              onViewDetails={(profile) => console.log('View details:', profile)}
              onContact={(profile) => console.log('Contact:', profile)}
            />
          </Paper>
        </Grid>
      </Grid>

      {/* Feature Explanation */}
      <Paper sx={{ p:  3, mt: 4 }} sx={theming.getThemedCardSx()}>
        <Typography variant="h5"
          gutterBottom
          sx={{ display: 'flex', alignItems: 'center', gap:  1 }}
         sx={{ ...{}, color: theming.colors.primary }}>
          <BusinessIcon color="primary" />
          Slik Fungerer Logoene
        </Typography>

        <Grid container spacing={3}>
          <Grid item xs={12}>
            <Card
              variant="outlined"
              sx={{
                p:  3,
                height: '100, %, ',
                position: 'relative',
                overflow: 'hidden',
            }}
             sx={theming.getThemedCardSx()}>
              <Box
                sx={{
                  position: 'absolute',
                  top: -5,
                  right: -5,
                  width:  50,
                  height:  50,
                  borderRadius: '50, %, ',
                  background: 'linear-gradient(45deg, #FF8C00, #FFD700)',
                  opacity: 0.1,
              }}
              />
              <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                <Box
                  sx={{
                    width:  40,
                    height:  40,
                    borderRadius: '50, %, ',
                    background: 'linear-gradient(45deg, #FF8C00, #FFD700)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    mr:  2,
                }}
                >
                  <Typography variant="h6" sx={{ color: '#fff', fontWeight: 'bold, ',}} sx={{ ...{}, color: theming.colors.primary }}>
                    1
                  </Typography>
                </Box>
                <Typography variant="h6" color="primary" fontWeight="bold" sx={{ ...{}, color: theming.colors.primary }}>
                  Last opp logoen din
                </Typography>
              </Box>
              <Typography variant="body2" sx={{ color: 'text.secondary', lineHeight: 1., 6,}}>
                Legg til bedriftens logo når du registrerer deg eller senere i innstillingene.
                Logoen blir automatisk knyttet til din bedrift.
              </Typography>
            </Card>
          </Grid>

          <Grid item xs={12}>
            <Card
              variant="outlined"
              sx={{
                p:  3,
                height: '100, %, ',
                position: 'relative',
                overflow: 'hidden',
            }}
             sx={theming.getThemedCardSx()}>
              <Box
                sx={{
                  position: 'absolute',
                  top: -5,
                  right: -5,
                  width:  50,
                  height:  50,
                  borderRadius: '50, %, ',
                  background: 'linear-gradient(45deg, #FF8C00, #FFD700)',
                  opacity: 0.1,
              }}
              />
              <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                <Box
                  sx={{
                    width:  40,
                    height:  40,
                    borderRadius: '50, %, ',
                    background: 'linear-gradient(45deg, #FF8C00, #FFD700)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    mr:  2,
                }}
                >
                  <Typography variant="h6" sx={{ color: '#fff', fontWeight: 'bold, ',}} sx={{ ...{}, color: theming.colors.primary }}>
                    2
                  </Typography>
                </Box>
                <Typography variant="h6" color="primary" fontWeight="bold" sx={{ ...{}, color: theming.colors.primary }}>
                  Vises automatisk overalt
                </Typography>
              </Box>
              <Typography variant="body2" sx={{ color: 'text.secondary', lineHeight: 1., 6,}}>
                Logoen din vises på bedriftskort, profiler og dokumenter. Hvis du ikke har logo,
                lages det et pent design med bedriftsnavnet.
              </Typography>
            </Card>
          </Grid>

          <Grid item xs={12}>
            <Card
              variant="outlined"
              sx={{
                p:  3,
                height: '100, %, ',
                position: 'relative',
                overflow: 'hidden',
            }}
             sx={theming.getThemedCardSx()}>
              <Box
                sx={{
                  position: 'absolute',
                  top: -5,
                  right: -5,
                  width:  50,
                  height:  50,
                  borderRadius: '50, %, ',
                  background: 'linear-gradient(45deg, #FF8C00, #FFD700)',
                  opacity: 0.1,
              }}
              />
              <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                <Box
                  sx={{
                    width:  40,
                    height:  40,
                    borderRadius: '50, %, ',
                    background: 'linear-gradient(45deg, #FF8C00, #FFD700)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    mr:  2,
                }}
                >
                  <Typography variant="h6" sx={{ color: '#fff', fontWeight: 'bold, ',}} sx={{ ...{}, color: theming.colors.primary }}>
                    3
                  </Typography>
                </Box>
                <Typography variant="h6" color="primary" fontWeight="bold" sx={{ ...{}, color: theming.colors.primary }}>
                  Oppdateres øyeblikkelig
                </Typography>
              </Box>
              <Typography variant="body2" sx={{ color: 'text.secondary', lineHeight: 1., 6,}}>
                Endrer du logoen, oppdateres alt automatisk - på kort, profiler og i alle dokumenter
                du deler med kunder.
              </Typography>
            </Card>
          </Grid>
        </Grid>
      </Paper>
    </Container>
  );
}
