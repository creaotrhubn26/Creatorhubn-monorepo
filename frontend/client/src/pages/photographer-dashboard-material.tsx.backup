  const { data: emailData } = useQuery({
    queryKey: ['/api/mail/unread-count', userId],
    queryFn: () => apiRequest(`/api/mail/unread-count/${userId}`),
    enabled: !!userId && userId !== 'guest',
    refetchInterval: 30000, // Check every 30 seconds
  });

  // Update unread emails state when data changes
  useEffect(() => {
