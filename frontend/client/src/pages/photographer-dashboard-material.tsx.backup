                    '& .MuiInputLabel-root.Mui-focused': { color: '#ffc107' }
                  }}
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Assistent(er)"
                  placeholder="Navn på assistent(er)"
                  sx={{
                    '& .MuiOutlinedInput-root': {
                      '&:hover fieldset': { borderColor: '#ffc107' },
                      '&.Mui-focused fieldset': { borderColor: '#ffc107' }
                    },
                    '& .MuiInputLabel-root.Mui-focused': { color: '#ffc107' }
                  }}
                />
              </Grid>
              <Grid item xs={12}>
                <Typography variant="h6" sx={{ mb: 2, color: '#ffc107' }}>Utstyr & Ressurser</Typography>
                <Grid container spacing={2}>
                  <Grid item xs={12} md={4}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#ffc107', '&.Mui-checked': { color: '#ffc107' } }} />}
                      label="Hovedkamera"
                    />
                  </Grid>
                  <Grid item xs={12} md={4}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#ffc107', '&.Mui-checked': { color: '#ffc107' } }} />}
                      label="Reservekamera"
                    />
                  </Grid>
                  <Grid item xs={12} md={4}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#ffc107', '&.Mui-checked': { color: '#ffc107' } }} />}
                      label="Ekstra objektiver"
                    />
                  </Grid>
                  <Grid item xs={12} md={4}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#ffc107', '&.Mui-checked': { color: '#ffc107' } }} />}
                      label="Blitseutstyr"
                    />
                  </Grid>
                  <Grid item xs={12} md={4}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#ffc107', '&.Mui-checked': { color: '#ffc107' } }} />}
                      label="Stativer"
                    />
                  </Grid>
                  <Grid item xs={12} md={4}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#ffc107', '&.Mui-checked': { color: '#ffc107' } }} />}
                      label="Minnekort & batterier"
                    />
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
          </Box>
        );

      case 5:
        return (
          <Box sx={{ 
            background: 'linear-gradient(135deg, rgba(63, 81, 181, 0.05), rgba(121, 134, 203, 0.02))',
            borderRadius: 3,
            p: 4,
            border: '1px solid rgba(63, 81, 181, 0.1)'
          }}>
            <Box sx={{ display: 'flex', alignItems: 'center', mb: 4 }}>
              <Box sx={{
                background: 'linear-gradient(135deg, #3f51b5, #7986cb)',
                borderRadius: '50%',
                width: 60,
                height: 60,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                mr: 3
              }}>
                <Typography variant="h4" sx={{ color: 'white', fontWeight: 700 }}>📦</Typography>
              </Box>
              <Box>
                <Typography variant="h4" sx={{ fontWeight: 700, color: '#3f51b5', mb: 1 }}>
                  Steg 6: Leveranser & Kvalitet
                </Typography>
                <Typography variant="body1" color="textSecondary">
                  Definering av leveranser og kvalitetsstandarder
                </Typography>
              </Box>
            </Box>

            <Grid container spacing={4}>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Antall bearbeidede bilder"
                  type="number"
                  defaultValue="50"
                  sx={{
                    '& .MuiOutlinedInput-root': {
                      '&:hover fieldset': { borderColor: '#3f51b5' },
                      '&.Mui-focused fieldset': { borderColor: '#3f51b5' }
                    },
                    '& .MuiInputLabel-root.Mui-focused': { color: '#3f51b5' }
                  }}
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Leveringstidspunkt"
                  placeholder="F.eks. 2-3 uker etter arrangement"
                  sx={{
                    '& .MuiOutlinedInput-root': {
                      '&:hover fieldset': { borderColor: '#3f51b5' },
                      '&.Mui-focused fieldset': { borderColor: '#3f51b5' }
                    },
                    '& .MuiInputLabel-root.Mui-focused': { color: '#3f51b5' }
                  }}
                />
              </Grid>
              <Grid item xs={12}>
                <Typography variant="h6" sx={{ mb: 2, color: '#3f51b5' }}>Leveranseformat</Typography>
                <Grid container spacing={2}>
                  <Grid item xs={12} md={4}>
                    <FormControlLabel
                      control={<Checkbox defaultChecked sx={{ color: '#3f51b5', '&.Mui-checked': { color: '#3f51b5' } }} />}
