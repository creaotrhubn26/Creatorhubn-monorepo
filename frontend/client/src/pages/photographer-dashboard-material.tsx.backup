  // API Integration with React Query
  const queryClient = useQueryClient();
  
  // Get user session for API calls
  const { data: userSession } = useQuery({
    queryKey: ['userSession'],
    queryFn: () => apiRequest('/api/auth/public-session'),
    retry: false
  });
  
  const userId = userSession?.userId || 'guest';
  
  // Fetch comprehensive business intelligence data
  const { data: businessIntelligence = [] } = useQuery({
    queryKey: ['/api/business-intelligence', userId],
    queryFn: () => apiRequest(`/api/business-intelligence/${userId}`),
    enabled: !!userId && userId !== 'guest'
  });
  
  // Fetch service integrations status
  const { data: serviceIntegrations = [] } = useQuery({
    queryKey: ['/api/integrations/services', userId],
    queryFn: () => apiRequest(`/api/integrations/services/${userId}`),
    enabled: !!userId && userId !== 'guest'
  });
  
  // Fetch GDPR compliance status
  const { data: gdprConsents = [] } = useQuery({
    queryKey: ['/api/compliance/gdpr-consents', userId],
    queryFn: () => apiRequest(`/api/compliance/gdpr-consents/${userId}`),
    enabled: !!userId && userId !== 'guest'
  });
  
  // Fetch tax compliance data
  const { data: taxCompliance = [] } = useQuery({
    queryKey: ['/api/compliance/tax-compliance', userId],
    queryFn: () => apiRequest(`/api/compliance/tax-compliance/${userId}`),
    enabled: !!userId && userId !== 'guest'
  });
  
  // Fetch performance metrics
  const { data: performanceMetrics = [] } = useQuery({
    queryKey: ['/api/performance/metrics'],
    queryFn: () => apiRequest('/api/performance/metrics')
  });
  
  // Fetch AI image analysis data
  const { data: aiImageAnalysis = [] } = useQuery({
    queryKey: ['/api/ai/image-analysis', userId],
    queryFn: () => apiRequest(`/api/ai/image-analysis/${userId}`),
    enabled: !!userId && userId !== 'guest'
  });
  
  // Fetch equipment monitoring data
  const { data: equipmentMonitoring = [] } = useQuery({
    queryKey: ['/api/equipment/monitoring', userId],
    queryFn: () => apiRequest(`/api/equipment/monitoring/${userId}`),
    enabled: !!userId && userId !== 'guest'
  });
  
  // Fetch live equipment pricing
  const { data: liveEquipmentPricing = [] } = useQuery({
    queryKey: ['/api/equipment/live-pricing'],
    queryFn: () => apiRequest('/api/equipment/live-pricing')
