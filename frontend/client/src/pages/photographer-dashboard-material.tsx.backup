                                {project.type === 'familie' && '👨‍👩‍👧‍👦 Familiefotografering'}
                                {project.type === 'portrett' && '👤 Portrettfotografering'}
                                {project.type === 'event' && '🎉 Eventfotografering'}
                                {project.type === 'bedrift' && '🏢 Bedriftsfotografering'}
                              </Typography>
