                    />
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
          </Box>
        );

      case 6:
        return (
          <Box sx={{ 
            background: 'linear-gradient(135deg, rgba(244, 67, 54, 0.05), rgba(229, 115, 115, 0.02))',
            borderRadius: 3,
            p: 4,
            border: '1px solid rgba(244, 67, 54, 0.1)'
          }}>
            <Box sx={{ display: 'flex', alignItems: 'center', mb: 4 }}>
              <Box sx={{
                background: 'linear-gradient(135deg, #f44336, #e57373)',
                borderRadius: '50%',
                width: 60,
                height: 60,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                mr: 3
              }}>
                <Typography variant="h4" sx={{ color: 'white', fontWeight: 700 }}>⚠️</Typography>
              </Box>
              <Box>
                <Typography variant="h4" sx={{ fontWeight: 700, color: '#f44336', mb: 1 }}>
                  Steg 7: Risikostyring
                </Typography>
                <Typography variant="body1" color="textSecondary">
                  Identifisering og håndtering av potensielle risikoer
                </Typography>
              </Box>
            </Box>

            <Grid container spacing={4}>
              <Grid item xs={12}>
                <Typography variant="h6" sx={{ mb: 2, color: '#f44336' }}>Potensielle Risikoer</Typography>
                <Grid container spacing={2}>
                  <Grid item xs={12} md={6}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#f44336', '&.Mui-checked': { color: '#f44336' } }} />}
                      label="Værforhold (utendørs fotografering)"
                    />
                  </Grid>
                  <Grid item xs={12} md={6}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#f44336', '&.Mui-checked': { color: '#f44336' } }} />}
                      label="Utstyrsfeil eller tekniske problemer"
                    />
                  </Grid>
                  <Grid item xs={12} md={6}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#f44336', '&.Mui-checked': { color: '#f44336' } }} />}
                      label="Lokasjonsproblemer eller endringer"
                    />
                  </Grid>
                  <Grid item xs={12} md={6}>
                    <FormControlLabel
                      control={<Checkbox sx={{ color: '#f44336', '&.Mui-checked': { color: '#f44336' } }} />}
                      label="Sykdom eller nødsituasjoner"
                    />
                  </Grid>
                </Grid>
              </Grid>
              <Grid item xs={12}>
                <TextField
                  fullWidth
                  label="Beredskapsplan"
                  multiline
                  rows={4}
                  placeholder="Beskriv hvordan potensielle problemer skal håndteres..."
                  sx={{
                    '& .MuiOutlinedInput-root': {
                      '&:hover fieldset': { borderColor: '#f44336' },
                      '&.Mui-focused fieldset': { borderColor: '#f44336' }
                    },
                    '& .MuiInputLabel-root.Mui-focused': { color: '#f44336' }
                  }}
                />
              </Grid>
            </Grid>
          </Box>
        );

      case 7:
        return (
          <Box sx={{ 
            background: 'linear-gradient(135deg, rgba(0, 150, 136, 0.05), rgba(77, 182, 172, 0.02))',
            borderRadius: 3,
            p: 4,
            border: '1px solid rgba(0, 150, 136, 0.1)'
          }}>
            <Box sx={{ display: 'flex', alignItems: 'center', mb: 4 }}>
              <Box sx={{
                background: 'linear-gradient(135deg, #009688, #4db6ac)',
                borderRadius: '50%',
                width: 60,
                height: 60,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                mr: 3
              }}>
                <Typography variant="h4" sx={{ color: 'white', fontWeight: 700 }}>💬</Typography>
              </Box>
              <Box>
                <Typography variant="h4" sx={{ fontWeight: 700, color: '#009688', mb: 1 }}>
                  Steg 8: Kommunikasjonsplan
                </Typography>
                <Typography variant="body1" color="textSecondary">
                  Planlegging av kommunikasjon med klient
                </Typography>
              </Box>
            </Box>

            <Grid container spacing={4}>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Foretrukket kommunikasjonsmåte"
                  select
                  defaultValue="email"
                  sx={{
                    '& .MuiOutlinedInput-root': {
                      '&:hover fieldset': { borderColor: '#009688' },
                      '&.Mui-focused fieldset': { borderColor: '#009688' }
                    },
                    '& .MuiInputLabel-root.Mui-focused': { color: '#009688' }
                  }}
                >
                  <MenuItem value="email">E-post</MenuItem>
                  <MenuItem value="phone">Telefon</MenuItem>
                  <MenuItem value="sms">SMS</MenuItem>
                  <MenuItem value="whatsapp">WhatsApp</MenuItem>
                </TextField>
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Møtefrekvens"
                  select
                  defaultValue="weekly"
                  sx={{
                    '& .MuiOutlinedInput-root': {
                      '&:hover fieldset': { borderColor: '#009688' },
                      '&.Mui-focused fieldset': { borderColor: '#009688' }
                    },
                    '& .MuiInputLabel-root.Mui-focused': { color: '#009688' }
                  }}
                >
                  <MenuItem value="daily">Daglig</MenuItem>
                  <MenuItem value="weekly">Ukentlig</MenuItem>
                  <MenuItem value="biweekly">Hver 14. dag</MenuItem>
                  <MenuItem value="monthly">Månedlig</MenuItem>
                </TextField>
              </Grid>
              <Grid item xs={12}>
                <Typography variant="h6" sx={{ mb: 2, color: '#009688' }}>Kommunikasjonsmilepæler</Typography>
                <Grid container spacing={2}>
                  <Grid item xs={12}>
                    <FormControlLabel
                      control={<Checkbox defaultChecked sx={{ color: '#009688', '&.Mui-checked': { color: '#009688' } }} />}
                      label="Planleggingsmøte (1-2 uker før)"
                    />
                  </Grid>
                  <Grid item xs={12}>
                    <FormControlLabel
                      control={<Checkbox defaultChecked sx={{ color: '#009688', '&.Mui-checked': { color: '#009688' } }} />}
                      label="Bekreftelse dag før arrangement"
                    />
                  </Grid>
                  <Grid item xs={12}>
                    <FormControlLabel
                      control={<Checkbox defaultChecked sx={{ color: '#009688', '&.Mui-checked': { color: '#009688' } }} />}
                      label="Oppdatering under redigering"
                    />
                  </Grid>
                  <Grid item xs={12}>
                    <FormControlLabel
                      control={<Checkbox defaultChecked sx={{ color: '#009688', '&.Mui-checked': { color: '#009688' } }} />}
                      label="Leveringsnotifikasjon"
                    />
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
          </Box>
        );

      default:
        return (
          <Box sx={{ textAlign: 'center', py: 8 }}>
            <CheckCircle sx={{ fontSize: 64, color: '#4caf50', mb: 2 }} />
            <Typography variant="h5" sx={{ mb: 2 }}>Alle steg fullført!</Typography>
            <Typography variant="body1" color="textSecondary">
              Prosjektet er klart for opprettelse
            </Typography>
          </Box>
        );
    }
  };

  // Submit Handler
  const handleComprehensiveProjectSubmit = useCallback(() => {
    if (!comprehensiveProjectForm.name || !comprehensiveProjectForm.type) {
      console.error('Missing required fields');
      return;
    }

    const projectData = {
      name: comprehensiveProjectForm.name,
      type: comprehensiveProjectForm.type,
      description: comprehensiveProjectForm.description,
      eventDate: comprehensiveProjectForm.eventDate,
      totalAmount: comprehensiveProjectForm.basePrice * (1 + comprehensiveProjectForm.vatRate / 100),
      clientName: comprehensiveProjectForm.clientName,
      clientEmail: comprehensiveProjectForm.clientEmail,
      status: 'planning',
      userId: user?.id || 'guest'
    };

    createProjectMutation.mutate(projectData);
  }, [comprehensiveProjectForm, user, createProjectMutation]);

  return (
    <Container maxWidth="xl" sx={{ 
      py: 4,
      pb: 12, // Extra bottom padding to prevent SpeedDial overlap
      minHeight: '100vh'
    }}>
      {/* Header */}
      <Box sx={{ 
        background: 'linear-gradient(135deg, rgba(255, 140, 0, 0.1), rgba(255, 165, 0, 0.05))',
        borderRadius: 3,
        p: 3,
        mb: 4,
        border: '1px solid rgba(255, 140, 0, 0.2)'
      }}>
        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <Box>
            <Typography variant="h3" sx={{ 
              fontWeight: 700,
              background: 'linear-gradient(135deg, #ff8c00, #ffa500)',
              backgroundClip: 'text',
              WebkitBackgroundClip: 'text',
              WebkitTextFillColor: 'transparent',
              mb: 1 
            }}>
              📸 Fotograf Dashboard
            </Typography>
            <Typography variant="h6" color="textSecondary">
              Velkommen tilbake, {user?.firstName || 'Fotograf'}!
            </Typography>
          </Box>
          <Box sx={{ display: 'flex', gap: 1 }}>
            <TutorialIntegrationButton 
              userType="photographer" 
              variant="contained" 
              size="small"
            />
            <Badge 
              badgeContent={unreadEmails} 
              color="error"
              sx={{
                '& .MuiBadge-badge': {
                  right: -3,
                  top: 3,
                  fontSize: '0.6rem',
                  height: 16,
                  minWidth: 16
                }
              }}
            >
              <Button
                variant="contained"
                size="small"
                startIcon={<Email sx={{ fontSize: '1rem' }} />}
                onClick={async () => {
                  setShowMailInterface(true);
                  setUnreadEmails(0); // Clear notifications when opening mail
                  
                  // Mark emails as read on server
                  try {
                    await apiRequest(`/api/mail/mark-read/${userId}`, {
                      method: 'POST'
                    });
                  } catch (error) {
                    console.log('Could not mark emails as read:', error);
                  }
                }}
                sx={{
                  background: 'linear-gradient(135deg, #1976d2, #1565c0)',
                  '&:hover': {
                    background: 'linear-gradient(135deg, #1565c0, #1976d2)'
                  },
                  minWidth: 'auto',
                  px: 1.5,
                  fontSize: '0.75rem'
                }}
              >
                E-post
              </Button>
            </Badge>
            <Button
              variant="contained"
              size="small"
              startIcon={<Settings sx={{ fontSize: '1rem' }} />}
              onClick={() => setShowSettingsModal(true)}
              sx={{
                background: 'linear-gradient(135deg, #ff8c00, #ffa500)',
                '&:hover': {
                  background: 'linear-gradient(135deg, #e67e00, #ff8c00)'
                },
                minWidth: 'auto',
                px: 1.5,
                fontSize: '0.75rem'
              }}
            >
              Innstillinger
            </Button>
          </Box>
        </Box>
        

        

        

      </Box>

      {/* Compact Quick Actions - Floating SpeedDial */}
      <Box sx={{ position: 'fixed', bottom: 100, right: 20, zIndex: 1000 }}>
        <SpeedDial
          ariaLabel="Hurtighandlinger"
          sx={{ 
            '& .MuiFab-primary': { 
              background: 'linear-gradient(135deg, #ff8c00, #ffa500)',
              '&:hover': { background: 'linear-gradient(135deg, #e67e00, #ff8c00)' }
            }
          }}
          icon={<Speed />}
          direction="up"
        >
          <SpeedDialAction
            key="nytt-prosjekt"
            icon={<Add />}
            tooltipTitle="Nytt Prosjekt"
            onClick={() => setShowProjectModal(true)}
            sx={{ 
              '& .MuiFab-primary': { 
                background: 'linear-gradient(135deg, #2196f3, #21cbf3)' 
              }
            }}
          />
          <SpeedDialAction
            key="epost"
            icon={<Email />}
            tooltipTitle="Send E-post"
            onClick={() => setShowMailInterface(true)}
            sx={{ 
              '& .MuiFab-primary': { 
                background: 'linear-gradient(135deg, #4caf50, #8bc34a)' 
              }
            }}
          />
          <SpeedDialAction
            key="chat"
            icon={<Chat />}
            tooltipTitle="Chat"
            onClick={() => setShowChatSystem(true)}
            sx={{ 
              '& .MuiFab-primary': { 
                background: 'linear-gradient(135deg, #9c27b0, #e1bee7)' 
              }
            }}
          />
          <SpeedDialAction
            key="kalender"
            icon={<CalendarToday />}
            tooltipTitle="Kalender"
            onClick={() => window.open('/calendar', '_blank')}
            sx={{ 
              '& .MuiFab-primary': { 
                background: 'linear-gradient(135deg, #ff9800, #ffb74d)' 
              }
            }}
          />
          <SpeedDialAction
            key="analyser"
            icon={<Assessment />}
            tooltipTitle="Analyser"
            onClick={() => setTabValue(7)}
            sx={{ 
              '& .MuiFab-primary': { 
                background: 'linear-gradient(135deg, #f44336, #e57373)' 
              }
            }}
          />
          <SpeedDialAction
            key="innstillinger"
            icon={<Settings />}
            tooltipTitle="Innstillinger"
            onClick={() => setShowSettingsModal(true)}
            sx={{ 
              '& .MuiFab-primary': { 
                background: 'linear-gradient(135deg, #607d8b, #90a4ae)' 
              }
            }}
          />
        </SpeedDial>
      </Box>







      {/* Main Tabs */}
      <Paper sx={{ background: 'rgba(255, 255, 255, 0.9)' }}>
        <Tabs 
          value={tabValue} 
          onChange={(_, newValue) => setTabValue(newValue)}
          variant="scrollable"
          scrollButtons="auto"
          sx={{ 
            borderBottom: 1, 
            borderColor: 'divider',
            '& .MuiTab-root': {
              fontWeight: 600,
              minWidth: 140,
              fontSize: '0.9rem',
              '&.Mui-selected': {
                color: '#ff8c00'
              }
            },
            '& .MuiTabs-indicator': {
              backgroundColor: '#ff8c00',
              height: 3
            }
          }}
        >
          <Tab label="📊 Oversikt" icon={<Camera />} />
          <Tab label="⚙️ Prosjektadministrasjon" icon={<Assignment />} />
          <Tab label="📄 Business & Kontrakter" icon={<Business />} />
          <Tab label="🎨 Kreativ Studio" icon={<Star />} />
          <Tab label="🔧 Utstyr & Ressurser" icon={<Build />} />
          <Tab label="📈 Markedsføring & Salg" icon={<Campaign />} />
          <Tab label="📊 Rapporter & Analyse" icon={<Assessment />} />
          <Tab label="⚙️ Systeminnstillinger" icon={<Settings />} />
        </Tabs>

        {/* Tab Content */}
        <Box sx={{ p: 3 }}>
          {tabValue === 0 && (
            <Box>
              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
                <Typography variant="h5" sx={{ fontWeight: 600, color: '#ff8c00' }}>
                  Dashboard Oversikt
                </Typography>
                <Button
                  variant="contained"
                  startIcon={<Add />}
                  onClick={() => setShowProjectModal(true)}
                  sx={{
                    background: 'linear-gradient(135deg, #ff8c00, #ffa500)',
                    '&:hover': {
                      background: 'linear-gradient(135deg, #e67e00, #ff8c00)'
                    }
                  }}
                >
                  Nytt Prosjekt
                </Button>
              </Box>
              
              {/* Key Performance Indicators */}
              <Paper sx={{ 
                background: 'linear-gradient(135deg, rgba(255, 140, 0, 0.05), rgba(255, 165, 0, 0.02))',
                border: '1px solid rgba(255, 140, 0, 0.1)',
                p: 2, 
                mb: 3 
              }}>
                <Typography variant="h6" sx={{ fontWeight: 600, color: '#ff8c00', mb: 2 }}>
                  📊 Nøkkeltall
                </Typography>
                <Grid container spacing={2}>
                  <Grid item xs={6} md={3}>
                    <Box 
                      onClick={() => setTabValue(1)}
                      sx={{ 
                        display: 'flex', 
                        alignItems: 'center', 
                        cursor: 'pointer',
                        p: 1.5,
                        borderRadius: 2,
                        transition: 'all 0.2s ease',
                        '&:hover': { 
                          background: 'rgba(33, 150, 243, 0.05)',
                          transform: 'translateY(-1px)' 
                        }
                      }}
                    >
                      <Avatar sx={{ bgcolor: '#2196f3', mr: 1.5, width: 32, height: 32 }}>
                        <Camera sx={{ fontSize: '1.1rem' }} />
                      </Avatar>
                      <Box sx={{ minWidth: 0, flex: 1 }}>
                        <Typography variant="body2" sx={{ fontWeight: 600, color: '#2196f3', fontSize: '0.8rem' }}>
                          Prosjekter
                        </Typography>
                        <Typography variant="h6" sx={{ fontWeight: 700, lineHeight: 1 }}>
                          {totalProjects}
                        </Typography>
                      </Box>
                    </Box>
                  </Grid>

                  <Grid item xs={6} md={3}>
                    <Box 
                      onClick={() => setTabValue(6)}
                      sx={{ 
                        display: 'flex', 
                        alignItems: 'center', 
                        cursor: 'pointer',
                        p: 1.5,
                        borderRadius: 2,
                        transition: 'all 0.2s ease',
                        '&:hover': { 
                          background: 'rgba(76, 175, 80, 0.05)',
                          transform: 'translateY(-1px)' 
                        }
                      }}
                    >
                      <Avatar sx={{ bgcolor: '#4caf50', mr: 1.5, width: 32, height: 32 }}>
                        <AttachMoney sx={{ fontSize: '1.1rem' }} />
                      </Avatar>
                      <Box sx={{ minWidth: 0, flex: 1 }}>
                        <Typography variant="body2" sx={{ fontWeight: 600, color: '#4caf50', fontSize: '0.8rem' }}>
                          Inntekt
                        </Typography>
                        <Typography variant="h6" sx={{ fontWeight: 700, lineHeight: 1 }}>
                          {Math.round(totalRevenue / 1000)}k NOK
                        </Typography>
                      </Box>
                    </Box>
                  </Grid>

                  <Grid item xs={6} md={3}>
                    <Box sx={{ 
                      display: 'flex', 
                      alignItems: 'center', 
                      cursor: 'pointer',
                      p: 1.5,
                      borderRadius: 2,
                      transition: 'all 0.2s ease',
                      '&:hover': { 
                        background: 'rgba(156, 39, 176, 0.05)',
                        transform: 'translateY(-1px)' 
                      }
                    }}>
                      <Avatar sx={{ bgcolor: '#9c27b0', mr: 1.5, width: 32, height: 32 }}>
                        <Build sx={{ fontSize: '1.1rem' }} />
                      </Avatar>
                      <Box sx={{ minWidth: 0, flex: 1 }}>
                        <Typography variant="body2" sx={{ fontWeight: 600, color: '#9c27b0', fontSize: '0.8rem' }}>
                          Utstyr
                        </Typography>
                        <Typography variant="h6" sx={{ fontWeight: 700, lineHeight: 1 }}>
                          {totalEquipment}
                        </Typography>
                      </Box>
