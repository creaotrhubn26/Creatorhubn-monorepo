                    <Box>
                      <Typography variant="body2" color="textSecondary">Telefon:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 600 }}>+47 123 45 678</Typography>
                    </Box>
                    <Box>
                      <Typography variant="body2" color="textSecondary">Lokasjon:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 600 }}>Stavanger Domkirke</Typography>
                    </Box>
                  </Box>
                </Paper>
              </Grid>
            </Grid>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowProjectDetailsModal(false)}>
            Lukk
          </Button>
          <Button 
            variant="contained" 
            startIcon={<Edit />}
            sx={{ bgcolor: '#007bff', '&:hover': { bgcolor: '#0056b3' } }}
            onClick={() => {
              setShowProjectDetailsModal(false);
              setShowEditProjectModal(true);
            }}
          >
            Rediger Prosjekt
          </Button>
        </DialogActions>
      </Dialog>
    </Container>
  );
}
