  // Calculate progress percentages
  const projectsProgress = Math.min((totalProjects / 20) * 100, 100);
  const revenueProgress = Math.min((totalRevenue / 200000) * 100, 100);
  const equipmentProgress = Math.min((totalEquipment / 25) * 100, 100);

