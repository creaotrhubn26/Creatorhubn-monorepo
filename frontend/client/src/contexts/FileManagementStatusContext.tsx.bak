/**
 * File Management Status Context
 * Manages and broadcasts real-time file management system status across components
 */

import React, { createContext, useContext, useState, useEffect, ReactNode } from 'react';

interface FileManagementStatus {
  // System Status
  isConnected: boolean;
  lastCheck: Date | null;
  systemStatus: 'connected' | 'disconnected' | 'testing';
  systemHealthy: boolean;
  activeOperations: number;
  
  // Google Drive Status
  googleDriveStatus: 'connected' | 'disconnected' | 'testing';
  googleDriveResponse: string;
  googleDriveLastCheck: Date | null;
  
  // Google Photos Status
  googlePhotosStatus: 'connected' | 'disconnected' | 'testing';
  googlePhotosResponse: string;
  googlePhotosLastCheck: Date | null;
  
  // Upload/Download Stats
  uploadStats: {
    active: number;
    completed: number;
    failed: number;
};
  downloadStats: {
    active: number;
    completed: number;
    failed: number;
};
  
  // Service Health
  uploadService: string;
  downloadService: string;
  storageService: string;
}

interface FileManagementStatusContextType {
  status: FileManagementStatus;
  updateStatus: (updates: Partial<FileManagementStatus>) => void;
  testFileSystem: () => Promise<void>;
  testGoogleDrive: () => Promise<void>;
  testGooglePhotos: () => Promise<void>;
}

const FileManagementStatusContext = createContext<FileManagementStatusContextType | undefined>(undefined);

interface FileManagementStatusProviderProps {
  children: ReactNode;
}

export function FileManagementStatusProvider({ children }: FileManagementStatusProviderProps) {
  const [status, setStatus] = useState<FileManagementStatus>({
    isConnected: false,
    lastCheck: null,
    systemStatus: 'testing',
    systemHealthy: false,
    activeOperations: 0,
    googleDriveStatus: 'testing',
    googleDriveResponse: '',
    googleDriveLastCheck: null,
    googlePhotosStatus: 'testing',
    googlePhotosResponse: '',
    googlePhotosLastCheck: null,
    uploadStats: {
      active: 0,
      completed: 0,
      failed: 0
},
    downloadStats: {
      active: 0,
      completed: 0,
      failed: 0
},
    uploadService: 'unknown',
    downloadService: 'unknown',
    storageService: 'unknown'
});

  const updateStatus = (updates: Partial<FileManagementStatus>) => {
    setStatus(prev => ({
      ...prev,
      ...updates,
      lastCheck: new Date()
}));
};

  const testFileSystem = async () => {
    try {
      const response = await fetch('/api/file-management/health');
      const data = await response.json();
      
      updateStatus({
        isConnected: response.status === 200,
        systemStatus: response.status === 200 ? 'connected' : 'disconnected',
        systemHealthy: data.status === 'ok',
        uploadService: data.uploadService || 'unknown',
        downloadService: data.downloadService || 'unknown',
        storageService: data.storageService || 'unknown'
    });

      // Get stats
      const statsResponse = await fetch('/api/file-management/stats');
      const statsData = await statsResponse.json();
      
      updateStatus({
        activeOperations: statsData.activeOperations || 0,
        uploadStats: statsData.upload || { active: 0, completed: 0, failed: 0 },
        downloadStats: statsData.download || { active: 0, completed: 0, failed: 0 }
    });
  } catch (error) {
      console.error('File system health check failed:', error);
      updateStatus({
        isConnected: false,
        systemStatus: 'disconnected',
        systemHealthy: false
    });
  }
};

  const testGoogleDrive = async () => {
    try {
      const response = await fetch('/api/file-management/google-drive/status');
      const data = await response.json();
      const isConnected = response.status === 200;
      
      updateStatus({
        googleDriveStatus: isConnected ? 'connected' : 'disconnected',
        googleDriveResponse: isConnected ? '200 OK' : `Error: ${response.status}`,
        googleDriveLastCheck: new Date()
    });
  } catch (error) {
      console.error('Google Drive test failed:', error);
      updateStatus({
        googleDriveStatus: 'disconnected',
        googleDriveResponse: `Error: ${error instanceof Error ? error.message : String(error)}`,
        googleDriveLastCheck: new Date()
    });
  }
};

  const testGooglePhotos = async () => {
    try {
      const response = await fetch('/api/file-management/google-photos/status');
      const data = await response.json();
      const isConnected = response.status === 200;
      
      updateStatus({
        googlePhotosStatus: isConnected ? 'connected' : 'disconnected',
        googlePhotosResponse: isConnected ? '200 OK' : `Error: ${response.status}`,
        googlePhotosLastCheck: new Date()
    });
  } catch (error) {
      console.error('Google Photos test failed:', error);
      updateStatus({
        googlePhotosStatus: 'disconnected',
        googlePhotosResponse: `Error: ${error instanceof Error ? error.message : String(error)}`,
        googlePhotosLastCheck: new Date()
    });
  }
};

  // Auto-test on mount and periodically
  useEffect(() => {
    testFileSystem();
    testGoogleDrive();
    testGooglePhotos();

    const interval = setInterval(() => {
      testFileSystem();
      testGoogleDrive();
      testGooglePhotos();
  }, 30000); // Check every 30 seconds

    return () => clearInterval(interval);
}, []);

  const value: FileManagementStatusContextType = {
    status,
    updateStatus,
    testFileSystem,
    testGoogleDrive,
    testGooglePhotos
};

  return (
    <FileManagementStatusContext.Provider value={value}>
      {children}
    </FileManagementStatusContext.Provider>
  );
}

export function useFileManagementStatus() {
  const context = useContext(FileManagementStatusContext);
  if (context === undefined) {
    throw new Error('useFileManagementStatus must be used within a FileManagementStatusProvider');
}
  return context;
}



