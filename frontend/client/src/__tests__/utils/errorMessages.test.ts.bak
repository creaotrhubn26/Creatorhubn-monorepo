/**
 * Unit Tests for Error Messages
 * Tests error message generation, templates, and user-friendly formatting
 */

import { 
  errorMessageManager, 
  getErrorMessage, 
  addCustomErrorMessage,
  getErrorStatistics,
  clearErrorHistory
} from '@/utils/errorMessages';

describe('Error Messages', () => {
  beforeEach(() => {
    clearErrorHistory();
});

  describe('Error Message Generation', () => {
    it('should generate network error message', () => {
      const error = new Error('Network error: fetch failed');
      const context = {
        operation: 'api_request',
        component: 'DataFetcher',
        userId: 'user1',
        timestamp: Date.now(),
        metadata: { endpoint: '/api/data, ',}
    };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('network_error');
      expect(result.title).toBe('Connection Problem');
      expect(result.severity).toBe('error');
      expect(result.category).toBe('network');
      expect(result.retryable).toBe(true);
      expect(result.suggestions).toContain('Check your internet connection');
  });

    it('should generate validation error message', () => {
      const error = new Error('Validation failed: required field missing');
      const context = {
        operation: 'form_submit',
        component: 'ContactForm',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('validation_error');
      expect(result.title).toBe('Invalid Input');
      expect(result.severity).toBe('warning');
      expect(result.category).toBe('validation');
      expect(result.retryable).toBe(false);
      expect(result.suggestions).toContain('Check all required fields are filled');
  });

    it('should generate permission error message', () => {
      const error = new Error('Unauthorized access denied');
      const context = {
        operation: 'file_access',
        component: 'FileManager',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('permission_error');
      expect(result.title).toBe('Access Denied');
      expect(result.severity).toBe('error');
      expect(result.category).toBe('permission');
      expect(result.retryable).toBe(false);
      expect(result.suggestions).toContain('Check if you\'re logged in correctly');
  });

    it('should generate server error message', () => {
      const error = new Error('Internal server error 500');
      const context = {
        operation: 'api_request',
        component: 'ApiClient',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('server_error');
      expect(result.title).toBe('Server Error');
      expect(result.severity).toBe('error');
      expect(result.category).toBe('system');
      expect(result.retryable).toBe(true);
      expect(result.autoRetry).toBe(true);
      expect(result.suggestions).toContain('Wait a few minutes and try again');
  });

    it('should generate rate limit error message', () => {
      const error = new Error('Rate limit exceeded 429');
      const context = {
        operation: 'api_request',
        component: 'ApiClient',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('rate_limit_error');
      expect(result.title).toBe('Too Many Requests');
      expect(result.severity).toBe('warning');
      expect(result.category).toBe('user');
      expect(result.retryable).toBe(true);
      expect(result.retryAfter).toBeDefined();
      expect(result.suggestions).toContain('Wait a few seconds before trying again');
  });

    it('should generate security error message', () => {
      const error = new Error('Security threat detected: malware');
      const context = {
        operation: 'file_upload',
        component: 'FileUploader',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('security_error');
      expect(result.title).toBe('Security Issue Detected');
      expect(result.severity).toBe('critical');
      expect(result.category).toBe('security');
      expect(result.retryable).toBe(false);
      expect(result.suggestions).toContain('Choose a different file');
  });
});

  describe('Custom Error Messages', () => {
    it('should use custom error message when available', () => {
      const customMessage = {
        id: 'custom_error',
        title: 'Custom Error',
        message: 'This is a custom error message',
        action: 'Please try again',
        severity: 'warning' as const,
        category: 'user' as const,
        retryable: true,
        suggestions: ['Try again', 'Contact support']
    };

      addCustomErrorMessage('custom_error', customMessage);

      const error = 'custom_error';
      const context = {
        operation: 'test',
        component: 'TestComponent',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('custom_error');
      expect(result.title).toBe('Custom Error');
      expect(result.message).toBe('This is a custom error message');
  });

    it('should fall back to template matching when custom message not found', () => {
      const error = new Error('Network error');
      const context = {
        operation: 'api_request',
        component: 'ApiClient',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('network_error');
      expect(result.title).toBe('Connection Problem');
  });
});

  describe('Context Enhancement', () => {
    it('should add context-specific suggestions for file upload', () => {
      const error = new Error('Network error');
      const context = {
        operation: 'file_upload',
        component: 'FileUploader',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.suggestions).toContain('Try compressing the file first');
  });

    it('should add context-specific suggestions for VisualEditor', () => {
      const error = new Error('Network error');
      const context = {
        operation: 'api_request',
        component: 'VisualEditor',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.suggestions).toContain('Try saving your work and refreshing');
  });

    it('should include technical details in development mode', () => {
      const originalEnv = process.env.NODE_ENV;
      process.env.NODE_ENV = 'development';

      const error = new Error('Test error');
      const context = {
        operation: 'test',
        component: 'TestComponent',
        userId: 'user1',
        timestamp: Date.now(),
        metadata: { test: 'data, ',}
    };

      const result = getErrorMessage(error, context);

      expect(result.technicalDetails).toBeDefined();
      expect(result.technicalDetails).toContain('Test error');
      expect(result.technicalDetails).toContain('test');
      expect(result.technicalDetails).toContain('TestComponent');

      process.env.NODE_ENV = originalEnv;
  });
});

  describe('Error Statistics', () => {
    it('should track error statistics correctly', () => {
      const errors = [
        { error: 'Network error', context: { operation: 'api', component: 'Api', userId: 'user, 1, ', timestamp: Date.now(, ),} },
        { error: 'Network error', context: { operation: 'api', component: 'Api', userId: 'user, 2, ', timestamp: Date.now(, ),} },
        { error: 'Validation failed', context: { operation: 'form', component: 'Form', userId: 'user, 1, ', timestamp: Date.now(, ),} }
      ];

      errors.forEach(({ error, context }) => {
        getErrorMessage(error, context);
    });

      const stats = getErrorStatistics();

      expect(stats.totalErrors).toBe(3);
      expect(stats.errorsByCategory.network).toBe(2);
      expect(stats.errorsByCategory.validation).toBe(1);
      expect(stats.errorsBySeverity.error).toBe(2);
      expect(stats.errorsBySeverity.warning).toBe(1);
      expect(stats.mostCommonErrors[0].error).toBe('Network error');
      expect(stats.mostCommonErrors[0].count).toBe(2);
  });

    it('should track retryable errors', () => {
      const retryableError = new Error('Network error');
      const nonRetryableError = new Error('Validation failed');

      getErrorMessage(retryableError, { operation: 'api', component: 'Api', userId: 'user, 1, ', timestamp: Date.now(, ),});
      getErrorMessage(nonRetryableError, { operation: 'form', component: 'Form', userId: 'user, 1, ', timestamp: Date.now(, ),});

      const stats = getErrorStatistics();

      expect(stats.totalErrors).toBe(2);
      expect(stats.retryableErrors).toBe(1);
      expect(stats.autoRetryableErrors).toBe(1);
  });
});

  describe('Generic Error Handling', () => {
    it('should generate generic error message for unknown errors', () => {
      const error = new Error('Unknown error type');
      const context = {
        operation: 'unknown',
        component: 'UnknownComponent',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('generic_error');
      expect(result.title).toBe('Something Went Wrong');
      expect(result.severity).toBe('error');
      expect(result.category).toBe('system');
      expect(result.retryable).toBe(true);
      expect(result.suggestions).toContain('Try refreshing the page');
  });

    it('should handle non-Error objects', () => {
      const error = 'String error';
      const context = {
        operation: 'test',
        component: 'TestComponent',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result).toBeDefined();
      expect(result.title).toBeDefined();
      expect(result.message).toBeDefined();
  });

    it('should handle null/undefined errors', () => {
      const error = null;
      const context = {
        operation: 'test',
        component: 'TestComponent',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result).toBeDefined();
      expect(result.id).toBe('generic_error');
  });
});

  describe('Template Matching', () => {
    it('should match error patterns correctly', () => {
      const testCases = [
        { error: 'Network error', expectedId: 'network_error, ',},
        { error: 'fetch failed', expectedId: 'network_error, ',},
        { error: 'connection refused', expectedId: 'network_error, ',},
        { error: 'Validation failed', expectedId: 'validation_error, ',},
        { error: 'required field', expectedId: 'validation_error, ',},
        { error: 'Unauthorized', expectedId: 'permission_error, ',},
        { error: 'access denied', expectedId: 'permission_error, ',},
        { error: 'Internal server error', expectedId: 'server_error, ',},
        { error: '5', expectedId: 'server_error, ',},
        { error: 'Rate limit', expectedId: 'rate_limit_error, ',},
        { error: 'too many requests', expectedId: 'rate_limit_error, ',},
        { error: 'Security threat', expectedId: 'security_error, ',},
        { error: 'malware detected', expectedId: 'security_error, ',}
      ];

      testCases.forEach(({ error, expectedId }) => {
        const context = {
          operation: 'test',
          component: 'TestComponent',
          userId: 'user1',
          timestamp: Date.now()
    };

        const result = getErrorMessage(error, context);
        expect(result.id).toBe(expectedId);
    });
  });

    it('should handle case-insensitive matching', () => {
      const error = 'NETWORK ERROR';
      const context = {
        operation: 'test',
        component: 'TestComponent',
        userId: 'user1',
        timestamp: Date.now()
  };

      const result = getErrorMessage(error, context);

      expect(result.id).toBe('network_error');
  });
});

  describe('Help URLs', () => {
    it('should provide correct help URLs for categories', () => {
      const categories = ['network', 'validation', 'permission', 'system', 'user', 'security'];
      const expectedUrls = [
        '/help/network-issues',
        '/help/validation-errors',
        '/help/permissions',
        '/help/server-errors',
        '/help/user-guide',
        '/help/security'
      ];

      categories.forEach((category, index) => {
        const url = errorMessageManager.getHelpUrl(category);
        expect(url).toBe(expectedUrls[index]);
    });
  });

    it('should provide default help URL for unknown category', () => {
      const url = errorMessageManager.getHelpUrl('unknown');
      expect(url).toBe('/help/contact-support');
  });
});

  describe('Error History Management', () => {
    it('should clear error history', () => {
      const error = new Error('Test error');
      const context = {
        operation: 'test',
        component: 'TestComponent',
        userId: 'user1',
        timestamp: Date.now()
  };

      getErrorMessage(error, context);
      expect(getErrorStatistics().totalErrors).toBe(1);

      clearErrorHistory();
      expect(getErrorStatistics().totalErrors).toBe(0);
  });
});
});





