/**
 * Unit Tests for Rate Limiting
 * Tests rate limiting functionality, statistics, and edge cases
 */

import { 
  rateLimiter, 
  checkAPIRateLimit, 
  checkActionRateLimit,
  addActionRateLimit,
  getRateLimitStatistics,
  clearRetryStats
} from '@/utils/rateLimiting';

describe('Rate Limiting', () => {
  beforeEach(() => {
    // Clear rate limiter state before each test
    rateLimiter.clearAllRateLimits();
});

  describe('API Rate Limiting', () => {
    it('should allow requests within limit', () => {
      const key = 'test-user';
      
      for (let i = 0; i < 5; i++) {
        const result = checkAPIRateLimit(key);
        expect(result.allowed).toBe(true);
        expect(result.remaining).toBeGreaterThan(0);
    }
  });

    it('should block requests when limit exceeded', () => {
      const key = 'test-user';
      
      // Make requests up to the limit
      for (let i = 0; i < 100; i++) {
        checkAPIRateLimit(key);
    }
      
      // Next request should be blocked
      const result = checkAPIRateLimit(key);
      expect(result.allowed).toBe(false);
      expect(result.remaining).toBe(0);
  });

    it('should reset limit after window expires', (done) => {
      const key = 'test-user';
      
      // Exceed limit
      for (let i = 0; i < 101; i++) {
        checkAPIRateLimit(key);
    }
      
      // Wait for window to reset (using shorter window for testing)
      rateLimiter.updateConfig({ windowMs: 100, 0,});
      
      setTimeout(() => {
        const result = checkAPIRateLimit(key);
        expect(result.allowed).toBe(true);
        done();
    }, 1100);
  });

    it('should track different keys independently', () => {
      const key1 = 'user1';
      const key2 = 'user2';
      
      // Exceed limit for user1
      for (let i = 0; i < 101; i++) {
        checkAPIRateLimit(key1);
    }
      
      // user2 should still be allowed
      const result = checkAPIRateLimit(key2);
      expect(result.allowed).toBe(true);
  });

    it('should provide correct rate limit info', () => {
      const key = 'test-user';
      
      const result = checkAPIRateLimit(key);
      
      expect(result.limit).toBe(100);
      expect(result.remaining).toBe(99);
      expect(result.reset).toBeGreaterThan(Date.now());
  });
});

  describe('Action Rate Limiting', () => {
    beforeEach(() => {
      // Add test action rate limit
      addActionRateLimit('test_action', {
        actionType: 'test_action',
        windowMs: 600, // 1 minute
        maxActions:  5,
        burstLimit:  2,
        priority: 'medium'
  });
  });

    it('should allow actions within limit', () => {
      const userId = 'test-user';
      
      for (let i = 0; i < 3; i++) {
        const result = checkActionRateLimit('test_action', userId);
        expect(result.allowed).toBe(true);
    }
  });

    it('should block actions when limit exceeded', () => {
      const userId = 'test-user';
      
      // Make actions up to the limit
      for (let i = 0; i < 5; i++) {
        checkActionRateLimit('test_action', userId);
    }
      
      // Next action should be blocked
      const result = checkActionRateLimit('test_action', userId);
      expect(result.allowed).toBe(false);
  });

    it('should enforce burst limit', () => {
      const userId = 'test-user';
      
      // Make actions up to burst limit
      for (let i = 0; i < 2; i++) {
        checkActionRateLimit('test_action', userId);
    }
      
      // Next action should be blocked by burst limit
      const result = checkActionRateLimit('test_action', userId);
      expect(result.allowed).toBe(false);
  });

    it('should track different users independently', () => {
      const user1 = 'user1';
      const user2 = 'user2';
      
      // Exceed limit for user1
      for (let i = 0; i < 6; i++) {
        checkActionRateLimit('test_action', user1);
    }
      
      // user2 should still be allowed
      const result = checkActionRateLimit('test_action', user2);
      expect(result.allowed).toBe(true);
  });

    it('should handle unknown action types gracefully', () => {
      const userId = 'test-user';
      
      const result = checkActionRateLimit('unknown_action', userId);
      
      expect(result.allowed).toBe(true);
      expect(result.limit).toBe(0);
  });
});

  describe('Statistics', () => {
    it('should track retry statistics correctly', () => {
      const key = 'test-user';
      
      // Make some requests
      for (let i = 0; i < 10; i++) {
        checkAPIRateLimit(key);
    }
      
      const stats = getRateLimitStatistics();
      
      expect(stats.totalRequests).toBe(10);
      expect(stats.activeKeys).toBe(1);
  });

    it('should calculate success rate correctly', () => {
      const key = 'test-user';
      
      // Make requests within limit
      for (let i = 0; i < 50; i++) {
        checkAPIRateLimit(key);
    }
      
      // Exceed limit
      for (let i = 0; i < 60; i++) {
        checkAPIRateLimit(key);
    }
      
      const stats = getRateLimitStatistics();
      
      expect(stats.totalRequests).toBe(110);
      expect(stats.activeKeys).toBe(1);
  });

    it('should track multiple keys', () => {
      const keys = ['user1', 'user2', 'user3'];
      
      keys.forEach(key => {
        for (let i = 0; i < 5; i++) {
          checkAPIRateLimit(key);
      }
    });
      
      const stats = getRateLimitStatistics();
      
      expect(stats.totalRequests).toBe(15);
      expect(stats.activeKeys).toBe(3);
  });
});

  describe('Configuration', () => {
    it('should allow custom configuration', () => {
      const customConfig = {
        windowMs: 300, // 30 seconds
        maxRequests: 50
  };
      
      rateLimiter.updateConfig(customConfig);
      
      const key = 'test-user';
      const result = checkAPIRateLimit(key);
      
      expect(result.limit).toBe(50);
  });

    it('should merge configuration with defaults', () => {
      const customConfig = {
        maxRequests: 25
  };
      
      rateLimiter.updateConfig(customConfig);
      
      const key = 'test-user';
      const result = checkAPIRateLimit(key);
      
      expect(result.limit).toBe(25);
      expect(result.remaining).toBe(24);
  });
});

  describe('Edge Cases', () => {
    it('should handle empty key', () => {
      const result = checkAPIRateLimit('');
      
      expect(result.allowed).toBe(true);
  });

    it('should handle special characters in key', () => {
      const key = 'user@domain.com';
      
      const result = checkAPIRateLimit(key);
      
      expect(result.allowed).toBe(true);
  });

    it('should handle very long keys', () => {
      const key = 'a'.repeat(1000);
      
      const result = checkAPIRateLimit(key);
      
      expect(result.allowed).toBe(true);
  });

    it('should handle concurrent requests', async () => {
      const key = 'test-user';
      const promises = [];
      
      // Make 10 concurrent requests
      for (let i = 0; i < 10; i++) {
        promises.push(Promise.resolve(checkAPIRateLimit(key)));
    }
      
      const results = await Promise.all(promises);
      
      // All should be allowed
      results.forEach(result => {
        expect(result.allowed).toBe(true);
    });
  });
});

  describe('Performance', () => {
    it('should handle many requests efficiently', () => {
      const key = 'test-user';
      const startTime = performance.now();
      
      // Make 1000 requests
      for (let i = 0; i < 1000; i++) {
        checkAPIRateLimit(key);
    }
      
      const endTime = performance.now();
      
      expect(endTime - startTime).toBeLessThan(1000); // Should complete within 1 second
  });

    it('should handle many different keys efficiently', () => {
      const startTime = performance.now();
      
      // Make requests with 100 different keys
      for (let i = 0; i < 100; i++) {
        checkAPIRateLimit(`user${i}`);
    }
      
      const endTime = performance.now();
      
      expect(endTime - startTime).toBeLessThan(500); // Should complete within 500ms
  });
});

  describe('Cleanup', () => {
    it('should clear all rate limits', () => {
      const key = 'test-user';
      
      // Make some requests
      for (let i = 0; i < 5; i++) {
        checkAPIRateLimit(key);
    }
      
      // Clear all rate limits
      rateLimiter.clearAllRateLimits();
      
      // Should start fresh
      const result = checkAPIRateLimit(key);
      expect(result.remaining).toBe(99);
  });

    it('should reset statistics', () => {
      const key = 'test-user';
      
      // Make some requests
      for (let i = 0; i < 10; i++) {
        checkAPIRateLimit(key);
    }
      
      // Clear statistics
      clearRetryStats();
      
      const stats = getRateLimitStatistics();
      expect(stats.totalRequests).toBe(0);
  });
});
});





