/**
 * Database Hook for Visual Editor
 * Provides easy access to database operations
 */

import { useState, useEffect, useCallback } from 'react';
import { useEnhancedMasterIntegration } from '../integration/EnhancedMasterIntegrationProvider';
import DatabaseIntegrationService from '../services/DatabaseIntegrationService';

export const useDatabase = () => {
  const { integration, communication, dataFlow } = useEnhancedMasterIntegration();
  const [dbIntegration, setDbIntegration] = useState<DatabaseIntegrationService | null>(null);
  const [isConnected, setIsConnected] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Initialize database integration
  useEffect(() => {
    const initDatabase = async () => {
      try {
        // Get database instance from integration
        const db = await (integration as any).getDatabase();
        if (db) {
          const service = new DatabaseIntegrationService(db, communication, integration);
          setDbIntegration(service);
          setIsConnected(true);
      } else {
          setError('Database not available');
      }
    } catch (err) {
        setError(err instanceof Error ? err.message : 'Database initialization failed');
    }
  };

    initDatabase();
}, [integration, communication]);

  // Save project
  const saveProject = useCallback(async (project: any) => {
    if (!dbIntegration) throw new Error('Database not connected');
    return await dbIntegration.saveProjectToDatabase(project);
}, [dbIntegration]);

  // Load project
  const loadProject = useCallback(async (projectId: string) => {
    if (!dbIntegration) throw new Error('Database not connected');
    return await dbIntegration.loadProjectFromDatabase(projectId);
}, [dbIntegration]);

  // Auto-save project
  const autoSaveProject = useCallback(async (project: any) => {
    if (!dbIntegration) return;
    return await dbIntegration.autoSaveProject(project);
}, [dbIntegration]);

  // Sync project changes
  const syncProjectChanges = useCallback(async (projectId: string, changes: any) => {
    if (!dbIntegration) throw new Error('Database not connected');
    return await (dbIntegration as any).syncProjectChanges(projectId, changes);
}, [dbIntegration]);

  // Track project usage
  const trackProjectUsage = useCallback(async (projectId: string, action: string, metadata: any) => {
    if (!dbIntegration) return;
    return await (dbIntegration as any).trackProjectUsage(projectId, action, metadata);
}, [dbIntegration]);

  // Save as template
  const saveAsTemplate = useCallback(async (project: any, templateName: string) => {
    if (!dbIntegration) throw new Error('Database not connected');
    return await (dbIntegration as any).saveAsTemplate(project, templateName);
}, [dbIntegration]);

  // Get user projects
  const getUserProjects = useCallback(async (userId: string) => {
    if (!dbIntegration) throw new Error('Database not connected');
    return await dbIntegration.getUserProjects(userId);
}, [dbIntegration]);

  // Search projects
  const searchProjects = useCallback(async (query: string, userId: string) => {
    if (!dbIntegration) throw new Error('Database not connected');
    return await (dbIntegration as any).searchProjects(query, userId);
}, [dbIntegration]);

  // Delete project
  const deleteProject = useCallback(async (projectId: string) => {
    if (!dbIntegration) throw new Error('Database not connected');
    return await dbIntegration.deleteProject(projectId);
}, [dbIntegration]);

  return {
    isConnected,
    error,
    saveProject,
    loadProject,
    autoSaveProject,
    syncProjectChanges,
    trackProjectUsage,
    saveAsTemplate,
    getUserProjects,
    searchProjects,
    deleteProject,
    dbIntegration
};
};

export default useDatabase;

