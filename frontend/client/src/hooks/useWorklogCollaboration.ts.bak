/**
 * useWorklogCollaboration Hook
 * Enables Google Keep collaboration on worklog entries
 */

import { useState, useCallback } from 'react';
import { apiRequest } from '@/lib/queryClient';
import { useQueryClient } from '@tanstack/react-query';

export interface CollaboratorEmail {
  email: string;
  name?: string;
  role?: 'viewer' | 'editor';
}

export function useWorklogCollaboration() {
  const [adding, setAdding] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const queryClient = useQueryClient();

  /**
   * Add collaborators to a worklog entry via Google Keep
   */
  const addCollaborators = useCallback(async (
    worklogId: string,
    emails: string[]
  ) => {
    setAdding(true);
    setError(null);

    try {
      const result = await apiRequest(`/api/worklog/${worklogId}/add-collaborators`, {
        method: 'POST',
        body: JSON.stringify({ emails })
      });

      // Refresh worklog queries
      await queryClient.invalidateQueries({ queryKey: ['/api/projects'] });

      setAdding(false);
      return result;
    } catch (err: any) {
      setError(err.message || 'Failed to add collaborators');
      setAdding(false);
      throw err;
    }
  }, [queryClient]);

  /**
   * Remove collaborator from worklog entry
   */
  const removeCollaborator = useCallback(async (
    worklogId: string,
    email: string
  ) => {
    setAdding(true);
    setError(null);

    try {
      const result = await apiRequest(`/api/worklog/${worklogId}/remove-collaborator`, {
        method: 'POST',
        body: JSON.stringify({ email })
      });

      await queryClient.invalidateQueries({ queryKey: ['/api/projects'] });

      setAdding(false);
      return result;
    } catch (err: any) {
      setError(err.message || 'Failed to remove collaborator');
      setAdding(false);
      throw err;
    }
  }, [queryClient]);

  /**
   * Share worklog entry via email (Google Keep sharing)
   */
  const shareViaEmail = useCallback(async (
    worklogId: string,
    emails: string[],
    message?: string
  ) => {
    return addCollaborators(worklogId, emails);
  }, [addCollaborators]);

  return {
    addCollaborators,
    removeCollaborator,
    shareViaEmail,
    adding,
    error
  };
}


