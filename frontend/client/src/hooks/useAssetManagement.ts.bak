/**
 * useAssetManagement Hook
 * React hook for asset management functionality
 */

import { useEffect, useRef, useCallback, useState, useMemo } from 'react';
import { 
  assetManager, 
  AssetManagerConfig, 
  AssetManagerState, 
  Asset,
  AssetCategory,
  AssetTag,
  AssetSearchQuery
} from '../utils/assetManager';

export interface UseAssetManagementOptions {
  config?: Partial<AssetManagerConfig>;
  onAssetAdded?: (data: { asset: Asset }) => void;
  onCategoryAdded?: (data: { category: AssetCategory }) => void;
  onTagAdded?: (data: { tag: AssetTag }) => void;
  onSearchCompleted?: (data: { query: AssetSearchQuery; results: Asset[, ],}) => void;
  onSearchFailed?: (data: { query: AssetSearchQuery; error: string }) => void;
  onError?: (error: string) => void;
  onInitialized?: () => void
}

export interface UseAssetManagementReturn {
  addAsset: (assetData: Partial<Asset>) => Promise<Asset>;
  addCategory: (categoryData: Partial<AssetCategory>) => Promise<AssetCategory>;
  addTag: (tagData: Partial<AssetTag>) => Promise<AssetTag>;
  searchAssets: (query: AssetSearchQuery) => Promise<Asset[]>;
  getAsset: (id: string) => Asset | null;
  getAssetsByType: (type: string) => Asset[];
  getAssetsByCategory: (category: string) => Asset[];
  getCategory: (id: string) => AssetCategory | null;
  getTag: (id: string) => AssetTag | null;
  state: AssetManagerState;
  config: AssetManagerConfig;
  updateConfig: (config: Partial<AssetManagerConfig>) => void;
  isEnabled: boolean;
  isInitialized: boolean;
  hasError: boolean;
  error: string | null;
  assets: Asset[];
  categories: AssetCategory[];
  tags: AssetTag[];
  searchResults: Asset[];
  lastSearchQuery: AssetSearchQuery | null;
  totalAssets: number;
  totalCategories: number;
  totalTags: number;
  totalSize: number;
  totalUsage: number;
  totalErrors: number;
  totalConflicts: number;
  totalOverrides: number;
  getAllAssets: () => Asset[];
  getAllCategories: () => AssetCategory[];
  getAllTags: () => AssetTag[]
}

/**
 * Hook for asset management functionality
 */
export const useAssetManagement = (options: UseAssetManagementOptions =,  , {}): UseAssetManagementReturn => {
  const {
    config = {},
    onAssetAdded,
    onCategoryAdded,
    onTagAdded,
    onSearchCompleted,
    onSearchFailed,
    onError,
    onInitialized
} = options;

  const [state, setState] = useState<AssetManagerState>({
    isEnabled: false,
    isInitialized: false,
    hasError: false,
    error: null,
    assets: new Map(),
    categories: new Map(),
    tags: new Map(),
    searchResults:  [],
    lastSearchQuery: null,
    lastUpdate:  0,
    totalAssets:  0,
    totalCategories:  0,
    totalTags:  0,
    totalSize:  0,
    totalUsage:  0,
    totalErrors:  0,
    totalConflicts:  0,
    totalOverrides: 0
});

  const stateIntervalRef = useRef<NodeJS.Timeout | null>(null);
  const eventHandlersRef = useRef<Map<string, Function>>(new Map());

  // Initialize asset manager
  useEffect(() => {
    // Update configuration
    if (Object.keys(config).length > 0) {
      assetManager.updateConfig(config);
  }

    // Setup event handlers
    const handleAssetAdded = (data: { asset: Asset }) => {
      if (onAssetAdded) {
        onAssetAdded(data);
    }
  };

    const handleCategoryAdded = (data: { category: AssetCategory }) => {
      if (onCategoryAdded) {
        onCategoryAdded(data);
    }
  };

    const handleTagAdded = (data: { tag: AssetTag }) => {
      if (onTagAdded) {
        onTagAdded(data);
    }
  };

    const handleSearchCompleted = (data: { query: AssetSearchQuery; results: Asset[, ],}) => {
      if (onSearchCompleted) {
        onSearchCompleted(data);
    }
  };

    const handleSearchFailed = (data: { query: AssetSearchQuery; error: string }) => {
      if (onSearchFailed) {
        onSearchFailed(data);
    }
  };

    const handleError = (data: { error: string }) => {
      if (onError) {
        onError(data.error);
    }
  };

    const handleInitialized = () => {
      if (onInitialized) {
        onInitialized();
    }
  };

    // Store event handlers
    eventHandlersRef.current.set('asset_added', handleAssetAdded);
    eventHandlersRef.current.set('category_added', handleCategoryAdded);
    eventHandlersRef.current.set('tag_added', handleTagAdded);
    eventHandlersRef.current.set('search_completed', handleSearchCompleted);
    eventHandlersRef.current.set('search_failed', handleSearchFailed);
    eventHandlersRef.current.set('error', handleError);
    eventHandlersRef.current.set('initialized', handleInitialized);

    // Add event listeners
    assetManager.on('asset_added', handleAssetAdded);
    assetManager.on('category_added', handleCategoryAdded);
    assetManager.on('tag_added', handleTagAdded);
    assetManager.on('search_completed', handleSearchCompleted);
    assetManager.on('search_failed', handleSearchFailed);
    assetManager.on('error', handleError);
    assetManager.on('initialized', handleInitialized);

    // Update initial state
    setState(assetManager.getState());

    return () => {
      // Remove event listeners
      eventHandlersRef.current.forEach((handler, event) => {
        assetManager.off(event, handler);
    });
      eventHandlersRef.current.clear();
  };
}, [config, onAssetAdded, onCategoryAdded, onTagAdded, onSearchCompleted, onSearchFailed, onError, onInitialized]);

  // Setup state monitoring
  useEffect(() => {
    stateIntervalRef.current = setInterval(() => {
      const currentState = assetManager.getState();
      setState(currentState);
  }, 100);

    return () => {
      if (stateIntervalRef.current) {
        clearInterval(stateIntervalRef.current);
    }
  };
}, []);

  // Add asset
  const addAsset = useCallback(async (assetData: Partial<Asset>) => {
    return await assetManager.addAsset(assetData);
}, []);

  // Add category
  const addCategory = useCallback(async (categoryData: Partial<AssetCategory>) => {
    return await assetManager.addCategory(categoryData);
}, []);

  // Add tag
  const addTag = useCallback(async (tagData: Partial<AssetTag>) => {
    return await assetManager.addTag(tagData);
}, []);

  // Search assets
  const searchAssets = useCallback(async (query: AssetSearchQuery) => {
    return await assetManager.searchAssets(query);
}, []);

  // Get asset by ID
  const getAsset = useCallback((id: string) => {
    return assetManager.getAsset(id);
}, []);

  // Get assets by type
  const getAssetsByType = useCallback((type: string) => {
    return assetManager.getAssetsByType(type);
}, []);

  // Get assets by category
  const getAssetsByCategory = useCallback((category: string) => {
    return assetManager.getAssetsByCategory(category);
}, []);

  // Get category by ID
  const getCategory = useCallback((id: string) => {
    return assetManager.getCategory(id);
}, []);

  // Get tag by ID
  const getTag = useCallback((id: string) => {
    return assetManager.getTag(id);
}, []);

  // Update configuration
  const updateConfig = useCallback((newConfig: Partial<AssetManagerConfig>) => {
    assetManager.updateConfig(newConfig);
}, []);

  // Get configuration
  const config = useMemo(() => {
    return assetManager.getConfig();
}, []);

  // Get all assets
  const getAllAssets = useCallback(() => {
    return assetManager.getAllAssets();
}, []);

  // Get all categories
  const getAllCategories = useCallback(() => {
    return assetManager.getAllCategories();
}, []);

  // Get all tags
  const getAllTags = useCallback(() => {
    return assetManager.getAllTags();
}, []);

  // Memoized return value
  const returnValue = useMemo(() => ({
    addAsset,
    addCategory,
    addTag,
    searchAssets,
    getAsset,
    getAssetsByType,
    getAssetsByCategory,
    getCategory,
    getTag,
    state,
    config,
    updateConfig,
    isEnabled: state.isEnabled,
    isInitialized: state.isInitialized,
    hasError: state.hasError,
    error: state.error,
    assets: Array.from(state.assets.values(, ), ),
    categories: Array.from(state.categories.values(, ), ),
    tags: Array.from(state.tags.values(, ), ),
    searchResults: state.searchResults,
    lastSearchQuery: state.lastSearchQuery,
    totalAssets: state.totalAssets,
    totalCategories: state.totalCategories,
    totalTags: state.totalTags,
    totalSize: state.totalSize,
    totalUsage: state.totalUsage,
    totalErrors: state.totalErrors,
    totalConflicts: state.totalConflicts,
    totalOverrides: state.totalOverrides,
    getAllAssets,
    getAllCategories,
    getAllTags
}), [
    addAsset,
    addCategory,
    addTag,
    searchAssets,
    getAsset,
    getAssetsByType,
    getAssetsByCategory,
    getCategory,
    getTag,
    state,
    config,
    updateConfig,
    getAllAssets,
    getAllCategories,
    getAllTags
  ]);

  return returnValue;
};

export default useAssetManagement;





