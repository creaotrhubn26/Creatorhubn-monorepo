/**
 * CreatorHub Norge - Profession Adapter Hook
 * Tilpasser komponenter og data basert på brukerens profesjon
 * Integrert med dynamisk profesjonssystem
 */

import { useAuth } from './useAuth';
import { useDynamicProfessions } from '../components/universal/hooks/useDynamicProfessions';
import { googleTrendsService, GoogleTrendsData } from '../services/GoogleTrendsService';
import { creatorHubSEOFixService } from '../services/CreatorHubSEOFixService';
import { googleAnalyticsService } from '../services/GoogleAnalyticsService';
import { useDemoMode } from '../contexts/DemoModeContext';

export interface ProjectType {
  value: string;
  label: string;
  description?: string;
  defaultHours?: number
}

export interface ProfessionConfig {
  profession: string;
  projectTypes: ProjectType[];
  defaultHourlyRate: number;
  specialFeatures: string[];
  contractTemplates: string[];
  // Google Trends & SEO integration
  trendingKeywords?: GoogleTrendsData[];
  seoInsights?: {
    searchVolume: number;
    trend: 'rising' | 'stable' | 'declining';
    opportunity: 'high' | 'medium' | 'low';
    seasonality: string;
};
  seoSuggestions?: any[];
  analyticsData?: any;
}

export function useProfessionAdapter() {
  const { user } = useAuth();
  const { isDemoMode } = useDemoMode();
  const {
    getCurrentUserProfession,
    professionConfigs: dynamicConfigs,
    isLoading,
    error,
} = useDynamicProfessions();
  const profession = user?.profession || getCurrentUserProfession();

  // Merge static and dynamic profession configurations

  const professionConfigs: Record<string, ProfessionConfig> = {
    photographer: {
      profession: 'photographer',
      projectTypes: [
        {
          value: 'bryllup',
          label: 'Bryllup',
          description: 'Bryllupsfotografering med timeline',
          defaultHours:  10,
      },
        {
          value: 'portrett',
          label: 'Portrett',
          description: 'Portrettfotografering',
          defaultHours:  2,
      },
        {
          value: 'bedrift',
          label: 'Bedrift',
          description: 'Bedriftsfotografering',
          defaultHours:  4,
      },
        {
          value: 'kommersielt',
          label: 'Kommersielt',
          description: 'Kommersiell fotografering',
          defaultHours:  6,
      },
        {
          value: 'lifestyle',
          label: 'Lifestyle',
          description: 'Lifestyle fotografering',
          defaultHours:  3,
      },
      ],
      defaultHourlyRate: 120,
      specialFeatures: ['wedding_timeline', 'photo_editing', 'client_gallery'],
      contractTemplates: [
        'wedding_photo',
        'portrait_session',
        'corporate_photo',
        'commercial_photo',
      ],
  },
    videographer: {
      profession: 'videographer',
      projectTypes: [
        {
          value: 'bryllup',
          label: 'Bryllupsvideo',
          description: 'Bryllupsvideo med timeline',
          defaultHours:  12,
      },
        {
          value: 'portrett',
          label: 'Portrettvideo',
          description: 'Portrettvideo og intervju',
          defaultHours:  3,
      },
        {
          value: 'bedrift',
          label: 'Bedriftsvideo',
          description: 'Bedriftsvideo og markedsføring',
          defaultHours:  8,
      },
        {
          value: 'kommersielt',
          label: 'Kommersiell video',
          description: 'Kommersiell videoproduksjon',
          defaultHours:  10,
      },
        {
          value: 'lifestyle',
          label: 'Lifestyle video',
          description: 'Lifestyle og sosiale medier',
          defaultHours:  4,
      },
      ],
      defaultHourlyRate: 150,
      specialFeatures: ['wedding_timeline', 'video_editing', 'multi_camera', 'audio_recording'],
      contractTemplates: [
        'wedding_video',
        'video_production',
        'corporate_video',
        'commercial_video',
      ],
  },
    music_producer: {
      profession: 'music_producer',
      projectTypes: [
        {
          value: 'bryllup',
          label: 'Bryllupslå',
          description: 'Spesiallåt til bryllup',
          defaultHours:  20,
      },
        {
          value: 'portrett',
          label: 'Demo',
          description: 'Demo-opptak',
          defaultHours:  8,
      },
        {
          value: 'bedrift',
          label: 'Bedriftslyd',
          description: 'Bedriftslyd og jingles',
          defaultHours:  12,
      },
        {
          value: 'kommersielt',
          label: 'Kommersiell musikk',
          description: 'Kommersiell musikkproduksjon',
          defaultHours:  15,
      },
        {
          value: 'lifestyle',
          label: 'Personlig lå',
          description: 'Personlig låtproduksjon',
          defaultHours:  10,
      },
      ],
      defaultHourlyRate: 80,
      specialFeatures: ['audio_mixing', 'mastering', 'recording'],
      contractTemplates: ['music_production', 'recording_session', 'mixing_mastering'],
  },
    vendor: {
      profession: 'vendor',
      projectTypes: [
        {
          value: 'bryllup',
          label: 'Bryllupsleveranse',
          description: 'Leveranse til bryllup',
          defaultHours:  6,
      },
        {
          value: 'portrett',
          label: 'Leveranse',
          description: 'Produktleveranse',
          defaultHours:  2,
      },
        {
          value: 'bedrift',
          label: 'Bedriftsleveranse',
          description: 'Bedriftsleveranse',
          defaultHours:  4,
      },
        {
          value: 'kommersielt',
          label: 'Kommersiell leveranse',
          description: 'Kommersiell leveranse',
          defaultHours:  5,
      },
        {
          value: 'lifestyle',
          label: 'Leveranse',
          description: 'Generell leveranse',
          defaultHours:  3,
      },
      ],
      defaultHourlyRate: 60,
      specialFeatures: ['inventory_management', 'delivery_tracking'],
      contractTemplates: ['vendor_service', 'product_delivery', 'service_agreement'],
  },
};

  const config = professionConfigs[profession] || professionConfigs.photographer;

  const getProjectTypes = (): ProjectType[] => {
    return config.projectTypes;
};

  const getDefaultHourlyRate = (): number => {
    return config.defaultHourlyRate;
};

  const hasFeature = (feature: string): boolean => {
    return config.specialFeatures.includes(feature);
};

  const getContractTemplates = (): string[] => {
    return config.contractTemplates;
};

  const adaptProjectTypeLabel = (projectType: string): string => {
    const type = config.projectTypes.find((t) => t.value === projectType);
    return type?.label || projectType;
};

  const adaptDashboardTitle = (): string => {
    // Try to get title from dynamic profession configs first
    if (dynamicConfigs?.[profession]) {
      return `${dynamicConfigs[profession].displayName}dashboard`;
  }

    // Fallback to hardcoded titles
    const titles = {
      photographer: 'Fotografdashboard',
      videographer: 'Videografdashboard',
      music_producer: 'Musikkprodusentdashboard',
      vendor: 'Leverandørdashboard',
  };
    return titles[profession] || 'Dashboard';
};

  const adaptTabLabels = () => {
    const baseLabels = {
      overview: 'Oversikt',
      projects: 'Prosjekter',
      clients: 'Kunder',
      equipment: 'Utstyr',
      files: 'Filer',
      settings: 'Innstillinger',
  };

    if (profession === 'videographer') {
      return {
        ...baseLabels,
        projects: 'Videoer',
        equipment: 'Utstyr & Studio',
    };
  }

    if (profession === 'music_producer') {
      return {
        ...baseLabels,
        projects: 'Låter',
        clients: 'Artister',
        equipment: 'Studio',
    };
  }

    if (profession === 'vendor') {
      return {
        ...baseLabels,
        projects: 'Produkter',
        clients: 'Bestillinger',
        equipment: 'Lager',
    };
  }

    return baseLabels;
};

  const supportsWeddingTimeline = (): boolean => {
    return ['photographer', 'videographer'].includes(profession);
};

  // Google Trends & SEO Integration Methods
  const loadTrendsData = async (region: string = 'norway') => {
    try {
      const trendingKeywords = await googleTrendsService.getTrendingKeywords(
        profession as any,
        region as any,
        isDemoMode
      );
      
      const seoSuggestions = await creatorHubSEOFixService.generateSuggestions(
        {},
        profession as any,
        region as any,
        isDemoMode
      );

      // Update the config with trends data
      const updatedConfig = {
        ...config,
        trendingKeywords,
        seoInsights: {
          searchVolume: trendingKeywords.reduce((sum, k) => sum + k.searchVolume, 0),
          trend: trendingKeywords.some(k => k.trend === 'rising') ? 'rising' : 'stable',
          opportunity: trendingKeywords.some(k => k.opportunity === 'high') ? 'high' : 'medium',
          seasonality: trendingKeywords.some(k => k.seasonality.peakMonths.length > 0) 
            ? 'Høysesong: ' + trendingKeywords.find(k => k.seasonality.peakMonths.length > 0)?.seasonality.peakMonths.join, (, ', ')
            : 'Stabil året rundt',
      },
        seoSuggestions,
    };

      return { trendingKeywords, seoSuggestions, updatedConfig };
  } catch (error) {
      console.error('Error loading trends data:', error);
      return { trendingKeywords:  [], seoSuggestions:  [], updatedConfig: config };
  }
};

  const getTrendingKeywords = (): GoogleTrendsData[] => {
    return config.trendingKeywords || [];
};

  const getSEOSuggestions = (): any[] => {
    return config.seoSuggestions || [];
};

  const getSEOInsights = () => {
    return config.seoInsights || null;
};

  const applySEOFixes = async (region: string = 'norway') => {
    try {
      await creatorHubSEOFixService.applyAllHighPriorityFixes, (, {}, profession as any, region as any);
      
      // Track the SEO fix application
      await googleAnalyticsService.trackEvent('seo_fix_applied', {
        profession,
        region,
        timestamp: new Date().toISOString, (, ),
    });
      
      return true;
  } catch (error) {
      console.error('Error applying SEO fixes:', error);
      return false;
  }
};

  const getProfessionSpecificKeywords = (): string[] => {
    const professionKeywords = {
      photographer: ['fotograf', 'bryllup', 'portrett', 'bedriftsfoto', 'kommersiell fotografering'],
      videographer: ['videograf', 'bryllupsvideo', 'bedriftsvideo', 'kommersiell video', 'redigering'],
      music_producer: ['musikkprodusent', 'studio', 'opptak', 'mixing', 'mastering'],
      vendor: ['leverandø', 'produkter', 'utstyr', 'levering', 'inventar'],
  };
    
    return professionKeywords[profession as keyof typeof professionKeywords] || [];
};

  const getProfessionSEOTips = (): string[] => {
    const tips = {
      photographer: [
        'Inkluder lokasjon i bildetitler (f.eks. "Bryllup Oslo 2024", ), ',
        'Bruk relevante nøkkelord i portefølje-beskrivelser',
        'Optimaliser bilder for Google Images med alt-tekst',
        'Opprett lokale Google My Business-profil',
      ],
      videographer: [
        'Lag engasjerende video-thumbnails',
        'Bruk beskrivende video-titler med nøkkelord',
        'Inkluder transkripsjoner for bedre SEO',
        'Optimaliser for YouTube-søk',
      ],
      music_producer: [
        'Bruk genre-spesifikke nøkkelord',
        'Inkluder artist-navn i produksjon-titler',
        'Optimaliser for Spotify og Apple Music',
        'Lag engasjerende album-cover',
      ],
      vendor: [
        'Bruk produktkategorier i beskrivelser',
        'Inkluder merkevarer og modeller',
        'Optimaliser for e-handel søk',
        'Bruk lokale nøkkelord for levering',
      ],
  };
    
    return tips[profession as keyof typeof tips] || [];
};

  const trackProfessionActivity = async (activity: string, metadata?: any) => {
    try {
      await googleAnalyticsService.trackEvent('profession_activity', {
        profession,
        activity,
        metadata: {
          ...metadata,
          timestamp: new Date().toISOString, (, ),
          userAgent: navigator.userAgent,
      },
    });
  } catch (error) {
      console.error('Error tracking profession activity:', error);
  }
};

  const getProfessionAnalytics = async () => {
    try {
      const analyticsData = await googleAnalyticsService.getRealTimeData('profession-dashboard');
      return analyticsData;
  } catch (error) {
      console.error('Error fetching profession analytics:', error);
      return null;
  }
};

  return {
    profession,
    config,
    getProjectTypes,
    getDefaultHourlyRate,
    hasFeature,
    getContractTemplates,
    adaptProjectTypeLabel,
    adaptDashboardTitle,
    adaptTabLabels,
    supportsWeddingTimeline,
    // Google Trends & SEO integration
    loadTrendsData,
    getTrendingKeywords,
    getSEOSuggestions,
    getSEOInsights,
    applySEOFixes,
    getProfessionSpecificKeywords,
    getProfessionSEOTips,
    trackProfessionActivity,
    getProfessionAnalytics,
};
}
