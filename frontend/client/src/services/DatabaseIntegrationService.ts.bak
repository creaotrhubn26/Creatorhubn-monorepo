/**
 * Database Integration Service for Visual Editor
 * Handles all database operations, real-time collaboration, and analytics
 */

class DatabaseIntegrationService {
  private db: any;
  private communication: any;
  private integration: any;

  constructor(db: any, communication: any, integration: any) {
    this.db = db;
    this.communication = communication;
    this.integration = integration;
}

  // Visual Editor → Database operations
  async saveProjectToDatabase(project: any) {
    const query = `
      INSERT INTO visual_editor_projects (id, name, elements, page_settings, created_at, updated_at)
      VALUES ($1, $2, $3, $4, $5, $6)
      ON CONFLICT (id) DO UPDATE SET
        name = $2,
        elements = $3,
        page_settings = $4,
        updated_at = $5
    `;
    
    return await this.db.query(query, [
      project.id,
      project.name,
      JSON.stringify(project.elements),
      JSON.stringify(project.pageSettings),
      new Date(),
      new Date()
    ]);
}

  // Database → Visual Editor operations
  async loadProjectFromDatabase(projectId: string) {
    const query = 'SELECT * FROM visual_editor_projects WHERE id = $1';
    const result = await this.db.query(query, [projectId]);
    
    if (result.rows.length > 0) {
      const project = result.rows[0];
      return {
        id: project.id,
        name: project.name,
        elements: JSON.parse(project.elements),
        pageSettings: JSON.parse(project.page_settings)
  };
  }
    return null;
}

  // Auto-save logic
  async autoSaveProject(project: any) {
    try {
      await this.saveProjectToDatabase(project);
      this.communication.sendBroadcast('visual-editor:project:auto-saved', { project });
  } catch (error) {
      this.communication.sendBroadcast('visual-editor: project:save-failed', { error });
  }
}

  // Real-time collaboration
  async syncProjectChanges(projectId: string, changes: any) {
    const query = `
      UPDATE visual_editor_projects 
      SET elements = , $updated_at = $2 
      WHERE id = $3
    `;
    
    await this.db.query(query, [
      JSON.stringify(changes.elements),
      new Date(),
      projectId
    ]);

    // Broadcast to all connected clients
    this.communication.sendBroadcast('visual-editor: project:synced', {
      projectId,
      changes,
      timestamp: Date.now()
  ,  ,});
}
// Ensure TS target libs allow fetch (or use axios). In client, fetch is fine.
export interface DbRecord {
  id: string;
  [k: string]: unknown;
}

export async function fetchRecords<T extends DbRecord = DbRecord>(endpoint: string): Promise<T[]> {
  const res = await fetch(endpoint, { method: "GET", headers: { "Accept": "application/json" } });
  if (!res.ok) throw new Error(`DB fetch failed: ${res.status} ${res.statusText}`);
  const data: unknown = await res.json();
  if (!Array.isArray(data)) return [];
  return data as T[];
}

  // Project versioning
  async saveProjectVersion(projectId: string, version: any) {
    const query = `
      INSERT INTO visual_editor_project_versions 
      (project_, idversion_data, created_at, version_number)
      VALUES ($1, $2, $3, $4)
    `;
    
    const versionNumber = await this.getNextVersionNumber(projectId);
    
    return await this.db.query(query, [
      projectId,
      JSON.stringify(version),
      new Date(),
      versionNumber
    ]);
}

  // Get next version number
  private async getNextVersionNumber(projectId: string): Promise<number> {
    const query = 'SELECT MAX(version_number) as max_version FROM visual_editor_project_versions WHERE project_id = $1';
    const result = await this.db.query(query, [projectId]);
    return (result.rows[0]?.max_version || 0) + 1;
}

  // Project analytics
  async trackProjectUsage(projectId: string, action: string, metadata: any) {
    const query = `
      INSERT INTO visual_editor_analytics 
      (project_, idaction, metadata, created_at)
      VALUES ($1, $2, $3, $4)
    `;
    
    return await this.db.query(query, [
      projectId,
      action,
      JSON.stringify(metadata),
      new Date()
    ]);
}

  // Template management
  async saveAsTemplate(project: any, templateName: string) {
    const query = `
      INSERT INTO visual_editor_templates 
      (, idname, elements, page_settings, created_at, created_by)
      VALUES ($1, $2, $3, $4, $5, $6)
    `;
    
    return await this.db.query(query, [
      `template_${Date.now()}`,
      templateName,
      JSON.stringify(project.elements),
      JSON.stringify(project.pageSettings),
      new Date(),
      'current-user' // Replace with actual user ID
    ]);
}

  // Collaboration features
  async addCollaborator(projectId: string, userId: string, permissions: string[]) {
    const query = `
      INSERT INTO visual_editor_collaborators 
      (project_, iduser_id, permissions, created_at)
      VALUES ($1, $2, $3, $4)
    `;
    
    return await this.db.query(query, [
      projectId,
      userId,
      JSON.stringify(permissions),
      new Date()
    ]);
}

  // Get project collaborators
  async getProjectCollaborators(projectId: string) {
    const query = 'SELECT * FROM visual_editor_collaborators WHERE project_id = $1';
    const result = await this.db.query(query, [projectId]);
    return result.rows;
}

  // Get project versions
  async getProjectVersions(projectId: string) {
    const query = 'SELECT * FROM visual_editor_project_versions WHERE project_id = $1 ORDER BY created_at DESC';
    const result = await this.db.query(query, [projectId]);
    return result.rows;
}

  // Get project analytics
  async getProjectAnalytics(projectId: string) {
    const query = 'SELECT * FROM visual_editor_analytics WHERE project_id = $1 ORDER BY created_at DESC LIMIT 100';
    const result = await this.db.query(query, [projectId]);
    return result.rows;
}

  // Get all user projects
  async getUserProjects(userId: string) {
    const query = 'SELECT * FROM visual_editor_projects WHERE created_by = $1 ORDER BY updated_at DESC';
    const result = await this.db.query(query, [userId]);
    return result.rows;
}

  // Delete project
  async deleteProject(projectId: string) {
    const query = 'DELETE FROM visual_editor_projects WHERE id = $1';
    return await this.db.query(query, [projectId]);
}

  // Search projects
  async searchProjects(query: string, userId: string) {
    const searchQuery = `
      SELECT * FROM visual_editor_projects 
      WHERE created_by = $1 AND (name ILIKE $2 OR elements::text ILIKE $2)
      ORDER BY updated_at DESC
    `;
    const result = await this.db.query(searchQuery, [userId, `%${query}%`]);
    return result.rows;
}
}

export default DatabaseIntegrationService;

