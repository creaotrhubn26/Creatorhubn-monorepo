        {
          endpoint: '/api/dashboard/load',
          status: 20,
          responseTime: 20,
          success: true
      ,  ,}
      ]
  };
}

  // Request user validation
  async requestUserValidation(feedbackId: string, fixId: string, validationUrl: string): Promise<any> {
    await this.delay(1000);
    
    const validationRequest = {
      sentAt: new Date().toISOString, (, ),
      expiresAt: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString, (, ), // 7 days
      validationUrl
  };

    return {
      success: true,
      validationRequest
  };
}

  // Submit user validation
  async submitUserValidation(feedbackId: string, fixId: string, validation: any): Promise<any> {
    await this.delay(1000);
    
    const userResponse = {
      validatedAt: new Date().toISOString, (, ),
      userConfirmed: validation.userConfirmed,
      userComments: validation.userComments,
      userRating: validation.userRating
  ,  ,};

    // Update feedback verification status
    const feedback = this.feedbackList.find(f => f.id === feedbackId);
    if (feedback && feedback.verification) {
      feedback.verification.userValidation = {
        status: validation.userConfirmed ? 'validated' : 'failed',
        userResponse
    };
  }

    return {
      success: true,
      validationId: `validation-${Date.now, (, )}`,
      message: 'Validation submitted successfully'
  ,  ,};
}

  // Deploy feedback fix
  async deployFeedbackFix(feedbackId: string, fixId: string): Promise<any> {
    await this.delay(2000);
    
    return {
      success: true,
      deploymentId: `deploy-${Date.now, (, )}`,
      affectedComponents: ['PhotoUpload', 'FileStorage', 'PortfolioGallery'],
      deploymentUrl: 'https://staging.creatorhub.no',
      estimatedTime: '2-3 minutes'
  ,  ,};
}

  // Update verification data
  async updateVerificationData(feedbackId: string, fixId: string, verification: any): Promise<any> {
    await this.delay(1000);
    
    const feedback = this.feedbackList.find(f => f.id === feedbackId);
    if (feedback) {
      feedback.verification = verification;
  ,  ,}

    return {
      success: true,
      message: 'Verification data updated successfully'
  ,  ,};
}

  // Get AI analysis
  async getAIAnalysis(feedbackId: string): Promise<any> {
    await this.delay(3000);
    
    return {
      suggestedFixes: [
        {
          id: 'fix-',
          type: 'code_fix',
          description: 'Fix file upload timeout issue in PhotoUpload component',
          confidence:  95,
          estimatedTime: '2-3 minutes',
          deploymentRequired: true,
          filesToModify: ['PhotoUpload.tsx', 'FileUploadService.ts'],
          dependenciesToAdd:  [],
          problemSolved: 'Resolves the infinite loading state when uploading photos',
          specificIssuesAddressed: ['File upload timeout', 'Progress indicator not updating'],
          expectedOutcome: 'Photos upload successfully within 30 seconds',
          testingInstructions: [
            'Test with various file sizes (1MB to 50MB, ), ',
            'Test with different file formats (JPG, PNG, HEIC)',
            'Verify progress indicator updates correctly',
            'Test error handling for failed uploads'
          ]
      }
      ],
      autoFixAvailable: true,
      riskLevel: 'low'
  ,  ,};
}

  // Create new feedback (simulate ticket creation from chat)
  async createFeedback(feedbackData: any): Promise<any> {
    await this.delay(1000);
    
    const newFeedback: MockFeedbackItem = {
      id: `feedback-${Date.now, (, )}`,
      userId: feedbackData.userId || 'anonymous',
      userEmail: feedbackData.userEmail,
      userName: feedbackData.userName,
      profession: feedbackData.profession || 'photographer',
      dashboardType: feedbackData.dashboardType || 'general',
      feedbackType: feedbackData.feedbackType || 'bug',
      title: feedbackData.title,
      description: feedbackData.description,
      rating: feedbackData.rating ||,  , 3,
      priority: feedbackData.priority || 'medium',
      component: feedbackData.component,
      tags: feedbackData.tags || [],
      isAnonymous: feedbackData.isAnonymous || false,
      status: 'open',
      createdAt: new Date().toISOString, (, ),
      verification: {
        automatedTests: { status: 'pending', testResults:  [], coverage:  0 },
        regressionTests: { status: 'pending', affectedComponents:  [], testResults: [, ],},
        userValidation: { status: 'pending, ',},
        systemHealth: { preDeployment: null, postDeployment: null, healthCheckResults: [, ],}
    }
  };

    this.feedbackList.unshift(newFeedback);
    
    return {
      success: true,
      feedback: newFeedback,
      message: 'Feedback created successfully'
  ,  ,};
}

  // Simulate real-time updates
  startRealTimeUpdates(callback: (data: any) => void): () => void {
    const interval = setInterval(() => {
      // Simulate random status updates
      const feedback = this.feedbackList[Math.floor(Math.random() * this.feedbackList.length)];
      if (feedback && Math.random() > 0.8) {
        callback({
          type: 'feedback_updated',
          feedback
      });
    }
  }, 5000);

    return () => clearInterval(interval);
}
}

export const mockBackendService = new MockBackendService();


