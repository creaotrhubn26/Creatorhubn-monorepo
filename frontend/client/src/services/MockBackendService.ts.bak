}

  // Get system health
  async getSystemHealth(): Promise<MockSystemHealth> {
    await this.delay(1000);
    
    return {
      overall: 'healthy',
      totalEndpoints:  15,
      successfulEndpoints:  15,
      failedEndpoints:  0,
      averageResponseTime: 10,
      checks: [
        {
          endpoint: '/api/auth/login',
          status: 20,
          responseTime: 10,
          success: true
      , isPhotoOptimized: false, addedDate: "2024-01-01", lastUpdated: "2024-01-01", isNew: false, isRecentlyUpdated: false, source: "manual" as const, version: 1 },
