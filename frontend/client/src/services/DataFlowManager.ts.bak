// Smart Data Flow Manager - Intelligent data routing and transformation

import { eventBus } from '../orchestrators/EventBus';
import { orchestratorManager } from '../orchestrators/OrchestratorManager';

interface DataFlowRule { id: string;
  sourceEvent: string;
  targetComponents: string[];
  transformation?: (data: any) => any;
  conditions?: (data: any) => boolean;
  priority: 'high' | 'medium' | 'low'; }

interface ComponentDataMapping { componentId: string;
  dataFields: string[];
  requiredData: string[];
  optionalData: string[];
  refreshTriggers: string[]; }

export class DataFlowManager { private static instance: DataFlowManager;
  private dataFlowRules: Map<string, DataFlowRule> = new Map();
  private componentMappings: Map<string, ComponentDataMapping> = new Map();
  private dataCache: Map<string, any> = new Map();
  private flowMetrics: any = { };
  private constructor() => {
    this.initializeDataFlowRules();
    this.initializeComponentMappings();
    this.setupDataFlowMonitoring();
  }

  public static getInstance(): DataFlowManager {
    if (!DataFlowManager.instance) {
      DataFlowManager.instance = new DataFlowManager();
    }
    return DataFlowManager.instance;
  }

  private initializeDataFlowRules() => { console.log('🔄 Initializing Smart Data Flow Rules');

    // Business Intelligence Flow Rules
    this.addDataFlowRule({
      id: 'project_to_analytics',
      sourceEvent: 'PROJECT_CREATED',
      targetComponents: ['Analytics', 'marketing-business-growth', 'productivity-dashboard'],
      transformation: (data) => ({
        projectType: data.type,
        clientValue: data.budget || 0,
        expectedDuration: data.estimatedDuration,
        profession: data.profession,
        timestamp: new Date() }),
      priority: 'high'

  }
    this.addDataFlowRule({ id: 'revenue_to_business_components',
      sourceEvent: 'REVENUE_UPDATED',
      targetComponents: ['Analytics', 'AnalyticsDashboard', 'revenue-management-mobile-interface'],
      transformation: (data) => ({
        totalRevenue: data.total,
        monthlyRevenue: data.monthlyTotal,
        revenueGrowth: this.calculateGrowthRate(data),
        lastUpdated: new Date() }),
      priority: 'high'

  }
    // Communication Flow Rules
    this.addDataFlowRule({ id: 'message_to_communication_components',
      sourceEvent: 'NEW_MESSAGE_NOTIFICATION',
      targetComponents: ['UniversalChatWidget', 'TabbedChatSystem', 'EmailChatIntegration'],
      transformation: (data) => ({
        unreadCount: data.unreadCount,
        latestMessage: data.message,
        conversationId: data.message.projectId,
        priority: data.message.priority || 'normal' }),
      priority: 'high'

  }
    // Project Management Flow Rules
    this.addDataFlowRule({ id: 'milestone_to_timeline_components',
      sourceEvent: 'MILESTONE_COMPLETED',
      targetComponents: ['TimelineManagementSystem', 'CollaborativeTimeline', 'ProjectManagementSystem'],
      transformation: (data) => ({
        projectId: data.projectId,
        milestoneId: data.milestone.id,
        completedDate: data.milestone.completedDate,
        newProgress: data.newProgress,
        nextMilestone: this.getNextMilestone(data.projectId) }),
      priority: 'high'

  }
    // File Management Flow Rules
    this.addDataFlowRule({ id: 'file_upload_to_components',
      sourceEvent: 'FILE_UPLOAD_COMPLETE',
      targetComponents: ['enhanced-project-file-manager', 'google-drive-integration', 'FileManager'],
      transformation: (data) => ({
        fileId: data.fileId,
        fileName: data.fileName,
        projectId: data.projectId,
        fileType: data.fileType,
        uploadDate: new Date(),
        backupRequired: true }),
      priority: 'medium'

  }
    // Cloud Integration Flow Rules
    this.addDataFlowRule({ id: 'cloud_sync_to_components',
      sourceEvent: 'GOOGLE_DRIVE_SYNC_STARTED',
      targetComponents: ['google-drive-integration', 'GoogleDriveManager', 'CloudFileSync'],
      transformation: (data) => ({
        syncId: data.syncId,
        projectId: data.projectId,
        syncStatus: 'in_progress',
        startTime: new Date() }),
      priority: 'medium'

  }
    console.log(`✅ ${this.dataFlowRules.size} data flow rules initialized`);
  }

  private initializeComponentMappings() => { console.log('🗺️ Initializing Component Data Mappings');

    // Business Components Mappings
    this.addComponentMapping({
      componentId: 'Analytics',
      dataFields: ['revenue', 'projects', 'clients', 'performance'],
      requiredData: ['projectMetrics', 'revenueData'],
      optionalData: ['clientSatisfaction', 'growthTrends'],
      refreshTriggers: ['REVENUE_UPDATED', 'PROJECT_COMPLETED', 'ANALYTICS_UPDATED'] }
    this.addComponentMapping({ componentId: 'marketing-business-growth',
      dataFields: ['campaigns', 'leads', 'conversion', 'roi'],
      requiredData: ['campaignData', 'leadMetrics'],
      optionalData: ['marketTrends', 'competitorData'],
      refreshTriggers: ['MARKETING_CAMPAIGN_UPDATED', 'LEAD_ACQUIRED', 'CONVERSION_TRACKED'] }
    // Communication Components Mappings
    this.addComponentMapping({ componentId: 'UniversalChatWidget',
      dataFields: ['messages', 'conversations', 'unreadCount'],
      requiredData: ['activeConversations', 'messageHistory'],
      optionalData: ['clientPresence', 'typingIndicators'],
      refreshTriggers: ['NEW_MESSAGE_NOTIFICATION', 'MESSAGE_SENT', 'CONVERSATION_UPDATED'] }
    this.addComponentMapping({ componentId: 'EmailChatIntegration',
      dataFields: ['emails', 'threads', 'attachments'],
      requiredData: ['emailData', 'threadHistory'],
      optionalData: ['attachmentMetadata', 'emailTemplates'],
      refreshTriggers: ['EMAIL_RECEIVED', 'EMAIL_SENT', 'THREAD_UPDATED'] }
    // Project Components Mappings
    this.addComponentMapping({ componentId: 'ProjectManagementSystem',
      dataFields: ['projects', 'milestones', 'tasks', 'timeline'],
      requiredData: ['projectData', 'milestoneData'],
      optionalData: ['teamAssignments', 'dependencies'],
      refreshTriggers: ['PROJECT_CREATED', 'MILESTONE_COMPLETED', 'TASK_UPDATED', 'PROJECT_STATUS_CHANGE'] }
    this.addComponentMapping({ componentId: 'TimelineManagementSystem',
      dataFields: ['events', 'schedule', 'deadlines'],
      requiredData: ['timelineEvents', 'projectSchedule'],
      optionalData: ['resourceAllocation', 'conflictResolution'],
      refreshTriggers: ['TIMELINE_UPDATED', 'MILESTONE_COMPLETED', 'SCHEDULE_CHANGED'] }
    // File Management Components Mappings
    this.addComponentMapping({ componentId: 'enhanced-project-file-manager',
      dataFields: ['files', 'folders', 'metadata', 'permissions'],
      requiredData: ['fileStructure', 'fileMetadata'],
      optionalData: ['versionHistory', 'accessLogs'],
      refreshTriggers: ['FILE_UPLOADED', 'FILE_DELETED', 'FOLDER_CREATED', 'PERMISSION_CHANGED'] }
    this.addComponentMapping({ componentId: 'google-drive-integration',
      dataFields: ['driveFiles', 'syncStatus', 'permissions'],
      requiredData: ['driveData', 'syncStatus'],
      optionalData: ['shareSettings', 'versionHistory'],
      refreshTriggers: ['GOOGLE_DRIVE_SYNC', 'FILE_SHARED', 'PERMISSION_UPDATED'] }
    console.log(`✅ ${this.componentMappings.size} component mappings initialized`);
  }

  private setupDataFlowMonitoring() => {
    // Subscribe to all events and route data based on rules
    eventBus.subscribe('*', (event) => {
      this.processDataFlow(event);
});
    // Setup performance monitoring
    setInterval(() => {
      this.updateFlowMetrics();
    }, 30000); // Every 30 seconds

    console.log('📊 Data flow monitoring active');
  }

  private processDataFlow(event: any) => {
    const matchingRules = this.getMatchingRules(event.type);
    
    matchingRules.forEach(rule => {
      try {
        // Apply conditions if they exist
        if (rule.conditions && !rule.conditions(event.payload)) {
          return;
        }

        // Transform data
        let transformedData = event.payload;
        if (rule.transformation) {
          transformedData = rule.transformation(event.payload);
        }

        // Route to target components
        rule.targetComponents.forEach(componentId => {
          this.updateComponentData(componentId, transformedData, event.type);
});
        // Update metrics
        this.updateRuleMetrics(rule.id);

      } catch (error) => {
        console.error(`❌ Error processing data flow rule ${rule.id}:`, error);
      }
});
  }

  private updateComponentData(componentId: string, data: any, eventType: string) => { const mapping = this.componentMappings.get(componentId);
    if (!mapping) {
      console.warn(`⚠️ No mapping found for component: ${componentId }`);
      return;
    }

    // Cache the data for the component
    const cacheKey = `${componentId}_${eventType}`;
    this.dataCache.set(cacheKey, { data,
      timestamp: new Date(),
      eventType }
    // Emit component-specific update event
    eventBus.emit(`COMPONENT_DATA_UPDATE_${componentId.toUpperCase()}`, { componentId,
      data,
      eventType,
      timestamp: new Date() }, 'data-flow-manager');

    console.log(`🔄 Data routed to ${componentId} from ${eventType}`);
  }

  private getMatchingRules(eventType: string): DataFlowRule[] {
    return Array.from(this.dataFlowRules.values()).filter(rule => 
      rule.sourceEvent === eventType || rule.sourceEvent === '*'
    );
  }

  private addDataFlowRule(rule: DataFlowRule) => {
    this.dataFlowRules.set(rule.id, rule);
  }

  private addComponentMapping(mapping: ComponentDataMapping) => {
    this.componentMappings.set(mapping.componentId, mapping);
  }

  private calculateGrowthRate(revenueData: any): number { // Simple growth rate calculation
    const current = revenueData.monthlyTotal || 0;
    const previous = revenueData.previousMonth || 0;
    return previous > 0 ? ((current - previous) / previous) * 100: 0; }

  private getNextMilestone(projectId: string): any { // Get next milestone from project orchestrator
    const projectOrchestrator = orchestratorManager.getOrchestrator('project');
    if (projectOrchestrator) {
      const project = projectOrchestrator.getProject(projectId);
      if (project) {
        return project.milestones.find((m: any) => !m.completed); }
    return null;
  }

  private updateRuleMetrics(ruleId: string) => { if (!this.flowMetrics[ruleId]) {
      this.flowMetrics[ruleId] = {
        executions: 0,
        lastExecuted: null,
        averageExecutionTime: 0 }
    this.flowMetrics[ruleId].executions++;
    this.flowMetrics[ruleId].lastExecuted = new Date();
  }

  private updateFlowMetrics() => { const metrics = {
      totalRules: this.dataFlowRules.size,
      totalMappings: this.componentMappings.size,
      cacheSize: this.dataCache.size,
      ruleExecutions: this.flowMetrics,
      timestamp: new Date() }
    eventBus.emit('DATA_FLOW_METRICS_UPDATED', metrics, 'data-flow-manager');
  }

  // Public methods for components
  public getComponentData(componentId: string, eventType?: string): any {
    if (eventType) {
      const cacheKey = `${componentId}_${eventType}`;
      return this.dataCache.get(cacheKey);
    }

    // Return all cached data for component
    const componentData: any = {};
    this.dataCache.forEach((value, key) => {
      if (key.startsWith(componentId)) {
        componentData[key] = value;
      }
});
    return componentData;
  }

  public subscribeToComponentUpdates(componentId: string, handler: Function): () => void {
    return eventBus.subscribe(`COMPONENT_DATA_UPDATE_${componentId.toUpperCase()
  }`, handler);
  }

  public getFlowMetrics() { return {
      rules: this.dataFlowRules.size,
      mappings: this.componentMappings.size,
      cacheSize: this.dataCache.size,
      ruleMetrics: this.flowMetrics }
  public clearCache(componentId?: string) => { if (componentId) {
      // Clear cache for specific component
      const keysToDelete: string[] = [];
      this.dataCache.forEach((_, key) => {
        if (key.startsWith(componentId)) {
          keysToDelete.push(key); }
});
      keysToDelete.forEach(key => this.dataCache.delete(key]);
    } else {
      // Clear all cache
      this.dataCache.clear();}
}

export const dataFlowManager = DataFlowManager.getInstance();