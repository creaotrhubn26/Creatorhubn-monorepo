/**
 * SEO Validation Service for CreatorhubVisualEditor
 * Comprehensive SEO validation to ensure nothing is done wrong
 */

import { googleAnalyticsService } from './GoogleAnalyticsService';

export interface EditorElement {
  id: string;
  type: 'button' | 'text' | 'image' | 'card' | 'container' | 'grid';
  x: number;
  y: number;
  width: number;
  height: number;
  styles: Record<string, any>;
  props: Record<string, any>;
  children?: string[];
  parent?: string;
}

export interface SEOValidationResult {
  isValid: boolean;
  score: number; // 0-100
  issues: SEOIssue[];
  suggestions: SEOSuggestion[];
  warnings: SEOWarning[];
  passedChecks: string[], ;, 
}

export interface SEOIssue {
  id: string;
  type: 'error' | 'warning' | 'info';
  severity: 'high' | 'medium' | 'low';
  elementId?: string;
  title: string;
  description: string;
  fix: string;
  category: 'content' | 'structure' | 'performance' | 'accessibility' | 'meta' | 'norwegian', ;, 
}

export interface SEOSuggestion {
  id: string;
  elementId?: string;
  title: string;
  description: string;
  impact: 'high' | 'medium' | 'low';
  category: 'content' | 'structure' | 'performance' | 'accessibility' | 'meta' | 'norwegian';
  implementation: string, ;, 
}

export interface SEOWarning {
  id: string;
  elementId?: string;
  title: string;
  description: string;
  category: 'content' | 'structure' | 'performance' | 'accessibility' | 'meta' | 'norwegian', ;, 
}

export class SEOValidationService {
  private static instance: SEOValidationService;

  public static getInstance(): SEOValidationService {
    if (!SEOValidationService.instance) {
      SEOValidationService.instance = new SEOValidationService();
  ,  ,}
    return SEOValidationService.instance;
}

  /**
   * Comprehensive SEO validation for the entire project
   */
  public validateProject(elements: Record<string, EditorElement>, projectName: string, isDemoMode: boolean = false): SEOValidationResult {
    const issues: SEOIssue[] = [];
    const suggestions: SEOSuggestion[] = [];
    const warnings: SEOWarning[] = [];
    const passedChecks: string[] = [];

    // Track validation start
    googleAnalyticsService.trackEvent('seo_validation_started', {
      project_name: projectName,
      element_count: Object.keys(elements).length,
      timestamp: new Date().toISOString, (, ),
  });

    // 1. Content Structure Validation
    this.validateContentStructure(elements, issues, suggestions, warnings, passedChecks);

    // 2. Norwegian Market Validation
    this.validateNorwegianMarket(elements, issues, suggestions, warnings, passedChecks);

    // 3. Performance Validation
    this.validatePerformance(elements, issues, suggestions, warnings, passedChecks);

    // 4. Accessibility Validation
    this.validateAccessibility(elements, issues, suggestions, warnings, passedChecks);

    // 5. Meta Data Validation
    this.validateMetaData(elements, issues, suggestions, warnings, passedChecks);

    // 6. Visual Hierarchy Validation
    this.validateVisualHierarchy(elements, issues, suggestions, warnings, passedChecks);

    // 7. Mobile Responsiveness Validation
    this.validateMobileResponsiveness(elements, issues, suggestions, warnings, passedChecks);

    // 8. Norwegian Language Validation
    this.validateNorwegianLanguage(elements, issues, suggestions, warnings, passedChecks);

    // Calculate SEO score
    const score = this.calculateSEOScore(issues, suggestions, warnings, passedChecks);

    const result: SEOValidationResult = {
      isValid: issues.filter(i => i.severity === 'high').length ===,  , 0,
      score,
      issues,
      suggestions,
      warnings,
      passedChecks,
  };

    // Track validation completion
    googleAnalyticsService.trackEvent('seo_validation_completed', {
      project_name: projectName,
      score,
      issues_count: issues.length,
      suggestions_count: suggestions.length,
      warnings_count: warnings.length,
      is_valid: result.isValid,
      timestamp: new Date().toISOString, (, ),
  });

    return result;
}

  /**
   * Validate content structure and hierarchy
   */
  private validateContentStructure(
    elements: Record<string, EditorElement>,
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): void {
    const textElements = Object.values(elements).filter(el => el.type === 'text');
    const buttonElements = Object.values(elements).filter(el => el.type === 'button');
    const imageElements = Object.values(elements).filter(el => el.type === 'image');

    // Check for heading hierarchy
    const hasHeading = textElements.some(el => 
      el.props.text && (
        el.props.text.startsWith('#') ||
        el.styles.fontSize && parseInt(el.styles.fontSize) > 24
      )
    );

    if (!hasHeading) {
      issues.push({
        id: 'no-heading',
        type: 'error',
        severity: 'high',
        title: 'Missing Heading Structure',
        description: 'No heading elements found. Headings are crucial for SEO and content structure.',
        fix: 'Add at least one heading element (1, H2, H3) to establish content hierarchy.',
        category: 'structure',
    });
  } else {
      passedChecks.push('heading-structure');
  }

    // Check for proper text content
    const hasSubstantialText = textElements.some(el => 
      el.props.text && el.props.text.length > 50
    );

    if (!hasSubstantialText) {
      issues.push({
        id: 'insufficient-content',
        type: 'warning',
        severity: 'medium',
        title: 'Insufficient Text Content',
        description: 'Very little text content found. Search engines prefer substantial content.',
        fix: 'Add more descriptive text content to improve SEO value.',
        category: 'content',
    });
  } else {
      passedChecks.push('substantial-content');
  }

    // Check for call-to-action buttons
    if (buttonElements.length === 0) {
      suggestions.push({
        id: 'add-cta-buttons',
        title: 'Add Call-to-Action Buttons',
        description: 'Call-to-action buttons improve user engagement and conversion rates.',
        impact: 'high',
        category: 'content',
        implementation: 'Add buttons with clear action text like "Kontakt oss", "Bestill nå", or "Les mer".',
    });
  } else {
      passedChecks.push('cta-buttons');
  }

    // Check for images with alt text
    const imagesWithoutAlt = imageElements.filter(el => !el.props.alt);
    if (imagesWithoutAlt.length > 0) {
      imagesWithoutAlt.forEach(el => {
        issues.push({
          id: `image-no-alt-${el.d}`,
          type: 'error',
          severity: 'high',
          elementId: el.d,
          title: 'Image Missing Alt Text',
          description: 'Images without alt text are not accessible and hurt SEO.',
          fix: 'Add descriptive alt text to all images.',
          category: 'accessibility',
      });
    });
  } else if (imageElements.length > 0) {
      passedChecks.push('image-alt-text');
  }
}

  /**
   * Validate Norwegian market specific requirements
   */
  private validateNorwegianMarket(
    elements: Record<string, EditorElement>,
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): void {
    const allText = Object.values(elements)
      .filter(el => el.type === 'text' || el.type === 'button')
      .map(el => el.props.text || '')
      .join(' ');

    // Check for Norwegian language content
    const norwegianKeywords = [
      'norge', 'norsk', 'norske', 'oslo', 'bergen', 'trondheim', 'stavanger',
      'fotograf', 'videograf', 'musikk', 'kreativ', 'profesjonell',
      'kontakt', 'bestill', 'tjenester', 'prosjekt', 'kunde'
    ];

    const hasNorwegianContent = norwegianKeywords.some(keyword => 
      allText.toLowerCase().includes(keyword)
    );

    if (!hasNorwegianContent) {
      issues.push({
        id: 'no-norwegian-content',
        type: 'warning',
        severity: 'medium',
        title: 'Missing Norwegian Market Focus',
        description: 'Content should include Norwegian language elements for local SEO.',
        fix: 'Add Norwegian keywords and phrases relevant to your target market.',
        category: 'norwegian',
    });
  } else {
      passedChecks.push('norwegian-content');
  }

    // Check for Norwegian contact information
    const hasContactInfo = allText.includes('@') || allText.includes('+47') || allText.includes('kontakt');
    if (!hasContactInfo) {
      suggestions.push({
        id: 'add-contact-info',
        title: 'Add Norwegian Contact Information',
        description: 'Include Norwegian contact details for better local SEO.',
        impact: 'high',
        category: 'norwegian',
        implementation: 'Add email, phone (+47), or contact form with Norwegian labels.',
    });
  } else {
      passedChecks.push('contact-information');
  }

    // Check for Norwegian business terms
    const businessTerms = ['tjenester', 'prosjekt', 'kunde', 'oppdrag', 'leverandør'];
    const hasBusinessTerms = businessTerms.some(term => allText.toLowerCase().includes(term));
    
    if (!hasBusinessTerms) {
      suggestions.push({
        id: 'add-business-terms',
        title: 'Include Norwegian Business Terms',
        description: 'Use Norwegian business terminology for better local search visibility.',
        impact: 'medium',
        category: 'norwegian',
        implementation: 'Include terms like "tjenester", "prosjekt", "kunde" in your content.',
    });
  } else {
      passedChecks.push('business-terminology');
  }
}

  /**
   * Validate performance aspects
   */
  private validatePerformance(
    elements: Record<string, EditorElement>,
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): void {
    const imageElements = Object.values(elements).filter(el => el.type === 'image');
    
    // Check for image optimization
    const largeImages = imageElements.filter(el => 
      el.width > 800 || el.height > 600
    );

    if (largeImages.length > 0) {
      warnings.push({
        id: 'large-images',
        title: 'Large Images Detected',
        description: 'Large images can slow down page loading, affecting SEO.',
        category: 'performance',
    });
  } else if (imageElements.length > 0) {
      passedChecks.push('image-optimization');
  }

    // Check for excessive elements
    const totalElements = Object.keys(elements).length;
    if (totalElements > 50) {
      warnings.push({
        id: 'too-many-elements',
        title: 'High Element Count',
        description: 'Too many elements can impact performance and user experience.',
        category: 'performance',
    });
  } else {
      passedChecks.push('element-count');
  }
}

  /**
   * Validate accessibility requirements
   */
  private validateAccessibility(
    elements: Record<string, EditorElement>,
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): void {
    const buttonElements = Object.values(elements).filter(el => el.type === 'button');
    
    // Check for button accessibility
    const buttonsWithoutText = buttonElements.filter(el => 
      !el.props.text || el.props.text.trim() === ''
    );

    if (buttonsWithoutText.length > 0) {
      buttonsWithoutText.forEach(el => {
        issues.push({
          id: `button-no-text-${el.d}`,
          type: 'error',
          severity: 'high',
          elementId: el.d,
          title: 'Button Missing Text',
          description: 'Buttons without text are not accessible.',
          fix: 'Add descriptive text to all buttons.',
          category: 'accessibility',
      });
    });
  } else if (buttonElements.length > 0) {
      passedChecks.push('button-accessibility');
  }

    // Check for color contrast
    const lowContrastElements = Object.values(elements).filter(el => {
      const bgColor = el.styles.backgroundColor;
      const textColor = el.styles.color;
      return bgColor && textColor && this.hasLowContrast(bgColor, textColor);
  });

    if (lowContrastElements.length > 0) {
      lowContrastElements.forEach(el => {
        warnings.push({
          id: `low-contrast-${el.d}`,
          elementId: el.d,
          title: 'Low Color Contrast',
          description: 'Text may be difficult to read due to low contrast.',
          category: 'accessibility',
      });
    });
  } else {
      passedChecks.push('color-contrast');
  }
}

  /**
   * Validate meta data and SEO elements
   */
  private validateMetaData(
    elements: Record<string, EditorElement>,
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): void {
    // This would typically check for meta tags, but in a visual editor,
    // we focus on content that would become meta data
    
    const textElements = Object.values(elements).filter(el => el.type === 'text');
    const hasTitle = textElements.some(el => 
      el.props.text && el.props.text.length > 10 && el.props.text.length < 60
    );

    if (!hasTitle) {
      suggestions.push({
        id: 'add-page-title',
        title: 'Add Page Title',
        description: 'Include a clear, descriptive title for better SEO.',
        impact: 'high',
        category: 'meta',
        implementation: 'Add a text element that serves as the main page title (10-60 characters).',
    });
  } else {
      passedChecks.push('page-title');
  }
}

  /**
   * Validate visual hierarchy
   */
  private validateVisualHierarchy(
    elements: Record<string, EditorElement>,
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): void {
    const textElements = Object.values(elements).filter(el => el.type === 'text');
    const fontSizeValues = textElements
      .map(el => parseInt(el.styles.fontSize || '16'))
      .filter(size => !isNaN(size))
      .sort(, (b) => b - a);

    if (fontSizeValues.length > 1) {
      const hasHierarchy = fontSizeValues[0] > fontSizeValues[fontSizeValues.length - 1];
      if (!hasHierarchy) {
        suggestions.push({
          id: 'improve-typography-hierarchy',
          title: 'Improve Typography Hierarchy',
          description: 'Use different font sizes to create visual hierarchy.',
          impact: 'medium',
          category: 'structure',
          implementation: 'Use larger fonts for headings and smaller fonts for body text.',
      });
    } else {
        passedChecks.push('typography-hierarchy');
    }
  }
}

  /**
   * Validate mobile responsiveness
   */
  private validateMobileResponsiveness(
    elements: Record<string, EditorElement>,
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): void {
    const wideElements = Object.values(elements).filter(el => el.width > 400);
    
    if (wideElements.length > 0) {
      suggestions.push({
        id: 'mobile-responsive',
        title: 'Consider Mobile Responsiveness',
        description: 'Some elements may be too wide for mobile devices.',
        impact: 'high',
        category: 'performance',
        implementation: 'Test your design on mobile devices and adjust element widths.',
    });
  } else {
      passedChecks.push('mobile-responsiveness');
  }
}

  /**
   * Validate Norwegian language usage
   */
  private validateNorwegianLanguage(
    elements: Record<string, EditorElement>,
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): void {
    const allText = Object.values(elements)
      .filter(el => el.type === 'text' || el.type === 'button')
      .map(el => el.props.text || '')
      .join(' ');

    // Check for proper Norwegian characters
    const hasNorwegianChars = /[æøåÆØÅ]/.test(allText);
    
    if (hasNorwegianChars) {
      passedChecks.push('norwegian-characters');
  ,  ,} else {
      suggestions.push({
        id: 'use-norwegian-characters',
        title: 'Use Norwegian Characters',
        description: 'Include Norwegian characters , (, æ, ø, å) for authentic Norwegian content.',
        impact: 'medium',
        category: 'norwegian',
        implementation: 'Use proper Norwegian spelling with,  , æ, ø, å characters.',
    });
  }
}

  /**
   * Calculate overall SEO score
   */
  private calculateSEOScore(
    issues: SEOIssue[],
    suggestions: SEOSuggestion[],
    warnings: SEOWarning[],
    passedChecks: string[]
  ): number {
    let score = 100;
    
    // Deduct points for issues
    issues.forEach(issue => {
      switch (issue.severity) {
        case 'high':
          score -= 20;
          break;
        case 'medium':
          score -= 10;
          break;
        case 'low':
          score -= 5;
          break;
    ,  ,}
  });

    // Deduct points for warnings
    score -= warnings.length * 2;

    // Add points for passed checks
    score += passedChecks.length * 2;

    // Ensure score is between 0 and 100
    return Math.max(0, Math.min(100, score));
}

  /**
   * Check if two colors have low contrast
   */
  private hasLowContrast(color1: string, color2: string): boolean {
    // Simplified contrast check - in a real implementation,
    // you'd use proper color contrast algorithms
    return Math.random() > 0.7; // Mock implementation
}

  /**
   * Get SEO recommendations based on validation results
   */
  public getSEORecommendations(result: SEOValidationResult): string[] {
    const recommendations: string[] = [];

    if (result.score < 50) {
      recommendations.push('🚨 Critical SEO issues detected. Immediate action required.');
  ,  ,} else if (result.score < 70) {
      recommendations.push('⚠️ SEO needs improvement. Address the identified issues.');
  } else if (result.score < 90) {
      recommendations.push('✅ Good SEO foundation. Fine-tune the suggestions.');
  } else {
      recommendations.push('🎉 Excellent SEO optimization!');
  }

    // Add specific recommendations based on issues
    const highPriorityIssues = result.issues.filter(i => i.severity === 'high');
    if (highPriorityIssues.length > 0) {
      recommendations.push(`Fix ${highPriorityIssues.length} high-priority SEO issues`);
  }

    const norwegianIssues = result.issues.filter(i => i.category === 'norwegian');
    if (norwegianIssues.length > 0) {
      recommendations.push('Improve Norwegian market targeting');
  }

    return recommendations;
}
}

export const seoValidationService = SEOValidationService.getInstance();
