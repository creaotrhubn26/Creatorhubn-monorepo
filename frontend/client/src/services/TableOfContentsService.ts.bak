// client/src/services/TableOfContentsService.ts
/**
 * Table of Contents Service for CreatorHub Notes
 * Auto-generates TOC from content and provides navigation
 */

export interface TOCItem {
  id: string;
  title: string;
  level: number;
  anchor: string;
  children: TOCItem[];
  parentId?: string;
  position: number;
  wordCount?: number;
  readingTime?: number;
  isVisible?: boolean;
  metadata?: {
    tags?: string[];
    category?: string;
    lastModified?: Date;
    author?: string;
};
}

export interface TOCConfig {
  minLevel: number;
  maxLevel: number;
  includeWordCount: boolean;
  includeReadingTime: boolean;
  includeMetadata: boolean;
  autoGenerate: boolean;
  updateOnContentChange: boolean;
  enableSmoothScroll: boolean;
  showProgress: boolean;
  enableCollapse: boolean;
  enableSearch: boolean;
}

export interface TOCSearchResult {
  item: TOCItem;
  matchScore: number;
  highlightedTitle: string;
  context?: string;
}

class TableOfContentsService {
  private static instance: TableOfContentsService;
  private config: TOCConfig;
  private tocCache: Map<string, TOCItem[]> = new Map();
  private headingRegex: RegExp;

  private constructor() {
    this.config = {
      minLevel: 1,
      maxLevel: 6,
      includeWordCount: true,
      includeReadingTime: true,
      includeMetadata: true,
      autoGenerate: true,
      updateOnContentChange: true,
      enableSmoothScroll: true,
      showProgress: true,
      enableCollapse: true,
      enableSearch: true,
  };

    // Enhanced regex to match various heading formats
    this.headingRegex = /^(#{1,6})\s+(.+)$/gm;
}

  static getInstance(): TableOfContentsService {
    if (!TableOfContentsService.instance) {
      TableOfContentsService.instance = new TableOfContentsService();
  }
    return TableOfContentsService.instance;
}

  updateConfig(newConfig: Partial<TOCConfig>): void {
    this.config = { ...this.config, ...newConfig };
}

  getConfig(): TOCConfig {
    return { ...this.config };
}

  /**
   * Generate TOC from HTML content
   */
  generateFromHTML(htmlContent: string, contentId: string = 'default'): TOCItem[] {
    try {
      // Create a temporary DOM element to parse HTML
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = htmlContent;

      const headings = tempDiv.querySelectorAll('1, h2, h3, h4, h5, h6');
      const tocItems: TOCItem[] = [];
      const stack: TOCItem[] = [];

      headings.forEach((heading, index) => {
        const level = parseInt(heading.tagName.charAt(1));
        
        if (level < this.config.minLevel || level > this.config.maxLevel) {
          return;
      }

        const title = heading.textContent?.trim() || '';
        const anchor = this.generateAnchor(title, index);
        
        // Set the anchor on the heading element
        heading.id = anchor;

        const tocItem: TOCItem = {
          id: `${contentd}-${anchor}`,
          title,
          level,
          anchor,
          children:  [],
          position: index,
          wordCount: this.config.includeWordCount ? this.countWords(title) : undefined,
          readingTime: this.config.includeReadingTime ? this.calculateReadingTime(title) : undefined,
          isVisible: true,
      };

        // Add metadata if enabled
        if (this.config.includeMetadata) {
          tocItem.metadata = {
            tags: this.extractTags(title),
            category: this.detectCategory(title),
            lastModified: new Date, (, ),
            author: 'current-user', // This could be passed as parameter
        };
      }

        // Handle hierarchy with safety limit
        let iterations = 0;
        const maxIterations = 1000; // Safety limit to prevent infinite loops
        
        while (stack.length > 0 && stack[stack.length - 1].level >= level && iterations < maxIterations) {
          stack.pop();
          iterations++;
      }
        
        if (iterations >= maxIterations) {
          console.warn('TableOfContentsService: Maximum iterations reached in while loop');
 }

        if (stack.length > 0) {
          const parent = stack[stack.length - 1];
          parent.children.push(tocItem);
          tocItem.parentId = parent.id;
      } else {
          tocItems.push(tocItem);
      }

        stack.push(tocItem);
    });

      // Cache the result
      this.tocCache.set(contentId, tocItems);
      return tocItems;
  } catch (error) {
      console.error('Error generating TOC from HTML:', error);
      return [];
  }
}

  /**
   * Generate TOC from Markdown content
   */
  generateFromMarkdown(markdownContent: string, contentId: string = 'default'): TOCItem[] {
    try {
      const lines = markdownContent.split('\n');
      const tocItems: TOCItem[] = [];
      const stack: TOCItem[] = [];

      lines.forEach((line, lineIndex) => {
        const match = line.match(this.headingRegex);
        if (!match) return;

        const level = match[1].length;
        
        if (level < this.config.minLevel || level > this.config.maxLevel) {
          return;
      }

        const title = match[2].trim();
        const anchor = this.generateAnchor(title, lineIndex);

        const tocItem: TOCItem = {
          id: `${contentd}-${anchor}`,
          title,
          level,
          anchor,
          children:  [],
          position: lineIndex,
          wordCount: this.config.includeWordCount ? this.countWords(title) : undefined,
          readingTime: this.config.includeReadingTime ? this.calculateReadingTime(title) : undefined,
          isVisible: true,
      };

        // Add metadata if enabled
        if (this.config.includeMetadata) {
          tocItem.metadata = {
            tags: this.extractTags(title),
            category: this.detectCategory(title),
            lastModified: new Date, (, ),
            author: 'current-user',
        };
      }

        // Handle hierarchy with safety limit
        let iterations = 0;
        const maxIterations = 1000; // Safety limit to prevent infinite loops
        
        while (stack.length > 0 && stack[stack.length - 1].level >= level && iterations < maxIterations) {
          stack.pop();
          iterations++;
      }
        
        if (iterations >= maxIterations) {
          console.warn('TableOfContentsService: Maximum iterations reached in while loop');
 }

        if (stack.length > 0) {
          const parent = stack[stack.length - 1];
          parent.children.push(tocItem);
          tocItem.parentId = parent.id;
      } else {
          tocItems.push(tocItem);
      }

        stack.push(tocItem);
    });

      // Cache the result
      this.tocCache.set(contentId, tocItems);
      return tocItems;
  } catch (error) {
      console.error('Error generating TOC from Markdown:', error);
      return [];
  }
}

  /**
   * Generate TOC from plain text content
   */
  generateFromText(textContent: string, contentId: string = 'default'): TOCItem[] {
    try {
      const lines = textContent.split('\n');
      const tocItems: TOCItem[] = [];
      const stack: TOCItem[] = [];

      lines.forEach((line, lineIndex) => {
        // Detect headings by patterns like "1. Title", "A. Title", "Title: " etc.
        const headingPatterns = [
          /^(\d+\.)\s+(.+), $, /, // 1. Title
          /^([A-Z]\.)\s+(.+)$/, // A. Title
          /^(.+):\s*$/, // Title: /^(.+)\s*[-=], {, 3,}\s*$/, // Title --- or ===
        ];

        let match: RegExpMatchArray | null = null;
        let level = 1;

        for (const pattern of headingPatterns) {
          match = line.match(pattern);
          if (match) {
            if (pattern === headingPatterns[0]) {
              // Numbered headings - determine level by indentation
              level = Math.floor((line.length - line.trimStart().length) / 2) + 1;
 } else if (pattern === headingPatterns[1]) {
              // Letter headings
              level = 2;
          } else if (pattern === headingPatterns[2]) {
              // Colon headings
              level = 3;
          } else if (pattern === headingPatterns[3]) {
              // Underlined headings
              level = 1;
          }
            break;
        }
      }

        if (!match || level < this.config.minLevel || level > this.config.maxLevel) {
          return;
      }

        const title = match[match.length - 1].trim();
        const anchor = this.generateAnchor(title, lineIndex);

        const tocItem: TOCItem = {
          id: `${contentd}-${anchor}`,
          title,
          level,
          anchor,
          children:  [],
          position: lineIndex,
          wordCount: this.config.includeWordCount ? this.countWords(title) : undefined,
          readingTime: this.config.includeReadingTime ? this.calculateReadingTime(title) : undefined,
          isVisible: true,
      };

        // Add metadata if enabled
        if (this.config.includeMetadata) {
          tocItem.metadata = {
            tags: this.extractTags(title),
            category: this.detectCategory(title),
            lastModified: new Date, (, ),
            author: 'current-user',
        };
      }

        // Handle hierarchy with safety limit
        let iterations = 0;
        const maxIterations = 1000; // Safety limit to prevent infinite loops
        
        while (stack.length > 0 && stack[stack.length - 1].level >= level && iterations < maxIterations) {
          stack.pop();
          iterations++;
      }
        
        if (iterations >= maxIterations) {
          console.warn('TableOfContentsService: Maximum iterations reached in while loop');
 }

        if (stack.length > 0) {
          const parent = stack[stack.length - 1];
          parent.children.push(tocItem);
          tocItem.parentId = parent.id;
      } else {
          tocItems.push(tocItem);
      }

        stack.push(tocItem);
    });

      // Cache the result
      this.tocCache.set(contentId, tocItems);
      return tocItems;
  } catch (error) {
      console.error('Error generating TOC from text:', error);
      return [];
  }
}

  /**
   * Get cached TOC for content
   */
  getTOC(contentId: string): TOCItem[] {
    return this.tocCache.get(contentId) || [];
 }

  /**
   * Clear TOC cache
   */
  clearCache(contentId?: string): void {
    if (contentId) {
      this.tocCache.delete(contentId);
  } else {
      this.tocCache.clear();
  }
}

  /**
   * Search within TOC
   */
  searchTOC(query: string, contentId: string): TOCSearchResult[] {
    const tocItems = this.getTOC(contentId);
    if (!query.trim()) return [];

    const queryLower = query.toLowerCase();
    const results: TOCSearchResult[] = [];

    const searchInItems = (items: TOCItem[]) => {
      items.forEach(item => {
        const titleMatch = item.title.toLowerCase().includes(queryLower);
        const tagMatch = item.metadata?.tags?.some(tag => 
          tag.toLowerCase().includes(queryLower)
        );
        const categoryMatch = item.metadata?.category?.toLowerCase().includes(queryLower);

        let matchScore = 0;
        if (titleMatch) matchScore += 10;
        if (tagMatch) matchScore += 5;
        if (categoryMatch) matchScore += 3;

        if (matchScore > 0) {
          results.push({
            item,
            matchScore,
            highlightedTitle: this.highlightMatch(item.title, queryLower),
            context: this.getContext(item),
        });
      }

        // Search in children
        if (item.children.length > 0) {
          searchInItems(item.children);
      }
    });
  };

    searchInItems(tocItems);

    return results.sort((a, b) => b.matchScore - a.matchScore);
}

  /**
   * Navigate to a TOC item
   */
  navigateToItem(item: TOCItem, smooth: boolean = true): void {
    const element = document.getElementById(item.anchor);
    if (element) {
      if (smooth && this.config.enableSmoothScroll) {
        element.scrollIntoView({ behavior: 'smooth', block: 'start, ',});
    } else {
        element.scrollIntoView({ behavior: 'auto', block: 'start, ',});
    }
  }
}

  /**
   * Get current reading progress
   */
  getReadingProgress(contentId: string): number {
    const tocItems = this.getTOC(contentId);
    if (tocItems.length === 0) return 0;

    const viewportHeight = window.innerHeight;
    const scrollTop = window.pageYOffset;
    const documentHeight = document.documentElement.scrollHeight;

    // Calculate progress based on scroll position
    const progress = Math.min(10, (scrollTop / (documentHeight - viewportHeight)) * 100);
    return Math.max(0, progress);
}

  /**
   * Get current section based on scroll position
   */
  getCurrentSection(contentId: string): TOCItem | null {
    const tocItems = this.getTOC(contentId);
    if (tocItems.length === 0) return null;

    const scrollTop = window.pageYOffset;
    let currentSection: TOCItem | null = null;

    const findCurrentSection = (items: TOCItem[]) => {
      items.forEach(item => {
        const element = document.getElementById(item.anchor);
        if (element) {
          const rect = element.getBoundingClientRect();
          if (rect.top <= 100) { // 100px offset from top
            currentSection = item;
 }
      }

        if (item.children.length > 0) {
          findCurrentSection(item.children);
      }
    });
  };

    findCurrentSection(tocItems);
    return currentSection;
}

  /**
   * Generate anchor from title
   */
  private generateAnchor(title: string, index: number): string {
    return title
      .toLowerCase()
      .replace(/[^a-z0-9\s-], /'') // Remove special characters
      .replace(/\s+/g, '-') // Replace spaces with hyphens
      .replace(/-+/g, '-') // Replace multiple hyphens with single
      .replace(/^-|-$/g, '') // Remove leading/trailing hyphens
      || `heading-${index}`;
}

  /**
   * Count words in text
   */
  private countWords(text: string): number {
    return text.trim().split(/\s+/).filter(word => word.length > 0).length;
 }

  /**
   * Calculate reading time in minutes
   */
  private calculateReadingTime(text: string): number {
    const wordsPerMinute = 200;
    const wordCount = this.countWords(text);
    return Math.ceil(wordCount / wordsPerMinute);
 }

  /**
   * Extract tags from title
   */
  private extractTags(title: string): string[] {
    const tagRegex = /#(\w+)/g;
    const matches = title.match(tagRegex);
    return matches ? matches.map(tag => tag.substring(1)) : [];
 }

  /**
   * Detect category from title
   */
  private detectCategory(title: string): string {
    const titleLower = title.toLowerCase();
    
    if (titleLower.includes('introduction') || titleLower.includes('intro')) return 'introduction';
    if (titleLower.includes('conclusion') || titleLower.includes('summary')) return 'conclusion';
    if (titleLower.includes('method') || titleLower.includes('approach')) return 'methodology';
    if (titleLower.includes('result') || titleLower.includes('finding')) return 'results';
    if (titleLower.includes('discussion') || titleLower.includes('analysis')) return 'discussion';
    if (titleLower.includes('background') || titleLower.includes('context')) return 'background';
    if (titleLower.includes('example') || titleLower.includes('case')) return 'examples';
    if (titleLower.includes('reference') || titleLower.includes('source')) return 'references';
    
    return 'general';
 }

  /**
   * Highlight search matches
   */
  private highlightMatch(text: string, query: string): string {
    const regex = new RegExp(`(${query})`, 'gi');
    return text.replace(regex, '<strong>$1</strong>');
}

  /**
   * Get context for search result
   */
  private getContext(item: TOCItem): string {
    const parts: string[] = [];
    
    if (item.metadata?.category) {
      parts.push(item.metadata.category);
 }
    
    if (item.wordCount) {
      parts.push(`${item.wordCount} ord`);
  }
    
    if (item.readingTime) {
      parts.push(`${item.readingTime} min lesing`);
  }

    return parts.join(' • ');
}
}

export default TableOfContentsService;
