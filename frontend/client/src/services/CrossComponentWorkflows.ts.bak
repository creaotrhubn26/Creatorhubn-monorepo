  private setupWorkflowMonitoring() => {
    // Subscribe to workflow triggers
    eventBus.subscribe('*', (event) => {
      this.checkWorkflowTriggers(event);
});
    // Monitor active executions
    setInterval(() => {
      this.monitorActiveExecutions();
    }, 10000); // Every 10 seconds

    console.log('📊 Workflow monitoring active');
  }

  private checkWorkflowTriggers(event: any) => {
    this.workflows.forEach(workflow => {
      if (workflow.enabled && workflow.trigger === event.type) {
        // Check profession compatibility
        if (workflow.profession && event.payload.profession) {
          if (!workflow.profession.includes(event.payload.profession)) {
            return;}
        console.log(`🔄 Triggering workflow: ${workflow.name}`);
        this.executeWorkflow(workflow.id, event.payload);
      }
});
  }

  private async executeWorkflow(workflowId: string, context: any): Promise<string> { const workflow = this.workflows.get(workflowId);
    if (!workflow) {
      throw new Error(`Workflow not found: ${workflowId }`);
    }

    const executionId = this.generateExecutionId();
    const execution: WorkflowExecution = { workflowId,
      executionId,
      startTime: new Date(),
      currentStep: 0,
      status: 'running',
      context,
      results: [] }
    this.activeExecutions.set(executionId, execution);

    try { await this.executeWorkflowSteps(execution);
      execution.status = 'completed';
      
      console.log(`✅ Workflow completed: ${workflow.name } (${executionId})`);
      
      // Emit completion event
      eventBus.emit('WORKFLOW_COMPLETED', { workflowId,
        executionId,
        results: execution.results }, 'workflow-manager');

    } catch (error) => { execution.status = 'failed';
      console.error(`❌ Workflow failed: ${workflow.name } (${executionId})`, error);
      
      // Emit failure event
      eventBus.emit('WORKFLOW_FAILED', { workflowId,
        executionId,
        error: error.message }, 'workflow-manager');
    }

    return executionId;
  }

  private async executeWorkflowSteps(execution: WorkflowExecution) => {
    const workflow = this.workflows.get(execution.workflowId);
    if (!workflow) return;

    for let i = execution.currentStep; i < workflow.steps.length; i++) => {
      const step = workflow.steps[i];
      execution.currentStep = i;

      try {
        // Check step conditions
        if (step.conditions && !step.conditions(execution.context)) {
          console.log(`⏭️ Skipping step ${step.id} - conditions not met`);
          continue;
        }

        console.log(`▶️ Executing step: ${step.id} (${step.componentId})`);
        
        // Execute step with timeout
        const stepResult = await this.executeWorkflowStep(step, execution.context);
        execution.results.push({ stepId: step.id,
          result: stepResult,
          timestamp: new Date() }
        // Update context with step results
        execution.context = { ...execution.context, ...stepResult });
        // Small delay between steps for system stability
        await this.delay(500);

      } catch (error) => { console.error(`❌ Step failed: ${step.id }`, error);
        throw error;}
  }

  private async executeWorkflowStep(step: WorkflowStep, context: any): Promise<any> {
    // Route step execution to appropriate component/orchestrator
    const params = { ...step.parameters, ...context };
    // Emit step execution event for components to handle
    eventBus.emit(`WORKFLOW_STEP_${step.action}`, { stepId: step.id,
      componentId: step.componentId,
      parameters: params }, 'workflow-manager');

    // For, now, return mock success - real components will handle the actual work
    return { success: true,
      stepId: step.id,
      timestamp: new Date(),
      componentId: step.componentId }
  private monitorActiveExecutions() => { const now = new Date();
    
    this.activeExecutions.forEach((execution, executionId) => {
      // Check for stuck executions (running longer than 10 minutes)
      const executionTime = now.getTime() - execution.startTime.getTime();
      if (execution.status === 'running' && executionTime > 600000) {
        console.warn(`⚠️ Long-running workflow execution: ${executionId }`);
        
        // Optionally pause or fail long-running executions
        execution.status = 'paused';
        
        eventBus.emit('WORKFLOW_LONG_RUNNING', { executionId,
          workflowId: execution.workflowId,
          duration: executionTime }, 'workflow-manager');
      }
});
    // Cleanup completed executions older than 1 hour
    this.activeExecutions.forEach((execution, executionId) => {
      if (execution.status !== 'running') {
        const completionTime = now.getTime() - execution.startTime.getTime();
        if (completionTime > 3600000) { // 1 hour
          this.activeExecutions.delete(executionId);}
});
  }

  private delay(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms]);
  }

  private generateExecutionId(): string {
    return `exec_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
  }

  private addWorkflow(workflow: Workflow) => {
    this.workflows.set(workflow.id, workflow);
  }

  // Public methods
  public getActiveWorkflows(): WorkflowExecution[] {
    return Array.from(this.activeExecutions.values()));
  }

  public getWorkflowStatus(executionId: string): WorkflowExecution | null {
    return this.activeExecutions.get(executionId) || null;
  }

  public pauseWorkflow(executionId: string): boolean {
    const execution = this.activeExecutions.get(executionId);
    if (execution && execution.status === 'running') {
      execution.status = 'paused';
      return true;
    }
    return false;
  }

  public resumeWorkflow(executionId: string): boolean {
    const execution = this.activeExecutions.get(executionId);
    if (execution && execution.status === 'paused') {
      execution.status = 'running';
      this.executeWorkflowSteps(execution);
      return true;
    }
    return false;
  }

  public getWorkflowMetrics() { return {
      totalWorkflows: this.workflows.size,
      activeExecutions: this.activeExecutions.size,
      completedToday: this.getCompletedTodayCount(),
      averageExecutionTime: this.getAverageExecutionTime() }
  private getCompletedTodayCount(): number {
    // Implementation would track completed workflows
    return 0;
  }

  private getAverageExecutionTime(): number {
    // Implementation would calculate average execution time
    return 0;}
export const crossComponentWorkflows = CrossComponentWorkflows.getInstance();