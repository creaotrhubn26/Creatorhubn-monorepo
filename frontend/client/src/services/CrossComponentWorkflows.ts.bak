});
    // Video Production Workflow
    this.addWorkflow({ id: 'video_production_complete',
      name: 'Komplett Videoproduksjon Workflow',
      description: 'Fra konsept til ferdig video',
      trigger: 'VIDEO_PROJECT_CREATED',
      profession: ['videographer'],
      priority: 'high',
      enabled: true,
      steps: [
        {
          id: 'generate_story_arc',
