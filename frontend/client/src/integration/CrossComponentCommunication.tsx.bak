/**
 * Cross-Component Communication System
 * Enables any component to communicate with any other component
 */

import React, { createContext, useContext, useCallback, useEffect, useRef } from 'react';
import { useIntegration } from './ComponentIntegrationManager';

// Communication message types
export interface CommunicationMessage {
  id: string;
  from: string;
  to: string | 'broadcast';
  type: string;
  data: any;
  timestamp: number;
  priority: 'low' | 'medium' | 'high' | 'critical';
  ttl?: number; // Time to live in milliseconds
}

// Component registry for tracking active components
interface ComponentRegistry {
  [componentId: string]: {
    componentType: string;
    capabilities: string[];
    lastSeen: number;
    status: 'active' | 'inactive' | 'error';
};
}

// Communication context
interface CommunicationContextType {
  // Send messages
  sendMessage: (message: Omit<CommunicationMessage, 'id' | 'timestamp'>) => void;
  sendBroadcast: (type: string, data: any, priority?: CommunicationMessage['priority']) => void;
  
  // Listen to messages
  onMessage: (callback: (message: CommunicationMessage) => void) => () => void;
  onMessageType: (type: string, callback: (message: CommunicationMessage) => void) => () => void;
  onMessageFrom: (from: string, callback: (message: CommunicationMessage) => void) => () => void;
  onMessageTo: (to: string, callback: (message: CommunicationMessage) => void) => () => void;
  
  // Component registry
  registerComponent: (componentId: string, componentType: string, capabilities: string[]) => void;
  unregisterComponent: (componentId: string) => void;
  getActiveComponents: () => ComponentRegistry;
  getComponentCapabilities: (componentId: string) => string[];
  
  // Message history
  getMessageHistory: (filter?: Partial<CommunicationMessage>) => CommunicationMessage[];
  clearMessageHistory: () => void; 
}

const CommunicationContext = createContext<CommunicationContextType | null>(null);

// Communication Provider
export const CommunicationProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const integration = useIntegration();
  
  const messageHistory = useRef<CommunicationMessage[]>([]);
  const componentRegistry = useRef<ComponentRegistry>({});
  const messageListeners = useRef<Set<(message: CommunicationMessage) => void>>(new Set());
  const typeListeners = useRef<Map<string, Set<(message: CommunicationMessage) => void>>>(new Map());
  const fromListeners = useRef<Map<string, Set<(message: CommunicationMessage) => void>>>(new Map());
  const toListeners = useRef<Map<string, Set<(message: CommunicationMessage) => void>>>(new Map());

  // Generate unique message ID
  const generateMessageId = useCallback(() => {
    return `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
}, []);

  // Send message
  const sendMessage = useCallback((message: Omit<CommunicationMessage, 'id' | 'timestamp'>) => {
    const fullMessage: CommunicationMessage = {
      ...message,
      id: generateMessageId(),
      timestamp: Date.now()
  };

    // Add to history
    messageHistory.current.push(fullMessage);
    
    // Keep only last 1000 messages
    if (messageHistory.current.length > 1000) {
      messageHistory.current = messageHistory.current.slice(-1000);
  }

    // Emit integration event
    integration.emit('communication:message', fullMessage);

    // Notify listeners
    messageListeners.current.forEach(listener => listener(fullMessage));
    
    // Notify type-specific listeners
    const typeListenerSet = typeListeners.current.get(message.type);
    if (typeListenerSet) {
      typeListenerSet.forEach(listener => listener(fullMessage));
  }
    
    // Notify from-specific listeners
    const fromListenerSet = fromListeners.current.get(message.from);
    if (fromListenerSet) {
      fromListenerSet.forEach(listener => listener(fullMessage));
  }
    
    // Notify to-specific listeners
    const toListenerSet = toListeners.current.get(message.to);
    if (toListenerSet) {
      toListenerSet.forEach(listener => listener(fullMessage));
  }

    // Handle TTL
    if (message.ttl) {
      setTimeout(() => {
        messageHistory.current = messageHistory.current.filter(m => m.id !== fullMessage.id);
    }, message.ttl);
  }
}, [integration, generateMessageId]);

  // Send broadcast message
  const sendBroadcast = useCallback((type: string, data: any, priority: CommunicationMessage['priority'] = 'medium') => {
    sendMessage({
      from: 'system',
      to: 'broadcast',
      type,
      data,
      priority
  });
}, [sendMessage]);

  // Listen to all messages
  const onMessage = useCallback((callback: (message: CommunicationMessage) => void) => {
    messageListeners.current.add(callback);
    return () => messageListeners.current.delete(callback);
}, []);

  // Listen to specific message type
  const onMessageType = useCallback((type: string, callback: (message: CommunicationMessage) => void) => {
    if (!typeListeners.current.has(type)) {
      typeListeners.current.set(type, new Set());
  }
    typeListeners.current.get(type)!.add(callback);
    return () => {
      const typeListenerSet = typeListeners.current.get(type);
      if (typeListenerSet) {
        typeListenerSet.delete(callback);
    }
  };
}, []);

  // Listen to messages from specific component
  const onMessageFrom = useCallback((from: string, callback: (message: CommunicationMessage) => void) => {
    if (!fromListeners.current.has(from)) {
      fromListeners.current.set(from, new Set());
  }
    fromListeners.current.get(from)!.add(callback);
    return () => {
      const fromListenerSet = fromListeners.current.get(from);
      if (fromListenerSet) {
        fromListenerSet.delete(callback);
    }
  };
}, []);

  // Listen to messages to specific component
  const onMessageTo = useCallback((to: string, callback: (message: CommunicationMessage) => void) => {
    if (!toListeners.current.has(to)) {
      toListeners.current.set(to, new Set());
  }
    toListeners.current.get(to)!.add(callback);
    return () => {
      const toListenerSet = toListeners.current.get(to);
      if (toListenerSet) {
        toListenerSet.delete(callback);
    }
  };
}, []);

  // Register component
  const registerComponent = useCallback((componentId: string, componentType: string, capabilities: string[]) => {
    componentRegistry.current[componentId] = {
      componentType,
      capabilities,
      lastSeen: Date.now(),
      status: 'active'
  };
    
    // Emit registration event
    integration.emit('communication:component:registered', {
      componentId,
      componentType,
      capabilities
  });
}, [integration]);

  // Unregister component
  const unregisterComponent = useCallback((componentId: string) => {
    delete componentRegistry.current[componentId];
    
    // Emit unregistration event
    integration.emit('communication:component:unregistered', { componentId });
}, [integration]);

  // Get active components
  const getActiveComponents = useCallback(() => {
    return { ...componentRegistry.current };
}, []);

  // Get component capabilities
  const getComponentCapabilities = useCallback((componentId: string) => {
    return componentRegistry.current[componentId]?.capabilities || [];
}, []);

  // Get message history
  const getMessageHistory = useCallback((filter?: Partial<CommunicationMessage>) => {
    if (!filter) return [...messageHistory.current];
    
    return messageHistory.current.filter(message => {
      return Object.entries(filter).every(([key, value]) => {
        return message[key as keyof CommunicationMessage] === value;
    });
  });
}, []);

  // Clear message history
  const clearMessageHistory = useCallback(() => {
    messageHistory.current = [];
}, []);

  // Update component status periodically
  useEffect(() => {
    const interval = setInterval(() => {
      const now = Date.now();
      Object.entries(componentRegistry.current).forEach(([componentId, component]) => {
        if (now - component.lastSeen > 30000) { // 30 seconds
          component.status = 'inactive';
      }
    });
  }, 5000);

    return () => clearInterval(interval);
}, []);

  const contextValue: CommunicationContextType = {
    sendMessage,
    sendBroadcast,
    onMessage,
    onMessageType,
    onMessageFrom,
    onMessageTo,
    registerComponent,
    unregisterComponent,
    getActiveComponents,
    getComponentCapabilities,
    getMessageHistory,
    clearMessageHistory
};

  return (
    <CommunicationContext.Provider value={contextValue}>
      {children}
    </CommunicationContext.Provider>
  );
};

// Hook to use communication system
export const useCommunication = () => {
  const context = useContext(CommunicationContext);
  if (!context) {
    throw new Error('useCommunication must be used within CommunicationProvider');
}
  return context;
};

// Pre-defined message types for common communications
export const MESSAGE_TYPES = {
  // Data messages
  DATA_REQUEST: 'data:request',
  DATA_RESPONSE: 'data:response',
  DATA_UPDATE: 'data:update',
  DATA_SYNC: 'data:sync',
  
  // UI messages
  UI_UPDATE: 'ui:update',
  UI_REFRESH: 'ui:refresh',
  UI_NOTIFY: 'ui:notify',
  UI_FOCUS: 'ui:focus',
  
  // Action messages
  ACTION_REQUEST: 'action:request',
  ACTION_RESPONSE: 'action:response',
  ACTION_EXECUTE: 'action:execute',
  
  // System messages
  SYSTEM_STATUS: 'system:status',
  SYSTEM_ERROR: 'system:error',
  SYSTEM_WARNING: 'system:warning',
  SYSTEM_INFO: 'system:info',
  
  // Collaboration messages
  COLLABORATION_JOIN: 'collaboration:join',
  COLLABORATION_LEAVE: 'collaboration:leave',
  COLLABORATION_UPDATE: 'collaboration:update',
  
  // Real-time messages
  REALTIME_UPDATE: 'realtime:update',
  REALTIME_SYNC: 'realtime:sync',
  REALTIME_NOTIFY: 'realtime:notify',
};

// HOC to add communication capabilities to components
export const withCommunication = <P extends object>(
  Component: React.ComponentType<P>
) => {
  return React.forwardRef<any, P & { componentId?: string; componentType?: string; capabilities?: string[] }>((props, ref) => {
    const communication = useCommunication();
    const { componentId, componentType, capabilities = [], ...restProps } = props;

    // Register component on mount
    useEffect(() => {
      if (componentId) {
        communication.registerComponent(componentId, componentType || 'unknown', capabilities);
        return () => communication.unregisterComponent(componentId);
    }
  }, [componentId, componentType, capabilities, communication]);

    return <Component {...(restProps as any)} ref={ref} communication={communication} />;
});
};

export default CommunicationProvider;


