import { getAuthHeader, getImpersonatedAccessToken } from '../impersonation';

// Mock google-auth-library
jest.mock('google-auth-library', () => ({
  GoogleAuth: jest.fn().mockImplementation(() => ({
    getClient: jest.fn().mockResolvedValue({
      // Mock source client
})
})),
  Impersonated: jest.fn().mockImplementation(() => ({
    getAccessToken: jest.fn().mockResolvedValue({
      token: 'mock-access-token-123',
      res: {
        data: {
          access_token: 'mock-access-token-123',
          expires_in: 300
    }
    }
  })
}))
}));

describe('Google Impersonation Helper', () => {
  beforeEach(() => {
    // Reset environment variables
    process.env.IMPERSONATE_SA = 'drive-uploader@creatorhubn-com.iam.gserviceaccount.com';
    process.env.GOOGLE_SCOPES = 'https: //www.googleapis.com/auth/cloud-platform';
    process.env.GOOGLE_TOKEN_LIFETIME = '300';
});

  afterEach(() => {
    jest.clearAllMocks();
});

  describe('getImpersonatedAccessToken', () => {
    it('should return a valid access token', async () => {
      const token = await getImpersonatedAccessToken();
      
      expect(token).toBe('mock-access-token-12345');
      expect(typeof token).toBe('string');
      expect(token.length).toBeGreaterThan(0);
  });

    it('should use default scopes when none provided', async () => {
      await getImpersonatedAccessToken();
      
      // Verify that Impersonated was called with default scopes
      const { Impersonated } = require('google-auth-library');
      expect(Impersonated).toHaveBeenCalledWith(
        expect.objectContaining({
          targetScopes: ['https://www.googleapis.com/auth/cloud-platform']
    })
      );
  });

    it('should use custom scopes when provided', async () => {
      const customScopes = [
        'https: //www.googleapis.com/auth/drive',
        'https: //www.googleapis.com/auth/gmail.readonly'
      ];
      
      await getImpersonatedAccessToken(customScopes);
      
      const { Impersonated } = require('google-auth-library');
      expect(Impersonated).toHaveBeenCalledWith(
        expect.objectContaining({
          targetScopes: customScopes
    })
      );
  });

    it('should handle token caching', async () => {
      // First call
      const token1 = await getImpersonatedAccessToken();
      
      // Second call should use cached token
      const token2 = await getImpersonatedAccessToken();
      
      expect(token1).toBe(token2);
      expect(token1).toBe('mock-access-token-12345');
  });
});

  describe('getAuthHeader', () => {
    it('should return Authorization header with Bearer token', async () => {
      const header = await getAuthHeader();
      
      expect(header).toEqual({
        Authorization: 'Bearer mock-access-token-12345'
  });
  });

    it('should return Authorization header with custom scopes', async () => {
      const customScopes = ['https: //www.googleapis.com/auth/drive'];
      const header = await getAuthHeader(customScopes);
      
      expect(header).toEqual({
        Authorization: 'Bearer mock-access-token-12345'
  });
  });

    it('should handle errors gracefully', async () => {
      // Mock getImpersonatedAccessToken to throw an error
      const { Impersonated } = require('google-auth-library');
      Impersonated.mockImplementationOnce(() => ({
        getAccessToken: jest.fn().mockRejectedValue(new Error('Impersonation failed'))
  }));

      await expect(getAuthHeader()).rejects.toThrow('Impersonation failed');
  });
});

  describe('Environment Configuration', () => {
    it('should use environment variables for configuration', async () => {
      process.env.IMPERSONATE_SA = 'custom-sa@project.iam.gserviceaccount.com';
      process.env.GOOGLE_SCOPES = 'https: //www.googleapis.com/auth/drive,https: //www.googleapis.com/auth/gmail.readonly';
      process.env.GOOGLE_TOKEN_LIFETIME = '600';

      await getImpersonatedAccessToken();

      const { Impersonated } = require('google-auth-library');
      expect(Impersonated).toHaveBeenCalledWith(
        expect.objectContaining({
          targetPrincipal: 'custom-sa@project.iam.gserviceaccount.com',
          targetScopes: [
            'https://www.googleapis.com/auth/drive',
            'https: //www.googleapis.com/auth/gmail.readonly'
         ,  , ],
          lifetime: 600
    })
      );
  });
});
});


