};

    this.followUpSequences.push(newSequence);
    return newSequence;
}

  triggerFollowUpSequence(sequenceId: string, clientId: string, projectId?: string): void {
    const sequence = this.followUpSequences.find(s => s.id === sequenceId);
    if (!sequence) return;

    sequence.steps.forEach(step => {
      setTimeout(() => {
        this.executeFollowUpStep(step, clientId, projectId);
  }, step.delay * 60 * 60 * 1000); // Convert hours to milliseconds
});
}

  private executeFollowUpStep(step: any, clientId: string, projectId?: string): void {
    // Implementation would execute the follow-up step
    console.log(`Executing follow-up step: ${step.template} for client ${clientId}`);
}

  // Client Success Metrics
  calculateClientMetrics(clientId: string, clientData: any): ClientSuccessMetrics {
    const metrics: ClientSuccessMetrics = {
      clientId,
      projectCount: clientData.projectCount || 0,
      totalSpent: clientData.totalSpent || 0,
      averageProjectValue: clientData.totalSpent / (clientData.projectCount || 1),
      lastProjectDate: new Date(clientData.lastProjectDate || Date.now()),
      satisfactionScore: clientData.satisfactionScore || 0,
      retentionRate: clientData.retentionRate || 0,
      lifetimeValue: clientData.lifetimeValue || 0,
      churnRisk: this.calculateChurnRisk(clientData),
      nextAction: this.getNextAction(clientData),
      lastUpdated: new Date()
    };

    const existingIndex = this.clientMetrics.findIndex(m => m.clientId === clientId);
    if (existingIndex >= 0) {
      this.clientMetrics[existingIndex] = metrics;
    } else {
      this.clientMetrics.push(metrics);
    }

    return metrics;
}

  private calculateChurnRisk(clientData: any): 'low' | 'medium' | 'high' {
    const daysSinceLastProject = Math.floor((Date.now() - new Date(clientData.lastProjectDate || Date.now()).getTime()) / (1000 * 60 * 60 * 24));
    const projectCount = clientData.projectCount || 0;
    const satisfactionScore = clientData.satisfactionScore || 0;

    if (daysSinceLastProject > 365 || satisfactionScore < 3) return 'high';
    if (daysSinceLastProject > 180 || satisfactionScore < 4) return 'medium';
    return 'low';
}

  private getNextAction(clientData: any): string {
    const churnRisk = this.calculateChurnRisk(clientData);
    
    switch (churnRisk) {
      case 'high': return 'Schedule follow-up call';
      case 'medium': return 'Send re-engagement email';
      case 'low': return 'Continue regular communication';
      default: return 'Monitor client activity';
}
}

  getClientMetrics(clientId?: string): ClientSuccessMetrics[] {
    if (clientId) {
      return this.clientMetrics.filter(m => m.clientId === clientId);
}
    return this.clientMetrics;
}

  // Analytics
  getCommunicationAnalytics(): Record<string, any> {
    const totalCommunications = this.communications.length;
    const sentCommunications = this.communications.filter(c => c.status === 'sent').length;
    const openedCommunications = this.communications.filter(c => c.status === 'opened').length;
    const clickedCommunications = this.communications.filter(c => c.status === 'clicked').length;

    return {
      totalCommunications,
      sentCommunications,
      openedCommunications,
      clickedCommunications,
      openRate: totalCommunications > 0 ? (openedCommunications / totalCommunications) * 100 : 0,
      clickRate: totalCommunications > 0 ? (clickedCommunications / totalCommunications) * 100 : 0,
      activeTemplates: this.templates.filter(t => t.isActive).length,
      activeSegments: this.clientSegments.length,
      activeFollowUps: this.followUpSequences.filter(s => s.isActive).length,
      overdueDeadlines: this.deadlineAlerts.filter(a => a.status ==='overdue').length
    };
  }
}

