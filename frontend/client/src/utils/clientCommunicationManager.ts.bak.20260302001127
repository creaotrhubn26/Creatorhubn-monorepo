  updateClientSegments(clientData: any[]): void {
    this.clientSegments.forEach(segment => {
      segment.clients = clientData.filter(client => this.matchesSegmentCriteria(client, segment.criteria)).map(c => c.id);
});
}

  private matchesSegmentCriteria(client: any, criteria: ClientSegment['criteria']): boolean {
    if (criteria.projectTypes && !criteria.projectTypes.includes(client.projectType)) {
      return false;
}

    if (criteria.projectCount) {
      const projectCount = client.projectCount || 0;
      if (criteria.projectCount.min && projectCount < criteria.projectCount.min) return false;
      if (criteria.projectCount.max && projectCount > criteria.projectCount.max) return false;
}

    if (criteria.totalSpent) {
      const totalSpent = client.totalSpent || 0;
      if (criteria.totalSpent.min && totalSpent < criteria.totalSpent.min) return false;
      if (criteria.totalSpent.max && totalSpent > criteria.totalSpent.max) return false;
}

    if (criteria.lastActivity) {
      const daysSinceLastActivity = Math.floor((Date.now() - new Date(client.lastActivity).getTime()) / (1000 * 60 * 60 * 24));
      if (daysSinceLastActivity > criteria.lastActivity.days) return false;
}

    return true;
}

