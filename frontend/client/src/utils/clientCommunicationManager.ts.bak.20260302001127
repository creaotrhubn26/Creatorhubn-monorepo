  // Communication Management
  createCommunication(data: Omit<ClientCommunication, 'id' | 'createdAt'>): ClientCommunication {
    const communication: ClientCommunication = {
      id: `comm-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
      createdAt: new Date(),
      ...data
};

    this.communications.push(communication);
    return communication;
}

  getCommunications(filter?: {
    clientId?: string;
    projectId?: string;
    status?: string;
    type?: string;
}): ClientCommunication[] {
    let filtered = this.communications;

    if (filter?.clientId) {
      filtered = filtered.filter(c => c.clientId === filter.clientId);
}

    if (filter?.projectId) {
      filtered = filtered.filter(c => c.projectId === filter.projectId);
}

    if (filter?.status) {
      filtered = filtered.filter(c => c.status === filter.status);
}

    if (filter?.type) {
      filtered = filtered.filter(c => c.type === filter.type);
}

    return filtered.sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());
}

  // Template Management
