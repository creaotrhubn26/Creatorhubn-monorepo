    return alert;
}

  getDeadlineAlerts(filter?: {
    projectId?: string;
    clientId?: string;
    status?: string;
}): DeadlineAlert[] {
    let filtered = this.deadlineAlerts;

    if (filter?.projectId) {
      filtered = filtered.filter(a => a.projectId === filter.projectId);
}

    if (filter?.clientId) {
      filtered = filtered.filter(a => a.clientId === filter.clientId);
}

    if (filter?.status) {
      filtered = filtered.filter(a => a.status === filter.status);
}

    return filtered.sort((a, b) => a.deadlineDate.getTime() - b.deadlineDate.getTime());
}

  checkDeadlineAlerts(): void {
    const now = new Date();
    const alerts = this.deadlineAlerts.filter(a => a.status === 'active');

    alerts.forEach(alert => {
      const daysUntilDeadline = Math.ceil((alert.deadlineDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
      
      alert.alertSettings.escalationLevels.forEach(level => {
        if (daysUntilDeadline <= level.daysBefore && daysUntilDeadline > 0) {
          // Send alert
          this.sendDeadlineAlert(alert, level);
    }
  });

      if (daysUntilDeadline < 0) {
        alert.status = 'overdue';
  }
});
}

  private sendDeadlineAlert(alert: DeadlineAlert, level: any): void {
