// Client Communication Manager
// Automated client communications and deadline management based on existing platform data

export interface ClientCommunication {
  id: string;
  clientId: string;
  projectId?: string;
  type: 'email' | 'sms' | 'push' | 'in-app';
  template: string;
  subject?: string;
  content: string;
  scheduledFor: Date;
  status: 'pending' | 'sent' | 'delivered' | 'opened' | 'clicked' | 'failed';
  metadata: {
    variables: Record<string, any>;
    attachments?: string[];
    priority: 'low' | 'medium' | 'high' | 'urgent';
    channel: string;
};
  createdAt: Date;
  sentAt?: Date;
  deliveredAt?: Date;
  openedAt?: Date;
  clickedAt?: Date
}

export interface CommunicationTemplate {
  id: string;
  name: string;
  description: string;
  type: 'welcome' | 'project_update' | 'proof_ready' | 'deadline_reminder' | 'delivery' | 'follow_up' | 'payment_reminder';
  trigger: {
    event: 'project_created' | 'project_updated' | 'proof_ready' | 'deadline_approaching' | 'project_delivered' | 'payment_due' | 'custom';
    conditions: Record<string, any>;
    delay?: number; // hours
};
  channels: ('email' | 'sms' | 'push' | 'in-app')[];
  content: {
    subject: string;
    body: string;
    variables: string[];
};
  isActive: boolean;
  createdAt: Date;
  updatedAt: Date
}

export interface DeadlineAlert {
  id: string;
  projectId: string;
  clientId: string;
  deadlineType: 'project_delivery' | 'client_approval' | 'payment_due' | 'meeting' | 'custom';
  deadlineDate: Date;
  alertSettings: {
    daysBefore: number[];
    escalationLevels: Array<{
      daysBefore: number;
      action: 'email' | 'sms' | 'call' | 'escalate';
      template: string;
}>;
};
  status: 'active' | 'completed' | 'overdue' | 'cancelled';
  lastAlertSent?: Date;
  createdAt: Date
}

export interface ClientSegment {
  id: string;
  name: string;
  description: string;
  criteria: {
    projectTypes?: string[];
    projectCount?: { min: number; max?: number };
    totalSpent?: { min: number; max?: number };
    lastActivity?: { days: number };
    projectStatus?: string[];
    customFilters?: Record<string, any>;
};
  clients: string[];
  createdAt: Date;
  updatedAt: Date
}

export interface FollowUpSequence {
  id: string;
  name: string;
  description: string;
  trigger: {
    event: 'project_completed' | 'no_activity' | 'payment_received' | 'custom';
    conditions: Record<string, any>;
};
  steps: Array<{
    order: number;
    delay: number; // hours
    template: string;
    channel: 'email' | 'sms' | 'push' | 'in-app';
    conditions?: Record<string, any>;
}>;
  isActive: boolean;
  createdAt: Date;
  updatedAt: Date
}

export interface ClientSuccessMetrics {
  clientId: string;
  projectCount: number;
  totalSpent: number;
  averageProjectValue: number;
  lastProjectDate: Date;
  satisfactionScore: number;
  retentionRate: number;
  lifetimeValue: number;
  churnRisk: 'low' | 'medium' | 'high';
  nextAction: string;
  lastUpdated: Date
}

