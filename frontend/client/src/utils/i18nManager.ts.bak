/**
 * i18n Manager
 * Manages internationalization and localization
 */

export interface I18nConfig {
  defaultLanguage: string;
  supportedLanguages: string[];
  fallbackLanguage: string;
  enableAutoDetection: boolean;
  enableLocalStorage: boolean;
  enableRTL: boolean;
  enablePluralization: boolean;
  enableInterpolation: boolean;
  enableNamespace: boolean;
  enableLazyLoading: boolean;
  enableHotReload: boolean;
  enableDebug: boolean;
  loadPath: string;
  namespace: string;
  interpolationPrefix: string;
  interpolationSuffix: string;
  pluralSeparator: string;
  contextSeparator: string;
}

export interface TranslationData {
  [key: string]: any;
}

export interface I18nState {
  currentLanguage: string;
  isLoading: boolean;
  isReady: boolean;
  hasError: boolean;
  error: string | null;
  loadedLanguages: string[];
  loadedNamespaces: string[];
  translations: Map<string, TranslationData>;
  fallbackTranslations: Map<string, TranslationData>;
}

export interface TranslationOptions {
  count?: number;
  context?: string;
  interpolation?: Record<string, any>;
  namespace?: string;
  fallback?: string;
  defaultValue?: string;
}

export interface I18nResult {
  success: boolean;
  translation: string;
  language: string;
  namespace: string;
  key: string;
  options: TranslationOptions;
  error?: string;
}

class I18nManager {
  private config: I18nConfig;
  private state: I18nState;
  private eventListeners: Map<string, Function[]> = new Map();
  private loadingPromises: Map<string, Promise<void>> = new Map();

  constructor(config: Partial<I18nConfig> = {}) {
    this.config = {
      defaultLanguage: 'en',
      supportedLanguages: ['en', 'es', 'fr', 'de', 'it', 'pt', 'ru', 'zh', 'ja', 'ko'],
      fallbackLanguage: 'en',
      enableAutoDetection: true,
      enableLocalStorage: true,
      enableRTL: true,
      enablePluralization: true,
      enableInterpolation: true,
      enableNamespace: true,
      enableLazyLoading: true,
      enableHotReload: false,
      enableDebug: false,
      loadPath: '/locales/{{lng}}/{{ns}}.json',
      namespace: 'translation',
      interpolationPrefix: '{{',
      interpolationSuffix: '}}',
      pluralSeparator: '_',
      contextSeparator: '_',
      ...config
  };

    this.state = {
      currentLanguage: this.config.defaultLanguage,
      isLoading: false,
      isReady: false,
      hasError: false,
      error: null,
      loadedLanguages: [],
      loadedNamespaces: [],
      translations: new Map(),
      fallbackTranslations: new Map()
  };

    this.initializeI18n();
}

  /**
   * Initialize i18n
   */
  private async initializeI18n(): Promise<void> {
    try {
      // Auto-detect language
      if (this.config.enableAutoDetection) {
        this.detectLanguage();
    }

      // Load from localStorage
      if (this.config.enableLocalStorage) {
        this.loadFromStorage();
    }

      // Load default language
      await this.loadLanguage(this.state.currentLanguage);

      this.state.isReady = true;
      this.emit('ready');
  } catch (error) {
      this.state.hasError = true;
      this.state.error = error instanceof Error ? error.message : 'Unknown error';
      this.emit('error', { error: this.state.error,});
  }
}

  /**
   * Detect language
   */
  private detectLanguage(): void {
    // Try to get from localStorage first
    if (this.config.enableLocalStorage) {
      const stored = localStorage.getItem('i18n_language');
      if (stored && this.config.supportedLanguages.includes(stored)) {
        this.state.currentLanguage = stored;
        return;
    }
  }

    // Try to detect from browser
    const browserLang = navigator.language.split('-')[0];
    if (this.config.supportedLanguages.includes(browserLang)) {
      this.state.currentLanguage = browserLang;
      return;
  }

    // Try to detect from browser with region
    const browserLangWithRegion = navigator.language;
    if (this.config.supportedLanguages.includes(browserLangWithRegion)) {
      this.state.currentLanguage = browserLangWithRegion;
      return;
  }

    // Fall back to default
    this.state.currentLanguage = this.config.defaultLanguage;
}

  /**
   * Load from storage
   */
  private loadFromStorage(): void {
    try {
      const stored = localStorage.getItem('i18n_data');
      if (stored) {
        const data = JSON.parse(stored);
        this.state.translations = new Map(data.translations);
        this.state.loadedLanguages = data.loadedLanguages || [];
        this.state.loadedNamespaces = data.loadedNamespaces || [];
    }
  } catch (error) {
      console.warn('Failed to load i18n data from storage:', error);
  }
}

  /**
   * Save to storage
   */
  private saveToStorage(): void {
    if (!this.config.enableLocalStorage) return;

    try {
      const data = {
        translations: Array.from(this.state.translations.entries()),
        loadedLanguages: this.state.loadedLanguages,
        loadedNamespaces: this.state.loadedNamespaces,
        currentLanguage: this.state.currentLanguage
};
      localStorage.setItem('i18n_data', JSON.stringify(data));
      localStorage.setItem('i18n_language', this.state.currentLanguage);
  } catch (error) {
      console.warn('Failed to save i18n data to storage:', error);
  }
}

  /**
   * Load language
   */
  async loadLanguage(language: string, namespace: string = this.config.namespace): Promise<void> {
    if (this.state.loadedLanguages.includes(language) && 
        this.state.loadedNamespaces.includes(namespace)) {
      return;
}

    if (this.loadingPromises.has(`${language}-${namespace}`)) {
      return this.loadingPromises.get(`${language}-${namespace}`);
  }

    const loadPromise = this.loadLanguageData(language, namespace);
    this.loadingPromises.set(`${language}-${namespace}`, loadPromise);

    try {
      await loadPromise;
      this.state.loadedLanguages.push(language);
      this.state.loadedNamespaces.push(namespace);
      this.saveToStorage();
      this.emit('language_loaded', { language, namespace });
  } catch (error) {
      this.state.hasError = true;
      this.state.error = error instanceof Error ? error.message : 'Unknown error';
      this.emit('error', { error: this.state.error,});
  } finally {
      this.loadingPromises.delete(`${language}-${namespace}`);
  }
}

  /**
   * Load language data
   */
  private async loadLanguageData(language: string, namespace: string): Promise<void> {
    const url = this.config.loadPath
      .replace('{{lng}}', language)
      .replace('{{ns}}', namespace);

    try {
      const response = await fetch(url);
      if (!response.ok) {
        throw new Error(`Failed to load translations: ${response.status}`);
    }

      const data = await response.json();
      const key = `${language}-${namespace}`;
      this.state.translations.set(key, data);

      // Load fallback if needed
      if (language !== this.config.fallbackLanguage) {
        await this.loadFallbackData(namespace);
    }
  } catch (error) {
      // Try to load fallback
      if (language !== this.config.fallbackLanguage) {
        await this.loadFallbackData(namespace);
    } else {
        throw error;
    }
  }
}

  /**
   * Load fallback data
   */
  private async loadFallbackData(namespace: string): Promise<void> {
    const fallbackKey = `${this.config.fallbackLanguage}-${namespace}`;
    
    if (this.state.fallbackTranslations.has(fallbackKey)) {
      return;
  }

    try {
      const url = this.config.loadPath
        .replace('{{lng}}', this.config.fallbackLanguage)
        .replace('{{ns}}', namespace);

      const response = await fetch(url);
      if (response.ok) {
        const data = await response.json();
        this.state.fallbackTranslations.set(fallbackKey, data);
    }
  } catch (error) {
      console.warn('Failed to load fallback translations:', error);
  }
}

  /**
   * Translate key
   */
  translate(key: string, options: TranslationOptions = {}): string {
    const {
      count,
      context,
      interpolation = {},
      namespace = this.config.namespace,
      fallback,
      defaultValue
  } = options;

    try {
      // Get translation
      let translation = this.getTranslation(key, namespace, context, count);
      
      // Use fallback if not found
      if (!translation && fallback) {
        translation = fallback;
    }
      
      // Use default value if still not found
      if (!translation && defaultValue) {
        translation = defaultValue;
    }
      
      // Use key as fallback
      if (!translation) {
        translation = key;
    }

      // Apply interpolation
      if (this.config.enableInterpolation && Object.keys(interpolation).length > 0) {
        translation = this.interpolate(translation, interpolation);
    }

      return translation;
  } catch (error) {
      if (this.config.enableDebug) {
        console.error('Translation error:', error);
    }
      return fallback || defaultValue || key;
  }
}

  /**
   * Get translation
   */
  private getTranslation(key: string, namespace: string, context?: string, count?: number): string | null {
    const currentKey = `${this.state.currentLanguage}-${namespace}`;
    const fallbackKey = `${this.config.fallbackLanguage}-${namespace}`;
    
    // Try current language
    let translation = this.getTranslationFromData(
      this.state.translations.get(currentKey),
      key,
      context,
      count
    );
    
    // Try fallback language
    if (!translation) {
      translation = this.getTranslationFromData(
        this.state.fallbackTranslations.get(fallbackKey),
        key,
        context,
        count
      );
  }
    
    return translation;
}

  /**
   * Get translation from data
   */
  private getTranslationFromData(data: TranslationData | undefined, key: string, context?: string, count?: number): string | null {
    if (!data) return null;

    // Build key with context and pluralization
    let fullKey = key;
    
    if (context) {
      fullKey = `${key}${this.config.contextSeparator}${context}`;
  }
    
    if (count !== undefined && this.config.enablePluralization) {
      const pluralKey = this.getPluralKey(count);
      fullKey = `${fullKey}${this.config.pluralSeparator}${pluralKey}`;
  }

    // Try full key first
    let translation = this.getNestedValue(data, fullKey);
    
    // Try without pluralization
    if (!translation && count !== undefined) {
      const baseKey = context ? `${key}${this.config.contextSeparator}${context}` : key;
      translation = this.getNestedValue(data, baseKey);
  }
    
    // Try without context
    if (!translation && context) {
      const baseKey = count !== undefined ? `${key}${this.config.pluralSeparator}${this.getPluralKey(count)}` : key;
      translation = this.getNestedValue(data, baseKey);
  }
    
    // Try base key
    if (!translation) {
      translation = this.getNestedValue(data, key);
  }

    return translation;
}

  /**
   * Get nested value
   */
  private getNestedValue(obj: any, path: string): string | null {
    return path.split('.').reduce((current, key) => {
      return current && current[key] !== undefined ? current[key] : null;
  }, obj);
}

  /**
   * Get plural key
   */
  private getPluralKey(count: number): string {
    if (count === 0) return 'zero';
    if (count === 1) return 'one';
    if (count === 2) return 'two';
    if (count < 5) return 'few';
    if (count < 10) return 'many';
    return 'other';
}

  /**
   * Interpolate translation
   */
  private interpolate(translation: string, interpolation: Record<string, any>): string {
    let result = translation;
    
    for (const [key, value] of Object.entries(interpolation)) {
      const placeholder = `${this.config.interpolationPrefix}${key}${this.config.interpolationSuffix}`;
      result = result.replace(new RegExp(placeholder, 'g'), String(value));
  }
    
    return result;
}

  /**
   * Change language
   */
  async changeLanguage(language: string): Promise<void> {
    if (language === this.state.currentLanguage) return;
    
    if (!this.config.supportedLanguages.includes(language)) {
      throw new Error(`Unsupported language: ${language}`);
  }

    this.state.currentLanguage = language;
    this.state.isLoading = true;
    
    try {
      await this.loadLanguage(language);
      this.saveToStorage();
      this.emit('language_changed', { language });
  } catch (error) {
      this.state.hasError = true;
      this.state.error = error instanceof Error ? error.message : 'Unknown error';
      this.emit('error', { error: this.state.error,});
  } finally {
      this.state.isLoading = false;
  }
}

  /**
   * Get current language
   */
  getCurrentLanguage(): string {
    return this.state.currentLanguage;
}

  /**
   * Get supported languages
   */
  getSupportedLanguages(): string[] {
    return [...this.config.supportedLanguages];
}

  /**
   * Check if language is loaded
   */
  isLanguageLoaded(language: string, namespace: string = this.config.namespace): boolean {
    return this.state.loadedLanguages.includes(language) && 
           this.state.loadedNamespaces.includes(namespace);
}

  /**
   * Get loaded languages
   */
  getLoadedLanguages(): string[] {
    return [...this.state.loadedLanguages];
}

  /**
   * Get loaded namespaces
   */
  getLoadedNamespaces(): string[] {
    return [...this.state.loadedNamespaces];
}

  /**
   * Check if RTL
   */
  isRTL(language?: string): boolean {
    if (!this.config.enableRTL) return false;
    
    const lang = language || this.state.currentLanguage;
    const rtlLanguages = ['ar', 'he', 'fa', 'ur', 'ku', 'ps', 'sd', 'ug'];
    return rtlLanguages.includes(lang.split('-')[0]);
}

  /**
   * Get state
   */
  getState(): I18nState {
    return { ...this.state };
}

  /**
   * Get configuration
   */
  getConfig(): I18nConfig {
    return { ...this.config };
}

  /**
   * Update configuration
   */
  updateConfig(newConfig: Partial<I18nConfig>): void {
    this.config = { ...this.config, ...newConfig };
}

  /**
   * Add event listener
   */
  on(event: string, callback: Function): void {
    if (!this.eventListeners.has(event)) {
      this.eventListeners.set(event, []);
  }
    this.eventListeners.get(event)!.push(callback);
}

  /**
   * Remove event listener
   */
  off(event: string, callback: Function): void {
    const listeners = this.eventListeners.get(event);
    if (listeners) {
      const index = listeners.indexOf(callback);
      if (index > -1) {
        listeners.splice(index, 1);
    }
  }
}

  /**
   * Emit event
   */
  private emit(event: string, data?: any): void {
    const listeners = this.eventListeners.get(event);
    if (listeners) {
      listeners.forEach(callback => {
        try {
          callback(data);
      } catch (error) {
          console.error('Error in i18n event listener:', error);
      }
    });
  }
}

  /**
   * Clear all data
   */
  clearAllData(): void {
    this.state.translations.clear();
    this.state.fallbackTranslations.clear();
    this.state.loadedLanguages = [];
    this.state.loadedNamespaces = [];
    this.state.isReady = false;
    this.state.hasError = false;
    this.state.error = null;
    
    if (this.config.enableLocalStorage) {
      localStorage.removeItem('i18n_data');
      localStorage.removeItem('i18n_language');
  }
    
    this.emit('data_cleared');
}

  /**
   * Cleanup
   */
  destroy(): void {
    this.state.translations.clear();
    this.state.fallbackTranslations.clear();
    this.eventListeners.clear();
    this.loadingPromises.clear();
}
}

// Create singleton instance
export const i18nManager = new I18nManager();

// Utility functions
export const t = (key: string, options?: TranslationOptions) => {
  return i18nManager.translate(key, options);
};

export const changeLanguage = (language: string) => {
  return i18nManager.changeLanguage(language)};

export const getCurrentLanguage = () => {
  return i18nManager.getCurrentLanguage();
};

export const isRTL = (language?: string) => {
  return i18nManager.isRTL(language);
};

export default i18nManager;





