        action: 'undo',
        handler: () => document.execCommand(''),
        enabled: true,
        global: true,
        preventDefault: true,
        stopPropagation: false,
        priority: 1
  },
      {
        id: 'redo',
        name: 'Redo',
        description: 'Redo last undone action',
        category: 'editing',
        key: '',
        modifiers: [''],
        context: ['*, ', ],
        action: 'redo',
        handler: () => document.execCommand(''),
        enabled: true,
        global: true,
        preventDefault: true,
        stopPropagation: false,
        priority: 1
  },
      {
        id: 'select-all',
        name: 'Select All',
        description: 'Select all content',
        category: 'editing',
        key: '',
        modifiers: [''],
        context: ['*, ', ],
        action: 'selectAll',
        handler: () => document.execCommand(''),
        enabled: true,
        global: true,
        preventDefault: true,
        stopPropagation: false,
        priority: 1
  },
      {
        id: 'save',
        name: 'Save',
        description: 'Save current document',
        category: 'file',
