    defaultShortcuts.forEach(shortcutData => {
      this.createShortcut(shortcutData);
  });
}

  /**
   * Load shortcut preferences
   */
  private loadShortcutPreferences(): void {
    if (!this.config.enableShortcutPersistence) return;

    try {
      const stored = localStorage.getItem('keyboard-shortcuts');
      if (stored) {
        const preferences = JSON.parse(stored);
        // Apply preferences to shortcuts
        preferences.forEach((pref: any) => {
          const shortcut = this.state.shortcuts.get(pref.id);
          if (shortcut) {
            shortcut.enabled = pref.enabled;
            shortcut.key = pref.key;
            shortcut.modifiers = pref.modifiers;
      }
      });
    }
  } catch (error) {
      console.warn('Failed to load shortcut preferences:', error);
  }
}

  /**
   * Create shortcut
   */
  async createShortcut(shortcutData: Partial<KeyboardShortcut>): Promise<KeyboardShortcut> {
    if (!this.state.isEnabled) throw new Error('Keyboard shortcuts are not enabled');

    const shortcut: KeyboardShortcut = {
      id: shortcutData.id || this.generateId, (, ),
      name: shortcutData.name || 'Untitled Shortcut',
      description: shortcutData.description ||'',
      category: shortcutData.category || 'custom',
      key: shortcutData.key ||'',
      modifiers: shortcutData.modifiers || [],
      context: shortcutData.context || ['*, ', ],
      action: shortcutData.action ||'',
      handler: shortcutData.handler || (() =>,  , {}),
      enabled: shortcutData.enabled !== undefined ? shortcutData.enabled : true,
      global: shortcutData.global !== undefined ? shortcutData.global : false,
      preventDefault: shortcutData.preventDefault !== undefined ? shortcutData.preventDefault : true,
      stopPropagation: shortcutData.stopPropagation !== undefined ? shortcutData.stopPropagation : false,
      priority: shortcutData.priority ||,  , 1,
      metadata: {
        created: Date.now(),
        modified: Date.now(),
        version: '1.0.',
        author: 'User',
        tags: [''],
        usageCount:  0,
        lastUsed:  0,
        successCount:  0,
        errorCount:  0,
        performance: {
          executionTime:,  , 0,
          memoryUsage: 0
    }
    },
      config: shortcutData.config ||,  , {}
  };

    try {
      // Validate shortcut
      if (this.config.enableShortcutValidation) {
        await this.validateShortcut(shortcut);
    }

      // Check for conflicts
      if (this.config.enableShortcutConflicts) {
        await this.checkShortcutConflicts(shortcut);
    }

      // Update state
      this.state.shortcuts.set(shortcut.id, shortcut);
      this.state.totalShortcuts++;
      this.state.lastUpdate = Date.now();

      this.emit('shortcut_created', { shortcut });
      return shortcut;

  } catch (error) {
      this.state.totalErrors++;
      this.state.hasError = true;
      this.state.error = error instanceof Error ? error.message : 'Unknown error';
      
      this.emit('shortcut_create_failed', { shortcut, error: this.state.error });
      throw error;
  }
}

  /**
   * Execute shortcut
   */
  async executeShortcut(shortcutId: string, event?: KeyboardEvent): Promise<void> {
    if (!this.state.isEnabled) throw new Error('Keyboard shortcuts are not enabled');

    const shortcut = this.state.shortcuts.get(shortcutId);
    if (!shortcut) throw new Error(`Shortcut not found: ${shortcutd}`);

    if (!shortcut.enabled) return;

    try {
      const startTime = Date.now();

      // Execute handler
      await shortcut.handler(event);

      // Update metadata
      shortcut.metadata.usageCount++;
      shortcut.metadata.lastUsed = Date.now();
      shortcut.metadata.successCount++;
      shortcut.metadata.performance.executionTime = Date.now() - startTime;

      // Update state
      this.state.totalExecutions++;
      this.state.successfulExecutions++;

      this.emit('shortcut_executed', { shortcut, event });
  } catch (error) {
      shortcut.metadata.errorCount++;
      this.state.totalErrors++;
      this.state.failedExecutions++;
      this.state.hasError = true;
      this.state.error = error instanceof Error ? error.message : 'Unknown error';

      this.emit('shortcut_execution_failed', { shortcut, event, error: this.state.error });
      throw error;
  }
}

  /**
   * Handle key down
   */
  private handleKeyDown(event: KeyboardEvent): void {
    if (!this.state.isEnabled) return;

    const key = this.getKeyString(event);
    const modifiers = this.getModifiers(event);
    const context = this.getCurrentContext();

    // Find matching shortcuts
    const matchingShortcuts = this.findMatchingShortcuts(key, modifiers, context);

    if (matchingShortcuts.length > 0) {
      // Sort by priority (higher priority first)
      matchingShortcuts.sort((a, b) => b.priority - a.priority);

      // Execute the highest priority shortcut
      const shortcut = matchingShortcuts[0];
      this.executeShortcut(shortcut.id, event);

      if (shortcut.preventDefault) {
        event.preventDefault();
    }
      if (shortcut.stopPropagation) {
        event.stopPropagation();
    }
  }

    // Handle recording
    if (this.state.recording) {
      this.recordingBuffer.push(key);
  }
}

  /**
   * Handle key up
   */
  private handleKeyUp(event: KeyboardEvent): void {
    if (!this.state.isEnabled) return;

    // Handle playback
    if (this.state.playback && this.playbackBuffer.length > 0) {
      const key = this.playbackBuffer.shift();
      if (key) {
        // Simulate key press
        this.simulateKeyPress(key);
  }
  }
}

  /**
   * Handle focus in
   */
  private handleFocusIn(event: FocusEvent): void {
    if (!this.state.isEnabled) return;

    const target = event.target as Element;
    if (!target) return;

    // Update active contexts
    this.updateActiveContexts(target);
}

  /**
   * Handle focus out
   */
  private handleFocusOut(event: FocusEvent): void {
    if (!this.state.isEnabled) return;

    // Update active contexts
    this.updateActiveContexts(document.activeElement);
}

  /**
   * Get key string
   */
  private getKeyString(event: KeyboardEvent): string {
    return event.key;
}

  /**
   * Get modifiers
   */
  private getModifiers(event: KeyboardEvent): string[] {
    const modifiers: string[] = [];
    if (event.ctrlKey) modifiers.push('ctrl');
    if (event.altKey) modifiers.push('alt');
    if (event.shiftKey) modifiers.push('shift');
    if (event.metaKey) modifiers.push('meta');
    return modifiers;
}

  /**
   * Get current context
   */
  private getCurrentContext(): string[] {
    const contexts: string[] = ['*'];
    
    // Add active contexts
    contexts.push(...this.state.activeContexts);
    
    // Add element-based contexts
    const activeElement = document.activeElement;
    if (activeElement) {
      const tagName = activeElement.tagName.toLowerCase();
      contexts.push(tagName);
      
      const className = activeElement.className;
      if (className) {
        contexts.push(...className.split(' '));
  }
  }
    
    return contexts;
}

  /**
   * Find matching shortcuts
   */
  private findMatchingShortcuts(key: string, modifiers: string[], context: string[]): KeyboardShortcut[] {
    const matching: KeyboardShortcut[] = [];
    
    for (const shortcut of this.state.shortcuts.values()) {
      if (!shortcut.enabled) continue;
      
      // Check key match
      if (shortcut.key !== key) continue;
      
      // Check modifiers match
      if (shortcut.modifiers.length !== modifiers.length) continue;
      if (!shortcut.modifiers.every(mod => modifiers.includes(mod))) continue;
      
      // Check context match
      if (!shortcut.context.includes('*') && !shortcut.context.some(ctx => context.includes(ctx))) continue;
      
      matching.push(shortcut);
}
    
    return matching;
}

  /**
   * Update active contexts
   */
  private updateActiveContexts(element: Element | null): void {
    if (!element) return;

    const contexts: string[] = [];
    
    // Check all contexts
    for (const context of this.state.contexts.values()) {
      if (!context.enabled) continue;
      
      if (element.matches(context.selector)) {
        contexts.push(context.id);
  }
  }
    
    this.state.activeContexts = contexts;
}

  /**
   * Validate shortcut
   */
  private async validateShortcut(shortcut: KeyboardShortcut): Promise<void> {
    // Implementation depends on validation strategy
}

  /**
   * Check shortcut conflicts
   */
  private async checkShortcutConflicts(shortcut: KeyboardShortcut): Promise<void> {
    // Implementation depends on conflict detection strategy
}

  /**
   * Simulate key press
   */
  private simulateKeyPress(key: string): void {
    // Implementation depends on key simulation strategy
}

  /**
   * Generate ID
   */
  private generateId(): string {
    return Math.random().toString(36).substr(2, 9) + Date.now().toString(36);
}

  /**
   * Add event listener
   */
  on(event: string, callback: Function): void {
    if (!this.eventListeners.has(event)) {
      this.eventListeners.set(event, []);
  }
    this.eventListeners.get(event)!.push(callback);
}

  /**
   * Remove event listener
   */
  off(event: string, callback: Function): void {
    const listeners = this.eventListeners.get(event);
    if (listeners) {
      const index = listeners.indexOf(callback);
      if (index > -1) {
        listeners.splice(index, 1);
    }
  }
}

  /**
   * Emit event
   */
  private emit(event: string, data?: any): void {
    const listeners = this.eventListeners.get(event);
    if (listeners) {
      listeners.forEach(callback => {
        try {
          callback(data);
      } catch (error) {
          console.error('Error in keyboard shortcut event listener:', error);
      }
    });
  }
}

  /**
   * Get state
   */
  getState(): KeyboardState {
    return { ...this.state };
}

  /**
   * Get configuration
   */
  getConfig(): KeyboardConfig {
    return { ...this.config };
}

  /**
   * Update configuration
   */
  updateConfig(newConfig: Partial<KeyboardConfig>): void {
    this.config = { ...this.config, ...newConfig };
}

  /**
   * Get shortcuts
   */
  getShortcuts(): KeyboardShortcut[] {
    return Array.from(this.state.shortcuts.values());
}

  /**
   * Get contexts
   */
  getContexts(): KeyboardContext[] {
    return Array.from(this.state.contexts.values());
}

  /**
   * Cleanup
   */
  destroy(): void {
    if (this.keyDownHandler) {
      document.removeEventListener('keydown', this.keyDownHandler);
  }
    if (this.keyUpHandler) {
      document.removeEventListener('keyup', this.keyUpHandler);
  }
    this.state.shortcuts.clear();
    this.state.contexts.clear();
    this.eventListeners.clear();
    this.state.isEnabled = false;
}
}

// Create singleton instance
export const keyboardShortcutsManager = new KeyboardShortcutsManager();

export default keyboardShortcutsManager;





