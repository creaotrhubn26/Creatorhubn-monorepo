/**
 * Universal File Format Support System
 * Connected to camera database for comprehensive format support
 * Used across all file upload components in CreatorHub Norge
 */

import { apiRequest } from '@/lib/queryClient';

export interface FileFormatInfo {
  extension: string;
  manufacturer: string;
  description: string;
  models: string[];
  isRAW: boolean;
  supported: boolean;
  mimeType?: string;
  maxFileSize?: number
}

export interface FileValidationResult {
  supported: boolean;
  format?: FileFormatInfo;
  message: string;
  suggestions?: string[]
}

class UniversalFileFormatSupport {
  private formatCache: Map<string, FileFormatInfo[]> = new Map();
  private lastCacheUpdate = 0;
