        permissions: [
          'canViewProjects', 'canCreateProjects', 'canEditProjects', 'canDeleteProjects',
          'canShareProjects', 'canArchiveProjects', 'canViewFiles', 'canUploadFiles',
          'canDownloadFiles', 'canDeleteFiles', 'canShareFiles', 'canOrganizeFiles',
          'canInviteMembers', 'canRemoveMembers', 'canEditMemberRoles', 'canViewMemberActivity',
