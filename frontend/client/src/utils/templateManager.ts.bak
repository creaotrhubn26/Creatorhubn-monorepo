// Template Manager for UniversalDashboard and UniversalShowcase
// Provides templates and presets based on existing platform components

export interface Template {
  id: string;
  name: string;
  description: string;
  category: 'dashboard' | 'showcase' | 'project' | 'workflow' | 'ui';
  profession: 'photographer' | 'videographer' | 'music_producer' | 'vendor' | 'admin' | 'universal';
  version: string;
  tags: string[];
  config: Record<string, any>;
  metadata: {
    createdBy: string;
    createdAt: Date;
    downloads: number;
    rating: number;
    featured: boolean;
};
}

export interface Preset {
  id: string;
  name: string;
  description: string;
  category: 'export' | 'filter' | 'view' | 'workflow' | 'settings';
  profession: string;
  config: Record<string, any>;
  metadata: {
    createdBy: string;
    createdAt: Date;
    usage: number;
};
}

export class TemplateManager {
  private templates: Template[] = [];
  private presets: Preset[] = [];

  constructor() {
    this.initializeDefaultTemplates();
    this.initializeDefaultPresets();
}

  private initializeDefaultTemplates(): void {
    // UniversalDashboard Templates
    this.templates.push({
      id: 'dashboard-photographer-pro',
      name: 'Photographer Pro Dashboard',
      description: 'Complete dashboard setup for professional photographers',
      category: 'dashboard',
      profession: 'photographer',
      version: '1.0.0',
      tags: ['photography', 'professional', 'client-management'],
      config: {
        tabState: { main: 0, projects: 0, clients: 0, equipment: 0 },
        uiSettings: { proEditorMode: true, compactMode: false, darkMode: false },
        layout: { sidebarWidth: 280, headerHeight: 64 },
        widgets: [
          { id: 'quick-stats', type: 'stats', position: { x: 0, y: 0, w: 4, h: 2 } },
          { id: 'recent-projects', type: 'project-list', position: { x: 4, y: 0, w: 4, h: 3 } }
        ]
    },
      metadata: {
        createdBy: 'system',
        createdAt: new Date(),
        downloads:  0,
        rating:  0,
        featured: true
    }
  });

    // UniversalShowcase Templates
    this.templates.push({
      id: 'showcase-wedding-photography',
      name: 'Wedding Photography Showcase',
      description: 'Professional wedding photography showcase with client proofing',
      category: 'showcase',
      profession: 'photographer',
      version: '1.0.0',
      tags: ['wedding', 'photography', 'client-proofing'],
      config: {
        layout: 'masonry',
        filters: { categories: ['ceremony', 'reception', 'portraits'] },
        display: { showThumbnails: true, showMetadata: true, itemSize: 'medium' },
        features: { clientMode: true, proofing: true, annotations: true }
    },
      metadata: {
        createdBy: 'system',
        createdAt: new Date(),
        downloads:  0,
        rating:  0,
        featured: true
    }
  });

    // Project Templates
    this.templates.push({
      id: 'project-wedding-photography',
      name: 'Wedding Photography Project',
      description: 'Complete wedding photography project structure',
      category: 'project',
      profession: 'photographer',
      version: '1.0.0',
      tags: ['wedding', 'photography', 'project-management'],
      config: {
        type: 'wedding-photography',
        structure: {
          folders: [
            { name: 'Raw Files', path: '/raw, ',},
            { name: 'Edited', path: '/edited, ',},
            { name: 'Client Proofs', path: '/proofs, ',},
            { name: 'Final Delivery', path: '/delivery, ',}
          ]
      },
        workflows: [
          { name: 'Pre-Wedding', steps: ['Client Meeting', 'Contract Signing'] },
          { name: 'Wedding Day', steps: ['Setup', 'Ceremony', 'Portraits'] },
          { name: 'Post-Processing', steps: ['Import', 'Edit', 'Client Proofing'] }
        ]
    },
      metadata: {
        createdBy: 'system',
        createdAt: new Date(),
        downloads:  0,
        rating:  0,
        featured: true
    }
  });
}

  private initializeDefaultPresets(): void {
    // Export Presets
    this.presets.push({
      id: 'export-web-gallery',
      name: 'Web Gallery Export',
      description: 'Optimized settings for web gallery',
      category: 'export',
      profession: 'photographer',
      config: {
        formats: ['jpeg', 'webp'],
        sizes: [
          { name: 'thumbnail', width: 300, height: 300, quality: 80 },
          { name: 'medium', width: 800, height: 600, quality: 85 }
        ],
        watermark: { enabled: true, position: 'bottom-right' }
    },
      metadata: {
        createdBy: 'system',
        createdAt: new Date(),
        usage: 0
    }
  });

    // Filter Presets
    this.presets.push({
      id: 'filter-recent-projects',
      name: 'Recent Projects',
      description: 'Show only projects from the last 30 days',
      category: 'filter',
      profession: 'universal',
      config: {
        dateRange: { start: new Date(Date.now() - 30 * 24 * 60 * 60 * 1000), end: new Date() },
        status: ['active', 'in-progress'],
        sortBy: 'date'
    },
      metadata: {
        createdBy: 'system',
        createdAt: new Date(),
        usage: 0
    }
  });

    // View Presets
    this.presets.push({
      id: 'view-client-proofing',
      name: 'Client Proofing View',
      description: 'Optimized view for client proofing',
      category: 'view',
      profession: 'photographer',
      config: {
        layout: 'masonry',
        showMetadata: false,
        selectionMode: true,
        itemSize: 'large'
    },
      metadata: {
        createdBy: 'system',
        createdAt: new Date(),
        usage: 0
    }
  });
}

  getTemplates(filter?: { category?: string; profession?: string; featured?: boolean }): Template[] {
    let filtered = this.templates;

    if (filter?.category) {
      filtered = filtered.filter(t => t.category === filter.category);
  }

    if (filter?.profession) {
      filtered = filtered.filter(t => t.profession === filter.profession || t.profession === 'universal');
  }

    if (filter?.featured) {
      filtered = filtered.filter(t => t.metadata.featured);
  }

    return filtered.sort((a, b) => b.metadata.downloads - a.metadata.downloads);
}

  getTemplate(id: string): Template | undefined {
    return this.templates.find(t => t.id === id);
}

  getPresets(filter?: { category?: string; profession?: string }): Preset[] {
    let filtered = this.presets;

    if (filter?.category) {
      filtered = filtered.filter(p => p.category === filter.category);
  }

    if (filter?.profession) {
      filtered = filtered.filter(p => p.profession === filter.profession || p.profession === 'universal');
  }

    return filtered.sort((a, b) => b.metadata.usage - a.metadata.usage);
}

  getPreset(id: string): Preset | undefined {
    return this.presets.find(p => p.id === id);
}

  applyTemplate(templateId: string, targetId: string): boolean {
    const template = this.getTemplate(templateId);
    if (!template) return false;

    console.log(`Applying template ${templateId} to ${targetId}`);
    return true;
}

  applyPreset(presetId: string, targetId: string): boolean {
    const preset = this.getPreset(presetId);
    if (!preset) return false;

    console.log(`Applying preset ${presetId} to ${targetId}`);
    return true;
}
}

export const templateManager = new TemplateManager();