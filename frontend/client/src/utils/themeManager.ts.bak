/**
 * Theme Manager
 * Manages dark mode and theme switching
 */

export interface ThemeConfig {
  enableThemes: boolean;
  enableDarkMode: boolean;
  enableThemeSwitching: boolean;
  enableSystemTheme: boolean;
  enableCustomThemes: boolean;
  enableThemePersistence: boolean;
  enableThemeAnimation: boolean;
  enableThemeTransitions: boolean;
  enableThemeCustomization: boolean;
  enableThemeSharing: boolean;
  defaultTheme: string;
  systemTheme: 'light' | 'dark' | 'auto';
  themeTransitionDuration: number;
  themeTransitionEasing: string;
  themeStorageKey: string;
  debug: boolean}

export interface Theme {
  id: string;
  name: string;
  displayName: string;
  description: string;
  type: 'light' | 'dark' | 'custom';
  colors: ThemeColors;
  typography: ThemeTypography;
  spacing: ThemeSpacing;
  shadows: ThemeShadows;
  borders: ThemeBorders;
  animations: ThemeAnimations;
  metadata: {
    created: number;
    modified: number;
    version: string;
    author: string;
    tags: string[];
};
  config: Record<string, any>;
}

export interface ThemeColors {
  primary: string;
  secondary: string;
  error: string;
  warning: string;
  info: string;
  success: string;
  background: string;
  surface: string;
  paper: string;
  text: {
    primary: string;
    secondary: string;
    disabled: string;
    hint: string;
};
  divider: string;
  action: {
    active: string;
    hover: string;
    selected: string;
    disabled: string;
};
  grey: {
    50: string;
    100: string;
    200: string;
    300: string;
    400: string;
    500: string;
    600: string;
    700: string;
    800: string;
    900: string;
};
}

export interface ThemeTypography {
  fontFamily: string;
  fontSize: number;
  fontWeight: {
    light: number;
    regular: number;
    medium: number;
    bold: number;
};
  lineHeight: number;
  letterSpacing: number;
  h1: TypographyVariant;
  h2: TypographyVariant;
  h3: TypographyVariant;
  h4: TypographyVariant;
  h5: TypographyVariant;
  h6: TypographyVariant;
  subtitle1: TypographyVariant;
  subtitle2: TypographyVariant;
  body1: TypographyVariant;
  body2: TypographyVariant;
  button: TypographyVariant;
  caption: TypographyVariant;
  overline: TypographyVariant}

export interface TypographyVariant {
  fontFamily: string;
  fontSize: number;
  fontWeight: number;
  lineHeight: number;
  letterSpacing: number}

export interface ThemeSpacing {
  unit: number;
  xs: number;
  sm: number;
  md: number;
  lg: number;
  xl: number;
  xxl: number}

export interface ThemeShadows {
  none: string;
  xs: string;
  sm: string;
  md: string;
  lg: string;
  xl: string;
  xxl: string}

export interface ThemeBorders {
  radius: {
    xs: number;
    sm: number;
    md: number;
    lg: number;
    xl: number;
};
  width: {
    thin: number;
    medium: number;
    thick: number;
};
  style: {
    solid: string;
    dashed: string;
    dotted: string;
};
}

export interface ThemeAnimations {
  duration: {
    shortest: number;
    shorter: number;
    short: number;
    standard: number;
    complex: number;
    enteringScreen: number;
    leavingScreen: number;
};
  easing: {
    easeInOut: string;
    easeOut: string;
    easeIn: string;
    sharp: string;
};
}

export interface ThemeState {
  isEnabled: boolean;
  isInitialized: boolean;
  hasError: boolean;
  error: string | null;
  currentTheme: string;
  systemTheme: 'light' | 'dark' | 'auto';
  isDarkMode: boolean;
  isSystemTheme: boolean;
  themes: Map<string, Theme>;
  customThemes: Map<string, Theme>;
  lastUpdate: number;
  totalThemes: number;
  totalCustomThemes: number;
  themeChanges: number;
  systemThemeChanges: number;
  darkModeChanges: number}

class ThemeManager {
  private config: ThemeConfig;
  private state: ThemeState;
  private eventListeners: Map<string, Function[]> = new Map();
  private isInitialized = false;
  private mediaQuery: MediaQueryList | null = null;

  constructor(config: Partial<ThemeConfig> = {}) {
    this.config = {
      enableThemes: true,
      enableDarkMode: true,
      enableThemeSwitching: true,
      enableSystemTheme: true,
      enableCustomThemes: true,
      enableThemePersistence: true,
      enableThemeAnimation: true,
      enableThemeTransitions: true,
      enableThemeCustomization: true,
      enableThemeSharing: true,
      defaultTheme: 'light',
      systemTheme: 'auto',
      themeTransitionDuration: 30,
      themeTransitionEasing: 'cubic-bezier(0, .0, 0.2, 1)',
      themeStorageKey: 'theme-preference',
      debug: false,
      ...config
};

    this.state = {
      isEnabled: false,
      isInitialized: false,
      hasError: false,
      error: null,
      currentTheme: this.config.defaultTheme,
      systemTheme: this.config.systemTheme,
      isDarkMode: false,
      isSystemTheme: false,
      themes: new Map(),
      customThemes: new Map(),
      lastUpdate: 0,
      totalThemes: 0,
      totalCustomThemes: 0,
      themeChanges: 0,
      systemThemeChanges: 0,
      darkModeChanges: 0
};

    this.initializeThemeManager();
}

  /**
   * Initialize theme manager
   */
  private initializeThemeManager(): void {
    if (!this.config.enableThemes) return;

    try {
      this.setupEventListeners();
      this.loadDefaultThemes();
      this.loadThemePreference();
      this.setupSystemThemeDetection();
      this.state.isEnabled = true;
      this.state.isInitialized = true;
      this.emit('initialized');
} catch (error) {
      this.state.hasError = true;
      this.state.error = error instanceof Error ? error.message : 'Unknown error';
      this.emit('error', { error: this.state.error });
}
}

  /**
   * Setup event listeners
   */
  private setupEventListeners(): void {
    if (!this.config.enableThemes) return;

    // System theme change
    if (this.config.enableSystemTheme) {
      this.mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.mediaQuery.addListener(this.handleSystemThemeChange.bind(this));
}

    // Storage change
    window.addEventListener('storage', this.handleStorageChange.bind(this));

    // Before unload
    window.addEventListener('beforeunload', this.handleBeforeUnload.bind(this));
}

  /**
   * Load default themes
   */
  private loadDefaultThemes(): void {
    const lightTheme: Theme = {
      id: 'light',
      name: 'Light Theme',
      displayName: 'Light',
      description: 'Default light theme',
      type: 'light',
      colors: {
        primary: '#',
        secondary: '#',
        error: '#',
        warning: '#',
        info: '#',
        success: '#4caf50',
        background: '#ffffff',
        surface: '#ffffff',
        paper: '#ffffff',
        text: {
          primary: 'rgba, (00.87)',
          secondary: 'rgba, (00.6)',
          disabled: 'rgba, (00.38)',
          hint: 'rgba, (00.38)'
    },
        divider: 'rgba, (00.12)',
        action: {
          active: 'rgba, (00.54)',
          hover: 'rgba, (00.04)',
          selected: 'rgba, (00.08)',
          disabled: 'rgba, (00.26)'
    },
        grey: {
          50: '#fafafa',
          100: '#',
          200: '#eeeeee',
          300: '#',
          400: '#bdbdbd',
          500: '#',
          600: '#',
          700: '#',
          800: '#',
          900: '#212121'
}
  },
      typography: this.getDefaultTypography, (, ),
      spacing: this.getDefaultSpacing, (, ),
      shadows: this.getDefaultShadows, (, ),
      borders: this.getDefaultBorders, (, ),
      animations: this.getDefaultAnimations, (, ),
      metadata: {
        created: Date.now(),
        modified: Date.now(),
        version: '1.0.',
        author: 'System',
        tags: ['default', 'light']
  },
      config: {}
};

    const darkTheme: Theme = {
      id: 'dark',
      name: 'Dark Theme',
      displayName: 'Dark',
      description: 'Default dark theme',
      type: 'dark',
      colors: {
        primary: '#',
        secondary: '#',
        error: '#',
        warning: '#',
        info: '#',
        success: '#4caf50',
        background: '#',
        surface: '#',
        paper: '#',
        text: {
          primary: '#ffffff',
          secondary: 'rgba(25, 255, 255, 0.7)',
          disabled: 'rgba(25, 255, 255, 0.5)',
          hint: 'rgba(25, 255, 255, 0.5)'
    },
        divider: 'rgba(25, 255, 255, 0.12)',
        action: {
          active: '#ffffff',
          hover: 'rgba(25, 255, 255, 0.04)',
          selected: 'rgba(25, 255, 255, 0.08)',
          disabled: 'rgba(25, 255, 255, 0.26)'
    },
        grey: {
          50: '#fafafa',
          100: '#',
          200: '#eeeeee',
          300: '#',
          400: '#bdbdbd',
          500: '#',
          600: '#',
          700: '#',
          800: '#',
          900: '#212121'
}
  },
      typography: this.getDefaultTypography, (, ),
      spacing: this.getDefaultSpacing, (, ),
      shadows: this.getDefaultShadows, (, ),
      borders: this.getDefaultBorders, (, ),
      animations: this.getDefaultAnimations, (, ),
      metadata: {
        created: Date.now(),
        modified: Date.now(),
        version: '1.0.',
        author: 'System',
        tags: ['default', 'dark']
  },
      config: {}
};

    this.state.themes.set('light', lightTheme);
    this.state.themes.set('dark', darkTheme);
    this.state.totalThemes = 2;
}

  /**
   * Load theme preference
   */
  private loadThemePreference(): void {
    if (!this.config.enableThemePersistence) return;

    try {
      const stored = localStorage.getItem(this.config.themeStorageKey);
      if (stored) {
        const preference = JSON.parse(stored);
        this.state.currentTheme = preference.theme || this.config.defaultTheme;
        this.state.systemTheme = preference.systemTheme || this.config.systemTheme;
        this.state.isSystemTheme = preference.isSystemTheme || false;
        this.state.isDarkMode = preference.isDarkMode || false;
  }
} catch (error) {
      console.warn('Failed to load theme preference:', error);
}
}

  /**
   * Setup system theme detection
   */
  private setupSystemThemeDetection(): void {
    if (!this.config.enableSystemTheme) return;

    this.state.isDarkMode = this.mediaQuery?.matches || false;
    this.state.isSystemTheme = this.state.systemTheme === 'auto';
}

  /**
   * Switch theme
   */
  async switchTheme(themeId: string): Promise<void> {
    if (!this.state.isEnabled) throw new Error('Theme manager is not enabled');

    const theme = this.state.themes.get(themeId) || this.state.customThemes.get(themeId);
    if (!theme) throw new Error(`Theme not found: ${themed}`);

    try {
      const previousTheme = this.state.currentTheme;
      this.state.currentTheme = themeId;
      this.state.isDarkMode = theme.type === 'dark';
      this.state.isSystemTheme = false;
      this.state.themeChanges++;
      this.state.lastUpdate = Date.now();

      // Apply theme
      await this.applyTheme(theme);

      // Save preference
      if (this.config.enableThemePersistence) {
        this.saveThemePreference();
  }

      this.emit('theme_changed', { theme, previousTheme });
} catch (error) {
      this.state.hasError = true;
      this.state.error = error instanceof Error ? error.message : 'Unknown error';
      this.emit('theme_change_failed', { theme, error: this.state.error });
      throw error;
}
}

  /**
   * Toggle dark mode
   */
  async toggleDarkMode(): Promise<void> {
    if (!this.state.isEnabled) throw new Error('Theme manager is not enabled');

    const newTheme = this.state.isDarkMode ? 'light' : 'dark';
    await this.switchTheme(newTheme);
}

  /**
   * Set system theme
   */
  async setSystemTheme(): Promise<void> {
    if (!this.state.isEnabled) throw new Error('Theme manager is not enabled');

    this.state.isSystemTheme = true;
    this.state.systemThemeChanges++;
    this.state.lastUpdate = Date.now();

    // Apply system theme
    const systemTheme = this.mediaQuery?.matches ? 'dark' : 'light';
    await this.switchTheme(systemTheme);

    this.emit('system_theme_changed', { theme: systemTheme });
}

  /**
   * Create custom theme
   */
  async createCustomTheme(themeData: Partial<Theme>): Promise<Theme> {
    if (!this.state.isEnabled) throw new Error('Theme manager is not enabled');

    const theme: Theme = {
      id: themeData.id || this.generateId, (, ),
      name: themeData.name || 'Custom Theme',
      displayName: themeData.displayName || themeData.name || 'Custom',
      description: themeData.description ||'',
      type: themeData.type || 'custom',
      colors: themeData.colors || this.getDefaultColors, (, ),
      typography: themeData.typography || this.getDefaultTypography, (, ),
      spacing: themeData.spacing || this.getDefaultSpacing, (, ),
      shadows: themeData.shadows || this.getDefaultShadows, (, ),
      borders: themeData.borders || this.getDefaultBorders, (, ),
      animations: themeData.animations || this.getDefaultAnimations, (, ),
      metadata: {
        created: Date.now(),
        modified: Date.now(),
        version: '1.0.',
        author: 'User',
        tags: [''],
        ...themeData.metadata
  },
      config: themeData.config ||,  , {}
};

    try {
      this.state.customThemes.set(theme.id, theme);
      this.state.totalCustomThemes++;
      this.state.lastUpdate = Date.now();

      this.emit('custom_theme_created', { theme });
      return theme;
} catch (error) {
      this.state.hasError = true;
      this.state.error = error instanceof Error ? error.message : 'Unknown error';
      this.emit('custom_theme_create_failed', { theme, error: this.state.error });
      throw error;
}
}

  /**
   * Apply theme
   */
  private async applyTheme(theme: Theme): Promise<void> {
    const root = document.documentElement;
    
    // Apply colors
    Object.entries(theme.colors).forEach(([key, value]) => {
      if (typeof value === 'string') {
        root.style.setProperty(`--theme-${key}`, value);
  } else if (typeof value === 'object') {
        Object.entries(value).forEach(([subKey, subValue]) => {
          root.style.setProperty(`--theme-${key}-${subKey}`, subValue);
    });
  }
});

    // Apply typography
    Object.entries(theme.typography).forEach(([key, value]) => {
      if (typeof value === 'object' && value !== null) {
        Object.entries(value).forEach(([subKey, subValue]) => {
          root.style.setProperty(`--theme-typography-${key}-${subKey}`, subValue);
    });
  }
});

    // Apply spacing
    Object.entries(theme.spacing).forEach(([key, value]) => {
      root.style.setProperty(`--theme-spacing-${key}`, `${value}px`);
});

    // Apply shadows
    Object.entries(theme.shadows).forEach(([key, value]) => {
      root.style.setProperty(`--theme-shadow-${key}`, value);
});

    // Apply borders
    Object.entries(theme.borders).forEach(([key, value]) => {
      if (typeof value === 'object' && value !== null) {
        Object.entries(value).forEach(([subKey, subValue]) => {
          root.style.setProperty(`--theme-border-${key}-${subKey}`, `${subValue}px`);
    });
  }
});

    // Apply animations
    Object.entries(theme.animations).forEach(([key, value]) => {
      if (typeof value === 'object' && value !== null) {
        Object.entries(value).forEach(([subKey, subValue]) => {
          root.style.setProperty(`--theme-animation-${key}-${subKey}`, subValue);
    });
  }
});

    // Set theme class
    root.className = root.className.replace(/theme-\w+/g, '');
    root.classList.add(`theme-${theme.id}`);
}

  /**
   * Save theme preference
   */
  private saveThemePreference(): void {
    if (!this.config.enableThemePersistence) return;

    try {
      const preference = {
        theme: this.state.currentTheme,
        systemTheme: this.state.systemTheme,
        isSystemTheme: this.state.isSystemTheme,
        isDarkMode: this.state.isDarkMode
};
      localStorage.setItem(this.config.themeStorageKey, JSON.stringify(preference));
} catch (error) {
      console.warn('Failed to save theme preference:', error);
}
}

  /**
   * Handle system theme change
   */
  private handleSystemThemeChange(): void {
    if (!this.state.isSystemTheme) return;

    const isDark = this.mediaQuery?.matches || false;
    this.state.isDarkMode = isDark;
    this.state.darkModeChanges++;
    this.state.lastUpdate = Date.now();

    const theme = isDark ? 'dark' : 'light';
    this.switchTheme(theme);
}

  /**
   * Handle storage change
   */
  private handleStorageChange(event: StorageEvent): void {
    if (event.key === this.config.themeStorageKey) {
      this.loadThemePreference();
}
}

  /**
   * Handle before unload
   */
  private handleBeforeUnload(): void {
    this.saveThemePreference();
}

